-    ℚ (SeparableClosure ℚ)
-    (numberFieldEmbeddedBaseSubgroup K L
-      (j.comp (IsScalarTower.toAlgHom ℚ L L')))
-    (numberFieldEmbeddedBaseSubgroup K' L' j)
-    (numberFieldEmbeddedBaseSubgroup_le_of_tower K K' L L' j)
