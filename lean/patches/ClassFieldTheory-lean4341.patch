+noncomputable local instance
+    naturalityAbstractRelativeFixedFieldNumberField :
+    NumberField
+      (abstractRelativeFixedField
+        ℚ (SeparableClosure ℚ) P.below) :=
+  NumberField.of_module_finite ℚ
