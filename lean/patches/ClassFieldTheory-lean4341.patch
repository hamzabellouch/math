+      (abstractFixedField ℚ (SeparableClosure ℚ) H.field)
+      (abstractRelativeFixedField
+      ℚ (SeparableClosure ℚ) P.below) :=
+  finiteAbelianSubextensionAbstractRelativeFixedFieldIsAbelianGalois P
