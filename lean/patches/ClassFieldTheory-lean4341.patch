+noncomputable instance
+    abstractFixedFieldCyclotomicCompositum_algebra
+    (H : FiniteAbstractField
+      (SeparableClosure ℚ ≃ₐ[ℚ] SeparableClosure ℚ)) :
+    let hI :=
+      rationalCyclotomicFieldInertia_le H.field
