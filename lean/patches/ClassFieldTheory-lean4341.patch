+        (abstractFixedFieldCyclotomicFiniteLayer H E) σ)
+        (abstractFixedFieldCyclotomicFiniteLayerEmbedding H E z) := by
+  let F :=
+    LocalClassFieldTheory.abstractFixedField
+      ℚ (SeparableClosure ℚ) H.field
+  let U :=
