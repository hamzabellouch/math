+@[simp]
+theorem abstractFixedFieldCyclotomicRestriction_extensionClass
+    (H : FiniteAbstractField
+      (SeparableClosure ℚ ≃ₐ[ℚ] SeparableClosure ℚ))
+    (σ : H.field.toSubgroup) :
