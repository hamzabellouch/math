+import PrimeNumberTheoremAnd.ZetaFive.Consequences
+
+/-!
+# Prime counting asymptotics from the proved prime number theorem
+
+The current Mathlib Chebyshev remainder estimate converts the proved theta asymptotic
+into the exact all-real prime-counting formula used by the Apéry proof.
+-/
+
+open Filter Real Asymptotics
+open scoped Chebyshev
+
+namespace AperyPNT
+
+/-- The prime-counting function is asymptotic to `x / log x`. -/
+theorem primeCounting_asymptotic :
+    (fun x : ℝ ↦ (Nat.primeCounting ⌊x⌋₊ : ℝ)) ~[atTop] (fun x ↦ x / log x) := by
+  have h := ZetaFivePNT.chebyshev_asymptotic.div (IsEquivalent.refl (u := Real.log))
+  have h' := h.add_isLittleO Chebyshev.integral_theta_div_log_sq_isLittleO
+  apply h'.congr' ?_ (Filter.EventuallyEq.refl _ _)
+  filter_upwards [eventually_ge_atTop (2 : ℝ)] with x hx
