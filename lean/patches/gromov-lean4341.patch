+private lemma small_generators_growth (n : ℕ) (hn : 2 ≤ n)
+    (G : Subgroup (Matrix.unitaryGroup (Fin n) ℂ))
+    (S_poly_data : SPolyData (G' n (H_n_eps hn) G))
+    (S : Set G) (S_finite : S.Finite)
+    (s_to_map : S_finite.toFinset → Subgroup.map G.subtype (G' n (H_n_eps hn) G))
