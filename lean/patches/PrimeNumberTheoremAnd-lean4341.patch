+lemma continuousOn_log1 : ContinuousOn (fun x ↦ (log x ^ 2)⁻¹ * x⁻¹) {0, 1, -1}ᶜ := by
+  refine fun t ht ↦ ContinuousAt.continuousWithinAt ?_
+  fun_prop (disch := simp_all)
