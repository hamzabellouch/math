+theorem first_fourier_aux2a :
+    (2 : ℂ) * π * -(y * (1 / (2 * π) * Real.log ((n) / x))) = -(y * ((n) / x).log) := by
+  calc
+    _ = -(y * (((2 : ℂ) * π) / (2 * π) * Real.log ((n) / x))) := by ring
+    _ = _ := by rw [div_self (by norm_num), one_mul]
