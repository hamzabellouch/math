+def divisorZeroIndex₀FiberFinset (f : ℂ → ℂ) (z₀ : ℂ) :
+    Finset (divisorZeroIndex₀ f (Set.univ : Set ℂ)) :=
+  (divisorZeroIndex₀_fiber_finite (f := f) z₀).toFinset
