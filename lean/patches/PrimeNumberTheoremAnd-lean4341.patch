+        ≤ ∫ (t : ℝ) in A..(2 * A), (Real.log 2 : ℝ) ∂volume := by
+    refine intervalIntegral.integral_mono_on (μ := (volume : MeasureTheory.Measure ℝ))
+      hA_le hφ_int hconst ?_
+    intro t ht
