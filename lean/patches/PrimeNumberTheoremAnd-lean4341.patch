+    simp only [Real.rpow_one] at this
+    apply Tendsto.congr' _ this
+    filter_upwards [eventually_ge_atTop 0] with x hx
+    rw [mul_comm]
+    apply div_rpow_eq_rpow_neg _ _ _ hx
+  have h4 := h3.const_mul (1 / σ)
+  have h5 := (h2.add h4).neg
+  convert h5 using 1
