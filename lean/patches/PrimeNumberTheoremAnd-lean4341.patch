+  convert! HasDerivAt.mul (c := fun z ↦ - (N : ℂ) ^ z) (d := fun z ↦ z⁻¹)
+    (c' := - (N : ℂ) ^ z * Real.log N)
+    (d' := - (z ^ 2)⁻¹) ?_ ?_ using 1
