+        exact (hr_not_bad' this).elim
+      have hval0 : divisorZeroIndex₀Val p ≠ 0 := divisorZeroIndex₀Val_ne_zero p
+      have hmτ : (m : ℝ) ≤ τ := le_trans hmρ (le_of_lt hτ)
