+    by_cases hi : i = 0 <;> simp [hi, f0]
+  have l2 i : ‖f i‖ / i = ‖f0 i‖ / i := by by_cases hi : i = 0 <;> simp [hi, f0]
+  simp_rw [l2] ; apply bound_sum_log rfl l1 hx
