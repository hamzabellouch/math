+  have h1 := tendsto_rpow_neg_atTop σpos
+  have h2 := h1.const_mul (1 / σ^2)
+  have h3 : Tendsto (fun t : ℝ ↦ t ^ (-σ) * Real.log t) atTop (nhds 0) := by
