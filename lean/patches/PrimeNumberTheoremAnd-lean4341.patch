+    ∫ t : ℝ, LSeries f (σ' + t * I) * ψ t * x ^ (t * I) := by
+  calc
+    _ = ∑' n, term f σ' n * ∫ (v : ℝ), 𝐞 (-(v * ((1 : ℝ) /
+        ((2 : ℝ) * π) * Real.log (n / x)))) • ψ v := by
+      simp only [Real.fourier_eq]
+      simp only [one_div, mul_inv_rev, RCLike.inner_apply', conj_trivial]
+    _ = ∑' n, ∫ (v : ℝ), term f σ' n * 𝐞 (-(v * ((1 : ℝ) /
+        ((2 : ℝ) * π) * Real.log (n / x)))) • ψ v := by
