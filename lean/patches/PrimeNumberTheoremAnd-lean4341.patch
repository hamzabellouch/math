+      have : divisorZeroIndex₀Val p ∈ Metric.ball (0 : ℂ) r0 ∩ D.support := ⟨hball, hp⟩
+      have : divisorZeroIndex₀Val p ∈ ({(0 : ℂ)} : Set ℂ) := by simp [hr0] at this
