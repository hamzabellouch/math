+    ∑ n ∈ Ioc 0 ⌊ x ⌋₊, log n ≥ x * log x - 2 * x := by
+  have one_le_floor : 1 ≤ ⌊x⌋₊ := by simpa
+  calc
+  _ = ∑ n ∈ Icc 1 ⌊ x ⌋₊, log n := by rfl
+  _ = ∑ n ∈ Ico (1 + 1) (⌊ x ⌋₊ + 1), log n := by
+    rw [← add_sum_Ioc_eq_sum_Icc one_le_floor]
