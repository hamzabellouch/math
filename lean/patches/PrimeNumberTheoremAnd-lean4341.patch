+theorem hh_integral' : ∫ t in Ioi 0, hh (1 / (2 * π)) t = 2 * π ^ 2 := by
+  have := hh_integral (a := 1) (b := 1 / (2 * π)) (c := 1)
+    (by positivity) (by positivity) (by positivity)
+  convert this using 1 <;> simp ; ring
