+    [MeasureTheory.SigmaFinite ν] [NormedSpace ℝ E] [MeasureTheory.SigmaFinite μ]
+    (f : α → β → E) {s : Set α} {t : Set β}
+    (hf : IntegrableOn (f.uncurry) (s ×ˢ t) (μ.prod ν)) :
+    (∫ (x : α) in s, ∫ (y : β) in t, f x y ∂ν ∂μ)
+      = ∫ (y : β) in t, ∫ (x : α) in s, f x y ∂μ ∂ν := by
