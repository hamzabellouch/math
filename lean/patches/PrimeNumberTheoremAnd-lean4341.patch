+      (C := Cgrow) (L := Real.log 2) (M := (1 + 4 * r0) ^ ρ)
+      (X := (1 + |2 * Rk|) ^ ρ)
+      (T := ∑' p : S, ‖divisorZeroIndex₀Val p.1‖⁻¹ ^ τ)
+      (Ctrail := Ctrail) (r0 := r0) (ρ := ρ) (τ := τ) (k := k)
+      hlog2pos hCgrow_pos.le hr0pos.le hpow_bound
