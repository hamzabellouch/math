+    ring_nf
+  · simp only [natCast_log, neg_mul]
+    apply HasDerivAt.neg
+    convert! HasDerivAt.const_cpow (c := (N : ℂ)) (f := id) (f' := 1) (x := z) (hasDerivAt_id z)
