+    exact by simpa [Set.mem_sdiff, Set.mem_singleton_iff] using this.2
+  exact tendstoUniformlyOn_divisorPartialProduct_div_pow_sub
+    (m := m) (f := f) h_sum (z₀ := z₀) (k := k) (hK := hK) hKz
