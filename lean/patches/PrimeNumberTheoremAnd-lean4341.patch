+    simpa [hEq] using hle
+  have ha_nonneg : 0 ≤ a := ha.le
+  have := mul_le_mul_of_nonneg_left hle' ha_nonneg
+  have hRHS : a * (Cφ * (R / a)) = Cφ * R := by
