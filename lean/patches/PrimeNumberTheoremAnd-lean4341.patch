+  have hlog : 0 < log x := log_pos hx
+  have hpos : ∀ {p : ℕ}, p.Prime → (0 : ℝ) < 1 - 1 / p := fun {p} hp ↦ by
+    have : (2 : ℝ) ≤ p := mod_cast hp.two_le
+    grind [one_div_le_one_div_of_le two_pos this]
