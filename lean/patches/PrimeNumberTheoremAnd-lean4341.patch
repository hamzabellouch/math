+            simpa [small] using (hsmall_fin.mem_toFinset.2 hp_mem)
+          exact hp this
+        exact lt_of_not_ge this
+      have hz' : ‖u / divisorZeroIndex₀Val p‖ ≤ (1 / 2 : ℝ) :=
