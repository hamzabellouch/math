+lemma K_le_four_mul_K_add_one_mul_of_quarter_le {A : ℝ} (hA : (1 / 4 : ℝ) ≤ A) :
+    K ≤ (4 * K + 1) * A := by
+  have hcoef : 1 ≤ 4 * A := by nlinarith [hA]
+  have hK : 0 ≤ K := K_nonneg
+  nlinarith [hK, hcoef]
