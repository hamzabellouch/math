+      convert volume.mono r4 ; norm_num
+    simpa [setIntegral_pos_iff_support_of_nonneg_ae r1 r2] using zero_lt_one.trans_le r5
+  have := div_nonneg l3 l4.le ; field_simp at this ; exact this
