+    simpa using hdiff.differentiableOn
+  have : (Filter.atTop : Filter (Finset (divisorZeroIndex₀ f (Set.univ : Set ℂ)))).NeBot :=
+    Filter.atTop_neBot
+  exact hloc.differentiableOn hF isOpen_univ
