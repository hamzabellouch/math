+lemma Function.support_mul_subset_of_subset {s : Set ℝ} {f g : ℝ → 𝕂}
+    (fSupp : f.support ⊆ s) : (f * g).support ⊆ s := by
+  simp_rw [support_mul', inter_subset, subset_union_of_subset_right fSupp]
