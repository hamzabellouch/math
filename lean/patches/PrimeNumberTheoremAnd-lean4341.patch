+theorem hh_integral (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
+    ∫ (t : ℝ) in Ioi 0, a * hh b (t / c) = a * c / b * π :=
+  hh_integrable_aux ha hb hc |>.2
