+    _ = (C₁ * A ^ ((3 : ℝ)/ 4) - C₂ * 2 * A) * Real.log |t| ^ (-7 : ℝ) := by ring
+    _ ≥ _ := ?_
+  · apply ge_iff_le.mpr
+    convert norm_sub_norm_le (a := ζ s') (b := ζ s' - ζ s) using 1
+    · rw [(by simp : ζ s' - ζ s = -(ζ s - ζ s'))]; simp only [norm_neg]
+    · simp
+  · apply sub_le_sub
+    · have := one_div_le ?_ (by positivity) |>.mp <| hC₁ ⟨σ'_gt, σ'_le⟩ t t_gt
