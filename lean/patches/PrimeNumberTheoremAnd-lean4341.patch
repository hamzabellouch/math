+      have hbmτ_le :
+          (∑' p : divisorZeroIndex₀ f (Set.univ : Set ℂ), bmτ p) ≤
+            (m : ℝ) * (4 : ℝ) ^ τ * (Sτ + 1) * (1 + r) ^ τ := by
+        have h0 :
+            (∑' p : divisorZeroIndex₀ f (Set.univ : Set ℂ), bmτ p)
