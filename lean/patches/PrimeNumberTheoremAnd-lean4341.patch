+theorem le_exp_of_log_one_add_le {x y : ℝ} (hy : 0 ≤ y) (hxy : log (1 + y) ≤ x) :
+    y ≤ exp x := by
+  have hpos : 0 < (1 : ℝ) + y := by linarith
+  have hone : 1 + y ≤ exp x := (log_le_iff_le_exp hpos).1 hxy
+  linarith
