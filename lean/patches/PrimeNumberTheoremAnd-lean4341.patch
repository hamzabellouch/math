+theorem E₃.bound''' : (fun x ↦ ∏ p ∈ Ioc 0 ⌊ x ⌋₊ with p.Prime, (1 - (1:ℝ) / p) - exp (-eulerMascheroniConstant) / log x) =O[atTop] (fun x ↦ 1 / (log x)^2) := by
+  obtain ⟨c, hc⟩ := E₃.abs_le
+  rw [isBigO_iff]
+  refine ⟨exp (-eulerMascheroniConstant) * 2 * c, ?_⟩
