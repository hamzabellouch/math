+theorem one_div_sub_one (n : ℕ) : 1 / (↑(n - 1) : ℝ) ≤ 2 / n := by
+  cases n with
+  | zero => simp
+  | succ n =>
+    cases n with
+    | zero => simp
+    | succ n => norm_cast ; rw [div_le_div_iff₀] <;> simp [mul_add] <;> linarith
