+lemma pi_asymp_aux (x : ℝ) (hx : 2 ≤ x) : Nat.primeCounting ⌊x⌋₊ =
+    (log x)⁻¹ * θ x + ∫ t in Set.Icc 2 x, θ t * (t * log t ^ 2)⁻¹ := by
+  rw [th43_b _ hx]
+  simp_rw [div_eq_mul_inv, Chebyshev.theta_eq_sum_Icc]
+  ring_nf!
