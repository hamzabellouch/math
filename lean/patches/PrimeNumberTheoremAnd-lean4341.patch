+lemma integral_log_inv'' (a b : ℝ) (ha : 2 ≤ a) (hb : a ≤ b) :
+    (log a)⁻¹ * a + ∫ t in Set.Icc a b, (log t)⁻¹ =
+    ((log b)⁻¹ * b) + ∫ t in Set.Icc a b, ((log t)^2)⁻¹ := by
