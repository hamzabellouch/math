+    rw [abs_of_nonneg hdiff_nonneg, abs_of_nonneg (by bound)]
+    exact hdiff_le.trans ((le_abs_self _).trans (Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log (by linarith)))
