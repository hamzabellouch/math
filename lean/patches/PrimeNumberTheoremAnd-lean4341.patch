+theorem E₂p.abs_le {x : ℝ} (hx : 2 ≤ x) :
+    |E₂p x| ≤ (log 4 + 6 + E₁) / log x := by
+    have : 0 < log x := by apply log_pos; linarith
+    rw [E₂p.eq hx, abs_le']
+    constructor
+    · grw [E₁p.le (by linarith)]
