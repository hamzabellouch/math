+lemma Z341pos (t : ℝ) (delta : ℝ) (hdelta : delta > 0) :
+    0 ≤ 3 * (-logDerivZeta ((1 : ℂ) + delta)).re +
+        4 * (-logDerivZeta ((1 : ℂ) + delta + t * I)).re +
+        (-logDerivZeta ((1 : ℂ) + delta + (2 * t) * I)).re := by
