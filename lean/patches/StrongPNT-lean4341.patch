+  have h_exists_rho0 := lem_zeros_have_limit_point R hR f h_Kf_inf
+  exact lem_identity_theoremKR R hR hR' f hf h_exists_rho0
+lemma lem_Contra_finiteKR (R : ℝ) (hR : 0 < R) (hR' : R < 1)
