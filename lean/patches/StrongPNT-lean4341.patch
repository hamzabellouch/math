+lemma zetaanalOnnot1 : AnalyticOnNhd ℂ riemannZeta {s : ℂ | s ≠ 1} := by
+  apply DiffAtallanalOnNhd
+  · apply isOpen_compl_singleton
+  · exact zetadiffAtnot1
