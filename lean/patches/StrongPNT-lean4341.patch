+lemma hasDerivWithinAt_congr_eqOn {f g : ℂ → ℂ} {s : Set ℂ} {z f' : ℂ}
+  (hEq : Set.EqOn f g s) (hz : z ∈ s) :
+  HasDerivWithinAt g f' s z → HasDerivWithinAt f f' s z := by
