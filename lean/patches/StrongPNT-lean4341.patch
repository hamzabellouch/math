+    rw[mul_one, ← neg_div, ← mul_neg]
+    nth_rewrite 2 [← one_div_mul_eq_div]
+    repeat rw[← mul_add]
+    let fTempRR : ℝ → ℝ → ℂ := fun x ↦ fun y ↦
