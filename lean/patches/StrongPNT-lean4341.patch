+lemma logDerivconst {a : ℂ} {g : ℂ → ℂ} (ha : a ≠ 0) :
+    ∀ z, logDeriv (fun w ↦ a * g w) z = logDeriv g z := by
+  intro z
+  exact logDeriv_const_mul z a ha
