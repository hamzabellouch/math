+lemma H_derivative_is_zero
+    {r1 R' R : ℝ}
+    (hr1_pos : 0 < r1) (hr1_lt_R' : r1 < R') (hR'_lt_R : R' < R) (hR_lt_one : R < 1)
+    {B : ℂ → ℂ}
