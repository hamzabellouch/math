+lemma helper_tendsto_add {f g : ℕ → ℂ} {a b : ℂ}
+  (hf : Tendsto f atTop (𝓝 a)) (hg : Tendsto g atTop (𝓝 b)) :
+  Tendsto (fun n => f n + g n) atTop (𝓝 (a + b)) := by
+                                                   
