+theorem SmoothedChebyshevDirichlet {SmoothingF : ℝ → ℝ}
+    (diffSmoothingF : ContDiff ℝ 1 SmoothingF)
+    (SmoothingFpos : ∀ x > 0, 0 ≤ SmoothingF x)
+    (suppSmoothingF : Function.support SmoothingF ⊆ Icc (1 / 2) 2)
