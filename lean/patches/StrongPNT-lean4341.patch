+    _ = 1 / Real.log (R / R1) * (Real.log (R / R1) * (∑ ρ ∈ h_finite_zeros.toFinset, ↑(analyticOrderAt f ρ).toNat)) := by
+      field_simp [ne_of_gt log_pos]
+    _ ≤ 1 / Real.log (R / R1) * Real.log B := by
+      gcongr
+      rw [mul_comm]
+      exact h_div_log
