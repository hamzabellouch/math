+lemma im_tsum_ofReal (g : ℕ → ℝ) : (∑' n : ℕ, (g n : ℂ)).im = 0 := by
+  have him := congrArg Complex.im (Complex.ofReal_tsum (L := SummationFilter.unconditional ℕ) (f := g)).symm
+  have hz : (((∑' n : ℕ, g n) : ℝ) : ℂ).im = 0 := by
+    simp
+  exact Eq.trans him hz
