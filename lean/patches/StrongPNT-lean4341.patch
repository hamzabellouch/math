+  simp only [one_div, mul_inv_rev, inv_I, neg_mul, norm_neg, Complex.norm_mul, norm_I, norm_inv,
+    norm_real, norm_eq_abs, Complex.norm_ofNat, one_mul, ge_iff_le]
