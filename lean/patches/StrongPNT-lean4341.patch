+lemma Lf_is_analytic
+    (r R R1 : ℝ)
+    (hr_pos : 0 < r)
+    (hr_lt_R1 : r < R1)
+    (hR1_pos : 0 < R1)
+    (hR1_lt_R : R1 < R)
