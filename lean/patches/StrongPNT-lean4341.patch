+    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using h_aux
+                                               
+  have h_drop : C * Real.log (abs (2 * t) + 2) - Sre ≤ C * Real.log (abs (2 * t) + 2) :=
