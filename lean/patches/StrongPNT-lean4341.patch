+lemma prod_inequality {P : Type*} (a b : P → ℝ≥0) (ha : Multipliable a) (hb : Multipliable b)
+  (hab : ∀ p : P, a p ≤ b p) :
+  ∏' p : P, a p ≤ ∏' p : P, b p := by
