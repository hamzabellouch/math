+              apply mul_le_mul_of_nonneg_left h_sum_bound (div_nonneg zero_le_one (le_of_lt h_pos))
+    _ = 1/((R^2/R1 - R1) * Real.log (R/R1)) * Real.log B := by
+      field_simp [ne_of_gt h_pos, ne_of_gt h_log_pos]
