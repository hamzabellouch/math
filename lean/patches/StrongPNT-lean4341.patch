+      Real.log |t| + Real.log (b / a)
+          ≤ Real.log |t| + |u| := by exact add_le_add_right haux1 _
+      _ ≤ Real.log |t| + (|u| * Real.log |t|) := by exact add_le_add_right haux2 _
+      _ = (1 + |u|) * Real.log |t| := by ring
