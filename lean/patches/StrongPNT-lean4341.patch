+lemma sq_div_sub_pos (a b : ℝ) (ha_pos : 0 < a) (hab : a < b) : 0 < b^2/a - a := by
+                                        
+  rw [sub_pos]
+                                                        
+  rw [lt_div_iff₀ ha_pos]
+                         
+  rw [← pow_two]
+                                                                         
+  have ha_nonneg : 0 ≤ a := le_of_lt ha_pos
+  apply pow_lt_pow_left₀ hab ha_nonneg
+  norm_num                                          
