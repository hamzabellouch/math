+    have h_2pi_nonneg : (0 : ℝ) ≤ 2 * Real.pi := by
+      apply mul_nonneg
+      · norm_num
+      · exact le_of_lt Real.pi_pos
+    exact abs_integral_le_integral_abs h_2pi_nonneg
+  · exact le_of_lt one_div_two_pi_pos
