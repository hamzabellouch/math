+          rw [Complex.re_ofReal_mul (Λ n)]
+          ring_nf
+          rw [Complex.inv_re]
+          rw [Complex.cpow_ofReal_re]
+          simp [*]
+          left
+          have N : (0 : ℝ) ≤ ↑n := by exact Nat.cast_nonneg' n
