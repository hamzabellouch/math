+lemma lem_dw_dt_real {r_int : ℝ} (t : ℝ) :
+deriv (fun (t' : ℝ) => r_int * Complex.exp (I * t')) t = I * r_int * Complex.exp (I * t) := by
+                                       
+  rw [deriv_const_mul]
+                                             
+  rw [deriv_cexp]
+                                                  
+  rw [deriv_const_mul]
