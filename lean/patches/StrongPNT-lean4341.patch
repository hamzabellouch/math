+        (z - ρ) ^ (analyticOrderAt f ρ).toNat) σ := by
+                                                                             
+  have hden := lem_denomAnalAt (S := h_finite_zeros.toFinset.erase σ)
+    (n := fun ρ => (analyticOrderAt f ρ).toNat)
+    (_hn_pos := by
