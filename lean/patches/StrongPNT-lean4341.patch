+    (_h_r_int_lt_R_analytic : r_int < R_analytic) :
+    norm (f (r_int * Complex.exp (I * t)) * (r_int * Complex.exp (I * t))) =
+norm (f (r_int * Complex.exp (I * t))) * norm (r_int * Complex.exp (I * t)) := by
+                                                                     
+  rw [norm_mul]
