+lemma lem_mod_div_and_neg (R : ℝ) (hR_pos : 0 < R) (ρ : ℂ) (h_rho_ne_zero : ρ ≠ 0) :
+  ‖(R : ℂ) / (-ρ)‖ = R / ‖ρ‖ := by
+                                                              
+  have hden : (-ρ) ≠ 0 := by simpa using neg_ne_zero.mpr h_rho_ne_zero
+  have hdiv := lem_mod_div_ (R : ℂ) (-ρ) hden
+  calc
+    ‖(R : ℂ) / (-ρ)‖ = ‖(R : ℂ)‖ / ‖-ρ‖ := hdiv
+    _ = ‖(R : ℂ)‖ / ‖ρ‖ := by simp [norm_neg]
+    _ = |R| / ‖ρ‖ := by simp
