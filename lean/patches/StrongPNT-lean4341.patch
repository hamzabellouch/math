+      have h_abs_eq : abs t = |t| := by simp
+      rw [h_abs_eq]
+      exact le_of_lt hσ_gt
+    exact hfinal t htgt3 σ hσ_ge_required
+                                                  
+  simpa [C, L, x] using hmain'
+
+end Erdos970
