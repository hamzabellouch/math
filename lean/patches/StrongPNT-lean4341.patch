+lemma norm_sub_comm' (x y : ℂ) : ‖x - y‖ = ‖y - x‖ := by
+  calc
+    ‖x - y‖ = ‖-(x - y)‖ := by simpa using (norm_neg (x - y)).symm
+    _ = ‖y - x‖ := by simp [neg_sub]
