+      intro n_zero
+      rw [n_zero, Nat.cast_zero] at h_order_ne_zero
+      exact h_order_ne_zero rfl
+                                 
+    have n_ge_one : n ≥ 1 := Nat.one_le_iff_ne_zero.mpr n_ne_zero
