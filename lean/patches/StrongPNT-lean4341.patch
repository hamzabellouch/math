+def zerosetKfR (R : ℝ) (_hR : 0 < R) (f : ℂ → ℂ) : Set ℂ :=
+  {ρ : ℂ | ρ ∈ Metric.closedBall (0 : ℂ) R ∧ f ρ = 0}
+lemma lemKinDR (R : ℝ) (hR : 0 < R) (f : ℂ → ℂ) :
+    zerosetKfR R hR f ⊆ Metric.closedBall (0 : ℂ) R := by
