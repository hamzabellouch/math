+lemma re_ofReal_mul_eq (a : ℝ) (z : ℂ) : ((a : ℂ) * z).re = a * z.re := by
+  calc
+    ((a : ℂ) * z).re = ((a : ℂ).re) * z.re - ((a : ℂ).im) * z.im := by
+      simp [Complex.mul_re]
+    _ = a * z.re - 0 := by
+      simp
+    _ = a * z.re := by
+      simp
