+                                           
+  have hρ_closed_R1 : ρ ∈ Metric.closedBall (0 : ℂ) R1 := h_rho_in_KfR1.1
+                                    
+  have hR1_le_R : R1 ≤ R := by linarith
+  have hR1_lt_one : R1 < 1 := by linarith
