+
+  have S : |π|⁻¹ * 2⁻¹ * (Const * ε⁻¹ * X ^ σ₂ * |3 + 3|) = C * X ^ σ₂ / ε :=
+    by
+      unfold C
+      ring_nf
+
+  simp only [sub_neg_eq_add] at Z
+  simp only [← S, ge_iff_le]
+  linear_combination (|π|⁻¹ * 2⁻¹ * Z)
