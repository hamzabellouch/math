+
+  obtain ⟨c₆, c₆pos, Tlb₆, Tlb₆bnd, hc₆⟩ := I6Bound ν_supp ContDiff1ν
+    holo2 ⟨σ₂_pos, σ₂_lt_one⟩ A_in_Ioc
+
+  let C' := c_close + C_main
+  let C'' := c₁ + c₂ + c₈ + c₉
+  let C''' := c₃ + c₄ + c₆ + c₇
