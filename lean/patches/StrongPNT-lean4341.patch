+    (∏ ρ ∈ h_finite_zeros.toFinset,
+      ((R : ℂ) - star ρ * z / (R : ℂ)) ^ (analyticOrderAt f ρ).toNat) /
+    (∏ ρ ∈ h_finite_zeros.toFinset, (z - ρ) ^ (analyticOrderAt f ρ).toNat) =
+    ∏ ρ ∈ h_finite_zeros.toFinset,
+      (((R : ℂ) - star ρ * z / (R : ℂ)) ^ (analyticOrderAt f ρ).toNat /
+       (z - ρ) ^ (analyticOrderAt f ρ).toNat) := by
