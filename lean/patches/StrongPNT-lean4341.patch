+lemma Rezetaseries_convergence (x y : ℝ) (hx : 1 < x) :
+    Summable (fun n : ℕ => (ArithmeticFunction.vonMangoldt n : ℝ) * (n : ℝ) ^ (-x) * Real.cos (y * Real.log (n : ℝ))) := by
+                                                                           
