+lemma reciprocal_div_inequality (a b : ℝ) (ha : 0 < a) (hb : 0 < b) (h : 4 / a ≤ b) : a ≥ 4 / b := by
+                                                                
+  have h1 : 4 ≤ b * a := div_le_to_le_mul 4 a b ha h
+                                       
+  have h2 : 4 ≤ a * b := by
+    rwa [mul_comm] at h1
+                                                              
+  have h3 : 4 / b ≤ a := le_mul_to_le_div 4 b a hb h2
+                                                                           
+  exact h3
