+theorem lem_mod_of_prod2 {ι : Type*} (K : Finset ι) (w : ι → ℂ) :
+    ‖∏ ρ ∈ K, w ρ‖ = ∏ ρ ∈ K, ‖w ρ‖ := by
+  classical
+  refine Finset.induction_on K ?h0 ?hstep
+  · simp
+  · intro a s ha ih
+                                                       
