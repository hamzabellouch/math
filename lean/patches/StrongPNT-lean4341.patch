+lemma log_abs_le_log_abs_add_two {t : ℝ} (ht : 2 < |t|) :
+  Real.log (abs t) ≤ Real.log (abs t + 2) := by
+  have hpos : 0 < |t| := lt_trans (by norm_num) ht
+  have hle : |t| ≤ |t| + 2 := by nlinarith
+  simpa using Real.log_le_log hpos hle
