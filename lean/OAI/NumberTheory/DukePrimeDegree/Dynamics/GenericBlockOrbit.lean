import OAI.NumberTheory.DukePrimeDegree.Dynamics.GenericRootCommutant
import OAI.NumberTheory.DukePrimeDegree.Dynamics.OrbitMeasureTransfer

namespace OAI

/-!
# Prime obstruction for the larger homogeneous orbit group

The actual finite-volume orbit group may strictly contain the group
generated by the roots. Genericity and one root already force its
stabilizer centralizer to be commutative. Thus block preservation is
enough: no absence-of-singletons or split-diagonal hypothesis is needed.
-/

noncomputable section
open Matrix Set MeasureTheory
open scoped Classical

namespace DukePrimeDegree
open PrimeDegreePackets

lemma blockScalar_mem_of_commutes_roots_and_blocks {n : ℕ}
    (r : Setoid (Fin n)) (M : Matrix (Fin n) (Fin n) ℝ)
    (hblock : ∀ N ∈ blockScalarAlgebra r, Commute M N)
    (hroot : ∀ i j, i ≠ j → r i j → Commute M (Matrix.transvection i j (1 : ℝ))) :
    M ∈ blockScalarAlgebra r := by
  have hD : M = Matrix.diagonal (fun i => M i i) := by
    ext a b
    by_cases hab : a = b
    · subst b
      simp
    · rw [Matrix.diagonal_apply_ne _ hab]
      by_cases hr : r a b
      · exact offColumn_zero_of_commute_root M b a (hroot b a (Ne.symm hab) (r.symm hr)) a hab
      · exact (commute_blockScalars_iff r M).mp hblock a b hr
  apply (mem_blockScalarAlgebra_iff r M).mpr
  refine ⟨hD, ?_⟩
  intro i j hr
  by_cases hij : i = j
  · subst j
    rfl
  · have he := hroot i j hij hr
    rw [hD] at he
    exact (diagonal_commute_transvection_iff _ hij).mp he

/-- The centralizer identification for the larger actual orbit group,
including partitions having singleton blocks. -/
theorem centralizer_subset_blockScalar_of_generic_finite_root_orbit {n : ℕ}
    (g : G n)
    (hgeneric : ∀ v ∈ rowLattice g.val, v ≠ 0 → ∀ j, v j ≠ 0)
    (L : Subgroup (G n))
    (μ : Measure (LatticeOrbitQuotient g L)) [IsFiniteMeasure μ] (hμ : μ ≠ 0)
    (hinv : ∀ h : L, μ.map (fun x => latticeOrbitRightAction g L x h) = μ)
    (r : Setoid (Fin n)) (hnontrivial : ∃ i j, i ≠ j ∧ r i j)
    (hroot : ∀ i j (hij : i ≠ j), r i j →
      Matrix.SpecialLinearGroup.transvection hij (1 : ℝ) ∈ L)
    (hblock : L ≤ blockMatrixGroup r)
    (M : Matrix (Fin n) (Fin n) ℝ)
    (hM : ∀ s : pointOrbitStabilizer g L, Commute M s.val.val) :
    M ∈ blockScalarAlgebra r := by
  obtain ⟨i, j, hij, hr⟩ := hnontrivial
  apply blockScalar_mem_of_commutes_roots_and_blocks r M
  · intro N hN
    apply pointStabilizer_commutative_of_finite_root_orbit g hgeneric L μ hμ hinv
      i j hij (hroot i j hij hr) M N hM
    intro s
    exact (slMatrixConjugation_eq_self_iff s.val.val N).mp
      (slMatrixConjugation_eq_self_of_mem_blockMatrixGroup r s.val.val
        (hblock s.val.property) N hN)
  · intro a b hab hrab
    exact commute_root_of_finite_root_orbit g L μ hμ hinv a b hab
      (hroot a b hab hrab) M hM

/-- Prime-degree arithmetic applied directly to a finite-volume larger
orbit group L. Only the concrete block-preserving inclusion remains;
there is no separate finite-volume assumption on the root group. -/
theorem root_partition_universal_of_generic_finite_blockPreserving_orbit {n : ℕ}
    (hn : n.Prime) (g : G n)
    (hgeneric : ∀ v ∈ rowLattice g.val, v ≠ 0 → ∀ j, v j ≠ 0)
    (L : Subgroup (G n))
    (μ : Measure (LatticeOrbitQuotient g L)) [IsFiniteMeasure μ] (hμ : μ ≠ 0)
    (hinv : ∀ h : L, μ.map (fun x => latticeOrbitRightAction g L x h) = μ)
    (r : Setoid (Fin n)) (hnontrivial : ∃ i j, i ≠ j ∧ r i j)
    (hroot : ∀ i j (hij : i ≠ j), r i j →
      Matrix.SpecialLinearGroup.transvection hij (1 : ℝ) ∈ L)
    (hblock : L ≤ blockMatrixGroup r) : ∀ i j, r i j := by
  apply root_partition_universal_of_rational_span hn g hgeneric r hnontrivial
  intro c hc
  exact rationalBlockRealSpan_of_centralizer_image g L r
    (centralizer_subset_blockScalar_of_generic_finite_root_orbit
      g hgeneric L μ hμ hinv r hnontrivial hroot hblock) hblock hc

/-- The same conclusion with a finite invariant measure on the ambient
lattice space concentrated on the actual L-orbit. -/
theorem root_partition_universal_of_generic_blockPreserving_orbit_measure {n : ℕ}
    (hn : n.Prime) (g : G n)
    (hgeneric : ∀ v ∈ rowLattice g.val, v ≠ 0 → ∀ j, v j ≠ 0)
    (L : Subgroup (G n)) (hL : IsClosed (L : Set (G n)))
    (μ : Measure (X n)) [IsFiniteMeasure μ] (hμ : μ ≠ 0)
    (horbit : ∀ᵐ x ∂μ, x ∈ range (latticeOrbitPoint g L))
    (hinv : ∀ h : L, μ.map (fun x => rightAction x h.val) = μ)
    (r : Setoid (Fin n)) (hnontrivial : ∃ i j, i ≠ j ∧ r i j)
    (hroot : ∀ i j (hij : i ≠ j), r i j →
      Matrix.SpecialLinearGroup.transvection hij (1 : ℝ) ∈ L)
    (hblock : L ≤ blockMatrixGroup r) : ∀ i j, r i j := by
  let ν := μ.comap (latticeOrbitPoint g L)
  have hν : ν ≠ 0 := by
    intro hzero
    have he := latticeOrbitPoint_map_comap g L hL μ horbit
    change ν.map _ = μ at he
    rw [hzero, Measure.map_zero] at he
    exact hμ he.symm
  exact root_partition_universal_of_generic_finite_blockPreserving_orbit hn g hgeneric
    L ν hν (latticeOrbitPoint_comap_invariant g L hL μ horbit hinv) r hnontrivial hroot hblock

end DukePrimeDegree

end

