import OAI.NumberTheory.DukePrimeDegree.Dynamics.NoFixedVectorOrbit
import OAI.NumberTheory.DukePrimeDegree.Dynamics.BlockNormalizerFiniteIndex

namespace OAI

/-!
# The group generated by the roots within each block

The finite-orbit fixed-vector obstruction excludes singleton blocks.
Without singleton blocks, the full matrix commutant of the root-generated
group is exactly the block-scalar algebra. Its full normalizer therefore
lies in the scalar-algebra normalizer used in orbit reduction.
-/

noncomputable section
open Matrix Set MeasureTheory
open scoped Classical

namespace DukePrimeDegree
open PrimeDegreePackets

def blockRootGroup {n : ℕ} (r : Setoid (Fin n)) : Subgroup (G n) :=
  Subgroup.closure {g | ∃ (i j : Fin n) (hij : i ≠ j) (t : ℝ),
    r i j ∧ g = Matrix.SpecialLinearGroup.transvection hij t}

lemma root_mem_blockRootGroup {n : ℕ} (r : Setoid (Fin n))
    (i j : Fin n) (hij : i ≠ j) (hr : r i j) (t : ℝ) :
    Matrix.SpecialLinearGroup.transvection hij t ∈ blockRootGroup r :=
  Subgroup.subset_closure ⟨i, j, hij, t, hr, rfl⟩

def rowVectorStabilizer {n : ℕ} (v : Fin n → ℝ) : Subgroup (G n) where
  carrier := {g | v ᵥ* g.val = v}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh
    change v ᵥ* (g.val * h.val) = v
    rw [← Matrix.vecMul_vecMul, hg, hh]
  inv_mem' := by
    intro g hg
    change v ᵥ* g⁻¹.val = v
    have he := congrArg (fun w : Fin n → ℝ => w ᵥ* g⁻¹.val) hg
    simpa only [Matrix.vecMul_vecMul, ← Matrix.SpecialLinearGroup.coe_mul,
      mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one, Matrix.vecMul_one] using he.symm

lemma singleton_fixed_by_blockRootGroup {n : ℕ} (r : Setoid (Fin n)) (k : Fin n)
    (hsingle : ∀ j, r k j → k = j) (h : blockRootGroup r) :
    (Pi.single k (1 : ℝ)) ᵥ* h.val.val = Pi.single k 1 := by
  have hle : blockRootGroup r ≤ rowVectorStabilizer (Pi.single k 1) := by
    rw [blockRootGroup, Subgroup.closure_le]
    rintro _ ⟨i, j, hij, t, hr, rfl⟩
    have hik : i ≠ k := by
      intro he
      subst i
      exact hij (hsingle j hr)
    change (Pi.single k (1 : ℝ)) ᵥ* Matrix.transvection i j t = Pi.single k 1
    ext a
    simp only [vecMul_transvection_apply]
    simp [Pi.single_apply, hik.symm]
  exact hle h.property

/-- A generic finite-volume root-group orbit has no singleton block. -/
theorem no_singleton_block_of_generic_finite_root_orbit {n : ℕ}
    (g : G n) (hgeneric : ∀ v ∈ rowLattice g.val, v ≠ 0 → ∀ j, v j ≠ 0)
    (r : Setoid (Fin n)) (hnontrivial : ∃ i j, i ≠ j ∧ r i j)
    (μ : Measure (LatticeOrbitQuotient g (blockRootGroup r))) [IsFiniteMeasure μ]
    (hμ : μ ≠ 0)
    (hinv : ∀ h : blockRootGroup r,
      μ.map (fun x => latticeOrbitRightAction g (blockRootGroup r) x h) = μ) :
    ∀ k, ∃ j, k ≠ j ∧ r k j := by
  obtain ⟨i, j, hij, hr⟩ := hnontrivial
  intro k
  by_contra hnone
  have hsingle : ∀ j, r k j → k = j := by
    intro l hl
    by_contra hkl
    exact hnone ⟨l, hkl, hl⟩
  have he := fixedVector_eq_zero_of_generic_finite_root_orbit g hgeneric
    (blockRootGroup r) μ hμ hinv i j hij (root_mem_blockRootGroup r i j hij hr 1)
    (Pi.single k 1) (singleton_fixed_by_blockRootGroup r k hsingle)
  have hk := congrFun he k
  simp at hk

private lemma diagonal_commute_transvection_of_eq {n : ℕ}
    (c : Fin n → ℝ) (i j : Fin n) (t : ℝ) (hc : c i = c j) :
    Commute (Matrix.diagonal c) (Matrix.transvection i j t) := by
  change Matrix.diagonal c * Matrix.transvection i j t =
    Matrix.transvection i j t * Matrix.diagonal c
  ext a b
  simp only [Matrix.diagonal_mul, Matrix.mul_diagonal]
  by_cases hab : a = b
  · subst b
    rw [mul_comm]
  · by_cases hai : a = i
    · subst a
      by_cases hbj : b = j
      · subst b
        rw [hc, mul_comm]
      · simp [Matrix.transvection, hab, Ne.symm hbj]
    · simp [Matrix.transvection, hab, Ne.symm hai]

lemma blockRootGroup_le_blockMatrixGroup {n : ℕ} (r : Setoid (Fin n)) :
    blockRootGroup r ≤ blockMatrixGroup r := by
  rw [blockRootGroup, Subgroup.closure_le]
  rintro _ ⟨i, j, hij, t, hr, rfl⟩
  intro c hc
  apply slMatrixConjugation_eq_self
  exact diagonal_commute_transvection_of_eq c i j t (hc i j hr)

/-- Once singleton blocks are excluded, roots alone determine the full
block-scalar commutant; no split diagonal is an extra hypothesis. -/
theorem blockScalar_mem_iff_commute_blockRoots {n : ℕ}
    (r : Setoid (Fin n)) (hnosingle : ∀ i, ∃ j, i ≠ j ∧ r i j)
    (M : Matrix (Fin n) (Fin n) ℝ) :
    M ∈ blockScalarAlgebra r ↔ ∀ i j, i ≠ j → r i j →
      Commute M (Matrix.transvection i j (1 : ℝ)) := by
  constructor
  · intro hM i j hij hr
    have hD := (mem_blockScalarAlgebra_iff r M).mp hM
    rw [hD.1]
    exact (diagonal_commute_transvection_iff _ hij).mpr (hD.2 i j hr)
  · intro hroot
    have hD : M = Matrix.diagonal (fun i => M i i) := by
      ext a b
      by_cases hab : a = b
      · subst b; simp
      · rw [Matrix.diagonal_apply_ne _ hab]
        obtain ⟨j, hbj, hr⟩ := hnosingle b
        have he := congrArg (fun A : Matrix (Fin n) (Fin n) ℝ => A a j)
          (hroot b j hbj hr).eq
        simp only [Matrix.mul_transvection_apply_same,
          Matrix.transvection_mul_apply_of_ne (i := b) (j := j) a j hab 1 M, one_mul] at he
        linarith
    apply (mem_blockScalarAlgebra_iff r M).mpr
    refine ⟨hD, ?_⟩
    intro i j hr
    by_cases hij : i = j
    · subst j; rfl
    · have he := hroot i j hij hr
      rw [hD] at he
      exact (diagonal_commute_transvection_iff _ hij).mp he

theorem blockScalar_mem_iff_commute_blockRootGroup {n : ℕ}
    (r : Setoid (Fin n)) (hnosingle : ∀ i, ∃ j, i ≠ j ∧ r i j)
    (M : Matrix (Fin n) (Fin n) ℝ) :
    M ∈ blockScalarAlgebra r ↔ ∀ h : blockRootGroup r, Commute M h.val.val := by
  constructor
  · intro hM h
    exact (slMatrixConjugation_eq_self_iff h.val M).mp
      (slMatrixConjugation_eq_self_of_mem_blockMatrixGroup r h.val
        (blockRootGroup_le_blockMatrixGroup r h.property) M hM)
  · intro hM
    apply (blockScalar_mem_iff_commute_blockRoots r hnosingle M).mpr
    intro i j hij hr
    exact hM ⟨Matrix.SpecialLinearGroup.transvection hij 1,
      root_mem_blockRootGroup r i j hij hr 1⟩

lemma conjugate_blockScalar_mem_of_root_normalizer {n : ℕ}
    (r : Setoid (Fin n)) (hnosingle : ∀ i, ∃ j, i ≠ j ∧ r i j)
    (g : G n) (hg : g ∈ Subgroup.normalizer (blockRootGroup r : Set (G n)))
    (M : Matrix (Fin n) (Fin n) ℝ) (hM : M ∈ blockScalarAlgebra r) :
    slMatrixConjugation g M ∈ blockScalarAlgebra r := by
  apply (blockScalar_mem_iff_commute_blockRootGroup r hnosingle _).mpr
  intro h
  have hk : g * h.val * g⁻¹ ∈ blockRootGroup r :=
    ((Subgroup.mem_normalizer_iff.mp hg) h.val).mp h.property
  have he : slMatrixConjugation g (g * h.val * g⁻¹).val = h.val.val := by
    have hc : (g * h.val * g⁻¹).val = slMatrixConjugation g⁻¹ h.val.val := by
      simp only [slMatrixConjugation, inv_inv, Matrix.SpecialLinearGroup.coe_mul]
    rw [hc]
    exact slMatrixConjugation_inverse g h.val.val
  have hcomm := ((blockScalar_mem_iff_commute_blockRootGroup r hnosingle M).mp hM
    ⟨g * h.val * g⁻¹, hk⟩).map (slMatrixConjugationHom g)
  change Commute (slMatrixConjugation g M)
    (slMatrixConjugation g (g * h.val * g⁻¹).val) at hcomm
  rwa [he] at hcomm

/-- The full root-group normalizer is contained in the already computed
block-scalar normalizer, once finite-orbit recurrence removes singleton blocks. -/
theorem blockRootGroup_normalizer_le_scalarNormalizer {n : ℕ}
    (r : Setoid (Fin n)) (hnosingle : ∀ i, ∃ j, i ≠ j ∧ r i j) :
    Subgroup.normalizer (blockRootGroup r : Set (G n)) ≤ blockScalarNormalizer r := by
  intro g hg M
  constructor
  · intro hM
    have hi := (Subgroup.normalizer (blockRootGroup r : Set (G n))).inv_mem hg
    have he := conjugate_blockScalar_mem_of_root_normalizer r hnosingle g⁻¹ hi _ hM
    simpa only [← slMatrixConjugation_mul, mul_inv_cancel, slMatrixConjugation_one] using he
  · exact conjugate_blockScalar_mem_of_root_normalizer r hnosingle g hg M

end DukePrimeDegree

