  refine ⟨C,hC,?_⟩
  intro θ rays K X hK hX rows F Q hQ hbad hrows Ψ lengthScale hmodel
  simp_rw [completedT_normHeight_norm _ _ _ _ (lt_of_lt_of_le zero_lt_one hX)]
