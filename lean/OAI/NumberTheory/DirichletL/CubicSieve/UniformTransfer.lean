    (V 5) (V 6) X₁ X₂ (𝓕 (JointLogSeparation.frequencyTwist A₁ θ₁)) (𝓕 (JointLogSeparation.frequencyTwist A₂ θ₂)) b hb0 hB hL hv hm ht hn
  · intro q x hx
    rw [tupleOuterWeight_norm]
