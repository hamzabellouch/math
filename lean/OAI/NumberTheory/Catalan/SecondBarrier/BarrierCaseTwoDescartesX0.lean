theorem barrierCase2AX_transform0_eq_explicit :
    barrierDescartesTransform (barrierCase2AX.map (Rat.castHom ℝ)) 36 (-1) (0) =
      barrierCase2AXTransform0Explicit := by
  apply Polynomial.ext
  intro h
  by_cases hh : h < 37
  · have hc := barrierDescartesTransform_coeff_rat barrierCase2AX
      barrierCase2AXCoefficient 36 (-1) (0) h barrierCase2AX_coeff_small
    have hr := barrierCase2AX_transform0_all_coeff_rat ⟨h, hh⟩
    change barrierDescartesCoeffRat barrierCase2AXCoefficient 36 (-1) (0) h =
      barrierCase2AXTransform0Coefficient h at hr
    rw [hr] at hc
    have ha : ((-1 : ℚ) : ℝ) = (-1 : ℝ) := by norm_num
    have hb : ((0 : ℚ) : ℝ) = (0 : ℝ) := by norm_num
    rw [ha, hb] at hc
    exact hc.trans (barrierCase2AXTransform0Explicit_coeff h hh).symm
  · rw [barrierDescartesTransform_coeff_zero_above _ _ _ _ (by omega)]
    symm
    apply coeff_eq_zero_of_natDegree_lt
    rw [barrierCase2AXTransform0Explicit_natDegree]
    omega

theorem barrierCase2AX_transform0_signVariations :
    (barrierDescartesTransform (barrierCase2AX.map (Rat.castHom ℝ))
      36 (-1) (0)).signVariations = 9 := by
  rw [barrierCase2AX_transform0_eq_explicit]
  have hd : barrierCase2AXTransform0Explicit.degree = 36 :=
    (degree_eq_iff_natDegree_eq_of_pos (show 0 < (36 : ℕ) by decide)).mpr
      barrierCase2AXTransform0Explicit_natDegree
  rw [signVariations, coeffList, hd]
  norm_num [barrierCase2AXTransform0Explicit_coeff, barrierCase2AXTransform0Coefficient,
    List.signVariations, List.range_succ, List.destutter, List.destutter', sign_apply,
    coeff_C_mul, coeff_X_pow, coeff_X]

theorem barrierCase2AX_transform0_positive_roots_le :
    (barrierDescartesTransform (barrierCase2AX.map (Rat.castHom ℝ))
      36 (-1) (0)).roots.countP (fun x => 0 < x) ≤ 9 := by
  have h := Polynomial.roots_countP_pos_le_signVariations
    (barrierDescartesTransform (barrierCase2AX.map (Rat.castHom ℝ)) 36 (-1) (0))
  simpa only [barrierCase2AX_transform0_signVariations] using h

