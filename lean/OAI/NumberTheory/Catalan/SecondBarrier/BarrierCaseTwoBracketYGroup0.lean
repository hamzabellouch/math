  intro k
  by_cases hk : k < 37
  · rw [barrierCase2AX_coeff_computed, barrierCase2AX_computed_coeff_small k hk,
      barrierCase2AXExplicit_coeff]
  · have hl : barrierCase2AX.coeff k = 0 :=
      coeff_eq_zero_of_natDegree_lt (by
        have h := barrierCase2AX_natDegree_le
        omega)
