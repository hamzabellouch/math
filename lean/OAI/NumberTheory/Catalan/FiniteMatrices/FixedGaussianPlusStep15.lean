theorem fixedGaussianPlusStep15_cells : ∀ r k : Fin 48,
    fixedGaussianPlusState16 r k =
      fixedGaussianStep fixedGaussianPlusState15 15 (fixedGaussianPlusRows 15) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianPlusState15 15
      (fixedGaussianPlusRows 15) 15 15)⁻¹ = (97 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianPlusState15 15
        (fixedGaussianPlusRows 15) 15 15 = (25 : ZMod 101) := by
      change fixedGaussianPlusState15 15 15 = (25 : ZMod 101)
      exact fixedGaussianPlusStep15_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 25 97
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianPlusState16 r k =
      (if (15 : Fin 48) < r then
