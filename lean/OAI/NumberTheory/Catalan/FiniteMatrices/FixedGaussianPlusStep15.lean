          (fixedGaussianSwap fixedGaussianPlusState15 15 (fixedGaussianPlusRows 15) r 15 *
            (97 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianPlusState15 15 (fixedGaussianPlusRows 15) 15 k
       else fixedGaussianSwap fixedGaussianPlusState15 15 (fixedGaussianPlusRows 15) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianPlusState16 r k =
