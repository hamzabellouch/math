theorem fixedGaussianMinusStep3_cells : ∀ r k : Fin 48,
    fixedGaussianMinusState4 r k =
      fixedGaussianStep fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianMinusState3 3
      (fixedGaussianMinusRows 3) 3 3)⁻¹ = (36 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianMinusState3 3
        (fixedGaussianMinusRows 3) 3 3 = (87 : ZMod 101) := by
      change fixedGaussianMinusState3 3 3 = (87 : ZMod 101)
      exact fixedGaussianMinusStep3_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 87 36
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianMinusState4 r k =
      (if (3 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r k -
          (fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r 3 *
            (36 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) 3 k
       else fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianMinusState4 r k =
        (if (3 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r k -
            (fixedGaussianSwap fixedGaussianMinusState3 3 (fixedGaussianMinusRows 3) r 3 *
              (36 : ZMod 101)) *
