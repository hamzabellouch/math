theorem fixedGaussianPlusStep1_pivot :
    fixedGaussianPivot fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1)
      (fixedGaussianPlusPivots 1) := by
  unfold fixedGaussianPivot
  let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
  let : Decidable (∀ j : Fin 48, (1 : Fin 48) ≤ j →
      j < fixedGaussianPlusRows 1 → fixedGaussianPlusState1 j 1 = 0) :=
    @Nat.decidableForallFin 48
      (fun j => (1 : Fin 48) ≤ j → j < fixedGaussianPlusRows 1 →
        fixedGaussianPlusState1 j 1 = 0) (fun j => inferInstance)
  exact of_decide_eq_true rfl

theorem fixedGaussianPlusStep1_cells : ∀ r k : Fin 48,
    fixedGaussianPlusState2 r k =
      fixedGaussianStep fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianPlusState1 1
      (fixedGaussianPlusRows 1) 1 1)⁻¹ = (2 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianPlusState1 1
        (fixedGaussianPlusRows 1) 1 1 = (51 : ZMod 101) := by
      change fixedGaussianPlusState1 1 1 = (51 : ZMod 101)
      exact fixedGaussianPlusStep1_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 51 2
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianPlusState2 r k =
      (if (1 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r k -
          (fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r 1 *
            (2 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) 1 k
       else fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianPlusState2 r k =
        (if (1 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r k -
            (fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r 1 *
              (2 : ZMod 101)) *
              fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) 1 k
         else fixedGaussianSwap fixedGaussianPlusState1 1 (fixedGaussianPlusRows 1) r k)) :=
      @Nat.decidableForallFin 48 _ (fun r =>
        @Nat.decidableForallFin 48 _ (fun k => inferInstance))
    exact of_decide_eq_true rfl
  let : Fact (Nat.Prime 101) := ⟨by decide⟩
  simpa only [fixedGaussianStep, div_eq_mul_inv, hinv] using hcells

