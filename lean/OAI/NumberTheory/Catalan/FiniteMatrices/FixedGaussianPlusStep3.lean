       else fixedGaussianSwap fixedGaussianPlusState3 3 (fixedGaussianPlusRows 3) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianPlusState4 r k =
