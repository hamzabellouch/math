    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 70 13
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianPlusState4 r k =
