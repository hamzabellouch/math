theorem fixedGaussianMinusStep1_pivot :
    fixedGaussianPivot fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1)
      (fixedGaussianMinusPivots 1) := by
  unfold fixedGaussianPivot
  let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
  let : Decidable (∀ j : Fin 48, (1 : Fin 48) ≤ j →
      j < fixedGaussianMinusRows 1 → fixedGaussianMinusState1 j 1 = 0) :=
    @Nat.decidableForallFin 48
      (fun j => (1 : Fin 48) ≤ j → j < fixedGaussianMinusRows 1 →
        fixedGaussianMinusState1 j 1 = 0) (fun j => inferInstance)
  exact of_decide_eq_true rfl

theorem fixedGaussianMinusStep1_cells : ∀ r k : Fin 48,
    fixedGaussianMinusState2 r k =
      fixedGaussianStep fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianMinusState1 1
      (fixedGaussianMinusRows 1) 1 1)⁻¹ = (56 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianMinusState1 1
        (fixedGaussianMinusRows 1) 1 1 = (92 : ZMod 101) := by
      change fixedGaussianMinusState1 1 1 = (92 : ZMod 101)
      exact fixedGaussianMinusStep1_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 92 56
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianMinusState2 r k =
      (if (1 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r k -
          (fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r 1 *
            (56 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) 1 k
       else fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianMinusState2 r k =
        (if (1 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r k -
            (fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r 1 *
              (56 : ZMod 101)) *
              fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) 1 k
         else fixedGaussianSwap fixedGaussianMinusState1 1 (fixedGaussianMinusRows 1) r k)) :=
      @Nat.decidableForallFin 48 _ (fun r =>
        @Nat.decidableForallFin 48 _ (fun k => inferInstance))
    exact of_decide_eq_true rfl
  let : Fact (Nat.Prime 101) := ⟨by decide⟩
  simpa only [fixedGaussianStep, div_eq_mul_inv, hinv] using hcells

