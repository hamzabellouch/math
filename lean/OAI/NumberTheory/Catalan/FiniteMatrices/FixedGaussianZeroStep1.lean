theorem fixedGaussianZeroStep1_cells : ∀ r k : Fin 48,
    fixedGaussianZeroState2 r k =
      fixedGaussianStep fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianZeroState1 1
      (fixedGaussianZeroRows 1) 1 1)⁻¹ = (52 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianZeroState1 1
        (fixedGaussianZeroRows 1) 1 1 = (68 : ZMod 101) := by
      change fixedGaussianZeroState1 1 1 = (68 : ZMod 101)
      exact fixedGaussianZeroStep1_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 68 52
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianZeroState2 r k =
      (if (1 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r k -
          (fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r 1 *
            (52 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) 1 k
       else fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianZeroState2 r k =
        (if (1 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r k -
            (fixedGaussianSwap fixedGaussianZeroState1 1 (fixedGaussianZeroRows 1) r 1 *
              (52 : ZMod 101)) *
