section

noncomputable section
namespace InternalCatalan

theorem fixedCanonicalMatrix_zero_mod :
    (fixedIntegerMatrix fixedIntegerBaseCanonical 0).map
      (fun x : ℤ => (x : ZMod 101)) = fixedLiteralModZero := by
  ext r k
  change ((fixedIntegerBaseCanonical r.castSucc k +
    0 * fixedIntegerBaseCanonical r.succ k : ℤ) : ZMod 101) = _
  rw [zero_mul, add_zero, fixedIntegerBaseCanonical_mod_eq]
  exact fixedLiteralBaseMod_zero r k

theorem fixedCanonicalMatrix_plus_mod :
    (fixedIntegerMatrix fixedIntegerBaseCanonical 1).map
      (fun x : ℤ => (x : ZMod 101)) = fixedLiteralModPlus := by
  ext r k
  change ((fixedIntegerBaseCanonical r.castSucc k +
    1 * fixedIntegerBaseCanonical r.succ k : ℤ) : ZMod 101) = _
  rw [one_mul, Int.cast_add, fixedIntegerBaseCanonical_mod_eq,
    fixedIntegerBaseCanonical_mod_eq]
  exact fixedLiteralBaseMod_plus r k

theorem fixedCanonicalMatrix_minus_mod :
    (fixedIntegerMatrix fixedIntegerBaseCanonical (-1)).map
      (fun x : ℤ => (x : ZMod 101)) = fixedLiteralModMinus := by
  ext r k
  change ((fixedIntegerBaseCanonical r.castSucc k +
    (-1) * fixedIntegerBaseCanonical r.succ k : ℤ) : ZMod 101) = _
  rw [neg_one_mul, Int.cast_add, Int.cast_neg,
    fixedIntegerBaseCanonical_mod_eq, fixedIntegerBaseCanonical_mod_eq]
  simpa only [sub_eq_add_neg] using fixedLiteralBaseMod_minus r k

end InternalCatalan

end

