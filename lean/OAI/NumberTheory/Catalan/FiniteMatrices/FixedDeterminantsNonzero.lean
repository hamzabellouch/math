section

noncomputable section
namespace InternalCatalan

theorem fixedMatrix_zero_det_ne_zero : (fixedMatrix 0).det ≠ 0 := by
  have hmod : ((fixedIntegerMatrix fixedIntegerBaseCanonical 0).map
      (fun x : ℤ => (x : ZMod 101))).det ≠ 0 := by
    rw [fixedCanonicalMatrix_zero_mod]
    exact fixedLiteralModZero_det_ne_zero
  simpa only [Int.cast_zero] using
    fixedMatrix_det_ne_zero_of_base_certificate fixedIntegerBaseCanonical
      854041599922236190937524347070927377276592590715779683450880000 0
      fixedIntegerBaseCanonical_cast hmod

theorem fixedMatrix_one_det_ne_zero : (fixedMatrix 1).det ≠ 0 := by
  have hmod : ((fixedIntegerMatrix fixedIntegerBaseCanonical 1).map
      (fun x : ℤ => (x : ZMod 101))).det ≠ 0 := by
    rw [fixedCanonicalMatrix_plus_mod]
    exact fixedLiteralModPlus_det_ne_zero
  simpa only [Int.cast_one] using
    fixedMatrix_det_ne_zero_of_base_certificate fixedIntegerBaseCanonical
      854041599922236190937524347070927377276592590715779683450880000 1
      fixedIntegerBaseCanonical_cast hmod

theorem fixedMatrix_neg_one_det_ne_zero : (fixedMatrix (-1)).det ≠ 0 := by
  have hmod : ((fixedIntegerMatrix fixedIntegerBaseCanonical (-1)).map
      (fun x : ℤ => (x : ZMod 101))).det ≠ 0 := by
    rw [fixedCanonicalMatrix_minus_mod]
    exact fixedLiteralModMinus_det_ne_zero
  simpa only [Int.cast_neg, Int.cast_one] using
    fixedMatrix_det_ne_zero_of_base_certificate fixedIntegerBaseCanonical
      854041599922236190937524347070927377276592590715779683450880000 (-1)
      fixedIntegerBaseCanonical_cast hmod

end InternalCatalan

