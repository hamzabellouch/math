theorem fixedGaussianPlusStep2_cells : ∀ r k : Fin 48,
    fixedGaussianPlusState3 r k =
      fixedGaussianStep fixedGaussianPlusState2 2 (fixedGaussianPlusRows 2) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianPlusState2 2
      (fixedGaussianPlusRows 2) 2 2)⁻¹ = (55 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianPlusState2 2
        (fixedGaussianPlusRows 2) 2 2 = (90 : ZMod 101) := by
      change fixedGaussianPlusState2 2 2 = (90 : ZMod 101)
      exact fixedGaussianPlusStep2_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 90 55
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianPlusState3 r k =
      (if (2 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianPlusState2 2 (fixedGaussianPlusRows 2) r k -
          (fixedGaussianSwap fixedGaussianPlusState2 2 (fixedGaussianPlusRows 2) r 2 *
            (55 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianPlusState2 2 (fixedGaussianPlusRows 2) 2 k
       else fixedGaussianSwap fixedGaussianPlusState2 2 (fixedGaussianPlusRows 2) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianPlusState3 r k =
