theorem fixedGaussianMinusStep7_cells : ∀ r k : Fin 48,
    fixedGaussianMinusState8 r k =
      fixedGaussianStep fixedGaussianMinusState7 7 (fixedGaussianMinusRows 7) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianMinusState7 7
      (fixedGaussianMinusRows 7) 7 7)⁻¹ = (31 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianMinusState7 7
        (fixedGaussianMinusRows 7) 7 7 = (88 : ZMod 101) := by
      change fixedGaussianMinusState7 7 7 = (88 : ZMod 101)
      exact fixedGaussianMinusStep7_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 88 31
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianMinusState8 r k =
      (if (7 : Fin 48) < r then
