       else fixedGaussianSwap fixedGaussianMinusState7 7 (fixedGaussianMinusRows 7) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianMinusState8 r k =
