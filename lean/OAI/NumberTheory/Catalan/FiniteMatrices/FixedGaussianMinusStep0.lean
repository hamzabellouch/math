theorem fixedGaussianMinusStep0_cells : ∀ r k : Fin 48,
    fixedGaussianMinusState1 r k =
      fixedGaussianStep fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianMinusState0 0
      (fixedGaussianMinusRows 0) 0 0)⁻¹ = (85 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianMinusState0 0
        (fixedGaussianMinusRows 0) 0 0 = (82 : ZMod 101) := by
      change fixedGaussianMinusState0 0 0 = (82 : ZMod 101)
      exact fixedGaussianMinusStep0_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 82 85
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianMinusState1 r k =
      (if (0 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r k -
          (fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r 0 *
            (85 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) 0 k
       else fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianMinusState1 r k =
        (if (0 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r k -
            (fixedGaussianSwap fixedGaussianMinusState0 0 (fixedGaussianMinusRows 0) r 0 *
              (85 : ZMod 101)) *
