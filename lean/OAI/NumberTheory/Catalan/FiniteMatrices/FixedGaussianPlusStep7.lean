theorem fixedGaussianPlusStep7_pivot :
    fixedGaussianPivot fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7)
      (fixedGaussianPlusPivots 7) := by
  unfold fixedGaussianPivot
  let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
  let : Decidable (∀ j : Fin 48, (7 : Fin 48) ≤ j →
      j < fixedGaussianPlusRows 7 → fixedGaussianPlusState7 j 7 = 0) :=
    @Nat.decidableForallFin 48
      (fun j => (7 : Fin 48) ≤ j → j < fixedGaussianPlusRows 7 →
        fixedGaussianPlusState7 j 7 = 0) (fun j => inferInstance)
  exact of_decide_eq_true rfl

theorem fixedGaussianPlusStep7_cells : ∀ r k : Fin 48,
    fixedGaussianPlusState8 r k =
      fixedGaussianStep fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r k := by
  have hinv : (fixedGaussianSwap fixedGaussianPlusState7 7
      (fixedGaussianPlusRows 7) 7 7)⁻¹ = (90 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianPlusState7 7
        (fixedGaussianPlusRows 7) 7 7 = (55 : ZMod 101) := by
      change fixedGaussianPlusState7 7 7 = (55 : ZMod 101)
      exact fixedGaussianPlusStep7_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 55 90
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianPlusState8 r k =
      (if (7 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r k -
          (fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r 7 *
            (90 : ZMod 101)) *
            fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) 7 k
       else fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianPlusState8 r k =
        (if (7 : Fin 48) < r then
          fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r k -
            (fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r 7 *
              (90 : ZMod 101)) *
