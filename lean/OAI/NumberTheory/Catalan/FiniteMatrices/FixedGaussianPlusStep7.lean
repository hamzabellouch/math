         else fixedGaussianSwap fixedGaussianPlusState7 7 (fixedGaussianPlusRows 7) r k)) :=
      @Nat.decidableForallFin 48 _ (fun r =>
        @Nat.decidableForallFin 48 _ (fun k => inferInstance))
    exact of_decide_eq_true rfl
  let : Fact (Nat.Prime 101) := ⟨by decide⟩
  simpa only [fixedGaussianStep, div_eq_mul_inv, hinv] using hcells

