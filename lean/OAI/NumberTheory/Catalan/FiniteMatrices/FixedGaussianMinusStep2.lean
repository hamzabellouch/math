  have hinv : (fixedGaussianSwap fixedGaussianMinusState2 2
      (fixedGaussianMinusRows 2) 2 2)⁻¹ = (35 : ZMod 101) := by
    have hpivot : fixedGaussianSwap fixedGaussianMinusState2 2
        (fixedGaussianMinusRows 2) 2 2 = (26 : ZMod 101) := by
