       else fixedGaussianSwap fixedGaussianMinusState2 2 (fixedGaussianMinusRows 2) r k) := by
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    let : Decidable (∀ r k : Fin 48, fixedGaussianMinusState3 r k =
