      exact fixedGaussianMinusStep2_pivot.2.2.2
    rw [hpivot]
    apply ZMod.inv_eq_of_mul_eq_one 101 26 35
    let : DecidableEq (ZMod 101) := inferInstanceAs (DecidableEq (Fin 101))
    exact of_decide_eq_true rfl
  have hcells : ∀ r k : Fin 48, fixedGaussianMinusState3 r k =
      (if (2 : Fin 48) < r then
        fixedGaussianSwap fixedGaussianMinusState2 2 (fixedGaussianMinusRows 2) r k -
          (fixedGaussianSwap fixedGaussianMinusState2 2 (fixedGaussianMinusRows 2) r 2 *
            (35 : ZMod 101)) *
