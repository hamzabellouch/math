theorem residual_coefficients_enclosed (f : EulerFormal.Series)
    (hf : ∀ n, Holds Q (u n) (PowerSeries.coeff n f))
    (hf0 : ∀ n, 220<n → PowerSeries.coeff n f=0) (k : ℕ)
    (hk : 140≤k) (hk' : k≤881) :
    Holds Q (r k) (PowerSeries.coeff k (EulerFormal.residual sigma kappa ((3/5 : ℚ) : ℝ) ((1/500 : ℚ) : ℝ) f)) := by
  obtain ⟨hb,hc,hd⟩ := powers_enclosed Q_pos 9 220 (by norm_num) trace validPowers f hf hf0
  rw [residual_data k hk hk']
  exact residual_enclosed sigma kappa (3/5) (1/500) trace f k (by omega) hf hb hc hd
