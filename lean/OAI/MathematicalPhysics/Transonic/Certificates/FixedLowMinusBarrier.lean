  square := fun n hn => square_data n (by omega) hn
  cube := fun n hn => cube_data n (by omega) hn
  fourth := fun n hn => fourth_data n (by omega) hn
  bZero := by intro n hn; change b n=zero; rw [b,ite_eq_right (by omega)]
  cZero := by intro n hn; change c n=zero; rw [c,ite_eq_right (by omega)]
  dZero := by intro n hn; change d n=zero; rw [d,ite_eq_right (by omega)]

