theorem produces {t : ℝ} (ht : t∈Set.Icc lo hi)
    (u : PowerSeries ℝ) (hu0 : PowerSeries.coeff 0 u=1)
    (hu1 : PowerSeries.coeff 1 u=ShootingParameters.slope t)
    (he : Formal.residual (ShootingParameters.sigma t) (ShootingParameters.kappa t) (3/5) u=0) :
    (∃ d : ℝ, ExteriorPolynomial.AdmissibleWindow (ShootingParameters.sigma t)
      (ShootingParameters.kappa t) d u) ∧ 0<PowerSeries.coeff 74 u := by
  have ht0 : t∈Set.Icc ShootingParameters.leftEnd ShootingParameters.rightEnd :=
    ⟨lo_mem.1.trans ht.1,ht.2.trans hi_mem.2⟩
  have hs := sig_mem ht
  have hk := kap_mem ht
  have hst : Holds Q st (ShootingParameters.slope t/256) := by
    rw [st_eq]
    simpa only [Int.cast_one,Int.cast_ofNat,one_div_mul_eq_div] using holds_scale (a:=1) (b:=256) (by norm_num) (s_mem ht)
  have h1 : Holds Q (trace.b 1) (ShootingParameters.slope t/256) := by rwa [b1_eq]
  have hw : WeightsHold Q weights (1/256) (ShootingParameters.sigma t) (ShootingParameters.kappa t) (3/5) := by
    rw [weights_eq]
    exact sourceWeights_hold qpos hs hk
  have hd (n : ℕ) (hn : 2≤n) (hn1 : n≤73) : Holds Q (trace.den n)
      (2*(1-ShootingParameters.sigma t)*(ShootingParameters.slope t/256)*(ShootingParameters.ratio t-n)) := by
    rw [den_eq n hn (by omega)]
    apply sourceDen_hold qpos n
    · rw [L0_eq]
      exact sourceL0_hold qpos hs hst
    · exact rho_mem ht
  exact certificate_produces_window qpos weights trace valid row74 num74_pos ht0
    sig kap hs hk hw h1 hd window window_valid u hu0 hu1 he
