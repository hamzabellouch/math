import OAI.GroupTheory.PolycyclicRecognition.Geometry.CartanDecomposition

namespace OAI

/-! # The subalgebra generated by nonzero roots

The subalgebra generated by the nonzero root spaces is already an ideal.
Thus taking the ideal generated by them in the Cartan construction does not
enlarge the subgroup that must later be integrated.
-/

noncomputable section

namespace PolycyclicRecognition

open LieAlgebra LieModule

variable {L : Type*} [LieRing L] [LieAlgebra ℝ L]
  (H : LieSubalgebra ℝ L) [H.IsCartanSubalgebra]

def cartanRootSubalgebra : LieSubalgebra ℝ L :=
  LieSubalgebra.lieSpan ℝ L
    {v | ∃ χ : Weight ℝ H L, χ.IsNonZero ∧ v ∈ rootSpace H χ}

theorem cartanRootSubalgebra_stable (h : H) {v : L}
    (hv : v ∈ cartanRootSubalgebra H) : ⁅(h : L), v⁆ ∈ cartanRootSubalgebra H := by
  induction hv using LieSubalgebra.lieSpan_induction with
  | mem v hv =>
    obtain ⟨χ, hχ, hv⟩ := hv
    apply LieSubalgebra.subset_lieSpan
    exact ⟨χ, hχ, (rootSpace H χ).lie_mem hv⟩
  | zero => simp only [lie_zero]; exact (cartanRootSubalgebra H).zero_mem
  | add x y _ _ hx hy =>
    rw [lie_add]
    exact (cartanRootSubalgebra H).add_mem hx hy
  | smul a x _ hx =>
    rw [lie_smul]
    exact (cartanRootSubalgebra H).smul_mem a hx
  | lie x y hx hy ihx ihy =>
    rw [leibniz_lie]
    exact (cartanRootSubalgebra H).add_mem
      ((cartanRootSubalgebra H).lie_mem ihx hy)
      ((cartanRootSubalgebra H).lie_mem hx ihy)

/-- Regard the generated subalgebra as a module for the Cartan subalgebra. -/
def cartanRootSubmodule : LieSubmodule ℝ H L where
  __ := (cartanRootSubalgebra H).toSubmodule
  lie_mem := by intro h v hv; exact cartanRootSubalgebra_stable H h hv

theorem cartanRootSubalgebra_sup_cartan [FiniteDimensional ℝ L]
    {n : ℕ} (T : TriangularAdjoint L n) :
    (cartanRootSubalgebra H).toSubmodule ⊔ H.toSubmodule = ⊤ := by
  let := T.isTriangularizable
  have hroot : (⨆ χ : Weight ℝ H L, ⨆ (_ : χ.IsNonZero), rootSpace H χ) ≤
      cartanRootSubmodule H := by
    apply iSup_le
    intro χ
    apply iSup_le
    intro hχ v hv
    exact LieSubalgebra.subset_lieSpan ⟨χ, hχ, hv⟩
  have hh : H.toLieSubmodule ⊔ cartanRootSubmodule H = ⊤ := by
    apply top_unique
    rw [← cartan_sup_iSup_rootSpace_eq_top (H := H)]
    exact sup_le_sup le_rfl hroot
  have heq := congrArg LieSubmodule.toSubmodule hh
  change H.toSubmodule ⊔ (cartanRootSubalgebra H).toSubmodule = ⊤ at heq
  simpa only [sup_comm] using heq

theorem cartanRootSubalgebra_ideal [FiniteDimensional ℝ L]
    {n : ℕ} (T : TriangularAdjoint L n) (x y : L)
    (hy : y ∈ cartanRootSubalgebra H) : ⁅x, y⁆ ∈ cartanRootSubalgebra H := by
  have hx : x ∈ (cartanRootSubalgebra H).toSubmodule ⊔ H.toSubmodule := by
    rw [cartanRootSubalgebra_sup_cartan H T]
    trivial
  obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_lie]
  exact (cartanRootSubalgebra H).add_mem
    ((cartanRootSubalgebra H).lie_mem hu hy)
    (cartanRootSubalgebra_stable H ⟨v, hv⟩ hy)

/-- The actual generated subalgebra equals the ideal used in the model. -/
theorem cartanRootSubalgebra_eq_ideal [FiniteDimensional ℝ L]
    {n : ℕ} (T : TriangularAdjoint L n) :
    (cartanRootSubalgebra H).toSubmodule = (cartanRootIdeal H).toSubmodule := by
  apply le_antisymm
  · change cartanRootSubalgebra H ≤ (cartanRootIdeal H).toLieSubalgebra
    apply LieSubalgebra.lieSpan_le.mpr
    exact LieSubmodule.subset_lieSpan
  · let I : LieIdeal ℝ L :=
      { (cartanRootSubalgebra H).toSubmodule with
        lie_mem := by intro x y hy; exact cartanRootSubalgebra_ideal H T x y hy }
    change cartanRootIdeal H ≤ I
    apply LieSubmodule.lieSpan_le.mpr
    exact LieSubalgebra.subset_lieSpan

end PolycyclicRecognition

end

end OAI
