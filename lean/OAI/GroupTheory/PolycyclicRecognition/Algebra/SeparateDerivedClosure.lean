import OAI.GroupTheory.PolycyclicRecognition.Algebra.SeparateConnectedGeneration
import Mathlib.GroupTheory.Solvable

namespace OAI

/-! # Derived subgroups in the polynomial group topology

Separate continuity of commutators passes derived-series bounds to closure.
It also makes the subgroup generated by the commutators of connected
subgroups connected. These are the two closure facts required in the
solvable matrix-group argument.
-/

noncomputable section
namespace PolycyclicRecognition

open scoped commutatorElement
variable {G : Type*} [Group G] [TopologicalSpace G]
  [SeparatelyContinuousMul G] [ContinuousInv G]
  (hc₁ : ∀ g : G, Continuous (fun h : G => ⁅g, h⁆))
  (hc₂ : ∀ h : G, Continuous (fun g : G => ⁅g, h⁆))

include hc₁ hc₂

theorem commutator_separateClosure_le (S T : Subgroup G) :
    ⁅separateClosure S, separateClosure T⁆ ≤ separateClosure ⁅S, T⁆ := by
  apply Subgroup.commutator_le.mpr
  intro g hg h hh
  exact map_mem_closure₂' hc₁ hc₂ hg hh
    (fun _ ha _ hb => Subgroup.commutator_mem_commutator ha hb)

theorem isSolvable_separateClosure [T1Space G] (S : Subgroup G) [Group.IsSolvable S] :
    Group.IsSolvable (separateClosure S) := by
  let C := separateClosure S
  have hbound (n : ℕ) : (derivedSeries C n).map C.subtype ≤
      separateClosure ((derivedSeries S n).map S.subtype) := by
    induction n with
    | zero => simp only [derivedSeries_zero, Subgroup.map_top, Subgroup.range_subtype]; exact le_rfl
    | succ n ih =>
      simp only [derivedSeries_succ, Subgroup.map_commutator]
      exact (Subgroup.commutator_mono ih ih).trans (commutator_separateClosure_le hc₁ hc₂ _ _)
  obtain ⟨n, hn⟩ := Group.IsSolvable.solvable (G := S)
  have hbot : separateClosure (⊥ : Subgroup G) = ⊥ := by
    ext g
    change g ∈ closure ({1} : Set G) ↔ g = 1
    rw [isClosed_singleton.closure_eq]
    rfl
  refine ⟨⟨n, ?_⟩⟩
  apply Subgroup.map_injective (f := C.subtype) Subtype.val_injective
  rw [Subgroup.map_bot]
  apply eq_bot_iff.mpr
  simpa only [hn, Subgroup.map_bot, hbot] using hbound n

theorem isPreconnected_commutator (S T : Subgroup G)
    (hS : IsPreconnected (S : Set G)) (hT : IsPreconnected (T : Set G)) :
    IsPreconnected ((⁅S, T⁆ : Subgroup G) : Set G) := by
  rw [Subgroup.commutator_def]
  apply isPreconnected_subgroup_closure
  · exact isPreconnected_image2_separate (fun g h : G => ⁅g, h⁆) hc₁ hc₂ hS hT
  · exact ⟨1, S.one_mem, 1, T.one_mem, by simp⟩

end PolycyclicRecognition

end

end OAI
