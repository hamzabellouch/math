import OAI.GroupTheory.PolycyclicRecognition.Algebra.FiniteModuleIndependentBound
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

namespace OAI

/-! # Finite commutative algebras generated by integral operators -/

noncomputable section
namespace PolycyclicRecognition
open scoped IsMulCommutative

section Commuting
variable {R E : Type} [CommRing R] [Ring E] [Algebra R E]
  {k : ℕ} (s : Fin k → E) (h : ∀ i j, Commute (s i) (s j))

include h in
theorem commuting_adjoin_isMulCommutative :
    IsMulCommutative (Algebra.adjoin R (Set.range s)) := by
  apply Algebra.isMulCommutative_adjoin R
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
  exact h i j

include h in
theorem commuting_adjoin_finite [Algebra.IsIntegral R E] :
    Module.Finite R (Algebra.adjoin R (Set.range s)) := by
  let := commuting_adjoin_isMulCommutative (R := R) s h
  let C := Algebra.adjoin R (Set.range s)
  let := Algebra.IsIntegral.of_injective C.val Subtype.val_injective
  have hfg : C.FG := Subalgebra.fg_def.mpr ⟨Set.range s, Set.finite_range s, rfl⟩
  let := C.fg_iff_finiteType.mp hfg
  exact Algebra.IsIntegral.finite
/-- Evaluate commuting operators by passing through their commutative generated algebra. -/
def commutingOperatorEval (K : Type) [CommRing K] {E : Type} [Ring E] [Algebra K E]
    {k : ℕ} (s : Fin k → E) (h : ∀ i j, Commute (s i) (s j)) :
    MvPolynomial (Fin k) K →ₐ[K] E := by
  let := commuting_adjoin_isMulCommutative (R := K) s h
  let C := Algebra.adjoin K (Set.range s)
  exact C.val.comp (MvPolynomial.aeval (fun i => (⟨s i, Algebra.subset_adjoin
    (Set.mem_range_self i)⟩ : C)))

@[simp] theorem commutingOperatorEval_X (K : Type) [CommRing K] {E : Type}
    [Ring E] [Algebra K E] {k : ℕ} (s : Fin k → E) (h : ∀ i j, Commute (s i) (s j))
    (i : Fin k) : commutingOperatorEval K s h (MvPolynomial.X i) = s i := by
  simp only [commutingOperatorEval, AlgHom.comp_apply, MvPolynomial.aeval_X,
    Subalgebra.val_apply]

end Commuting

section Relations
variable {K R C B : Type} [Field K] [CommRing R] [CommRing C] [CommRing B]
  [Algebra K R] [Algebra K C] [Algebra K B] [Algebra R C] [IsScalarTower K R C]

/-- Relations in a finite algebra bound every independent family in a quotient
of any of its finitely generated subalgebras. No domain assumption on C is needed. -/
theorem relation_quotient_independent_bound {r k n : ℕ}
    (a : Fin r → R) (ha : Algebra.adjoin K (Set.range a) = ⊤)
    [Module.Finite R C] (f : MvPolynomial (Fin k) K →ₐ[K] C)
    (β : MvPolynomial (Fin k) K →ₐ[K] B) (hβ : Function.Surjective β)
    (hker : ∀ p, f p = 0 → β p = 0)
    (x : Fin n → B) (hx : AlgebraicIndependent K x) : n ≤ r := by
  let ψ : MvPolynomial (Fin k) K →ₐ[K] f.range := f.rangeRestrict
  have hker' : RingHom.ker ψ.toRingHom ≤ RingHom.ker β.toRingHom := by
    intro p hp
    change ψ p = 0 at hp
    change β p = 0
    apply hker
    exact congrArg Subtype.val hp
  let g : f.range →ₐ[K] B := AlgHom.liftOfSurjective ψ f.rangeRestrict_surjective β hker'
  have hg : Function.Surjective g :=
    AlgHom.liftOfSurjective_surjective ψ f.rangeRestrict_surjective β hker' hβ
  choose y hy using fun i => hg (x i)
  have hy' : AlgebraicIndependent K y := by
    apply AlgebraicIndependent.of_comp g
    simpa only [Function.comp_def, hy] using hx
  exact algebraicIndependent_card_le_of_finite_module a ha
    (fun i => (y i).val) (hy'.map' (f := f.range.val) Subtype.val_injective)
end Relations
end PolycyclicRecognition

end

end OAI
