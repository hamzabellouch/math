import OAI.GroupTheory.PolycyclicRecognition.Algebra.RationalNilpotentTorsion
import OAI.GroupTheory.PolycyclicRecognition.Finiteness.LocallyFiniteRationalHomology

namespace OAI

/-! # The characteristic torsion subgroup of a nilpotent group

Zero rational abelianization shows that a subgroup generated by torsion
elements is torsion. This constructs the subgroup and its torsion-free
quotient without a finite-generation premise.
-/
noncomputable section
namespace PolycyclicRecognition
open CategoryTheory
variable {G : Type} [Group G] [Group.IsNilpotent G]

theorem nilpotent_torsion_closure (S : Set G) (hS : ∀ g ∈ S, IsOfFinOrder g) :
    ∀ g ∈ Subgroup.closure S, IsOfFinOrder g := by
  let H := Subgroup.closure S
  let π := Abelianization.of (G := H)
  let T := (CommGroup.torsion (Abelianization H)).comap π
  have hHT : H ≤ T.map H.subtype := by
    change Subgroup.closure S ≤ T.map H.subtype
    rw [Subgroup.closure_le]
    intro g hg
    let a : H := ⟨g, Subgroup.subset_closure hg⟩
    refine ⟨a, ?_, rfl⟩
    change IsOfFinOrder (π a)
    obtain ⟨n, hn, he⟩ := (hS g hg).exists_pow_eq_one
    apply isOfFinOrder_iff_pow_eq_one.mpr
    refine ⟨n, hn, ?_⟩
    rw [← map_pow]
    have ha : a ^ n = 1 := Subtype.ext he
    rw [ha, map_one]
  have hHAb : ∀ a : Abelianization H, IsOfFinOrder a := by
    intro a
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (commutator H) a
    obtain ⟨b, hb, he⟩ := hHT g.property
    have hbg : b = g := Subtype.ext he
    exact hbg ▸ hb
  have ht : ∀ g : H, IsOfFinOrder g :=
    nilpotent_torsion_of_rational_abelianization_isZero
      (rationalAbelianSpace_isZero_iff_torsion.mpr hHAb)
  intro g hg
  obtain ⟨n, hn, he⟩ := (ht ⟨g, hg⟩).exists_pow_eq_one
  exact isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, congrArg Subtype.val he⟩

theorem nilpotent_torsion_mul {a b : G} (ha : IsOfFinOrder a) (hb : IsOfFinOrder b) :
    IsOfFinOrder (a * b) := by
  apply nilpotent_torsion_closure {a, b}
  · intro g hg
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact ha
    · exact Set.mem_singleton_iff.mp hg ▸ hb
  · exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp))

def nilpotentTorsionSubgroup : Subgroup G where
  carrier := {g | IsOfFinOrder g}
  one_mem' := isOfFinOrder_iff_pow_eq_one.mpr ⟨1, Nat.zero_lt_one, one_pow 1⟩
  mul_mem' := nilpotent_torsion_mul
  inv_mem' := IsOfFinOrder.inv

@[simp] theorem mem_nilpotentTorsionSubgroup (g : G) :
    g ∈ nilpotentTorsionSubgroup ↔ IsOfFinOrder g := Iff.rfl

instance nilpotentTorsionSubgroup_characteristic :
    (nilpotentTorsionSubgroup (G := G)).Characteristic := by
  apply Subgroup.characteristic_iff_map_le.mpr
  intro e g hg
  obtain ⟨a, ha, rfl⟩ := hg
  obtain ⟨n, hn, he⟩ := ha.exists_pow_eq_one
  apply isOfFinOrder_iff_pow_eq_one.mpr
  exact ⟨n, hn, by rw [← map_pow, he, map_one]⟩

theorem nilpotentTorsionQuotient_torsionFree :
    HasNoNontrivialTorsion (G ⧸ nilpotentTorsionSubgroup) := by
  intro a n hn ha
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (nilpotentTorsionSubgroup (G := G)) a
  apply (QuotientGroup.eq_one_iff g).mpr
  have hg : g ^ n ∈ nilpotentTorsionSubgroup :=
    (QuotientGroup.eq_one_iff _).mp (by
      change (QuotientGroup.mk' nilpotentTorsionSubgroup) (g ^ n) = 1
      rw [map_pow]
      exact ha)
  obtain ⟨m, hm, he⟩ := hg.exists_pow_eq_one
  exact isOfFinOrder_iff_pow_eq_one.mpr
    ⟨n * m, Nat.mul_pos (Nat.pos_of_ne_zero hn) hm, by simpa only [pow_mul] using he⟩

def nilpotentTorsionQuotientRationalHomologyIso [Countable G] (n : ℕ) :
    rationalModuleFunctor.obj (groupHomology (trivialIntegral G) n) ≅
      rationalModuleFunctor.obj (groupHomology (trivialIntegral
        (G ⧸ nilpotentTorsionSubgroup)) n) :=
  torsionNilpotentKernelRationalHomologyIso nilpotentTorsionSubgroup
    (fun g => by
      obtain ⟨k, hk, he⟩ := g.property.exists_pow_eq_one
      exact isOfFinOrder_iff_pow_eq_one.mpr ⟨k, hk, Subtype.ext he⟩) n

theorem finitelyGenerated_torsion_nilpotent_finite [Group.FG G]
    (ht : ∀ g : G, IsOfFinOrder g) : Finite G := by
  obtain ⟨U, hU, htf⟩ :=
    (isPolycyclic_of_finitelyGenerated_nilpotent G).exists_torsionFree_finiteIndex
  have hone (g : U) : g = 1 := by
    obtain ⟨n, hn, hg⟩ := (ht g).exists_pow_eq_one
    exact htf g n (Nat.ne_of_gt hn) (Subtype.ext hg)
  let : Subsingleton U := ⟨fun a b => (hone a).trans (hone b).symm⟩
  exact (Subgroup.finite_iff_finite_and_finiteIndex U).mpr ⟨inferInstance, hU⟩

theorem nilpotentTorsionSubgroup_locallyFinite
    (H : Subgroup (nilpotentTorsionSubgroup (G := G))) (hH : H.FG) : Finite H := by
  let : Group.FG H := (Group.fg_iff_subgroup_fg _).mpr hH
  apply finitelyGenerated_torsion_nilpotent_finite
  intro g
  obtain ⟨n, hn, hg⟩ := g.val.property.exists_pow_eq_one
  exact isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, Subtype.ext (Subtype.ext hg)⟩

def nilpotentTorsionQuotientRationalAbelianizationEquiv [Countable G] :
    RationalAbelianSpace (Abelianization G) ≃ₗ[ℚ]
      RationalAbelianSpace (Abelianization (G ⧸ nilpotentTorsionSubgroup)) :=
  (rationalH1AbelianizationEquiv (G := G)).symm ≪≫ₗ
    (nilpotentTorsionQuotientRationalHomologyIso (G := G) 1).toLinearEquiv ≪≫ₗ
    rationalH1AbelianizationEquiv

theorem nilpotentTorsionQuotient_finiteDimension_of_finite_abelianization [Countable G]
    [Module.Finite ℚ (RationalAbelianSpace (Abelianization G))] :
    HasFiniteIntegralCohomologicalDimension (G ⧸ nilpotentTorsionSubgroup) := by
  let : Countable (G ⧸ nilpotentTorsionSubgroup) :=
    Function.Surjective.countable (QuotientGroup.mk'_surjective nilpotentTorsionSubgroup)
  let e := nilpotentTorsionQuotientRationalAbelianizationEquiv (G := G)
  let : Module.Finite ℚ
      (RationalAbelianSpace (Abelianization (G ⧸ nilpotentTorsionSubgroup))) :=
    Module.Finite.equiv e
  exact nilpotent_finiteDimension_of_finite_abelianization
    nilpotentTorsionQuotient_torsionFree

end PolycyclicRecognition

end

end OAI
