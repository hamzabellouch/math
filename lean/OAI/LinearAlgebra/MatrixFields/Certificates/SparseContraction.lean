def leafRateBall : Fin 9 → Ball := (Matrix.vecCons (leafRateBall0) (Matrix.vecCons (leafRateBall1) (Matrix.vecCons (leafRateBall2) (Matrix.vecCons (leafRateBall3) (Matrix.vecCons (leafRateBall4) (Matrix.vecCons (leafRateBall5) (Matrix.vecCons (leafRateBall6) (Matrix.vecCons (leafRateBall7) (Matrix.vecCons (leafRateBall8) Matrix.vecEmpty)))))))))
lemma leafRateBall_sound (k : Fin 9) :
    (leafRateBall k).Encloses (initialRate (zeroLeafShape k)) := by
  fin_cases k
  · exact leafRateBall0_sound
  · exact leafRateBall1_sound
  · exact leafRateBall2_sound
  · exact leafRateBall3_sound
  · exact leafRateBall4_sound
  · exact leafRateBall5_sound
  · exact leafRateBall6_sound
  · exact leafRateBall7_sound
  · exact leafRateBall8_sound
def initialVolumeRawBall : Ball := finSumBall 9 (fun k =>
  .mul (initialLawBall (zeroLeafShape k)) (leafRateBall k))

lemma initialVolumeRawBall_sound : initialVolumeRawBall.Encloses S0 := by
  rw [nativeS0_eq_sum]
  apply finSumBall_sound
  intro k
  exact Ball.mul_sound (initialLawBall_sound _ (zeroLeafShape_mem k))
    (leafRateBall_sound k)
def initialVolumeBall : Ball := ⟨(3170407140796466915468826036527 / 100000000000000000000000000000000), (249845433 / 25000000000000000000000000000000)⟩
theorem nativeS0_enclosed : initialVolumeBall.Encloses S0 := by
  exact contains_sound initialVolumeRawBall_sound (by decide +kernel)
theorem nativeS0_strict_bounds :
    (3170407140796466915 : ℝ) / 100000000000000000000 < S0 ∧ S0 < (3170407140796466916 : ℝ) / 100000000000000000000 := by
  obtain ⟨hl,hu⟩ := Ball.bounds nativeS0_enclosed
  norm_num [initialVolumeBall, Ball.lower, Ball.upper] at hl hu ⊢
  constructor <;> linarith
