    (Ball.exact_sound ((∑ w : Fin 3, if sortedInitial.get g w = k.val then (1 : ℚ) else 0) / 3))
  convert h using 1
  simp only [Rat.cast_div, Rat.cast_sum, apply_ite, Rat.cast_one,
    Rat.cast_zero, Rat.cast_ofNat, mul_div_assoc]

