lemma Z0_4_4Den_sound : Z0_4_4Den.Encloses
    (((orderedPairs (shape 0 4 4)).map (fun ij => weight (orderedPairInteger (shape 0 4 4) ij.1 ij.2))).sum : ℝ) := by
  exact contains_sound (list_cast_enclosed (orderedPairs (shape 0 4 4)) Z0_4_4Raw
    (fun ij => weight (orderedPairInteger (shape 0 4 4) ij.1 ij.2))
    (fun ij _ => Z0_4_4Raw_sound ij)) (by decide +kernel)
lemma Z0_4_4Den_pos : 0 < Z0_4_4Den.lower := by decide +kernel
def Z0_4_4Probs (ij : PairSlot) : Ball :=
  match ij.1.val, ij.2.val with
  | 0, 5 => ⟨(7494452423922705001235812089 / 4000000000000000000000000000000), (1 / 100000000000000000000000000000000)⟩
  | 1, 4 => ⟨(1261243984157612676036813528611 / 10000000000000000000000000000000), (27 / 100000000000000000000000000000000)⟩
  | 2, 2 => ⟨(61165519013116834840287783186423 / 100000000000000000000000000000000), (7 / 6250000000000000000000000000000)⟩
  | 2, 3 => ⟨(784932206749518952016351104847 / 12500000000000000000000000000000), (7 / 50000000000000000000000000000000)⟩
  | 3, 2 => ⟨(784932206749518952016351104847 / 12500000000000000000000000000000), (7 / 50000000000000000000000000000000)⟩
  | 3, 3 => ⟨(675963374542473156652537959353 / 100000000000000000000000000000000), (1 / 100000000000000000000000000000000)⟩
  | 4, 1 => ⟨(1261243984157612676036813528611 / 10000000000000000000000000000000), (27 / 100000000000000000000000000000000)⟩
  | 5, 0 => ⟨(7494452423922705001235812089 / 4000000000000000000000000000000), (1 / 100000000000000000000000000000000)⟩
  | _, _ => (.exact 0)
lemma Z0_4_4Contains : ∀ i j : Fin 6,
    statisticWeight i + statisticWeight j = shapeMax (shape 0 4 4) →
    contains (.mul (Z0_4_4Raw (i,j)) (.inv Z0_4_4Den)) (Z0_4_4Probs (i,j)) = true := by
  decide +kernel
lemma Z0_4_4Zero : ∀ i j : Fin 6,
    statisticWeight i + statisticWeight j ≠ shapeMax (shape 0 4 4) → Z0_4_4Probs (i,j) = .exact 0 := by
  decide +kernel
lemma Z0_4_4Probs_sound (ij : PairSlot) :
    (Z0_4_4Probs ij).Encloses (zeroPairLaw (shape 0 4 4) ij.1 ij.2 : ℝ) := by
  by_cases h : statisticWeight ij.1 + statisticWeight ij.2 = shapeMax (shape 0 4 4)
  · have hb := contains_sound (Ball.mul_sound (Z0_4_4Raw_sound ij)
      (Ball.inv_sound Z0_4_4Den_sound Z0_4_4Den_pos)) (Z0_4_4Contains ij.1 ij.2 h)
    simpa only [zeroPairLaw, h, ite_true, Rat.cast_div, Rat.cast_mul,
      Rat.cast_inv, div_eq_mul_inv] using hb
  · rw [Z0_4_4Zero ij.1 ij.2 h]
    simpa only [zeroPairLaw, h, ite_false] using Ball.exact_sound 0

def Z0_4_4Half (w : Fin 3) (ij : PairSlot) : Ball :=
  if (shape 0 4 4) w = 0 then if ij = (0,0) then .exact 1 else .exact 0
  else if w = halfMaxAxis (shape 0 4 4) then Z0_4_4Probs ij
  else Z0_4_4Probs (kappa ij.1, kappa ij.2)
lemma Z0_4_4Half_sound (w : Fin 3) (ij : PairSlot) :
    (Z0_4_4Half w ij).Encloses (halfLaw (shape 0 4 4) w ij : ℝ) := by
  have hp : positive (shape 0 4 4) = false := by decide +kernel
  simp only [Z0_4_4Half, halfLaw, hp, Bool.false_eq_true, ite_false]
  split_ifs
  · exact Ball.exact_sound 1
  · exact Ball.exact_sound 0
  · exact Z0_4_4Probs_sound _
  · exact Z0_4_4Probs_sound _

