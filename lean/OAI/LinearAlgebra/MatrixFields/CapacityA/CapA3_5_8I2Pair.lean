def CA3_5_8I2PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 3 5 8)) (shape 3 5 8) (fun u => (stageALaw (shape 3 5 8) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 2) a : ℝ)) a
def CA3_5_8I2PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 3 5 8) A3_5_8Law 2 a
lemma CA3_5_8I2PairRaw_sound (a : PairSlot × PairSlot) :
    (CA3_5_8I2PairRaw a).Encloses (CA3_5_8I2PairValue a) := by
  exact stageAPairBall_sound (shape 3 5 8) (by decide +kernel) A3_5_8Law (fun u => (stageALaw (shape 3 5 8) u : ℝ)) (fun u _ => A3_5_8Law_sound u) 2 a
