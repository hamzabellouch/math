def CA5_5_6I2PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 5 5 6)) (shape 5 5 6) (fun u => (stageALaw (shape 5 5 6) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 2) a : ℝ)) a
def CA5_5_6I2PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 5 5 6) A5_5_6Law 2 a
