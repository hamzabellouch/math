def CA4_4_8I2PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 4 4 8)) (shape 4 4 8) (fun u => (stageALaw (shape 4 4 8) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 2) a : ℝ)) a
def CA4_4_8I2PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 4 4 8) A4_4_8Law 2 a
lemma CA4_4_8I2PairRaw_sound (a : PairSlot × PairSlot) :
    (CA4_4_8I2PairRaw a).Encloses (CA4_4_8I2PairValue a) := by
  exact stageAPairBall_sound (shape 4 4 8) (by decide +kernel) A4_4_8Law (fun u => (stageALaw (shape 4 4 8) u : ℝ)) (fun u _ => A4_4_8Law_sound u) 2 a
