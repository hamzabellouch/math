def CA3_3_10I2PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 3 3 10)) (shape 3 3 10) (fun u => (stageALaw (shape 3 3 10) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 2) a : ℝ)) a
def CA3_3_10I2PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 3 3 10) A3_3_10Law 2 a
lemma CA3_3_10I2PairRaw_sound (a : PairSlot × PairSlot) :
