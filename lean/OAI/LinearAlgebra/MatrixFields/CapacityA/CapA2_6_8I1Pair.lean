def CA2_6_8I1PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 2 6 8)) (shape 2 6 8) (fun u => (stageALaw (shape 2 6 8) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 1) a : ℝ)) a
def CA2_6_8I1PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 2 6 8) A2_6_8Law 1 a
