def CA2_4_10I2PairValue (a : PairSlot × PairSlot) : ℝ := pairLaw (below (shape 2 4 10)) (shape 2 4 10) (fun u => (stageALaw (shape 2 4 10) u : ℝ)) (fun u a => (halfLaw u ((Equiv.refl (Fin 3)) 2) a : ℝ)) a
def CA2_4_10I2PairRaw (a : PairSlot × PairSlot) : Ball := stageAPairBall (shape 2 4 10) A2_4_10Law 2 a
