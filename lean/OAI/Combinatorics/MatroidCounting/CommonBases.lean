  first
  | assumption
  | exact controlled_wordRange
  | exact controlled_boolNot
  | exact controlled_boolAnd
  | exact controlled_boolOr
  | exact controlled_natEqual
  | exact controlled_natEqZero
  | exact controlled_natSub
