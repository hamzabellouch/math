  change run O ceilDivCode (ε.num.natAbs,ε.den)=_
  rw [run_ceilDivCode O _ _ (Int.natAbs_pos.mpr (ne_of_gt (Rat.num_pos.mpr hε))),inverse_ceiling_input ε hε]
