lemma historyPositive_all (h : List (PhaseSample n N)) (hp : HistoryPositive n N h) (j : ℕ) (p r) :
    0<storedWeights n N h j p r := by
  by_cases hj : j ≤ h.length
  · exact hp j hj p r
