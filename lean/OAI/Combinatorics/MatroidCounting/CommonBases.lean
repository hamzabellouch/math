def divCopies : Program k 16 := concatProgram (copyProgram 2 4 5) (copyProgram 1 4 6)
def divCheck : Program k 25 := concatProgram divCopies (compareProgram 5 6)
def divSubtract : Program k 24 := concatProgram (copyProgram 1 4 5) (subProgram 2 5 4)
def divCopiesConfig (R : Fin (k+8) → List Bool) (pc : Fin 17) (q c : ℕ) : MachineConfig k 16 := ⟨R,pc,none,q,c⟩
def divCheckConfig (R : Fin (k+8) → List Bool) (pc : Fin 26) (q c : ℕ) : MachineConfig k 25 := ⟨R,pc,none,q,c⟩
def divSubtractConfig (R : Fin (k+8) → List Bool) (pc : Fin 25) (q c : ℕ) : MachineConfig k 24 := ⟨R,pc,none,q,c⟩
lemma divCopies_exit : (divCopies : Program k 16) (lastLabel 16)=.halt := by
  simp [divCopies,concatProgram,lastLabel,copyProgram,Instruction.relabel]
lemma divSubtract_exit : (divSubtract : Program k 24) (lastLabel 24)=.halt := by
  simp [divSubtract,concatProgram,lastLabel,subProgram,Instruction.relabel]
lemma divCopies_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution divCopies O (divCopiesConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      ((5*zs.length+2)+(5*ys.length+2))=
      divCopiesConfig (divRegisters R xs ys zs ws zs ys) 16 q (c+((5*zs.length+2)+(5*ys.length+2))) := by
  have hc := copy_block (k:=k) (2 : Fin (k+8)) 4 5 (by simp) (by simp) (by simp)
    O (divRegisters R xs ys zs ws [] []) zs [] q c bits
  simp only [List.append_nil,divRegisters_copyR_in,divRegisters_copyR_out] at hc
  have hd := copy_block (k:=k) (1 : Fin (k+8)) 4 6 (by simp) (by simp) (by simp)
    O (divRegisters R xs ys zs ws zs []) ys [] q (c+(5*zs.length+2)) (fun i => bits (5*zs.length+2+i))
  simp only [List.append_nil,divRegisters_copyD_in,divRegisters_copyD_out] at hd
  have hh := concat_run (copyProgram (k:=k) 2 4 5) (copyProgram 1 4 6) (by rfl) O
    (copyConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits (5*zs.length+2) (5*ys.length+2)
    (by rw [hc]; rfl) (by rw [hc]; rfl)
  rw [hc] at hh
  have hre : restartControl (copyConfig (divRegisters R xs ys zs ws zs []) 8 q (c+5*zs.length+2))
      (0 : Fin 9)=copyConfig (divRegisters R xs ys zs ws zs []) 0 q (c+(5*zs.length+2)) := by
    simp [restartControl,copyConfig,Nat.add_assoc]
  rw [hre,hd] at hh
  simpa [divCopies,divCopiesConfig,copyConfig,relabelConfig,firstLabel,secondLabel,Nat.add_assoc] using hh

def divCheckCost (ys zs : List Bool) : ℕ := (5*zs.length+2)+(5*ys.length+2)+(2*max zs.length ys.length+2)
lemma divCheck_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution divCheck O (divCheckConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      (divCheckCost ys zs)=
      divCheckConfig (divRegisters R xs ys zs ws [] []) (if binaryValue zs<binaryValue ys then 25 else 24) q (c+divCheckCost ys zs) := by
  have hc := divCopies_run O R xs ys zs ws q c bits
  have hd := comparison_block (k:=k) (5 : Fin (k+8)) 6 (by simp) O
    (divRegisters R xs ys zs ws zs ys) zs ys q (c+((5*zs.length+2)+(5*ys.length+2)))
      (fun i => bits ((5*zs.length+2)+(5*ys.length+2)+i))
  dsimp only at hd
  simp only [divRegisters_compare_in,divRegisters_compare_out] at hd
  have hh := concat_run (divCopies : Program k 16) (compareProgram 5 6) divCopies_exit O
    (divCopiesConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      ((5*zs.length+2)+(5*ys.length+2)) (2*max zs.length ys.length+2)
      (by rw [hc]; rfl) (by rw [hc]; rfl)
  rw [hc] at hh
  have hre : restartControl (divCopiesConfig (divRegisters R xs ys zs ws zs ys) 16 q (c+((5*zs.length+2)+(5*ys.length+2))))
      (0 : Fin 10)=compareConfig (divRegisters R xs ys zs ws zs ys) 0 q (c+((5*zs.length+2)+(5*ys.length+2))) := rfl
  rw [hre,hd] at hh
  split_ifs at hh ⊢ <;> simpa [divCheck,divCheckCost,divCopiesConfig,divCheckConfig,compareConfig,relabelConfig,firstLabel,secondLabel,Nat.add_assoc] using hh

def divSubtractCost (ys zs : List Bool) : ℕ := (5*ys.length+2)+(subCost false zs ys+2*(subDigits false zs ys).length+1)
lemma divSubtract_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (hzy : binaryValue ys≤binaryValue zs) (q c : ℕ) (bits : ℕ → Bool) :
    execution divSubtract O (divSubtractConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      (divSubtractCost ys zs)=
      divSubtractConfig (divRegisters R xs ys (subDigits false zs ys) ws [] []) 24 q (c+divSubtractCost ys zs) := by
  have hc := copy_block (k:=k) (1 : Fin (k+8)) 4 5 (by simp) (by simp) (by simp)
    O (divRegisters R xs ys zs ws [] []) ys [] q c bits
  simp only [List.append_nil,divRegisters_copyS_in,divRegisters_copyS_out] at hc
  have hd := (subtraction_block (k:=k) (2 : Fin (k+8)) 5 4 (by simp) (by simp) (by simp)
    O (divRegisters R xs ys zs ws ys []) zs ys hzy q (c+(5*ys.length+2))
      (fun i => bits (5*ys.length+2+i))).2.2
  simp only [divRegisters_sub_in,divRegisters_sub_out] at hd
  have hh := concat_run (copyProgram (k:=k) 1 4 5) (subProgram 2 5 4) (by rfl) O
    (copyConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits (5*ys.length+2)
      (subCost false zs ys+2*(subDigits false zs ys).length+1)
      (by rw [hc]; rfl) (by rw [hc]; rfl)
  rw [hc] at hh
  have hre : restartControl (copyConfig (divRegisters R xs ys zs ws ys []) 8 q (c+5*ys.length+2))
      (0 : Fin 17)=subConfig (divRegisters R xs ys zs ws ys []) 0 q (c+(5*ys.length+2)) := by
    simp [restartControl,copyConfig,subConfig,Nat.add_assoc]
  rw [hre,hd] at hh
  simpa [divSubtract,divSubtractCost,divSubtractConfig,copyConfig,subConfig,relabelConfig,firstLabel,secondLabel,Nat.add_assoc] using hh

def divisionCheckLabel (i : Fin 26) : Fin 54 :=
  if h : i.val<24 then ⟨3+i.val,by omega⟩ else if i.val=24 then 27 else 52
def divisionSubLabel (i : Fin 25) : Fin 54 := ⟨27+i.val,by omega⟩
def divisionProgram : Program k 53 := fun i =>
  if i.val=0 then .pop 0 53 1 2
  else if i.val=1 then .push 2 false 3
  else if i.val=2 then .push 2 true 3
  else if h : i.val<27 then
    ((divCheck : Program k 25) ⟨i.val-3,by omega⟩).relabel divisionCheckLabel
  else if h : i.val<51 then
    ((divSubtract : Program k 24) ⟨i.val-27,by omega⟩).relabel divisionSubLabel
  else if i.val=51 then .push 3 true 0
  else if i.val=52 then .push 3 false 0
  else .halt
def divisionConfig (R : Fin (k+8) → List Bool) (pc : Fin 54) (q c : ℕ) : MachineConfig k 53 :=
  ⟨R,pc,none,q,c⟩
lemma division_check_table (i : Fin 26) (hi : (divCheck : Program k 25) i≠.halt) :
    (divisionProgram : Program k 53) (divisionCheckLabel i)=
      ((divCheck : Program k 25) i).relabel divisionCheckLabel := by
  have hil : i.val<24 := by
    by_contra hh
    have he : i=24 ∨ i=25 := by
      have hl := i.isLt
      rcases (show i.val=24 ∨ i.val=25 by omega) with h|h
      · exact Or.inl (Fin.ext h)
      · exact Or.inr (Fin.ext h)
    rcases he with rfl|rfl <;> exact hi rfl
  simp [divisionCheckLabel,hil,divisionProgram,
    show ¬3+i.val=1 by omega,show ¬3+i.val=2 by omega,show 3+i.val<27 by omega]
lemma division_sub_table (i : Fin 25) (hi : i≠lastLabel 24) :
    (divisionProgram : Program k 53) (divisionSubLabel i)=
      ((divSubtract : Program k 24) i).relabel divisionSubLabel := by
  have hil : i.val<24 := by
    have hn : i.val≠24 := by intro h; exact hi (Fin.ext h)
    omega
  simp [divisionSubLabel,divisionProgram,
    show ¬27+i.val=1 by omega,show ¬27+i.val=2 by omega,
    show ¬27+i.val<27 by omega,show 27+i.val<51 by omega]
lemma division_check_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution divisionProgram O (divisionConfig (divRegisters R xs ys zs ws [] []) 3 q c) bits
      (divCheckCost ys zs)=divisionConfig (divRegisters R xs ys zs ws [] [])
        (if binaryValue zs<binaryValue ys then 52 else 27) q (c+divCheckCost ys zs) := by
  have h := execution_relabel_before_any_halt (divCheck : Program k 25) divisionProgram divisionCheckLabel
    division_check_table O (divCheckConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      (divCheckCost ys zs) (by rw [divCheck_run]; rfl)
  rw [divCheck_run] at h
  split_ifs at h ⊢ <;> simpa [relabelConfig,divCheckConfig,divisionConfig,divisionCheckLabel] using h
lemma division_sub_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (hzy : binaryValue ys≤binaryValue zs) (q c : ℕ) (bits : ℕ → Bool) :
    execution divisionProgram O (divisionConfig (divRegisters R xs ys zs ws [] []) 27 q c) bits
      (divSubtractCost ys zs)=divisionConfig (divRegisters R xs ys (subDigits false zs ys) ws [] [])
        51 q (c+divSubtractCost ys zs) := by
  have h := execution_relabel_before_halt (divSubtract : Program k 24) divisionProgram divisionSubLabel
    (lastLabel 24) divSubtract_exit division_sub_table O
    (divSubtractConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits (divSubtractCost ys zs)
    (by rw [divSubtract_run O R xs ys zs ws hzy]; rfl)
  rw [divSubtract_run O R xs ys zs ws hzy] at h
  simpa [relabelConfig,divSubtractConfig,divisionConfig,divisionSubLabel] using h

def divisionRemainder (ys zs : List Bool) : List Bool :=
  if binaryValue zs<binaryValue ys then zs else subDigits false zs ys
def divisionDigit (ys zs : List Bool) : Bool := decide (binaryValue ys≤binaryValue zs)
def divisionDigitCost (ys zs : List Bool) : ℕ :=
  2+divCheckCost ys zs+(if binaryValue zs<binaryValue ys then 0 else divSubtractCost ys zs)+1
lemma division_digit_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (x : Bool) (xs ys zs ws : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution divisionProgram O (divisionConfig (divRegisters R (x::xs) ys zs ws [] []) 0 q c) bits
      (divisionDigitCost ys (x::zs))=
      divisionConfig (divRegisters R xs ys (divisionRemainder ys (x::zs))
        (divisionDigit ys (x::zs)::ws) [] []) 0 q (c+divisionDigitCost ys (x::zs)) := by
  have hp : execution divisionProgram O
      (divisionConfig (divRegisters R (x::xs) ys zs ws [] []) 0 q c) bits 2=
      divisionConfig (divRegisters R xs ys (x::zs) ws [] []) 3 q (c+2) := by
    cases x <;> simp [execution,machineStep,divisionProgram,divisionConfig,
      divRegisters_update0,divRegisters_update2,divRegisters]
  unfold divisionDigitCost
  rw [show 2+divCheckCost ys (x::zs)+(if binaryValue (x::zs)<binaryValue ys then 0 else divSubtractCost ys (x::zs))+1=
    2+(divCheckCost ys (x::zs)+((if binaryValue (x::zs)<binaryValue ys then 0 else divSubtractCost ys (x::zs))+1)) by omega]
  rw [execution_add,hp,execution_add,division_check_run]
  by_cases hl : binaryValue (x::zs)<binaryValue ys
  · have hn : ¬binaryValue ys≤binaryValue (x::zs) := by omega
    simp [hl,divisionRemainder,divisionDigit,hn,execution,machineStep,divisionProgram,divisionConfig,
      divRegisters_update3,divRegisters,Nat.add_assoc]
  · have hn : binaryValue ys≤binaryValue (x::zs) := by omega
    simp only [hl,ite_false]
    rw [execution_add,division_sub_run O R xs ys (x::zs) ws hn]
    simp [divisionRemainder,divisionDigit,hl,hn,execution,machineStep,divisionProgram,divisionConfig,
      divRegisters_update3,divRegisters,Nat.add_assoc]

def divisionWords : List Bool → List Bool → List Bool → List Bool → List Bool × List Bool
  | [],_,zs,ws => (zs,ws)
  | x::xs,ys,zs,ws => divisionWords xs ys (divisionRemainder ys (x::zs)) (divisionDigit ys (x::zs)::ws)
def divisionCost : List Bool → List Bool → List Bool → ℕ
  | [],_,_ => 1
  | x::xs,ys,zs => divisionDigitCost ys (x::zs)+divisionCost xs ys (divisionRemainder ys (x::zs))

theorem division_machine_run (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys zs ws : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution divisionProgram O (divisionConfig (divRegisters R xs ys zs ws [] []) 0 q c) bits
      (divisionCost xs ys zs)=divisionConfig
        (divRegisters R [] ys (divisionWords xs ys zs ws).1 (divisionWords xs ys zs ws).2 [] [])
        53 q (c+divisionCost xs ys zs) := by
  induction xs generalizing zs ws c bits with
  | nil => simp [divisionCost,divisionWords,execution,machineStep,divisionProgram,divisionConfig,divRegisters]
  | cons x xs ih =>
    rw [divisionCost,execution_add,division_digit_run,ih]
    simp only [divisionWords,Nat.add_assoc]

lemma binaryValue_append (xs ys : List Bool) :
    binaryValue (xs++ys)=binaryValue xs+2^xs.length*binaryValue ys := by
  induction xs with
  | nil => simp [binaryValue]
  | cons x xs ih =>
    simp only [List.cons_append,binaryValue,ih,List.length_cons,pow_succ]
    ring

def streamValue : List Bool → ℕ → ℕ
  | [],a => a
  | x::xs,a => streamValue xs (2*a+(if x then 1 else 0))
lemma streamValue_eq (xs : List Bool) (a : ℕ) :
    streamValue xs a=binaryValue xs.reverse+2^xs.length*a := by
  induction xs generalizing a with
  | nil => simp [streamValue,binaryValue]
  | cons x xs ih =>
    simp only [streamValue,ih,List.reverse_cons,binaryValue_append,List.length_reverse,
      List.length_cons,pow_succ,binaryValue]
    ring
lemma division_step_math (x : Bool) (ys zs : List Bool) (hr : binaryValue zs<binaryValue ys) :
    binaryValue (divisionRemainder ys (x::zs))<binaryValue ys ∧
      binaryValue (divisionRemainder ys (x::zs))+
        binaryValue ys*(if divisionDigit ys (x::zs) then 1 else 0)=binaryValue (x::zs) := by
  by_cases hl : binaryValue (x::zs)<binaryValue ys
  · have hn : ¬binaryValue ys≤binaryValue (x::zs) := by omega
    simp [divisionRemainder,divisionDigit,hl,hn]
  · have hn : binaryValue ys≤binaryValue (x::zs) := by omega
    have hv := subDigits_value false (x::zs) ys (by simpa using hn)
    simp only [Bool.false_eq_true,ite_false,Nat.add_zero] at hv
    simp only [divisionRemainder,divisionDigit,hl,ite_false,hn,decide_true,ite_true,Nat.mul_one]
    refine ⟨?_,hv⟩
    cases x <;> simp [binaryValue] at hv <;> omega
lemma divisionWords_invariant (xs ys zs ws : List Bool) (hr : binaryValue zs<binaryValue ys) :
    binaryValue (divisionWords xs ys zs ws).1+binaryValue ys*binaryValue (divisionWords xs ys zs ws).2=
      streamValue xs (binaryValue zs+binaryValue ys*binaryValue ws) ∧
      binaryValue (divisionWords xs ys zs ws).1<binaryValue ys := by
  induction xs generalizing zs ws with
  | nil => exact ⟨rfl,hr⟩
  | cons x xs ih =>
    have hd := division_step_math x ys zs hr
    have hi := ih (divisionRemainder ys (x::zs)) (divisionDigit ys (x::zs)::ws) hd.1
    simp only [divisionWords]
    refine ⟨?_,hi.2⟩
    rw [hi.1,streamValue]
    congr 1
    simp only [binaryValue]
    have hv := hd.2
    simp only [binaryValue] at hv
    nlinarith

theorem divisionWords_correct (xs ys : List Bool) (hy : 0<binaryValue ys) :
    binaryValue (divisionWords xs ys [] []).1=binaryValue xs.reverse%binaryValue ys ∧
      binaryValue (divisionWords xs ys [] []).2=binaryValue xs.reverse/binaryValue ys := by
  have h := divisionWords_invariant xs ys [] [] (by simpa [binaryValue] using hy)
  simp only [binaryValue,Nat.mul_zero,Nat.add_zero,streamValue_eq] at h
  constructor
  · rw [←h.1,Nat.add_mul_mod_self_left,Nat.mod_eq_of_lt h.2]
  · rw [←h.1,Nat.add_mul_div_left _ _ hy,Nat.div_eq_of_lt h.2,Nat.zero_add]

lemma subDigits_length (c : Bool) (xs ys : List Bool) :
    (subDigits c xs ys).length=max xs.length ys.length := by
  induction xs generalizing c ys with
  | nil =>
    induction ys generalizing c with
    | nil => simp [subDigits]
    | cons y ys ih => simp [subDigits,ih]
  | cons x xs ih =>
    cases ys with
    | nil => simp [subDigits,ih]
    | cons y ys => simp [subDigits,ih,max_add_add_right]
lemma divisionRemainder_length (ys zs : List Bool) :
    (divisionRemainder ys zs).length ≤ max zs.length ys.length := by
  unfold divisionRemainder
  split_ifs
  · exact Nat.le_max_left _ _
  · exact (subDigits_length false zs ys).le
lemma divCheckCost_bound (ys zs : List Bool) :
    divCheckCost ys zs≤12*max ys.length zs.length+6 := by
  have hy := Nat.le_max_left ys.length zs.length
  have hz := Nat.le_max_right ys.length zs.length
  unfold divCheckCost
  rw [Nat.max_comm zs.length ys.length]
  omega
lemma divSubtractCost_bound (ys zs : List Bool) :
    divSubtractCost ys zs≤13*max ys.length zs.length+6 := by
  have hy := Nat.le_max_left ys.length zs.length
  have hz := Nat.le_max_right ys.length zs.length
  have h := (subDigits_length_cost false zs ys).2
  unfold divSubtractCost
  rw [subDigits_length,Nat.max_comm zs.length ys.length]
  omega
lemma divisionDigitCost_bound (ys zs : List Bool) :
    divisionDigitCost ys zs≤25*max ys.length zs.length+15 := by
  have hc := divCheckCost_bound ys zs
  have hs := divSubtractCost_bound ys zs
  unfold divisionDigitCost
  split_ifs <;> omega
lemma divisionCost_bound (xs ys zs : List Bool) (K : ℕ) (hy : ys.length≤K) (hz : zs.length≤K) :
    divisionCost xs ys zs≤40*xs.length*(K+xs.length+1)+1 := by
  induction xs generalizing zs K with
  | nil => simp [divisionCost]
  | cons x xs ih =>
    have hl : max ys.length (x::zs).length≤K+1 := by simp only [List.length_cons]; omega
    have hr : (divisionRemainder ys (x::zs)).length≤K+1 := by
      have hh := divisionRemainder_length ys (x::zs)
      rw [Nat.max_comm] at hh
      exact hh.trans hl
    have hc := (divisionDigitCost_bound ys (x::zs)).trans (Nat.add_le_add_right (Nat.mul_le_mul_left 25 hl) 15)
    have ht := ih (divisionRemainder ys (x::zs)) (K+1) (by omega) hr
    simp only [divisionCost,List.length_cons]
    nlinarith

theorem division_block (O : IndependenceOracle n) (R : Fin (k+8) → List Bool)
    (xs ys : List Bool) (hy : 0<binaryValue ys) (q c : ℕ) (bits : ℕ → Bool) :
    let t := divisionCost xs ys []
    let z := divisionWords xs ys [] []
    t≤40*xs.length*(ys.length+xs.length+1)+1 ∧
      binaryValue z.1=binaryValue xs.reverse%binaryValue ys ∧
      binaryValue z.2=binaryValue xs.reverse/binaryValue ys ∧
      execution divisionProgram O (divisionConfig (divRegisters R xs ys [] [] [] []) 0 q c) bits t=
        divisionConfig (divRegisters R [] ys z.1 z.2 [] []) 53 q (c+t) := by
  dsimp only
  exact ⟨divisionCost_bound xs ys [] ys.length le_rfl (by simp),
    (divisionWords_correct xs ys hy).1,(divisionWords_correct xs ys hy).2,
    division_machine_run O R xs ys [] [] q c bits⟩

end

section

variable {k s n : ℕ}
def Instruction.renameRegisters (e : Equiv.Perm (Fin (k+8))) : Instruction k s → Instruction k s
  | .push i b j => .push (e i) b j
  | .pop i a b c => .pop (e i) a b c
  | .coin a b => .coin a b
  | .query w i a b => .query w (e i) a b
  | .halt => .halt
def renameProgram (e : Equiv.Perm (Fin (k+8))) (P : Program k s) : Program k s :=
  fun i => (P i).renameRegisters e
def renameConfig (e : Equiv.Perm (Fin (k+8))) (c : MachineConfig k s) : MachineConfig k s :=
  ⟨fun i => c.registers (e.symm i),c.control,c.output,c.oracleCalls,c.bitOperations⟩
lemma rename_update (e : Equiv.Perm (Fin (k+8))) (R : Fin (k+8) → List Bool) (j : Fin (k+8)) (z : List Bool) :
    Function.update (fun i => R (e.symm i)) (e j) z=(fun i => Function.update R j z (e.symm i)) := by
  funext i
  by_cases hi : i=e j
  · subst i; simp
  · have hj : e.symm i≠j := by intro h; apply hi; simpa using congrArg e h
    simp [Function.update,hi,hj]
lemma machineStep_rename (e : Equiv.Perm (Fin (k+8))) (P : Program k s)
    (O : IndependenceOracle n) (b : Bool) (c : MachineConfig k s) (h : P c.control≠.halt) :
    machineStep (renameProgram e P) O b (renameConfig e c)=renameConfig e (machineStep P O b c) := by
  cases hc : c.output with
  | some z => simp [machineStep,renameConfig,hc]
  | none =>
    cases hp : P c.control with
    | push i b j => simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters,rename_update]
    | pop i x y z =>
      cases hl : c.registers i with
      | nil => simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters,hl]
      | cons a l => cases a <;> simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters,hl,rename_update]
    | coin x y => cases b <;> simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters]
    | query w i x y =>
      by_cases hl : (c.registers i).length=n
      · simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters,hl]
      · simp [machineStep,renameConfig,hc,renameProgram,hp,Instruction.renameRegisters,hl]
    | halt => exact (h hp).elim

theorem execution_rename_before_halt (e : Equiv.Perm (Fin (k+8))) (P : Program k s)
    (O : IndependenceOracle n) (c : MachineConfig k s) (bits : ℕ → Bool) (u : ℕ)
    (hu : (execution P O c bits u).output=none) :
    execution (renameProgram e P) O (renameConfig e c) bits u=renameConfig e (execution P O c bits u) := by
  induction u with
  | zero => rfl
  | succ u ih =>
    have hn := machineStep_none_pre P O (bits u) (execution P O c bits u) hu
    have hh := machineStep_none_not_halt P O (bits u) (execution P O c bits u) hu
    simp only [execution,ih hn]
    exact machineStep_rename e P O _ _ hh

end

variable {k n : ℕ}
def bitFrame : List Bool → List Bool
  | [] => [true]
  | b::bs => false::b::bitFrame bs
lemma bitFrame_length (bs : List Bool) : (bitFrame bs).length=2*bs.length+1 := by
  induction bs with
  | nil => rfl
  | cons b bs ih => simp [bitFrame,ih]; omega
lemma bitFrame_append (xs ys : List Bool) :
    bitFrame (xs++ys)=(xs.flatMap (fun b => [false,b]))++bitFrame ys := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp [bitFrame,ih]
lemma bitFrame_reverse_cons (b : Bool) (bs : List Bool) :
    bitFrame (b::bs).reverse=(bs.reverse.flatMap (fun x => [false,x]))++[false,b,true] := by
  rw [List.reverse_cons,bitFrame_append]
  rfl

def framePackProgram (a d : Fin (k+8)) : Program k 5 := fun pc =>
  match pc.val with
  | 0 => .push d true 1
  | 1 => .pop a 5 2 3
  | 2 => .push d false 4
  | 3 => .push d true 4
  | 4 => .push d false 1
  | _ => .halt
def frameConfig (R : Fin (k+8) → List Bool) (pc : Fin 6) (q c : ℕ) : MachineConfig k 5 :=
  ⟨R,pc,none,q,c⟩
lemma frame_pack_scan (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs ts : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (framePackProgram a d) O (frameConfig (pairRegisters R a d xs ts) 1 q c) bits
      (3*xs.length+1)=frameConfig (pairRegisters R a d []
        ((xs.reverse.flatMap (fun b => [false,b]))++ts)) 5 q (c+3*xs.length+1) := by
  induction xs generalizing ts c bits with
  | nil => simp [execution,machineStep,framePackProgram,frameConfig,pairRegisters_a _ _ _ had]
  | cons x xs ih =>
    have ht : execution (framePackProgram a d) O (frameConfig (pairRegisters R a d (x::xs) ts) 1 q c) bits 3=
        frameConfig (pairRegisters R a d xs (false::x::ts)) 1 q (c+3) := by
      cases x <;> simp [execution,machineStep,framePackProgram,frameConfig,
        pairRegisters_a _ _ _ had,pairRegisters_b,pairRegisters_update_a _ _ _ had,pairRegisters_update_b]
    rw [List.length_cons,show 3*(xs.length+1)+1=3+(3*xs.length+1) by omega,execution_add,ht,ih]
    simp only [List.reverse_cons,List.flatMap_append,List.flatMap_singleton,List.append_assoc,List.cons_append,List.nil_append]
    congr 1 ; omega

theorem frame_pack_block (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs ts : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (framePackProgram a d) O (frameConfig (pairRegisters R a d xs ts) 0 q c) bits
      (3*xs.length+2)=frameConfig (pairRegisters R a d [] (bitFrame xs.reverse++ts)) 5 q (c+3*xs.length+2) := by
  have ht : execution (framePackProgram a d) O (frameConfig (pairRegisters R a d xs ts) 0 q c) bits 1=
      frameConfig (pairRegisters R a d xs (true::ts)) 1 q (c+1) := by
    simp [execution,machineStep,framePackProgram,frameConfig,pairRegisters_b,pairRegisters_update_b]
  rw [show 3*xs.length+2=1+(3*xs.length+1) by omega,execution_add,ht,frame_pack_scan a d had]
  have hf : bitFrame xs.reverse=(xs.reverse.flatMap (fun b => [false,b]))++[true] := by
    simpa [bitFrame] using bitFrame_append xs.reverse []
  simp only [hf,List.append_assoc,List.singleton_append]
  congr 1 ; omega

def frameUnpackProgram (a d : Fin (k+8)) : Program k 5 := fun pc =>
  match pc.val with
  | 0 => .pop a 5 1 4
  | 1 => .pop a 5 2 3
  | 2 => .push d false 0
  | 3 => .push d true 0
  | _ => .halt

theorem frame_unpack_block (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs ts zs : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (frameUnpackProgram a d) O
      (frameConfig (pairRegisters R a d (bitFrame xs++ts) zs) 0 q c) bits (3*xs.length+1)=
      frameConfig (pairRegisters R a d ts (xs.reverse++zs)) 4 q (c+3*xs.length+1) := by
  induction xs generalizing zs c bits with
  | nil => simp [bitFrame,execution,machineStep,frameUnpackProgram,frameConfig,
      pairRegisters_a _ _ _ had,pairRegisters_update_a _ _ _ had]
  | cons x xs ih =>
    have ht : execution (frameUnpackProgram a d) O
        (frameConfig (pairRegisters R a d (bitFrame (x::xs)++ts) zs) 0 q c) bits 3=
        frameConfig (pairRegisters R a d (bitFrame xs++ts) (x::zs)) 0 q (c+3) := by
      cases x <;> simp [bitFrame,execution,machineStep,frameUnpackProgram,frameConfig,
        pairRegisters_a _ _ _ had,pairRegisters_b,pairRegisters_update_a _ _ _ had,pairRegisters_update_b]
    rw [List.length_cons,show 3*(xs.length+1)+1=3+(3*xs.length+1) by omega,execution_add,ht,ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]
    congr 1 ; omega

theorem frame_unpack_packed (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs ts : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (frameUnpackProgram a d) O
      (frameConfig (pairRegisters R a d (bitFrame xs.reverse++ts) []) 0 q c) bits (3*xs.length+1)=
      frameConfig (pairRegisters R a d ts xs) 4 q (c+3*xs.length+1) := by
  simpa using frame_unpack_block a d had O R xs.reverse ts [] q c bits

end

namespace MachineCode
abbrev Registers (k : ℕ) := Fin (k+8) → List Bool
structure Block (k : ℕ) where
  size : ℕ
  code : Program k size
  exit_halt : code (lastLabel size) = .halt

def state {k s : ℕ} (R : Registers k) (pc : Fin (s+1)) (q w : ℕ) : MachineConfig k s :=
  ⟨R,pc,none,q,w⟩

def Runs {k n : ℕ} (p : Block k) (O : IndependenceOracle n) (bits : ℕ → Bool)
    (R R' : Registers k) (t q w : ℕ) : Prop :=
  ∀ q₀ w₀, execution p.code O (state R 0 q₀ w₀) bits t =
    state R' (lastLabel p.size) (q₀+q) (w₀+w)

def skip (k : ℕ) : Block k := ⟨0,fun _ => .halt,rfl⟩
lemma runs_skip {k n : ℕ} (O : IndependenceOracle n) (bits : ℕ → Bool) (R : Registers k) :
    Runs (skip k) O bits R R 0 0 0 := by
  intro q w
  rfl

def seq {k : ℕ} (p q : Block k) : Block k where
  size := p.size+q.size
  code := concatProgram p.code q.code
  exit_halt := by
    have he : lastLabel (p.size+q.size)=secondLabel p.size q.size (lastLabel q.size) := by
      apply Fin.ext; rfl
    rw [he,concatProgram_second,q.exit_halt]
    rfl
lemma runs_seq {k n : ℕ} {p q : Block k} (O : IndependenceOracle n) (bits : ℕ → Bool)
    {R S T : Registers k} {u v a b c d : ℕ}
    (hp : Runs p O bits R S u a b)
    (hq : Runs q O (fun i => bits (u+i)) S T v c d) :
    Runs (seq p q) O bits R T (u+v) (a+c) (b+d) := by
  intro q₀ w₀
  have ep := hp q₀ w₀
  have en : (execution p.code O (state R 0 q₀ w₀) bits u).output=none := by rw [ep]; rfl
  have ec : (execution p.code O (state R 0 q₀ w₀) bits u).control=lastLabel p.size := by rw [ep]; rfl
  have h := concat_run p.code q.code p.exit_halt O (state R 0 q₀ w₀) bits u v en ec
  rw [ep] at h
  have eh := hq (q₀+a) (w₀+b)
  change execution q.code O (restartControl (state S (lastLabel p.size) (q₀+a) (w₀+b)) 0)
    (fun i => bits (u+i)) v = _ at eh
  rw [eh] at h
  change execution (concatProgram p.code q.code) O (state R 0 q₀ w₀) bits (u+v) =
    state T (lastLabel (p.size+q.size)) (q₀+(a+c)) (w₀+(b+d))
  simpa [state,relabelConfig,firstLabel,secondLabel,lastLabel,Nat.add_assoc] using h

def push {k : ℕ} (a : Fin (k+8)) (b : Bool) : Block k where
  size := 1
  code := fun pc => if pc=0 then .push a b 1 else .halt
  exit_halt := by simp [lastLabel]
lemma runs_push {k n : ℕ} (O : IndependenceOracle n) (bits : ℕ → Bool)
    (R : Registers k) (a : Fin (k+8)) (b : Bool) :
    Runs (push a b) O bits R (Function.update R a (b::R a)) 1 0 1 := by
  intro q w
  rfl

inductive Test (k : ℕ) where
  | pop (a : Fin (k+8)) (empty zero one : Bool)
  | query (which : Bool) (a : Fin (k+8))
  | coin

def Test.instruction {k s : ℕ} (test : Test k) (no yes : Fin (s+1)) : Instruction k s :=
  match test with
  | .pop a e z o => .pop a (if e then yes else no) (if z then yes else no) (if o then yes else no)
  | .query which a => .query which a no yes
  | .coin => .coin no yes

def Test.result {k n : ℕ} (test : Test k) (O : IndependenceOracle n) (bit : Bool)
    (R : Registers k) : Option (Bool × Registers k) :=
  match test with
  | .pop a e z o => match R a with
    | [] => some (e,R)
    | b::xs => some ((if b then o else z),Function.update R a xs)
  | .query which a => if (R a).length=n then
      some (O which (fun i => (R a)[i.val]?.getD false),R) else none
  | .coin => some (bit,R)

def Test.queries {k : ℕ} : Test k → ℕ
  | .query _ _ => 1
  | _ => 0

def Test.work {k : ℕ} (test : Test k) (n : ℕ) (R : Registers k) : ℕ :=
  match test with
  | .query _ a => (R a).length+n+1
  | _ => 1

lemma test_step {k s n : ℕ} (test : Test k) (O : IndependenceOracle n) (bit : Bool)
    (P : Program k s) (pc no yes : Fin (s+1)) (hP : P pc=test.instruction no yes)
    (R R' : Registers k) (b : Bool) (h : test.result O bit R=some (b,R')) (q w : ℕ) :
    machineStep P O bit (state R pc q w)=
      state R' (if b then yes else no) (q+test.queries) (w+test.work n R) := by
  cases test with
  | pop a e z o =>
    cases ha : R a with
    | nil =>
      simp only [Test.result,ha,Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      simp [machineStep,state,hP,Test.instruction,ha,Test.queries,Test.work]
    | cons x xs =>
      simp only [Test.result,ha,Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      cases x <;> simp [machineStep,state,hP,Test.instruction,ha,Test.queries,Test.work]
  | query which a =>
    simp only [Test.result] at h
    split_ifs at h with hn
    · simp only [Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      simp [machineStep,state,hP,Test.instruction,hn,Test.queries,Test.work,Nat.add_assoc]
  | coin =>
    simp only [Test.result,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    simp [machineStep,state,hP,Test.instruction,Test.queries,Test.work]

def noLabel (s t : ℕ) (i : Fin (s+1)) : Fin (s+t+2) :=
  if i.val=s then lastLabel (s+t+1) else ⟨i.val+1,by omega⟩
def yesLabel (s t : ℕ) (i : Fin (t+1)) : Fin (s+t+2) :=
  if i.val=t then lastLabel (s+t+1) else ⟨s+i.val+1,by omega⟩
lemma noLabel_exit (s t : ℕ) : noLabel s t (lastLabel s)=lastLabel (s+t+1) := by
  simp [noLabel,lastLabel]
lemma yesLabel_exit (s t : ℕ) : yesLabel s t (lastLabel t)=lastLabel (s+t+1) := by
  simp [yesLabel,lastLabel]

def fork {k : ℕ} (test : Test k) (p q : Block k) : Block k where
  size := p.size+q.size+1
  code := fun pc =>
    if pc.val=0 then test.instruction (noLabel p.size q.size 0) (yesLabel p.size q.size 0)
    else if h : pc.val≤p.size then
      (p.code ⟨pc.val-1,by omega⟩).relabel (noLabel p.size q.size)
    else if h : pc.val≤p.size+q.size then
      (q.code ⟨pc.val-p.size-1,by omega⟩).relabel (yesLabel p.size q.size)
    else .halt
  exit_halt := by simp [lastLabel,show ¬p.size+q.size+1≤p.size by omega]
lemma fork_head {k : ℕ} (test : Test k) (p q : Block k) :
    (fork test p q).code 0=test.instruction (noLabel p.size q.size 0) (yesLabel p.size q.size 0) := by
  simp [fork]
lemma fork_no {k : ℕ} (test : Test k) (p q : Block k) (i : Fin (p.size+1)) (hi : i≠lastLabel p.size) :
    (fork test p q).code (noLabel p.size q.size i)=(p.code i).relabel (noLabel p.size q.size) := by
  have hv : i.val≠p.size := by intro h; exact hi (Fin.ext h)
  have hv' : i.val+1≤p.size := by omega
  simp [fork,noLabel,hv,hv']
lemma fork_yes {k : ℕ} (test : Test k) (p q : Block k) (i : Fin (q.size+1)) (hi : i≠lastLabel q.size) :
    (fork test p q).code (yesLabel p.size q.size i)=(q.code i).relabel (yesLabel p.size q.size) := by
  have hv : i.val≠q.size := by intro h; exact hi (Fin.ext h)
  have hv' : p.size+i.val+1≤p.size+q.size := by omega
  simp [fork,yesLabel,hv,show ¬p.size+i.val+1≤p.size by omega,hv',show p.size+i.val+1-p.size-1=i.val by omega]

lemma fork_run_no {k n : ℕ} (test : Test k) (p q : Block k) (O : IndependenceOracle n)
    (bits : ℕ → Bool) {R S T : Registers k} {t a b : ℕ}
    (ht : test.result O (bits 0) R=some (false,S))
    (hp : Runs p O (fun i => bits (1+i)) S T t a b) :
    Runs (fork test p q) O bits R T (1+t) (test.queries+a) (test.work n R+b) := by
  intro q₀ w₀
  have first := test_step test O (bits 0) (fork test p q).code 0 _ _ (fork_head test p q) R S false ht q₀ w₀
  have er := hp (q₀+test.queries) (w₀+test.work n R)
  have en : (execution p.code O (state S 0 (q₀+test.queries) (w₀+test.work n R))
      (fun i => bits (1+i)) t).output=none := by rw [er]; rfl
  have rel := execution_relabel_before_halt p.code (fork test p q).code (noLabel p.size q.size)
    (lastLabel p.size) p.exit_halt (fork_no test p q) O _ (fun i => bits (1+i)) t en
  rw [er] at rel
  rw [execution_add]
  change execution (fork test p q).code O
    (machineStep (fork test p q).code O (bits 0) (state R 0 q₀ w₀)) (fun i => bits (1+i)) t = _
  rw [first]
  change execution (fork test p q).code O
    (relabelConfig (noLabel p.size q.size) (state S 0 (q₀+test.queries) (w₀+test.work n R)))
    (fun i => bits (1+i)) t = _
  rw [rel]
  simp only [state,relabelConfig,noLabel_exit,Nat.add_assoc]
  rfl
lemma fork_run_yes {k n : ℕ} (test : Test k) (p q : Block k) (O : IndependenceOracle n)
    (bits : ℕ → Bool) {R S T : Registers k} {t a b : ℕ}
    (ht : test.result O (bits 0) R=some (true,S))
    (hq : Runs q O (fun i => bits (1+i)) S T t a b) :
    Runs (fork test p q) O bits R T (1+t) (test.queries+a) (test.work n R+b) := by
  intro q₀ w₀
  have first := test_step test O (bits 0) (fork test p q).code 0 _ _ (fork_head test p q) R S true ht q₀ w₀
  have er := hq (q₀+test.queries) (w₀+test.work n R)
  have en : (execution q.code O (state S 0 (q₀+test.queries) (w₀+test.work n R))
      (fun i => bits (1+i)) t).output=none := by rw [er]; rfl
  have rel := execution_relabel_before_halt q.code (fork test p q).code (yesLabel p.size q.size)
    (lastLabel q.size) q.exit_halt (fork_yes test p q) O _ (fun i => bits (1+i)) t en
  rw [er] at rel
  rw [execution_add]
  change execution (fork test p q).code O
    (machineStep (fork test p q).code O (bits 0) (state R 0 q₀ w₀)) (fun i => bits (1+i)) t = _
  rw [first]
  change execution (fork test p q).code O
    (relabelConfig (yesLabel p.size q.size) (state S 0 (q₀+test.queries) (w₀+test.work n R)))
    (fun i => bits (1+i)) t = _
  rw [rel]
  simp only [state,relabelConfig,yesLabel_exit,Nat.add_assoc]
  rfl

end MachineCode

section MachineLoops
variable {k s n : ℕ}
def loopLabel (s : ℕ) (i : Fin (s+1)) : Fin (s+2) :=
  if h : i.val=s then 0 else ⟨i.val+1,by omega⟩
def repeatProgram (P : Program k s) (a : Fin (k+8)) : Program k (s+1) := fun pc =>
  if pc.val=0 then .pop a (lastLabel (s+1)) (loopLabel s 0) (loopLabel s 0)
  else if h : pc.val≤ s then (P ⟨pc.val-1,by omega⟩).relabel (loopLabel s)
  else .halt
lemma repeatProgram_body (P : Program k s) (a : Fin (k+8)) (i : Fin (s+1))
    (hi : i≠lastLabel s) : repeatProgram P a (loopLabel s i)=(P i).relabel (loopLabel s) := by
  have hiv : i.val≠s := by intro h; apply hi; exact Fin.ext h
  simp [repeatProgram,loopLabel,hiv,show i.val+1≤ s by omega]
lemma loopLabel_last (s : ℕ) : loopLabel s (lastLabel s)=0 := by simp [loopLabel,lastLabel]
def loopConfig (R : Fin (k+8) → List Bool) (pc : Fin (s+1)) (q c : ℕ) : MachineConfig k s :=
  ⟨R,pc,none,q,c⟩
lemma repeatProgram_pop (P : Program k s) (a : Fin (k+8)) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (x : Bool) (xs : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (repeatProgram P a) O (loopConfig (Function.update R a (x::xs)) 0 q c) bits 1=
      relabelConfig (loopLabel s) (loopConfig (Function.update R a xs) 0 q (c+1)) := by
  cases x <;> simp [execution,machineStep,repeatProgram,loopConfig,relabelConfig]
lemma repeatProgram_empty (P : Program k s) (a : Fin (k+8)) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (repeatProgram P a) O (loopConfig (Function.update R a []) 0 q c) bits 1=
      loopConfig (Function.update R a []) (lastLabel (s+1)) q (c+1) := by
  simp [execution,machineStep,repeatProgram,loopConfig]
def loopState {A : Type*} (f : A → A) : ℕ → A → A
  | 0,x => x
  | m+1,x => loopState f m (f x)
def loopSum {A : Type*} (f : A → A) (g : A → ℕ) : ℕ → A → ℕ
  | 0,_ => 0
  | m+1,x => g x+loopSum f g m (f x)

theorem repeat_block {A : Type*} (P : Program k s) (a : Fin (k+8))
    (hexit : P (lastLabel s)=.halt) (O : IndependenceOracle n)
    (encode : A → Fin (k+8) → List Bool) (f : A → A) (ticks queries work : A → ℕ)
    (body : ∀ (v : A) (xs : List Bool) (q c : ℕ) (bits : ℕ → Bool),
      execution P O (loopConfig (Function.update (encode v) a xs) 0 q c) bits (ticks v)=
        loopConfig (Function.update (encode (f v)) a xs) (lastLabel s) (q+queries v) (c+work v))
    (v : A) (xs : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (repeatProgram P a) O (loopConfig (Function.update (encode v) a xs) 0 q c) bits
      (loopSum f (fun v => ticks v+1) xs.length v+1)=
      loopConfig (Function.update (encode (loopState f xs.length v)) a []) (lastLabel (s+1))
        (q+loopSum f queries xs.length v) (c+loopSum f (fun v => work v+1) xs.length v+1) := by
  induction xs generalizing v q c bits with
  | nil => simpa [loopSum,loopState] using repeatProgram_empty P a O (encode v) q c bits
  | cons x xs ih =>
    have hb := body v xs q (c+1) (fun i => bits (1+i))
    have hnone : (execution P O (loopConfig (Function.update (encode v) a xs) 0 q (c+1))
        (fun i => bits (1+i)) (ticks v)).output=none := by rw [hb]; rfl
    have hl := execution_relabel_before_halt P (repeatProgram P a) (loopLabel s) (lastLabel s)
      hexit (repeatProgram_body P a) O _ (fun i => bits (1+i)) (ticks v) hnone
    have hfirst : execution (repeatProgram P a) O
        (loopConfig (Function.update (encode v) a (x::xs)) 0 q c) bits (1+ticks v)=
        loopConfig (Function.update (encode (f v)) a xs) 0 (q+queries v) (c+1+work v) := by
      rw [execution_add,repeatProgram_pop,hl,hb]
      simp [relabelConfig,loopConfig,loopLabel_last]
    simp only [List.length_cons,loopSum,loopState]
    rw [show ticks v+1+loopSum f (fun v => ticks v+1) xs.length (f v)+1=
      (1+ticks v)+(loopSum f (fun v => ticks v+1) xs.length (f v)+1) by omega,
      execution_add,hfirst,ih]
    congr 1 <;> omega
lemma loopSum_le {A : Type*} (f : A → A) (g : A → ℕ) (B : ℕ) (hg : ∀ x,g x≤B)
    (m : ℕ) (x : A) : loopSum f g m x≤ m*B := by
  induction m generalizing x with
  | zero => simp [loopSum]
  | succ m ih => simpa [loopSum,Nat.succ_mul,Nat.add_comm] using Nat.add_le_add (hg x) (ih (f x))
end MachineLoops

section MachineMove
variable {k n : ℕ}
def reverseProgram (a d : Fin (k+8)) : Program k 3 := fun pc =>
  match pc.val with
  | 0 => .pop a 3 1 2
  | 1 => .push d false 0
  | 2 => .push d true 0
  | _ => .halt
def reverseConfig (R : Fin (k+8) → List Bool) (pc : Fin 4) (q c : ℕ) : MachineConfig k 3 :=
  ⟨R,pc,none,q,c⟩
theorem reverse_block (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs ys : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (reverseProgram a d) O (reverseConfig (pairRegisters R a d xs ys) 0 q c) bits (2*xs.length+1)=
      reverseConfig (pairRegisters R a d [] (xs.reverse++ys)) 3 q (c+2*xs.length+1) := by
  induction xs generalizing ys c bits with
  | nil => simp [execution,machineStep,reverseProgram,reverseConfig,pairRegisters_a _ _ _ had]
  | cons x xs ih =>
    have ht : execution (reverseProgram a d) O (reverseConfig (pairRegisters R a d (x::xs) ys) 0 q c) bits 2=
        reverseConfig (pairRegisters R a d xs (x::ys)) 0 q (c+2) := by
      cases x <;> simp [execution,machineStep,reverseProgram,reverseConfig,pairRegisters_a _ _ _ had,pairRegisters_b,
        pairRegisters_update_a _ _ _ had,pairRegisters_update_b]
    rw [List.length_cons,show 2*(xs.length+1)+1=2+(2*xs.length+1) by omega,execution_add,ht,ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]
    congr 1; omega
def clearProgram (a : Fin (k+8)) : Program k 1 := fun pc => if pc.val=0 then .pop a 1 0 0 else .halt
def clearConfig (R : Fin (k+8) → List Bool) (pc : Fin 2) (q c : ℕ) : MachineConfig k 1 :=
  ⟨R,pc,none,q,c⟩
theorem clear_block (a : Fin (k+8)) (O : IndependenceOracle n)
    (R : Fin (k+8) → List Bool) (xs : List Bool) (q c : ℕ) (bits : ℕ → Bool) :
    execution (clearProgram a) O (clearConfig (Function.update R a xs) 0 q c) bits (xs.length+1)=
      clearConfig (Function.update R a []) 1 q (c+xs.length+1) := by
  induction xs generalizing c bits with
  | nil => simp [execution,machineStep,clearProgram,clearConfig]
  | cons x xs ih =>
    have ht : execution (clearProgram a) O (clearConfig (Function.update R a (x::xs)) 0 q c) bits 1=
        clearConfig (Function.update R a xs) 0 q (c+1) := by
      cases x <;> simp [execution,machineStep,clearProgram,clearConfig]
    rw [List.length_cons,show xs.length+1+1=1+(xs.length+1) by omega,execution_add,ht,ih]
    congr 1; omega
def moveProgram (a b d : Fin (k+8)) : Program k 6 := concatProgram (reverseProgram a b) (reverseProgram b d)
def moveConfig (R : Fin (k+8) → List Bool) (pc : Fin 7) (q c : ℕ) : MachineConfig k 6 :=
  ⟨R,pc,none,q,c⟩
lemma triple_pair_ab (R : Fin (k+8) → List Bool) (a b d : Fin (k+8))
    (hab : a≠b) (had : a≠d) (hbd : b≠d) (xs ys zs us vs : List Bool) :
    pairRegisters (tripleRegisters R a b d xs ys zs) a b us vs=tripleRegisters R a b d us vs zs := by
  simp only [pairRegisters,tripleRegisters_update_a _ _ _ _ hab had,tripleRegisters_update_b _ _ _ _ hbd]
lemma triple_pair_bd (R : Fin (k+8) → List Bool) (a b d : Fin (k+8))
    (hbd : b≠d) (xs ys zs us vs : List Bool) :
    pairRegisters (tripleRegisters R a b d xs ys zs) b d us vs=tripleRegisters R a b d xs us vs := by
  simp only [pairRegisters,tripleRegisters_update_b _ _ _ _ hbd,tripleRegisters_update_d]
theorem move_block (a b d : Fin (k+8)) (hab : a≠b) (had : a≠d) (hbd : b≠d)
    (O : IndependenceOracle n) (R : Fin (k+8) → List Bool) (xs ys : List Bool)
    (q c : ℕ) (bits : ℕ → Bool) :
    execution (moveProgram a b d) O (moveConfig (tripleRegisters R a b d xs [] ys) 0 q c) bits (4*xs.length+2)=
      moveConfig (tripleRegisters R a b d [] [] (xs++ys)) 6 q (c+4*xs.length+2) := by
  have h1 := reverse_block a b hab O (tripleRegisters R a b d xs [] ys) xs [] q c bits
  simp only [triple_pair_ab _ _ _ _ hab had hbd,List.append_nil] at h1
  have h2 := reverse_block b d hbd O (tripleRegisters R a b d [] xs.reverse ys) xs.reverse ys q
    (c+2*xs.length+1) (fun i => bits (2*xs.length+1+i))
  simp only [triple_pair_bd _ _ _ _ hbd,List.reverse_reverse,List.length_reverse] at h2
  have h := concat_run (reverseProgram a b) (reverseProgram b d) (by rfl) O
    (reverseConfig (tripleRegisters R a b d xs [] ys) 0 q c) bits (2*xs.length+1) (2*xs.length+1)
    (by rw [h1]; rfl) (by rw [h1]; rfl)
  rw [h1] at h
  change execution (moveProgram a b d) O (moveConfig (tripleRegisters R a b d xs [] ys) 0 q c) bits
    ((2*xs.length+1)+(2*xs.length+1))=relabelConfig (secondLabel 3 3)
      (execution (reverseProgram b d) O (reverseConfig (tripleRegisters R a b d [] xs.reverse ys) 0 q (c+2*xs.length+1))
        (fun i => bits (2*xs.length+1+i)) (2*xs.length+1)) at h
  rw [h2] at h
  convert h using 1 <;> simp only [relabelConfig,reverseConfig,moveConfig,secondLabel,
    show 2*xs.length+1+(2*xs.length+1)=4*xs.length+2 by omega,
    show c+2*xs.length+1+2*xs.length+1=c+4*xs.length+2 by omega]
  rfl
end MachineMove

namespace MachineCode

def reverse {k : ℕ} (a d : Fin (k+8)) : Block k :=
  ⟨3,reverseProgram a d,rfl⟩
def clear {k : ℕ} (a : Fin (k+8)) : Block k :=
  ⟨1,clearProgram a,rfl⟩
def move {k : ℕ} (a b d : Fin (k+8)) : Block k :=
  ⟨6,moveProgram a b d,rfl⟩
def pack {k : ℕ} (a d : Fin (k+8)) : Block k :=
  ⟨5,framePackProgram a d,rfl⟩
def unpack {k : ℕ} (a d : Fin (k+8)) : Block k where
  size := 4
  code := fun pc => match pc.val with
    | 0 => .pop a 4 1 4
    | 1 => .pop a 4 2 3
    | 2 => .push d false 0
    | 3 => .push d true 0
    | _ => .halt
  exit_halt := rfl

lemma runs_reverse {k n : ℕ} (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Registers k) (xs ys : List Bool) (bits : ℕ → Bool) :
    Runs (reverse a d) O bits (pairRegisters R a d xs ys)
      (pairRegisters R a d [] (xs.reverse++ys)) (2*xs.length+1) 0 (2*xs.length+1) := by
  intro q w
  convert reverse_block a d had O R xs ys q w bits using 1 <;> simp [reverse,state,reverseConfig,lastLabel,Nat.add_assoc]
  rfl
lemma runs_clear {k n : ℕ} (a : Fin (k+8)) (O : IndependenceOracle n)
    (R : Registers k) (xs : List Bool) (bits : ℕ → Bool) :
    Runs (clear a) O bits (Function.update R a xs)
      (Function.update R a []) (xs.length+1) 0 (xs.length+1) := by
  intro q w
  convert clear_block a O R xs q w bits using 1 <;> simp [clear,state,clearConfig,lastLabel,Nat.add_assoc]
  rfl
lemma runs_move {k n : ℕ} (a b d : Fin (k+8)) (hab : a≠b) (had : a≠d) (hbd : b≠d)
    (O : IndependenceOracle n) (R : Registers k) (xs ys : List Bool) (bits : ℕ → Bool) :
    Runs (move a b d) O bits (tripleRegisters R a b d xs [] ys)
      (tripleRegisters R a b d [] [] (xs++ys)) (4*xs.length+2) 0 (4*xs.length+2) := by
  intro q w
  convert move_block a b d hab had hbd O R xs ys q w bits using 1 <;> simp [move,state,moveConfig,lastLabel,Nat.add_assoc]
  rfl
lemma runs_pack {k n : ℕ} (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Registers k) (xs ts : List Bool) (bits : ℕ → Bool) :
    Runs (pack a d) O bits (pairRegisters R a d xs ts)
      (pairRegisters R a d [] (bitFrame xs.reverse++ts)) (3*xs.length+2) 0 (3*xs.length+2) := by
  intro q w
  convert frame_pack_block a d had O R xs ts q w bits using 1 <;> simp [pack,state,frameConfig,lastLabel,Nat.add_assoc]
  rfl
lemma runs_unpack {k n : ℕ} (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Registers k) (xs ts zs : List Bool) (bits : ℕ → Bool) :
    Runs (unpack a d) O bits (pairRegisters R a d (bitFrame xs++ts) zs)
      (pairRegisters R a d ts (xs.reverse++zs)) (3*xs.length+1) 0 (3*xs.length+1) := by
  intro q w
  let f : Fin 6 → Fin 5 := fun i => ⟨min i.val 4,by omega⟩
  have h := frame_unpack_block a d had O R xs ts zs q w bits
  have hn : (execution (frameUnpackProgram a d) O
      (frameConfig (pairRegisters R a d (bitFrame xs++ts) zs) 0 q w) bits (3*xs.length+1)).output=none := by
    rw [h]; rfl
  have rel := execution_relabel_before_halt (frameUnpackProgram a d) (unpack a d).code f 4 rfl
    (by intro i hi; fin_cases i <;> rfl) O _ bits (3*xs.length+1) hn
  rw [h] at rel
  convert rel using 1 <;> simp [state,relabelConfig,frameConfig,f,unpack,lastLabel,Nat.add_assoc]
  rfl
lemma runs_unpack_packed {k n : ℕ} (a d : Fin (k+8)) (had : a≠d) (O : IndependenceOracle n)
    (R : Registers k) (xs ts : List Bool) (bits : ℕ → Bool) :
    Runs (unpack a d) O bits (pairRegisters R a d (bitFrame xs.reverse++ts) [])
      (pairRegisters R a d ts xs) (3*xs.length+1) 0 (3*xs.length+1) := by
  simpa only [List.length_reverse,List.reverse_reverse,List.append_nil] using
    runs_unpack a d had O R xs.reverse ts [] bits

def repeatBlock {k : ℕ} (p : Block k) (a : Fin (k+8)) : Block k where
  size := p.size+1
  code := repeatProgram p.code a
  exit_halt := by simp [repeatProgram,lastLabel]

abbrev Word := List Bool

def regs (x y z saved : Word) : Registers 1 := fun i =>
  if i=0 then x else if i=1 then y else if i=2 then z else if i=8 then saved else []
@[simp] lemma regs_zero (x y z s : Word) : regs x y z s 0=x := by simp [regs]
@[simp] lemma regs_one (x y z s : Word) : regs x y z s 1=y := by simp [regs]
@[simp] lemma regs_two (x y z s : Word) : regs x y z s 2=z := by simp [regs]
@[simp] lemma regs_eight (x y z s : Word) : regs x y z s 8=s := by simp [regs]
@[simp] lemma update_regs_zero (x y z s u : Word) : Function.update (regs x y z s) 0 u=regs u y z s := by
  funext i; fin_cases i <;> simp [regs]
@[simp] lemma update_regs_one (x y z s u : Word) : Function.update (regs x y z s) 1 u=regs x u z s := by
  funext i; fin_cases i <;> simp [regs]
@[simp] lemma update_regs_two (x y z s u : Word) : Function.update (regs x y z s) 2 u=regs x y u s := by
  funext i; fin_cases i <;> simp [regs]
@[simp] lemma update_regs_eight (x y z s u : Word) : Function.update (regs x y z s) 8 u=regs x y z u := by
  funext i; fin_cases i <;> simp [regs]

def pair (x y : Word) : Word := bitFrame x.reverse++y
@[simp] lemma pair_length (x y : Word) : (pair x y).length=2*x.length+1+y.length := by
  simp [pair,bitFrame_length]

def Computes {n : ℕ} (p : Block 1) (O : IndependenceOracle n)
    (x y : Word) (t q w : ℕ) : Prop :=
  ∀ saved bits, Runs p O bits (regs x [] [] saved) (regs y [] [] saved) t q w

def Bounded {n : ℕ} (p : Block 1) (O : IndependenceOracle n) (x y : Word) (B : ℕ) : Prop :=
  ∃ t q w, t≤B ∧ q≤B ∧ w≤B ∧ Computes p O x y t q w

lemma computes_skip {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Computes (skip 1) O x x 0 0 0 := fun s bits => runs_skip O bits (regs x [] [] s)
lemma computes_seq {n : ℕ} {p q : Block 1} {O : IndependenceOracle n} {x y z : Word}
    {t₁ q₁ w₁ t₂ q₂ w₂ : ℕ} (hp : Computes p O x y t₁ q₁ w₁) (hq : Computes q O y z t₂ q₂ w₂) :
    Computes (seq p q) O x z (t₁+t₂) (q₁+q₂) (w₁+w₂) := by
  intro s bits
  exact runs_seq O bits (hp s bits) (hq s (fun i => bits (t₁+i)))
lemma bounded_seq {n : ℕ} {p q : Block 1} {O : IndependenceOracle n} {x y z : Word}
    {B C : ℕ} (hp : Bounded p O x y B) (hq : Bounded q O y z C) :
    Bounded (seq p q) O x z (B+C) := by
  obtain ⟨t₁,q₁,w₁,ht₁,hq₁,hw₁,hp⟩ := hp
  obtain ⟨t₂,q₂,w₂,ht₂,hq₂,hw₂,hq⟩ := hq
  exact ⟨_,_,_,Nat.add_le_add ht₁ ht₂,Nat.add_le_add hq₁ hq₂,Nat.add_le_add hw₁ hw₂,computes_seq hp hq⟩
lemma bounded_mono {n : ℕ} {p : Block 1} {O : IndependenceOracle n} {x y : Word}
    {B C : ℕ} (h : Bounded p O x y B) (hBC : B≤C) : Bounded p O x y C := by
  obtain ⟨t,q,w,ht,hq,hw,hp⟩ := h
  exact ⟨t,q,w,ht.trans hBC,hq.trans hBC,hw.trans hBC,hp⟩

def copy {k : ℕ} (a b d : Fin (k+8)) : Block k := ⟨8,copyProgram a b d,rfl⟩
lemma runs_copy {k n : ℕ} (a b d : Fin (k+8)) (hab : a≠b) (had : a≠d) (hbd : b≠d)
    (O : IndependenceOracle n) (R : Registers k) (xs ys : Word) (bits : ℕ → Bool) :
    Runs (copy a b d) O bits (tripleRegisters R a b d xs [] ys)
      (tripleRegisters R a b d xs [] (xs++ys)) (5*xs.length+2) 0 (5*xs.length+2) := by
  intro q w
  convert copy_block a b d hab had hbd O R xs ys q w bits using 1 <;>
    simp [copy,state,copyConfig,lastLabel,Nat.add_assoc]
  rfl

def duplicate : Block 1 := seq (copy 0 2 1) (pack 1 0)
lemma computes_duplicate {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Computes duplicate O x (pair x x) (8*x.length+4) 0 (8*x.length+4) := by
  intro s bits
  have hc := runs_copy (k:=1) 0 2 1 (by decide) (by decide) (by decide) O (regs x [] [] s) x [] bits
  simp only [tripleRegisters,pairRegisters,update_regs_zero,update_regs_two,update_regs_one,List.append_nil] at hc
  have hp := runs_pack (k:=1) 1 0 (by decide) O (regs x x [] s) x x (fun i => bits (5*x.length+2+i))
  simp only [pairRegisters,update_regs_one,update_regs_zero] at hp
  simpa only [duplicate,pair,show 5*x.length+2+(3*x.length+2)=8*x.length+4 by omega,Nat.zero_add] using
    runs_seq O bits hc hp

lemma split_pair {n : ℕ} (O : IndependenceOracle n) (x y z s : Word) (bits : ℕ → Bool) :
    Runs (unpack 0 1) O bits (regs (pair x y) z [] s) (regs y (x++z) [] s)
      (3*x.length+1) 0 (3*x.length+1) := by
  have h := runs_unpack (k:=1) 0 1 (by decide) O (regs [] [] [] s) x.reverse y z bits
  simpa only [pair,pairRegisters,update_regs_zero,update_regs_one,List.length_reverse,List.reverse_reverse] using h
lemma make_pair {n : ℕ} (O : IndependenceOracle n) (x y z s : Word) (bits : ℕ → Bool) :
    Runs (pack 1 0) O bits (regs y x z s) (regs (pair x y) [] z s)
      (3*x.length+2) 0 (3*x.length+2) := by
  simpa only [pair,pairRegisters,update_regs_zero,update_regs_one] using
    runs_pack (k:=1) 1 0 (by decide) O (regs [] [] z s) x y bits
lemma move_one_zero {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (move 1 2 0) O bits (regs y x [] s) (regs (x++y) [] [] s)
      (4*x.length+2) 0 (4*x.length+2) := by
  simpa only [tripleRegisters,pairRegisters,update_regs_zero,update_regs_one,update_regs_two] using
    runs_move (k:=1) 1 2 0 (by decide) (by decide) (by decide) O (regs [] [] [] s) x y bits

def first : Block 1 := seq (unpack 0 1) (seq (clear 0) (move 1 2 0))
def second : Block 1 := seq (unpack 0 1) (clear 1)
lemma computes_first {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes first O (pair x y) x (7*x.length+y.length+4) 0 (7*x.length+y.length+4) := by
  intro s bits
  have hu := split_pair O x y [] s bits
  have hc := runs_clear (k:=1) 0 O (regs y x [] s) y (fun i => bits (3*x.length+1+i))
  simp only [update_regs_zero] at hc
  have hm := move_one_zero O x [] s (fun i => bits (3*x.length+1+(y.length+1+i)))
  simp only [List.append_nil] at hu hm
  have ht := runs_seq O bits hu (runs_seq O (fun i => bits (3*x.length+1+i)) hc hm)
  simpa only [first,show 3*x.length+1+(y.length+1+(4*x.length+2))=7*x.length+y.length+4 by omega,Nat.zero_add] using ht
lemma computes_second {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes second O (pair x y) y (4*x.length+2) 0 (4*x.length+2) := by
  intro s bits
  have hu := split_pair O x y [] s bits
  simp only [List.append_nil] at hu
  have hc := runs_clear (k:=1) 1 O (regs y x [] s) x (fun i => bits (3*x.length+1+i))
  simp only [update_regs_one] at hc
  simpa only [second,show 3*x.length+1+(x.length+1)=4*x.length+2 by omega,Nat.zero_add] using runs_seq O bits hu hc

lemma save_zero {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (pack 0 8) O bits (regs x y [] s) (regs [] y [] (pair x s))
      (3*x.length+2) 0 (3*x.length+2) := by
  simpa only [pair,pairRegisters,update_regs_zero,update_regs_eight] using
    runs_pack (k:=1) 0 8 (by decide) O (regs [] y [] []) x s bits
lemma restore_one {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (unpack 8 1) O bits (regs x [] [] (pair y s)) (regs x y [] s)
      (3*y.length+1) 0 (3*y.length+1) := by
  simpa only [pair,pairRegisters,update_regs_one,update_regs_eight] using
    runs_unpack_packed (k:=1) 8 1 (by decide) O (regs x [] [] []) y s bits
lemma pack_zero_one {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (pack 0 1) O bits (regs x y [] s) (regs [] (pair x y) [] s)
      (3*x.length+2) 0 (3*x.length+2) := by
  simpa only [pair,pairRegisters,update_regs_zero,update_regs_one] using
    runs_pack (k:=1) 0 1 (by decide) O (regs [] [] [] s) x y bits

def swap : Block 1 := seq (unpack 0 1) (seq (pack 0 1) (move 1 2 0))
lemma computes_swap {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes swap O (pair x y) (pair y x) (7*x.length+11*y.length+9) 0 (7*x.length+11*y.length+9) := by
  intro s bits
  have hu := split_pair O x y [] s bits
  simp only [List.append_nil] at hu
  have hp := pack_zero_one O y x s (fun i => bits (3*x.length+1+i))
  have hm := move_one_zero O (pair y x) [] s (fun i => bits (3*x.length+1+(3*y.length+2+i)))
  simp only [List.append_nil] at hm
  have ht := runs_seq O bits hu (runs_seq O (fun i => bits (3*x.length+1+i)) hp hm)
  have he : 3*x.length+1+(3*y.length+2+(4*(pair y x).length+2))=7*x.length+11*y.length+9 := by
    rw [pair_length]; omega
  simpa only [swap,he,Nat.zero_add] using ht

def left (p : Block 1) : Block 1 :=
  seq (unpack 0 1) (seq (pack 0 8) (seq (move 1 2 0)
    (seq p (seq (unpack 8 1) (seq (pack 0 1) (move 1 2 0))))))
lemma computes_left {n : ℕ} {O : IndependenceOracle n} {p : Block 1} {x u : Word}
    {t q w : ℕ} (h : Computes p O x u t q w) (y : Word) :
    Computes (left p) O (pair x y) (pair u y)
      (7*x.length+10*y.length+11*u.length+14+t) q (7*x.length+10*y.length+11*u.length+14+w) := by
  intro s bits
  have hu := split_pair O x y [] s bits
  simp only [List.append_nil] at hu
  have hs := save_zero O y x s (fun i => bits (3*x.length+1+i))
  have hm := move_one_zero O x [] (pair y s) (fun i => bits (3*x.length+1+(3*y.length+2+i)))
  simp only [List.append_nil] at hm
  have hp := h (pair y s) (fun i => bits (3*x.length+1+(3*y.length+2+(4*x.length+2+i))))
  have hr := restore_one O u y s (fun i => bits (3*x.length+1+(3*y.length+2+(4*x.length+2+(t+i)))))
  have hf := pack_zero_one O u y s (fun i => bits (3*x.length+1+(3*y.length+2+(4*x.length+2+(t+(3*y.length+1+i))))))
  have he := move_one_zero O (pair u y) [] s
    (fun i => bits (3*x.length+1+(3*y.length+2+(4*x.length+2+(t+(3*y.length+1+(3*u.length+2+i)))))))
  simp only [List.append_nil] at he
  have ht := runs_seq O bits hu (runs_seq O _ hs (runs_seq O _ hm
    (runs_seq O _ hp (runs_seq O _ hr (runs_seq O _ hf he)))))
  have cost (v : ℕ) : 3*x.length+1+(3*y.length+2+(4*x.length+2+(v+(3*y.length+1+(3*u.length+2+(4*(pair u y).length+2))))))=
      7*x.length+10*y.length+11*u.length+14+v := by rw [pair_length]; omega
  simpa only [left,cost,Nat.zero_add,Nat.add_zero] using ht

def right (p : Block 1) : Block 1 := seq swap (seq (left p) swap)
lemma computes_right {n : ℕ} {O : IndependenceOracle n} {p : Block 1} {x u : Word}
    {t q w : ℕ} (h : Computes p O x u t q w) (y : Word) :
    Computes (right p) O (pair y x) (pair y u)
      (28*y.length+18*x.length+18*u.length+32+t) q (28*y.length+18*x.length+18*u.length+32+w) := by
  have ht := computes_seq (computes_swap O y x) (computes_seq (computes_left h y) (computes_swap O u y))
  convert ht using 1 <;> first | rfl | omega

def parallel (p q : Block 1) : Block 1 := seq (left p) (right q)
def fanout (p q : Block 1) : Block 1 := seq duplicate (parallel p q)

def stripZeros : Word → Word
  | [] => []
  | false::xs => stripZeros xs
  | true::xs => true::xs
def stripCost : Word → ℕ
  | [] => 1
  | false::xs => 1+stripCost xs
  | true::_ => 2
lemma strip_length (x : Word) : (stripZeros x).length≤x.length := by
  induction x with
  | nil => rfl
  | cons b xs ih => cases b <;> simp only [stripZeros,List.length_cons] <;> omega
lemma strip_cost_le (x : Word) : stripCost x≤x.length+2 := by
  induction x with
  | nil => decide
  | cons b xs ih => cases b <;> simp only [stripCost,List.length_cons] <;> omega
lemma strip_append (x y : Word) : stripZeros (x++y)=if stripZeros x=[] then stripZeros y else stripZeros x++y := by
  induction x with
  | nil => simp [stripZeros]
  | cons b xs ih =>
    cases b <;> simp [stripZeros,ih]
    rfl

def normalWord (x : Word) : Word := (stripZeros x.reverse).reverse
lemma normal_length (x : Word) : (normalWord x).length≤x.length := by
  simpa only [normalWord,List.length_reverse] using strip_length x.reverse
lemma normalWord_cons (b : Bool) (xs : Word) :
    normalWord (b::xs)=if normalWord xs=[] then (if b then [true] else []) else b::normalWord xs := by
  simp only [normalWord,List.reverse_cons,strip_append]
  by_cases h : stripZeros xs.reverse=[]
  · simp [h]; cases b <;> rfl
  · simp [h,List.reverse_eq_nil_iff]

lemma binaryValue_bits (n : ℕ) : binaryValue n.bits=n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n hn ih =>
    rw [Nat.bits_append_bit n b hn]
    cases b <;> simp [binaryValue,ih,Nat.bit]
    omega
lemma normalWord_eq_bits (xs : Word) : normalWord xs=(binaryValue xs).bits := by
  induction xs with
  | nil => rfl
  | cons b xs ih =>
    rw [normalWord_cons,ih]
    by_cases hz : binaryValue xs=0
    · cases b <;> simp [binaryValue,hz]
    · have hb : (binaryValue xs).bits≠[] := by
        intro h
        have he := binaryValue_bits (binaryValue xs)
        rw [h] at he
        exact hz he.symm
      cases b with
      | false => simp [binaryValue,hb,Nat.bit0_bits _ hz]
      | true =>
        simp only [ite_true,ite_eq_right hb,binaryValue]
        rw [Nat.add_comm 1, Nat.bit1_bits]
lemma normalWord_value (xs : Word) : binaryValue (normalWord xs)=binaryValue xs := by
  rw [normalWord_eq_bits,binaryValue_bits]
@[simp] lemma normalWord_bits (n : ℕ) : normalWord n.bits=n.bits := by
  rw [normalWord_eq_bits,binaryValue_bits]

def stripCode {k : ℕ} (a : Fin (k+8)) : Block k where
  size := 2
  code := fun pc => match pc.val with
    | 0 => .pop a 2 0 1
    | 1 => .push a true 2
    | _ => .halt
  exit_halt := rfl
lemma runs_strip {k n : ℕ} (a : Fin (k+8)) (O : IndependenceOracle n) (R : Registers k)
    (x : Word) (bits : ℕ → Bool) :
    Runs (stripCode a) O bits (Function.update R a x) (Function.update R a (stripZeros x))
      (stripCost x) 0 (stripCost x) := by
  intro q w
  induction x generalizing w bits with
  | nil => simp [stripCode,stripCost,stripZeros,execution,machineStep,state,lastLabel]
  | cons b xs ih =>
    cases b with
    | false =>
      have hf : execution (stripCode a).code O (state (Function.update R a (false::xs)) 0 q w) bits 1=
          state (Function.update R a xs) 0 q (w+1) := by
        simp [stripCode,state,execution,machineStep]
        rfl
      rw [stripCost,execution_add,hf,ih]
      simp [stripZeros,Nat.add_assoc]
    | true => simp [stripCode,stripCost,stripZeros,execution,machineStep,state,lastLabel,Nat.add_assoc]

def normalCode : Block 1 := seq (reverse 0 1) (seq (stripCode 1) (reverse 1 0))
def normalCost (x : Word) : ℕ := 2*x.length+1+(stripCost x.reverse+(2*(stripZeros x.reverse).length+1))
lemma normalCost_le (x : Word) : normalCost x≤5*x.length+4 := by
  have h₁:=strip_cost_le x.reverse
  have h₂:=strip_length x.reverse
  simp only [List.length_reverse] at h₁ h₂
  unfold normalCost
  omega
lemma computes_normalCode {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Computes normalCode O x (normalWord x) (normalCost x) 0 (normalCost x) := by
  intro s bits
  have h₁ := runs_reverse (k:=1) 0 1 (by decide) O (regs [] [] [] s) x [] bits
  simp only [pairRegisters,update_regs_zero,update_regs_one,List.append_nil] at h₁
  have h₂ := runs_strip (k:=1) 1 O (regs [] [] [] s) x.reverse (fun i => bits (2*x.length+1+i))
  simp only [update_regs_one] at h₂
  have h₃ := runs_reverse (k:=1) 1 0 (by decide) O (regs [] [] [] s) (stripZeros x.reverse) []
    (fun i => bits (2*x.length+1+(stripCost x.reverse+i)))
  simp only [pairRegisters,update_regs_zero,update_regs_one,List.append_nil] at h₃
  simpa only [normalCode,normalCost,normalWord,Nat.zero_add] using runs_seq O bits h₁ (runs_seq O _ h₂ h₃)
lemma bounded_normalCode {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Bounded normalCode O x (binaryValue x).bits (5*x.length+4) := by
  refine ⟨normalCost x,0,normalCost x,normalCost_le x,Nat.zero_le _,normalCost_le x,?_⟩
  rw [←normalWord_eq_bits]
  exact computes_normalCode O x

def addBlock : Block 1 := ⟨16,addProgram 0 1 2,rfl⟩
def addTime (x y : Word) : ℕ := addCost false x y+2*(addDigits false x y).length+1
lemma runs_add {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs addBlock O bits (regs x y [] s) (regs (addDigits false x y) [] [] s)
      (addTime x y) 0 (addTime x y) := by
  dsimp only [Runs,addBlock]
  intro q w
  have h := (addition_block (k:=1) 0 1 2 (by decide) (by decide) (by decide) O (regs [] [] [] s) x y q w bits).2.2
  convert h using 1 <;> simp only [addTime,addConfig,state,tripleRegisters,pairRegisters,update_regs_zero,
    update_regs_one,update_regs_two,lastLabel,Nat.add_zero]
  rfl
lemma addTime_le (x y : Word) : addTime x y ≤ 5*(x.length+y.length)+6 := by
  have h := addDigits_length_cost false x y
  unfold addTime
  omega

def addCode : Block 1 := seq (unpack 0 1) (seq addBlock normalCode)
lemma computes_add {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes addCode O (pair x y) (binaryValue x+binaryValue y).bits
      (3*x.length+1+addTime y x+normalCost (addDigits false y x)) 0
      (3*x.length+1+addTime y x+normalCost (addDigits false y x)) := by
  have hv : binaryValue (addDigits false y x)=binaryValue x+binaryValue y := by
    simpa [Nat.add_comm] using addDigits_value false y x
  intro s bits
  have hs := split_pair O x y [] s bits
  simp only [List.append_nil] at hs
  have ha := runs_add O y x s (fun i => bits (3*x.length+1+i))
  have hn := computes_normalCode O (addDigits false y x) s (fun i => bits (3*x.length+1+(addTime y x+i)))
  rw [normalWord_eq_bits,hv] at hn
  have ht := runs_seq O bits hs (runs_seq O _ ha hn)
  simpa only [addCode,Nat.zero_add,Nat.add_assoc] using ht
lemma bounded_add {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Bounded addCode O (pair x y) (binaryValue x+binaryValue y).bits (20*(x.length+y.length+1)) := by
  have h₁ := addTime_le y x
  have h₂ := normalCost_le (addDigits false y x)
  have h₃ := (addDigits_length_cost false y x).1
  refine ⟨_,0,_,?_,Nat.zero_le _,?_,computes_add O x y⟩ <;> omega

def mulBlock : Block 1 := ⟨26,mulProgram,rfl⟩
lemma mulRegisters_regs (x y z s : Word) : mulRegisters (regs [] [] [] s) x y z []=regs x y z s := by
  funext i; fin_cases i <;> simp [mulRegisters,regs]
lemma runs_mul {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs mulBlock O bits (regs x y [] s)
      (regs (List.replicate y.length false++x) [] (mulDigits x y []) s)
      (mulCost x y []) 0 (mulCost x y []) := by
  dsimp only [Runs,mulBlock]
  intro q w
  have h := (multiplication_block (k:=1) O (regs [] [] [] s) x y q w bits).2.2
  convert h using 1 <;> simp only [mulConfig,state,mulRegisters_regs,lastLabel,Nat.add_zero]
  rfl
lemma clear_zero {n : ℕ} (O : IndependenceOracle n) (x y z s : Word) (bits : ℕ → Bool) :
    Runs (clear 0) O bits (regs x y z s) (regs [] y z s) (x.length+1) 0 (x.length+1) := by
  simpa only [update_regs_zero] using runs_clear (k:=1) 0 O (regs [] y z s) x bits
lemma move_two_zero {n : ℕ} (O : IndependenceOracle n) (x s : Word) (bits : ℕ → Bool) :
    Runs (move 2 1 0) O bits (regs [] [] x s) (regs x [] [] s) (4*x.length+2) 0 (4*x.length+2) := by
  simpa only [tripleRegisters,pairRegisters,update_regs_zero,update_regs_one,update_regs_two,List.append_nil] using
    runs_move (k:=1) 2 1 0 (by decide) (by decide) (by decide) O (regs [] [] [] s) x [] bits

def mulCode : Block 1 := seq (unpack 0 1) (seq mulBlock (seq (clear 0) (seq (move 2 1 0) normalCode)))
def mulTime (x y : Word) : ℕ :=
  3*x.length+1+mulCost y x []+(x.length+y.length+1)+(4*(mulDigits y x []).length+2)+normalCost (mulDigits y x [])
lemma computes_mul {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes mulCode O (pair x y) (binaryValue x*binaryValue y).bits (mulTime x y) 0 (mulTime x y) := by
  have hv : binaryValue (mulDigits y x [])=binaryValue x*binaryValue y := by
    simp [mulDigits_value,binaryValue,Nat.mul_comm]
  intro s bits
  have h₁ := split_pair O x y [] s bits
  simp only [List.append_nil] at h₁
  have h₂ := runs_mul O y x s (fun i => bits (3*x.length+1+i))
  have h₃ := clear_zero O (List.replicate x.length false++y) [] (mulDigits y x []) s
    (fun i => bits (3*x.length+1+(mulCost y x []+i)))
  simp only [List.length_append,List.length_replicate] at h₃
  have h₄ := move_two_zero O (mulDigits y x []) s
    (fun i => bits (3*x.length+1+(mulCost y x []+(x.length+y.length+1+i))))
  have h₅ := computes_normalCode O (mulDigits y x []) s
    (fun i => bits (3*x.length+1+(mulCost y x []+(x.length+y.length+1+(4*(mulDigits y x []).length+2+i)))))
  rw [normalWord_eq_bits,hv] at h₅
  have ht := runs_seq O bits h₁ (runs_seq O _ h₂ (runs_seq O _ h₃ (runs_seq O _ h₄ h₅)))
  simpa only [mulCode,mulTime,Nat.zero_add,Nat.add_assoc] using ht
lemma mulTime_le (x y : Word) : mulTime x y ≤ 60*(x.length+y.length+1)^2 := by
  have h₁ := mulCost_bound y x []
  have h₂ := mulDigits_length y x []
  have h₃ := normalCost_le (mulDigits y x [])
  simp only [List.length_nil,Nat.max_zero] at h₁ h₂
  unfold mulTime
  nlinarith [sq_nonneg (x.length:ℤ),sq_nonneg (y.length:ℤ)]
lemma bounded_mul {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Bounded mulCode O (pair x y) (binaryValue x*binaryValue y).bits (60*(x.length+y.length+1)^2) :=
  ⟨_,0,_,mulTime_le x y,Nat.zero_le _,mulTime_le x y,computes_mul O x y⟩

lemma computes_parallel {n : ℕ} {O : IndependenceOracle n} {p q : Block 1} {x y u v : Word}
    {t₁ q₁ w₁ t₂ q₂ w₂ : ℕ} (hp : Computes p O x u t₁ q₁ w₁) (hq : Computes q O y v t₂ q₂ w₂) :
    Computes (parallel p q) O (pair x y) (pair u v)
      (7*x.length+28*y.length+39*u.length+18*v.length+46+t₁+t₂) (q₁+q₂)
      (7*x.length+28*y.length+39*u.length+18*v.length+46+w₁+w₂) := by
  have ht := computes_seq (computes_left hp y) (computes_right hq u)
  convert ht using 1 <;> first | rfl | omega
lemma computes_fanout {n : ℕ} {O : IndependenceOracle n} {p q : Block 1} {x u v : Word}
    {t₁ q₁ w₁ t₂ q₂ w₂ : ℕ} (hp : Computes p O x u t₁ q₁ w₁) (hq : Computes q O x v t₂ q₂ w₂) :
    Computes (fanout p q) O x (pair u v)
      (43*x.length+39*u.length+18*v.length+50+t₁+t₂) (q₁+q₂)
      (43*x.length+39*u.length+18*v.length+50+w₁+w₂) := by
  have ht := computes_seq (computes_duplicate O x) (computes_parallel hp hq)
  convert ht using 1 <;> first | rfl | omega

def prependCode : Word → Block 1
  | [] => skip 1
  | b::xs => seq (prependCode xs) (push 0 b)
lemma computes_prepend {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes (prependCode x) O y (x++y) x.length 0 x.length := by
  induction x with
  | nil => exact computes_skip O y
  | cons b xs ih =>
    have hp : Computes (push 0 b) O (xs++y) (b::(xs++y)) 1 0 1 := by
      intro s bits
      simpa only [regs_zero,update_regs_zero] using runs_push O bits (regs (xs++y) [] [] s) 0 b
    have ht := computes_seq ih hp
    simpa only [prependCode,List.cons_append,List.length_cons,Nat.zero_add] using ht

def constCode (x : Word) : Block 1 := seq (clear 0) (prependCode x)
lemma computes_const {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes (constCode y) O x y (x.length+y.length+1) 0 (x.length+y.length+1) := by
  have hc : Computes (clear 0) O x [] (x.length+1) 0 (x.length+1) :=
    fun s bits => clear_zero O x [] [] s bits
  have ht := computes_seq hc (computes_prepend O y [])
  simpa only [constCode,List.append_nil,Nat.zero_add,show x.length+1+y.length=x.length+y.length+1 by omega] using ht

def selectCode (p q : Block 1) : Block 1 := seq (unpack 0 1) (fork (.pop 1 false false true) p q)
lemma computes_select {n : ℕ} {O : IndependenceOracle n} (p q : Block 1) (b : Bool) {x y : Word}
    {t a w : ℕ} (h : Computes (if b then q else p) O x y t a w) :
    Computes (selectCode p q) O (pair [b] x) y (5+t) a (5+w) := by
  intro s bits
  have hu := split_pair O [b] x [] s bits
  simp only [List.append_nil,List.length_singleton,show 3*1+1=4 by omega] at hu
  have hf : Runs (fork (.pop 1 false false true) p q) O (fun i => bits (4+i))
      (regs x [b] [] s) (regs y [] [] s) (1+t) a (1+w) := by
    cases b with
    | false =>
      have hp := h s (fun i => bits (4+(1+i)))
      have hh := fork_run_no (.pop 1 false false true) p q O (fun i => bits (4+i))
        (R:=regs x [false] [] s) (by simp [Test.result]) hp
      simpa only [Test.queries,Test.work,Nat.zero_add] using hh
    | true =>
      have hp := h s (fun i => bits (4+(1+i)))
      have hh := fork_run_yes (.pop 1 false false true) p q O (fun i => bits (4+i))
        (R:=regs x [true] [] s) (by simp [Test.result]) hp
      simpa only [Test.queries,Test.work,Nat.zero_add] using hh
  have ht := runs_seq O bits hu hf
  simpa only [selectCode,Nat.zero_add,show 4+(1+t)=5+t by omega,show 4+(1+w)=5+w by omega] using ht

def queryCode (which : Bool) : Block 1 := fork (.query which 0) (constCode [false]) (constCode [true])
lemma computes_query {n : ℕ} (O : IndependenceOracle n) (which : Bool) (x : Word) (hx : x.length=n) :
    Computes (queryCode which) O x [O which (fun i => x[i.val]?.getD false)] (n+3) 1 (3*n+3) := by
  intro s bits
  have hp (b : Bool) := computes_const O x [b] s (fun i => bits (1+i))
  have hres : (Test.query which 0).result O (bits 0) (regs x [] [] s)=
      some (O which (fun i => x[i.val]?.getD false),regs x [] [] s) := by simp [Test.result,hx]
  cases hb : O which (fun i => x[i.val]?.getD false) with
  | false =>
    rw [hb] at hres
    have ht := fork_run_no (.query which 0) (constCode [false]) (constCode [true]) O bits hres (hp false)
    simp only [Test.queries,Test.work,regs_zero,hx,List.length_singleton] at ht
    convert ht using 1 <;> first | rfl | omega
  | true =>
    rw [hb] at hres
    have ht := fork_run_yes (.query which 0) (constCode [false]) (constCode [true]) O bits hres (hp true)
    simp only [Test.queries,Test.work,regs_zero,hx,List.length_singleton] at ht
    convert ht using 1 <;> first | rfl | omega

def quadRegs (x y z u s : Word) : Registers 1 := Function.update (regs x y z s) 3 u
@[simp] lemma quadRegs_zero (x y z u s : Word) : quadRegs x y z u s 0=x := by simp [quadRegs]
@[simp] lemma quadRegs_one (x y z u s : Word) : quadRegs x y z u s 1=y := by simp [quadRegs]
@[simp] lemma quadRegs_two (x y z u s : Word) : quadRegs x y z u s 2=z := by simp [quadRegs]
@[simp] lemma quadRegs_three (x y z u s : Word) : quadRegs x y z u s 3=u := by simp [quadRegs]
@[simp] lemma quadRegs_nil (x y z s : Word) : quadRegs x y z [] s=regs x y z s := by
  funext i; fin_cases i <;> simp [quadRegs,regs]
@[simp] lemma update_quad_zero (x y z u s v : Word) : Function.update (quadRegs x y z u s) 0 v=quadRegs v y z u s := by
  funext i; fin_cases i <;> simp [quadRegs,regs]
@[simp] lemma update_quad_one (x y z u s v : Word) : Function.update (quadRegs x y z u s) 1 v=quadRegs x v z u s := by
  funext i; fin_cases i <;> simp [quadRegs,regs]
@[simp] lemma update_quad_two (x y z u s v : Word) : Function.update (quadRegs x y z u s) 2 v=quadRegs x y v u s := by
  funext i; fin_cases i <;> simp [quadRegs,regs]
@[simp] lemma update_quad_three (x y z u s v : Word) : Function.update (quadRegs x y z u s) 3 v=quadRegs x y z v s := by
  simp [quadRegs]
lemma divRegisters_quad (x y z u s : Word) : divRegisters (regs [] [] [] s) x y z u [] []=quadRegs x y z u s := by
  funext i; fin_cases i <;> simp [divRegisters,quadRegs,regs]

def divBlock : Block 1 := ⟨53,divisionProgram,rfl⟩
lemma runs_div {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs divBlock O bits (regs x y [] s)
      (quadRegs [] y (divisionWords x y [] []).1 (divisionWords x y [] []).2 s)
      (divisionCost x y []) 0 (divisionCost x y []) := by
  dsimp only [Runs,divBlock]
  intro q w
  have h := division_machine_run (k:=1) O (regs [] [] [] s) x y [] [] q w bits
  convert h using 1 <;> simp only [divisionConfig,state,divRegisters_quad,quadRegs_nil,lastLabel,Nat.add_zero]
  rfl

lemma div_prepare {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (seq (reverse 0 2) (move 2 3 0)) O bits (regs x y [] s) (regs x.reverse y [] s)
      (6*x.length+3) 0 (6*x.length+3) := by
  have hr := runs_reverse (k:=1) 0 2 (by decide) O (regs [] y [] s) x [] bits
  simp only [pairRegisters,update_regs_zero,update_regs_two,List.append_nil] at hr
  have hm := runs_move (k:=1) 2 3 0 (by decide) (by decide) (by decide) O
    (quadRegs [] y [] [] s) x.reverse [] (fun i => bits (2*x.length+1+i))
  simp only [tripleRegisters,pairRegisters,update_quad_zero,update_quad_two,update_quad_three,
    List.append_nil,List.length_reverse] at hm
  simp only [quadRegs_nil] at hm
  have ht := runs_seq O bits hr hm
  convert ht using 1 <;> first | rfl | omega

lemma div_finish {n : ℕ} (O : IndependenceOracle n) (x r q s : Word) (bits : ℕ → Bool) :
    Runs (seq (clear 1) (seq (pack 2 3) (move 3 1 0))) O bits (quadRegs [] x r q s)
      (regs (pair r q) [] [] s) (x.length+11*r.length+4*q.length+9) 0
      (x.length+11*r.length+4*q.length+9) := by
  have h₁ := runs_clear (k:=1) 1 O (quadRegs [] [] r q s) x bits
  simp only [update_quad_one] at h₁
  have h₂ := runs_pack (k:=1) 2 3 (by decide) O (quadRegs [] [] [] [] s) r q
    (fun i => bits (x.length+1+i))
  simp only [pairRegisters,update_quad_two,update_quad_three] at h₂
  change Runs (pack 2 3) O _ (quadRegs [] [] r q s) (quadRegs [] [] [] (pair r q) s) _ _ _ at h₂
  have h₃ := runs_move (k:=1) 3 1 0 (by decide) (by decide) (by decide) O (quadRegs [] [] [] [] s)
    (pair r q) [] (fun i => bits (x.length+1+(3*r.length+2+i)))
  simp only [tripleRegisters,pairRegisters,update_quad_zero,update_quad_one,update_quad_three,
    List.append_nil] at h₃
  simp only [quadRegs_nil] at h₃
  have ht := runs_seq O bits h₁ (runs_seq O _ h₂ h₃)
  convert ht using 1 <;> first | rfl | simp only [pair_length]; omega

def rawDivCode : Block 1 := seq (unpack 0 1)
  (seq (seq (reverse 0 2) (move 2 3 0)) (seq divBlock
    (seq (clear 1) (seq (pack 2 3) (move 3 1 0)))))
def divResult (x y : Word) : Word × Word := divisionWords y.reverse x [] []
def rawDivTime (x y : Word) : ℕ :=
  4*x.length+6*y.length+11*(divResult x y).1.length+4*(divResult x y).2.length+13+divisionCost y.reverse x []
lemma computes_rawDiv {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes rawDivCode O (pair x y) (pair (divResult x y).1 (divResult x y).2)
      (rawDivTime x y) 0 (rawDivTime x y) := by
  intro s bits
  have h₁ := split_pair O x y [] s bits
  simp only [List.append_nil] at h₁
  have h₂ := div_prepare O y x s (fun i => bits (3*x.length+1+i))
  have h₃ := runs_div O y.reverse x s (fun i => bits (3*x.length+1+(6*y.length+3+i)))
  have h₄ := div_finish O x (divResult x y).1 (divResult x y).2 s
    (fun i => bits (3*x.length+1+(6*y.length+3+(divisionCost y.reverse x []+i))))
  have ht := runs_seq O bits h₁ (runs_seq O _ h₂ (runs_seq O _ h₃ h₄))
  convert ht using 1 <;> first | rfl | unfold rawDivTime; omega

lemma divisionWords_length (xs ys zs ws : Word) :
    (divisionWords xs ys zs ws).1.length ≤ max ys.length zs.length+xs.length ∧
    (divisionWords xs ys zs ws).2.length = xs.length+ws.length := by
  induction xs generalizing zs ws with
  | nil => simp only [divisionWords,List.length_nil,Nat.add_zero,Nat.zero_add]; exact ⟨Nat.le_max_right _ _,True.intro⟩
  | cons x xs ih =>
    have hh := ih (divisionRemainder ys (x::zs)) (divisionDigit ys (x::zs)::ws)
    have hr := divisionRemainder_length ys (x::zs)
    simp only [divisionWords,List.length_cons] at *
    constructor <;> omega
lemma divResult_length (x y : Word) : (divResult x y).1.length ≤ x.length+y.length ∧
    (divResult x y).2.length=y.length := by
  simpa only [divResult,List.length_reverse,List.length_nil,Nat.max_zero,Nat.add_zero] using divisionWords_length y.reverse x [] []
lemma rawDivTime_le (x y : Word) : rawDivTime x y ≤ 100*(x.length+y.length+1)^2 := by
  have hd := divisionCost_bound y.reverse x [] x.length le_rfl (by simp)
  have hl := divResult_length x y
  simp only [List.length_reverse] at hd
  unfold rawDivTime
  nlinarith

def divCode : Block 1 := seq rawDivCode (parallel normalCode normalCode)
def normalizedResult (x y : Word) : Word := pair (binaryValue (divResult x y).1).bits (binaryValue (divResult x y).2).bits
lemma bounded_div {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Bounded divCode O (pair x y) (normalizedResult x y) (300*(x.length+y.length+1)^2) := by
  have h₁ := computes_rawDiv O x y
  have h₂ := computes_parallel (computes_normalCode O (divResult x y).1) (computes_normalCode O (divResult x y).2)
  have ht := computes_seq h₁ h₂
  simp only [normalWord_eq_bits] at ht
  have hl := divResult_length x y
  have hr := rawDivTime_le x y
  have hn₁ := normal_length (divResult x y).1
  have hn₂ := normal_length (divResult x y).2
  have hc₁ := normalCost_le (divResult x y).1
  have hc₂ := normalCost_le (divResult x y).2
  rw [normalWord_eq_bits] at hn₁ hn₂
  refine ⟨_,0,_,?_,Nat.zero_le _,?_,ht⟩ <;> nlinarith
lemma normalizedResult_pos (x y : Word) (hx : 0 < binaryValue x) :
    normalizedResult x y=pair (binaryValue y%binaryValue x).bits (binaryValue y/binaryValue x).bits := by
  have hh := divisionWords_correct y.reverse x hx
  simpa only [normalizedResult,divResult,List.reverse_reverse] using congrArg₂ (fun a b : ℕ => pair a.bits b.bits) hh.1 hh.2

def cmpLabel (i : Fin 10) : Fin 11 := ⟨i.val,by omega⟩
def cmpBlock : Block 1 where
  size := 10
  code := fun pc => if h : pc.val < 8 then
      (compareProgram (1 : Fin 9) 0 ⟨pc.val,by omega⟩).relabel cmpLabel
    else if pc.val=8 then .push 0 false 10
    else if pc.val=9 then .push 0 true 10 else .halt
  exit_halt := rfl
lemma cmpBlock_body (i : Fin 10) (h : compareProgram (1 : Fin 9) 0 i ≠ .halt) :
    cmpBlock.code (cmpLabel i)=(compareProgram (1 : Fin 9) 0 i).relabel cmpLabel := by
  have hi : i.val<8 := by
    by_contra hn
    have hiv := i.isLt
    have : i.val=8 ∨ i.val=9 := by omega
    rcases this with hi|hi <;> simp [compareProgram,hi] at h
  simp [cmpBlock,cmpLabel,hi]
lemma runs_cmp {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs cmpBlock O bits (regs y x [] s) (regs [decide (binaryValue x<binaryValue y)] [] [] s)
      (2*max x.length y.length+3) 0 (2*max x.length y.length+3) := by
  intro q w
  have hh := comparison_block (1 : Fin 9) 0 (by decide) O (regs [] [] [] s) x y q w bits
  simp only [pairRegisters,update_regs_zero,update_regs_one] at hh
  have hp := execution_relabel_before_any_halt (compareProgram (1 : Fin 9) 0) cmpBlock.code
    cmpLabel cmpBlock_body O (state (regs y x [] s) 0 q w) bits (2*max x.length y.length+2)
    (by rw [show state (regs y x [] s) 0 q w=compareConfig (regs y x [] s) 0 q w by rfl,hh]; rfl)
  rw [show state (regs y x [] s) 0 q w=compareConfig (regs y x [] s) 0 q w by rfl,hh] at hp
  change execution cmpBlock.code O (state (regs y x [] s) 0 q w) bits (2*max x.length y.length+2)=_ at hp
  rw [show 2*max x.length y.length+3=(2*max x.length y.length+2)+1 by omega,execution_add,hp]
  by_cases h : binaryValue x<binaryValue y <;>
    simp [h,relabelConfig,cmpLabel,compareConfig,state,execution,machineStep,cmpBlock,lastLabel,Nat.add_assoc]

def cmpCode : Block 1 := seq (unpack 0 1) cmpBlock
lemma computes_cmp {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes cmpCode O (pair x y) [decide (binaryValue x<binaryValue y)]
      (3*x.length+2*max x.length y.length+4) 0 (3*x.length+2*max x.length y.length+4) := by
  intro s bits
  have hu := split_pair O x y [] s bits
  simp only [List.append_nil] at hu
  have hr := runs_cmp O x y s (fun i => bits (3*x.length+1+i))
  have hh := runs_seq O bits hu hr
  convert hh using 1 <;> first | rfl | omega
lemma bounded_cmp {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Bounded cmpCode O (pair x y) [decide (binaryValue x<binaryValue y)] (5*(x.length+y.length+1)) := by
  refine ⟨_,0,_,?_,Nat.zero_le _,?_,computes_cmp O x y⟩ <;> omega

def loopAccum {A : Type*} (f : A → A) (g : A → ℕ → ℕ) : ℕ → A → ℕ
  | 0,_ => 0
  | m+1,x => g x m+loopAccum f g m (f x)

theorem runs_repeat {k n : ℕ} {A : Type*} (p : Block k) (a : Fin (k+8))
    (O : IndependenceOracle n) (encode : A → Registers k) (f : A → A)
    (ticks queries work : A → ℕ → ℕ)
    (body : ∀ v xs bits, Runs p O bits (Function.update (encode v) a xs)
      (Function.update (encode (f v)) a xs) (ticks v xs.length) (queries v xs.length) (work v xs.length))
    (v : A) (xs : Word) (bits : ℕ → Bool) :
    Runs (repeatBlock p a) O bits (Function.update (encode v) a xs)
      (Function.update (encode (loopState f xs.length v)) a [])
      (xs.length+loopAccum f ticks xs.length v+1) (loopAccum f queries xs.length v)
      (xs.length+loopAccum f work xs.length v+1) := by
  dsimp only [Runs, repeatBlock]
  intro q c
  induction xs generalizing v q c bits with
  | nil =>
    have h := repeatProgram_empty p.code a O (encode v) q c bits
    simpa [Runs,repeatBlock,state,loopConfig,loopAccum,loopState] using h
  | cons x xs ih =>
    have hb := body v xs (fun i => bits (1+i)) q (c+1)
    have hnone : (execution p.code O (state (Function.update (encode v) a xs) 0 q (c+1))
        (fun i => bits (1+i)) (ticks v xs.length)).output=none := by rw [hb]; rfl
    have hl := execution_relabel_before_halt p.code (repeatProgram p.code a) (loopLabel p.size)
      (lastLabel p.size) p.exit_halt (repeatProgram_body p.code a) O _ (fun i => bits (1+i))
      (ticks v xs.length) hnone
    have hfirst : execution (repeatProgram p.code a) O
        (state (Function.update (encode v) a (x::xs)) 0 q c) bits (1+ticks v xs.length)=
        state (Function.update (encode (f v)) a xs) 0 (q+queries v xs.length) (c+1+work v xs.length) := by
      rw [execution_add]
      change execution _ O (execution (repeatProgram p.code a) O
        (loopConfig (Function.update (encode v) a (x::xs)) 0 q c) bits 1) _ _ = _
      rw [repeatProgram_pop]
      change execution _ O (relabelConfig _ (state (Function.update (encode v) a xs) 0 q (c+1))) _ _ = _
      rw [hl,hb]
      simp [relabelConfig,state,loopLabel_last]
    simp only [List.length_cons,loopAccum,loopState]
    rw [show xs.length+1+(ticks v xs.length+loopAccum f ticks xs.length (f v))+1=
      (1+ticks v xs.length)+(xs.length+loopAccum f ticks xs.length (f v)+1) by omega,
      execution_add,hfirst]
    have hi := ih (f v) (fun i => bits (1+ticks v xs.length+i))
      (q+queries v xs.length) (c+1+work v xs.length)
    change execution (repeatProgram p.code a) O _ _ _ = _ at hi
    rw [hi]
    congr 1 <;> omega

lemma loopAccum_le {A : Type*} (f : A → A) (g : A → ℕ → ℕ) (m B : ℕ)
    (h : ∀ x i, i < m → g x i ≤ B) (x : A) : loopAccum f g m x ≤ m * B := by
  induction m generalizing x with
  | zero => simp [loopAccum]
  | succ m ih =>
    have h₁ := h x m (by omega)
    have h₂ := ih (fun x i hi => h x i (by omega)) (f x)
    simpa only [loopAccum,Nat.succ_mul] using Nat.add_le_add h₁ h₂ |>.trans (by omega)

lemma save_one {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs (pack 1 8) O bits (regs x y [] s) (regs x [] [] (pair y s))
      (3*y.length+2) 0 (3*y.length+2) := by
  simpa only [pair,pairRegisters,update_regs_one,update_regs_eight] using
    runs_pack (k:=1) 1 8 (by decide) O (regs x [] [] []) y s bits

def iterationBody (p : Block 1) : Block 1 := seq (pack 1 8) (seq p (unpack 8 1))
lemma iteration_body {n : ℕ} {O : IndependenceOracle n} {p : Block 1} {x y : Word}
    {t q w : ℕ} (h : Computes p O x y t q w) (counter saved : Word) (bits : ℕ → Bool) :
    Runs (iterationBody p) O bits (regs x counter [] saved) (regs y counter [] saved)
      (6*counter.length+3+t) q (6*counter.length+3+w) := by
  have hs := save_one O x counter saved bits
  have hp := h (pair counter saved) (fun i => bits (3*counter.length+2+i))
  have hr := restore_one O y counter saved (fun i => bits (3*counter.length+2+(t+i)))
  have ht := runs_seq O bits hs (runs_seq O _ hp hr)
  convert ht using 1 <;> first | rfl | omega

def iterateCode (p : Block 1) : Block 1 := seq (unpack 0 1) (repeatBlock (iterationBody p) 1)
lemma computes_iterate {n : ℕ} {A : Type*} (O : IndependenceOracle n) (p : Block 1)
    (encode : A → Word) (f : A → A) (t q w : A → ℕ)
    (h : ∀ x, Computes p O (encode x) (encode (f x)) (t x) (q x) (w x)) (x : A) (counter : Word) :
    Computes (iterateCode p) O (pair counter (encode x)) (encode (loopState f counter.length x))
      (4*counter.length+loopAccum f (fun x i => 6*i+3+t x) counter.length x+2)
      (loopAccum f (fun x _ => q x) counter.length x)
      (4*counter.length+loopAccum f (fun x i => 6*i+3+w x) counter.length x+2) := by
  intro saved bits
  have hs := split_pair O counter (encode x) [] saved bits
  simp only [List.append_nil] at hs
  have hr := runs_repeat (iterationBody p) 1 O (fun x => regs (encode x) [] [] saved) f
    (fun x i => 6*i+3+t x) (fun x _ => q x) (fun x i => 6*i+3+w x)
    (by intro x xs bits; simpa only [update_regs_one] using iteration_body (h x) xs saved bits)
    x counter (fun i => bits (3*counter.length+1+i))
  simp only [update_regs_one] at hr
  have ht := runs_seq O bits hs hr
  convert ht using 1 <;> first | rfl | omega

lemma bounded_iterate {n : ℕ} {A : Type*} (O : IndependenceOracle n) (p : Block 1)
    (encode : A → Word) (f : A → A) (B : ℕ)
    (h : ∀x,Bounded p O (encode x) (encode (f x)) B) (x : A) (counter : Word) :
    Bounded (iterateCode p) O (pair counter (encode x)) (encode (loopState f counter.length x))
      (counter.length*(6*counter.length+B+7)+2) := by
  classical
  choose t q w ht hq hw hc using h
  have hc' := computes_iterate O p encode f t q w hc x counter
  have ht' := loopAccum_le f (fun x i => 6*i+3+t x) counter.length (6*counter.length+3+B)
    (by intro x i hi; have := ht x; omega) x
  have hw' := loopAccum_le f (fun x i => 6*i+3+w x) counter.length (6*counter.length+3+B)
    (by intro x i hi; have := hw x; omega) x
  have hq' := loopAccum_le f (fun x _ => q x) counter.length B (by intro x _ _; exact hq x) x
  refine ⟨_,_,_,?_,?_,?_,hc'⟩ <;> nlinarith

def words : List Word → Word
  | [] => []
  | x::xs => true :: pair x (words xs)
lemma words_length (xs : List Word) : (words xs).length = 2*(xs.map List.length).sum+2*xs.length := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [words,List.length_cons,pair_length,List.map_cons,List.sum_cons,ih]; omega

def foldWords {A X : Type*} (f : X → A → A) : List X → A → A
  | [],s => s
  | x::xs,s => foldWords f xs (f x s)
def foldCharge {A X : Type*} (f : X → A → A) (g : X → List X → A → ℕ) : List X → A → ℕ
  | [],_ => 0
  | x::xs,s => g x xs s+foldCharge f g xs (f x s)

lemma runs_repeat_cons {k n : ℕ} {p : Block k} {a : Fin (k+8)} {O : IndependenceOracle n}
    {bits : ℕ → Bool} {R R' R'' : Registers k} {b : Bool} {xs : Word}
    {t q w u v z : ℕ}
    (hp : Runs p O (fun i => bits (1+i)) (Function.update R a xs) R' t q w)
    (hi : Runs (repeatBlock p a) O (fun i => bits (1+t+i)) R' R'' u v z) :
    Runs (repeatBlock p a) O bits (Function.update R a (b::xs)) R''
      (1+t+u) (q+v) (1+w+z) := by
  dsimp only [Runs, repeatBlock] at *
  intro q₀ w₀
  have hb := hp q₀ (w₀+1)
  have hnone : (execution p.code O (state (Function.update R a xs) 0 q₀ (w₀+1))
      (fun i => bits (1+i)) t).output=none := by rw [hb]; rfl
  have hl := execution_relabel_before_halt p.code (repeatProgram p.code a) (loopLabel p.size)
      (lastLabel p.size) p.exit_halt (repeatProgram_body p.code a) O _ (fun i => bits (1+i)) t hnone
  rw [execution_add,execution_add]
  change execution _ O (execution _ O (execution (repeatProgram p.code a) O
    (loopConfig (Function.update R a (b::xs)) 0 q₀ w₀) bits 1) _ _) _ _ = _
  rw [repeatProgram_pop]
  change execution _ O (execution _ O (relabelConfig _ (state (Function.update R a xs) 0 q₀ (w₀+1))) _ _) _ _ = _
  rw [hl,hb]
  simp only [relabelConfig,state,loopLabel_last]
  have hh := hi (q₀+q) (w₀+1+w)
  simpa [state,Nat.add_assoc] using hh

lemma unpack_one_two {n : ℕ} (O : IndependenceOracle n) (a x tail s : Word) (bits : ℕ → Bool) :
    Runs (unpack 1 2) O bits (regs a (pair x tail) [] s) (regs a tail x s)
      (3*x.length+1) 0 (3*x.length+1) := by
  simpa only [pair,pairRegisters,update_regs_one,update_regs_two] using
    runs_unpack_packed (k:=1) 1 2 (by decide) O (regs a [] [] s) x tail bits
lemma pack_two_zero {n : ℕ} (O : IndependenceOracle n) (a x s : Word) (bits : ℕ → Bool) :
    Runs (pack 2 0) O bits (regs a [] x s) (regs (pair x a) [] [] s)
      (3*x.length+2) 0 (3*x.length+2) := by
  simpa only [pair,pairRegisters,update_regs_zero,update_regs_two] using
    runs_pack (k:=1) 2 0 (by decide) O (regs [] [] [] s) x a bits
lemma save_one_with_two {n : ℕ} (O : IndependenceOracle n) (a y x s : Word) (bits : ℕ → Bool) :
    Runs (pack 1 8) O bits (regs a y x s) (regs a [] x (pair y s))
      (3*y.length+2) 0 (3*y.length+2) := by
  simpa only [pair,pairRegisters,update_regs_one,update_regs_eight] using
    runs_pack (k:=1) 1 8 (by decide) O (regs a [] x []) y s bits

def listBody (p : Block 1) : Block 1 :=
  seq (unpack 1 2) (seq (pack 1 8) (seq (pack 2 0) (seq p (unpack 8 1))))
lemma list_body {n : ℕ} {O : IndependenceOracle n} {p : Block 1} {x a b : Word}
    {t q w : ℕ} (h : Computes p O (pair x a) b t q w) (tail saved : Word) (bits : ℕ → Bool) :
    Runs (listBody p) O bits (regs a (pair x tail) [] saved) (regs b tail [] saved)
      (6*x.length+6*tail.length+6+t) q (6*x.length+6*tail.length+6+w) := by
  have h₁ := unpack_one_two O a x tail saved bits
  have h₂ := save_one_with_two O a tail x saved (fun i => bits (3*x.length+1+i))
  have h₃ := pack_two_zero O a x (pair tail saved) (fun i => bits (3*x.length+1+(3*tail.length+2+i)))
  have h₄ := h (pair tail saved) (fun i => bits (3*x.length+1+(3*tail.length+2+(3*x.length+2+i))))
  have h₅ := restore_one O b tail saved (fun i => bits (3*x.length+1+(3*tail.length+2+(3*x.length+2+(t+i)))))
  have ht := runs_seq O bits h₁ (runs_seq O _ h₂ (runs_seq O _ h₃ (runs_seq O _ h₄ h₅)))
  convert ht using 1 <;> first | rfl | omega

lemma list_loop {n : ℕ} {A X : Type*} (O : IndependenceOracle n) (p : Block 1)
    (encode : A → Word) (encX : X → Word) (f : X → A → A) (t q w : X → A → ℕ)
    (h : ∀ x a, Computes p O (pair (encX x) (encode a)) (encode (f x a)) (t x a) (q x a) (w x a))
    (xs : List X) (a : A) (saved : Word) (bits : ℕ → Bool) :
    Runs (repeatBlock (listBody p) 1) O bits (regs (encode a) (words (xs.map encX)) [] saved)
      (regs (encode (foldWords f xs a)) [] [] saved)
      (1+foldCharge f (fun x tail a => 7+6*(encX x).length+6*(words (tail.map encX)).length+t x a) xs a)
      (foldCharge f (fun x _ a => q x a) xs a)
      (1+foldCharge f (fun x tail a => 7+6*(encX x).length+6*(words (tail.map encX)).length+w x a) xs a) := by
  induction xs generalizing a bits with
  | nil =>
    dsimp only [Runs, repeatBlock]
    intro q₀ w₀
    simpa only [repeatBlock,state,loopConfig,words,List.map_nil,foldWords,foldCharge,Nat.add_zero,
      update_regs_one] using repeatProgram_empty (listBody p).code 1 O (regs (encode a) [] [] saved) q₀ w₀ bits
  | cons x xs ih =>
    have hb := list_body (h x a) (words (xs.map encX)) saved (fun i => bits (1+i))
    have hr := runs_repeat_cons (R:=regs (encode a) [] [] saved) (b:=true)
      (by simpa only [update_regs_one] using hb)
      (ih (f x a) (fun i => bits (1+(6*(encX x).length+6*(words (xs.map encX)).length+6+t x a)+i)))
    simp only [update_regs_one] at hr
    convert hr using 1 <;> first | rfl | simp only [foldCharge]; omega

def foldCode (p : Block 1) : Block 1 := seq (unpack 0 1) (repeatBlock (listBody p) 1)
lemma computes_fold {n : ℕ} {A X : Type*} (O : IndependenceOracle n) (p : Block 1)
    (encode : A → Word) (encX : X → Word) (f : X → A → A) (t q w : X → A → ℕ)
    (h : ∀ x a, Computes p O (pair (encX x) (encode a)) (encode (f x a)) (t x a) (q x a) (w x a))
    (xs : List X) (a : A) :
    Computes (foldCode p) O (pair (words (xs.map encX)) (encode a)) (encode (foldWords f xs a))
      (3*(words (xs.map encX)).length+2+foldCharge f (fun x tail a => 7+6*(encX x).length+6*(words (tail.map encX)).length+t x a) xs a)
      (foldCharge f (fun x _ a => q x a) xs a)
      (3*(words (xs.map encX)).length+2+foldCharge f (fun x tail a => 7+6*(encX x).length+6*(words (tail.map encX)).length+w x a) xs a) := by
  intro saved bits
  have hs := split_pair O (words (xs.map encX)) (encode a) [] saved bits
  simp only [List.append_nil] at hs
  have hl := list_loop O p encode encX f t q w h xs a saved (fun i => bits (3*(words (xs.map encX)).length+1+i))
  have ht := runs_seq O bits hs hl
  convert ht using 1 <;> first | rfl | omega

def reverseCode : Block 1 := seq (reverse 0 1) (move 1 2 0)
lemma computes_reverse {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Computes reverseCode O x x.reverse (6*x.length+3) 0 (6*x.length+3) := by
  intro s bits
  have hr := runs_reverse (k:=1) 0 1 (by decide) O (regs [] [] [] s) x [] bits
  simp only [pairRegisters,update_regs_zero,update_regs_one,List.append_nil] at hr
  have hm := move_one_zero O x.reverse [] s (fun i => bits (2*x.length+1+i))
  have ht := runs_seq O bits hr hm
  simpa only [reverseCode,List.append_nil,List.length_reverse,Nat.zero_add,
    show 2*x.length+1+(4*x.length+2)=6*x.length+3 by omega] using ht

def boolListBlock : Block 1 where
  size := 7
  code := fun pc => match pc.val with
    | 0 => .pop 1 7 1 2
    | 1 => .push 0 true 3
    | 2 => .push 0 true 4
    | 3 => .push 0 false 5
    | 4 => .push 0 true 5
    | 5 => .push 0 false 6
    | 6 => .push 0 true 0
    | _ => .halt
  exit_halt := rfl
lemma boolList_push (b : Bool) (s : Word) : true::false::b::true::s=true::pair [b] s := rfl
lemma runs_boolList {n : ℕ} (O : IndependenceOracle n) (x y s : Word) (bits : ℕ → Bool) :
    Runs boolListBlock O bits (regs (words (y.map (fun b => [b]))) x [] s)
      (regs (words ((x.reverse++y).map (fun b => [b]))) [] [] s) (5*x.length+1) 0 (5*x.length+1) := by
  intro q w
  induction x generalizing y w bits with
  | nil => simp [execution,machineStep,boolListBlock,state,lastLabel]
  | cons b xs ih =>
    have hh : execution boolListBlock.code O
        (state (regs (words (y.map (fun b => [b]))) (b::xs) [] s) 0 q w) bits 5=
        state (regs (words ((b::y).map (fun b => [b]))) xs [] s) 0 q (w+5) := by
      cases b <;> simp [execution,machineStep,boolListBlock,state,words,pair,bitFrame,Nat.add_assoc] <;> rfl
    rw [List.length_cons,show 5*(xs.length+1)+1=5+(5*xs.length+1) by omega,execution_add,hh,ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]
    congr 1; omega

def boolListCode : Block 1 := seq (reverse 0 1) boolListBlock
lemma computes_boolList {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    Computes boolListCode O x (words (x.map (fun b => [b]))) (7*x.length+2) 0 (7*x.length+2) := by
  intro s bits
  have hr := runs_reverse (k:=1) 0 1 (by decide) O (regs [] [] [] s) x [] bits
  simp only [pairRegisters,update_regs_zero,update_regs_one,List.append_nil] at hr
  have hb := runs_boolList O x.reverse [] s (fun i => bits (2*x.length+1+i))
  simp only [List.map_nil,words,List.reverse_reverse,List.append_nil,List.length_reverse] at hb
  have ht := runs_seq O bits hr hb
  convert ht using 1 <;> first | rfl | omega

def consWordCode : Block 1 := seq (unpack 0 1)
  (fork (.pop 1 false false true) (push 0 false) (push 0 true))
lemma computes_consWord {n : ℕ} (O : IndependenceOracle n) (b : Bool) (x : Word) :
    Computes consWordCode O (pair [b] x) (b::x) 6 0 6 := by
  have h (b : Bool) : Computes (push 0 b) O x (b::x) 1 0 1 := by
    intro s bits
    simpa only [regs_zero,update_regs_zero] using runs_push O bits (regs x [] [] s) 0 b
  have ht := computes_select (push 0 false) (push 0 true) b (x:=x) (y:=b::x) (by cases b <;> exact h _)
  exact ht

def consListCode : Block 1 := push 0 true
lemma computes_consList {n : ℕ} (O : IndependenceOracle n) (x : Word) (xs : List Word) :
    Computes consListCode O (pair x (words xs)) (words (x::xs)) 1 0 1 := by
  intro s bits
  simpa only [regs_zero,update_regs_zero,consListCode,words] using runs_push O bits (regs (pair x (words xs)) [] [] s) 0 true

def appendCode : Block 1 := seq (unpack 0 1) (move 1 2 0)
lemma computes_append {n : ℕ} (O : IndependenceOracle n) (x y : Word) :
    Computes appendCode O (pair x y) (x++y) (7*x.length+3) 0 (7*x.length+3) := by
  intro s bits
  have hs := split_pair O x y [] s bits
  simp only [List.append_nil] at hs
  have hm := move_one_zero O x y s (fun i => bits (3*x.length+1+i))
  simpa only [appendCode,Nat.zero_add,show 3*x.length+1+(4*x.length+2)=7*x.length+3 by omega] using
    runs_seq O bits hs hm

def subBlock : Block 1 := ⟨16,subProgram 1 0 2,rfl⟩
def subTime (x y : Word) : ℕ := subCost false x y+2*(subDigits false x y).length+1
lemma runs_sub {n : ℕ} (O : IndependenceOracle n) (x y s : Word)
    (hxy : binaryValue y≤binaryValue x) (bits : ℕ → Bool) :
    Runs subBlock O bits (regs y x [] s) (regs [] (subDigits false x y) [] s)
      (subTime x y) 0 (subTime x y) := by
  dsimp only [Runs,subBlock]
  intro q w
  have h := (subtraction_block (k:=1) 1 0 2 (by decide) (by decide) (by decide) O
    (regs [] [] [] s) x y hxy q w bits).2.2
  convert h using 1 <;> simp only [subTime,subConfig,state,tripleRegisters,pairRegisters,update_regs_zero,
    update_regs_one,update_regs_two,lastLabel,Nat.add_zero]
  rfl

def subCode : Block 1 := seq (unpack 0 1) (seq subBlock (seq (move 1 2 0) normalCode))
lemma computes_sub {n : ℕ} (O : IndependenceOracle n) (x y : Word)
    (hxy : binaryValue y≤binaryValue x) :
    Computes subCode O (pair x y) (binaryValue x-binaryValue y).bits
      (3*x.length+1+subTime x y+4*(subDigits false x y).length+2+normalCost (subDigits false x y)) 0
      (3*x.length+1+subTime x y+4*(subDigits false x y).length+2+normalCost (subDigits false x y)) := by
  have hv := (subtraction_block (k:=1) 1 0 2 (by decide) (by decide) (by decide) O
    (regs [] [] [] []) x y hxy 0 0 (fun _ => false)).1
  intro s bits
  have hs := split_pair O x y [] s bits
  simp only [List.append_nil] at hs
  have hd := runs_sub O x y s hxy (fun i => bits (3*x.length+1+i))
  have hm := move_one_zero O (subDigits false x y) [] s (fun i => bits (3*x.length+1+(subTime x y+i)))
  simp only [List.append_nil] at hm
  have hn := computes_normalCode O (subDigits false x y) s
    (fun i => bits (3*x.length+1+(subTime x y+(4*(subDigits false x y).length+2+i))))
  rw [normalWord_eq_bits,hv] at hn
  have hh := runs_seq O bits hs (runs_seq O _ hd (runs_seq O _ hm hn))
  convert hh using 1 <;> first | rfl | omega
lemma bounded_sub {n : ℕ} (O : IndependenceOracle n) (x y : Word)
    (hxy : binaryValue y≤binaryValue x) :
    Bounded subCode O (pair x y) (binaryValue x-binaryValue y).bits (30*(x.length+y.length+1)) := by
  have h₁ := subDigits_length_cost false x y
  have h₂ := normalCost_le (subDigits false x y)
  refine ⟨_,0,_,?_,Nat.zero_le _,?_,computes_sub O x y hxy⟩ <;> dsimp only [subTime] <;> omega

def rankPrep : Block 1 where
  size := 5
  code := fun pc => match pc.val with
    | 0 => .pop 0 5 1 3
    | 1 => .push 2 false 2
    | 2 => .push 1 false 0
    | 3 => .push 2 true 4
    | 4 => .push 1 false 0
    | _ => .halt
  exit_halt := rfl
lemma runs_rankPrep {n : ℕ} (O : IndependenceOracle n) (x y z s : Word) (bits : ℕ → Bool) :
    Runs rankPrep O bits (regs x y z s)
      (regs [] (List.replicate x.length false++y) (x.reverse++z) s) (3*x.length+1) 0 (3*x.length+1) := by
  dsimp only [Runs]
  intro q w
  induction x generalizing y z w bits with
  | nil => simp [execution,machineStep,rankPrep,state,lastLabel]
  | cons b xs ih =>
    have h : execution rankPrep.code O (state (regs (b::xs) y z s) 0 q w) bits 3=
        state (regs xs (false::y) (b::z) s) 0 q (w+3) := by
      cases b <;> simp [execution,machineStep,rankPrep,state,Nat.add_assoc] <;> rfl
    rw [List.length_cons,show 3*(xs.length+1)+1=3+(3*xs.length+1) by omega,execution_add,h,ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append,Nat.add_zero]
    congr 1
    · simp [List.replicate_add,List.append_assoc]
    · omega

lemma update_regs_three_empty (x y z s : Word) : Function.update (regs x y z s) 3 []=regs x y z s := by
  funext i; fin_cases i <;> simp [regs]
lemma greedyRegisters_regs (x y z s : Word) : greedyRegisters (regs [] [] [] s) x y z []=regs x y z s := by
  funext i; fin_cases i <;> simp [greedyRegisters,regs]

def readyRank (which : Bool) : Block 1 := ⟨32,rankProgram which,rfl⟩
def rankCode (which : Bool) : Block 1 := seq rankPrep (seq (move 2 3 0) (seq (readyRank which) normalCode))
def rankWord {n : ℕ} (O : IndependenceOracle n) (which : Bool) (x : Word) : ℕ :=
  binaryValue (rankBits which O x.reverse)
lemma popcountBits_length (xs ys : Word) : (popcountBits xs ys).length≤xs.length+ys.length := by
  induction xs generalizing ys with
  | nil => simp [popcountBits]
  | cons b xs ih =>
    cases b with
    | false => simpa only [popcountBits,Bool.false_eq_true,ite_false,List.length_cons] using
        (ih ys).trans (by omega)
    | true =>
      have h := ih (incrementBits ys)
      have hi := incrementBits_length ys
      simp only [popcountBits,ite_true,List.length_cons]
      omega
lemma rankBits_length {n : ℕ} (O : IndependenceOracle n) (which : Bool) (x : Word) :
    (rankBits which O x).length≤x.length := by
  simpa only [rankBits,wordGreedy_length,List.length_nil,Nat.add_zero] using
    popcountBits_length (wordGreedy (wordOracle which O) x []) []
lemma computes_rank {n : ℕ} (O : IndependenceOracle n) (which : Bool) (x : Word) (hx : x.length=n) :
    Computes (rankCode which) O x (rankWord O which x).bits
      (7*n+3+rankTime which O x.reverse+normalCost (rankBits which O x.reverse))
      (greedyCalls x.reverse)
      (7*n+3+rankWork which O x.reverse+normalCost (rankBits which O x.reverse)) := by
  intro s bits
  have hp := runs_rankPrep O x [] [] s bits
  simp only [hx,List.append_nil] at hp
  have hm := runs_move (k:=1) 2 3 0 (by decide) (by decide) (by decide) O
    (regs [] (List.replicate n false) [] s) x.reverse [] (fun i => bits (3*n+1+i))
  simp only [tripleRegisters,pairRegisters,update_regs_zero,update_regs_two,update_regs_three_empty,
    List.append_nil,List.length_reverse,hx] at hm
  have hr : Runs (readyRank which) O (fun i => bits (3*n+1+(4*n+2+i)))
      (regs x.reverse (List.replicate n false) [] s) (regs (rankBits which O x.reverse) [] [] s)
      (rankTime which O x.reverse) (greedyCalls x.reverse) (rankWork which O x.reverse) := by
    intro q w
    convert rank_run which O (regs [] [] [] s) x.reverse (by simpa only [List.length_reverse] using hx) q w (fun i => bits (3*n+1+(4*n+2+i))) using 1 <;>
      (try simp only [readyRank,state,rankConfig,greedyRegisters_regs,lastLabel]) <;> rfl
  have hn := computes_normalCode O (rankBits which O x.reverse) s
    (fun i => bits (3*n+1+(4*n+2+(rankTime which O x.reverse+i))))
  rw [normalWord_eq_bits] at hn
  have hh := runs_seq O bits hp (runs_seq O _ hm (runs_seq O _ hr hn))
  convert hh using 1 <;> first | rfl | omega
lemma bounded_rank {n : ℕ} (O : IndependenceOracle n) (which : Bool) (x : Word) (hx : x.length=n) :
    Bounded (rankCode which) O x (rankWord O which x).bits (100*(n+1)^2) := by
  have hr : x.reverse.length=n := by simpa only [List.length_reverse] using hx
  have ht := rankTime_bound which O x.reverse hr
  have hw := rankWork_bound which O x.reverse hr
  have hl := rankBits_length O which x.reverse
  have hn := normalCost_le (rankBits which O x.reverse)
  have hq := greedyCalls_bound x.reverse
  simp only [List.length_reverse,hx] at hl hq
  refine ⟨_,_,_,?_,?_,?_,computes_rank O which x hx⟩ <;> nlinarith

lemma rankWord_correct {n : ℕ} (M₁ M₂ : Matroid (Fin n)) (O : IndependenceOracle n)
    (hO : ExactOracles M₁ M₂ O) (hE₁ : M₁.E=Set.univ) (hE₂ : M₂.E=Set.univ)
    (which : Bool) (x : Word) (hx : x.length=n) :
    rankWord O which x=((if which then M₂ else M₁).eRk (wordSet n x)).toNat := by
  simp only [rankWord,rankBits,popcount_value,binaryValue,Nat.zero_add]
  have hr := wordGreedy_rank (if which then M₂ else M₁) (by cases which <;> assumption)
    (wordOracle which O) (fun l _ => hO which (fun i => l[i.val]?.getD false)) x.reverse
    (by simpa only [List.length_reverse] using hx)
  simpa only [List.reverse_reverse] using hr
open scoped Classical in
lemma rankWord_eq_rankOracle {n : ℕ} (M₁ M₂ : Matroid (Fin n)) (O : IndependenceOracle n)
    (hO : ExactOracles M₁ M₂ O) (hE₁ : M₁.E=Set.univ) (hE₂ : M₂.E=Set.univ)
    (which : Bool) (x : Word) (hx : x.length=n) :
    rankWord O which x=rankOracle O which (wordSet n x).toFinset := by
  classical
  rw [rankWord_correct M₁ M₂ O hO hE₁ hE₂ which x hx,
    rankOracle_correct M₁ M₂ O hO hE₁ hE₂ which,Set.coe_toFinset]

inductive DataType where
  | unit | bool | nat | word
  | prod : DataType → DataType → DataType
  | list : DataType → DataType

@[reducible] def Value : DataType → Type
  | .unit => Unit
  | .bool => Bool
  | .nat => ℕ
  | .word => Word
  | .prod a b => Value a × Value b
  | .list a => List (Value a)

def encode : {a : DataType} → Value a → Word
  | .unit,_ => []
  | .bool,b => [b]
  | .nat,m => m.bits
  | .word,w => w
  | .prod _ _,(x,y) => pair (encode x) (encode y)
  | .list _,xs => words (xs.map encode)

def width {a : DataType} (x : Value a) : ℕ := (encode x).length

inductive Expression : DataType → DataType → Type where
  | ident {a} : Expression a a
  | constant {a b} : Value b → Expression a b
  | compose {a b c} : Expression a b → Expression b c → Expression a c
  | both {a b c} : Expression a b → Expression a c → Expression a (.prod b c)
  | fst {a b} : Expression (.prod a b) a
  | snd {a b} : Expression (.prod a b) b
  | branch {a b} : Expression a b → Expression a b → Expression (.prod .bool a) b
  | fold {a b} : Expression (.prod a b) b → Expression (.prod (.list a) b) b
  | cons {a} : Expression (.prod a (.list a)) (.list a)
  | consBit : Expression (.prod .bool .word) .word
  | append : Expression (.prod .word .word) .word
  | reverse : Expression .word .word
  | toList : Expression .word (.list .bool)
  | toBits : Expression .nat .word
  | toNat : Expression .word .nat
  | add : Expression (.prod .nat .nat) .nat
  | sub : Expression (.prod .nat .nat) .nat
  | rank : Bool → Expression .word .nat
  | mul : Expression (.prod .nat .nat) .nat
  | less : Expression (.prod .nat .nat) .bool
  | divRem : Expression (.prod .nat .nat) (.prod .nat .nat)
  | query : Bool → Expression .word .bool

def compile : {a b : DataType} → Expression a b → Block 1
  | _,_,.ident => skip 1
  | _,_,.constant x => constCode (encode x)
  | _,_,.compose p q => seq (compile p) (compile q)
  | _,_,.both p q => fanout (compile p) (compile q)
  | _,_,.fst => first
  | _,_,.snd => second
  | _,_,.branch p q => selectCode (compile p) (compile q)
  | _,_,.fold p => foldCode (compile p)
  | _,_,.cons => consListCode
  | _,_,.consBit => consWordCode
  | _,_,.append => appendCode
  | _,_,.reverse => reverseCode
  | _,_,.toList => boolListCode
  | _,_,.toBits => skip 1
  | _,_,.toNat => normalCode
  | _,_,.add => addCode
  | _,_,.sub => subCode
  | _,_,.rank b => rankCode b
  | _,_,.mul => mulCode
  | _,_,.less => cmpCode
  | _,_,.divRem => divCode
  | _,_,.query b => queryCode b

def evalFold {a b : DataType} (step : Value (.prod a b) → Option (Value b × ℕ)) :
    List (Value a) → Value b → Option (Value b × ℕ)
  | [],z => some (z,0)
  | x::xs,z => do
    let (z',c) ← step (x,z)
    let (y,d) ← evalFold step xs z'
    pure (y,7+6*width x+6*width (a:=.list a) xs+c+d)

def evaluate {n : ℕ} (O : IndependenceOracle n) : {a b : DataType} → Expression a b →
    Value a → Option (Value b × ℕ)
  | _,_,.ident,x => some (x,0)
  | _,_,.constant y,x => some (y,width x+width y+1)
  | _,_,.compose p q,x => do
    let (y,c) ← evaluate O p x
    let (z,d) ← evaluate O q y
    pure (z,c+d)
  | _,_,.both p q,x => do
    let (y,c) ← evaluate O p x
    let (z,d) ← evaluate O q x
    pure ((y,z),43*width x+39*width y+18*width z+50+c+d)
  | _,_,.fst,(x,y) => some (x,7*width x+width y+4)
  | _,_,.snd,(x,y) => some (y,4*width x+2)
  | _,_,.branch p q,(b,x) => do
    let (y,c) ← (if b then evaluate O q x else evaluate O p x)
    pure (y,5+c)
  | _,_,.fold p,(xs,z) => do
    let (y,c) ← evalFold (evaluate O p) xs z
    pure (y,3*width xs+2+c)
  | _,_,.cons,(x,xs) => some (x::xs,1)
  | _,_,.consBit,(b,xs) => some (b::xs,6)
  | _,_,.append,(x,y) => some (x++y,7*x.length+3)
  | _,_,.reverse,x => some (x.reverse,6*x.length+3)
  | _,_,.toList,x => some (x,7*x.length+2)
  | _,_,.toBits,x => some (x.bits,0)
  | _,_,.toNat,x => some (binaryValue x,5*x.length+4)
  | _,_,.add,(x,y) => some (x+y,20*(x.bits.length+y.bits.length+1))
  | _,_,.sub,(x,y) => if y≤x then some (x-y,30*(x.bits.length+y.bits.length+1)) else none
  | _,_,.rank b,x => if x.length=n then some (rankWord O b x,100*(n+1)^2) else none
  | _,_,.mul,(x,y) => some (x*y,60*(x.bits.length+y.bits.length+1)^2)
  | _,_,.less,(x,y) => some (decide (x<y),5*(x.bits.length+y.bits.length+1))
  | _,_,.divRem,(x,y) => if x=0 then none else
      some ((y%x,y/x),300*(x.bits.length+y.bits.length+1)^2)
  | _,_,.query b,x => if x.length=n then
      some (O b (fun i => x[i.val]?.getD false),3*n+3) else none

lemma bounded_fanout {n : ℕ} {O : IndependenceOracle n} {p q : Block 1} {x y z : Word} {B C : ℕ}
    (h : Bounded p O x y B) (g : Bounded q O x z C) :
    Bounded (fanout p q) O x (pair y z) (43*x.length+39*y.length+18*z.length+50+B+C) := by
  obtain ⟨t,a,w,ht,ha,hw,hp⟩ := h
  obtain ⟨u,b,v,hu,hb,hv,hq⟩ := g
  refine ⟨_,_,_,?_,?_,?_,computes_fanout hp hq⟩ <;> omega
lemma bounded_select {n : ℕ} {O : IndependenceOracle n} (p q : Block 1) (b : Bool) {x y : Word} {B : ℕ}
    (h : Bounded (if b then q else p) O x y B) :
    Bounded (selectCode p q) O (pair [b] x) y (5+B) := by
  obtain ⟨t,a,w,ht,ha,hw,hp⟩ := h
  refine ⟨_,_,_,?_,?_,?_,computes_select p q b hp⟩ <;> omega

lemma computes_bounded {n : ℕ} {O : IndependenceOracle n} {p : Block 1} {x y : Word} {c : ℕ}
    (h : Computes p O x y c 0 c) : Bounded p O x y c :=
  ⟨c,0,c,le_rfl,Nat.zero_le _,le_rfl,h⟩

lemma evalFold_loop {n : ℕ} {O : IndependenceOracle n} {a b : DataType}
    (p : Block 1) (f : Value (.prod a b) → Option (Value b × ℕ))
    (hf : ∀ x y c, f x=some (y,c) → Bounded p O (encode x) (encode y) c)
    (xs : List (Value a)) (z y : Value b) (c : ℕ) (h : evalFold f xs z=some (y,c)) :
    ∃ t q w, t≤1+c ∧ q≤c ∧ w≤1+c ∧ ∀ s bits,
      Runs (repeatBlock (listBody p) 1) O bits (regs (encode z) (encode (a:=.list a) xs) [] s)
        (regs (encode y) [] [] s) t q w := by
  induction xs generalizing z y c with
  | nil =>
    simp only [evalFold,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    refine ⟨1,0,1,by omega,by omega,by omega,?_⟩
    intro s bits
    dsimp only [Runs, repeatBlock]
    intro q w
    simpa only [repeatBlock,state,loopConfig,encode,List.map_nil,words,Nat.add_zero,update_regs_one] using
      repeatProgram_empty (listBody p).code 1 O (regs (encode z) [] [] s) q w bits
  | cons x xs ih =>
    cases h₁ : f (x,z) with
    | none => simp [evalFold,h₁] at h
    | some r =>
      rcases r with ⟨z',c₁⟩
      cases h₂ : evalFold f xs z' with
      | none => simp [evalFold,h₁,h₂] at h
      | some r =>
        rcases r with ⟨y',c₂⟩
        simp [evalFold,h₁,h₂] at h
        rcases h with ⟨rfl,rfl⟩
        obtain ⟨t₁,q₁,w₁,ht₁,hq₁,hw₁,hp⟩ := hf _ _ _ h₁
        obtain ⟨t₂,q₂,w₂,ht₂,hq₂,hw₂,hr⟩ := ih z' y' c₂ h₂
        refine ⟨7+6*width x+6*width (a:=.list a) xs+t₁+t₂,q₁+q₂,
          7+6*width x+6*width (a:=.list a) xs+w₁+w₂,by omega,by omega,by omega,?_⟩
        intro s bits
        have hb := list_body hp (encode (a:=.list a) xs) s (fun i => bits (1+i))
        have hh := runs_repeat_cons (R:=regs (encode z) [] [] s) (b:=true)
          (by simpa only [update_regs_one] using hb)
          (hr s (fun i => bits (1+(6*(encode x).length+6*(encode (a:=.list a) xs).length+6+t₁)+i)))
        simp only [update_regs_one] at hh
        convert hh using 1 <;> first | rfl | (dsimp only [width]; omega)

lemma evalFold_bounded {n : ℕ} {O : IndependenceOracle n} {a b : DataType}
    (p : Block 1) (f : Value (.prod a b) → Option (Value b × ℕ))
    (hf : ∀ x y c, f x=some (y,c) → Bounded p O (encode x) (encode y) c)
    (xs : List (Value a)) (z y : Value b) (c : ℕ) (h : evalFold f xs z=some (y,c)) :
    Bounded (foldCode p) O (encode (a:=.prod (.list a) b) (xs,z)) (encode y) (3*width (a:=.list a) xs+2+c) := by
  obtain ⟨t,q,w,ht,hq,hw,hl⟩ := evalFold_loop p f hf xs z y c h
  refine ⟨3*width (a:=.list a) xs+1+t,q,3*width (a:=.list a) xs+1+w,by omega,by omega,by omega,?_⟩
  intro s bits
  have hs := split_pair O (encode (a:=.list a) xs) (encode z) [] s bits
  simp only [List.append_nil] at hs
  simpa only [Nat.zero_add, foldCode, encode, width] using runs_seq O bits hs (hl s (fun i => bits (3*width (a:=.list a) xs+1+i)))

theorem compile_correct {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (e : Expression a b) : ∀ x y c, evaluate O e x=some (y,c) →
      Bounded (compile e) O (encode x) (encode y) c := by
  induction e with
  | ident =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_skip O _)
  | constant v =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_const O _ _)
  | compose p q ihp ihq =>
    intro x y c h
    cases hp : evaluate O p x with
    | none => simp [evaluate,hp] at h
    | some r =>
      rcases r with ⟨z,d⟩
      cases hq : evaluate O q z with
      | none => simp [evaluate,hp,hq] at h
      | some r =>
        rcases r with ⟨v,f⟩
        simp [evaluate,hp,hq] at h
        rcases h with ⟨rfl,rfl⟩
        exact bounded_seq (ihp _ _ _ hp) (ihq _ _ _ hq)
  | both p q ihp ihq =>
    intro x y c h
    cases hp : evaluate O p x with
    | none => simp [evaluate,hp] at h
    | some r =>
      rcases r with ⟨z,d⟩
      cases hq : evaluate O q x with
      | none => simp [evaluate,hp,hq] at h
      | some r =>
        rcases r with ⟨v,f⟩
        simp [evaluate,hp,hq] at h
        rcases h with ⟨rfl,rfl⟩
        exact bounded_fanout (ihp _ _ _ hp) (ihq _ _ _ hq)
  | fst =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_first O _ _)
  | snd =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_second O _ _)
  | branch p q ihp ihq =>
    intro ⟨b,x⟩ y c h
    have he : (if b then evaluate O q x else evaluate O p x)=evaluate O (if b then q else p) x := by cases b <;> rfl
    cases hp : evaluate O (if b then q else p) x with
    | none => simp [evaluate,he,hp] at h
    | some r =>
      rcases r with ⟨z,d⟩
      simp [evaluate,he,hp] at h
      rcases h with ⟨rfl,rfl⟩
      apply bounded_select
      cases b with
      | false => exact ihp _ _ _ hp
      | true => exact ihq _ _ _ hp
  | fold p ih =>
    intro ⟨xs,z⟩ y c h
    cases hp : evalFold (evaluate O p) xs z with
    | none => simp [evaluate,hp] at h
    | some r =>
      rcases r with ⟨v,d⟩
      simp [evaluate,hp] at h
      rcases h with ⟨rfl,rfl⟩
      exact evalFold_bounded (compile p) (evaluate O p) ih xs z v d hp
  | cons =>
    intro ⟨x,xs⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_consList O _ _)
  | consBit =>
    intro ⟨b,x⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_consWord O _ _)
  | append =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_append O _ _)
  | reverse =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_reverse O _)
  | toList =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_boolList O _)
  | toBits =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    exact computes_bounded (computes_skip O _)
  | toNat =>
    intro x y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    have hh := computes_bounded (computes_normalCode O x)
    rw [normalWord_eq_bits] at hh
    exact bounded_mono hh (normalCost_le x)
  | add =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    simpa only [compile, encode, binaryValue_bits] using bounded_add O x.bits z.bits
  | sub =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate] at h
    by_cases hx : z≤x
    · simp only [ite_eq_left hx,Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      simpa only [compile,encode,binaryValue_bits] using bounded_sub O x.bits z.bits
        (by simpa only [binaryValue_bits] using hx)
    · simp [hx] at h
  | rank b =>
    intro x y c h
    simp only [evaluate] at h
    by_cases hx : x.length=n
    · simp only [ite_eq_left hx,Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      exact bounded_rank O b x hx
    · simp [hx] at h
  | mul =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    simpa only [compile, encode, binaryValue_bits] using bounded_mul O x.bits z.bits
  | less =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    simpa only [compile, encode, binaryValue_bits] using bounded_cmp O x.bits z.bits
  | divRem =>
    intro ⟨x,z⟩ y c h
    simp only [evaluate] at h
    by_cases hx : x=0
    · simp [hx] at h
    · simp only [ite_eq_right hx] at h
      simp only [Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      have hh := bounded_div O x.bits z.bits
      rw [normalizedResult_pos _ _ (by simpa only [binaryValue_bits] using Nat.pos_of_ne_zero hx)] at hh
      simpa only [compile, encode, binaryValue_bits] using hh
  | query b =>
    intro x y c h
    simp only [evaluate] at h
    by_cases hx : x.length=n
    · simp only [ite_eq_left hx] at h
      simp only [Option.some.injEq,Prod.mk.injEq] at h
      rcases h with ⟨rfl,rfl⟩
      exact ⟨n+3,1,3*n+3,by omega,by omega,le_rfl,computes_query O b x hx⟩
    · simp [hx] at h

def foldValue {A B : Type*} (step : A × B → Option B) : List A → B → Option B
  | [],z => some z
  | x::xs,z => (step (x,z)).bind (foldValue step xs)

def run {n : ℕ} (O : IndependenceOracle n) : {a b : DataType} → Expression a b → Value a → Option (Value b)
  | _,_,.ident,x => some x
  | _,_,.constant y,_ => some y
  | _,_,.compose p q,x => (run O p x).bind (run O q)
  | _,_,.both p q,x => do let y ← run O p x; let z ← run O q x; pure (y,z)
  | _,_,.fst,(x,_) => some x
  | _,_,.snd,(_,y) => some y
  | _,_,.branch p q,(b,x) => if b then run O q x else run O p x
  | _,_,.fold p,(xs,z) => foldValue (run O p) xs z
  | _,_,.cons,(x,xs) => some (x::xs)
  | _,_,.consBit,(b,xs) => some (b::xs)
  | _,_,.append,(x,y) => some (x++y)
  | _,_,.reverse,x => some x.reverse
  | _,_,.toList,x => some x
  | _,_,.toBits,x => some x.bits
  | _,_,.toNat,x => some (binaryValue x)
  | _,_,.add,(x,y) => some (x+y)
  | _,_,.sub,(x,y) => if y≤x then some (x-y) else none
  | _,_,.mul,(x,y) => some (x*y)
  | _,_,.less,(x,y) => some (decide (x<y))
  | _,_,.divRem,(x,y) => if x=0 then none else some (y%x,y/x)
  | _,_,.query b,x => if x.length=n then some (O b (fun i => x[i.val]?.getD false)) else none
  | _,_,.rank b,x => if x.length=n then some (rankWord O b x) else none

lemma evalFold_forget {a b : DataType} (f : Value (.prod a b) → Option (Value b × ℕ))
    (g : Value (.prod a b) → Option (Value b)) (hfg : ∀ x,(f x).map Prod.fst=g x)
    (xs : List (Value a)) (z : Value b) : (evalFold f xs z).map Prod.fst=foldValue g xs z := by
  induction xs generalizing z with
  | nil => rfl
  | cons x xs ih =>
    rw [evalFold,foldValue,←hfg]
    cases hf : f (x,z) with
    | none => rfl
    | some r =>
      rcases r with ⟨z',c⟩
      simp only [Option.map_some,Option.bind_some]
      rw [←ih]
      cases hh : evalFold f xs z' <;> simp [hh]
lemma evaluate_forget {n : ℕ} (O : IndependenceOracle n) {a b : DataType} (e : Expression a b)
    (x : Value a) : (evaluate O e x).map Prod.fst=run O e x := by
  induction e with
  | compose p q ihp ihq =>
    simp only [evaluate,run,←ihp]
    cases hp : evaluate O p x with
    | none => rfl
    | some r =>
      rcases r with ⟨y,c⟩
      simp only [Option.map_some,Option.bind_some]
      rw [←ihq]
      cases hh : evaluate O q y <;> simp [hh]
  | both p q ihp ihq =>
    simp only [evaluate,run,←ihp,←ihq]
    cases evaluate O p x <;> cases evaluate O q x <;> rfl
  | branch p q ihp ihq =>
    rcases x with ⟨b,x⟩
    cases b <;> simp only [evaluate,run,Bool.false_eq_true,ite_false,ite_true,←ihp,←ihq] <;>
      first | (cases evaluate O p x <;> rfl) | (cases evaluate O q x <;> rfl)
  | fold p ih =>
    rcases x with ⟨xs,z⟩
    simp only [evaluate,run,←evalFold_forget (evaluate O p) (run O p) ih xs z]
    cases evalFold (evaluate O p) xs z <;> rfl
  | divRem => rcases x with ⟨x,y⟩; simp only [evaluate,run]; split_ifs <;> rfl
  | sub => rcases x with ⟨x,y⟩; simp only [evaluate,run]; split_ifs <;> rfl
  | query b => simp only [evaluate,run]; split_ifs <;> rfl
  | rank b => simp only [evaluate,run]; split_ifs <;> rfl
  | _ => rfl

lemma compile_run {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (e : Expression a b) (x : Value a) (y : Value b) (h : run O e x=some y) :
    ∃ B, Bounded (compile e) O (encode x) (encode y) B := by
  rw [←evaluate_forget] at h
  cases he : evaluate O e x with
  | none => simp [he] at h
  | some r =>
    rcases r with ⟨y',c⟩
    simp only [he,Option.map_some,Option.some.injEq] at h
    subst y'
    exact ⟨c,compile_correct O e x y c he⟩

namespace Expression
infixr:80 " >>> " => compose

def onLeft {a b c} (p : Expression a b) : Expression (.prod a c) (.prod b c) :=
  both (fst >>> p) snd
def onRight {a b c} (p : Expression a b) : Expression (.prod c a) (.prod c b) :=
  both fst (snd >>> p)
def swap {a b} : Expression (.prod a b) (.prod b a) := both snd fst
def letIn {a b c} (p : Expression a b) (q : Expression (.prod a b) c) : Expression a c :=
  both ident p >>> q
def applyIf {a b} (test : Expression a .bool) (no yes : Expression a b) : Expression a b :=
  both test ident >>> branch no yes

def boolNot : Expression .bool .bool := both ident ident >>> branch (constant true) (constant false)
def boolAnd : Expression (.prod .bool .bool) .bool := branch (constant false) ident
def natEqZero : Expression .nat .bool := both ident (constant 1) >>> less
def natSub : Expression (.prod .nat .nat) .nat := applyIf less sub (constant 0)
def natDivRem : Expression (.prod .nat .nat) (.prod .nat .nat) :=
  applyIf (fst >>> natEqZero) divRem (both snd (constant 0))
def natDiv : Expression (.prod .nat .nat) .nat := natDivRem >>> snd
def natMod : Expression (.prod .nat .nat) .nat := natDivRem >>> fst

def listReverse {a} : Expression (.list a) (.list a) := both ident (constant []) >>> fold cons

def mapStep {a b c} (p : Expression (.prod a c) b) : Expression (.prod a (.prod (.list b) c)) (.prod (.list b) c) :=
  both
    (both (both fst (snd >>> snd) >>> p) (snd >>> fst) >>> cons)
    (snd >>> snd)
def mapWith {a b c} (p : Expression (.prod a c) b) : Expression (.prod (.list a) c) (.list b) :=
  both fst (both (constant []) snd) >>> fold (mapStep p) >>> fst >>> listReverse

def listLength {a} : Expression (.list a) .nat :=
  both ident (constant 0) >>> fold (both snd (constant 1) >>> add)
def wordLength : Expression .word .nat := toList >>> listLength

def wordRepeatStep : Expression (.prod .bool .word) .word :=
  letIn (snd >>> both ident ident >>> append)
    (both fst snd >>> both (fst >>> fst) snd >>> branch ident (both (constant false) ident >>> consBit))

def unary : Expression .nat .word :=
  both (toBits >>> reverse >>> toList) (constant []) >>> fold wordRepeatStep

end Expression

lemma foldValue_eq_foldl {a b : DataType} (f : Value (.prod a b) → Option (Value b))
    (g : Value b → Value a → Value b) (hf : ∀ x z, f (x,z)=some (g z x))
    (xs : List (Value a)) (z : Value b) : foldValue f xs z=some (xs.foldl g z) := by
  induction xs generalizing z with
  | nil => rfl
  | cons x xs ih => simp [foldValue,hf,ih]

namespace Expression
variable {n : ℕ} (O : IndependenceOracle n)
@[simp] lemma run_boolNot (b : Bool) : run O boolNot b=some (!b) := by
  cases b <;> rfl
@[simp] lemma run_boolAnd (b c : Bool) : run O boolAnd (b,c)=some (b && c) := by
  cases b <;> rfl
@[simp] lemma run_natEqZero (m : ℕ) : run O natEqZero m=some (decide (m=0)) := by
  simp [natEqZero,run]
@[simp] lemma run_natSub (x y : ℕ) : run O natSub (x,y)=some (x-y) := by
  simp only [natSub,applyIf,run]
  by_cases h : x<y
  · simp [h,Nat.sub_eq_zero_of_le (Nat.le_of_lt h)]
  · simp [h,Nat.le_of_not_gt h]
@[simp] lemma run_natDivRem (x y : ℕ) : run O natDivRem (x,y)=some (y%x,y/x) := by
  simp only [natDivRem,applyIf,run,run_natEqZero]
  by_cases h : x=0 <;> simp [h]
@[simp] lemma run_natDiv (x y : ℕ) : run O natDiv (x,y)=some (y/x) := by
  change ((run O natDivRem (x,y)).bind fun p => some p.2)=some (y/x)
  rw [run_natDivRem]; rfl
@[simp] lemma run_natMod (x y : ℕ) : run O natMod (x,y)=some (y%x) := by
  change ((run O natDivRem (x,y)).bind fun p => some p.1)=some (y%x)
  rw [run_natDivRem]; rfl
lemma run_listReverse {a : DataType} (xs : List (Value a)) :
    run O listReverse xs=some xs.reverse := by
  simp only [listReverse,run]
  have h := foldValue_eq_foldl (fun p : Value (.prod a (.list a)) => some (p.1::p.2))
    (fun zs x => x::zs) (fun _ _ => rfl) xs []
  simpa using h
lemma run_mapStep {a b c : DataType} (p : Expression (.prod a c) b)
    (f : Value a → Value c → Value b) (hp : ∀ x z, run O p (x,z)=some (f x z))
    (x : Value a) (xs : List (Value b)) (z : Value c) :
    run O (mapStep p) (x,(xs,z))=some (f x z::xs,z) := by
  simp [mapStep,run,hp]
lemma run_mapWith {a b c : DataType} (p : Expression (.prod a c) b)
    (f : Value a → Value c → Value b) (hp : ∀ x z, run O p (x,z)=some (f x z))
    (xs : List (Value a)) (z : Value c) :
    run O (mapWith p) (xs,z)=some (xs.map (fun x => f x z)) := by
  have hf : ∀ (ys : List (Value a)) (acc : List (Value b)),
      foldValue (run O (mapStep p)) ys (acc,z)=some ((ys.map (fun x => f x z)).reverse++acc,z) := by
    intro ys
    induction ys with
    | nil => intro acc; rfl
    | cons x ys ih => intro acc; simp [foldValue,run_mapStep O p f hp,ih,List.append_assoc]
  simp [mapWith,run,hf,run_listReverse]
lemma run_listLength {a : DataType} (xs : List (Value a)) :
    run O listLength xs=some xs.length := by
  have hf : ∀ (ys : List (Value a)) (z : ℕ),
      foldValue (fun p : Value (.prod a .nat) => some (p.2+1)) ys z=some (z+ys.length) := by
    intro ys
    induction ys with
    | nil => intro z; simp [foldValue]
    | cons x ys ih => intro z; simpa [foldValue,ih] using congrArg some (by omega : z+1+ys.length=z+(ys.length+1))
  simp [listLength,run,hf]
lemma run_wordLength (xs : Word) : run O wordLength xs=some xs.length := by
  simp [wordLength,run,run_listLength]
lemma run_wordRepeatStep (b : Bool) (w : Word) :
    run O wordRepeatStep (b,w)=some (if b then false::(w++w) else w++w) := by
  cases b <;> rfl
lemma unary_value (xs : List Bool) (w : Word) :
    ∃ out, foldValue (run O wordRepeatStep) xs.reverse w=some out ∧
      out.length=2^xs.length*w.length+binaryValue xs := by
  induction xs generalizing w with
  | nil => exact ⟨w,rfl,by simp [binaryValue]⟩
  | cons b xs ih =>
    obtain ⟨u,hu,hl⟩ := ih w
    have happ : ∀ (ys zs : List Bool) v,
        foldValue (run O wordRepeatStep) (ys++zs) v=
          (foldValue (run O wordRepeatStep) ys v).bind (foldValue (run O wordRepeatStep) zs) := by
      intro ys
      induction ys with
      | nil => intros; rfl
      | cons y ys ih => intros; simp [foldValue,ih,Option.bind_assoc]
    refine ⟨(if b then false::(u++u) else u++u),?_,?_⟩
    · rw [List.reverse_cons,happ,hu]
      simp only [Option.bind_some,foldValue]
      rw [run_wordRepeatStep]; rfl
    · cases b <;> simp [List.length_append,hl,binaryValue,Nat.pow_succ] <;> ring
lemma run_unary (m : ℕ) : ∃ w,run O unary m=some w ∧ w.length=m := by
  obtain ⟨w,hw,hlen⟩ := unary_value O m.bits []
  refine ⟨w,?_,?_⟩
  · simpa [unary,run] using hw
  · simpa [binaryValue_bits] using hlen
end Expression

@[simp] lemma width_pair {a b : DataType} (x : Value a) (y : Value b) :
    width (a:=.prod a b) (x,y)=2*width x+1+width y := by simp [width,encode]
@[simp] lemma width_nil {a : DataType} : width (a:=.list a) []=0 := rfl
@[simp] lemma width_cons {a : DataType} (x : Value a) (xs : List (Value a)) :
    width (a:=.list a) (x::xs)=2*width x+2+width (a:=.list a) xs := by
  simp [width,encode,words]; omega
lemma list_length_le_width {a : DataType} (xs : List (Value a)) :
    xs.length≤width (a:=.list a) xs := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [List.length_cons,width_cons]; omega

def FoldSafe {A B : Type*} (ok : A×B → Prop) (f : A×B → Option B) : List A → B → Prop
  | [],_ => True
  | x::xs,z => ok (x,z) ∧ ∀ y,f (x,z)=some y → FoldSafe ok f xs y

def Safe {n : ℕ} (O : IndependenceOracle n) (S : ℕ) : {a b : DataType} →
    Expression a b → Value a → Prop
  | _,_,e,x => width x≤S ∧ (∀ y,run O e x=some y → width y≤S) ∧
    match e,x with
    | .compose p q,x => Safe O S p x ∧ ∀ y,run O p x=some y → Safe O S q y
    | .both p q,x => Safe O S p x ∧ Safe O S q x
    | .branch p q,(b,x) => if b then Safe O S q x else Safe O S p x
    | .fold p,(xs,z) => FoldSafe (Safe O S p) (run O p) xs z
    | _,_ => True

lemma safe_input {n S : ℕ} {O : IndependenceOracle n} {a b : DataType}
    {p : Expression a b} {x : Value a} (h : Safe O S p x) : width x≤S := by
  cases p <;> exact h.1
lemma safe_output {n S : ℕ} {O : IndependenceOracle n} {a b : DataType}
    {p : Expression a b} {x : Value a} (h : Safe O S p x) {y : Value b}
    (hr : run O p x=some y) : width y≤S := by
  cases p <;> exact h.2.1 y hr

def chargeBound : {a b : DataType} → Expression a b → ℕ → ℕ
  | _,_,.compose p q,T => 10000*(T+1)^2+chargeBound p T+chargeBound q T
  | _,_,.both p q,T => 10000*(T+1)^2+chargeBound p T+chargeBound q T
  | _,_,.branch p q,T => 10000*(T+1)^2+chargeBound p T+chargeBound q T
  | _,_,.fold p,T => 10000*(T+1)^2+(T+1)*(10000*(T+1)^2+chargeBound p T)
  | _,_,_,T => 10000*(T+1)^2

lemma evalFold_charge {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression (.prod a b) b) (S E : ℕ)
    (hp : ∀ x y c,Safe O S p x → evaluate O p x=some (y,c) → c≤E)
    (xs : List (Value a)) (z y : Value b) (c : ℕ)
    (hs : FoldSafe (Safe O S p) (run O p) xs z) (hw : width (a:=.list a) xs≤S)
    (he : evalFold (evaluate O p) xs z=some (y,c)) :
    c≤xs.length*(7+12*S+E) := by
  induction xs generalizing z y c with
  | nil => simp [evalFold] at he; rcases he with ⟨rfl,rfl⟩; simp
  | cons x xs ih =>
    rw [evalFold] at he
    cases hh : evaluate O p (x,z) with
    | none => simp [hh] at he
    | some u =>
      rcases u with ⟨z',d⟩
      have hrun : run O p (x,z)=some z' := by rw [←evaluate_forget,hh]; rfl
      have hd := hp (x,z) z' d hs.1 hh
      have hw' : width (a:=.list a) xs≤S := by rw [width_cons] at hw; omega
      have hx : width x≤S := by rw [width_cons] at hw; omega
      cases ht : evalFold (evaluate O p) xs z' with
      | none => simp [hh,ht] at he
      | some u =>
        rcases u with ⟨y',e⟩
        simp [hh,ht] at he
        rcases he with ⟨rfl,rfl⟩
        have hh := ih z' y' e (hs.2 z' hrun) hw' ht
        simp only [List.length_cons,Nat.add_mul,Nat.one_mul]
        omega

lemma charge_primitive (T : ℕ) : 300*(2*T+1)^2+100*T+100≤10000*(T+1)^2 := by nlinarith

lemma evaluate_charge {n : ℕ} (O : IndependenceOracle n) {a b : DataType} (p : Expression a b)
    (S : ℕ) (x : Value a) (y : Value b) (c : ℕ) (hs : Safe O S p x)
    (he : evaluate O p x=some (y,c)) : c≤chargeBound p (S+n) := by
  induction p generalizing S c with
  | compose p q ihp ihq =>
    rcases hs with ⟨hx,hy,hp,hq⟩
    simp only [evaluate] at he
    cases hpv : evaluate O p x with
    | none => simp [hpv] at he
    | some u =>
      rcases u with ⟨z,d⟩
      have hr : run O p x=some z := by rw [←evaluate_forget,hpv]; rfl
      have hd := ihp S x z d hp hpv
      cases hqv : evaluate O q z with
      | none => simp [hpv,hqv] at he
      | some u =>
        rcases u with ⟨y',e⟩
        simp [hpv,hqv] at he
        rcases he with ⟨rfl,rfl⟩
        have hh := ihq S z y' e (hq z hr) hqv
        simp only [chargeBound]; omega
  | both p q ihp ihq =>
    rcases hs with ⟨hx,hy,hp,hq⟩
    simp only [evaluate] at he
    cases hpv : evaluate O p x with
    | none => simp [hpv] at he
    | some u =>
      rcases u with ⟨z,d⟩
      have hr : run O p x=some z := by rw [←evaluate_forget,hpv]; rfl
      have hz := safe_output hp hr
      have hd := ihp S x z d hp hpv
      cases hqv : evaluate O q x with
      | none => simp [hpv,hqv] at he
      | some u =>
        rcases u with ⟨z',e⟩
        have hr' : run O q x=some z' := by rw [←evaluate_forget,hqv]; rfl
        have hz' := safe_output hq hr'
        simp [hpv,hqv] at he
        rcases he with ⟨rfl,rfl⟩
        have hh := ihq S x z' e hq hqv
        have hb := charge_primitive (S+n)
        simp only [chargeBound]; nlinarith
  | branch p q ihp ihq =>
    rcases x with ⟨b,x⟩
    rcases hs with ⟨hx,hy,hh⟩
    cases b <;> simp only [Bool.false_eq_true,ite_false,ite_true] at hh <;>
      simp only [evaluate,Bool.false_eq_true,ite_false,ite_true] at he
    · cases hv : evaluate O p x with
      | none => simp [hv] at he
      | some u =>
        rcases u with ⟨y',d⟩
        simp [hv] at he
        rcases he with ⟨rfl,rfl⟩
        have hd := ihp S x y' d hh hv
        have hb := charge_primitive (S+n)
        simp only [chargeBound]; omega
    · cases hv : evaluate O q x with
      | none => simp [hv] at he
      | some u =>
        rcases u with ⟨y',d⟩
        simp [hv] at he
        rcases he with ⟨rfl,rfl⟩
        have hd := ihq S x y' d hh hv
        have hb := charge_primitive (S+n)
        simp only [chargeBound]; omega
  | fold p ih =>
    rcases x with ⟨xs,z⟩
    rcases hs with ⟨hx,hy,hh⟩
    have hw : width (a:=.list _) xs≤S := by rw [width_pair] at hx; omega
    have hlen := list_length_le_width xs
    simp only [evaluate] at he
    cases hv : evalFold (evaluate O p) xs z with
    | none => simp [hv] at he
    | some u =>
      rcases u with ⟨y',d⟩
      simp [hv] at he
      rcases he with ⟨rfl,rfl⟩
      have hd := evalFold_charge O p S (chargeBound p (S+n)) (fun x y c => ih S x y c) xs z y' d hh hw hv
      have hb := charge_primitive (S+n)
      have hmul : xs.length*(7+12*S+chargeBound p (S+n))≤(S+n+1)*(10000*(S+n+1)^2+chargeBound p (S+n)) :=
        Nat.mul_le_mul (by omega) (by omega)
      simp only [chargeBound]; omega
  | ident => simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at he; rcases he with ⟨rfl,rfl⟩; exact Nat.zero_le _
  | constant z =>
    have hx := safe_input hs
    have hz := safe_output hs (y:=z) rfl
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at he
    rcases he with ⟨rfl,rfl⟩
    have hb := charge_primitive (S+n)
    simp only [chargeBound]; omega
  | fst =>
    rcases x with ⟨u,v⟩
    have hx := safe_input hs
    rw [width_pair] at hx
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at he
    rcases he with ⟨rfl,rfl⟩
    have hb := charge_primitive (S+n)
    simp only [chargeBound]; omega
  | snd =>
    rcases x with ⟨u,v⟩
    have hx := safe_input hs
    rw [width_pair] at hx
    simp only [evaluate,Option.some.injEq,Prod.mk.injEq] at he
    rcases he with ⟨rfl,rfl⟩
    have hb := charge_primitive (S+n)
    simp only [chargeBound]; omega
  | cons | consBit | append | add | sub | mul | less | divRem =>
    rcases x with ⟨x,y⟩
    have hx := safe_input hs
    have hb := charge_primitive (S+n)
    try simp only [width_pair] at hx
    simp only [evaluate] at he
    try split_ifs at he
    all_goals
      simp only [Option.some.injEq,Prod.mk.injEq] at he
      try contradiction
      rcases he with ⟨rfl,rfl⟩
      simp only [chargeBound,width,encode,pair_length] at hx ⊢
      nlinarith
  | reverse | toList | toBits | toNat | rank | query =>
    have hx := safe_input hs
    have hb := charge_primitive (S+n)
    simp only [evaluate] at he
    try split_ifs at he
    all_goals
      simp only [Option.some.injEq,Prod.mk.injEq] at he
      try contradiction
      rcases he with ⟨rfl,rfl⟩
      simp only [chargeBound,width,encode] at hx ⊢
      nlinarith

def chargeDegree : {a b : DataType} → Expression a b → ℕ
  | _,_,.compose p q => chargeDegree p+chargeDegree q+3
  | _,_,.both p q => chargeDegree p+chargeDegree q+3
  | _,_,.branch p q => chargeDegree p+chargeDegree q+3
  | _,_,.fold p => chargeDegree p+3
  | _,_,_ => 2

def chargeCoefficient : {a b : DataType} → Expression a b → ℕ
  | _,_,.compose p q => 10000+chargeCoefficient p+chargeCoefficient q
  | _,_,.both p q => 10000+chargeCoefficient p+chargeCoefficient q
  | _,_,.branch p q => 10000+chargeCoefficient p+chargeCoefficient q
  | _,_,.fold p => 20000+chargeCoefficient p
  | _,_,_ => 10000

lemma monomial_add_bound (T C D e f x y : ℕ) (hx : x≤C*(T+1)^e) (hy : y≤D*(T+1)^f) :
    10000*(T+1)^2+x+y≤(10000+C+D)*(T+1)^(e+f+3) := by
  have hbase : 1≤T+1 := by omega
  have hp : (T+1)^2≤(T+1)^(e+f+3) := Nat.pow_le_pow_right hbase (by omega)
  have he : (T+1)^e≤(T+1)^(e+f+3) := Nat.pow_le_pow_right hbase (by omega)
  have hf : (T+1)^f≤(T+1)^(e+f+3) := Nat.pow_le_pow_right hbase (by omega)
  have hx' := hx.trans (Nat.mul_le_mul_left C he)
  have hy' := hy.trans (Nat.mul_le_mul_left D hf)
  calc
    _ ≤ 10000*(T+1)^(e+f+3)+C*(T+1)^(e+f+3)+D*(T+1)^(e+f+3) := by omega
    _ = _ := by ring
lemma monomial_fold_bound (T C e x : ℕ) (hx : x≤C*(T+1)^e) :
    10000*(T+1)^2+(T+1)*(10000*(T+1)^2+x)≤(20000+C)*(T+1)^(e+3) := by
  have hbase : 1≤T+1 := by omega
  have hp : (T+1)^2≤(T+1)^(e+3) := Nat.pow_le_pow_right hbase (by omega)
  have hq : (T+1)^3≤(T+1)^(e+3) := Nat.pow_le_pow_right hbase (by omega)
  have he : (T+1)^(e+1)≤(T+1)^(e+3) := Nat.pow_le_pow_right hbase (by omega)
  calc
    _ ≤ 10000*(T+1)^2+(T+1)*(10000*(T+1)^2+C*(T+1)^e) := by gcongr
    _ = 10000*(T+1)^2+10000*(T+1)^3+C*(T+1)^(e+1) := by ring
    _ ≤ 10000*(T+1)^(e+3)+10000*(T+1)^(e+3)+C*(T+1)^(e+3) := by gcongr
    _ = _ := by ring

lemma chargeBound_polynomial {a b : DataType} (p : Expression a b) (T : ℕ) :
    chargeBound p T≤chargeCoefficient p*(T+1)^chargeDegree p := by
  induction p with
  | compose p q ihp ihq | both p q ihp ihq | branch p q ihp ihq =>
      exact monomial_add_bound T _ _ _ _ _ _ ihp ihq
  | fold p ih => exact monomial_fold_bound T _ _ _ ih
  | ident | constant | fst | snd | cons | consBit | append | reverse | toList | toBits | toNat |
    add | sub | mul | less | divRem | query | rank => exact Nat.le_refl _

lemma evaluate_polynomial {n : ℕ} (O : IndependenceOracle n) {a b : DataType} (p : Expression a b)
    (S : ℕ) (x : Value a) (y : Value b) (c : ℕ) (hs : Safe O S p x)
    (he : evaluate O p x=some (y,c)) :
    c≤chargeCoefficient p*(S+n+1)^chargeDegree p :=
  (evaluate_charge O p S x y c hs he).trans (chargeBound_polynomial p (S+n))

lemma foldSafe_mono {A B : Type*} (p q : A×B → Prop) (f : A×B → Option B)
    (hpq : ∀ x,p x → q x) (xs : List A) (z : B) (h : FoldSafe p f xs z) :
    FoldSafe q f xs z := by
  induction xs generalizing z with
  | nil => trivial
  | cons x xs ih => exact ⟨hpq _ h.1,fun y hy => ih y (h.2 y hy)⟩
lemma safe_mono {n S T : ℕ} {O : IndependenceOracle n} {a b : DataType}
    (p : Expression a b) (x : Value a) (h : Safe O S p x) (hST : S≤T) : Safe O T p x := by
  induction p with
  | compose p q ihp ihq =>
    exact ⟨h.1.trans hST,fun y hy => (h.2.1 y hy).trans hST,
      ihp _ h.2.2.1,fun y hy => ihq _ (h.2.2.2 y hy)⟩
  | both p q ihp ihq =>
    exact ⟨h.1.trans hST,fun y hy => (h.2.1 y hy).trans hST,ihp _ h.2.2.1,ihq _ h.2.2.2⟩
  | branch p q ihp ihq =>
    refine ⟨h.1.trans hST,fun y hy => (h.2.1 y hy).trans hST,?_⟩
    rcases x with ⟨v,x⟩
    cases v <;> simp only [Bool.false_eq_true,ite_false,ite_true] at *
    · exact ihp _ h.2.2
    · exact ihq _ h.2.2
  | fold p ih =>
    exact ⟨h.1.trans hST,fun y hy => (h.2.1 y hy).trans hST,
      foldSafe_mono _ _ _ (fun x hx => ih x hx) _ _ h.2.2⟩
  | _ => exact ⟨h.1.trans hST,fun y hy => (h.2.1 y hy).trans hST,trivial⟩

lemma safe_compose {n S : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression a b) (q : Expression b c) (x : Value a)
    (hp : Safe O S p x) (hq : ∀ y,run O p x=some y → Safe O S q y) :
    Safe O S (.compose p q) x := by
  refine ⟨safe_input hp,?_,hp,hq⟩
  intro z hz
  simp only [run] at hz
  cases he : run O p x with
  | none => simp [he] at hz
  | some y =>
    simp only [he,Option.bind_some] at hz
    exact safe_output (hq y he) hz
lemma safe_both {n S : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression a b) (q : Expression a c) (x : Value a)
    (hp : Safe O S p x) (hq : Safe O S q x) :
    Safe O (3*S+1) (.both p q) x := by
  have hS : S≤3*S+1 := by omega
  refine ⟨(safe_input hp).trans hS,?_,safe_mono p x hp hS,safe_mono q x hq hS⟩
  intro z hz
  simp only [run] at hz
  cases he : run O p x with
  | none => simp [he] at hz
  | some y =>
    simp only [he] at hz
    cases hf : run O q x with
    | none => simp [hf] at hz
    | some w =>
      simp only [hf,] at hz
      have hh : (y,w)=z := Option.some.inj hz
      cases hh
      have hy := safe_output hp he
      have hw := safe_output hq hf
      rw [width_pair]
      omega
lemma foldSafe_invariant {A B : Type*} (ok : A×B → Prop) (f : A×B → Option B)
    (P : B → Prop) (xs : List A) (z : B) (hz : P z)
    (hstep : ∀ x∈xs,∀ y,P y → ok (x,y) ∧ ∀ y',f (x,y)=some y' → P y') :
    FoldSafe ok f xs z := by
  induction xs generalizing z with
  | nil => trivial
  | cons x xs ih =>
    obtain ⟨hgood,hnext⟩ := hstep x (by simp) z hz
    exact ⟨hgood,fun y hy => ih y (hnext y hy) (fun v hv => hstep v (by simp [hv]))⟩
lemma foldValue_invariant {A B : Type*} (f : A×B → Option B) (P : B → Prop)
    (xs : List A) (z : B) (hz : P z)
    (hstep : ∀ x∈xs,∀ y,P y → ∀ y',f (x,y)=some y' → P y')
    (y : B) (hy : foldValue f xs z=some y) : P y := by
  induction xs generalizing z with
  | nil => cases hy; exact hz
  | cons x xs ih =>
    simp only [foldValue] at hy
    cases he : f (x,z) with
    | none => simp [he] at hy
    | some w =>
      simp only [he,Option.bind_some] at hy
      exact ih w (hstep x (by simp) z hz w he) (fun v hv => hstep v (by simp [hv])) hy
lemma safe_fold_invariant {n S : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression (.prod a b) b) (xs : List (Value a)) (z : Value b) (P : Value b → Prop)
    (hz : P z) (hw : width (a:=.prod (.list a) b) (xs,z)≤S)
    (hwidth : ∀ y,P y → width y≤S)
    (hstep : ∀ x∈xs,∀ y,P y → Safe O S p (x,y) ∧ ∀ y',run O p (x,y)=some y' → P y') :
    Safe O S (.fold p) (xs,z) := by
  refine ⟨hw,?_,foldSafe_invariant _ _ P xs z hz hstep⟩
  intro y hy
  exact hwidth y (foldValue_invariant _ P xs z hz (fun x hx v hv => (hstep x hx v hv).2) y hy)

inductive SizePolynomial where
  | constant : ℕ → SizePolynomial
  | input : SizePolynomial
  | add : SizePolynomial → SizePolynomial → SizePolynomial
  | mul : SizePolynomial → SizePolynomial → SizePolynomial
namespace SizePolynomial
def eval : SizePolynomial → ℕ → ℕ
  | .constant c,_ => c
  | .input,x => x
  | .add p q,x => p.eval x+q.eval x
  | .mul p q,x => p.eval x*q.eval x
def degree : SizePolynomial → ℕ
  | .constant _ => 0
  | .input => 1
  | .add p q | .mul p q => p.degree+q.degree
def coefficient : SizePolynomial → ℕ
  | .constant c => c
  | .input => 1
  | .add p q => p.coefficient+q.coefficient
  | .mul p q => p.coefficient*q.coefficient
lemma monotone (p : SizePolynomial) : Monotone p.eval := by
  intro x y h
  induction p with
  | constant c => rfl
  | input => exact h
  | add p q ihp ihq => exact Nat.add_le_add ihp ihq
  | mul p q ihp ihq => exact Nat.mul_le_mul ihp ihq
lemma bound (p : SizePolynomial) (x : ℕ) : p.eval x≤p.coefficient*(x+1)^p.degree := by
  induction p with
  | constant c => simp [eval,coefficient,degree]
  | input => simp [eval,coefficient,degree]
  | add p q ihp ihq =>
    have hp := Nat.pow_le_pow_right (by omega : 1≤x+1) (Nat.le_add_right p.degree q.degree)
    have hq := Nat.pow_le_pow_right (by omega : 1≤x+1) (Nat.le_add_left q.degree p.degree)
    dsimp only [eval,coefficient,degree]
    calc
      _ ≤ p.coefficient*(x+1)^(p.degree+q.degree)+q.coefficient*(x+1)^(p.degree+q.degree) :=
        Nat.add_le_add (ihp.trans (Nat.mul_le_mul_left _ hp)) (ihq.trans (Nat.mul_le_mul_left _ hq))
      _ = _ := by ring
  | mul p q ihp ihq =>
    dsimp only [eval,coefficient,degree]
    calc
      _ ≤ (p.coefficient*(x+1)^p.degree)*(q.coefficient*(x+1)^q.degree) := Nat.mul_le_mul ihp ihq
      _ = _ := by rw [pow_add]; ring
def subst : SizePolynomial → SizePolynomial → SizePolynomial
  | .constant c,_ => .constant c
  | .input,q => q
  | .add p r,q => .add (p.subst q) (r.subst q)
  | .mul p r,q => .mul (p.subst q) (r.subst q)
lemma eval_subst (p q : SizePolynomial) (x : ℕ) : (p.subst q).eval x=p.eval (q.eval x) := by
  induction p <;> simp_all [subst,eval]
end SizePolynomial

def Controlled {a b : DataType} (p : Expression a b) : Prop :=
  ∃ f : SizePolynomial,∀ {n : ℕ} (O : IndependenceOracle n) (x : Value a),Safe O (f.eval (width x)) p x
lemma controlled_input {a b : DataType} {p : Expression a b} (hp : Controlled p) :
    ∃ C d : ℕ,∀ {n : ℕ} (O : IndependenceOracle n) (S : ℕ) (x : Value a),
      width x≤S → Safe O (C*(S+1)^d) p x := by
  obtain ⟨f,hf⟩ := hp
  exact ⟨f.coefficient,f.degree,fun O S x hx => safe_mono p x (hf O x)
    ((f.monotone hx).trans (f.bound S))⟩
lemma controlled_compose {a b c : DataType} (p : Expression a b) (q : Expression b c)
    (hp : Controlled p) (hq : Controlled q) : Controlled (.compose p q) := by
  obtain ⟨f,hf⟩ := hp
  obtain ⟨g,hg⟩ := hq
  refine ⟨.add f (g.subst f),fun O x => ?_⟩
  apply safe_compose O p q x
  · exact safe_mono p x (hf O x) (by simp only [SizePolynomial.eval]; omega)
  · intro y hy
    have h := safe_output (hf O x) hy
    apply safe_mono q y (hg O y)
    rw [SizePolynomial.eval,SizePolynomial.eval_subst]
    exact (g.monotone h).trans (Nat.le_add_left _ _)
lemma controlled_both {a b c : DataType} (p : Expression a b) (q : Expression a c)
    (hp : Controlled p) (hq : Controlled q) : Controlled (.both p q) := by
  obtain ⟨f,hf⟩ := hp
  obtain ⟨g,hg⟩ := hq
  refine ⟨.add (.mul (.constant 3) (.add f g)) (.constant 1),fun O x => ?_⟩
  apply safe_both O p q x
  · exact safe_mono p x (hf O x) (Nat.le_add_right _ _)
  · exact safe_mono q x (hg O x) (Nat.le_add_left _ _)
lemma controlled_branch {a b : DataType} (p q : Expression a b)
    (hp : Controlled p) (hq : Controlled q) : Controlled (.branch p q) := by
  obtain ⟨f,hf⟩ := hp
  obtain ⟨g,hg⟩ := hq
  refine ⟨.add .input (.add f g),fun O x => ?_⟩
  rcases x with ⟨v,x⟩
  have hw : width x≤width (a:=.prod .bool a) (v,x) := by rw [width_pair]; omega
  have hp' : Safe O (width (a:=.prod .bool a) (v,x)+
      (f.eval (width (a:=.prod .bool a) (v,x))+g.eval (width (a:=.prod .bool a) (v,x)))) p x :=
    safe_mono p x (hf O x) ((f.monotone hw).trans (by omega))
  have hq' : Safe O (width (a:=.prod .bool a) (v,x)+
      (f.eval (width (a:=.prod .bool a) (v,x))+g.eval (width (a:=.prod .bool a) (v,x)))) q x :=
    safe_mono q x (hg O x) ((g.monotone hw).trans (by omega))
  refine ⟨by simp only [SizePolynomial.eval]; omega,?_,?_⟩
  · intro y hy
    cases v
    · exact safe_output hp' hy
    · exact safe_output hq' hy
  · cases v
    · exact hp'
    · exact hq'

@[simp] lemma width_nat (x : ℕ) : width (a:=.nat) x=x.bits.length := rfl
@[simp] lemma width_word (x : Word) : width (a:=.word) x=x.length := rfl
@[simp] lemma width_bool (x : Bool) : width (a:=.bool) x=1 := rfl
@[simp] lemma width_unit (x : Unit) : width (a:=.unit) x=0 := rfl
lemma bits_length_mono {a b : ℕ} (h : a≤b) : a.bits.length≤b.bits.length := by
  simpa only [Nat.size_eq_bits_len] using Nat.size_le_size h
lemma bits_length_le_value (a : ℕ) : a.bits.length≤a := by
  rw [Nat.size_eq_bits_len]
  exact Nat.size_le.mpr a.lt_two_pow_self
lemma bits_length_add (a b : ℕ) : (a+b).bits.length≤a.bits.length+b.bits.length+1 := by
  simp only [Nat.size_eq_bits_len]
  apply Nat.size_le.mpr
  have ha := Nat.lt_size_self a
  have hb := Nat.lt_size_self b
  have hpa : 1≤2^a.size := Nat.one_le_pow _ _ (by decide)
  have hpb : 1≤2^b.size := Nat.one_le_pow _ _ (by decide)
  rw [pow_succ,pow_add]
  nlinarith
lemma bits_length_mul (a b : ℕ) : (a*b).bits.length≤a.bits.length+b.bits.length := by
  simp only [Nat.size_eq_bits_len]
  apply Nat.size_le.mpr
  rw [pow_add]
  calc
    a*b≤(2^a.size)*b := Nat.mul_le_mul_right _ (Nat.lt_size_self a).le
    _ < (2^a.size)*(2^b.size) := Nat.mul_lt_mul_of_pos_left (Nat.lt_size_self b) (by positivity)
lemma bits_length_binaryValue (x : Word) : (binaryValue x).bits.length≤x.length := by
  rw [←normalWord_eq_bits]
  exact normal_length x
lemma width_list_bool (x : Word) : width (a:=.list .bool) x=4*x.length := by
  induction x with
  | nil => rfl
  | cons b xs ih =>
    rw [width_cons (a:=.bool),width_bool,ih,List.length_cons]
    omega
lemma width_list_append {a : DataType} (x y : List (Value a)) :
    width (a:=.list a) (x++y)=width (a:=.list a) x+width (a:=.list a) y := by
  induction x with
  | nil => simp
  | cons z x ih => simp only [List.cons_append,width_cons,ih]; omega
lemma width_list_reverse {a : DataType} (x : List (Value a)) :
    width (a:=.list a) x.reverse=width (a:=.list a) x := by
  induction x with
  | nil => rfl
  | cons z x ih => simp only [List.reverse_cons,width_list_append,width_cons,width_nil,ih]; omega
lemma width_list_member {a : DataType} (x : Value a) (xs : List (Value a)) (h : x∈xs) :
    width x≤width (a:=.list a) xs := by
  induction xs with
  | nil => cases h
  | cons z zs ih =>
    simp only [List.mem_cons] at h
    cases h with
    | inl h => subst x; rw [width_cons]; omega
    | inr h => have hi := ih h; rw [width_cons]; omega

def Atomic : {a b : DataType} → Expression a b → Prop
  | _,_,.compose _ _ | _,_,.both _ _ | _,_,.branch _ _ | _,_,.fold _ => False
  | _,_,_ => True

def constantWidth : {a b : DataType} → Expression a b → ℕ
  | _,_,.constant x => width x
  | _,_,_ => 0
lemma safe_atomic {n S : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression a b) (x : Value a) (ha : Atomic p) (hx : width x≤S)
    (hy : ∀ y,run O p x=some y → width y≤S) : Safe O S p x := by
  cases p <;> first | contradiction | exact ⟨hx,hy,trivial⟩
lemma atomic_width {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression a b) (x : Value a) (ha : Atomic p) (y : Value b) (hy : run O p x=some y) :
    width y≤8*(width x+constantWidth p+1) := by
  cases p with
  | compose | both | branch | fold => contradiction
  | ident => cases hy; simp only [constantWidth]; omega
  | constant z => cases hy; simp only [constantWidth]; omega
  | fst =>
    rcases x with ⟨u,v⟩
    cases hy
    simp only [width_pair,constantWidth]; omega
  | snd =>
    rcases x with ⟨u,v⟩
    cases hy
    simp only [width_pair,constantWidth]; omega
  | @cons a =>
    rcases x with ⟨u,v⟩
    cases hy
    rw [width_pair (a := a) (b := .list a)]
    simp only [width_cons,constantWidth]; omega
  | consBit =>
    rcases x with ⟨u,v⟩
    cases hy
    rw [width_pair (a := .bool) (b := .word)]
    simp only [width_word,List.length_cons,width_bool,constantWidth]; omega
  | append =>
    rcases x with ⟨u,v⟩
    cases hy
    rw [width_pair (a := .word) (b := .word)]
    simp only [width_word,List.length_append,constantWidth]; omega
  | reverse =>
    cases hy
    simp only [width_word,List.length_reverse,constantWidth]; omega
  | toList =>
    cases hy
    rw [width_list_bool]
    simp only [width_word,constantWidth]; omega
  | toBits =>
    cases hy
    simp only [width_word,width_nat,constantWidth]; omega
  | toNat =>
    cases hy
    have h := bits_length_binaryValue x
    simp only [width_word,width_nat,constantWidth]; omega
  | add =>
    rcases x with ⟨u,v⟩
    cases hy
    have h := bits_length_add u v
    rw [width_pair (a := .nat) (b := .nat)]
    simp only [width_nat,constantWidth]; omega
  | mul =>
    rcases x with ⟨u,v⟩
    cases hy
    have h := bits_length_mul u v
    rw [width_pair (a := .nat) (b := .nat)]
    simp only [width_nat,constantWidth]; omega
  | sub =>
    rcases x with ⟨u,v⟩
    simp only [run] at hy
    split_ifs at hy with hv
    · cases hy
      have h := bits_length_mono (Nat.sub_le u v)
      rw [width_pair (a := .nat) (b := .nat)]
      simp only [width_nat,constantWidth]; omega
  | less =>
    simp only [width_bool,constantWidth]; omega
  | divRem =>
    rcases x with ⟨u,v⟩
    simp only [run] at hy
    split_ifs at hy with hv
    · cases hy
      have h₁ := bits_length_mono (Nat.mod_le v u)
      have h₂ := bits_length_mono (Nat.div_le_self v u)
      simp only [width_pair (a := .nat) (b := .nat),width_nat,constantWidth]; omega
  | query b => simp only [width_bool,constantWidth]; omega
  | rank b =>
    simp only [run] at hy
    split_ifs at hy with hx
    · cases hy
      have h₁ := bits_length_binaryValue (rankBits b O x.reverse)
      have h₂ := rankBits_length O b x.reverse
      simp only [List.length_reverse] at h₂
      simp only [width_nat,width_word,constantWidth,rankWord]; omega
lemma controlled_atomic {a b : DataType} (p : Expression a b) (ha : Atomic p) : Controlled p := by
  refine ⟨.mul (.constant 8) (.add (.add .input (.constant (constantWidth p))) (.constant 1)),fun O x => ?_⟩
  apply safe_atomic O p x ha
  · dsimp [SizePolynomial.eval]; omega
  · exact fun y hy => atomic_width O p x ha y hy

lemma foldSafe_prefix {A B : Type*} (ok : A×B → Prop) (f : A×B → Option B)
    (xs : List A) (z : B)
    (h : ∀ pre x post,xs=pre++x::post → ∀ y,foldValue f pre z=some y → ok (x,y)) :
    FoldSafe ok f xs z := by
  induction xs generalizing z with
  | nil => trivial
  | cons x xs ih =>
    refine ⟨h [] x xs rfl z rfl,?_⟩
    intro y hy
    apply ih y
    intro pre a post he w hw
    apply h (x::pre) a post (by simpa using congrArg (List.cons x) he) w
    simp only [foldValue,hy,Option.bind_some]
    exact hw

lemma controlled_fold {a b : DataType} (p : Expression (.prod a b) b)
    (hp : Controlled p) (g : SizePolynomial)
    (hg : ∀ {n : ℕ} (O : IndependenceOracle n) (xs : List (Value a)) (z : Value b)
      (pre post : List (Value a)),xs=pre++post → ∀ y,foldValue (run O p) pre z=some y →
      width y≤g.eval (width (a:=.prod (.list a) b) (xs,z))) :
    Controlled (.fold p) := by
  obtain ⟨f,hf⟩ := hp
  let vP : SizePolynomial := .add (.add (.mul (.constant 2) .input) (.constant 1)) g
  let h : SizePolynomial := .add (.add .input g) (f.subst vP)
  refine ⟨h,fun O x => ?_⟩
  rcases x with ⟨xs,z⟩
  have hS : width (a:=.prod (.list a) b) (xs,z)≤h.eval (width (a:=.prod (.list a) b) (xs,z)) := by
    dsimp [h,SizePolynomial.eval]; omega
  have hgS : g.eval (width (a:=.prod (.list a) b) (xs,z))≤h.eval (width (a:=.prod (.list a) b) (xs,z)) := by
    dsimp [h,SizePolynomial.eval]; omega
  refine ⟨hS,?_,?_⟩
  · intro y hy
    exact (hg O xs z xs [] (by simp) y hy).trans hgS
  · apply foldSafe_prefix
    intro pre v post he y hy
    have hay : width y≤g.eval (width (a:=.prod (.list a) b) (xs,z)) := hg O xs z pre (v::post) he y hy
    have ha : width (a:=a) v≤width (a:=.prod (.list a) b) (xs,z) := by
      have hm : v∈xs := by rw [he]; simp
      have ha := width_list_member v xs hm
      rw [width_pair]; omega
    have hinput : width (a:=.prod a b) (v,y)≤vP.eval (width (a:=.prod (.list a) b) (xs,z)) := by
      rw [width_pair]
      dsimp [vP,SizePolynomial.eval]
      omega
    apply safe_mono p (v,y) (hf O (v,y))
    exact (f.monotone hinput).trans (by
      dsimp only [h,SizePolynomial.eval]
      rw [SizePolynomial.eval_subst]
      omega)

lemma mod_double_lt (a b : ℕ) (hb : 0<b) (hba : b≤a) : 2*(a%b)<a := by
  have hr := Nat.mod_lt a hb
  have hd := Nat.div_pos hba hb
  have hm := Nat.mul_le_mul_left b hd
  have he := Nat.mod_add_div a b
  omega
lemma mod_size_lt (a b : ℕ) (hb : 0<b) (hba : b≤a) : (a%b).size<a.size := by
  have ha : 0<a := lt_of_lt_of_le hb hba
  by_cases hz : a%b=0
  · simpa [hz] using Nat.size_pos.mpr ha
  · have h := Nat.size_le_size (Nat.le_of_lt (mod_double_lt a b hb hba))
    have hs : (2*(a%b)).size=(a%b).size+1 := by
      have he : 2*(a%b)=Nat.bit false (a%b) := by simp [Nat.bit_val]
      rw [he,Nat.size_bit (by simpa [Nat.bit_val] using hz)]
    rw [hs] at h
    omega

def gcdStep (p : ℕ × ℕ) : ℕ × ℕ := if p.2=0 then p else (p.2,p.1%p.2)
def gcdSteps : ℕ → ℕ × ℕ → ℕ × ℕ
  | 0,p => p
  | k+1,p => gcdSteps k (gcdStep p)
lemma gcdSteps_zero (k a : ℕ) : gcdSteps k (a,0)=(a,0) := by
  induction k with
  | zero => rfl
  | succ k ih => simpa [gcdSteps,gcdStep] using ih
lemma gcdSteps_done (k a b : ℕ) (hba : b≤a) (hk : a.size+b.size≤k) :
    gcdSteps k (a,b)=(Nat.gcd a b,0) := by
  induction k generalizing a b with
  | zero =>
    have ha : a=0 := Nat.size_eq_zero.mp (by omega)
    have hb : b=0 := Nat.size_eq_zero.mp (by omega)
    simp [ha,hb,gcdSteps]
  | succ k ih =>
    by_cases hb : b=0
    · subst b; simp [gcdSteps_zero]
    · have hb' := Nat.pos_of_ne_zero hb
      have hl := mod_size_lt a b hb' hba
      have hs := Nat.size_le_size hba
      have hh := ih b (a%b) (Nat.le_of_lt (Nat.mod_lt a hb')) (by omega)
      simp only [gcdSteps,gcdStep,hb,ite_false]
      rw [hh,Nat.gcd_comm b (a%b),←Nat.gcd_rec,Nat.gcd_comm b a]

namespace Expression
abbrev NN := DataType.prod .nat .nat

def sortPair : Expression NN NN := applyIf less ident swap
def gcdStepCode : Expression NN NN :=
  applyIf (snd >>> natEqZero) (both snd (swap >>> natMod)) ident

def gcdCode : Expression NN .nat :=
  sortPair >>> both
    (both (fst >>> toBits) (snd >>> toBits) >>> append >>> toList)
    ident >>> fold (snd >>> gcdStepCode) >>> fst
lemma run_sortPair {n : ℕ} (O : IndependenceOracle n) (a b : ℕ) :
    run O sortPair (a,b)=some (if a<b then (b,a) else (a,b)) := by
  simp only [sortPair,applyIf,swap,run]
  by_cases h : a<b <;> simp [h]
lemma run_gcdStepCode {n : ℕ} (O : IndependenceOracle n) (a b : ℕ) :
    run O gcdStepCode (a,b)=some (gcdStep (a,b)) := by
  by_cases hb : b=0 <;>
    simp [gcdStepCode,applyIf,run,swap,natEqZero,natMod,natDivRem,gcdStep,hb]
lemma fold_gcdStepCode {n : ℕ} (O : IndependenceOracle n) (xs : List Bool) (p : ℕ × ℕ) :
    foldValue (run O (snd (a:=.bool) >>> gcdStepCode)) xs p=some (gcdSteps xs.length p) := by
  induction xs generalizing p with
  | nil => rfl
  | cons b xs ih =>
    rcases p with ⟨a,c⟩
    change ((run O gcdStepCode (a,c)).bind fun p =>
      foldValue (run O (snd (a:=.bool) >>> gcdStepCode)) xs p)=_
    rw [run_gcdStepCode,Option.bind_some,ih]
    rfl
lemma run_gcdCode {n : ℕ} (O : IndependenceOracle n) (a b : ℕ) :
    run O gcdCode (a,b)=some (Nat.gcd a b) := by
  unfold gcdCode
  have hs := run_sortPair O a b
  simp only [run]
  rw [hs]
  simp only [Option.bind_some]
  by_cases hab : a<b
  · simp only [hab,ite_true]
    change ((foldValue (run O (snd (a:=.bool) >>> gcdStepCode)) (b.bits++a.bits) (b,a)).bind
      fun p => some p.1)=some (Nat.gcd a b)
    rw [fold_gcdStepCode]
    simp only [List.length_append,Nat.size_eq_bits_len]
    rw [gcdSteps_done _ _ _ (Nat.le_of_lt hab) (by rfl)]
    simp [Nat.gcd_comm]
  · simp only [hab,ite_false]
    change ((foldValue (run O (snd (a:=.bool) >>> gcdStepCode)) (a.bits++b.bits) (a,b)).bind
      fun p => some p.1)=some (Nat.gcd a b)
    rw [fold_gcdStepCode]
    simp only [List.length_append,Nat.size_eq_bits_len]
    rw [gcdSteps_done _ _ _ (Nat.le_of_not_gt hab) (by rfl)]
    rfl
end Expression

open Expression
syntax "control" : tactic
macro_rules
| `(tactic| control) => `(tactic|
  first
  | assumption
  | apply controlled_compose <;> control
  | apply controlled_both <;> control
  | apply controlled_branch <;> control
  | exact controlled_atomic _ trivial)
lemma controlled_onLeft {a b c : DataType} (p : Expression a b) (hp : Controlled p) :
    Controlled (onLeft (c:=c) p) := by unfold onLeft; control
lemma controlled_onRight {a b c : DataType} (p : Expression a b) (hp : Controlled p) :
    Controlled (onRight (c:=c) p) := by unfold onRight; control
lemma controlled_swap {a b : DataType} : Controlled (Expression.swap (a:=a) (b:=b)) := by unfold Expression.swap; control
lemma controlled_letIn {a b c : DataType} (p : Expression a b) (q : Expression (.prod a b) c)
    (hp : Controlled p) (hq : Controlled q) : Controlled (letIn p q) := by unfold letIn; control
lemma controlled_applyIf {a b : DataType} (p : Expression a .bool) (q r : Expression a b)
    (hp : Controlled p) (hq : Controlled q) (hr : Controlled r) : Controlled (applyIf p q r) := by
  unfold applyIf; control
lemma controlled_boolNot : Controlled boolNot := by unfold boolNot; control
lemma controlled_boolAnd : Controlled boolAnd := by unfold boolAnd; control
lemma controlled_natEqZero : Controlled natEqZero := by unfold natEqZero; control
lemma controlled_natSub : Controlled natSub := by unfold natSub; control
lemma controlled_natDivRem : Controlled natDivRem := by unfold natDivRem; control
lemma controlled_natDiv : Controlled natDiv := by unfold natDiv; control
lemma controlled_natMod : Controlled natMod := by unfold natMod; control
lemma controlled_listReverse {a : DataType} : Controlled (listReverse (a:=a)) := by
  unfold listReverse
  apply controlled_compose
  · control
  · apply controlled_fold _ (controlled_atomic (cons (a:=a)) trivial) (.mul (.constant 2) .input)
    intro n O xs z pre post he y hy
    have hh := foldValue_eq_foldl (run O (cons (a:=a))) (fun z x => x::z) (fun _ _ => rfl) pre z
    rw [hh] at hy
    cases hy
    rw [List.foldl_flip_cons_eq_append',width_list_append,width_list_reverse]
    have hp : width (a:=.list a) pre≤width (a:=.list a) xs := by rw [he,width_list_append]; omega
    rw [width_pair (a:=.list a) (b:=.list a)]
    dsimp [SizePolynomial.eval]
    omega
lemma foldl_succ {A : Type*} (l : List A) (z : ℕ) : l.foldl (fun z _ => z+1) z=z+l.length := by
  induction l generalizing z with
  | nil => simp
  | cons x xs ih => simp only [List.foldl_cons,ih,List.length_cons]; omega
lemma controlled_listLength {a : DataType} : Controlled (listLength (a:=a)) := by
  unfold listLength
  apply controlled_compose
  · control
  · apply controlled_fold _ (by control) (.mul (.constant 2) .input)
    intro n O xs z pre post he y hy
    have hh := foldValue_eq_foldl (run O (both (snd (a:=a)) (constant 1) >>> Expression.add)) (fun z (_ : Value a) => z+1) (fun _ _ => rfl) pre z
    rw [hh] at hy
    cases hy
    have hv := foldl_succ pre z
    rw [hv,width_nat]
    have hbits := bits_length_add z pre.length
    have hlen := bits_length_le_value pre.length
    have hx := list_length_le_width xs
    have hp : pre.length≤xs.length := by rw [he,List.length_append]; omega
    rw [width_pair (a:=.list a) (b:=.nat),width_nat]
    dsimp [SizePolynomial.eval]
    omega
lemma controlled_wordLength : Controlled wordLength := by
  exact controlled_compose _ _ (controlled_atomic _ trivial) controlled_listLength
lemma gcdSteps_max (k a b : ℕ) : (gcdSteps k (a,b)).1≤ max a b ∧ (gcdSteps k (a,b)).2≤ max a b := by
  induction k generalizing a b with
  | zero => exact ⟨Nat.le_max_left _ _,Nat.le_max_right _ _⟩
  | succ k ih =>
    by_cases hb : b=0
    · simpa [hb,gcdStep,gcdSteps] using ih a 0
    · have hi := ih b (a%b)
      have hle : max b (a%b)≤ max a b := max_le (Nat.le_max_right _ _) ((Nat.mod_le _ _).trans (Nat.le_max_left _ _))
      simpa [gcdSteps,gcdStep,hb] using And.intro (hi.1.trans hle) (hi.2.trans hle)
lemma controlled_gcdStep : Controlled gcdStepCode := by unfold gcdStepCode; control
lemma controlled_gcd : Controlled gcdCode := by
  unfold gcdCode
  apply controlled_compose
  · control
  · apply controlled_compose
    · control
    · apply controlled_compose
      · apply controlled_fold _ (by control) (.mul (.constant 4) .input)
        intro n O xs z pre post he y hy
        rcases z with ⟨a,b⟩
        rw [fold_gcdStepCode] at hy
        cases hy
        have hh := gcdSteps_max pre.length a b
        have h₁ := bits_length_mono hh.1
        have h₂ := bits_length_mono hh.2
        have hm : (max a b).bits.length≤a.bits.length+b.bits.length := by
          rcases le_total a b with h|h
          · rw [max_eq_right h]; omega
          · rw [max_eq_left h]; omega
        rw [width_pair (a:=.nat) (b:=.nat),width_pair (a:=.list .bool) (b:=.prod .nat .nat),
          width_pair (a:=.nat) (b:=.nat)]
        simp only [width_nat,SizePolynomial.eval]
        omega
      · control

open Expression

def PolySafe {a b : DataType} (p : Expression a b) (R : ℕ → Value a → Prop) : Prop :=
  ∃ f : SizePolynomial,∀ {n : ℕ} (O : IndependenceOracle n) (S : ℕ) (x : Value a),
    R S x → Safe O (f.eval S) p x
lemma polySafe_of_controlled {a b : DataType} (p : Expression a b) (hp : Controlled p)
    (R : ℕ → Value a → Prop) (g : SizePolynomial) (hg : ∀ S x,R S x → width x≤g.eval S) :
    PolySafe p R := by
  obtain ⟨f,hf⟩ := hp
  refine ⟨f.subst g,fun O S x hx => ?_⟩
  apply safe_mono p x (hf O x)
  rw [SizePolynomial.eval_subst]
  exact f.monotone (hg S x hx)
lemma polySafe_mono {a b : DataType} (p : Expression a b) {R Q : ℕ → Value a → Prop}
    (hp : PolySafe p Q) (h : ∀ S x,R S x → Q S x) : PolySafe p R := by
  obtain ⟨f,hf⟩ := hp
  exact ⟨f,fun O S x hx => hf O S x (h S x hx)⟩
lemma polySafe_compose {a b c : DataType} (p : Expression a b) (q : Expression b c)
    (R : ℕ → Value a → Prop) (Q : ℕ → Value b → Prop)
    (hp : PolySafe p R) (hq : PolySafe q Q)
    (h : ∀ {n : ℕ} (O : IndependenceOracle n) S x,R S x → ∀ y,run O p x=some y → Q S y) :
    PolySafe (p >>> q) R := by
  obtain ⟨f,hf⟩ := hp
  obtain ⟨g,hg⟩ := hq
  refine ⟨.add f g,fun O S x hx => ?_⟩
  apply safe_compose O p q x
  · exact safe_mono p x (hf O S x hx) (Nat.le_add_right _ _)
  · intro y hy
    exact safe_mono q y (hg O S y (h O S x hx y hy)) (Nat.le_add_left _ _)
lemma polySafe_both {a b c : DataType} (p : Expression a b) (q : Expression a c)
    (R : ℕ → Value a → Prop) (hp : PolySafe p R) (hq : PolySafe q R) :
    PolySafe (.both p q) R := by
  obtain ⟨f,hf⟩ := hp
  obtain ⟨g,hg⟩ := hq
  refine ⟨.add (.mul (.constant 3) (.add f g)) (.constant 1),fun O S x hx => ?_⟩
  apply safe_both O p q x
  · exact safe_mono p x (hf O S x hx) (Nat.le_add_right _ _)
  · exact safe_mono q x (hg O S x hx) (Nat.le_add_left _ _)
lemma polySafe_fold {a b : DataType} (p : Expression (.prod a b) b)
    (R : ℕ → Value (.prod (.list a) b) → Prop) (Q : ℕ → Value (.prod a b) → Prop)
    (hp : PolySafe p Q) (g : SizePolynomial)
    (hinput : ∀ S x,R S x → width x≤g.eval S)
    (hacc : ∀ {n : ℕ} (O : IndependenceOracle n) S xs z,R S (xs,z) →
      ∀ pre post,xs=pre++post → ∀ y,foldValue (run O p) pre z=some y → width y≤g.eval S)
    (hstep : ∀ {n : ℕ} (O : IndependenceOracle n) S xs z,R S (xs,z) →
      ∀ pre x post,xs=pre++x::post → ∀ y,foldValue (run O p) pre z=some y → Q S (x,y)) :
    PolySafe (.fold p) R := by
  obtain ⟨f,hf⟩ := hp
  refine ⟨.add f g,fun O S x hx => ?_⟩
  obtain ⟨xs,z⟩ := x
  refine ⟨(hinput S (xs,z) hx).trans (Nat.le_add_left _ _),?_,?_⟩
  · intro y hy
    exact (hacc O S xs z hx xs [] (by simp) y hy).trans (Nat.le_add_left _ _)
  · apply foldSafe_prefix
    intro pre x post he y hy
    exact safe_mono p (x,y) (hf O S (x,y) (hstep O S xs z hx pre x post he y hy))
      (Nat.le_add_right _ _)
lemma polySafe_controlled {a b : DataType} (p : Expression a b)
    (hp : PolySafe p (fun S x => width x≤S)) : Controlled p := by
  obtain ⟨f,hf⟩ := hp
  exact ⟨f,fun O x => hf O (width x) x le_rfl⟩

lemma run_mapStep_partial {n : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression (.prod a c) b) (x : Value a) (zs : List (Value b)) (ctx : Value c) :
    run O (mapStep p) (x,(zs,ctx))=(run O p (x,ctx)).map (fun v => (v::zs,ctx)) := by
  simp only [mapStep,run,bind_pure_comp,Option.bind_some]
  cases he : run O p (x,ctx) <;> simp [he]
lemma fold_mapStep_bound {n : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression (.prod a c) b) (xs : List (Value a)) (zs : List (Value b)) (ctx : Value c)
    (U : ℕ) (hu : ∀ x∈xs,∀ v,run O p (x,ctx)=some v → width v≤U)
    (y : Value (.prod (.list b) c)) (hy : foldValue (run O (mapStep p)) xs (zs,ctx)=some y) :
    width (a:=.list b) y.1≤width (a:=.list b) zs+xs.length*(2*U+2) ∧ y.2=ctx := by
  induction xs generalizing zs with
  | nil => cases hy; simp
  | cons x xs ih =>
    rw [foldValue,run_mapStep_partial] at hy
    cases he : run O p (x,ctx) with
    | none => simp [he] at hy
    | some v =>
      simp only [he,Option.map_some,Option.bind_some] at hy
      have hv := hu x (by simp) v he
      have hh := ih (v::zs) (fun x hx => hu x (by simp [hx])) hy
      rw [width_cons] at hh
      refine ⟨?_,hh.2⟩
      simp only [List.length_cons,Nat.add_mul,Nat.one_mul]
      omega
lemma controlled_mapStep {a b c : DataType} (p : Expression (.prod a c) b) (hp : Controlled p) :
    Controlled (mapStep p) := by unfold mapStep; control
lemma controlled_mapFold {a b c : DataType} (p : Expression (.prod a c) b) (hp : Controlled p) :
    Controlled (.fold (mapStep p)) := by
  obtain ⟨f,hf⟩ := hp
  let s : SizePolynomial := .add (.mul (.constant 3) .input) (.constant 1)
  let g : SizePolynomial := .mul (.add (.mul (.constant 4) .input) (.constant 3))
    (.add (.mul (.constant 2) (f.subst s)) (.constant 3))
  apply controlled_fold _ (controlled_mapStep p ⟨f,hf⟩) g
  intro n O xs z pre post he y hy
  rcases z with ⟨zs,ctx⟩
  let W := width (a:=.prod (.list a) (.prod (.list b) c)) (xs,(zs,ctx))
  have hx : width (a:=.list a) xs≤W := by dsimp [W]; rw [width_pair (a:=.list a) (b:=.prod (.list b) c)]; omega
  have hzs : width (a:=.list b) zs≤W := by dsimp [W]; rw [width_pair (a:=.list a) (b:=.prod (.list b) c),width_pair (a:=.list b) (b:=c)]; omega
  have hc : width ctx≤W := by dsimp [W]; rw [width_pair (a:=.list a) (b:=.prod (.list b) c),width_pair (a:=.list b) (b:=c)]; omega
  have hl : pre.length≤W := by
    have hh := list_length_le_width xs
    have he' := congrArg List.length he
    simp only [List.length_append] at he'
    omega
  let U := f.eval (3*W+1)
  have hh := fold_mapStep_bound O p pre zs ctx U (by
    intro x hxp v hv
    have hxx : x∈xs := by rw [he]; exact List.mem_append_left post hxp
    have hxb := (width_list_member x xs hxx).trans hx
    apply (safe_output (hf O (x,ctx)) hv).trans
    apply f.monotone
    rw [width_pair (a:=a) (b:=c)]
    omega) y hy
  have hm := Nat.mul_le_mul_right (2*U+2) hl
  have hy' : width (a:=.list b) y.1≤W+W*(2*U+2) := by omega
  change width y≤g.eval W
  have hw : width y=2*width (a:=.list b) y.1+1+width ctx := by
    obtain ⟨ys,vctx⟩ := y
    change width (a:=.prod (.list b) c) (ys,vctx)=2*width (a:=.list b) ys+1+width ctx
    rw [width_pair,show vctx=ctx from hh.2]
  rw [hw]
  simp only [g,SizePolynomial.eval,SizePolynomial.eval_subst]
  change _≤(4*W+3)*(2*U+3)
  nlinarith
lemma controlled_mapWith {a b c : DataType} (p : Expression (.prod a c) b) (hp : Controlled p) :
    Controlled (mapWith p) := by
  unfold mapWith
  apply controlled_compose
  · control
  · apply controlled_compose
    · exact controlled_mapFold p hp
    · apply controlled_compose
      · control
      · exact controlled_listReverse

def rationalPair (q : ℚ) : ℕ × ℕ := (q.num.natAbs,q.den)
def normalizePair (a b : ℕ) : ℕ × ℕ :=
  if b=0 then (0,1) else (a/Nat.gcd a b,b/Nat.gcd a b)
lemma rationalPair_div (a b : ℕ) : rationalPair ((a:ℚ)/(b:ℚ))=normalizePair a b := by
  have he : (a:ℚ)/(b:ℚ)=mkRat (a:ℤ) b := by
    simp only [Rat.mkRat_eq_divInt,Rat.divInt_eq_div,Int.cast_natCast]
  rw [he]
  by_cases hb : b=0 <;>
    simp [rationalPair,normalizePair,Rat.num_mkRat,Rat.den_mkRat,hb,Nat.gcd_comm,Int.natAbs_ediv_of_nonneg]
lemma rationalPair_value {q : ℚ} (hq : 0≤q) :
    ((rationalPair q).1:ℚ)/((rationalPair q).2:ℚ)=q := by
  dsimp [rationalPair]
  have hnum : 0≤q.num := Rat.num_nonneg.mpr hq
  have he : (q.num.natAbs:ℚ)=(q.num:ℚ) := by
    have hnat : (q.num.natAbs:ℤ)=q.num := Int.natAbs_of_nonneg hnum
    simpa only [Int.cast_natCast] using congrArg (fun z : ℤ => (z:ℚ)) hnat
  rw [he]
  exact Rat.num_div_den q
lemma rationalPair_den (q : ℚ) : 0<(rationalPair q).2 := q.den_pos

namespace Expression
lemma run_applyIf {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression a .bool) (q r : Expression a b) (x : Value a) :
    run O (applyIf p q r) x=(run O p x).bind (fun t => if t then run O r x else run O q x) := by
  simp [applyIf,run,Option.bind_assoc]
lemma run_letIn {n : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression a b) (q : Expression (.prod a b) c) (x : Value a) :
    run O (letIn p q) x=(run O p x).bind (fun y => run O q (x,y)) := by
  simp [letIn,run,Option.bind_assoc]

def normalizeRat : Expression NN NN := applyIf (snd >>> natEqZero)
  (letIn gcdCode (both
    (both snd (fst >>> fst) >>> natDiv)
    (both snd (fst >>> snd) >>> natDiv)))
  (constant (0,1))

def ratCross : Expression (.prod NN NN) NN := both
  (both (fst >>> fst) (snd >>> snd) >>> mul)
  (both (snd >>> fst) (fst >>> snd) >>> mul)
def ratAdd : Expression (.prod NN NN) NN :=
  both (ratCross >>> add) (both (fst >>> snd) (snd >>> snd) >>> mul) >>> normalizeRat
def ratMul : Expression (.prod NN NN) NN :=
  both (both (fst >>> fst) (snd >>> fst) >>> mul)
       (both (fst >>> snd) (snd >>> snd) >>> mul) >>> normalizeRat
def ratDiv : Expression (.prod NN NN) NN := ratCross >>> normalizeRat
def ratLess : Expression (.prod NN NN) .bool := ratCross >>> less

def ratMinOne : Expression NN NN := applyIf (swap >>> less) ident (constant (1,1))

lemma run_normalizeRat {n : ℕ} (O : IndependenceOracle n) (a b : ℕ) :
    run O normalizeRat (a,b)=some (normalizePair a b) := by
  rw [normalizeRat,run_applyIf]
  change ((run O natEqZero b).bind fun t => if t then some (0,1) else _)=_
  rw [run_natEqZero]
  by_cases hb : b=0
  · simp [hb,normalizePair]
  · simp only [hb,decide_false,Option.bind_some,Bool.false_eq_true,ite_false]
    rw [run_letIn,run_gcdCode]
    change (do
      let x ← run O natDiv (Nat.gcd a b,a)
      let y ← run O natDiv (Nat.gcd a b,b)
      pure (x,y))=some (normalizePair a b)
    rw [run_natDiv O _ _,run_natDiv O _ _]
    simp [normalizePair,hb]
lemma run_normalizeRat_pair {n : ℕ} (O : IndependenceOracle n) (a b : ℕ) :
    run O normalizeRat (a,b)=some (rationalPair ((a:ℚ)/(b:ℚ))) := by
  rw [rationalPair_div]
  exact run_normalizeRat O a b
lemma run_ratCross {n : ℕ} (O : IndependenceOracle n) (a b c d : ℕ) :
    run O ratCross ((a,b),(c,d))=some (a*d,c*b) := rfl
lemma run_ratAdd_raw {n : ℕ} (O : IndependenceOracle n) (a b c d : ℕ) :
    run O ratAdd ((a,b),(c,d))=some (normalizePair (a*d+c*b) (b*d)) := by
  change run O normalizeRat (a*d+c*b,b*d)=_
  exact run_normalizeRat O _ _
lemma run_ratMul_raw {n : ℕ} (O : IndependenceOracle n) (a b c d : ℕ) :
    run O ratMul ((a,b),(c,d))=some (normalizePair (a*c) (b*d)) := by
  change run O normalizeRat (a*c,b*d)=_
  exact run_normalizeRat O _ _
lemma run_ratDiv_raw {n : ℕ} (O : IndependenceOracle n) (a b c d : ℕ) :
    run O ratDiv ((a,b),(c,d))=some (normalizePair (a*d) (c*b)) := by
  change run O normalizeRat (a*d,c*b)=_
  exact run_normalizeRat O _ _
lemma run_ratAdd {n : ℕ} (O : IndependenceOracle n) (q r : ℚ) (hq : 0≤q) (hr : 0≤r) :
    run O ratAdd (rationalPair q,rationalPair r)=some (rationalPair (q+r)) := by
  rw [run_ratAdd_raw,←rationalPair_div]
  congr 2
  conv_rhs => rw [←rationalPair_value hq,←rationalPair_value hr]
  push_cast
  have hb : (rationalPair q).2 ≠ 0 := (rationalPair_den q).ne'
  have hd : (rationalPair r).2 ≠ 0 := (rationalPair_den r).ne'
  field_simp
lemma run_ratMul {n : ℕ} (O : IndependenceOracle n) (q r : ℚ) (hq : 0≤q) (hr : 0≤r) :
    run O ratMul (rationalPair q,rationalPair r)=some (rationalPair (q*r)) := by
  rw [run_ratMul_raw,←rationalPair_div]
  congr 2
  conv_rhs => rw [←rationalPair_value hq,←rationalPair_value hr]
  push_cast
  ring
lemma run_ratDiv {n : ℕ} (O : IndependenceOracle n) (q r : ℚ) (hq : 0≤q) (hr : 0≤r) :
    run O ratDiv (rationalPair q,rationalPair r)=some (rationalPair (q/r)) := by
  rw [run_ratDiv_raw,←rationalPair_div]
  congr 2
  conv_rhs => rw [←rationalPair_value hq,←rationalPair_value hr]
  push_cast
  simp only [div_eq_mul_inv,mul_inv_rev,inv_inv]
  ring
lemma run_ratLess {n : ℕ} (O : IndependenceOracle n) (q r : ℚ) (hq : 0≤q) (hr : 0≤r) :
    run O ratLess (rationalPair q,rationalPair r)=some (decide (q<r)) := by
  change some (decide ((rationalPair q).1*(rationalPair r).2 <
    (rationalPair r).1*(rationalPair q).2))=some (decide (q<r))
  congr 2
  conv_rhs => rw [←rationalPair_value hq,←rationalPair_value hr]
  have hb : (0:ℚ)<(rationalPair q).2 := by exact_mod_cast rationalPair_den q
  have hd : (0:ℚ)<(rationalPair r).2 := by exact_mod_cast rationalPair_den r
  rw [div_lt_div_iff₀ hb hd]
  norm_cast
lemma run_ratMinOne {n : ℕ} (O : IndependenceOracle n) (q : ℚ) (hq : 0≤q) :
    run O ratMinOne (rationalPair q)=some (rationalPair (min 1 q)) := by
  have hv := rationalPair_value hq
  have hd : (0:ℚ)<(rationalPair q).2 := by exact_mod_cast rationalPair_den q
  have hcmp : (rationalPair q).2<(rationalPair q).1 ↔ (1:ℚ)<q := by
    conv_rhs => rw [←hv,lt_div_iff₀ hd,one_mul]
    norm_cast
  by_cases h : 1<q
  · have he := hcmp.mpr h
    simp only [ratMinOne,run_applyIf]
    change (if decide ((rationalPair q).2 < (rationalPair q).1) then some (1,1) else some (rationalPair q))=_
    rw [ite_eq_left (by simpa using he),min_eq_left (le_of_lt h)]
    rfl
  · have he : ¬(rationalPair q).2<(rationalPair q).1 := mt hcmp.mp h
    simp only [ratMinOne,run_applyIf]
    change (if decide ((rationalPair q).2 < (rationalPair q).1) then some (1,1) else some (rationalPair q))=_
    rw [ite_eq_right (by simpa using he),min_eq_right (le_of_not_gt h)]

def iterateWord {a : DataType} (p : Expression a a) : Expression (.prod .word a) a :=
  onLeft toList >>> fold (snd >>> p)
def iterateNat {a : DataType} (p : Expression a a) : Expression (.prod .nat a) a :=
  onLeft unary >>> iterateWord p

def fromList : Expression (.list .bool) .word :=
  both (listReverse) (constant []) >>> fold consBit

lemma foldValue_iterate {n : ℕ} (O : IndependenceOracle n) {a : DataType} (p : Expression a a)
    (f : Value a → Value a) (hp : ∀ x,run O p x=some (f x)) (xs : List Bool) (z : Value a) :
    foldValue (run O (snd (a:=.bool) >>> p)) xs z=some ((f^[xs.length]) z) := by
  induction xs generalizing z with
  | nil => rfl
  | cons b xs ih =>
    change ((run O p z).bind fun y => foldValue (run O (snd (a:=.bool) >>> p)) xs y)=_
    rw [hp,Option.bind_some,ih]
    rfl
lemma run_iterateWord {n : ℕ} (O : IndependenceOracle n) {a : DataType} (p : Expression a a)
    (f : Value a → Value a) (hp : ∀ x,run O p x=some (f x)) (w : Word) (z : Value a) :
    run O (iterateWord p) (w,z)=some ((f^[w.length]) z) := by
  change foldValue (run O (snd (a:=.bool) >>> p)) w z=_
  exact foldValue_iterate O p f hp w z
lemma run_iterateNat {n : ℕ} (O : IndependenceOracle n) {a : DataType} (p : Expression a a)
    (f : Value a → Value a) (hp : ∀ x,run O p x=some (f x)) (k : ℕ) (z : Value a) :
    run O (iterateNat p) (k,z)=some ((f^[k]) z) := by
  obtain ⟨w,hw,hlen⟩ := run_unary O k
  simp only [iterateNat,onLeft,run,Option.bind_some]
  rw [hw]
  change run O (iterateWord p) (w,z)=_
  rw [run_iterateWord O p f hp,hlen]
lemma run_fromList {n : ℕ} (O : IndependenceOracle n) (xs : List Bool) :
    run O fromList xs=some xs := by
  simp only [fromList,run]
  rw [run_listReverse]
  change foldValue (run O consBit) xs.reverse []=some xs
  have hh := foldValue_eq_foldl (run O consBit) (fun z x => x::z) (fun _ _ => rfl) xs.reverse []
  simpa using hh

def rangeStepCode : Expression (.prod .nat (.list .nat)) (.prod .nat (.list .nat)) :=
  both (both fst (constant 1) >>> add) (both fst snd >>> cons)
def rangeCode : Expression .nat (.list .nat) :=
  both ident (constant (0,[])) >>> iterateNat rangeStepCode >>> snd >>> listReverse

def rangeStep (p : ℕ × List ℕ) : ℕ × List ℕ := (p.1+1,p.1::p.2)
lemma rangeStep_iterate (k : ℕ) : (rangeStep^[k]) (0,[])=(k,(List.range k).reverse) := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Function.iterate_succ_apply',ih]; simp [rangeStep,List.range_succ]
lemma run_rangeCode {n : ℕ} (O : IndependenceOracle n) (k : ℕ) :
    run O rangeCode k=some (List.range k) := by
  have hh := run_iterateNat O rangeStepCode rangeStep (fun _ => rfl) k (0,[])
  change ((run O (iterateNat rangeStepCode) (k,(0,[]))).bind fun p => run O listReverse p.2)=_
  rw [hh,rangeStep_iterate,Option.bind_some,run_listReverse,List.reverse_reverse]

abbrev SplitState (a : DataType) := DataType.prod .nat (.prod (.list a) (.list a))
def splitStep {a : DataType} : Expression (.prod a (SplitState a)) (SplitState a) :=
  applyIf (snd >>> fst >>> natEqZero)
    (both (both (snd >>> fst) (constant 1) >>> natSub)
      (both (both fst (snd >>> snd >>> fst) >>> cons) (snd >>> snd >>> snd)))
    (both (snd >>> fst)
      (both (snd >>> snd >>> fst) (both fst (snd >>> snd >>> snd) >>> cons)))
def splitAtCode {a : DataType} : Expression (.prod (.list a) .nat) (.prod (.list a) (.list a)) :=
  both fst (both snd (constant ([],[]))) >>> fold splitStep >>> snd >>>
    both (fst >>> listReverse) (snd >>> listReverse)
def takeCode {a : DataType} : Expression (.prod (.list a) .nat) (.list a) := splitAtCode >>> fst
def dropCode {a : DataType} : Expression (.prod (.list a) .nat) (.list a) := splitAtCode >>> snd

def splitStepValue {a : DataType} (p : Value a × (ℕ × (List (Value a) × List (Value a)))) :=
  if p.2.1=0 then (0,(p.2.2.1,p.1::p.2.2.2)) else (p.2.1-1,(p.1::p.2.2.1,p.2.2.2))
lemma run_splitStep {n : ℕ} (O : IndependenceOracle n) {a : DataType} (x : Value a)
    (k : ℕ) (u v : List (Value a)) : run O splitStep (x,(k,(u,v)))=some (splitStepValue (x,(k,(u,v)))) := by
  rw [splitStep,run_applyIf]
  change ((run O natEqZero k).bind fun t => if t then _ else _)=_
  rw [run_natEqZero]
  by_cases hk : k=0
  · subst k; rfl
  · simp only [hk,decide_false,Option.bind_some,Bool.false_eq_true,ite_false]
    change ((run O natSub (k,1)).bind fun j => some (j,(x::u,v)))=_
    rw [run_natSub]
    simp [splitStepValue,hk]
lemma fold_splitStep {n : ℕ} (O : IndependenceOracle n) {a : DataType} (xs : List (Value a))
    (k : ℕ) (u v : List (Value a)) :
    foldValue (run O splitStep) xs (k,(u,v))=
      some (k-xs.length,((xs.take k).reverse++u,(xs.drop k).reverse++v)) := by
  induction xs generalizing k u v with
  | nil => simp [foldValue]
  | cons x xs ih =>
    rw [foldValue,run_splitStep]
    cases k with
    | zero => simpa [splitStepValue,List.append_assoc] using ih 0 u (x::v)
    | succ k => simpa [splitStepValue,List.append_assoc] using ih k (x::u) v
lemma run_splitAtCode {n : ℕ} (O : IndependenceOracle n) {a : DataType} (xs : List (Value a)) (k : ℕ) :
    run O splitAtCode (xs,k)=some (xs.take k,xs.drop k) := by
  change ((foldValue (run O splitStep) xs (k,([],[]))).bind fun p => do
    let x ← run O listReverse p.2.1
    let y ← run O listReverse p.2.2
    pure (x,y))=_
  rw [fold_splitStep]
  simp only [List.append_nil,Option.bind_some]
  rw [run_listReverse,run_listReverse]
  simp
lemma run_takeCode {n : ℕ} (O : IndependenceOracle n) {a : DataType} (xs : List (Value a)) (k : ℕ) :
    run O takeCode (xs,k)=some (xs.take k) := by
  change ((run O splitAtCode (xs,k)).bind fun p => some p.1)=_
  rw [run_splitAtCode]; rfl
lemma run_dropCode {n : ℕ} (O : IndependenceOracle n) {a : DataType} (xs : List (Value a)) (k : ℕ) :
    run O dropCode (xs,k)=some (xs.drop k) := by
  change ((run O splitAtCode (xs,k)).bind fun p => some p.2)=_
  rw [run_splitAtCode]; rfl

lemma run_compose {n : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression a b) (q : Expression b c) (x : Value a) :
    run O (p >>> q) x=(run O p x).bind (run O q) := rfl
lemma run_both {n : ℕ} (O : IndependenceOracle n) {a b c : DataType}
    (p : Expression a b) (q : Expression a c) (x : Value a) :
    run O (both p q) x=(run O p x).bind (fun y => (run O q x).map (fun z => (y,z))) := by
  simp only [run]
  congr 1
  funext y
  cases run O q x <;> rfl

def headD {a} : Expression (.prod (.list a) a) a := onLeft listReverse >>> fold fst
def getDCode {a} : Expression (.prod (.prod (.list a) .nat) a) a :=
  both (fst >>> dropCode) snd >>> headD

def boolOr : Expression (.prod .bool .bool) .bool := branch ident (constant true)
def natEqual : Expression NN .bool := both less (swap >>> less) >>> boolOr >>> boolNot

def listAll : Expression (.list .bool) .bool := both ident (constant true) >>> fold boolAnd

def filterStep {a b} (p : Expression (.prod a b) .bool) :
    Expression (.prod a (.prod (.list a) b)) (.prod (.list a) b) :=
  both (applyIf (both fst (snd >>> snd) >>> p) (snd >>> fst)
    (both fst (snd >>> fst) >>> cons)) (snd >>> snd)
def filterWith {a b} (p : Expression (.prod a b) .bool) :
    Expression (.prod (.list a) b) (.list a) :=
  both fst (both (constant []) snd) >>> fold (filterStep p) >>> fst >>> listReverse

def foldLast {A : Type*} : List A → A → A
  | [],d => d
  | x::xs,_ => foldLast xs x
lemma foldLast_append {A : Type*} (xs ys : List A) (d : A) :
    foldLast (xs++ys) d=foldLast ys (foldLast xs d) := by
  induction xs generalizing d with
  | nil => rfl
  | cons x xs ih => exact ih x
lemma foldLast_reverse {A : Type*} (xs : List A) (d : A) :
    foldLast xs.reverse d=xs.headD d := by
  cases xs with
  | nil => rfl
  | cons x xs => simp [List.reverse_cons,foldLast_append,foldLast]
lemma run_headD {n : ℕ} (O : IndependenceOracle n) {a} (xs : List (Value a)) (d : Value a) :
    run O headD (xs,d)=some (xs.headD d) := by
  have hf : ∀ (ys : List (Value a)) (z : Value a),
      foldValue (run O (fst (b:=a))) ys z=some (foldLast ys z) := by
    intro ys
    induction ys with
    | nil => intro z; rfl
    | cons y ys ih => intro z; exact ih y
  simp only [headD,onLeft,run,run_listReverse]
  change foldValue (run O (fst (b:=a))) xs.reverse d=_
  rw [hf,foldLast_reverse]
lemma run_getDCode {n : ℕ} (O : IndependenceOracle n) {a} (xs : List (Value a)) (k : ℕ) (d : Value a) :
    run O getDCode ((xs,k),d)=some (xs.getD k d) := by
  simp [getDCode,run]
  rw [run_dropCode O xs k]
  change run O headD (xs.drop k,d)=_
  rw [run_headD]
  congr 1
  induction k generalizing xs with
  | zero => cases xs <;> rfl
  | succ k ih => cases xs with
    | nil => rfl
    | cons x xs => exact ih xs
lemma run_boolOr {n : ℕ} (O : IndependenceOracle n) (x y : Bool) :
    run O boolOr (x,y)=some (x||y) := by cases x <;> rfl
lemma run_natEqual {n : ℕ} (O : IndependenceOracle n) (x y : ℕ) :
    run O natEqual (x,y)=some (decide (x=y)) := by
  simp [natEqual,run,swap]
  rw [run_boolOr]
  simp only [Option.bind_some]
  congr 1
  by_cases h : x=y
  · subst y; simp
  · have hn : x<y ∨ y<x := by omega
    rcases hn with hh|hh <;> simp [h,hh]
lemma run_listAll {n : ℕ} (O : IndependenceOracle n) (xs : List Bool) :
    run O listAll xs=some (xs.all id) := by
  have hf : ∀ (ys : List Bool) (z : Bool),
      foldValue (run O boolAnd) ys z=some (z && ys.all id) := by
    intro ys
    induction ys with
    | nil => intro z; cases z <;> rfl
    | cons y ys ih =>
      intro z
      change ((run O boolAnd (y,z)).bind (foldValue (run O boolAnd) ys))=_
      rw [run_boolAnd,Option.bind_some,ih]
      cases z <;> cases y <;> simp
  change foldValue (run O boolAnd) xs true=_
  simpa using hf xs true
lemma run_filterStep {n : ℕ} (O : IndependenceOracle n) {a b} (p : Expression (.prod a b) .bool)
    (f : Value a → Value b → Bool) (hp : ∀ x z,run O p (x,z)=some (f x z))
    (x : Value a) (ys : List (Value a)) (z : Value b) :
    run O (filterStep p) (x,(ys,z))=some ((if f x z then x::ys else ys),z) := by
  simp only [filterStep,run_both,run_applyIf]
  change ((run O p (x,z)).bind fun t => if t then some (x::ys) else some ys).bind
    (fun v => (some z).map (fun w => (v,w)))=_
  rw [hp]
  cases f x z <;> rfl
lemma run_filterWith {n : ℕ} (O : IndependenceOracle n) {a b} (p : Expression (.prod a b) .bool)
    (f : Value a → Value b → Bool) (hp : ∀ x z,run O p (x,z)=some (f x z))
    (xs : List (Value a)) (z : Value b) :
    run O (filterWith p) (xs,z)=some (xs.filter (fun x => f x z)) := by
  have hf : ∀ (ys acc : List (Value a)),
      foldValue (run O (filterStep p)) ys (acc,z)=some ((ys.filter (fun x => f x z)).reverse++acc,z) := by
    intro ys
    induction ys with
    | nil => intro acc; rfl
    | cons y ys ih =>
      intro acc
      rw [foldValue,run_filterStep O p f hp,Option.bind_some]
      cases h : f y z <;> simp [h,ih,List.append_assoc]
  change ((foldValue (run O (filterStep p)) xs ([],z)).bind fun yz => run O listReverse yz.1)=_
  rw [hf]
  change run O listReverse ((xs.filter (fun x => f x z)).reverse++[])=_
  rw [List.append_nil,run_listReverse,List.reverse_reverse]

def powStepCode : Expression (.prod .nat .nat) (.prod .nat .nat) := both fst mul
def powCode : Expression NN .nat :=
  both snd (both fst (constant 1)) >>> iterateNat powStepCode >>> snd
lemma run_powCode {n : ℕ} (O : IndependenceOracle n) (a k : ℕ) :
    run O powCode (a,k)=some (a^k) := by
  let f : ℕ×ℕ → ℕ×ℕ := fun z => (z.1,z.1*z.2)
  have hi : ∀ j v,(f^[j]) (a,v)=(a,a^j*v) := by
    intro j
    induction j with
    | zero => intro v; simp [f]
    | succ j ih => intro v; rw [Function.iterate_succ_apply',ih]; simp [f,pow_succ]; ring
  have hh := run_iterateNat O powStepCode f (fun _ => rfl) k (a,1)
  simp [powCode,run,hh,hi]

def ratPowCode : Expression (.prod NN .nat) NN :=
  both (both (fst >>> fst) snd >>> powCode) (both (fst >>> snd) snd >>> powCode) >>> normalizeRat
lemma run_ratPowCode {n : ℕ} (O : IndependenceOracle n) (q : ℚ) (hq : 0≤q) (k : ℕ) :
    run O ratPowCode (rationalPair q,k)=some (rationalPair (q^k)) := by
  simp [ratPowCode,run]
  rw [run_powCode O _ _,run_powCode O _ _]
  change run O normalizeRat ((rationalPair q).1^k,(rationalPair q).2^k)=_
  rw [run_normalizeRat_pair]
  congr 2
  conv_rhs => rw [←rationalPair_value hq]
  push_cast
  rw [div_pow]
end Expression

open Expression
lemma width_take {a : DataType} (xs : List (Value a)) (k : ℕ) :
    width (a:=.list a) (xs.take k)≤width (a:=.list a) xs := by
  have hh := width_list_append (xs.take k) (xs.drop k)
  rw [List.take_append_drop] at hh
  omega
lemma width_drop {a : DataType} (xs : List (Value a)) (k : ℕ) :
    width (a:=.list a) (xs.drop k)≤width (a:=.list a) xs := by
  have hh := width_list_append (xs.take k) (xs.drop k)
  rw [List.take_append_drop] at hh
  omega
lemma controlled_fromList : Controlled fromList := by
  unfold fromList
  apply controlled_compose
  · exact controlled_both _ _ controlled_listReverse (controlled_atomic _ trivial)
  · apply controlled_fold consBit (controlled_atomic _ trivial) (.mul (.constant 2) .input)
    intro n O xs z pre post he y hy
    have hh := foldValue_eq_foldl (run O consBit) (fun z x => x::z) (fun _ _ => rfl) pre z
    rw [hh] at hy
    cases hy
    rw [List.foldl_flip_cons_eq_append',width_word,List.length_append,List.length_reverse]
    have hp : pre.length≤xs.length := by rw [he,List.length_append]; omega
    rw [width_pair (a:=.list .bool) (b:=.word),width_list_bool,width_word]
    dsimp [SizePolynomial.eval]
    omega
lemma controlled_splitStep {a : DataType} : Controlled (splitStep (a:=a)) := by unfold splitStep; control
lemma controlled_splitFold {a : DataType} : Controlled (.fold (splitStep (a:=a))) := by
  apply controlled_fold splitStep controlled_splitStep (.mul (.constant 8) .input)
  intro n O xs z pre post he y hy
  rcases z with ⟨k,u,v⟩
  rw [fold_splitStep] at hy
  cases hy
  have hpre : width (a:=.list a) pre≤width (a:=.list a) xs := by rw [he,width_list_append]; omega
  have ht := width_take (a:=a) pre k
  have hd := width_drop (a:=a) pre k
  have hk := bits_length_mono (Nat.sub_le k pre.length)
  simp only [width_pair (a:=.nat) (b:=.prod (.list a) (.list a)),
    width_pair (a:=.list a) (b:=.list a),width_nat,width_list_append,width_list_reverse,
    width_pair (a:=.list a) (b:=SplitState a),SizePolynomial.eval]
  omega
lemma controlled_splitAt {a : DataType} : Controlled (splitAtCode (a:=a)) := by
  have hf := controlled_splitFold (a:=a)
  have hr := controlled_listReverse (a:=a)
  unfold splitAtCode
  control
lemma controlled_take {a : DataType} : Controlled (takeCode (a:=a)) :=
  controlled_compose _ _ controlled_splitAt (controlled_atomic _ trivial)
lemma controlled_drop {a : DataType} : Controlled (dropCode (a:=a)) :=
  controlled_compose _ _ controlled_splitAt (controlled_atomic _ trivial)
lemma fold_fst_mem {A : Type*} (xs : List A) (z y : A)
    (hy : foldValue (fun p : A×A => some p.1) xs z=some y) : y=z ∨ y∈xs := by
  induction xs generalizing z with
  | nil => cases hy; exact Or.inl rfl
  | cons x xs ih =>
    change foldValue (fun p : A×A => some p.1) xs x=some y at hy
    rcases ih x hy with h|h
    · exact Or.inr (by simp [h])
    · exact Or.inr (by simp [h])
lemma controlled_headD {a : DataType} : Controlled (headD (a:=a)) := by
  unfold headD
  apply controlled_compose
  · exact controlled_onLeft _ controlled_listReverse
  · apply controlled_fold (Expression.fst (a:=a) (b:=a)) (controlled_atomic _ trivial) (.mul (.constant 2) .input)
    intro n O xs z pre post he y hy
    have hh := fold_fst_mem pre z y hy
    have hw : width y≤width z+width (a:=.list a) xs := by
      rcases hh with hh|hh
      · subst y; omega
      · have hm : y∈xs := by rw [he]; exact List.mem_append_left post hh
        have hb := width_list_member y xs hm
        omega
    rw [width_pair (a:=.list a) (b:=a)]
    dsimp [SizePolynomial.eval]
    omega
lemma controlled_getD {a : DataType} : Controlled (getDCode (a:=a)) := by
  have hd := controlled_drop (a:=a)
  have hh := controlled_headD (a:=a)
  unfold getDCode
  control
lemma controlled_boolOr : Controlled boolOr := by unfold boolOr; control
lemma controlled_natEqual : Controlled natEqual := by unfold natEqual; control
lemma controlled_listAll : Controlled listAll := by
  unfold listAll
  apply controlled_compose
  · control
  · apply controlled_fold boolAnd controlled_boolAnd (.add .input (.constant 1))
    intro n O xs z pre post he y hy
    simp only [width_bool,SizePolynomial.eval]
    omega

open Expression
def wordDouble (w : Word) (b : Bool) : Word := if b then false::(w++w) else w++w
lemma wordDouble_length_le (w : Word) (b : Bool) : w.length≤(wordDouble w b).length := by
  cases b <;> simp [wordDouble,List.length_append] ; omega
lemma wordDouble_fold_length_le (xs : List Bool) (z : Word) : z.length≤(xs.foldl wordDouble z).length := by
  induction xs generalizing z with
  | nil => rfl
  | cons b xs ih => exact (wordDouble_length_le z b).trans (ih (wordDouble z b))
lemma wordDouble_prefix_length_le (pre post : List Bool) (z : Word) :
    (pre.foldl wordDouble z).length≤((pre++post).foldl wordDouble z).length := by
  rw [List.foldl_append]
  exact wordDouble_fold_length_le post _
lemma fold_wordDouble {n : ℕ} (O : IndependenceOracle n) (xs : List Bool) (z : Word) :
    foldValue (run O wordRepeatStep) xs z=some (xs.foldl wordDouble z) := by
  apply foldValue_eq_foldl
  intro b w
  exact run_wordRepeatStep O b w
lemma controlled_wordRepeatStep : Controlled wordRepeatStep := by unfold wordRepeatStep; control
lemma polySafe_wordRepeatFold : PolySafe (.fold wordRepeatStep)
    (fun S x => x.1.length≤S ∧ (x.1.foldl wordDouble x.2).length≤S) := by
  apply polySafe_fold wordRepeatStep _ (fun S x => width x≤5*S+4)
    (polySafe_of_controlled wordRepeatStep controlled_wordRepeatStep _
      (.add (.mul (.constant 5) .input) (.constant 4)) (by intros; assumption))
    (.add (.mul (.constant 10) .input) (.constant 4))
  · intro S x hx
    obtain ⟨xs,z⟩ := x
    dsimp only [Prod.fst,Prod.snd] at hx
    have hh := wordDouble_fold_length_le xs z
    rw [width_pair (a:=.list .bool) (b:=.word),width_list_bool,width_word]
    dsimp [SizePolynomial.eval]
    omega
  · intro n O S xs z hx pre post he y hy
    dsimp only [Prod.fst,Prod.snd] at hx
    rw [fold_wordDouble] at hy
    cases hy
    have hh := wordDouble_prefix_length_le pre post z
    rw [←he] at hh
    rw [width_word]
    dsimp [SizePolynomial.eval]
    omega
  · intro n O S xs z hx pre b post he y hy
    dsimp only [Prod.fst,Prod.snd] at hx
    rw [fold_wordDouble] at hy
    cases hy
    have hh := wordDouble_prefix_length_le pre (b::post) z
    rw [←he] at hh
    rw [width_pair (a:=.bool) (b:=.word),width_bool,width_word]
    omega
lemma polySafe_unary : PolySafe unary (fun S x => x≤S) := by
  unfold unary
  apply polySafe_compose _ _ _ _
    (polySafe_of_controlled _ (by control) _ .input (by
      intro S x hx
      exact (bits_length_le_value x).trans hx)) polySafe_wordRepeatFold
  intro n O S x hx y hy
  cases hy
  obtain ⟨w,hw,hlen⟩ := unary_value O x.bits []
  rw [fold_wordDouble] at hw
  have hwe : (x.bits.reverse.foldl wordDouble [])=w := Option.some.inj hw
  refine ⟨?_,?_⟩
  · simpa only [List.length_reverse] using (bits_length_le_value x).trans hx
  · rw [hwe,hlen]
    simpa only [List.length_nil,mul_zero,zero_add,binaryValue_bits] using hx

abbrev StateData := DataType.prod .word .word

def representedState (n : ℕ) (p : Word×Word) : Set (Fin n⊕Fin n) :=
  {i | Sum.elim (fun j => j∈wordSet n p.1) (fun j => j∈wordSet n p.2) i}
@[simp] lemma representedState_inl (n : ℕ) (p : Word×Word) (i : Fin n) :
    Sum.inl i∈representedState n p ↔ p.1[i.val]?.getD false=true := Iff.rfl
@[simp] lemma representedState_inr (n : ℕ) (p : Word×Word) (i : Fin n) :
    Sum.inr i∈representedState n p ↔ p.2[i.val]?.getD false=true := Iff.rfl
@[simp] lemma representedState_preinl (n : ℕ) (p : Word×Word) :
    Sum.inl ⁻¹' representedState n p=wordSet n p.1 := rfl
@[simp] lemma representedState_preinr (n : ℕ) (p : Word×Word) :
    Sum.inr ⁻¹' representedState n p=wordSet n p.2 := rfl
lemma wordSet_not {n : ℕ} (x : Word) (hx : x.length=n) :
    wordSet n (x.map Bool.not)=(wordSet n x)ᶜ := by
  ext i
  simp only [wordSet,Set.mem_ofPred_eq,Set.mem_compl_iff]
  have hi : i.val<x.length := by omega
  rw [List.getElem?_eq_getElem hi,List.getElem?_eq_getElem (by simpa using hi),List.getElem_map]
  cases x[i.val] <;> simp

namespace Expression

def wordGet : Expression (.prod .word .nat) .bool :=
  both (both (fst >>> toList) snd) (constant false) >>> getDCode
def wordNot : Expression .word .word :=
  toList >>> both ident (constant (b:=.unit) ()) >>> mapWith (c:=.unit) (fst >>> boolNot) >>> fromList
def wordCountStep : Expression (.prod .bool .nat) .nat := branch ident (both ident (constant 1) >>> add)
def wordCount : Expression .word .nat := toList >>> both ident (constant 0) >>> fold wordCountStep

lemma run_wordGet {n : ℕ} (O : IndependenceOracle n) (x : Word) (j : ℕ) :
    run O wordGet (x,j)=some (x[j]?.getD false) := by
  change run O (getDCode (a:=.bool)) ((x,j),false)=_
  exact run_getDCode O (a:=.bool) x j false
lemma run_wordNot {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    run O wordNot x=some (x.map Bool.not) := by
  change ((run O (mapWith (c:=.unit) (fst >>> boolNot)) (x,())).bind (run O fromList))=_
  rw [run_mapWith O _ (fun b (_ : Unit) => !b) (by intro b z; exact run_boolNot O b)]
  change run O fromList (x.map Bool.not)=_
  exact run_fromList O _
lemma run_wordCount {n : ℕ} (O : IndependenceOracle n) (x : Word) :
    run O wordCount x=some (x.count true) := by
  have hf : ∀ (xs : Word) k,foldValue (run O wordCountStep) xs k=some (k+xs.count true) := by
    intro xs
    induction xs with
    | nil => intro k; simp [foldValue]
    | cons b xs ih =>
      intro k
      cases b with
      | false =>
        change foldValue (run O wordCountStep) xs k=some (k+(false::xs).count true)
        rw [ih]; simp
      | true =>
        change foldValue (run O wordCountStep) xs (k+1)=some (k+(true::xs).count true)
        rw [ih]; simp [Nat.add_comm,Nat.add_left_comm]
  change foldValue (run O wordCountStep) x 0=_
  simpa using hf x 0

def deficiencyCode : Expression (.prod .nat StateData) .nat :=
  both (both (snd >>> fst >>> wordLength) fst >>> add)
    (both (both (snd >>> fst >>> rank false) (snd >>> snd >>> wordCount) >>> add)
      (snd >>> snd >>> wordNot >>> rank true) >>> add) >>> natSub
lemma run_deficiencyCode {n : ℕ} (O : IndependenceOracle n) (r : ℕ) (x y : Word)
    (hx : x.length=n) (hy : y.length=n) :
    run O deficiencyCode (r,(x,y))=
      some (n+r-(rankWord O false x+y.count true+rankWord O true (y.map Bool.not))) := by
  simp only [deficiencyCode,run_compose,run_both]
  simp [run,run_wordLength,run_wordCount,run_wordNot,hx,hy]
  rw [run_natSub]
end Expression

open scoped Classical in
lemma deficiencyCode_source {n : ℕ} (M₁ M₂ : Matroid (Fin n)) (O : IndependenceOracle n)
    (hO : ExactOracles M₁ M₂ O) (hE₁ : M₁.E=Set.univ) (hE₂ : M₂.E=Set.univ)
    (r : ℕ) (x y : Word) (hx : x.length=n) (hy : y.length=n) :
    run O Expression.deficiencyCode (r,(x,y))=some (oracleDeficiency n r O (representedState n (x,y))) := by
  rw [Expression.run_deficiencyCode O r x y hx hy]
  unfold oracleDeficiency pairedDeficiencyOracle
  rw [representedState_preinl,representedState_preinr,
    rankWord_eq_rankOracle M₁ M₂ O hO hE₁ hE₂ false x hx,
    rankWord_eq_rankOracle M₁ M₂ O hO hE₁ hE₂ true (y.map Bool.not) (by simpa using hy),
    wordSet_not y hy]
  rw [Set.toFinset_compl]
  have hc : (wordSet n y).toFinset.card=y.count true := by
    simpa using wordSet_card y hy
  simp only [hc]

abbrev Optional (a : DataType) := DataType.prod .bool a
abbrev RandomRows := DataType.list .word

def optionData {a : DataType} (d : Value a) : Option (Value a) → Value (Optional a)
  | none => (false,d)
  | some x => (true,x)
lemma foldValue_append {A B : Type*} (f : A×B → Option B) (xs ys : List A) (z : B) :
    foldValue f (xs++ys) z=(foldValue f xs z).bind (foldValue f ys) := by
  induction xs generalizing z with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.cons_append,foldValue,ih,Option.bind_assoc]

namespace Expression
@[simp] lemma run_ident {n : ℕ} (O : IndependenceOracle n) {a : DataType} (x : Value a) :
  run O (ident (a:=a)) x=some x := rfl
@[simp] lemma run_fst {n : ℕ} (O : IndependenceOracle n) {a b : DataType} :
  run O (fst (a:=a) (b:=b))=(fun x => some x.1) := rfl
@[simp] lemma run_snd {n : ℕ} (O : IndependenceOracle n) {a b : DataType} :
  run O (snd (a:=a) (b:=b))=(fun x => some x.2) := rfl
@[simp] lemma run_constant {n : ℕ} (O : IndependenceOracle n) {a b : DataType} (x : Value a) (y : Value b) :
  run O (constant (a:=a) (b:=b) y) x=some y := rfl
@[simp] lemma run_reverse {n : ℕ} (O : IndependenceOracle n) (x : Word) :
  run O reverse x=some x.reverse := rfl
@[simp] lemma run_toNat {n : ℕ} (O : IndependenceOracle n) (x : Word) :
  run O toNat x=some (binaryValue x) := rfl
@[simp] lemma run_less {n : ℕ} (O : IndependenceOracle n) (x y : ℕ) :
  run O less (x,y)=some (decide (x<y)) := rfl

def wordTake : Expression (.prod .word .nat) .word := onLeft toList >>> takeCode >>> fromList
def wordDrop : Expression (.prod .word .nat) .word := onLeft toList >>> dropCode >>> fromList
lemma run_wordTake {n : ℕ} (O : IndependenceOracle n) (x : Word) (k : ℕ) :
    run O wordTake (x,k)=some (x.take k) := by
  change ((run O (takeCode (a:=.bool)) (x,k)).bind (run O fromList))=_
  rw [run_takeCode]; exact run_fromList O _
lemma run_wordDrop {n : ℕ} (O : IndependenceOracle n) (x : Word) (k : ℕ) :
    run O wordDrop (x,k)=some (x.drop k) := by
  change ((run O (dropCode (a:=.bool)) (x,k)).bind (run O fromList))=_
  rw [run_dropCode]; exact run_fromList O _

abbrev RejectState := DataType.prod NN (Optional .nat)
def rejectStep : Expression (.prod .word RejectState) RejectState :=
  both (snd >>> fst)
    (letIn (both fst (snd >>> fst >>> snd) >>> wordTake >>> reverse >>> toNat)
      (applyIf (both snd (fst >>> snd >>> fst >>> fst) >>> less)
        (fst >>> snd >>> snd) (both (constant true) snd)))
def rejectCode : Expression (.prod RandomRows NN) (Optional .nat) :=
  both (fst >>> listReverse) (both snd (constant (false,0))) >>> fold rejectStep >>> snd

def rejectValue (v k : ℕ) : List Word → Option ℕ
  | [] => none
  | x::xs => let z := binaryValue (x.take k).reverse
      if z<v then some z else rejectValue v k xs
lemma run_rejectStep {n : ℕ} (O : IndependenceOracle n) (x : Word) (v k : ℕ) (z : Bool×ℕ) :
    run O rejectStep (x,((v,k),z))=some ((v,k),
      if binaryValue (x.take k).reverse<v then (true,binaryValue (x.take k).reverse) else z) := by
  simp only [rejectStep,run_both,run_letIn,run_compose,run_fst,run_snd,run_constant,
    run_reverse,run_toNat,run_applyIf,Option.bind_some,Option.map_some]
  rw [run_wordTake O x k]
  by_cases h : binaryValue (x.take k).reverse<v <;> simp [run,h]
lemma fold_reject {n : ℕ} (O : IndependenceOracle n) (v k : ℕ) (xs : List Word) (z : Bool×ℕ) :
    foldValue (run O rejectStep) xs.reverse ((v,k),z)=
      some ((v,k),match rejectValue v k xs with | none => z | some y => (true,y)) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    rw [List.reverse_cons,foldValue_append,ih]
    simp only [Option.bind_some,foldValue]
    rw [run_rejectStep]
    simp only [Option.bind_some]
    change _=some ((v,k),match rejectValue v k (x::xs) with | none => z | some y => (true,y))
    simp only [rejectValue]
    split_ifs <;> rfl
lemma run_rejectCode {n : ℕ} (O : IndependenceOracle n) (xs : List Word) (v k : ℕ) :
    run O rejectCode (xs,(v,k))=some (optionData 0 (rejectValue v k xs)) := by
  simp only [rejectCode,run_compose,run_both,run_fst,run_snd,run_constant,Option.bind_some,
    run_listReverse,Option.map_some]
  change ((foldValue (run O rejectStep) xs.reverse ((v,k),(false,0))).bind fun z => some z.2)=_
  rw [fold_reject]
  cases rejectValue v k xs <;> rfl
end Expression

lemma binaryValue_ofFn_reverse (h : ℕ) (bits : BitWord h) :
    binaryValue (List.ofFn bits).reverse=(wordEquiv h bits).val := by
  induction h with
  | zero => simp [wordEquiv,binaryValue]
  | succ h ih =>
    rw [List.ofFn_succ,List.reverse_cons,binaryValue_append]
    simp only [List.length_reverse,List.length_ofFn,ih,binaryValue]
    simp [wordEquiv,Equiv.trans_apply,Fin.consEquiv,finProdFinEquiv,finTwoEquiv]
    cases bits 0 <;> simp <;> rfl

lemma ofFn_bitPrefix (h H : ℕ) (hh : h≤H) (bits : BitWord H) :
    List.ofFn (bitPrefix h H hh bits)=(List.ofFn bits).take h := by
  apply List.ext_getElem
  · simp; omega
  · intro i hi hj
    simp [bitPrefix]

lemma rejectValue_ofFn (v h D : ℕ) (bits : Fin D → BitWord h) :
    Expression.rejectValue v h (List.ofFn (fun i => List.ofFn (bits i)))=
      (boundedUniform v h D bits).map Fin.val := by
  induction D with
  | zero => rfl
  | succ D ih =>
    rw [List.ofFn_succ]
    simp only [Expression.rejectValue]
    rw [List.take_of_length_le (by simp),binaryValue_ofFn_reverse]
    simp only [boundedUniform]
    split_ifs <;> first | rfl | exact ih (Fin.tail bits)

lemma rejectValue_prefix (v h H D : ℕ) (hh : h≤H) (bits : Fin D → BitWord H) :
    Expression.rejectValue v h (List.ofFn (fun i => List.ofFn (bits i)))=
      (boundedUniform v h D (fun i => bitPrefix h H hh (bits i))).map Fin.val := by
  induction D with
  | zero => rfl
  | succ D ih =>
    rw [List.ofFn_succ]
    simp only [Expression.rejectValue,←ofFn_bitPrefix h H hh,binaryValue_ofFn_reverse,boundedUniform]
    split_ifs <;> first | rfl | exact ih (Fin.tail bits)

abbrev BankData := DataType.list RandomRows
abbrev Bank := List (List Word)
lemma rejectValue_lt (v h : ℕ) (xs : List Word) {i : ℕ}
    (hi : Expression.rejectValue v h xs=some i) : i<v := by
  induction xs with
  | nil => cases hi
  | cons x xs ih =>
    simp only [Expression.rejectValue] at hi
    split_ifs at hi with hx
    · cases hi; exact hx
    · exact ih hi

def bankEval {A : Type*} : DrawTree A → Bank → Option A × Bank
  | .leaf a,bank => (some a,bank)
  | .draw _ _,[] => (none,[])
  | .draw v k,rows::bank =>
    match hi : Expression.rejectValue (v+1) (Nat.clog 2 (v+1)) rows with
    | none => (none,bank)
    | some i => bankEval (k ⟨i,rejectValue_lt _ _ _ hi⟩) bank

lemma bankEval_bind {A B : Type*} (t : DrawTree A) (f : A → DrawTree B) (bank : Bank) :
    bankEval (t.bind f) bank=
      match bankEval t bank with
      | (none,rest) => (none,rest)
      | (some a,rest) => bankEval (f a) rest := by
  induction t generalizing bank with
  | leaf a => rfl
  | draw v k ih =>
    cases bank with
    | nil => rfl
    | cons rows bank =>
      simp only [DrawTree.bind,bankEval]
      split <;> first | rfl | exact ih _ bank
lemma bankEval_map {A B : Type*} (t : DrawTree A) (f : A → B) (bank : Bank) :
    bankEval (t.map f) bank=((bankEval t bank).1.map f,(bankEval t bank).2) := by
  rw [DrawTree.map,bankEval_bind]
  cases bankEval t bank with
  | mk o rest => cases o <;> rfl

def bankEncode {H D M : ℕ} (bits : Fin M → Fin D → BitWord H) : Bank :=
  List.ofFn (fun m => List.ofFn (fun d => List.ofFn (bits m d)))
lemma bankEncode_succ {H D M : ℕ} (bits : Fin (M+1) → Fin D → BitWord H) :
    bankEncode bits=List.ofFn (fun d => List.ofFn (bits 0 d))::bankEncode (Fin.tail bits) := by
  exact List.ofFn_succ
lemma bankEval_run {A : Type*} (H D M : ℕ) (t : DrawTree A) (ht : DrawTree.Fits H M t)
    (bits : Fin M → Fin D → BitWord H) :
    (bankEval t (bankEncode bits)).1=DrawTree.run H D M t bits := by
  induction t generalizing M with
  | leaf a => cases M <;> rfl
  | draw v k ih =>
    cases M with
    | zero => exact False.elim ht
    | succ M =>
      rw [bankEncode_succ]
      simp only [bankEval,DrawTree.run,dite_eq_left ht.1]
      have he := rejectValue_prefix (v+1) (Nat.clog 2 (v+1)) H D ht.1 (bits 0)
      cases hu : boundedUniform (v+1) (Nat.clog 2 (v+1)) D
          (fun i => bitPrefix _ H ht.1 (bits 0 i)) with
      | none =>
        simp only [hu,Option.map_none] at he
        split
        · rfl
        · rename_i i hi
          have hh := he.symm.trans hi
          cases hh
      | some i =>
        simp only [hu,Option.map_some] at he
        split
        · rename_i hi
          have hh := he.symm.trans hi
          cases hh
        · rename_i j hj
          have hh := Option.some.inj (he.symm.trans hj)
          subst j
          exact ih i M (ht.2 i) (Fin.tail bits)

open Expression

def zeroValue : (a : DataType) → Value a
  | .unit => ()
  | .bool => false
  | .nat => 0
  | .word => []
  | .prod a b => (zeroValue a,zeroValue b)
  | .list _ => []
def optionalValue (a : DataType) : Option (Value a) → Value (Optional a) := optionData (zeroValue a)
def decodeOptional {a : DataType} (x : Value (Optional a)) : Option (Value a) := if x.1 then some x.2 else none
@[simp] lemma decode_optionalValue (a : DataType) (x : Option (Value a)) :
    decodeOptional (optionalValue a x)=x := by cases x <;> rfl

abbrev Effect (a b : DataType) := Expression (.prod a BankData) (.prod (Optional b) BankData)
namespace Expression
lemma clog_two_size_pred (v : ℕ) : Nat.clog 2 v=(v-1).size := by
  apply Nat.le_antisymm
  · apply (Nat.clog_le_iff_le_pow (by norm_num)).mpr
    have h := Nat.lt_size_self (v-1)
    omega
  · apply Nat.size_le.mpr
    have h := Nat.le_pow_clog (by norm_num : 1<2) v
    have hp : 0<2^(Nat.clog 2 v) := by positivity
    omega

def clogCode : Expression .nat .nat := both ident (constant 1) >>> natSub >>> toBits >>> wordLength
lemma run_clogCode {n : ℕ} (O : IndependenceOracle n) (v : ℕ) :
    run O clogCode v=some (Nat.clog 2 v) := by
  simp only [clogCode,run_compose,run_both,run_ident,run_constant,Option.bind_some,Option.map_some]
  rw [run_natSub]
  change run O wordLength (v-1).bits=_
  rw [run_wordLength,Nat.size_eq_bits_len,clog_two_size_pred]

end Expression
open Expression
namespace Effect

def pure {a b} (p : Expression a b) : Effect a b := both (both (constant true) (fst >>> p)) snd
def fail {a b} : Effect a b := both (constant (optionalValue b none)) snd

def bind {a b c} (p : Effect a b) (q : Effect b c) : Effect a c :=
  p >>> applyIf (fst >>> fst)
    (both (constant (optionalValue c none)) snd)
    (both (fst >>> snd) snd >>> q)

def keep {a b} (p : Effect a b) : Effect a (.prod a b) :=
  letIn p (both
    (applyIf (snd >>> fst >>> fst) (constant (optionalValue (.prod a b) none))
      (both (constant true) (both (fst >>> fst) (snd >>> fst >>> snd))))
    (snd >>> snd))

def letIn {a b c} (p : Effect a b) (q : Effect (.prod a b) c) : Effect a c :=
  bind (keep p) q

def draw : Effect .nat .nat :=
  both
    (both (snd >>> both ident (constant []) >>> headD) (both fst (fst >>> clogCode)) >>> rejectCode)
    (snd >>> both ident (constant 1) >>> dropCode)

lemma run_pure {n : ℕ} (O : IndependenceOracle n) {a b} (p : Expression a b)
    (x : Value a) (y : Value b) (bank : Bank) (hp : run O p x=some y) :
    run O (pure p) (x,bank)=some (optionalValue b (some y),bank) := by
  simp only [pure,run_both,run_compose,run_fst,run_snd,run_constant,
    Option.bind_some,hp,Option.map_some]
  rfl
lemma run_fail {n : ℕ} (O : IndependenceOracle n) {a b} (x : Value a) (bank : Bank) :
    run O (fail (a:=a) (b:=b)) (x,bank)=some (optionalValue b none,bank) := rfl
lemma run_bind {n : ℕ} (O : IndependenceOracle n) {a b c} (p : Effect a b) (q : Effect b c)
    (x : Value a) (bank rest : Bank) (y : Option (Value b))
    (hp : run O p (x,bank)=some (optionalValue b y,rest)) :
    run O (bind p q) (x,bank)=
      match y with
      | none => some (optionalValue c none,rest)
      | some z => run O q (z,rest) := by
  cases y <;> dsimp only <;> rw [bind,run_compose,hp,Option.bind_some,run_applyIf] <;> rfl
lemma run_keep {n : ℕ} (O : IndependenceOracle n) {a b} (p : Effect a b)
    (x : Value a) (bank rest : Bank) (y : Value b)
    (hp : run O p (x,bank)=some (optionalValue b (some y),rest)) :
    run O (keep p) (x,bank)=some (optionalValue (.prod a b) (some (x,y)),rest) := by
  rw [keep,run_letIn,hp]
  rfl
lemma run_draw {n : ℕ} (O : IndependenceOracle n) (v : ℕ) (bank : Bank) :
    run O draw (v,bank)=some (optionData 0
      (Expression.rejectValue v (Nat.clog 2 v) (bank.headD [])),bank.drop 1) := by
  simp only [draw,run_both,run_compose,run_fst,run_snd,run_ident,run_constant,Option.bind_some,Option.map_some]
  rw [run_headD,run_clogCode,run_dropCode]
  simp only [Option.bind_some,Option.map_some]
  rw [run_rejectCode]
  rfl

def Realizes {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b : DataType}
    (p : Effect a b) (encode : A → Value b) (x : Value a) (t : DrawTree A) : Prop :=
  ∀ bank, run O p (x,bank)=some
    (optionalValue b ((bankEval t bank).1.map encode),(bankEval t bank).2)

lemma realizes_pure {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b : DataType}
    (p : Expression a b) (encode : A → Value b) (x : Value a) (y : A)
    (hp : run O p x=some (encode y)) : Realizes O (pure p) encode x (.leaf y) := by
  intro bank
  exact run_pure O p x (encode y) bank hp

lemma realizes_bind {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c : DataType}
    (p : Effect a b) (q : Effect b c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → DrawTree B)
    (hp : Realizes O p ea x t) (hq : ∀ y,Realizes O q eb (ea y) (f y)) :
    Realizes O (bind p q) eb x (t.bind f) := by
  intro bank
  rw [bankEval_bind]
  cases ht : bankEval t bank with
  | mk out rest =>
    have hh := hp bank
    rw [ht] at hh
    cases out with
    | none => exact run_bind O p q x bank rest none hh
    | some y =>
      rw [run_bind O p q x bank rest (some (ea y)) hh]
      exact hq y rest

lemma realizes_keep {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b : DataType}
    (p : Effect a b) (ea : A → Value b) (x : Value a) (t : DrawTree A)
    (hp : Realizes O p ea x t) :
    Realizes O (keep p) (fun y => (x,ea y)) x t := by
  intro bank
  have hh := hp bank
  cases ht : bankEval t bank with
  | mk out rest =>
    rw [ht] at hh
    cases out with
    | none => rw [keep,run_letIn,hh]; rfl
    | some y => exact run_keep O p x bank rest (ea y) hh

lemma realizes_letIn {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c : DataType}
    (p : Effect a b) (q : Effect (.prod a b) c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → DrawTree B)
    (hp : Realizes O p ea x t) (hq : ∀ y,Realizes O q eb (x,ea y) (f y)) :
    Realizes O (letIn p q) eb x (t.bind f) :=
  realizes_bind O (keep p) q _ eb x t f (realizes_keep O p ea x t hp) hq

lemma realizes_draw {n : ℕ} (O : IndependenceOracle n) (v : ℕ) :
    Realizes O draw Fin.val (v+1) (.draw v DrawTree.leaf) := by
  intro bank
  rw [run_draw]
  cases bank with
  | nil => rfl
  | cons rows bank =>
    simp only [bankEval]
    split
    · rename_i hi
      simp only [List.headD_cons,List.drop_succ_cons,List.drop_zero,hi,Option.map_none]
      rfl
    · rename_i i hi
      simp only [List.headD_cons,List.drop_succ_cons,List.drop_zero,hi,Option.map_some]
      rfl

def map {a b c} (p : Effect a b) (q : Expression b c) : Effect a c := bind p (pure q)
def precompose {a b c} (p : Expression a b) (q : Effect b c) : Effect a c := onLeft p >>> q

def choose {a b} (test : Expression a .bool) (p q : Effect a b) : Effect a b :=
  applyIf (fst >>> test) p q

lemma run_precompose {n : ℕ} (O : IndependenceOracle n) {a b c} (p : Expression a b)
    (q : Effect b c) (x : Value a) (y : Value b) (bank : Bank)
    (hp : run O p x=some y) : run O (precompose p q) (x,bank)=run O q (y,bank) := by
  simp only [precompose,onLeft,run_compose,run_both,run_fst,run_snd,Option.bind_some,hp,Option.map_some]

lemma realizes_precompose {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b c}
    (p : Expression a b) (q : Effect b c) (ea : A → Value c) (x : Value a) (y : Value b)
    (t : DrawTree A) (hp : run O p x=some y) (hq : Realizes O q ea y t) :
    Realizes O (precompose p q) ea x t := by
  intro bank
  rw [run_precompose O p q x y bank hp]
  exact hq bank

lemma run_choose {n : ℕ} (O : IndependenceOracle n) {a b} (test : Expression a .bool)
    (p q : Effect a b) (x : Value a) (bank : Bank) (v : Bool)
    (ht : run O test x=some v) :
    run O (choose test p q) (x,bank)=if v then run O q (x,bank) else run O p (x,bank) := by
  rw [choose,run_applyIf]
  change ((run O test x).bind fun v => if v then _ else _)=_
  rw [ht,Option.bind_some]

lemma realizes_map {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c}
    (p : Effect a b) (q : Expression b c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → B)
    (hp : Realizes O p ea x t) (hq : ∀ y,run O q (ea y)=some (eb (f y))) :
    Realizes O (map p q) eb x (t.map f) :=
  realizes_bind O p (pure q) ea eb x t (fun y => .leaf (f y)) hp
    (fun y => realizes_pure O q eb (ea y) (f y) (hq y))
end Effect

def iterateM {A : Type*} (f : A → Option A) : ℕ → A → Option A
  | 0,x => some x
  | k+1,x => (f x).bind (iterateM f k)
lemma iterateM_some {A : Type*} (f : A → Option A) (x : A) (h : f x=some x) (k : ℕ) :
    iterateM f k x=some x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [iterateM,h,Option.bind_some,ih]
namespace Expression
lemma run_iterateNatM {n : ℕ} (O : IndependenceOracle n) {a : DataType}
    (p : Expression a a) (k : ℕ) (x : Value a) :
    run O (iterateNat p) (k,x)=iterateM (run O p) k x := by
  have hf : ∀ (w : Word) (z : Value a),
      foldValue (run O (snd (a:=.bool) >>> p)) w z=iterateM (run O p) w.length z := by
    intro w
    induction w with
    | nil => intro z; rfl
    | cons b w ih =>
      intro z
      change ((run O p z).bind (foldValue (run O (snd (a:=.bool) >>> p)) w))=_
      simp only [List.length_cons,iterateM]
      congr 1
      funext v
      exact ih v
  obtain ⟨w,hw,hlen⟩ := run_unary O k
  simp only [iterateNat,onLeft,run_compose,run_both,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [hw]
  change foldValue (run O (snd (a:=.bool) >>> p)) w x=_
  rw [hf,hlen]
end Expression
namespace Effect

def loopStep {a} (p : Effect a a) : Expression (.prod (Optional a) BankData) (.prod (Optional a) BankData) :=
  applyIf (fst >>> fst) ident (both (fst >>> snd) snd >>> p)
def repeatCode {a} (p : Effect a a) : Effect (.prod .nat a) a :=
  both (fst >>> fst) (both (both (constant (b:=.bool) true) (fst >>> snd)) snd) >>> iterateNat (loopStep p)
lemma run_loopStep_none {n : ℕ} (O : IndependenceOracle n) {a} (p : Effect a a) (bank : Bank) :
    run O (loopStep p) (optionalValue a none,bank)=some (optionalValue a none,bank) := rfl
lemma run_loopStep_some {n : ℕ} (O : IndependenceOracle n) {a} (p : Effect a a)
    (x : Value a) (bank : Bank) :
    run O (loopStep p) (optionalValue a (some x),bank)=run O p (x,bank) := rfl
lemma run_repeat {n : ℕ} (O : IndependenceOracle n) {a} (p : Effect a a)
    (k : ℕ) (x : Value a) (bank : Bank) :
    run O (repeatCode p) ((k,x),bank)=iterateM (run O (loopStep p)) k (optionalValue a (some x),bank) := by
  change run O (iterateNat (loopStep p)) (k,(optionalValue a (some x),bank))=_
  exact run_iterateNatM O _ _ _

def treeRepeat {A : Type*} (f : A → DrawTree A) : ℕ → A → DrawTree A
  | 0,x => .leaf x
  | k+1,x => (f x).bind (treeRepeat f k)
lemma realizes_repeat {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a}
    (p : Effect a a) (ea : A → Value a) (f : A → DrawTree A)
    (hp : ∀ x,Realizes O p ea (ea x) (f x)) (k : ℕ) (x : A) :
    Realizes O (repeatCode p) ea (k,ea x) (treeRepeat f k x) := by
  intro bank
  rw [run_repeat]
  induction k generalizing x bank with
  | zero => rfl
  | succ k ih =>
    rw [iterateM,run_loopStep_some,hp x bank,Option.bind_some,treeRepeat,bankEval_bind]
    cases ht : bankEval (f x) bank with
    | mk out rest =>
      cases out with
      | none =>
        simpa only [Option.map_none] using iterateM_some (run O (loopStep p))
          (optionalValue a none,rest) (run_loopStep_none O p rest) k
      | some y => exact ih y rest

end Effect
end MachineCode

namespace DrawTree
variable {A B : Type*}
lemma Reindexed.trans {t u v : DrawTree A} (h : Reindexed t u) (g : Reindexed u v) :
    Reindexed t v := by
  induction h generalizing v with
  | leaf a => cases g; exact .leaf a
  | draw m k l e h ih =>
    cases g with
    | draw _ _ z f gz =>
      exact .draw m k z (e.trans f) (fun i => ih i (gz (e i)))
lemma uniformVia_reindexed_via (A : Type*) [Fintype A] [Nonempty A]
    (e f : Fin (Fintype.card A) ≃ A) : Reindexed (uniformVia A e) (uniformVia A f) :=
  (uniformVia_reindexed A e).trans (uniformVia_reindexed A f).symm
end DrawTree
namespace MachineCode
open Expression
namespace Effect

def RealizesLaw {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b : DataType}
    (p : Effect a b) (encode : A → Value b) (x : Value a) (t : DrawTree A) : Prop :=
  ∃ u, DrawTree.Reindexed t u ∧ Realizes O p encode x u
lemma Realizes.law {n : ℕ} {O : IndependenceOracle n} {A : Type*} {a b} {p : Effect a b}
    {e : A → Value b} {x : Value a} {t : DrawTree A} (h : Realizes O p e x t) :
    RealizesLaw O p e x t := ⟨t,.refl t,h⟩
lemma RealizesLaw.reindex {n : ℕ} {O : IndependenceOracle n} {A : Type*} {a b}
    {p : Effect a b} {e : A → Value b} {x : Value a} {t u : DrawTree A}
    (h : RealizesLaw O p e x u) (ht : DrawTree.Reindexed t u) : RealizesLaw O p e x t := by
  rcases h with ⟨v,hv,hp⟩
  exact ⟨v,ht.trans hv,hp⟩
lemma law_bind {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c}
    (p : Effect a b) (q : Effect b c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → DrawTree B)
    (hp : RealizesLaw O p ea x t) (hq : ∀ y,RealizesLaw O q eb (ea y) (f y)) :
    RealizesLaw O (bind p q) eb x (t.bind f) := by
  classical
  rcases hp with ⟨u,hu,hp⟩
  choose g hg hq using hq
  exact ⟨u.bind g,hu.bind hg,realizes_bind O p q ea eb x u g hp hq⟩
lemma law_letIn {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c}
    (p : Effect a b) (q : Effect (.prod a b) c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → DrawTree B)
    (hp : RealizesLaw O p ea x t) (hq : ∀ y,RealizesLaw O q eb (x,ea y) (f y)) :
    RealizesLaw O (letIn p q) eb x (t.bind f) := by
  classical
  rcases hp with ⟨u,hu,hp⟩
  choose g hg hq using hq
  exact ⟨u.bind g,hu.bind hg,realizes_letIn O p q ea eb x u g hp hq⟩
lemma law_precompose {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b c}
    (p : Expression a b) (q : Effect b c) (ea : A → Value c) (x : Value a) (y : Value b)
    (t : DrawTree A) (hp : run O p x=some y) (hq : RealizesLaw O q ea y t) :
    RealizesLaw O (precompose p q) ea x t := by
  rcases hq with ⟨u,hu,hq⟩
  exact ⟨u,hu,realizes_precompose O p q ea x y u hp hq⟩
lemma law_map {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c}
    (p : Effect a b) (q : Expression b c) (ea : A → Value b) (eb : B → Value c)
    (x : Value a) (t : DrawTree A) (f : A → B)
    (hp : RealizesLaw O p ea x t) (hq : ∀ y,run O q (ea y)=some (eb (f y))) :
    RealizesLaw O (map p q) eb x (t.map f) := by
  rcases hp with ⟨u,hu,hp⟩
  exact ⟨u.map f,hu.map f,realizes_map O p q ea eb x u f hp hq⟩
lemma law_choose {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b}
    (test : Expression a .bool) (p q : Effect a b) (ea : A → Value b)
    (x : Value a) (t : DrawTree A) (v : Bool) (ht : run O test x=some v)
    (h : RealizesLaw O (if v then q else p) ea x t) :
    RealizesLaw O (choose test p q) ea x t := by
  rcases h with ⟨u,hu,hp⟩
  refine ⟨u,hu,fun bank => ?_⟩
  rw [run_choose O test p q x bank v ht]
  cases v <;> exact hp bank
end Effect
end MachineCode

namespace DrawTree
variable {A B C : Type*}
lemma bind_leaf (t : DrawTree A) : t.bind leaf=t := by
  induction t with
  | leaf a => rfl
  | draw v f ih => simp only [bind,ih]
lemma map_bind (t : DrawTree A) (f : A → B) (g : B → DrawTree C) :
    (t.map f).bind g=t.bind (fun a => g (f a)) := by
  rw [DrawTree.map,bind_assoc]
  rfl
lemma bind_map (t : DrawTree A) (f : A → DrawTree B) (g : B → C) :
    (t.bind f).map g=t.bind (fun a => (f a).map g) := bind_assoc t f _
lemma map_map (t : DrawTree A) (f : A → B) (g : B → C) :
    (t.map f).map g=t.map (g ∘ f) := map_bind t f _
end DrawTree
namespace MachineCode

open Expression

def optionEncode {A : Type*} {a} (e : A → Value a) (x : Option A) : Value (Optional a) :=
  optionalValue a (x.map e)
@[simp] lemma optionEncode_none {A : Type*} {a} (e : A → Value a) :
    optionEncode e none=(false,zeroValue a) := rfl
@[simp] lemma optionEncode_some {A : Type*} {a} (e : A → Value a) (x : A) :
    optionEncode e (some x)=(true,e x) := rfl
namespace Effect

def someCode {a b} (p : Effect a b) : Effect a (Optional b) :=
  map p (both (constant true) ident)
def noneCode {a b} : Effect a (Optional b) := pure (constant (optionalValue b none))
def optionContinue {a b} (q : Effect a (Optional b)) : Effect (Optional a) (Optional b) :=
  choose fst noneCode (precompose snd q)
def optionBind {a b c} (p : Effect a (Optional b)) (q : Effect b (Optional c)) : Effect a (Optional c) :=
  bind p (optionContinue q)

lemma law_some {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b} (p : Effect a b)
    (ea : A → Value b) (x : Value a) (t : DrawTree A) (h : RealizesLaw O p ea x t) :
    RealizesLaw O (someCode p) (optionEncode ea) x (t.map some) :=
  law_map O p _ ea (optionEncode ea) x t some h (fun _ => rfl)
lemma law_none {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a b} (ea : A → Value b) (x : Value a) :
    RealizesLaw O (noneCode (a:=a) (b:=b)) (optionEncode ea) x (.leaf none) :=
  (realizes_pure O _ _ _ none rfl).law
lemma law_optionContinue {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b}
    (q : Effect a (Optional b)) (ea : A → Value a) (eb : B → Value b)
    (f : A → DrawTree (Option B)) (x : Option A)
    (hq : ∀ y,RealizesLaw O q (optionEncode eb) (ea y) (f y)) :
    RealizesLaw O (optionContinue q) (optionEncode eb) (optionEncode ea x)
      (match x with | none => .leaf none | some y => f y) := by
  unfold optionContinue
  cases x with
  | none => exact law_choose O _ _ _ _ _ _ false rfl (law_none O eb _)
  | some y =>
    exact law_choose O _ _ _ _ _ _ true rfl
      (law_precompose O snd q _ _ _ _ rfl (hq y))
lemma law_optionBind {n : ℕ} (O : IndependenceOracle n) {A B : Type*} {a b c}
    (p : Effect a (Optional b)) (q : Effect b (Optional c))
    (ea : A → Value b) (eb : B → Value c) (x : Value a)
    (t : DrawTree (Option A)) (f : A → DrawTree (Option B))
    (hp : RealizesLaw O p (optionEncode ea) x t)
    (hq : ∀ y,RealizesLaw O q (optionEncode eb) (ea y) (f y)) :
    RealizesLaw O (optionBind p q) (optionEncode eb) x (t.optionBind f) :=
  law_bind O p (optionContinue q) (optionEncode ea) (optionEncode eb) x t _ hp
    (fun y => law_optionContinue O q ea eb f y hq)

lemma law_repeat {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a}
    (p : Effect a a) (ea : A → Value a) (f : A → DrawTree A)
    (hp : ∀ x,RealizesLaw O p ea (ea x) (f x)) (k : ℕ) (x : A) :
    RealizesLaw O (repeatCode p) ea (k,ea x) (treeRepeat f k x) := by
  classical
  choose g hg hp using hp
  have hh : ∀ k x, DrawTree.Reindexed (treeRepeat f k x) (treeRepeat g k x) := by
    intro k
    induction k with
    | zero => intro x; exact .leaf x
    | succ k ih => intro x; exact (hg x).bind ih
  exact ⟨treeRepeat g k x,hh k x,realizes_repeat O p ea g hp k x⟩
lemma treeRepeat_succ_last {A : Type*} (f : A → DrawTree A) (k : ℕ) (x : A) :
    treeRepeat f (k+1) x=(treeRepeat f k x).bind f := by
  induction k generalizing x with
  | zero => exact DrawTree.bind_leaf (f x)
  | succ k ih =>
    change (f x).bind (treeRepeat f (k+1))=((f x).bind (treeRepeat f k)).bind f
    rw [DrawTree.bind_assoc]
    congr 1
    funext y
    exact ih y
lemma treeRepeat_option {A : Type*} (f : A → DrawTree (Option A)) (k : ℕ) (x : A) :
    treeRepeat (fun u => match u with | none => .leaf none | some a => f a) k (some x)=
      DrawTree.iterate f k x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [treeRepeat_succ_last,ih]; rfl

def iterateCode {a} (p : Effect a (Optional a)) : Effect (.prod .nat a) (Optional a) :=
  precompose (both fst (both (constant true) snd)) (repeatCode (optionContinue p))
lemma law_iterate {n : ℕ} (O : IndependenceOracle n) {A : Type*} {a}
    (p : Effect a (Optional a)) (ea : A → Value a) (f : A → DrawTree (Option A))
    (hp : ∀ x,RealizesLaw O p (optionEncode ea) (ea x) (f x)) (k : ℕ) (x : A) :
    RealizesLaw O (iterateCode p) (optionEncode ea) (k,ea x) (DrawTree.iterate f k x) := by
  unfold iterateCode
  apply law_precompose O _ _ _ _ (k,optionEncode ea (some x)) _ rfl
  rw [←treeRepeat_option]
  apply law_repeat
  intro u
  exact law_optionContinue O p ea ea f u hp
end Effect

lemma polySafe_reparam {a b : DataType} (p : Expression a b) (R : ℕ → Value a → Prop)
    (hp : PolySafe p R) (g : SizePolynomial) : PolySafe p (fun S x => R (g.eval S) x) := by
  obtain ⟨f,hf⟩ := hp
  exact ⟨f.subst g,fun O S x hx => by rw [SizePolynomial.eval_subst]; exact hf O _ x hx⟩
lemma polySafe_post {a b c : DataType} (p : Expression a b) (q : Expression b c)
    (R : ℕ → Value a → Prop) (hp : PolySafe p R) (hq : Controlled q) : PolySafe (p >>> q) R := by
  obtain ⟨f,hf⟩ := hp
  apply polySafe_compose p q R (fun S y => width y≤f.eval S) ⟨f,hf⟩
    (polySafe_of_controlled q hq _ f (by intros; assumption))
  intro n O S x hx y hy
  exact safe_output (hf O S x hx) hy
lemma foldValue_iterateM {n : ℕ} (O : IndependenceOracle n) {a : DataType}
    (p : Expression a a) (xs : List Bool) (z : Value a) :
    foldValue (run O (Expression.snd (a:=.bool) >>> p)) xs z=iterateM (run O p) xs.length z := by
  induction xs generalizing z with
  | nil => rfl
  | cons b xs ih => simp only [foldValue,run_compose,run_snd,Option.bind_some,List.length_cons,iterateM]; simp_rw [ih]

lemma polySafe_iterateNat {a : DataType} (p : Expression a a)
    (R : ℕ → Value (.prod .nat a) → Prop) (Q : ℕ → Value a → Prop)
    (hp : PolySafe p Q) (g : SizePolynomial)
    (hinput : ∀ S k z,R S (k,z) → k+width (a:=a) z≤g.eval S)
    (hacc : ∀ {n : ℕ} (O : IndependenceOracle n) S k z,R S (k,z) →
      ∀ j,j≤k → ∀ y,iterateM (run O p) j z=some y → width (a:=a) y≤g.eval S)
    (hbody : ∀ {n : ℕ} (O : IndependenceOracle n) S k z,R S (k,z) →
      ∀ j,j<k → ∀ y,iterateM (run O p) j z=some y → Q S y) :
    PolySafe (iterateNat p) R := by
  let T : SizePolynomial := .add (.mul (.constant 12) g) (.constant 4)
  have hnatwidth : ∀ S x,R S x → width x≤T.eval S := by
    intro S x hx
    obtain ⟨k,z⟩ := x
    have hh : k+width (a:=a) z≤g.eval S := hinput S k z hx
    have hb := bits_length_le_value k
    rw [width_pair (a:=.nat) (b:=a),width_nat]
    dsimp [T,SizePolynomial.eval]
    have h₁ := Nat.mul_le_mul_left 2 hh
    omega
  have hu : PolySafe (onLeft (c:=a) unary) R := by
    unfold onLeft
    apply polySafe_both
    · apply polySafe_compose _ _ R (fun S k => k≤g.eval S)
        (polySafe_of_controlled Expression.fst (by control) R T hnatwidth)
        (polySafe_reparam unary (fun S k => k≤S) polySafe_unary g)
      intro n O S x hx y hy
      obtain ⟨k,z⟩ := x
      simp only [run_fst, Option.some.injEq] at hy
      subst y
      have hh : k+width (a:=a) z≤g.eval S := hinput S k z hx
      exact (Nat.le_add_right k (width (a:=a) z)).trans hh
    · exact polySafe_of_controlled Expression.snd (by control) R T hnatwidth
  let Rw : ℕ → Value (.prod .word a) → Prop := fun S x => R S (x.1.length,x.2)
  let Rl : ℕ → Value (.prod (.list .bool) a) → Prop := fun S x => R S (x.1.length,x.2)
  have hw : ∀ S x,Rw S x → width x≤T.eval S := by
    intro S x hx
    obtain ⟨w,z⟩ := x
    have hh : w.length+width (a:=a) z≤g.eval S := hinput S w.length z hx
    rw [width_pair (a:=.word) (b:=a),width_word]
    dsimp [T,SizePolynomial.eval]
    omega
  have hfold : PolySafe (.fold (snd >>> p)) Rl := by
    refine polySafe_fold (Expression.snd (a:=.bool) >>> p) Rl
      (fun S x => width x≤T.eval S ∧ Q S x.2) ?_ T ?_ ?_ ?_
    · apply polySafe_compose _ _ _ Q
        (polySafe_of_controlled Expression.snd (by control) _ T (by intro S x hx; exact hx.1)) hp
      intro n O S x hx y hy
      cases hy
      exact hx.2
    · intro S x hx
      obtain ⟨xs,z⟩ := x
      have hh : xs.length+width (a:=a) z≤g.eval S := hinput S xs.length z hx
      rw [width_pair (a:=.list .bool) (b:=a),width_list_bool]
      dsimp [T,SizePolynomial.eval]
      omega
    · intro n O S xs z hx pre post he y hy
      rw [foldValue_iterateM] at hy
      have hj : pre.length≤xs.length := by rw [he,List.length_append]; omega
      have hh := hacc O S xs.length z hx pre.length hj y hy
      dsimp [T,SizePolynomial.eval]
      omega
    · intro n O S xs z hx pre b post he y hy
      rw [foldValue_iterateM] at hy
      have hj : pre.length<xs.length := by rw [he,List.length_append,List.length_cons]; omega
      have hh := hacc O S xs.length z hx pre.length hj.le y hy
      refine ⟨?_,hbody O S xs.length z hx pre.length hj y hy⟩
      rw [width_pair (a:=.bool) (b:=a),width_bool]
      dsimp [T,SizePolynomial.eval]
      omega
  unfold iterateNat iterateWord
  apply polySafe_compose _ _ R Rw hu
  · apply polySafe_compose _ _ Rw Rl
      (polySafe_of_controlled _ (by unfold onLeft; control) Rw T hw) hfold
    intro n O S x hx y hy
    cases hy
    exact hx
  · intro n O S x hx y hy
    obtain ⟨k,z⟩ := x
    obtain ⟨w,hw,hk⟩ := run_unary O k
    simp only [onLeft,run_both,run_compose,run_fst,run_snd,Option.bind_some,hw,Option.map_some] at hy
    cases hy
    change R S (w.length,z)
    rwa [hk]

lemma iterateM_total {A : Type*} (p : A → Option A) (f : A → A)
    (hp : ∀ x,p x=some (f x)) (k : ℕ) (x : A) : iterateM p k x=some ((f^[k]) x) := by
  induction k generalizing x with
  | zero => rfl
  | succ k ih => rw [iterateM,hp,Option.bind_some,ih,Function.iterate_succ_apply]
lemma width_list_le {a : DataType} (xs : List (Value a)) (S : ℕ)
    (hs : ∀ x∈xs,width (a:=a) x≤S) : width (a:=.list a) xs≤xs.length*(2*S+2) := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    have hx := hs x (by simp)
    have hh := ih (fun y hy => hs y (by simp [hy]))
    rw [width_cons (a:=a),List.length_cons,Nat.add_mul,Nat.one_mul]
    omega
lemma width_range (k : ℕ) : width (a:=.list .nat) (List.range k)≤k*(2*k+2) := by
  simpa only [List.length_range] using width_list_le (a:=.nat) (List.range k) k (by
    intro x hx
    exact (bits_length_le_value x).trans (List.mem_range.mp hx).le)
lemma width_rangeState (k : ℕ) : width (a:=.prod .nat (.list .nat)) (k,(List.range k).reverse)≤4*(k+1)^2 := by
  rw [width_pair (a:=.nat) (b:=.list .nat),width_nat,width_list_reverse (a:=.nat)]
  have h := width_range k
  have h' := bits_length_le_value k
  nlinarith
lemma controlled_rangeStep : Controlled rangeStepCode := by unfold rangeStepCode; control
lemma polySafe_rangeCode : PolySafe rangeCode (fun S k => k≤S) := by
  let g : SizePolynomial := .mul (.constant 10) (.mul (.add .input (.constant 1)) (.add .input (.constant 1)))
  have hg (S : ℕ) : g.eval S=10*(S+1)^2 := by simp [g,SizePolynomial.eval,pow_two]
  let R : ℕ → Value (.prod .nat (.prod .nat (.list .nat))) → Prop := fun S x => x.1≤S ∧ x.2=(0,[])
  have hi : PolySafe (iterateNat rangeStepCode) R := by
    refine polySafe_iterateNat rangeStepCode R (fun S z => width z≤g.eval S)
      (polySafe_of_controlled _ controlled_rangeStep _ g (by intros; assumption)) g ?_ ?_ ?_
    · intro S k z hx
      dsimp [R] at hx
      rcases hx with ⟨hk,rfl⟩
      rw [hg]
      change k+1≤10*(S+1)^2
      exact (Nat.add_le_add_right hk 1).trans (by nlinarith)
    · intro n O S k z hx j hj y hy
      dsimp [R] at hx
      rcases hx with ⟨hk,rfl⟩
      rw [iterateM_total (run O rangeStepCode) rangeStep (fun _ => rfl),rangeStep_iterate] at hy
      cases hy
      apply (width_rangeState j).trans
      rw [hg]
      have hjk : Nat.le j S := hj.trans hk
      exact (Nat.mul_le_mul_left 4 (Nat.pow_le_pow_left (Nat.add_le_add_right hjk 1) 2)).trans
        (Nat.mul_le_mul_right _ (by decide : 4≤10))
    · intro n O S k z hx j hj y hy
      dsimp [R] at hx
      rcases hx with ⟨hk,rfl⟩
      rw [iterateM_total (run O rangeStepCode) rangeStep (fun _ => rfl),rangeStep_iterate] at hy
      cases hy
      apply (width_rangeState j).trans
      rw [hg]
      have hjk : Nat.le j S := hj.le.trans hk
      exact (Nat.mul_le_mul_left 4 (Nat.pow_le_pow_left (Nat.add_le_add_right hjk 1) 2)).trans
        (Nat.mul_le_mul_right _ (by decide : 4≤10))
  unfold rangeCode
  apply polySafe_compose _ _ _ R
    (polySafe_of_controlled _ (by control) _ .input (by
      intro S k hk
      exact (bits_length_le_value k).trans hk))
    (polySafe_post _ _ R hi (controlled_compose _ _ (by control) controlled_listReverse))
  intro n O S x hx y hy
  cases hy
  exact ⟨hx,rfl⟩
lemma controlled_wordRange : Controlled (wordLength >>> rangeCode) := by
  apply polySafe_controlled
  apply polySafe_compose _ _ _ (fun S k => k≤S)
    (polySafe_of_controlled _ controlled_wordLength _ .input (by intros; assumption)) polySafe_rangeCode
  intro n O S x hx y hy
  rw [run_wordLength] at hy
  cases hy
  exact hx

lemma run_filterStep_partial {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression (.prod a b) .bool) (x : Value a) (ys : List (Value a)) (z : Value b) :
    run O (filterStep p) (x,(ys,z))=(run O p (x,z)).map (fun t => ((if t then x::ys else ys),z)) := by
  simp only [filterStep,run_both,run_applyIf,run_compose,run_fst,run_snd,Option.bind_some,Option.map_some]
  cases he : run O p (x,z) with
  | none => rfl
  | some t => cases t <;> rfl
lemma fold_filterStep_bound {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (p : Expression (.prod a b) .bool) (xs ys : List (Value a)) (z : Value b)
    (v : Value (.prod (.list a) b)) (hv : foldValue (run O (filterStep p)) xs (ys,z)=some v) :
    width (a:=.list a) v.1≤width (a:=.list a) xs+width (a:=.list a) ys ∧ v.2=z := by
  induction xs generalizing ys with
  | nil => cases hv; simp
  | cons x xs ih =>
    rw [foldValue,run_filterStep_partial] at hv
    cases he : run O p (x,z) with
    | none => simp [he] at hv
    | some t =>
      simp only [he,Option.map_some,Option.bind_some] at hv
      cases t with
      | false =>
        have hh := ih ys hv
        rw [width_cons (a:=a)]
        exact ⟨by omega,hh.2⟩
      | true =>
        have hh := ih (x::ys) hv
        rw [width_cons (a:=a)] at hh ⊢
        exact ⟨by omega,hh.2⟩
lemma controlled_filterStep {a b : DataType} (p : Expression (.prod a b) .bool) (hp : Controlled p) :
    Controlled (filterStep p) := by unfold filterStep; control
lemma controlled_filterFold {a b : DataType} (p : Expression (.prod a b) .bool) (hp : Controlled p) :
    Controlled (.fold (filterStep p)) := by
  apply controlled_fold _ (controlled_filterStep p hp) (.mul (.constant 3) .input)
  intro n O xs z pre post he y hy
  obtain ⟨ys,ctx⟩ := z
  have hh := fold_filterStep_bound O p pre ys ctx y hy
  have hpre : width (a:=.list a) pre≤width (a:=.list a) xs := by rw [he,width_list_append]; omega
  obtain ⟨out,outctx⟩ := y
  dsimp only [Prod.fst,Prod.snd] at hh
  rw [width_pair (a:=.list a) (b:=b),width_pair (a:=.list a) (b:=.prod (.list a) b),
    width_pair (a:=.list a) (b:=b),hh.2]
  dsimp [SizePolynomial.eval]
  omega
lemma controlled_filterWith {a b : DataType} (p : Expression (.prod a b) .bool) (hp : Controlled p) :
    Controlled (filterWith p) := by
  unfold filterWith
  have hf := controlled_filterFold p hp
  have hr := controlled_listReverse (a:=a)
  control

open scoped Classical
noncomputable def stateEncode {n : ℕ} (S : Set (Fin n⊕Fin n)) : Value StateData :=
  (List.ofFn (fun i => decide (Sum.inl i∈S)),List.ofFn (fun i => decide (Sum.inr i∈S)))
@[simp] lemma stateEncode_left_length {n : ℕ} (S : Set (Fin n⊕Fin n)) :
    (stateEncode S).1.length=n := List.length_ofFn
@[simp] lemma stateEncode_right_length {n : ℕ} (S : Set (Fin n⊕Fin n)) :
    (stateEncode S).2.length=n := List.length_ofFn
@[simp] lemma stateEncode_repr {n : ℕ} (S : Set (Fin n⊕Fin n)) :
    representedState n (stateEncode S)=S := by
  ext i
  cases i <;> simp [representedState,stateEncode,wordSet]
lemma stateEncode_get_left {n : ℕ} (S : Set (Fin n⊕Fin n)) (i : Fin n) :
    (stateEncode S).1[i.val]?.getD false=decide (Sum.inl i∈S) := by simp [stateEncode]
lemma stateEncode_get_right {n : ℕ} (S : Set (Fin n⊕Fin n)) (i : Fin n) :
    (stateEncode S).2[i.val]?.getD false=decide (Sum.inr i∈S) := by simp [stateEncode]

namespace Expression

def boolXor : Expression (.prod .bool .bool) .bool := branch ident boolNot
lemma run_boolXor {n : ℕ} (O : IndependenceOracle n) (a b : Bool) :
    run O boolXor (a,b)=some (xor a b) := by cases a <;> cases b <;> rfl

def singleAt : Expression (.prod .nat StateData) .bool :=
  both (both (snd >>> fst) fst >>> wordGet) (both (snd >>> snd) fst >>> wordGet) >>> boolXor
def fullAt : Expression (.prod .nat StateData) .bool :=
  both (both (snd >>> fst) fst >>> wordGet) (both (snd >>> snd) fst >>> wordGet) >>> boolAnd
def emptyAt : Expression (.prod .nat StateData) .bool :=
  both (both (snd >>> fst) fst >>> wordGet) (both (snd >>> snd) fst >>> wordGet) >>> boolOr >>> boolNot

def singleValue (i : ℕ) (S : Word×Word) : Bool := xor (S.1[i]?.getD false) (S.2[i]?.getD false)
def fullValue (i : ℕ) (S : Word×Word) : Bool := (S.1[i]?.getD false) && (S.2[i]?.getD false)
def emptyValue (i : ℕ) (S : Word×Word) : Bool := !(S.1[i]?.getD false || S.2[i]?.getD false)
lemma run_singleAt {n : ℕ} (O : IndependenceOracle n) (i : ℕ) (S : Word×Word) :
    run O singleAt (i,S)=some (singleValue i S) := by
  simp only [singleAt,run_compose,run_both,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [run_wordGet,run_wordGet]
  exact run_boolXor O _ _
lemma run_fullAt {n : ℕ} (O : IndependenceOracle n) (i : ℕ) (S : Word×Word) :
    run O fullAt (i,S)=some (fullValue i S) := by
  simp only [fullAt,run_compose,run_both,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [run_wordGet,run_wordGet]
  exact run_boolAnd O _ _
lemma run_emptyAt {n : ℕ} (O : IndependenceOracle n) (i : ℕ) (S : Word×Word) :
    run O emptyAt (i,S)=some (emptyValue i S) := by
  simp only [emptyAt,run_compose,run_both,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [run_wordGet,run_wordGet]
  change ((run O boolOr _).bind (run O boolNot))=_
  rw [run_boolOr]; exact run_boolNot O _

def plainValue (S : Word×Word) : Bool := ((List.range S.1.length).map (fun i => singleValue i S)).all id
def plainCode : Expression StateData .bool :=
  both (fst >>> wordLength >>> rangeCode) ident >>> mapWith singleAt >>> listAll
lemma run_plainCode {n : ℕ} (O : IndependenceOracle n) (S : Word×Word) :
    run O plainCode S=some (plainValue S) := by
  simp only [plainCode,run_compose,run_both,run_fst,run_ident,Option.bind_some,Option.map_some]
  rw [run_wordLength,Option.bind_some,run_rangeCode]
  change ((run O (mapWith singleAt) (List.range S.1.length,S)).bind (run O listAll))=_
  rw [run_mapWith O singleAt singleValue (run_singleAt O)]
  exact run_listAll O _
end Expression

lemma singleValue_source {n : ℕ} (S : Set (Fin n⊕Fin n)) (i : Fin n) :
    Expression.singleValue i.val (stateEncode S)=decide (PairSingle (slotPair i) S) := by
  rw [Expression.singleValue,stateEncode_get_left,stateEncode_get_right]
  unfold PairSingle slotPair
  by_cases ha : Sum.inl i∈S <;> by_cases hb : Sum.inr i∈S <;> simp [ha,hb]
lemma fullValue_source {n : ℕ} (S : Set (Fin n⊕Fin n)) (i : Fin n) :
    Expression.fullValue i.val (stateEncode S)=decide (PairFull (slotPair i) S) := by
  rw [Expression.fullValue,stateEncode_get_left,stateEncode_get_right]
  unfold PairFull slotPair
  by_cases ha : Sum.inl i∈S <;> by_cases hb : Sum.inr i∈S <;> simp [ha,hb]
lemma emptyValue_source {n : ℕ} (S : Set (Fin n⊕Fin n)) (i : Fin n) :
    Expression.emptyValue i.val (stateEncode S)=decide (PairEmpty (slotPair i) S) := by
  rw [Expression.emptyValue,stateEncode_get_left,stateEncode_get_right]
  unfold PairEmpty slotPair
  by_cases ha : Sum.inl i∈S <;> by_cases hb : Sum.inr i∈S <;> simp [ha,hb]

lemma plainValue_source {n : ℕ} (S : Set (Fin n⊕Fin n)) :
    Expression.plainValue (stateEncode S)=decide (PlainState (pairedSlots n) S) := by
  apply Bool.eq_iff_iff.mpr
  simp only [Expression.plainValue,List.all_map,List.all_eq_true,Function.comp_apply,id_eq,
    stateEncode_left_length,List.mem_range,decide_eq_true_eq]
  constructor
  · intro h p hp
    obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hp
    have hh := h i.val i.isLt
    rw [singleValue_source] at hh
    exact of_decide_eq_true hh
  · intro h i hi
    rw [singleValue_source S ⟨i,hi⟩]
    exact decide_eq_true (h _ (by simp [pairedSlots]))

lemma plainCode_source {n : ℕ} (O : IndependenceOracle n) (S : Set (Fin n⊕Fin n)) :
    run O Expression.plainCode (stateEncode S)=some (decide (PlainState (pairedSlots n) S)) := by
  rw [Expression.run_plainCode,plainValue_source]

abbrev DefectInput := DataType.prod Expression.NN StateData
namespace Expression

def defectAt : Expression (.prod .nat DefectInput) .bool :=
  applyIf (both fst (snd >>> fst >>> fst) >>> natEqual)
    (applyIf (both fst (snd >>> fst >>> snd) >>> natEqual)
      (both fst (snd >>> snd) >>> singleAt) (both fst (snd >>> snd) >>> fullAt))
    (both fst (snd >>> snd) >>> emptyAt)
def defectAtValue (i : ℕ) (p : (ℕ×ℕ)×(Word×Word)) : Bool :=
  if i=p.1.1 then emptyValue i p.2 else if i=p.1.2 then fullValue i p.2 else singleValue i p.2
lemma run_defectAt {n : ℕ} (O : IndependenceOracle n) (i p r : ℕ) (S : Word×Word) :
    run O defectAt (i,((p,r),S))=some (defectAtValue i ((p,r),S)) := by
  simp only [defectAt,run_applyIf,run_compose,run_both,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [run_natEqual]
  by_cases hi : i=p
  · subst i; simp only [decide_true,Option.bind_some,ite_true]; simpa only [defectAtValue,ite_true] using run_emptyAt O p S
  · simp only [hi,decide_false,Option.bind_some,Bool.false_eq_true,ite_false]
    rw [run_natEqual]
    by_cases hr : i=r
    · subst i; simp only [decide_true,Option.bind_some,ite_true]
      simpa only [defectAtValue,hi,ite_false,ite_true] using run_fullAt O r S
    · simp only [hr,decide_false,Option.bind_some,Bool.false_eq_true,ite_false]
      simpa only [defectAtValue,hi,hr,ite_false] using run_singleAt O i S

def defectValue (p r : ℕ) (S : Word×Word) : Bool :=
  decide (p≠r) && ((List.range S.1.length).map (fun i => defectAtValue i ((p,r),S))).all id
def defectCode : Expression DefectInput .bool :=
  both (fst >>> natEqual >>> boolNot)
    (both (snd >>> fst >>> wordLength >>> rangeCode) ident >>> mapWith defectAt >>> listAll) >>> boolAnd
lemma run_defectCode {n : ℕ} (O : IndependenceOracle n) (p r : ℕ) (S : Word×Word) :
    run O defectCode ((p,r),S)=some (defectValue p r S) := by
  simp only [defectCode,run_compose,run_both,run_fst,run_snd,run_ident,Option.bind_some,Option.map_some]
  rw [run_natEqual,run_wordLength]
  simp only [Option.bind_some]
  rw [run_rangeCode]
  simp only [Option.bind_some,run_boolNot,run_compose]
  rw [run_mapWith O defectAt defectAtValue (by intro i v; rcases v with ⟨⟨p,r⟩,S⟩; exact run_defectAt O i p r S)]
  simp only [Option.bind_some,run_listAll,Option.map_some]
  rw [run_boolAnd]
  congr 1
  simp only [defectValue,decide_not]
end Expression

lemma slotPair_inj {α : Type*} (i j : α) : slotPair i=slotPair j ↔ i=j := by simp [slotPair]
lemma slotPair_mem {n : ℕ} (i : Fin n) : slotPair i∈pairedSlots n := by simp [pairedSlots]
lemma defect_paired_iff {n : ℕ} (p r : Fin n) (S : Set (Fin n⊕Fin n)) :
    DefectState (pairedSlots n) (slotPair p) (slotPair r) S ↔
      p≠r ∧ PairEmpty (slotPair p) S ∧ PairFull (slotPair r) S ∧
      ∀ i, i≠p → i≠r → PairSingle (slotPair i) S := by
  constructor
  · intro h
    refine ⟨fun hp => h.2.2.1 (congrArg slotPair hp),h.2.2.2.1,h.2.2.2.2.1,?_⟩
    intro i hip hir
    exact h.2.2.2.2.2 (slotPair i) (slotPair_mem i) (fun he => hip ((slotPair_inj i p).mp he)) (fun he => hir ((slotPair_inj i r).mp he))
  · rintro ⟨hpr,hp,hr,h⟩
    refine ⟨slotPair_mem p,slotPair_mem r,fun he => hpr ((slotPair_inj p r).mp he),hp,hr,?_⟩
    intro t ht htp htr
    obtain ⟨i,hi,rfl⟩ := List.mem_map.mp ht
    exact h i (fun he => htp (congrArg slotPair he)) (fun he => htr (congrArg slotPair he))

lemma defectValue_source {n : ℕ} (S : Set (Fin n⊕Fin n)) (p r : Fin n) :
    Expression.defectValue p.val r.val (stateEncode S)=
      decide (DefectState (pairedSlots n) (slotPair p) (slotPair r) S) := by
  apply Bool.eq_iff_iff.mpr
  simp only [Expression.defectValue,Bool.and_eq_true,decide_eq_true_eq,List.all_map,List.all_eq_true,
    Function.comp_apply,id_eq,stateEncode_left_length,List.mem_range]
  rw [defect_paired_iff]
  constructor
  · rintro ⟨hne,h⟩
    have hpr : p≠r := fun he => hne (congrArg Fin.val he)
    refine ⟨hpr,?_,?_,?_⟩
    · have hh := h p.val p.isLt
      simpa only [Expression.defectAtValue,ite_true,emptyValue_source,decide_eq_true_eq] using hh
    · have hh := h r.val r.isLt
      have hrp : r.val≠p.val := Ne.symm hne
      simpa only [Expression.defectAtValue,hrp,ite_false,ite_true,fullValue_source,decide_eq_true_eq] using hh
    · intro i hip hir
      have hh := h i.val i.isLt
      have hip' : i.val≠p.val := fun he => hip (Fin.ext he)
      have hir' : i.val≠r.val := fun he => hir (Fin.ext he)
      simpa only [Expression.defectAtValue,hip',hir',ite_false,singleValue_source,decide_eq_true_eq] using hh
  · rintro ⟨hpr,hp,hr,h⟩
    refine ⟨fun he => hpr (Fin.ext he),?_⟩
    intro i hi
    let j : Fin n := ⟨i,hi⟩
    change Expression.defectAtValue j.val ((p.val,r.val),stateEncode S)=true
    by_cases hjp : j=p
    · subst p
      simpa only [Expression.defectAtValue,ite_true,emptyValue_source,decide_eq_true_eq] using hp
    · by_cases hjr : j=r
      · subst r
        have hne : j.val≠p.val := fun he => hjp (Fin.ext he)
        simpa only [Expression.defectAtValue,hne,ite_false,ite_true,fullValue_source,decide_eq_true_eq] using hr
      · have hip : j.val≠p.val := fun he => hjp (Fin.ext he)
        have hir : j.val≠r.val := fun he => hjr (Fin.ext he)
        simpa only [Expression.defectAtValue,hip,hir,ite_false,singleValue_source,decide_eq_true_eq] using h j hjp hjr

lemma defectCode_source {n : ℕ} (O : IndependenceOracle n) (S : Set (Fin n⊕Fin n)) (p r : Fin n) :
    run O Expression.defectCode ((p.val,r.val),stateEncode S)=
      some (decide (DefectState (pairedSlots n) (slotPair p) (slotPair r) S)) := by
  rw [Expression.run_defectCode,defectValue_source]

abbrev SampleData := DataType.list StateData
abbrev HistoryData := DataType.list SampleData
namespace Expression

def countWith {a b} (p : Expression (.prod a b) .bool) : Expression (.prod (.list a) b) .nat :=
  filterWith p >>> listLength
lemma run_countWith {n : ℕ} (O : IndependenceOracle n) {a b} (p : Expression (.prod a b) .bool)
    (f : Value a → Value b → Bool) (hp : ∀ x z,run O p (x,z)=some (f x z))
    (xs : List (Value a)) (z : Value b) :
    run O (countWith p) (xs,z)=some (xs.countP (fun x => f x z)) := by
  rw [countWith,run_compose,run_filterWith O p f hp,Option.bind_some,run_listLength]
  simp only [List.countP_eq_length_filter]

def countPlainCode : Expression SampleData .nat :=
  both ident (constant (b:=.unit) ()) >>> countWith (fst >>> plainCode)
def countDefectCode : Expression (.prod SampleData NN) .nat := countWith (swap >>> defectCode)
def countPlainValue (xs : List (Word×Word)) : ℕ := xs.countP plainValue
def countDefectValue (xs : List (Word×Word)) (p r : ℕ) : ℕ := xs.countP (fun S => defectValue p r S)
lemma run_countPlainCode {n : ℕ} (O : IndependenceOracle n) (xs : List (Word×Word)) :
    run O countPlainCode xs=some (countPlainValue xs) := by
  change run O (countWith (fst (b:=.unit) >>> plainCode)) (xs,())=_
  exact run_countWith (a:=StateData) (b:=.unit) O _ (fun x (_ : Unit) => plainValue x) (fun x _ => run_plainCode O x) xs ()
lemma run_countDefectCode {n : ℕ} (O : IndependenceOracle n) (xs : List (Word×Word)) (p r : ℕ) :
    run O countDefectCode (xs,(p,r))=some (countDefectValue xs p r) := by
  exact run_countWith (a:=StateData) (b:=NN) O _ (fun S u => defectValue u.1 u.2 S)
    (fun S u => run_defectCode O u.1 u.2 S) xs (p,r)

def learningRatioCode : Expression (.prod SampleData NN) NN :=
  both (fst >>> countPlainCode) countDefectCode >>> normalizeRat
def learningRatio (xs : List (Word×Word)) (p r : ℕ) : ℚ := (countPlainValue xs:ℚ)/countDefectValue xs p r
lemma learningRatio_nonneg (xs : List (Word×Word)) (p r : ℕ) : 0≤learningRatio xs p r := by
  unfold learningRatio; positivity
lemma run_learningRatio {n : ℕ} (O : IndependenceOracle n) (xs : List (Word×Word)) (p r : ℕ) :
    run O learningRatioCode (xs,(p,r))=some (rationalPair (learningRatio xs p r)) := by
  simp only [learningRatioCode,run_compose,run_both,run_fst,Option.bind_some]
  rw [run_countPlainCode,run_countDefectCode]
  exact run_normalizeRat_pair O _ _

def weightStep : Expression (.prod SampleData (.prod NN NN)) (.prod NN NN) :=
  both (snd >>> fst)
    (applyIf (snd >>> fst >>> natEqual)
      (both (snd >>> snd) (both fst (snd >>> fst) >>> learningRatioCode) >>> ratMul)
      (snd >>> snd))
def weightUpdate (p r : ℕ) (xs : List (Word×Word)) (q : ℚ) : ℚ :=
  if p=r then q else q*learningRatio xs p r
lemma weightUpdate_nonneg (p r : ℕ) (xs : List (Word×Word)) (q : ℚ) (hq : 0≤q) :
    0≤weightUpdate p r xs q := by
  unfold weightUpdate
  split_ifs
  · exact hq
  · exact mul_nonneg hq (learningRatio_nonneg xs p r)
lemma run_weightStep {n : ℕ} (O : IndependenceOracle n) (p r : ℕ) (xs : List (Word×Word)) (q : ℚ) (hq : 0≤q) :
    run O weightStep (xs,((p,r),rationalPair q))=some ((p,r),rationalPair (weightUpdate p r xs q)) := by
  simp only [weightStep,run_both,run_compose,run_fst,run_snd,Option.bind_some,run_applyIf]
  rw [run_natEqual]
  by_cases hpr : p=r
  · subst p; simp only [decide_true,Option.bind_some,ite_true,Option.map_some,weightUpdate]
  · simp only [hpr,decide_false,Option.bind_some,Option.map_some,Bool.false_eq_true,ite_false]
    rw [run_learningRatio]
    simp only [Option.bind_some,Option.map_some]
    rw [run_ratMul O q _ hq (learningRatio_nonneg xs p r)]
    simp only [Option.map_some,weightUpdate,hpr,ite_false]

def historyWeightValue (p r : ℕ) (h : List (List (Word×Word))) : ℚ :=
  h.foldl (fun q xs => weightUpdate p r xs q) 4
def historyWeightCode : Expression (.prod HistoryData NN) NN :=
  both fst (both snd (constant (b:=NN) (4,1))) >>> fold weightStep >>> snd
lemma fold_weightStep {n : ℕ} (O : IndependenceOracle n) (p r : ℕ) (h : List (List (Word×Word)))
    (q : ℚ) (hq : 0≤q) :
    foldValue (run O weightStep) h ((p,r),rationalPair q)=some
      ((p,r),rationalPair (h.foldl (fun q xs => weightUpdate p r xs q) q)) := by
  induction h generalizing q with
  | nil => rfl
  | cons xs h ih =>
    rw [foldValue,run_weightStep O p r xs q hq,Option.bind_some]
    exact ih _ (weightUpdate_nonneg p r xs q hq)
lemma run_historyWeightCode {n : ℕ} (O : IndependenceOracle n) (p r : ℕ) (h : List (List (Word×Word))) :
    run O historyWeightCode (h,(p,r))=some (rationalPair (historyWeightValue p r h)) := by
  change ((foldValue (run O weightStep) h ((p,r),rationalPair 4)).bind fun z => some z.2)=_
  rw [fold_weightStep O p r h 4 (by norm_num)]
  rfl
end Expression

noncomputable def sampleEncode {n : ℕ} (xs : List (Set (Fin n⊕Fin n))) : Value SampleData := xs.map stateEncode
noncomputable def historyEncode {n : ℕ} (h : List (List (Set (Fin n⊕Fin n)))) : Value HistoryData := h.map sampleEncode
lemma countPlainValue_source {n : ℕ} (xs : List (Set (Fin n⊕Fin n))) :
    Expression.countPlainValue (sampleEncode xs)=xs.countP (fun S => decide (PlainState (pairedSlots n) S)) := by
  simp only [Expression.countPlainValue,sampleEncode,List.countP_map,plainValue_source,Function.comp_def]
lemma countDefectValue_source {n : ℕ} (xs : List (Set (Fin n⊕Fin n))) (p r : Fin n) :
    Expression.countDefectValue (sampleEncode xs) p.val r.val=
      xs.countP (fun S => decide (DefectState (pairedSlots n) (slotPair p) (slotPair r) S)) := by
  simp only [Expression.countDefectValue,sampleEncode,List.countP_map,defectValue_source,Function.comp_def]

lemma weightUpdate_source {n : ℕ} (xs : List (Set (Fin n⊕Fin n))) (p r : Fin n)
    (w : ((Fin n⊕Fin n)×(Fin n⊕Fin n)) → ((Fin n⊕Fin n)×(Fin n⊕Fin n)) → ℚ) :
    Expression.weightUpdate p.val r.val (sampleEncode xs) (w (slotPair p) (slotPair r))=
      rationalLearn (pairedSlots n) w xs (slotPair p) (slotPair r) := by
  unfold Expression.weightUpdate rationalLearn
  by_cases hpr : p=r
  · subst p; simp
  · have hv : p.val≠r.val := fun he => hpr (Fin.ext he)
    have hs : slotPair p≠slotPair r := fun he => hpr ((slotPair_inj p r).mp he)
    rw [ite_eq_right hv,ite_eq_left ⟨slotPair_mem p,slotPair_mem r,hs⟩,rationalTypeRatio]
    rw [Expression.learningRatio,countPlainValue_source,countDefectValue_source]

lemma historyWeight_source {n : ℕ} (h : List (List (Set (Fin n⊕Fin n)))) (p r : Fin n) :
    Expression.historyWeightValue p.val r.val (historyEncode h)=
      rationalHistory (pairedSlots n) id h (slotPair p) (slotPair r) := by
  have hf : ∀ (l : List (List (Set (Fin n⊕Fin n))))
      (w : ((Fin n⊕Fin n)×(Fin n⊕Fin n)) → ((Fin n⊕Fin n)×(Fin n⊕Fin n)) → ℚ),
      (historyEncode l).foldl (fun q xs => Expression.weightUpdate p.val r.val xs q) (w (slotPair p) (slotPair r))=
        (l.foldl (fun w xs => rationalLearn (pairedSlots n) w xs) w) (slotPair p) (slotPair r) := by
    intro l
    induction l with
    | nil => intro w; rfl
    | cons xs l ih =>
      intro w
      change (historyEncode l).foldl _ (Expression.weightUpdate p.val r.val (sampleEncode xs) (w (slotPair p) (slotPair r)))=_
      rw [weightUpdate_source]
      exact ih _
  exact hf h (fun _ _ => 4)

lemma historyWeightCode_source {n : ℕ} (O : IndependenceOracle n)
    (h : List (List (Set (Fin n⊕Fin n)))) (p r : Fin n) :
    run O Expression.historyWeightCode (historyEncode h,(p.val,r.val))=
      some (rationalPair (rationalHistory (pairedSlots n) id h (slotPair p) (slotPair r))) := by
  rw [Expression.run_historyWeightCode,historyWeight_source]

namespace Expression

def listAppend {a} : Expression (.prod (.list a) (.list a)) (.list a) :=
  onLeft listReverse >>> fold cons
lemma run_listAppend {n : ℕ} (O : IndependenceOracle n) {a} (xs ys : List (Value a)) :
    run O listAppend (xs,ys)=some (xs++ys) := by
  have hf : ∀ (us vs : List (Value a)),foldValue (run O cons) us vs=some (us.reverse++vs) := by
    intro us
    induction us with
    | nil => intro vs; rfl
    | cons u us ih => intro vs; simpa [foldValue,run,List.reverse_cons,List.append_assoc] using ih (u::vs)
  simp only [listAppend,onLeft,run_compose,run_both,run_fst,run_snd,Option.bind_some]
  rw [run_listReverse]
  simp only [Option.bind_some,Option.map_some]
  change foldValue (run O cons) xs.reverse ys=_
  rw [hf,List.reverse_reverse]

def productStep {a b} : Expression (.prod a (.prod (.list (.prod a b)) (.list b)))
    (.prod (.list (.prod a b)) (.list b)) :=
  both (both (snd >>> fst) (both (snd >>> snd) fst >>> mapWith swap) >>> listAppend) (snd >>> snd)
def productCode {a b} : Expression (.prod (.list a) (.list b)) (.list (.prod a b)) :=
  both fst (both (constant []) snd) >>> fold productStep >>> fst
lemma run_productStep {n : ℕ} (O : IndependenceOracle n) {a b}
    (x : Value a) (zs : List (Value a × Value b)) (ys : List (Value b)) :
    run O productStep (x,(zs,ys))=some (zs++ys.map (fun y => (x,y)),ys) := by
  simp only [productStep,run_both,run_compose,run_fst,run_snd,Option.bind_some,Option.map_some]
  rw [run_mapWith O swap (fun y x => (x,y)) (fun _ _ => rfl)]
  simp only [Option.map_some,Option.bind_some]
  rw [run_listAppend]
  rfl
lemma run_productCode {n : ℕ} (O : IndependenceOracle n) {a b}
    (xs : List (Value a)) (ys : List (Value b)) :
    run O productCode (xs,ys)=some ((xs ×ˢ ys)) := by
  have hf : ∀ (us : List (Value a)) (acc : List (Value a × Value b)),
      foldValue (run O productStep) us (acc,ys)=some (acc++(us ×ˢ ys),ys) := by
    intro us
    induction us with
    | nil => intro acc; simp [foldValue]
    | cons u us ih =>
      intro acc
      rw [foldValue,run_productStep,Option.bind_some,ih]
      simp [List.product_cons,List.append_assoc]
  change ((foldValue (run O productStep) xs ([],ys)).bind fun z => some z.1)=_
  rw [hf]
  rfl

def indexPairs : Expression .nat (.list NN) := both rangeCode rangeCode >>> productCode
lemma run_indexPairs {n : ℕ} (O : IndependenceOracle n) (k : ℕ) :
    run O indexPairs k=some ((List.range k) ×ˢ (List.range k)) := by
  simp only [indexPairs,run_compose,run_both]
  rw [run_rangeCode]
  simp only [Option.bind_some,Option.map_some]
  exact run_productCode O _ _
end Expression

open Expression
lemma controlled_listAppend {a : DataType} : Controlled (listAppend (a:=a)) := by
  unfold listAppend
  apply controlled_compose
  · exact controlled_onLeft _ controlled_listReverse
  · apply controlled_fold (Expression.cons (a:=a)) (controlled_atomic _ trivial) (.mul (.constant 2) .input)
    intro n O xs z pre post he y hy
    have hh := foldValue_eq_foldl (run O (cons (a:=a))) (fun z x => x::z) (fun _ _ => rfl) pre z
    rw [hh] at hy
    cases hy
    rw [List.foldl_flip_cons_eq_append',width_list_append,width_list_reverse]
    have hp : width (a:=.list a) pre≤width (a:=.list a) xs := by rw [he,width_list_append]; omega
    rw [width_pair (a:=.list a) (b:=.list a)]
    dsimp [SizePolynomial.eval]
    omega
lemma width_list_map_pair {a b : DataType} (x : Value a) (ys : List (Value b)) :
    width (a:=.list (.prod a b)) (ys.map (fun y => (x,y)))≤
      4*(width x+1)*(width (a:=.list b) ys+1) := by
  have he : width (a:=.list (.prod a b)) (ys.map (fun y => (x,y)))=
      (4*width x+2)*ys.length+width (a:=.list b) ys := by
    induction ys with
    | nil => rfl
    | cons y ys ih =>
      simp only [List.map_cons,width_cons (a:=.prod a b),width_pair (a:=a) (b:=b),ih,
        List.length_cons,width_cons (a:=b)]
      ring
  rw [he]
  have hl := list_length_le_width ys
  nlinarith
lemma width_list_product {a b : DataType} (xs : List (Value a)) (ys : List (Value b)) :
    width (a:=.list (.prod a b)) (xs ×ˢ ys)≤
      8*(width (a:=.list a) xs+1)*(width (a:=.list b) ys+1) := by
  have hh : width (a:=.list (.prod a b)) (xs ×ˢ ys)≤
      4*width (a:=.list a) xs*(width (a:=.list b) ys+1) := by
    induction xs with
    | nil => simp only [List.nil_product,width_nil (a:=.prod a b)]; omega
    | cons x xs ih =>
      rw [List.product_cons,width_list_append (a:=.prod a b)]
      have hx := width_list_map_pair x ys
      rw [width_cons (a:=a)]
      nlinarith
  nlinarith
lemma controlled_productStep {a b : DataType} : Controlled (productStep (a:=a) (b:=b)) := by
  have hm := controlled_mapWith (Expression.swap (a:=b) (b:=a)) controlled_swap
  have ha := controlled_listAppend (a:=.prod a b)
  unfold productStep
  control
lemma fold_productStep {n : ℕ} (O : IndependenceOracle n) {a b : DataType}
    (xs : List (Value a)) (zs : List (Value a×Value b)) (ys : List (Value b)) :
    foldValue (run O (productStep (a:=a) (b:=b))) xs (zs,ys)=some (zs++(xs ×ˢ ys),ys) := by
  induction xs generalizing zs with
  | nil => simp [foldValue]
  | cons x xs ih =>
    rw [foldValue,run_productStep,Option.bind_some,ih]
    simp [List.product_cons,List.append_assoc]
lemma controlled_productCode {a b : DataType} : Controlled (productCode (a:=a) (b:=b)) := by
  unfold productCode
  apply controlled_compose
  · control
  · apply controlled_compose
    · apply controlled_fold productStep controlled_productStep
        (.mul (.constant 32) (.mul (.add .input (.constant 1)) (.add .input (.constant 1))))
      intro n O xs z pre post he y hy
      rcases z with ⟨zs,ys⟩
      rw [fold_productStep] at hy
      cases hy
      have hp : width (a:=.list a) pre≤width (a:=.list a) xs := by rw [he,width_list_append]; omega
      have hb := width_list_product pre ys
      rw [width_pair (a:=.list (.prod a b)) (b:=.list b),width_list_append,
        width_pair (a:=.list a) (b:=.prod (.list (.prod a b)) (.list b)),
        width_pair (a:=.list (.prod a b)) (b:=.list b)]
      dsimp [SizePolynomial.eval]
      nlinarith
    · control
lemma controlled_wordGet : Controlled wordGet := by
  have hg := controlled_getD (a:=.bool)
  unfold wordGet
  control
lemma controlled_wordNot : Controlled wordNot := by
  have hm := controlled_mapWith (c:=.unit) (fst >>> boolNot) (by
    apply controlled_compose; exact controlled_atomic _ trivial; exact controlled_boolNot)
  have hf := controlled_fromList
  unfold wordNot
  control
lemma controlled_wordCountStep : Controlled wordCountStep := by unfold wordCountStep; control
lemma fold_wordCount_bound {n : ℕ} (O : IndependenceOracle n) (xs : List Bool) (z y : ℕ)
    (hy : foldValue (run O wordCountStep) xs z=some y) : y≤z+xs.length := by
  induction xs generalizing z with
  | nil => cases hy; simp
  | cons b xs ih =>
    cases b with
    | false => have hh := ih z hy; simp only [List.length_cons]; omega
    | true => have hh := ih (z+1) hy; simp only [List.length_cons]; omega
lemma controlled_wordCount : Controlled wordCount := by
  unfold wordCount
  apply controlled_compose
  · control
  · apply controlled_compose
    · control
    · apply controlled_fold wordCountStep controlled_wordCountStep (.mul (.constant 2) .input)
      intro n O xs z pre post he y hy
      have hh := bits_length_mono (fold_wordCount_bound O pre z y hy)
      have ha := bits_length_add z pre.length
      have hp : pre.length≤xs.length := by rw [he,List.length_append]; omega
      have hl := bits_length_le_value pre.length
      rw [width_nat,width_pair (a:=.list .bool) (b:=.nat),width_nat,width_list_bool]
      dsimp [SizePolynomial.eval]
      omega
lemma controlled_deficiency : Controlled deficiencyCode := by
  have hl := controlled_wordLength
  have hc := controlled_wordCount
  have hn := controlled_wordNot
  have hs := controlled_natSub
  unfold deficiencyCode
  control

