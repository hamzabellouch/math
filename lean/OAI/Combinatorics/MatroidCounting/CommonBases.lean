lemma controlled_wordIndexPairs : Controlled (wordLength >>> indexPairs) := by
  apply polySafe_controlled
  apply polySafe_compose _ _ _ (fun S k => k≤S)
    (polySafe_of_controlled _ controlled_wordLength _ .input (by intros; assumption)) polySafe_indexPairs
  intro n O S x hx y hy
  rw [run_wordLength] at hy
  cases hy
  exact hx
lemma controlled_defectPairs : Controlled defectPairsCode := by
  have h := controlled_wordIndexPairs
  have hd := controlled_defectCode
