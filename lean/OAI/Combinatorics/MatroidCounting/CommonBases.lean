    exact hm.1
  · apply oracleSafe_precompose restartPrep _ restartAfterPlainScope restartRepeatScope
      (oracleSafe_controlled _ (by unfold restartPrep; cc) _ _ restartAfterPlainScope_width) safe_restartRepeat
    intro n O S z hz y hy
