theorem rankWeight_positive_directions (M : Matroid ι) (hE : M.E = Set.univ)
    (q : ℝ) (hq : 0 < q) (hq1 : q ≤ 1) (ds : List (ι → ℝ))
    (hds : ∀ a ∈ ds, ∀ i, 0 < a i) :
