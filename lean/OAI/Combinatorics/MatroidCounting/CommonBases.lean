def ClassObservable (gs : List (Γ × Γ)) (G : Set Γ → ℝ) : Prop :=
  ∀ p r S T, DefectState gs p r S → DefectState gs p r T → G S = G T

lemma projection_classObservable (gs : List (Γ × Γ)) (f G : Set Γ → ℝ) :
    ClassObservable gs (observableProjection gs f G) := by
  intro p r S T hS hT
  rw [observableProjection_defect gs f G S hS,observableProjection_defect gs f G T hT]

omit sectionInstance61 sectionInstance62 in
lemma ClassObservable.sub_const [Fintype Γ] [DecidableEq Γ] {gs : List (Γ × Γ)} {G : Set Γ → ℝ}
    (hG : ClassObservable gs G) (a : ℝ) : ClassObservable gs (fun S => G S-a) := by
  intro p r S T hS hT
  dsimp only
  rw [hG p r S T hS hT]

lemma defect_pairing_projection (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs = Set.univ) (f G H : Set Γ → ℝ)
    (hf : ∀ S,0 < f S) (hG : ClassObservable gs G)
    (p r : Γ × Γ) (hp : p ∈ gs) (hr : r ∈ gs) (hpr : p ≠ r) :
    (∑ S ∈ Finset.univ.filter (DefectState gs p r), f S*G S*H S) =
    ∑ S ∈ Finset.univ.filter (DefectState gs p r), f S*G S*observableProjection gs f H S := by
  let t := Finset.univ.filter (DefectState gs p r)
  have hz := slotDefect_pos gs f hf ∅ hgs p r hp hr hpr
  rw [slotDefect_eq_defect_sum gs hgs hcover f p r hp hr hpr] at hz
  have ht : t.Nonempty := by
    by_contra h
    have he : t = ∅ := Finset.not_nonempty_iff_eq_empty.mp h
    change 0 < ∑ S ∈ t,f S at hz
    rw [he,Finset.sum_empty] at hz
    exact lt_irrefl _ hz
  obtain ⟨T,hT⟩ := ht
  have hTp : DefectState gs p r T := (Finset.mem_filter.mp hT).2
  have hc (S : Set Γ) (hS : S ∈ t) : G S = G T :=
    hG p r S T (Finset.mem_filter.mp hS).2 hTp
  change (∑ S ∈ t,f S*G S*H S) = ∑ S ∈ t,f S*G S*observableProjection gs f H S
  calc
    _ = G T*(∑ S ∈ t,f S*H S) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro S hS
      rw [hc S hS]; ring
    _ = G T*((∑ S ∈ t,f S)*defectMean gs f H p r) := by
      congr 1
      unfold defectMean
      rw [slotDefect_eq_defect_sum gs hgs hcover f p r hp hr hpr,
        slotDefect_eq_defect_sum gs hgs hcover (fun S => f S*H S) p r hp hr hpr]
      change _ = (∑ S ∈ t,f S)*((∑ S ∈ t,f S*H S)/(∑ S ∈ t,f S))
      have hzt : (∑ S ∈ t,f S) ≠ 0 := hz.ne'
      field_simp [hzt]
    _ = _ := by
      rw [Finset.sum_mul,Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro S hS
      rw [hc S hS,observableProjection_defect gs f H S (Finset.mem_filter.mp hS).2]
      ring

lemma chain_pairing_projection (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G H : Set Γ → ℝ) (hf : ∀ S,0 < f S) (hG : ClassObservable gs G) :
    (∑ S ∈ chainStates gs,chainWeight gs w f S*G S*H S) =
      ∑ S ∈ chainStates gs,chainWeight gs w f S*G S*observableProjection gs f H S := by
  simp only [chainWeight,mul_assoc]
  rw [chain_sum_decomposition,chain_sum_decomposition]
  congr 1
  · apply Finset.sum_congr rfl
    intro S hS
    rw [observableProjection_plain gs f H S (Finset.mem_filter.mp hS).2]
  · apply Finset.sum_congr rfl
    intro pr hpr
    obtain ⟨hp,hr,hpr⟩ := (mem_defectTypes gs pr).mp hpr
    congr 1
    simpa only [mul_assoc] using defect_pairing_projection gs hgs hcover f G H hf hG pr.1 pr.2 hp hr hpr

noncomputable def extendChainFun (gs : List (Γ × Γ)) (H : ChainIndex gs → ℝ) (S : Set Γ) : ℝ :=
  if h : ChainState gs S then H ⟨S,h⟩ else 0
omit sectionInstance61 sectionInstance62 in
lemma extendChainFun_apply [Fintype Γ] [DecidableEq Γ] (gs : List (Γ × Γ)) (H : ChainIndex gs → ℝ) (S : ChainIndex gs) :
    extendChainFun gs H S.val = H S := by simp [extendChainFun,S.property]

end ProjectionBridge

section ObservableMSE
open scoped BigOperators Classical
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]

lemma metropolisChain_inner (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G H : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S) :
    (metropolisChain gs hgs hne hcover w f hw hf).inner (fun S => G S.val) (fun S => H S.val) =
    (∑ S ∈ chainStates gs,chainWeight gs w f S*G S*H S)/chainTotal gs w f := by
  change (∑ S : ChainIndex gs,(chainWeight gs w f S.val/chainTotal gs w f)*G S.val*H S.val) = _
  simp_rw [div_mul_eq_mul_div]
  rw [← Finset.sum_div,chain_sum_subtype]

lemma metropolisChain_mean (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S) :
    (metropolisChain gs hgs hne hcover w f hw hf).mean (fun S => G S.val) = chainMean gs w f G := by
  change (∑ S : ChainIndex gs,(chainWeight gs w f S.val/chainTotal gs w f)*G S.val) = _
  simp_rw [div_mul_eq_mul_div]
  unfold chainMean
  rw [← Finset.sum_div,chain_sum_subtype]

lemma metropolisChain_variance (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S) :
    (metropolisChain gs hgs hne hcover w f hw hf).variance (fun S => G S.val) = chainVariance gs w f G := by
  rw [FiniteChain.variance,metropolisChain_mean]
  rw [metropolisChain_inner gs hgs hne hcover w f (fun S => G S-chainMean gs w f G) (fun S => G S-chainMean gs w f G) hw hf]
  unfold chainVariance
  congr 1
  apply Finset.sum_congr rfl
  intro S _
  ring

theorem metropolisChain_dual (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hsig : HasSlotSignature f) (hG : ClassObservable gs G)
    (hlower : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (H : ChainIndex gs → ℝ) :
    let C := metropolisChain gs hgs hne hcover w f hw hf
    let g := fun S : ChainIndex gs => G S.val-chainMean gs w f G
    (C.inner g H)^2 ≤ (2000*(gs.length:ℝ)^6)*C.inner g g*C.energy H := by
  let C := metropolisChain gs hgs hne hcover w f hw hf
  let a := chainMean gs w f G
  let g := fun S : ChainIndex gs => G S.val-a
  let H' := extendChainFun gs H
  let QH := fun S : ChainIndex gs => observableProjection gs f H' S.val
  have hext : (fun S : ChainIndex gs => H' S.val) = H := by
    funext S
    exact extendChainFun_apply gs H S
  have hmean : C.mean g = 0 := by
    have hm := metropolisChain_mean gs hgs hne hcover w f G hw hf
    change C.mean (fun S => G S.val-a) = 0
    change C.mean (fun S : ChainIndex gs => G S.val) = a at hm
    rw [← hm]
    exact C.centered_mean _
  have hpair : C.inner g H = C.inner g QH := by
    rw [← hext]
    change C.inner (fun S => (G S.val-a)) (fun S => H' S.val) =
      C.inner (fun S => (G S.val-a)) (fun S => observableProjection gs f H' S.val)
    dsimp only [C]
    rw [metropolisChain_inner gs hgs hne hcover w f (fun S => G S-a) H' hw hf,
      metropolisChain_inner gs hgs hne hcover w f (fun S => G S-a) (observableProjection gs f H') hw hf]
    exact congrArg (fun t => t/chainTotal gs w f)
      (chain_pairing_projection gs hgs hcover w f (fun S => G S-a) H' hf (hG.sub_const a))
  have hbound : C.variance QH ≤ (2000*(gs.length:ℝ)^6)*C.energy H := by
    change (metropolisChain gs hgs hne hcover w f hw hf).variance
      (fun S => observableProjection gs f H' S.val) ≤ _
    rw [metropolisChain_variance]
    have hb := observable_poincare gs hgs hne hcover w hw f H' hf hsig hlower hupper
    rw [← metropolisChain_energy gs hgs hne hcover w f H' hw hf,hext] at hb
    exact hb
  change (C.inner g H)^2 ≤ (2000*(gs.length:ℝ)^6)*C.inner g g*C.energy H
  rw [hpair,← C.inner_center_right g QH hmean (C.mean QH)]
  calc
    _ ≤ C.inner g g*C.variance QH := C.inner_cauchy _ _
    _ ≤ C.inner g g*((2000*(gs.length:ℝ)^6)*C.energy H) :=
      mul_le_mul_of_nonneg_left hbound (C.inner_nonneg g)
    _ = _ := by ring

theorem metropolisChain_timeAverage (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hsig : HasSlotSignature f) (hG : ClassObservable gs G)
    (hlower : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (U : ℝ) (hU : 0 ≤ U) (ν : ChainIndex gs → ℝ)
    (hwarm : ∀ S,ν S ≤ U*chainWeight gs w f S.val/chainTotal gs w f)
    (N : ℕ) (hN : 0 < N) :
    let C := metropolisChain gs hgs hne hcover w f hw hf
    let g := fun S : ChainIndex gs => G S.val-chainMean gs w f G
    (∑ S,ν S*C.squareMoment g N S)/(N:ℝ)^2 ≤
      2*U*(2000*(gs.length:ℝ)^6)*chainVariance gs w f G/N := by
  let C := metropolisChain gs hgs hne hcover w f hw hf
  let g := fun S : ChainIndex gs => G S.val-chainMean gs w f G
  have hi : C.inner g g = chainVariance gs w f G := by
    rw [← metropolisChain_variance gs hgs hne hcover w f G hw hf]
    unfold FiniteChain.variance
    rw [metropolisChain_mean]
  have h := C.warm_squareMoment_bound g (2000*(gs.length:ℝ)^6) U (by positivity) hU
    (metropolisChain_dual gs hgs hne hcover w f G hw hf hsig hG hlower hupper) ν
    (by intro S; simpa only [C,metropolisChain,FiniteChain.ofMoves,mul_div_assoc] using hwarm S) N hN
  rw [hi] at h
  exact h

end ObservableMSE

structure KilledKernel (B : Type*) [Fintype B] where
  Q : B → B → ℝ
  r : ℝ
  nonnegative : ∀ x y,0 ≤ Q x y
  rnonneg : 0 ≤ r
  rlt : r < 1
  rowbound : ∀ x,∑ y,Q x y ≤ r

namespace KilledKernel
open scoped BigOperators Classical
open Filter
variable {B : Type*} [Fintype B] (Q : KilledKernel B)
noncomputable def apply (f : B → ℝ) (x : B) : ℝ := ∑ y,Q.Q x y*f y
noncomputable def iterate (k : ℕ) (f : B → ℝ) : B → ℝ := Nat.iterate Q.apply k f
@[simp] lemma iterate_zero (f : B → ℝ) : Q.iterate 0 f = f := rfl
lemma iterate_succ (k : ℕ) (f : B → ℝ) : Q.iterate (k+1) f = Q.apply (Q.iterate k f) :=
  Function.iterate_succ_apply' Q.apply k f
lemma iterate_succ' (k : ℕ) (f : B → ℝ) : Q.iterate (k+1) f = Q.iterate k (Q.apply f) :=
  Function.iterate_succ_apply Q.apply k f
lemma apply_add (f g : B → ℝ) : Q.apply (fun x => f x+g x) = fun x => Q.apply f x+Q.apply g x := by
  funext x
  simp [apply,mul_add,Finset.sum_add_distrib]
lemma apply_sub (f g : B → ℝ) : Q.apply (fun x => f x-g x) = fun x => Q.apply f x-Q.apply g x := by
  funext x
  simp [apply,mul_sub,Finset.sum_sub_distrib]
lemma apply_sum {J : Type*} (s : Finset J) (f : J → B → ℝ) :
    Q.apply (fun x => ∑ j ∈ s,f j x) = fun x => ∑ j ∈ s,Q.apply (f j) x := by
  funext x
  simp only [apply,Finset.mul_sum]
  exact Finset.sum_comm
lemma apply_mul (a : ℝ) (f : B → ℝ) : Q.apply (fun x => a*f x) = fun x => a*Q.apply f x := by
  funext x
  simp only [apply,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro y _
  ring
lemma apply_nonneg (f : B → ℝ) (hf : ∀ x,0 ≤ f x) (x : B) : 0 ≤ Q.apply f x :=
  Finset.sum_nonneg (fun y _ => mul_nonneg (Q.nonnegative x y) (hf y))
lemma iterate_nonneg (k : ℕ) (f : B → ℝ) (hf : ∀ x,0 ≤ f x) (x : B) : 0 ≤ Q.iterate k f x := by
  induction k generalizing x with
  | zero => exact hf x
  | succ k ih =>
    rw [Q.iterate_succ]
    exact Q.apply_nonneg _ ih x

lemma apply_abs_bound (f : B → ℝ) (M : ℝ) (hM : 0 ≤ M) (hf : ∀ x,|f x| ≤ M) (x : B) :
    |Q.apply f x| ≤ Q.r*M := by
  calc
    _ ≤ ∑ y,|Q.Q x y*f y| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ y,Q.Q x y*|f y| := by simp_rw [abs_mul,abs_of_nonneg (Q.nonnegative x _) ]
    _ ≤ ∑ y,Q.Q x y*M := Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (hf y) (Q.nonnegative x y))
    _ = (∑ y,Q.Q x y)*M := (Finset.sum_mul _ _ _).symm
    _ ≤ Q.r*M := mul_le_mul_of_nonneg_right (Q.rowbound x) hM

lemma iterate_abs_bound (k : ℕ) (f : B → ℝ) (M : ℝ) (hM : 0 ≤ M) (hf : ∀ x,|f x| ≤ M) (x : B) :
    |Q.iterate k f x| ≤ Q.r^k*M := by
  induction k generalizing x with
  | zero => simpa using hf x
  | succ k ih =>
    rw [Q.iterate_succ,pow_succ']
    simpa only [mul_assoc] using Q.apply_abs_bound (Q.iterate k f) (Q.r^k*M)
      (mul_nonneg (pow_nonneg Q.rnonneg _) hM) ih x

lemma summable_iterate (f : B → ℝ) (x : B) : Summable (fun k => Q.iterate k f x) := by
  let M := ∑ y,|f y|
  have hM : 0 ≤ M := Finset.sum_nonneg (fun y _ => abs_nonneg _)
  have hf : ∀ y,|f y| ≤ M := fun y => Finset.single_le_sum (f := fun z => |f z|) (fun z _ => abs_nonneg _) (Finset.mem_univ y)
  exact (Summable.of_nonneg_of_le (fun k => abs_nonneg _) (fun k => Q.iterate_abs_bound k f M hM hf x)
    ((summable_geometric_of_lt_one Q.rnonneg Q.rlt).mul_right M)).of_abs

lemma iterate_tendsto_zero (f : B → ℝ) (x : B) : Tendsto (fun k => Q.iterate k f x) atTop (nhds 0) := by
  let M := ∑ y,|f y|
  have hM : 0 ≤ M := Finset.sum_nonneg (fun y _ => abs_nonneg _)
  have hf : ∀ y,|f y| ≤ M := fun y => Finset.single_le_sum (f := fun z => |f z|) (fun z _ => abs_nonneg _) (Finset.mem_univ y)
  have ht : Tendsto (fun k => Q.r^k*M) atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one Q.rnonneg Q.rlt).mul_const M
  exact (tendsto_zero_iff_abs_tendsto_zero _).mpr (squeeze_zero (fun k => abs_nonneg _)
    (fun k => Q.iterate_abs_bound k f M hM hf x) ht)

noncomputable def green (f : B → ℝ) (x : B) : ℝ := ∑' k,Q.iterate k f x
lemma green_nonneg (f : B → ℝ) (hf : ∀ x,0 ≤ f x) (x : B) : 0 ≤ Q.green f x :=
  tsum_nonneg (fun k => Q.iterate_nonneg k f hf x)

lemma green_firstStep (f : B → ℝ) (x : B) : Q.green f x = f x+Q.apply (Q.green f) x := by
  unfold green
  rw [(Q.summable_iterate f x).tsum_eq_zero_add]
  simp only [Q.iterate_zero,Q.iterate_succ,apply]
  congr 1
  rw [Summable.tsum_finsetSum (fun y (_ : y ∈ Finset.univ) => (Q.summable_iterate f y).mul_left (Q.Q x y))]
  simp_rw [tsum_mul_left]

lemma iterate_sub (k : ℕ) (f g : B → ℝ) :
    Q.iterate k (fun x => f x-g x) = fun x => Q.iterate k f x-Q.iterate k g x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Q.iterate_succ,ih,Q.apply_sub,← Q.iterate_succ,← Q.iterate_succ]
lemma iterate_sum {J : Type*} (s : Finset J) (f : J → B → ℝ) (k : ℕ) :
    Q.iterate k (fun x => ∑ j ∈ s,f j x) = fun x => ∑ j ∈ s,Q.iterate k (f j) x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Q.iterate_succ,ih,Q.apply_sum]; simp_rw [← Q.iterate_succ]
lemma iterate_mul (a : ℝ) (f : B → ℝ) (k : ℕ) :
    Q.iterate k (fun x => a*f x) = fun x => a*Q.iterate k f x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [Q.iterate_succ,ih,Q.apply_mul,← Q.iterate_succ]

lemma green_sum {J : Type*} (s : Finset J) (f : J → B → ℝ) (x : B) :
    Q.green (fun x => ∑ j ∈ s,f j x) x = ∑ j ∈ s,Q.green (f j) x := by
  unfold green
  simp_rw [Q.iterate_sum]
  exact Summable.tsum_finsetSum (fun j _ => Q.summable_iterate (f j) x)
lemma green_mul (a : ℝ) (f : B → ℝ) (x : B) : Q.green (fun x => a*f x) x = a*Q.green f x := by
  unfold green
  simp_rw [Q.iterate_mul]
  exact tsum_mul_left

lemma iterate_residual_sum (f : B → ℝ) (N : ℕ) (x : B) :
    (∑ k ∈ Finset.range N,Q.iterate k (fun y => f y-Q.apply f y) x) = f x-Q.iterate N f x := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ,ih,Q.iterate_sub,← Q.iterate_succ']
    simp only
    ring

lemma green_residual (f : B → ℝ) (x : B) : Q.green (fun y => f y-Q.apply f y) x = f x := by
  have hs := (Q.summable_iterate (fun y => f y-Q.apply f y) x).tendsto_sum_tsum_nat
  simp_rw [Q.iterate_residual_sum] at hs
  have ht : Tendsto (fun N => f x-Q.iterate N f x) atTop (nhds (f x)) := by
    simpa using tendsto_const_nhds.sub (Q.iterate_tendsto_zero f x)
  exact tendsto_nhds_unique hs ht

end KilledKernel
namespace FiniteChain

section
open scoped BigOperators Classical
variable {X : Type*} [sectionInstance66 : Fintype X] (C : FiniteChain X) (A : X → Prop)

abbrev Inside := {x : X // A x}
abbrev Outside := {x : X // ¬ A x}

noncomputable def mergeFun (h : Inside A → ℝ) (b : Outside A → ℝ) (x : X) : ℝ :=
  if hx : A x then h ⟨x,hx⟩ else b ⟨x,hx⟩
omit sectionInstance66 in
@[simp] lemma mergeFun_inside [Fintype X] (h : Inside A → ℝ) (b : Outside A → ℝ) (x : Inside A) :
    mergeFun A h b x.val = h x := by simp [mergeFun,x.property]
omit sectionInstance66 in
@[simp] lemma mergeFun_outside [Fintype X] (h : Inside A → ℝ) (b : Outside A → ℝ) (x : Outside A) :
    mergeFun A h b x.val = b x := by simp [mergeFun,x.property]

variable (Q : KilledKernel (Outside A)) (hQ : ∀ x y : Outside A,Q.Q x y = C.P x.val y.val)

noncomputable def hitKernel (x : Outside A) (y : Inside A) : ℝ :=
  Q.green (fun z => C.P z.val y.val) x
lemma hitKernel_nonneg (x : Outside A) (y : Inside A) : 0 ≤ C.hitKernel A Q x y :=
  Q.green_nonneg _ (fun z => C.nonnegative z.val y.val) x

include hQ in
lemma exitRow (x : Outside A) : (∑ y : Inside A,C.P x.val y.val) = 1-Q.apply (fun _ => 1) x := by
  have hh := Fintype.sum_subtype_add_sum_subtype A (fun y => C.P x.val y)
  rw [C.stochastic] at hh
  have he : Q.apply (fun _ => 1) x = ∑ y : Outside A,C.P x.val y.val := by
    simp [KilledKernel.apply,hQ]
  rw [he]
  linarith

include hQ in
lemma hitKernel_row (x : Outside A) : ∑ y : Inside A,C.hitKernel A Q x y = 1 := by
  unfold hitKernel
  rw [← Q.green_sum Finset.univ]
  have he : (fun z : Outside A => ∑ y : Inside A,C.P z.val y.val) =
      fun z => 1-Q.apply (fun _ => 1) z := by
    funext z
    exact C.exitRow A Q hQ z
  rw [he,Q.green_residual]

include hQ in
lemma hitKernel_firstStep (x : Outside A) (y : Inside A) :
    C.hitKernel A Q x y = C.P x.val y.val+∑ z : Outside A,C.P x.val z.val*C.hitKernel A Q z y := by
  unfold hitKernel
  rw [Q.green_firstStep]
  simp only [KilledKernel.apply,hQ]

noncomputable def traceMatrix (x y : Inside A) : ℝ :=
  C.P x.val y.val+∑ z : Outside A,C.P x.val z.val*C.hitKernel A Q z y
noncomputable def traceApply (h : Inside A → ℝ) (x : Inside A) : ℝ :=
  ∑ y,C.traceMatrix A Q x y*h y

lemma traceMatrix_nonneg (x y : Inside A) : 0 ≤ C.traceMatrix A Q x y :=
  add_nonneg (C.nonnegative _ _) (Finset.sum_nonneg (fun z _ => mul_nonneg
    (C.nonnegative _ _) (C.hitKernel_nonneg A Q z y)))
lemma traceMatrix_lazy (x : Inside A) : 1/2 ≤ C.traceMatrix A Q x x := by
  exact (C.lazy x.val).trans (le_add_of_nonneg_right (Finset.sum_nonneg (fun z _ =>
    mul_nonneg (C.nonnegative _ _) (C.hitKernel_nonneg A Q z x))))
include hQ in
lemma traceMatrix_stochastic (x : Inside A) : ∑ y,C.traceMatrix A Q x y = 1 := by
  unfold traceMatrix
  rw [Finset.sum_add_distrib,Finset.sum_comm]
  simp_rw [← Finset.mul_sum,C.hitKernel_row A Q hQ,mul_one]
  rw [Fintype.sum_subtype_add_sum_subtype A,C.stochastic]

noncomputable def offExtension (h : Inside A → ℝ) (x : Outside A) : ℝ :=
  ∑ y : Inside A,C.hitKernel A Q x y*h y
noncomputable def harmonicExtension (h : Inside A → ℝ) : X → ℝ := mergeFun A h (C.offExtension A Q h)
@[simp] lemma harmonicExtension_inside (h : Inside A → ℝ) (x : Inside A) :
    C.harmonicExtension A Q h x.val = h x := mergeFun_inside _ _ _ _
@[simp] lemma harmonicExtension_outside (h : Inside A → ℝ) (x : Outside A) :
    C.harmonicExtension A Q h x.val = C.offExtension A Q h x := mergeFun_outside _ _ _ _

include hQ in
lemma offExtension_firstStep (h : Inside A → ℝ) (x : Outside A) :
    C.offExtension A Q h x = (∑ y : Inside A,C.P x.val y.val*h y)+
      ∑ z : Outside A,C.P x.val z.val*C.offExtension A Q h z := by
  unfold offExtension
  calc
    _ = ∑ y : Inside A,(C.P x.val y.val+∑ z : Outside A,C.P x.val z.val*C.hitKernel A Q z y)*h y := by
      apply Finset.sum_congr rfl
      intro y _
      rw [C.hitKernel_firstStep A Q hQ]
    _ = _ := ?_
  simp only [add_mul,Finset.sum_mul,Finset.sum_add_distrib]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro z _
  simp_rw [mul_assoc,← Finset.mul_sum]

include hQ in
lemma harmonicExtension_harmonic (h : Inside A → ℝ) (x : Outside A) :
    C.apply (C.harmonicExtension A Q h) x.val = C.harmonicExtension A Q h x.val := by
  unfold apply
  rw [← Fintype.sum_subtype_add_sum_subtype A]
  simp only [C.harmonicExtension_inside,C.harmonicExtension_outside]
  exact (C.offExtension_firstStep A Q hQ h x).symm

lemma apply_harmonicExtension_inside (h : Inside A → ℝ) (x : Inside A) :
    C.apply (C.harmonicExtension A Q h) x.val = C.traceApply A Q h x := by
  unfold apply
  rw [← Fintype.sum_subtype_add_sum_subtype A]
  simp only [C.harmonicExtension_inside,C.harmonicExtension_outside]
  unfold traceApply traceMatrix offExtension
  simp_rw [add_mul,Finset.sum_mul,Finset.sum_add_distrib,Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  apply Finset.sum_congr rfl
  intro z _
  ring

include hQ in
lemma harmonic_inner_residual (h g : Inside A → ℝ) :
    C.inner (C.harmonicExtension A Q h)
      (fun x => C.harmonicExtension A Q g x-C.apply (C.harmonicExtension A Q g) x) =
    ∑ x : Inside A,C.π x.val*h x*(g x-C.traceApply A Q g x) := by
  unfold inner
  rw [← Fintype.sum_subtype_add_sum_subtype A]
  simp only [C.harmonicExtension_inside,C.apply_harmonicExtension_inside,
    C.harmonicExtension_harmonic A Q hQ,sub_self,mul_zero,Finset.sum_const_zero,add_zero]

end
section
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X) (A : X → Prop)
variable (Q : KilledKernel (Outside A)) (hQ : ∀ x y : Outside A,Q.Q x y = C.P x.val y.val)

lemma residual_symmetric (f g : X → ℝ) :
    C.inner f (fun x => g x-C.apply g x) = C.inner g (fun x => f x-C.apply f x) := by
  rw [C.inner_sub_right,C.inner_sub_right,C.apply_selfAdjoint,C.inner_symm f g,
    C.inner_symm (C.apply f) g]

include hQ in
lemma traceMatrix_reversible (x y : Inside A) :
    C.π x.val*C.traceMatrix A Q x y = C.π y.val*C.traceMatrix A Q y x := by
  by_cases hxy : x = y
  · subst y; rfl
  have h := C.residual_symmetric (C.harmonicExtension A Q (fun z => if z=x then 1 else 0))
    (C.harmonicExtension A Q (fun z => if z=y then 1 else 0))
  rw [C.harmonic_inner_residual A Q hQ,C.harmonic_inner_residual A Q hQ] at h
  simp [traceApply,hxy,Ne.symm hxy] at h
  linarith

noncomputable def insideMass : ℝ := ∑ x : Inside A,C.π x.val
lemma insideMass_pos [Nonempty (Inside A)] : 0 < C.insideMass A := by
  apply Finset.sum_pos
  · intro x _; exact C.positive _
  · exact Finset.univ_nonempty

noncomputable def traceChain [Nonempty (Inside A)] : FiniteChain (Inside A) where
  P := C.traceMatrix A Q
  π := fun x => C.π x.val/C.insideMass A
  positive := fun x => div_pos (C.positive _) (C.insideMass_pos A)
  normalized := by rw [← Finset.sum_div]; exact div_self (C.insideMass_pos A).ne'
  nonnegative := C.traceMatrix_nonneg A Q
  stochastic := C.traceMatrix_stochastic A Q hQ
  reversible := by
    intro x y
    rw [div_mul_eq_mul_div,div_mul_eq_mul_div,C.traceMatrix_reversible A Q hQ]
  lazy := C.traceMatrix_lazy A Q

lemma traceChain_energy [Nonempty (Inside A)] (h : Inside A → ℝ) :
    C.energy (C.harmonicExtension A Q h) =
      C.insideMass A*(C.traceChain A Q hQ).energy h := by
  rw [energy,C.harmonic_inner_residual A Q hQ]
  change _ = C.insideMass A*(∑ x : Inside A,
    (C.π x.val/C.insideMass A)*h x*(h x-C.traceApply A Q h x))
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  field_simp [(C.insideMass_pos A).ne']

lemma mean_apply (f : X → ℝ) : C.mean (C.apply f) = C.mean f := by
  unfold mean apply
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  simp_rw [← mul_assoc,← Finset.sum_mul,C.stationary]
lemma mean_residual (f : X → ℝ) : C.mean (fun x => f x-C.apply f x) = 0 := by
  unfold mean
  simp_rw [mul_sub,Finset.sum_sub_distrib]
  change C.mean f-C.mean (C.apply f) = 0
  rw [C.mean_apply,sub_self]

noncomputable def duration (x : Outside A) : ℝ := Q.green (fun _ => 1) x
noncomputable def returnCost (x : Inside A) : ℝ :=
  1+∑ y : Outside A,C.P x.val y.val*duration A Q y
lemma duration_nonneg (x : Outside A) : 0 ≤ duration A Q x :=
  Q.green_nonneg _ (by intro; norm_num) x
lemma returnCost_nonneg (x : Inside A) : 0 ≤ C.returnCost A Q x :=
  add_nonneg (by norm_num) (Finset.sum_nonneg (fun y _ =>
    mul_nonneg (C.nonnegative _ _) (duration_nonneg A Q y)))

include hQ in
lemma expected_returnCost : (∑ x : Inside A,C.π x.val*C.returnCost A Q x) = 1 := by
  let l : X → ℝ := mergeFun A (fun _ => 0) (duration A Q)
  have hi (x : Inside A) : l x.val = 0 := by simp [l]
  have ho (x : Outside A) : l x.val = duration A Q x := by simp [l]
  have hai (x : Inside A) : C.apply l x.val = ∑ y : Outside A,C.P x.val y.val*duration A Q y := by
    unfold apply
    rw [← Fintype.sum_subtype_add_sum_subtype A]
    simp only [hi,ho,mul_zero,Finset.sum_const_zero,zero_add]
  have hao (x : Outside A) : C.apply l x.val = Q.apply (duration A Q) x := by
    unfold apply
    rw [← Fintype.sum_subtype_add_sum_subtype A]
    simp only [hi,ho,mul_zero,Finset.sum_const_zero,zero_add,KilledKernel.apply,hQ]
  have hr (x : Outside A) : l x.val-C.apply l x.val = 1 := by
    rw [ho,hao]
    have hg := Q.green_firstStep (fun _ => (1:ℝ)) x
    change duration A Q x = 1+Q.apply (duration A Q) x at hg
    linarith
  have hm := C.mean_residual l
  unfold mean at hm
  rw [← Fintype.sum_subtype_add_sum_subtype A] at hm
  simp only [hi,hai,hr,zero_sub,mul_neg,Finset.sum_neg_distrib,mul_one] at hm
  have hmass := Fintype.sum_subtype_add_sum_subtype A C.π
  rw [C.normalized] at hmass
  unfold returnCost
  simp only [mul_add,mul_one,Finset.sum_add_distrib]
  linarith

lemma traceChain_returnCost [Nonempty (Inside A)] :
    (C.traceChain A Q hQ).mean (C.returnCost A Q) = 1/C.insideMass A := by
  change (∑ x : Inside A,(C.π x.val/C.insideMass A)*C.returnCost A Q x) = _
  simp_rw [div_mul_eq_mul_div]
  rw [← Finset.sum_div,C.expected_returnCost A Q hQ]

lemma warm_returnCost [Nonempty (Inside A)] (ν : Inside A → ℝ) (U : ℝ)
    (hν : ∀ x,ν x ≤ U*(C.traceChain A Q hQ).π x) :
    (∑ x,ν x*C.returnCost A Q x) ≤ U/C.insideMass A := by
  calc
    _ ≤ ∑ x,U*(C.traceChain A Q hQ).π x*C.returnCost A Q x :=
      Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_right (hν x) (C.returnCost_nonneg A Q x))
    _ = U*(C.traceChain A Q hQ).mean (C.returnCost A Q) := by simp [mean,Finset.mul_sum,mul_assoc]
    _ = _ := by rw [C.traceChain_returnCost A Q hQ]; ring
end
section
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X) (A : X → Prop)
variable (hExit : ∀ x : Outside A,∃ y : Inside A,0 < C.P x.val y.val)
noncomputable def exitProbability (x : Outside A) : ℝ := ∑ y : Inside A,C.P x.val y.val
lemma exitProbability_nonneg (x : Outside A) : 0 ≤ C.exitProbability A x :=
  Finset.sum_nonneg (fun y _ => C.nonnegative x.val y.val)
include hExit in
lemma exitProbability_pos (x : Outside A) : 0 < C.exitProbability A x := by
  obtain ⟨y,hy⟩ := hExit x
  exact hy.trans_le (Finset.single_le_sum (fun z _ => C.nonnegative _ _) (Finset.mem_univ y))
lemma exitProbability_le_one (x : Outside A) : C.exitProbability A x ≤ 1 := by
  have h := Fintype.sum_subtype_add_sum_subtype A (fun y => C.P x.val y)
  rw [C.stochastic] at h
  have hn : 0 ≤ ∑ y : Outside A,C.P x.val y.val := Finset.sum_nonneg (fun y _ => C.nonnegative _ _)
  change (∑ y : Inside A,C.P x.val y.val) ≤ 1
  linarith
noncomputable def killedChain : KilledKernel (Outside A) where
  Q := fun x y => C.P x.val y.val
  r := 1-∏ x : Outside A,C.exitProbability A x
  nonnegative := fun x y => C.nonnegative _ _
  rnonneg := sub_nonneg.mpr (Finset.prod_le_one₀ (fun x _ => C.exitProbability_nonneg A x)
    (fun x _ => C.exitProbability_le_one A x))
  rlt := by
    have h : 0 < ∏ x : Outside A,C.exitProbability A x := Finset.prod_pos (fun x _ => C.exitProbability_pos A hExit x)
    linarith
  rowbound := by
    intro x
    have hprod : (∏ z : Outside A,C.exitProbability A z) ≤ C.exitProbability A x := by
      have h := Finset.prod_le_prod_of_subset_of_le_one₀ (Finset.singleton_subset_iff.mpr (Finset.mem_univ x))
        (fun z (_ : z ∈ Finset.univ) => C.exitProbability_nonneg A z)
        (fun z _ _ => C.exitProbability_le_one A z)
      simpa only [Finset.prod_singleton] using h
    have hs := Fintype.sum_subtype_add_sum_subtype A (fun y => C.P x.val y)
    rw [C.stochastic] at hs
    change (∑ y : Inside A,C.P x.val y.val)+(∑ y : Outside A,C.P x.val y.val) = 1 at hs
    unfold exitProbability at hprod ⊢
    linarith
end
open scoped Classical BigOperators
variable {X : Type*} [Fintype X] (C : FiniteChain X)

lemma apply_cauchy (f g : X → ℝ) :
    (C.inner f (C.apply g))^2 ≤ C.inner f (C.apply f)*C.inner g (C.apply g) := by
  let B : LinearMap.BilinForm ℝ (X → ℝ) := Matrix.toBilin' (fun x y => C.π x*C.P x y)
  have he (u v : X → ℝ) : B u v = C.inner u (C.apply v) := by
    simp only [B,inner,apply,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    change v y*(u x*(C.π x*C.P x y))=C.π x*u x*(C.P x y*v y)
    ring
  have hs : LinearMap.IsSymm B := by
    constructor
    intro u v
    simp only [he,RingHom.id_apply]
    rw [C.apply_selfAdjoint,C.inner_symm]
  simpa only [he] using B.apply_sq_le_of_symm (fun u => by rw [he]; exact C.apply_positive u) hs f g

lemma inner_sub_left (f g h : X → ℝ) :
    C.inner (fun x => f x-g x) h = C.inner f h-C.inner g h := by
  rw [C.inner_symm,C.inner_sub_right,C.inner_symm h f,C.inner_symm h g]
lemma apply_sub (f g : X → ℝ) : C.apply (fun x => f x-g x) = fun x => C.apply f x-C.apply g x := by
  funext x
  simp [apply,mul_sub,Finset.sum_sub_distrib]
lemma mean_const (a : ℝ) : C.mean (fun _ => a) = a := by
  simp [mean,← Finset.sum_mul,C.normalized]
lemma mean_sub (f g : X → ℝ) : C.mean (fun x => f x-g x) = C.mean f-C.mean g := by
  simp [mean,mul_sub,Finset.sum_sub_distrib]
lemma variance_eq_inner (f : X → ℝ) (hf : C.mean f = 0) : C.variance f = C.inner f f := by
  simp [variance,hf]

lemma apply_contraction (r : ℝ) (hr : 0 ≤ r)
    (hgap : ∀ f : X → ℝ,C.mean f = 0 → C.inner f (C.apply f) ≤ r*C.inner f f)
    (f : X → ℝ) (hf : C.mean f = 0) :
    C.inner (C.apply f) (C.apply f) ≤ r^2*C.inner f f := by
  have hg : C.mean (C.apply f) = 0 := by rw [C.mean_apply,hf]
  have hcs := C.apply_cauchy (C.apply f) f
  have h₁ := hgap f hf
  have h₂ := hgap (C.apply f) hg
  have hp₁ := C.apply_positive f
  have hp₂ := C.apply_positive (C.apply f)
  have hn := C.inner_nonneg (C.apply f)
  have hm := C.inner_nonneg f
  have hb := mul_le_mul h₂ h₁ hp₁ (mul_nonneg hr hn)
  by_cases hz : C.inner (C.apply f) (C.apply f) = 0
  · rw [hz]; positivity
  · have hpos : 0 < C.inner (C.apply f) (C.apply f) := lt_of_le_of_ne hn (Ne.symm hz)
    nlinarith

lemma iterate_mean (k : ℕ) (f : X → ℝ) : C.mean (C.iterate k f) = C.mean f := by
  induction k with
  | zero => rfl
  | succ k ih => rw [C.iterate_succ,C.mean_apply,ih]
lemma iterate_contraction (r : ℝ) (hr : 0 ≤ r)
    (hgap : ∀ f : X → ℝ,C.mean f = 0 → C.inner f (C.apply f) ≤ r*C.inner f f)
    (k : ℕ) (f : X → ℝ) (hf : C.mean f = 0) :
    C.inner (C.iterate k f) (C.iterate k f) ≤ r^(2*k)*C.inner f f := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [C.iterate_succ]
    calc
      _ ≤ r^2*C.inner (C.iterate k f) (C.iterate k f) :=
        C.apply_contraction r hr hgap _ (by rw [C.iterate_mean,hf])
      _ ≤ r^2*(r^(2*k)*C.inner f f) := mul_le_mul_of_nonneg_left ih (sq_nonneg r)
      _ = _ := by rw [show 2*(k+1)=2+2*k by omega,pow_add]; ring

noncomputable def pointDensity (x : X) (y : X) : ℝ := if y=x then 1/C.π x else 0
noncomputable def centeredPoint (x : X) (y : X) : ℝ := C.pointDensity x y-1
lemma pointDensity_mean (x : X) : C.mean (C.pointDensity x) = 1 := by
  simp [mean,pointDensity,(C.positive x).ne']
lemma centeredPoint_mean (x : X) : C.mean (C.centeredPoint x) = 0 := by
  change C.mean (fun z => C.pointDensity x z-1) = 0
  rw [C.mean_sub,C.pointDensity_mean,C.mean_const,sub_self]
lemma pointDensity_inner (x : X) (f : X → ℝ) : C.inner (C.pointDensity x) f = f x := by
  simp [inner,pointDensity,(C.positive x).ne']
lemma centeredPoint_norm (x : X) : C.inner (C.centeredPoint x) (C.centeredPoint x) ≤ 1/C.π x := by
  unfold centeredPoint
  rw [C.inner_sub_left,C.inner_sub_right,C.inner_sub_right,C.pointDensity_inner,
    C.pointDensity_inner,C.inner_symm (fun _ => 1),C.pointDensity_inner]
  have h₁ : C.inner (fun _ => 1) (fun _ => 1) = 1 := by simp [inner,C.normalized]
  rw [h₁]
  simp only [pointDensity,ite_true]
  linarith

lemma iterate_const (k : ℕ) (a : ℝ) : C.iterate k (fun _ => a) = fun _ => a := by
  induction k with
  | zero => rfl
  | succ k ih => rw [C.iterate_succ,ih,C.apply_const]
lemma iterate_sub (k : ℕ) (f g : X → ℝ) :
    C.iterate k (fun x => f x-g x) = fun x => C.iterate k f x-C.iterate k g x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [C.iterate_succ,ih,C.apply_sub,C.iterate_succ,C.iterate_succ]

lemma point_mixing_squared (r : ℝ) (hr : 0 ≤ r)
    (hgap : ∀ f : X → ℝ,C.mean f = 0 → C.inner f (C.apply f) ≤ r*C.inner f f)
    (k : ℕ) (x y : X) :
    (C.iterate k (C.pointDensity y) x-1)^2 ≤ r^(2*k)/(C.π x*C.π y) := by
  have he : C.inner (C.centeredPoint x) (C.iterate k (C.centeredPoint y)) =
      C.iterate k (C.pointDensity y) x-1 := by
    change C.inner (fun z => C.pointDensity x z-1) (C.iterate k (C.centeredPoint y)) = _
    rw [C.inner_sub_left,C.pointDensity_inner]
    have hm : C.inner (fun _ => 1) (C.iterate k (C.centeredPoint y)) = 0 := by
      have hz := C.iterate_mean k (C.centeredPoint y)
      rw [C.centeredPoint_mean] at hz
      simpa only [inner,mean,mul_one] using hz
    rw [hm,sub_zero]
    change C.iterate k (fun z => C.pointDensity y z-1) x = _
    rw [C.iterate_sub,C.iterate_const]
  have hcs := C.inner_cauchy (C.centeredPoint x) (C.iterate k (C.centeredPoint y))
  rw [he] at hcs
  have hcon := C.iterate_contraction r hr hgap k (C.centeredPoint y) (C.centeredPoint_mean y)
  have hny := C.centeredPoint_norm y
  have hnx := C.centeredPoint_norm x
  have hb := mul_le_mul hnx (hcon.trans (mul_le_mul_of_nonneg_left hny (pow_nonneg hr _)))
    (C.inner_nonneg _) (div_nonneg (by norm_num) (C.positive x).le)
  calc
    _ ≤ _ := hcs.trans hb
    _ = _ := by field_simp
lemma variance_formula (f : X → ℝ) : C.variance f = C.inner f f-(C.mean f)^2 := by
  rw [variance,C.inner_sub_left,C.inner_sub_right,C.inner_sub_right]
  have h₁ : C.inner f (fun _ => C.mean f) = (C.mean f)^2 := by
    unfold inner
    rw [← Finset.sum_mul]
    change C.mean f*C.mean f = (C.mean f)^2
    ring
  have h₂ : C.inner (fun _ => C.mean f) (fun _ => C.mean f) = (C.mean f)^2 := by
    simp only [inner,← Finset.sum_mul,C.normalized,one_mul,pow_two]
  rw [h₁,C.inner_symm (fun _ => C.mean f) f,h₁,h₂]
  ring

lemma poincare_rayleigh (K : ℝ) (hK : 0 < K)
    (hp : ∀ f : X → ℝ,C.variance f ≤ K*C.energy f)
    (f : X → ℝ) (hf : C.mean f = 0) :
    C.inner f (C.apply f) ≤ (1-1/K)*C.inner f f := by
  have h := hp f
  rw [C.variance_eq_inner f hf,energy,C.inner_sub_right] at h
  apply (mul_le_mul_iff_right₀ hK).mp
  field_simp
  nlinarith

lemma point_mixing (r m : ℝ) (hr : 0 ≤ r) (hm : 0 < m) (hπ : ∀ x,m ≤ C.π x)
    (hgap : ∀ f : X → ℝ,C.mean f = 0 → C.inner f (C.apply f) ≤ r*C.inner f f)
    (k : ℕ) (x y : X) :
    |C.iterate k (C.pointDensity y) x-1| ≤ r^k/m := by
  have hs := C.point_mixing_squared r hr hgap k x y
  have hd : m^2 ≤ C.π x*C.π y := by simpa only [pow_two] using mul_le_mul (hπ x) (hπ y) hm.le (C.positive x).le
  have hb : r^(2*k)/(C.π x*C.π y) ≤ (r^k/m)^2 := by
    calc
      _ ≤ r^(2*k)/m^2 := div_le_div_of_nonneg_left (pow_nonneg hr _) (sq_pos_of_pos hm) hd
      _ = _ := by rw [mul_comm 2 k,pow_mul,div_pow]
  have ha : (|C.iterate k (C.pointDensity y) x-1|)^2 ≤ (r^k/m)^2 := by
    rw [sq_abs]
    exact hs.trans hb
  exact (sq_le_sq₀ (abs_nonneg _) (div_nonneg (pow_nonneg hr _) hm.le)).mp ha

lemma point_mixing_exp (K m : ℝ) (hK : 1 ≤ K) (hm : 0 < m) (hπ : ∀ x,m ≤ C.π x)
    (hp : ∀ f : X → ℝ,C.variance f ≤ K*C.energy f)
    (k : ℕ) (x y : X) :
    |C.iterate k (C.pointDensity y) x-1| ≤ Real.exp (-(k:ℝ)/K)/m := by
  have hKp : 0 < K := lt_of_lt_of_le (by norm_num) hK
  have hr : 0 ≤ 1-1/K := sub_nonneg.mpr ((div_le_one hKp).mpr hK)
  have hpow : (1-1/K)^k ≤ Real.exp (-(k:ℝ)/K) := by
    have hle : 1-1/K ≤ Real.exp (-1/K) := by
      have hh := Real.add_one_le_exp (-1/K)
      convert hh using 1 ; ring
    calc
      _ ≤ (Real.exp (-1/K))^k := pow_le_pow_left₀ hr hle k
      _ = Real.exp ((k:ℝ)*(-1/K)) := (Real.exp_nat_mul _ _).symm
      _ = _ := by congr 1; ring
  exact (C.point_mixing _ m hr hm hπ (C.poincare_rayleigh K hKp hp) k x y).trans
    (div_le_div_of_nonneg_right hpow hm.le)
end FiniteChain
section TraceGeometry
open scoped Classical BigOperators
variable {Γ : Type*} [Fintype Γ] [sectionInstance71 : DecidableEq Γ]

lemma SlotsFresh.cross_ne {gs : List (Γ × Γ)} {A : Set Γ} (hgs : SlotsFresh gs A)
    {p r : Γ × Γ} (hp : p ∈ gs) (hr : r ∈ gs) (hpr : p ≠ r)
    {x y : Γ} (hx : x=p.1 ∨ x=p.2) (hy : y=r.1 ∨ y=r.2) : x ≠ y := by
  intro hxy
  have := hgs.pair_contains_unique hp hr hx (hxy ▸ hy)
  exact hpr this

lemma DefectState.plain_neighbor {gs : List (Γ × Γ)} (hgs : SlotsFresh gs ∅)
    {p r : Γ × Γ} {S : Set Γ} (hS : DefectState gs p r S) :
    ∃ T,PlainState gs T ∧ ExchangeAdjacent S T := by
  obtain ⟨hp,hr,hpr,he,hf,ht⟩ := hS
  let T := insert p.1 (S\{r.1})
  have hpne : p.1 ≠ p.2 := ((SlotsFresh.perm (List.perm_cons_erase hp) ∅).mp hgs).1
  have hrne : r.1 ≠ r.2 := ((SlotsFresh.perm (List.perm_cons_erase hr) ∅).mp hgs).1
  have hpr11 : p.1 ≠ r.1 := hgs.cross_ne hp hr hpr (Or.inl rfl) (Or.inl rfl)
  have hpr21 : p.2 ≠ r.1 := hgs.cross_ne hp hr hpr (Or.inr rfl) (Or.inl rfl)
  have hpr12 : p.1 ≠ r.2 := hgs.cross_ne hp hr hpr (Or.inl rfl) (Or.inr rfl)
  refine ⟨T,?_,?_⟩
  · intro t htm
    by_cases htp : t=p
    · subst t
      simp [PairSingle,T,hpne.symm,he.1,he.2]
    by_cases htr : t=r
    · subst t
      simp [PairSingle,T,hpr11.symm,hpr12.symm,hrne.symm,hf.2]
    have h₁ : t.1 ≠ p.1 := hgs.cross_ne htm hp htp (Or.inl rfl) (Or.inl rfl)
    have h₂ : t.2 ≠ p.1 := hgs.cross_ne htm hp htp (Or.inr rfl) (Or.inl rfl)
    have h₃ : t.1 ≠ r.1 := hgs.cross_ne htm hr htr (Or.inl rfl) (Or.inl rfl)
    have h₄ : t.2 ≠ r.1 := hgs.cross_ne htm hr htr (Or.inr rfl) (Or.inl rfl)
    simpa only [PairSingle,T,Set.mem_insert_iff,Set.mem_sdiff,Set.mem_singleton_iff,
      h₁,h₂,h₃,h₄,false_or,not_false_eq_true,and_true] using ht t htm htp htr
  · refine ⟨S\{r.1},r.1,p.1,hpr11.symm,by simp,?_,?_,rfl⟩
    · exact fun h => he.1 h.1
    · ext x
      simp only [Set.mem_insert_iff,Set.mem_sdiff,Set.mem_singleton_iff]
      constructor
      · intro hx
        by_cases h : x=r.1
        · exact Or.inl h
        · exact Or.inr ⟨hx,h⟩
      · rintro (rfl|⟨hx,_⟩)
        · exact hf.1
        · exact hx

abbrev PlainIndex (gs : List (Γ × Γ)) :=
  FiniteChain.Inside (fun S : ChainIndex gs => PlainState gs S.val)

omit sectionInstance71 in
lemma plainIndex_sum [DecidableEq Γ] (gs : List (Γ × Γ)) (g : Set Γ → ℝ) :
    (∑ S : PlainIndex gs,g S.val.val) = ∑ S ∈ Finset.univ.filter (PlainState gs),g S := by
  let e : PlainIndex gs ≃ {S : Set Γ // PlainState gs S} :=
    { toFun := fun S => ⟨S.val.val,S.property⟩
      invFun := fun S => ⟨⟨S.val,Or.inl S.property⟩,S.property⟩
      left_inv := by intro; rfl
      right_inv := by intro; rfl }
  calc
    _ = ∑ S : {S : Set Γ // PlainState gs S},g S.val :=
      Fintype.sum_equiv e _ _ (by intro S; rfl)
    _ = _ := (Finset.sum_subtype _ (by intro S; simp) g).symm

lemma plainIndex_nonempty (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs = Set.univ) : Nonempty (PlainIndex gs) := by
  have hz := slotTotal_pos gs (fun _ => (1:ℝ)) (by intro; norm_num) ∅ hgs
  rw [slotTotal_eq_plain_sum gs hgs hcover,← plainIndex_sum] at hz
  by_contra h
  have : IsEmpty (PlainIndex gs) := not_nonempty_iff.mp h
  simp at hz

lemma metropolis_plain_exit (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (S : FiniteChain.Outside (fun S : ChainIndex gs => PlainState gs S.val)) :
    ∃ T : PlainIndex gs,0 < (metropolisChain gs hgs hne hcover w f hw hf).P S.val T.val := by
  obtain ⟨p,r,hS⟩ := S.val.property.resolve_left S.property
  obtain ⟨T,hT,hST⟩ := hS.plain_neighbor hgs
  let t : PlainIndex gs := ⟨⟨T,Or.inl hT⟩,hT⟩
  refine ⟨t,?_⟩
  have hneST : S.val ≠ t.val := by intro h; exact hST.ne (congrArg Subtype.val h)
  change 0 < metropolisMove gs w f S.val t.val+if S.val=t.val then _ else _
  rw [ite_eq_right hneST,add_zero]
  unfold metropolisMove
  rw [ite_eq_left hST]
  have hn : (0:ℝ) < gs.length := by exact_mod_cast List.length_pos_iff.mpr hne
  exact div_pos (lt_min (chainWeight_pos gs w f hw hf _) (chainWeight_pos gs w f hw hf _))
    (mul_pos (mul_pos (by norm_num) (sq_pos_of_pos hn)) (chainWeight_pos gs w f hw hf _))
end TraceGeometry
section TracePoincare
open scoped Classical BigOperators
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]
variable (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
  (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
  (f : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)

abbrev plainPredicate (gs : List (Γ × Γ)) (S : ChainIndex gs) := PlainState gs S.val
noncomputable def metropolisKilled : KilledKernel (FiniteChain.Outside (plainPredicate gs)) :=
  (metropolisChain gs hgs hne hcover w f hw hf).killedChain (plainPredicate gs)
    (metropolis_plain_exit gs hgs hne hcover w f hw hf)

noncomputable def metropolisTrace : FiniteChain (PlainIndex gs) := by
  letI := plainIndex_nonempty gs hgs hcover
  exact (metropolisChain gs hgs hne hcover w f hw hf).traceChain (plainPredicate gs)
    (metropolisKilled gs hgs hne hcover w f hw hf) (by intro _ _; rfl)

lemma metropolis_insideMass :
    (metropolisChain gs hgs hne hcover w f hw hf).insideMass (plainPredicate gs) =
      slotTotal gs f ∅/chainTotal gs w f := by
  change (∑ S : PlainIndex gs,chainWeight gs w f S.val.val/chainTotal gs w f) = _
  have he (S : PlainIndex gs) : chainWeight gs w f S.val.val = f S.val.val := by
    rw [chainWeight,chainMultiplier_plain gs w S.val.val S.property,one_mul]
  simp_rw [he]
  rw [← Finset.sum_div,plainIndex_sum,slotTotal_eq_plain_sum gs hgs hcover]

lemma metropolisTrace_pi (S : PlainIndex gs) :
    (metropolisTrace gs hgs hne hcover w f hw hf).π S = f S.val.val/slotTotal gs f ∅ := by
  change (chainWeight gs w f S.val.val/chainTotal gs w f)/
    (metropolisChain gs hgs hne hcover w f hw hf).insideMass (plainPredicate gs) = _
  rw [metropolis_insideMass gs hgs hne hcover w f hw hf,chainWeight,
    chainMultiplier_plain gs w S.val.val S.property,one_mul]
  field_simp [(chainTotal_pos gs hgs hcover w f hf hw).ne']

lemma metropolisTrace_variance (H : Set Γ → ℝ) :
    (metropolisTrace gs hgs hne hcover w f hw hf).variance (fun S => H S.val.val) =
      slotVariance gs f H ∅/slotTotal gs f ∅ := by
  rw [FiniteChain.variance_formula]
  unfold FiniteChain.inner FiniteChain.mean
  simp_rw [metropolisTrace_pi,div_mul_eq_mul_div,← Finset.sum_div]
  rw [plainIndex_sum gs (fun S => f S*H S*H S),plainIndex_sum gs (fun S => f S*H S),
    slotVariance_eq_plain_variance gs hgs hcover,slotTotal_eq_plain_sum gs hgs hcover]
  have he : (∑ S with PlainState gs S,f S*H S*H S) = ∑ S with PlainState gs S,f S*(H S)^2 := by
    apply Finset.sum_congr rfl; intro S _; ring
  rw [he]
  have hz := (slotTotal_pos gs f hf ∅ hgs).ne'
  rw [slotTotal_eq_plain_sum gs hgs hcover] at hz
  field_simp

theorem metropolisTrace_poincare (hsig : HasSlotSignature f)
    (hgood : ∀ p ∈ gs,∀ r ∈ gs,p ≠ r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (h : PlainIndex gs → ℝ) :
    (metropolisTrace gs hgs hne hcover w f hw hf).variance h ≤
      18*(gs.length:ℝ)^4*(metropolisTrace gs hgs hne hcover w f hw hf).energy h := by
  let := plainIndex_nonempty gs hgs hcover
  let C := metropolisChain gs hgs hne hcover w f hw hf
  let Q := metropolisKilled gs hgs hne hcover w f hw hf
  let H := C.harmonicExtension (plainPredicate gs) Q h
  let F := extendChainFun gs H
  have hF (S : ChainIndex gs) : F S.val = H S := extendChainFun_apply gs H S
  have hh (S : PlainIndex gs) : F S.val.val = h S := by
    rw [hF]; exact C.harmonicExtension_inside (plainPredicate gs) Q h S
  have hvar := metropolisTrace_variance gs hgs hne hcover w f hw hf F
  have hefun : (fun S : PlainIndex gs => F S.val.val) = h := funext hh
  rw [hefun] at hvar
  have hv := transversal_variance_bound gs f F w hf hsig hgs hw hgood
  have hz := slotTotal_pos gs f hf ∅ hgs
  have hΛ := chainTotal_pos gs hgs hcover w f hf hw
  have hn : (1:ℝ) ≤ gs.length := by exact_mod_cast List.length_pos_iff.mpr hne
  have henergy : restrictedEnergy (chainEdges gs) (chainConductance gs w f) F ∅ ∅ =
      (2*(gs.length:ℝ)^2*slotTotal gs f ∅)*(metropolisTrace gs hgs hne hcover w f hw hf).energy h := by
    have hc := metropolisChain_energy gs hgs hne hcover w f F hw hf
    have hfFn : (fun S : ChainIndex gs => F S.val) = H := funext hF
    rw [hfFn] at hc
    change C.energy (C.harmonicExtension (plainPredicate gs) Q h) = _ at hc
    rw [C.traceChain_energy (plainPredicate gs) Q (by intro _ _; rfl)] at hc
    change C.insideMass (plainPredicate gs)*(metropolisTrace gs hgs hne hcover w f hw hf).energy h = _ at hc
    rw [metropolis_insideMass gs hgs hne hcover w f hw hf] at hc
    unfold chainDirichlet at hc
    field_simp at hc
    nlinarith
  rw [henergy] at hv
  rw [hvar]
  have hE := (metropolisTrace gs hgs hne hcover w f hw hf).energy_nonneg h
  apply (div_le_iff₀ hz).mpr
  have hconst : (gs.length:ℝ)*(1+8*(gs.length:ℝ))*(2*(gs.length:ℝ)^2) ≤ 18*(gs.length:ℝ)^4 := by
    nlinarith [sq_nonneg ((gs.length:ℝ)-1),sq_nonneg (gs.length:ℝ)]
  have hb := mul_le_mul_of_nonneg_right hconst (mul_nonneg hz.le hE)
  nlinarith
end TracePoincare

namespace KilledKernel
open scoped BigOperators Classical
variable {B : Type*} [Fintype B] (Q : KilledKernel B)
lemma apply_mono {f g : B → ℝ} (h : ∀ x,f x ≤ g x) (x : B) : Q.apply f x ≤ Q.apply g x :=
  Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (h y) (Q.nonnegative x y))
lemma iterate_mono {f g : B → ℝ} (h : ∀ x,f x ≤ g x) (k : ℕ) (x : B) :
    Q.iterate k f x ≤ Q.iterate k g x := by
  induction k generalizing x with
  | zero => exact h x
  | succ k ih => rw [Q.iterate_succ,Q.iterate_succ]; exact Q.apply_mono ih x
lemma survival_antitone (x : B) : Antitone (fun k => Q.iterate k (fun _ => 1) x) := by
  apply antitone_nat_of_succ_le
  intro k
  rw [Q.iterate_succ']
  apply Q.iterate_mono
  intro y
  simpa only [apply,mul_one] using (Q.rowbound y).trans Q.rlt.le
lemma duration_tail (N : ℕ) (x : B) :
    (N:ℝ)*Q.iterate N (fun _ => 1) x ≤ Q.green (fun _ => 1) x := by
  calc
    _ = ∑ k ∈ Finset.range N,Q.iterate N (fun _ => 1) x := by simp
    _ ≤ ∑ k ∈ Finset.range N,Q.iterate k (fun _ => 1) x :=
      Finset.sum_le_sum (fun k hk => Q.survival_antitone x (Finset.mem_range.mp hk).le)
    _ ≤ _ := (Q.summable_iterate (fun _ => 1) x).sum_le_tsum (Finset.range N)
      (fun k _ => Q.iterate_nonneg k _ (by intro; norm_num) x)
noncomputable def partialGreen (N : ℕ) (f : B → ℝ) (x : B) : ℝ :=
  ∑ k ∈ Finset.range N,Q.iterate k f x
lemma partialGreen_nonneg (N : ℕ) (f : B → ℝ) (hf : ∀ x,0 ≤ f x) (x : B) :
    0 ≤ Q.partialGreen N f x := Finset.sum_nonneg (fun k _ => Q.iterate_nonneg k f hf x)
lemma partialGreen_le (N : ℕ) (f : B → ℝ) (hf : ∀ x,0 ≤ f x) (x : B) :
    Q.partialGreen N f x ≤ Q.green f x :=
  (Q.summable_iterate f x).sum_le_tsum (Finset.range N) (fun k _ => Q.iterate_nonneg k f hf x)
lemma partialGreen_sum {J : Type*} (s : Finset J) (f : J → B → ℝ) (N : ℕ) (x : B) :
    Q.partialGreen N (fun y => ∑ j ∈ s,f j y) x = ∑ j ∈ s,Q.partialGreen N (f j) x := by
  unfold partialGreen
  simp_rw [Q.iterate_sum]
  exact Finset.sum_comm
end KilledKernel

namespace FiniteChain
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X) (A : X → Prop)
  (Q : KilledKernel (Outside A)) (hQ : ∀ x y,Q.Q x y=C.P x.val y.val)

noncomputable def cappedTrace (N : ℕ) (x y : Inside A) : ℝ :=
  C.P x.val y.val + ∑ z : Outside A,C.P x.val z.val*
    Q.partialGreen N (fun t => C.P t.val y.val) z
lemma cappedTrace_nonneg (N : ℕ) (x y : Inside A) : 0 ≤ C.cappedTrace A Q N x y := by
  apply add_nonneg (C.nonnegative _ _)
  exact Finset.sum_nonneg (fun z _ => mul_nonneg (C.nonnegative _ _)
    (Q.partialGreen_nonneg N _ (fun t => C.nonnegative _ _) z))
lemma cappedTrace_le (N : ℕ) (x y : Inside A) : C.cappedTrace A Q N x y ≤ C.traceMatrix A Q x y := by
  unfold cappedTrace traceMatrix
  apply add_le_add_right
  apply Finset.sum_le_sum
  intro z _
  exact mul_le_mul_of_nonneg_left (Q.partialGreen_le N _ (fun t => C.nonnegative _ _) z) (C.nonnegative _ _)
include hQ in
lemma cappedTrace_mass (N : ℕ) (x : Inside A) :
    ∑ y,C.cappedTrace A Q N x y = 1-∑ z : Outside A,C.P x.val z.val*Q.iterate N (fun _ => 1) z := by
  unfold cappedTrace
  rw [Finset.sum_add_distrib,Finset.sum_comm]
  simp_rw [← Finset.mul_sum,← Q.partialGreen_sum]
  have he : (fun t : Outside A => ∑ y : Inside A,C.P t.val y.val) =
      fun t => 1-Q.apply (fun _ => 1) t := by
    funext t
    exact C.exitRow A Q hQ t
  rw [he]
  simp_rw [KilledKernel.partialGreen,Q.iterate_residual_sum,mul_sub,mul_one,Finset.sum_sub_distrib]
  have hs := Fintype.sum_subtype_add_sum_subtype A (fun y => C.P x.val y)
  rw [C.stochastic] at hs
  linarith

include hQ in
lemma cappedTrace_loss (N : ℕ) (x : Inside A) :
    (N:ℝ)*(1-∑ y,C.cappedTrace A Q N x y) ≤ C.returnCost A Q x := by
  rw [C.cappedTrace_mass A Q hQ]
  simp only [sub_sub_cancel]
  calc
    _ = ∑ z : Outside A,C.P x.val z.val*((N:ℝ)*Q.iterate N (fun _ => 1) z) := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro z _; ring
    _ ≤ ∑ z : Outside A,C.P x.val z.val*duration A Q z :=
      Finset.sum_le_sum (fun z _ => mul_le_mul_of_nonneg_left (Q.duration_tail N z) (C.nonnegative _ _))
    _ ≤ _ := by unfold returnCost; linarith

include hQ in
lemma cappedTrace_substochastic (N : ℕ) (x : Inside A) : ∑ y,C.cappedTrace A Q N x y ≤ 1 := by
  calc
    _ ≤ ∑ y,C.traceMatrix A Q x y := Finset.sum_le_sum (fun y _ => C.cappedTrace_le A Q N x y)
    _ = 1 := C.traceMatrix_stochastic A Q hQ x

lemma cappedTrace_warm_loss [Nonempty (Inside A)] (N : ℕ) (U : ℝ) (ν : Inside A → ℝ)
    (hν : ∀ x,0 ≤ ν x) (hwarm : ∀ x,ν x ≤ U*(C.traceChain A Q hQ).π x) :
    (N:ℝ)*(∑ x,ν x*(1-∑ y,C.cappedTrace A Q N x y)) ≤ U/C.insideMass A := by
  calc
    _ = ∑ x,ν x*((N:ℝ)*(1-∑ y,C.cappedTrace A Q N x y)) := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro x _; ring
    _ ≤ ∑ x,ν x*C.returnCost A Q x := Finset.sum_le_sum (fun x _ =>
      mul_le_mul_of_nonneg_left (C.cappedTrace_loss A Q hQ N x) (hν x))
    _ ≤ _ := C.warm_returnCost A Q hQ ν U hwarm
end FiniteChain

structure FiniteKernel (X Y : Type*) [Fintype Y] where
  P : X → Y → ℝ
  nonnegative : ∀ x y,0 ≤ P x y
  substochastic : ∀ x,∑ y,P x y ≤ 1
namespace FiniteKernel
open scoped BigOperators Classical
variable {X Y Z : Type*} [Fintype X] [Fintype Y] [Fintype Z]
noncomputable def identity : FiniteKernel X X where
  P x y := if x=y then 1 else 0
  nonnegative := by intros; split_ifs <;> norm_num
  substochastic := by intro x; simp
noncomputable def comp (K : FiniteKernel X Y) (L : FiniteKernel Y Z) : FiniteKernel X Z where
  P x z := ∑ y,K.P x y*L.P y z
  nonnegative := by intros; exact Finset.sum_nonneg (fun y _ => mul_nonneg (K.nonnegative _ _) (L.nonnegative _ _))
  substochastic := by
    intro x
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum]
    calc
      _ ≤ ∑ y,K.P x y*1 := Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left (L.substochastic y) (K.nonnegative x y))
      _ ≤ 1 := by simp only [mul_one]; exact K.substochastic x
noncomputable def push (K : FiniteKernel X Y) (ν : X → ℝ) (y : Y) := ∑ x,ν x*K.P x y
lemma push_nonneg (K : FiniteKernel X Y) (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) (y : Y) :
    0 ≤ K.push ν y := Finset.sum_nonneg (fun x _ => mul_nonneg (hν x) (K.nonnegative x y))
lemma push_mono (K : FiniteKernel X Y) {ν ν' : X → ℝ} (h : ∀ x,ν x ≤ ν' x) (y : Y) :
    K.push ν y ≤ K.push ν' y := Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_right (h x) (K.nonnegative x y))
lemma push_comp (K : FiniteKernel X Y) (L : FiniteKernel Y Z) (ν : X → ℝ) :
    (K.comp L).push ν = L.push (K.push ν) := by
  funext z
  simp only [push,comp,Finset.mul_sum,Finset.sum_mul,mul_assoc]
  exact Finset.sum_comm
lemma push_identity (ν : X → ℝ) : (identity : FiniteKernel X X).push ν = ν := by
  funext x; simp [push,identity]
lemma push_mass (K : FiniteKernel X Y) (ν : X → ℝ) :
    ∑ y,K.push ν y = ∑ x,ν x*(∑ y,K.P x y) := by
  unfold push; rw [Finset.sum_comm]; simp_rw [← Finset.mul_sum]
lemma push_mass_le (K : FiniteKernel X Y) (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) :
    ∑ y,K.push ν y ≤ ∑ x,ν x := by
  rw [K.push_mass]
  exact Finset.sum_le_sum (fun x _ => by simpa using mul_le_mul_of_nonneg_left (K.substochastic x) (hν x))
noncomputable def power (K : FiniteKernel X X) : ℕ → FiniteKernel X X
  | 0 => identity
  | n+1 => (K.power n).comp K
lemma power_push_succ (K : FiniteKernel X X) (n : ℕ) (ν : X → ℝ) :
    (K.power (n+1)).push ν = K.push ((K.power n).push ν) := (K.power n).push_comp K ν
lemma push_domination (K L : FiniteKernel X Y) (hKL : ∀ x y,K.P x y ≤ L.P x y)
    (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) (y : Y) : K.push ν y ≤ L.push ν y :=
  Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (hKL x y) (hν x))
lemma power_domination (K L : FiniteKernel X X) (hKL : ∀ x y,K.P x y ≤ L.P x y)
    (n : ℕ) (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) (y : X) :
    (K.power n).push ν y ≤ (L.power n).push ν y := by
  induction n generalizing y with
  | zero => exact le_rfl
  | succ n ih =>
    rw [K.power_push_succ,L.power_push_succ]
    exact (K.push_mono (fun y => ih y) y).trans
      (K.push_domination L hKL _ ((L.power n).push_nonneg ν hν) y)

lemma one_step_defect (K L : FiniteKernel X Y) (hL : ∀ x,∑ y,L.P x y=1)
    (a b : X → ℝ) (_ : ∀ x,0 ≤ a x) (hab : ∀ x,a x ≤ b x) :
    (∑ y,L.push b y)-(∑ y,K.push a y) ≤
      (∑ x,b x)-(∑ x,a x)+∑ x,b x*(1-∑ y,K.P x y) := by
  rw [L.push_mass,K.push_mass]
  simp_rw [hL,mul_one]
  have hh : ∑ x,a x*(1-∑ y,K.P x y) ≤ ∑ x,b x*(1-∑ y,K.P x y) :=
    Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_right (hab x) (sub_nonneg.mpr (K.substochastic x)))
  simp_rw [mul_sub,mul_one,Finset.sum_sub_distrib] at hh ⊢
  linarith
end FiniteKernel

namespace FiniteChain

section
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X)
noncomputable def kernel : FiniteKernel X X where
  P := C.P
  nonnegative := C.nonnegative
  substochastic := fun x => (C.stochastic x).le
lemma kernel_stationary : C.kernel.push C.π = C.π := by
  funext y; exact C.stationary y
lemma push_warm (ν : X → ℝ) (U : ℝ) (hν : ∀ x,ν x ≤ U*C.π x) (y : X) :
    C.kernel.push ν y ≤ U*C.π y := by
  calc
    _ ≤ ∑ x,U*C.π x*C.P x y := C.kernel.push_mono hν y
    _ = U*C.π y := by simp only [mul_assoc,← Finset.mul_sum,C.stationary]
lemma power_warm (n : ℕ) (ν : X → ℝ) (U : ℝ) (hν : ∀ x,ν x ≤ U*C.π x) (y : X) :
    (C.kernel.power n).push ν y ≤ U*C.π y := by
  induction n generalizing y with
  | zero => simpa [FiniteKernel.power,FiniteKernel.push_identity] using hν y
  | succ n ih => rw [FiniteKernel.power_push_succ]; exact C.push_warm _ U (fun y => ih y) y
lemma kernel_power_stochastic (n : ℕ) (x : X) : ∑ y,(C.kernel.power n).P x y=1 := by
  induction n with
  | zero => simp [FiniteKernel.power,FiniteKernel.identity]
  | succ n ih =>
    change (∑ y,∑ z,(C.kernel.power n).P x z*C.P z y) = 1
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum,C.stochastic,mul_one]
    exact ih
lemma power_push_mass (n : ℕ) (ν : X → ℝ) : ∑ y,(C.kernel.power n).push ν y = ∑ x,ν x := by
  rw [FiniteKernel.push_mass]
  simp_rw [C.kernel_power_stochastic,mul_one]

lemma capped_power_mass (K : FiniteKernel X X) (hK : ∀ x y,K.P x y≤C.P x y)
    (ν : X → ℝ) (hν : ∀ x,0≤ν x) (hnorm : ∑ x,ν x=1)
    (U e : ℝ) (hwarm : ∀ x,ν x≤U*C.π x)
    (hloss : ∀ a : X → ℝ,(∀ x,0≤a x) → (∀ x,a x≤U*C.π x) →
      (∑ x,a x*(1-∑ y,K.P x y))≤e) (T : ℕ) :
    1-(∑ x,(K.power T).push ν x)≤(T:ℝ)*e := by
  have hdom := fun n x => K.power_domination C.kernel hK n ν hν x
  induction T with
  | zero => simp [FiniteKernel.power,FiniteKernel.push_identity,hnorm]
  | succ T ih =>
    have h := K.one_step_defect C.kernel C.stochastic
      ((K.power T).push ν) ((C.kernel.power T).push ν)
      ((K.power T).push_nonneg ν hν) (hdom T)
    have hl := hloss ((C.kernel.power T).push ν)
      ((C.kernel.power T).push_nonneg ν hν) (C.power_warm T ν U hwarm)
    have hm := C.power_push_mass T ν
    have hm' := C.power_push_mass (T+1) ν
    rw [FiniteKernel.power_push_succ] at hm'
    rw [FiniteKernel.power_push_succ]
    simp only [hnorm] at hm hm'
    rw [hm,hm'] at h
    push_cast
    linarith

variable (A : X → Prop) (Q : KilledKernel (Outside A)) (hQ : ∀ x y,Q.Q x y=C.P x.val y.val)
noncomputable def cappedTraceKernel (N : ℕ) : FiniteKernel (Inside A) (Inside A) where
  P := C.cappedTrace A Q N
  nonnegative := C.cappedTrace_nonneg A Q N
  substochastic := C.cappedTrace_substochastic A Q hQ N
lemma cappedTrace_power_mass [Nonempty (Inside A)] (N T : ℕ) (hN : 0<N)
    (U : ℝ) (ν : Inside A → ℝ) (hν : ∀ x,0≤ν x) (hnorm : ∑ x,ν x=1)
    (hwarm : ∀ x,ν x≤U*(C.traceChain A Q hQ).π x) :
    1-(∑ x,((C.cappedTraceKernel A Q hQ N).power T).push ν x) ≤
      (T:ℝ)*(U/C.insideMass A/(N:ℝ)) := by
  apply (C.traceChain A Q hQ).capped_power_mass (C.cappedTraceKernel A Q hQ N)
    (C.cappedTrace_le A Q N) ν hν hnorm U _ hwarm
  intro a ha haw
  have h := C.cappedTrace_warm_loss A Q hQ N U a ha haw
  apply (le_div_iff₀ (by exact_mod_cast hN : (0:ℝ)<N)).mpr
  simpa only [cappedTraceKernel,mul_comm] using h
end

section
open scoped BigOperators Classical
variable {X : Type*} [sectionInstance81 : Fintype X] (C : FiniteChain X)
lemma pathExpectation_mono (N : ℕ) (x : X) (F G : List X → ℝ) (h : ∀ l,F l≤G l) :
    C.pathExpectation N x F≤C.pathExpectation N x G := by
  induction N generalizing x F G with
  | zero => exact h _
  | succ N ih =>
    apply Finset.sum_le_sum
    intro y _
    exact mul_le_mul_of_nonneg_left (ih y _ _ (fun l => h _)) (C.nonnegative x y)
lemma pathExpectation_finsum {J : Type*} (s : Finset J) (N : ℕ) (x : X) (F : J → List X → ℝ) :
    C.pathExpectation N x (fun l => ∑ j ∈ s,F j l) = ∑ j ∈ s,C.pathExpectation N x (F j) := by
  induction s using Finset.induction_on with
  | empty => simp [C.pathExpectation_const]
  | @insert j s hj ih => simp [Finset.sum_insert,hj,C.pathExpectation_add,ih]
lemma pathExpectation_congr_length (N : ℕ) (x : X) (F G : List X → ℝ)
    (h : ∀ l,l.length=N+1 → F l=G l) : C.pathExpectation N x F=C.pathExpectation N x G := by
  induction N generalizing x F G with
  | zero => exact h [x] rfl
  | succ N ih =>
    apply Finset.sum_congr rfl
    intro y _
    congr 1
    apply ih
    intro l hl
    exact h (x::l) (by simp [hl])
omit sectionInstance81 in
lemma pathSum_center [Fintype X] (G : X → ℝ) (m : ℝ) (l : List X) :
    pathSum (fun x => G x-m) l = pathSum G l-(l.length:ℝ)*m := by
  induction l with
  | nil => simp [pathSum]
  | cons x l ih => simp only [pathSum_cons,List.length_cons,Nat.cast_add,Nat.cast_one]; rw [ih]; ring

noncomputable def pathProbability (ν : X → ℝ) (N : ℕ) (E : List X → Prop) : ℝ :=
  ∑ x,ν x*C.pathExpectation N x (fun l => if E l then 1 else 0)
lemma pathProbability_nonneg (ν : X → ℝ) (hν : ∀ x,0≤ν x) (N : ℕ) (E : List X → Prop) :
    0≤C.pathProbability ν N E := Finset.sum_nonneg (fun x _ => mul_nonneg (hν x)
      (C.pathExpectation_nonneg N x _ (by intro l; split_ifs <;> norm_num)))
lemma pathProbability_mono (ν : X → ℝ) (hν : ∀ x,0≤ν x) (N : ℕ) (E F : List X → Prop)
    (h : ∀ l,E l → F l) : C.pathProbability ν N E≤C.pathProbability ν N F := by
  apply Finset.sum_le_sum
  intro x _
  apply mul_le_mul_of_nonneg_left _ (hν x)
  apply C.pathExpectation_mono
  intro l
  by_cases he : E l
  · simp [he,h l he]
  · simp [he]; split_ifs <;> norm_num
lemma pathProbability_union {J : Type*} [Fintype J] (ν : X → ℝ) (hν : ∀ x,0≤ν x)
    (N : ℕ) (E : J → List X → Prop) :
    C.pathProbability ν N (fun l => ∃ j,E j l) ≤ ∑ j,C.pathProbability ν N (E j) := by
  classical
  have h : ∀ l,(if ∃ j,E j l then (1:ℝ) else 0)≤∑ j,if E j l then 1 else 0 := by
    intro l
    by_cases he : ∃ j,E j l
    · obtain ⟨j,hj⟩ := he
      rw [ite_eq_left ⟨j,hj⟩]
      calc
        (1:ℝ) = (if E j l then 1 else 0) := by simp [hj]
        _ ≤ ∑ j,if E j l then 1 else 0 := Finset.single_le_sum (f := fun j => if E j l then (1:ℝ) else 0)
          (fun j _ => by split_ifs <;> norm_num) (Finset.mem_univ j)
    · simp [show ∀ j,¬E j l from fun j hj => he ⟨j,hj⟩]
  unfold pathProbability
  calc
    _ = ∑ x,ν x*C.pathExpectation N x (fun l => if ∃ j,E j l then 1 else 0) := by
      apply Finset.sum_congr rfl
      intro x _
      congr 1
      apply C.pathExpectation_congr
      intro l
      split_ifs <;> rfl
    _ ≤ ∑ x,ν x*C.pathExpectation N x (fun l => ∑ j,if E j l then 1 else 0) :=
      Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (C.pathExpectation_mono N x _ _ h) (hν x))
    _ = _ := by simp_rw [C.pathExpectation_finsum,Finset.mul_sum]; exact Finset.sum_comm

lemma pathProbability_average_error (ν : X → ℝ) (hν : ∀ x,0≤ν x) (G : X → ℝ)
    (m t : ℝ) (ht : 0<t) (N : ℕ) (hN : 0<N) :
    C.pathProbability ν (N-1) (fun l => t < |pathSum G l/(N:ℝ)-m|) ≤
      ((∑ x,ν x*C.squareMoment (fun x => G x-m) N x)/(N:ℝ)^2)/t^2 := by
  have hn : (0:ℝ)<N := by exact_mod_cast hN
  have hpoint : ∀ l,(if t < |pathSum G l/(N:ℝ)-m| then (1:ℝ) else 0)≤
      (pathSum G l/(N:ℝ)-m)^2/t^2 := by
    intro l
    by_cases he : t < |pathSum G l/(N:ℝ)-m|
    · rw [ite_eq_left he,le_div_iff₀ (sq_pos_of_pos ht)]
      have hh := (sq_lt_sq₀ ht.le (abs_nonneg _)).mpr he
      simpa only [sq_abs,one_mul] using hh.le
    · rw [ite_eq_right he]; positivity
  have h := Finset.sum_le_sum (s := Finset.univ) (fun x _ =>
    mul_le_mul_of_nonneg_left (C.pathExpectation_mono (N-1) x _ _ hpoint) (hν x))
  change C.pathProbability ν (N-1) _ ≤ _ at h
  have he : ∀ x,C.pathExpectation (N-1) x (fun l => (pathSum G l/(N:ℝ)-m)^2/t^2) =
      C.squareMoment (fun x => G x-m) N x/(N:ℝ)^2/t^2 := by
    intro x
    rw [squareMoment,ite_eq_right (Nat.ne_of_gt hN)]
    have hh : C.pathExpectation (N-1) x (fun l => (pathSum G l/(N:ℝ)-m)^2/t^2) =
        C.pathExpectation (N-1) x (fun l => (1/(N:ℝ)^2/t^2)*(pathSum (fun x => G x-m) l)^2) := by
      apply C.pathExpectation_congr_length
      intro l hl
      have hl' : l.length=N := by omega
      rw [pathSum_center,hl']
      field_simp

    rw [hh,C.pathExpectation_mul]
    ring
  simp_rw [he] at h
  simpa only [← mul_div_assoc,← Finset.sum_div] using h
end

open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X)
lemma variance_le_one (G : X → ℝ) (hG : ∀ x,0≤G x ∧ G x≤1) : C.variance G≤1 := by
  rw [C.variance_formula]
  have h : C.inner G G≤1 := by
    calc
      _ ≤ ∑ x,C.π x*1 := Finset.sum_le_sum (fun x _ => by
        have hx := hG x
        have hh : G x*G x≤1 := by nlinarith
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hh (C.positive x).le)
      _ = 1 := by simpa using C.normalized
  nlinarith [sq_nonneg (C.mean G)]

lemma relative_union_bound {J : Type*} [Fintype J]
    (ν : X → ℝ) (hν : ∀ x,0≤ν x) (G : J → X → ℝ)
    (m η v : ℝ) (hm : 0 < m) (hη : 0<η) (hv : 0≤v)
    (hmean : ∀ j,m≤C.mean (G j)) (N : ℕ) (hN : 0<N)
    (hmse : ∀ j,(∑ x,ν x*C.squareMoment (fun x => G j x-C.mean (G j)) N x)/(N:ℝ)^2≤v) :
    C.pathProbability ν (N-1) (fun l => ∃ j,η*C.mean (G j) <
      |pathSum (G j) l/(N:ℝ)-C.mean (G j)|) ≤ (Fintype.card J:ℝ)*v/(η*m)^2 := by
  calc
    _ ≤ ∑ j,C.pathProbability ν (N-1) (fun l => η*C.mean (G j) <
      |pathSum (G j) l/(N:ℝ)-C.mean (G j)|) := C.pathProbability_union ν hν (N-1) _
    _ ≤ ∑ j,v/(η*m)^2 := by
      apply Finset.sum_le_sum
      intro j _
      have hj : 0<C.mean (G j) := hm.trans_le (hmean j)
      have ht : 0<η*C.mean (G j) := mul_pos hη hj
      have hb := C.pathProbability_average_error ν hν (G j) (C.mean (G j))
        (η*C.mean (G j)) ht N hN
      have hden : (η*m)^2≤(η*C.mean (G j))^2 := by
        exact (sq_le_sq₀ (mul_nonneg hη.le hm.le) ht.le).mpr
          (mul_le_mul_of_nonneg_left (hmean j) hη.le)
      exact hb.trans ((div_le_div_of_nonneg_right (hmse j) (sq_nonneg _)).trans
        (div_le_div_of_nonneg_left hv (sq_pos_of_pos (mul_pos hη hm)) hden))
    _ = _ := by simp [mul_div_assoc]
end FiniteChain

section PhaseProbability
open scoped BigOperators Classical
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]

theorem metropolisChain_bounded_MSE (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs ≠ [])
    (hcover : pairSupport gs = Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hsig : HasSlotSignature f) (hG : ClassObservable gs G)
    (hbounded : ∀ S,ChainState gs S → 0≤G S ∧ G S≤1)
    (hlower : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p ∈ gs, ∀ r ∈ gs, p ≠ r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (ν : ChainIndex gs → ℝ)
    (hwarm : ∀ S,ν S ≤ (10*(gs.length:ℝ)^2)*chainWeight gs w f S.val/chainTotal gs w f)
    (N : ℕ) (hN : 0 < N) :
    let C := metropolisChain gs hgs hne hcover w f hw hf
    (∑ S,ν S*C.squareMoment (fun S => G S.val-C.mean (fun S => G S.val)) N S)/(N:ℝ)^2 ≤
      40000*(gs.length:ℝ)^8/N := by
  have h := metropolisChain_timeAverage gs hgs hne hcover w f G hw hf hsig hG
    hlower hupper (10*(gs.length:ℝ)^2) (by positivity) ν hwarm N hN
  have hv := (metropolisChain gs hgs hne hcover w f hw hf).variance_le_one
    (fun S => G S.val) (fun S => hbounded S.val S.property)
  rw [metropolisChain_variance] at hv
  dsimp only
  rw [metropolisChain_mean]
  calc
    _ ≤ _ := h
    _ ≤ 2*(10*(gs.length:ℝ)^2)*(2000*(gs.length:ℝ)^6)*1/N :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hv (by positivity)) (by positivity)
    _ = _ := by ring

lemma phase_error_arithmetic (n L J N : ℕ) (hn : 0<n) (hJ : J≤2*n^2)
    (η : ℝ) (hη : 0<η)
    (hN : (10:ℝ)^10*(L+1)*n^14/η^2≤N) :
    (J:ℝ)*(40000*(n:ℝ)^8/N)/(η*(1/(20*(n:ℝ)^2)))^2 ≤ 1/(32*(L+1:ℝ)) := by
  have hn' : (0:ℝ)<n := by exact_mod_cast hn
  have hL : (0:ℝ)<L+1 := by positivity
  have hN' : (0:ℝ)<N := lt_of_lt_of_le (by positivity) hN
  have hJ' : (J:ℝ)≤2*(n:ℝ)^2 := by exact_mod_cast hJ
  have hh : (10:ℝ)^10*(L+1)*n^14≤(N:ℝ)*η^2 := (div_le_iff₀ (sq_pos_of_pos hη)).mp hN
  have hnum : (J:ℝ)*40000*(n:ℝ)^8*(20*(n:ℝ)^2)^2*(32*(L+1:ℝ)) ≤
      (10:ℝ)^10*(L+1)*n^14 := by
    have h := mul_le_mul_of_nonneg_right hJ' (show 0≤40000*(n:ℝ)^8*(20*(n:ℝ)^2)^2*(32*(L+1:ℝ)) by positivity)
    calc
      _ ≤ (2*(n:ℝ)^2)*(40000*(n:ℝ)^8*(20*(n:ℝ)^2)^2*(32*(L+1:ℝ))) := by nlinarith only [h]
      _ = 1024000000*(L+1)*(n:ℝ)^14 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (by norm_num) hL.le) (by positivity)
  have hd : (J:ℝ)*(40000*(n:ℝ)^8/N)/(η*(1/(20*(n:ℝ)^2)))^2 =
      (J:ℝ)*40000*(n:ℝ)^8*(20*(n:ℝ)^2)^2/((N:ℝ)*η^2) := by
    field_simp
  rw [hd]
  apply (div_le_div_iff₀ (mul_pos hN' (sq_pos_of_pos hη)) (by positivity)).mpr
  simpa only [one_mul] using hnum.trans hh
end PhaseProbability

section SamplingObservables
open scoped BigOperators Classical
variable {Γ : Type*} [sectionInstance85 : Fintype Γ] [DecidableEq Γ]
noncomputable def plainObservable (gs : List (Γ × Γ)) (g : Set Γ → ℝ) (S : Set Γ) : ℝ :=
  if PlainState gs S then g S else 0
noncomputable def defectIndicator (gs : List (Γ × Γ)) (p r : Γ × Γ) (S : Set Γ) : ℝ :=
  if DefectState gs p r S then 1 else 0
lemma plainObservable_class (gs : List (Γ × Γ)) (g : Set Γ → ℝ) :
    ClassObservable gs (plainObservable gs g) := by
  intro p r S T hS hT
  simp [plainObservable,hS.not_plain,hT.not_plain]
lemma defectIndicator_class (gs : List (Γ × Γ)) (p r : Γ × Γ) :
    ClassObservable gs (defectIndicator gs p r) := by
  intro p' r' S T hS hT
  have he : DefectState gs p r S ↔ DefectState gs p r T := by
    constructor
    · intro h
      obtain ⟨rfl,rfl⟩ := hS.unique h
      exact hT
    · intro h
      obtain ⟨rfl,rfl⟩ := hT.unique h
      exact hS
  simp [defectIndicator,he]
lemma plainObservable_mean (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) : chainMean gs w f (plainObservable gs g) =
      slotTotal gs (fun S =>  f S*g S) ∅/chainTotal gs w f := by
  unfold chainMean
  congr 1
  simp only [chainWeight,mul_assoc]
  rw [chain_sum_decomposition,slotTotal_eq_plain_sum gs hgs hcover]
  have hplain : (∑ S with PlainState gs S,f S*plainObservable gs g S)=
      ∑ S with PlainState gs S,f S*g S := by
    apply Finset.sum_congr rfl
    intro S hS
    simp [plainObservable,(Finset.mem_filter.mp hS).2]
  rw [hplain]
  have hdef : ∀ pr ∈ defectTypes gs,(∑ S with DefectState gs pr.1 pr.2 S,f S*plainObservable gs g S)=0 := by
    intro pr hpr
    apply Finset.sum_eq_zero
    intro S hS
    simp [plainObservable,((Finset.mem_filter.mp hS).2).not_plain]
  rw [add_eq_left]
  apply Finset.sum_eq_zero
  intro pr hpr
  rw [hdef pr hpr,mul_zero]
lemma defectIndicator_mean (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f : Set Γ → ℝ) (p r : Γ × Γ) (hp : p∈gs) (hr : r∈gs) (hpr : p≠r) :
    chainMean gs w f (defectIndicator gs p r) =
      w p r*slotDefect gs f ∅ p r/chainTotal gs w f := by
  unfold chainMean
  congr 1
  simp only [chainWeight,mul_assoc]
  rw [chain_sum_decomposition,slotDefect_eq_defect_sum gs hgs hcover f p r hp hr hpr]
  have hplain : (∑ S with PlainState gs S,f S*defectIndicator gs p r S)=0 := by
    apply Finset.sum_eq_zero
    intro S hS
    have hh : ¬DefectState gs p r S := fun h =>  h.not_plain (Finset.mem_filter.mp hS).2
    simp [defectIndicator,hh]
  rw [hplain,zero_add]
  rw [Finset.sum_eq_single (p,r)]
  · congr 1
    apply Finset.sum_congr rfl
    intro S hS
    simp [defectIndicator,(Finset.mem_filter.mp hS).2]
  · intro pr hm hne
    have he : ∀ S,DefectState gs pr.1 pr.2 S → ¬DefectState gs p r S := by
      intro S hS h
      exact hne (Prod.ext (hS.unique h).1 (hS.unique h).2)
    have hz : (∑ S with DefectState gs pr.1 pr.2 S,f S*defectIndicator gs p r S)=0 := by
      apply Finset.sum_eq_zero
      intro S hS
      simp [defectIndicator,he S (Finset.mem_filter.mp hS).2]
    rw [hz,mul_zero]
  · intro h
    exact (h ((mem_defectTypes gs (p,r)).mpr ⟨hp,hr,hpr⟩)).elim
lemma plain_mass_lower (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hupper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r) :
    1/(5*(gs.length:ℝ)^2) ≤ slotTotal gs f ∅/chainTotal gs w f := by
  have hz := slotTotal_pos gs f hf ∅ hgs
  have hΛ := chainTotal_pos gs hgs hcover w f hf hw
  have hn : (0:ℝ) < gs.length := by exact_mod_cast List.length_pos_iff.mpr hne
  apply (div_le_div_iff₀ (by positivity) hΛ).mpr
  simpa only [one_mul,mul_one,mul_comm] using chainTotal_le gs hgs hne hcover w f hf hupper
lemma defect_mass_lower (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hlower : ∀ p∈gs,∀ r∈gs,p≠r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (p r : Γ × Γ) (hp : p∈gs) (hr : r∈gs) (hpr : p≠r) :
    1/(20*(gs.length:ℝ)^2) ≤ chainMean gs w f (defectIndicator gs p r) := by
  rw [defectIndicator_mean gs hgs hcover w f p r hp hr hpr]
  have hc := slotDefect_pos gs f hf ∅ hgs p r hp hr hpr
  have hΛ := chainTotal_pos gs hgs hcover w f hf hw
  have hwc : slotTotal gs f ∅/4 ≤ w p r*slotDefect gs f ∅ p r := by
    have h := (div_le_iff₀ (show 0 < 4*slotDefect gs f ∅ p r by positivity)).mp (hlower p hp r hr hpr)
    linarith
  calc
    _ = (1/(5*(gs.length:ℝ)^2))/4 := by ring
    _  ≤  (slotTotal gs f ∅/chainTotal gs w f)/4 :=
      div_le_div_of_nonneg_right (plain_mass_lower gs hgs hne hcover w f hw hf hupper) (by norm_num)
    _ = (slotTotal gs f ∅/4)/chainTotal gs w f := by ring
    _  ≤  _ := div_le_div_of_nonneg_right hwc hΛ.le
lemma chainMean_mono (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f G H : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (h : ∀ S,ChainState gs S → G S ≤ H S) : chainMean gs w f G ≤ chainMean gs w f H := by
  apply div_le_div_of_nonneg_right _ (chainTotal_pos gs hgs hcover w f hf hw).le
  apply Finset.sum_le_sum
  intro S hS
  exact mul_le_mul_of_nonneg_left (h S (Finset.mem_filter.mp hS).2)
    (mul_nonneg (chainMultiplier_pos gs w hw S).le (hf S).le)
lemma plainObservable_mass_lower (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hg : ∀ S,PlainState gs S → 1/2 ≤ g S)
    (hupper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r) :
    1/(20*(gs.length:ℝ)^2) ≤ chainMean gs w f (plainObservable gs g) := by
  have hm := chainMean_mono gs hgs hcover w f (plainObservable gs (fun _ =>  1/2))
    (plainObservable gs g) hw hf (by intro S hS; unfold plainObservable; split_ifs with hp; exact hg S hp; rfl)
  rw [plainObservable_mean gs hgs hcover] at hm
  have he : slotTotal gs (fun S =>  f S*(1/2)) ∅ = (1/2)*slotTotal gs f ∅ := by
    have hfun : (fun S =>  f S*(1/2)) = fun S =>  (1/2)*f S := by funext S; ring
    rw [hfun]
    exact coeffDerivs_scale _ _ _ _
  rw [he] at hm
  have hl := plain_mass_lower gs hgs hne hcover w f hw hf hupper
  have hn : (0:ℝ) < gs.length := by exact_mod_cast List.length_pos_iff.mpr hne
  have hp : 0 ≤ 1/(5*(gs.length:ℝ)^2) := by positivity
  calc
    _  ≤  (1/(5*(gs.length:ℝ)^2))/2 := by field_simp; norm_num
    _  ≤  (slotTotal gs f ∅/chainTotal gs w f)/2 := div_le_div_of_nonneg_right hl (by norm_num)
    _  ≤  _ := by convert hm using 1 ; ring

abbrev PhaseObservables (gs : List (Γ × Γ)) := Option {pr // pr∈defectTypes gs} ⊕ Unit
lemma phaseObservables_card (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[]) :
    Fintype.card (PhaseObservables gs) ≤ 2*gs.length^2 := by
  have hn := List.length_pos_iff.mpr hne
  have hc : (defectTypes gs).card=gs.length*gs.length-gs.length := by
    rw [defectTypes,Finset.offDiag_card,List.toFinset_card_of_nodup hgs.nodup]
  simp only [PhaseObservables,Fintype.card_sum,Fintype.card_option,Fintype.card_coe,Fintype.card_unit,hc]
  have hh : gs.length ≤ gs.length*gs.length := by nlinarith
  rw [pow_two]
  omega
noncomputable def phaseObservable (gs : List (Γ × Γ)) (g : Set Γ → ℝ) :
    PhaseObservables gs → Set Γ → ℝ
  | .inl none => plainObservable gs (fun _ => 1)
  | .inl (some pr) => defectIndicator gs pr.val.1 pr.val.2
  | .inr _ => plainObservable gs g
lemma phaseObservable_class (gs : List (Γ × Γ)) (g : Set Γ → ℝ) (j : PhaseObservables gs) :
    ClassObservable gs (phaseObservable gs g j) := by
  rcases j with (_ | pr) | u
  · exact plainObservable_class gs _
  · exact defectIndicator_class gs _ _
  · exact plainObservable_class gs _
omit sectionInstance85 in
lemma phaseObservable_bounded [Fintype Γ] (gs : List (Γ × Γ)) (g : Set Γ → ℝ)
    (hg : ∀ S,PlainState gs S → 0 ≤ g S ∧ g S ≤ 1)
    (j : PhaseObservables gs) (S : Set Γ) :
    0 ≤ phaseObservable gs g j S ∧ phaseObservable gs g j S ≤ 1 := by
  rcases j with (_ | pr) | u
  · simp only [phaseObservable,plainObservable]; split_ifs <;> norm_num
  · simp only [phaseObservable,defectIndicator]; split_ifs <;> norm_num
  · simp only [phaseObservable,plainObservable]; split_ifs with h
    · exact hg S h
    · norm_num
lemma phaseObservable_mean_lower (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hg : ∀ S,PlainState gs S → 1/2 ≤ g S)
    (hlower : ∀ p∈gs,∀ r∈gs,p≠r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (j : PhaseObservables gs) :
    1/(20*(gs.length:ℝ)^2) ≤ chainMean gs w f (phaseObservable gs g j) := by
  rcases j with (_ | pr) | u
  · exact plainObservable_mass_lower gs hgs hne hcover w f _ hw hf (by intros; norm_num) hupper
  · obtain ⟨hp,hr,hpr⟩ := (mem_defectTypes gs pr.val).mp pr.property
    exact defect_mass_lower gs hgs hne hcover w f hw hf hlower hupper _ _ hp hr hpr
  · exact plainObservable_mass_lower gs hgs hne hcover w f g hw hf hg hupper

theorem metropolis_phase_failure (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (hw : ∀ p r,0 < w p r) (hf : ∀ S,0 < f S)
    (hsig : HasSlotSignature f) (hg : ∀ S,PlainState gs S → 1/2 ≤ g S ∧ g S ≤ 1)
    (hlower : ∀ p∈gs,∀ r∈gs,p≠r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r)
    (hupper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r)
    (ν : ChainIndex gs → ℝ) (hν : ∀ S,0 ≤ ν S)
    (hwarm : ∀ S,ν S ≤ (10*(gs.length:ℝ)^2)*chainWeight gs w f S.val/chainTotal gs w f)
    (L N : ℕ) (η : ℝ) (hη : 0 < η)
    (hN : (10:ℝ)^10*(L+1)*gs.length^14/η^2 ≤ N) :
    let C := metropolisChain gs hgs hne hcover w f hw hf
    C.pathProbability ν (N-1) (fun l => ∃ j : PhaseObservables gs,
      η*C.mean (fun S => phaseObservable gs g j S.val) <
        |FiniteChain.pathSum (fun S => phaseObservable gs g j S.val) l/(N:ℝ)-
          C.mean (fun S => phaseObservable gs g j S.val)|) ≤ 1/(32*(L+1:ℝ)) := by
  let C := metropolisChain gs hgs hne hcover w f hw hf
  have hn : 0 < gs.length := List.length_pos_iff.mpr hne
  have hn' : (0:ℝ) < gs.length := by exact_mod_cast hn
  have hN' : (0:ℝ) < N := lt_of_lt_of_le (by positivity) hN
  have hNm : 0 < N := by exact_mod_cast hN'
  have hμ : ∀ j,1/(20*(gs.length:ℝ)^2) ≤ C.mean (fun S => phaseObservable gs g j S.val) := by
    intro j
    rw [metropolisChain_mean]
    exact phaseObservable_mean_lower gs hgs hne hcover w f g hw hf (fun S hS => (hg S hS).1)
      hlower hupper j
  have hb := C.relative_union_bound ν hν (fun j S => phaseObservable gs g j S.val)
    (1/(20*(gs.length:ℝ)^2)) η (40000*(gs.length:ℝ)^8/N) (by positivity) hη (by positivity)
    hμ N hNm (fun j => metropolisChain_bounded_MSE gs hgs hne hcover w f
      (phaseObservable gs g j) hw hf hsig (phaseObservable_class gs g j)
      (fun S _ => phaseObservable_bounded gs g (fun S hS => ⟨by linarith [(hg S hS).1],(hg S hS).2⟩) j S)
      hlower hupper ν hwarm N hNm)
  exact hb.trans (phase_error_arithmetic gs.length L (Fintype.card (PhaseObservables gs)) N hn
    (phaseObservables_card gs hgs hne) η hη hN)
end SamplingObservables

open Set

section PairedReduction
variable {α β : Type*}

lemma sum_eRank (M : Matroid α) (N : Matroid β) :
    (M.sum N).eRank = M.eRank + N.eRank := by
  obtain ⟨B,hB⟩ := M.exists_isBase
  obtain ⟨C,hC⟩ := N.exists_isBase
  have hBC : (M.sum N).IsBase (Sum.inl '' B ∪ Sum.inr '' C) := by
    rw [Matroid.sum_isBase_iff]
    simpa [Set.preimage_image_eq _ Sum.inl_injective,
      Set.preimage_image_eq _ Sum.inr_injective] using And.intro hB hC
  rw [← hBC.encard_eq_eRank, Set.encard_union_eq,
    Set.InjOn.encard_image, Set.InjOn.encard_image,
    hB.encard_eq_eRank, hC.encard_eq_eRank]
  · exact Sum.inr_injective.injOn
  · exact Sum.inl_injective.injOn
  · exact Set.disjoint_image_inl_image_inr

def pairedMatroid (M₁ M₂ : Matroid α) : Matroid (α ⊕ α) := M₁.sum M₂✶

def transversal (A : Set α) : Set (α ⊕ α) := Sum.inl '' A ∪ Sum.inr '' Aᶜ

@[simp] lemma preimage_inl_transversal (A : Set α) :
    Sum.inl ⁻¹' transversal A = A := by
  simp [transversal, Set.preimage_image_eq _ Sum.inl_injective]

@[simp] lemma preimage_inr_transversal (A : Set α) :
    Sum.inr ⁻¹' transversal A = Aᶜ := by
  simp [transversal, 
    Set.preimage_image_eq _ Sum.inr_injective]

lemma transversal_injective : Function.Injective (@transversal α) := by
  intro A B h
  have := congrArg (fun S => Sum.inl ⁻¹' S) h
  simpa using this

lemma paired_ground (M₁ M₂ : Matroid α) (h₁ : M₁.E = Set.univ)
    (h₂ : M₂.E = Set.univ) : (pairedMatroid M₁ M₂).E = Set.univ := by
  ext x
  cases x <;> simp [pairedMatroid, h₁, h₂]

lemma transversal_isBase_iff (M₁ M₂ : Matroid α) (h₂ : M₂.E = Set.univ)
    (A : Set α) :
    (pairedMatroid M₁ M₂).IsBase (transversal A) ↔ M₁.IsBase A ∧ M₂.IsBase A := by
  simp only [pairedMatroid, Matroid.sum_isBase_iff, preimage_inl_transversal,
    preimage_inr_transversal, Matroid.dual_isBase_iff', h₂,
    ← Set.compl_eq_univ_sdiff, compl_compl, Set.subset_univ, and_true]

lemma paired_eRank [Fintype α] (M₁ M₂ : Matroid α) (h₂ : M₂.E = Set.univ)
    (hr : M₁.eRank = M₂.eRank) :
    (pairedMatroid M₁ M₂).eRank = (Fintype.card α : ℕ∞) := by
  rw [pairedMatroid, sum_eRank,hr, M₂.eRank_add_eRank_dual,h₂,
    Set.encard_univ, ENat.card_eq_coe_fintype_card]

lemma transversal_encard [Fintype α] (A : Set α) :
    (transversal A).encard = (Fintype.card α : ℕ∞) := by
  rw [transversal, Set.encard_union_eq,
    Set.InjOn.encard_image, Set.InjOn.encard_image,
    ← Set.encard_union_eq disjoint_compl_right, union_compl_self, Set.encard_univ,
    ENat.card_eq_coe_fintype_card]
  · exact Sum.inr_injective.injOn
  · exact Sum.inl_injective.injOn
  · exact Set.disjoint_image_inl_image_inr

lemma transversal_ncard [Fintype α] (A : Set α) :
    (transversal A).ncard = Fintype.card α := by
  exact_mod_cast (Set.coe_ncard_eq_encard (transversal A)).trans (transversal_encard A)

end PairedReduction

open scoped BigOperators Classical

noncomputable def annealRho (n : ℕ) : ℝ := 1 - 1 / (2 * (n : ℝ))
def annealLength (n b : ℕ) : ℕ := 2*n*(n+b)
noncomputable def annealTolerance (ε : ℝ) (L : ℕ) : ℝ := ε/(32*((L:ℝ)+1))

lemma annealRho_bounds (n : ℕ) (hn : 0<n) : 1/2 ≤ annealRho n ∧ annealRho n < 1 := by
  have hn' : (1:ℝ) ≤ n := by exact_mod_cast hn
  unfold annealRho
  have hh : 0 < 2*(n:ℝ) := by positivity
  constructor
  · have := (div_le_iff₀ hh).mpr (show (1:ℝ) ≤ (1/2)*(2*n) by nlinarith)
    linarith
  · have := div_pos (show (0:ℝ)<1 by norm_num) hh
    linarith
lemma annealRho_pow_lower (n : ℕ) (hn : 0<n) : 1/2 ≤ annealRho n ^ n := by
  have hn' : 0 < (n:ℝ) := by exact_mod_cast hn
  have h := one_add_mul_le_pow (a := -(1/(2*(n:ℝ)))) (by
    have hh := (annealRho_bounds n hn).1
    unfold annealRho at hh
    linarith) n
  have he : 1+(n:ℝ)*(-(1/(2*n))) = 1/2 := by field_simp; ring
  simpa only [he,annealRho,sub_eq_add_neg] using h
lemma annealStep_bounds (n d : ℕ) (hn : 0<n) (hd : d≤n) :
    1/2 ≤ annealRho n ^ d ∧ annealRho n ^ d ≤ 1 := by
  have hr := annealRho_bounds n hn
  have h0 : 0 ≤ annealRho n := by linarith
  exact ⟨(annealRho_pow_lower n hn).trans (pow_le_pow_of_le_one h0 hr.2.le hd),
    pow_le_one₀ h0 hr.2.le⟩

section CoefficientDrift
variable {X : Type*} [Fintype X]

noncomputable def deficiencyPartition (d : X → ℕ) (q : ℝ) : ℝ := ∑ x,q^(d x)
lemma deficiencyPartition_pos [Nonempty X] (d : X → ℕ) (q : ℝ) (hq : 0<q) :
    0 < deficiencyPartition d q := Finset.sum_pos (fun _ _ => pow_pos hq _) Finset.univ_nonempty
lemma coefficient_step (d : X → ℕ) (n : ℕ) (hn : 0<n) (hd : ∀ x,d x≤n)
    (q : ℝ) (hq : 0≤q) :
    deficiencyPartition d q / 2 ≤ deficiencyPartition d (q*annealRho n) ∧
    deficiencyPartition d (q*annealRho n) ≤ deficiencyPartition d q := by
  unfold deficiencyPartition
  simp_rw [mul_pow]
  constructor
  · rw [Finset.sum_div]
    exact Finset.sum_le_sum (fun x _ => by
      have := mul_le_mul_of_nonneg_left (annealStep_bounds n (d x) hn (hd x)).1 (pow_nonneg hq (d x))
      linarith)
  · exact Finset.sum_le_sum (fun x _ => by
      simpa using mul_le_mul_of_nonneg_left (annealStep_bounds n (d x) hn (hd x)).2 (pow_nonneg hq _))
lemma normalized_drift [Nonempty X] (d : X → ℕ) (n : ℕ) (hn : 0<n) (hd : ∀ x,d x≤n)
    (q : ℝ) (hq : 0<q) (x : X) :
    q^(d x)/deficiencyPartition d q ≤
      2*((q*annealRho n)^(d x)/deficiencyPartition d (q*annealRho n)) := by
  have hr := annealRho_bounds n hn
  have hr0 : 0<annealRho n := by linarith
  have hD := deficiencyPartition_pos d q hq
  have hD' := deficiencyPartition_pos d (q*annealRho n) (mul_pos hq hr0)
  have hstep := coefficient_step d n hn hd q hq.le
  have hw := annealStep_bounds n (d x) hn (hd x)
  rw [← mul_div_assoc,div_le_div_iff₀ hD hD']
  rw [mul_pow]
  have hq0 : 0 ≤ q^(d x) := (pow_pos hq _).le
  have h1 := mul_le_mul_of_nonneg_left hstep.2 hq0
  have h2 := mul_le_mul_of_nonneg_right (show q^(d x) ≤ 2*(q^(d x)*annealRho n^(d x)) by nlinarith [mul_nonneg hq0 (sub_nonneg.mpr hw.1)]) hD.le
  exact h1.trans h2
end CoefficientDrift

lemma estimated_ratio_bounds (η p u phat uhat : ℝ) (hη0 : 0≤η) (hη1 : η<1)
    (hp : 0<p) (hu : 0<u)
    (hphat : (1-η)*p ≤ phat ∧ phat ≤ (1+η)*p)
    (huhat : (1-η)*u ≤ uhat ∧ uhat ≤ (1+η)*u) :
    0<phat ∧ (1-η)/(1+η) ≤ (uhat/phat)/(u/p) ∧
      (uhat/phat)/(u/p) ≤ (1+η)/(1-η) := by
  have hp' : 0<phat := lt_of_lt_of_le (mul_pos (by linarith) hp) hphat.1
  have hu' : 0<uhat := lt_of_lt_of_le (mul_pos (by linarith) hu) huhat.1
  refine ⟨hp',?_,?_⟩
  · rw [le_div_iff₀ (div_pos hu hp),div_mul_div_comm,div_le_div_iff₀ (mul_pos (by linarith) hp) hp']
    have h1 := mul_le_mul_of_nonneg_left hphat.2 (mul_nonneg (by linarith : 0≤1-η) hu.le)
    have h2 := mul_le_mul_of_nonneg_right huhat.1 (mul_nonneg (by linarith : 0≤1+η) hp.le)
    nlinarith
  · rw [div_le_iff₀ (div_pos hu hp),div_mul_div_comm,
      div_le_div_iff₀ hp' (mul_pos (by linarith) hp)]
    have h1 := mul_le_mul_of_nonneg_left hphat.1 (mul_nonneg (by linarith : 0≤1+η) hu.le)
    have h2 := mul_le_mul_of_nonneg_right huhat.2 (mul_nonneg (by linarith : 0≤1-η) hp.le)
    nlinarith

lemma ratio_coarse_bounds (η : ℝ) (h0 : 0≤η) (h1 : η≤1/3) :
    1/2 ≤ (1-η)/(1+η) ∧ (1+η)/(1-η) ≤ 2 := by
  constructor
  · rw [le_div_iff₀ (by linarith : 0<1+η)]; linarith
  · rw [div_le_iff₀ (by linarith : 0<1-η)]; linarith

lemma learned_multiplier_good (w p0 pt phat0 phatt ideal nextIdeal η : ℝ)
    (hw : 0<w) (hp0 : 0<p0) (hpt : 0<pt) (_ : 0 < ideal)
    (hidentity : w*(p0/pt)=ideal) (hη0 : 0≤η) (hη1 : η≤1/3)
    (hphat0 : (1-η)*p0≤phat0 ∧ phat0≤(1+η)*p0)
    (hphatt : (1-η)*pt≤phatt ∧ phatt≤(1+η)*pt)
    (hdrift : ideal/2≤nextIdeal ∧ nextIdeal≤2*ideal) :
    nextIdeal/4 ≤ w*(phat0/phatt) ∧ w*(phat0/phatt)≤4*nextIdeal := by
  have hb := estimated_ratio_bounds η pt p0 phatt phat0 hη0 (by linarith) hpt hp0 hphatt hphat0
  have hc := ratio_coarse_bounds η hη0 hη1
  have hl := (le_div_iff₀ (div_pos hp0 hpt)).mp (hc.1.trans hb.2.1)
  have hu := (div_le_iff₀ (div_pos hp0 hpt)).mp (hb.2.2.trans hc.2)
  have hl' := mul_le_mul_of_nonneg_left hl hw.le
  have hu' := mul_le_mul_of_nonneg_left hu hw.le
  have hl'' : ideal/2 ≤ w*(phat0/phatt) := by nlinarith [hidentity]
  have hu'' : w*(phat0/phatt) ≤ 2*ideal := by nlinarith [hidentity]
  constructor <;> linarith

lemma product_ratios (c : ℕ → ℝ) (hc : ∀ j,0 < c j) (L : ℕ) :
    (∏ j ∈ Finset.range L,c (j+1)/c j) = c L/c 0 := by
  induction L with
  | zero => simp [ne_of_gt (hc 0)]
  | succ L ih =>
    rw [Finset.prod_range_succ,ih]
    field_simp [ne_of_gt (hc L),ne_of_gt (hc 0)]

lemma relative_product_lower (a : ℕ → ℝ) (L : ℕ) (η : ℝ) (hη0 : 0≤η) (hη1 : η≤1/2)
    (ha : ∀ j<L,(1-η)/(1+η)≤a j) :
    1-2*(L:ℝ)*η ≤ ∏ j ∈ Finset.range L,a j := by
  have hdiv : 1-2*η ≤ (1-η)/(1+η) := by
    rw [le_div_iff₀ (by linarith : 0<1+η)]
    nlinarith [sq_nonneg η]
  have hp : (1-2*η)^L ≤ ∏ j ∈ Finset.range L,a j := by
    have he : (1-2*η)^L = ∏ _j ∈ Finset.range L,(1-2*η) := by simp
    rw [he]
    apply Finset.prod_le_prod₀
    · intro j _; linarith
    · intro j hj; exact hdiv.trans (ha j (Finset.mem_range.mp hj))
  have hb := one_add_mul_le_pow (a := -2*η) (by linarith) L
  have he : (1+(-2*η))^L=(1-2*η)^L := by congr 1; ring
  rw [he] at hb
  nlinarith

lemma product_accuracy (a : ℕ → ℝ) (ε : ℝ) (L : ℕ) (hε0 : 0<ε) (hε1 : ε<1)
    (ha : ∀ j<L,(1-annealTolerance ε L)/(1+annealTolerance ε L)≤a j ∧
      a j≤(1+annealTolerance ε L)/(1-annealTolerance ε L)) :
    1-ε/4 ≤ ∏ j ∈ Finset.range L,a j ∧ ∏ j ∈ Finset.range L,a j≤1+ε/4 := by
  let η := annealTolerance ε L
  have hL : 0 ≤ (L:ℝ) := Nat.cast_nonneg _
  have hden : 0<32*((L:ℝ)+1) := by positivity
  have hη0 : 0 < η := div_pos hε0 hden
  have hη1 : η < 1/32 := by
    apply (div_lt_iff₀ hden).mpr
    nlinarith
  have hη2 : 2*(L:ℝ)*η ≤ ε/16 := by
    dsimp only [η,annealTolerance]
    rw [← mul_div_assoc,div_le_iff₀ hden]
    nlinarith
  have hlo := relative_product_lower a L η hη0.le (by linarith) (fun j hj => (ha j hj).1)
  have hap : ∀ j<L,0<a j := by
    intro j hj
    have hh := (ha j hj).1
    exact lt_of_lt_of_le (div_pos (by linarith) (by linarith)) hh
  have hainv : ∀ j<L,(1-η)/(1+η) ≤ (a j)⁻¹ := by
    intro j hj
    rw [inv_eq_one_div,le_div_iff₀ (hap j hj)]
    have hu := (le_div_iff₀ (show 0<1-η by linarith)).mp (ha j hj).2
    rw [div_mul_eq_mul_div,div_le_iff₀ (by linarith : 0<1+η)]
    nlinarith
  have hinv := relative_product_lower (fun j => (a j)⁻¹) L η hη0.le (by linarith) hainv
  rw [Finset.prod_inv_distrib] at hinv
  have hp : 0 < ∏ j ∈ Finset.range L,a j := Finset.prod_pos (fun j hj => hap j (Finset.mem_range.mp hj))
  have hlow : 1-ε/16 ≤ (∏ j ∈ Finset.range L,a j)⁻¹ := by linarith
  have hmul := (le_div_iff₀ hp).mp (show 1-ε/16 ≤ 1/(∏ j ∈ Finset.range L,a j) by simpa only [one_div] using hlow)
  constructor
  · linarith
  · nlinarith [mul_nonneg (show 0≤ε by linarith) (show 0≤1-ε by linarith)]

lemma final_estimate_accuracy (ε Z C Zhat : ℝ) (hε0 : 0<ε) (hε1 : ε<1) (hZ : 0≤Z)
    (hC : Z≤C ∧ C≤(1+ε/10)*Z)
    (hhat : (1-ε/4)*C≤Zhat ∧ Zhat≤(1+ε/4)*C) :
    (1-ε)*Z≤Zhat ∧ Zhat≤(1+ε)*Z := by
  have hl := mul_le_mul_of_nonneg_left hC.1 (show 0≤1-ε/4 by linarith)
  have hu := mul_le_mul_of_nonneg_left hC.2 (show 0≤1+ε/4 by linarith)
  have he : (1+ε/4)*(1+ε/10)≤1+ε := by nlinarith [sq_nonneg ε]
  have he' := mul_le_mul_of_nonneg_right he hZ
  constructor <;> nlinarith [mul_nonneg hε0.le hZ]

section Contamination
variable {X : Type*} [Fintype X]
noncomputable def zeroDeficiencyCount (d : X → ℕ) : ℕ := (Finset.univ.filter (fun x => d x=0)).card
lemma partition_contamination (d : X → ℕ) (q : ℝ) (hq0 : 0≤q) (hq1 : q≤1) :
    (zeroDeficiencyCount d:ℝ) ≤ deficiencyPartition d q ∧
      deficiencyPartition d q ≤ (zeroDeficiencyCount d:ℝ)+(Fintype.card X:ℝ)*q := by
  have hcount : (zeroDeficiencyCount d:ℝ) = ∑ x,if d x=0 then (1:ℝ) else 0 := by
    simp [zeroDeficiencyCount,Finset.sum_boole]
  rw [hcount]
  constructor
  · apply Finset.sum_le_sum
    intro x _
    by_cases h : d x=0
    · simp [h]
    · simp [h,pow_nonneg hq0]
  · have hs : ∀ x,q^(d x) ≤ (if d x=0 then 1 else 0)+q := by
      intro x
      by_cases h : d x=0
      · simp [h,hq0]
      · simp only [h,ite_false,zero_add]
        have hd : 1≤d x := Nat.one_le_iff_ne_zero.mpr h
        simpa using pow_le_pow_of_le_one hq0 hq1 hd
    have hh := Finset.sum_le_sum (s := Finset.univ) (fun x _ => hs x)
    simpa [deficiencyPartition,Finset.sum_add_distrib] using hh
end Contamination

namespace FiniteExperiment
open scoped BigOperators Classical
variable {X : Type*} [sectionInstance89 : Fintype X]

noncomputable def expect (K : List X → X → ℝ) : ℕ → List X → (List X → ℝ) → ℝ
  | 0,h,φ => φ h
  | t+1,h,φ => ∑ x,K h x*expect K t (h++[x]) φ
noncomputable def mass (K : List X → X → ℝ) (t : ℕ) (h : List X) : ℝ :=
  expect K t h (fun _ => 1)
lemma expect_nonneg (K : List X → X → ℝ) (hK : ∀ h x,0 ≤ K h x)
    (φ : List X → ℝ) (hφ : ∀ h,0 ≤ φ h) (t : ℕ) (h : List X) :
    0 ≤ expect K t h φ := by
  induction t generalizing h with
  | zero => exact hφ h
  | succ t ih => exact Finset.sum_nonneg (fun x _ => mul_nonneg (hK h x) (ih _))
lemma expect_mono (K : List X → X → ℝ) (hK : ∀ h x,0 ≤ K h x)
    (φ ψ : List X → ℝ) (hh : ∀ h,φ h ≤ ψ h) (t : ℕ) (h : List X) :
    expect K t h φ ≤ expect K t h ψ := by
  induction t generalizing h with
  | zero => exact hh h
  | succ t ih => exact Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (ih _) (hK h x))
lemma expect_kernel_mono (K P : List X → X → ℝ) (hK : ∀ h x,0 ≤ K h x)
    (hKP : ∀ h x,K h x ≤ P h x) (φ : List X → ℝ) (hφ : ∀ h,0 ≤ φ h)
    (t : ℕ) (h : List X) : expect K t h φ ≤ expect P t h φ := by
  have hP : ∀ h x,0 ≤ P h x := fun h x => (hK h x).trans (hKP h x)
  induction t generalizing h with
  | zero => rfl
  | succ t ih =>
    exact Finset.sum_le_sum (fun x _ => mul_le_mul (hKP h x) (ih _)
      (expect_nonneg K hK φ hφ t _) (hP h x))
lemma mass_nonneg (K : List X → X → ℝ) (hK : ∀ h x,0 ≤ K h x) (t : ℕ) (h : List X) :
    0 ≤ mass K t h := expect_nonneg K hK _ (by intros; norm_num) t h
lemma mass_le_one (K : List X → X → ℝ) (hK : ∀ h x,0 ≤ K h x)
    (hrow : ∀ h,∑ x,K h x ≤ 1) (t : ℕ) (h : List X) : mass K t h ≤ 1 := by
  induction t generalizing h with
  | zero => rfl
  | succ t ih =>
    change (∑ x,K h x*mass K t (h++[x])) ≤ 1
    calc
      _ ≤ ∑ x,K h x*1 := Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (ih _) (hK h x))
      _ ≤ 1 := by simpa using hrow h

theorem adaptive_success (K : List X → X → ℝ) (Good : List X → Prop)
    (hK : ∀ h x,0 ≤ K h x) (hrow : ∀ h,∑ x,K h x ≤ 1)
    (hsupport : ∀ h,Good h → ∀ x,0<K h x → Good (h++[x]))
    (e : ℝ) (he : 0 ≤ e) (hloss : ∀ h,Good h → 1-e ≤ ∑ x,K h x)
    (t : ℕ) (h : List X) (hh : Good h) : 1-(t:ℝ)*e ≤ mass K t h := by
  induction t generalizing h with
  | zero => simp [mass,expect]
  | succ t ih =>
    have hlocal : ∀ x,K h x*(1-(t:ℝ)*e) ≤ K h x*mass K t (h++[x]) := by
      intro x
      by_cases hz : K h x=0
      · simp [hz]
      · exact mul_le_mul_of_nonneg_left (ih _ (hsupport h hh x (lt_of_le_of_ne (hK h x) (Ne.symm hz)))) (hK h x)
    change 1-((t+1:ℕ):ℝ)*e ≤ ∑ x,K h x*mass K t (h++[x])
    have hs := Finset.sum_le_sum (fun x (_ : x∈Finset.univ) => hlocal x)
    rw [← Finset.sum_mul] at hs
    have hm := hloss h hh
    have hu := hrow h
    have ht : 0 ≤ (t:ℝ)*e := mul_nonneg (Nat.cast_nonneg _) he
    push_cast
    nlinarith [mul_nonneg ht (sub_nonneg.mpr hu)]

noncomputable def restrict (P : List X → X → ℝ) (Good : List X → Prop) (h : List X) (x : X) : ℝ :=
  if Good (h++[x]) then P h x else 0
omit sectionInstance89 in
lemma restrict_nonneg [Fintype X] (P : List X → X → ℝ) (Good : List X → Prop) (hP : ∀ h x,0 ≤ P h x)
    (h : List X) (x : X) : 0 ≤ restrict P Good h x := by
  unfold restrict; split_ifs; exact hP _ _; rfl
omit sectionInstance89 in
lemma restrict_le [Fintype X] (P : List X → X → ℝ) (Good : List X → Prop) (hP : ∀ h x,0 ≤ P h x)
    (h : List X) (x : X) : restrict P Good h x ≤ P h x := by
  unfold restrict; split_ifs; rfl; exact hP _ _
omit sectionInstance89 in
lemma restrict_support [Fintype X] (P : List X → X → ℝ) (Good : List X → Prop)
    (h : List X) (x : X) (hx : 0<restrict P Good h x) : Good (h++[x]) := by
  by_contra hg
  simp [restrict,hg] at hx
lemma mass_le_good_probability (P : List X → X → ℝ) (Good : List X → Prop)
    (hP : ∀ h x,0 ≤ P h x) (t : ℕ) (h : List X) (hh : Good h) :
    mass (restrict P Good) t h ≤ expect P t h (fun l => if Good l then 1 else 0) := by
  induction t generalizing h with
  | zero => simp [mass,expect,hh]
  | succ t ih =>
    change (∑ x,restrict P Good h x*mass (restrict P Good) t (h++[x])) ≤ _
    apply Finset.sum_le_sum
    intro x _
    by_cases hg : Good (h++[x])
    · simpa only [restrict,ite_eq_left hg] using mul_le_mul_of_nonneg_left (ih _ hg) (hP h x)
    · have hr : restrict P Good h x=0 := by simp [restrict,hg]
      rw [hr,zero_mul]
      exact mul_nonneg (hP h x) (expect_nonneg P hP _ (by intro l; split_ifs <;> norm_num) t _)

theorem good_probability (P : List X → X → ℝ) (Good : List X → Prop)
    (hP : ∀ h x,0 ≤ P h x) (hrow : ∀ h,∑ x,P h x ≤ 1)
    (e : ℝ) (he : 0 ≤ e)
    (hstep : ∀ h,Good h → 1-e ≤ ∑ x,restrict P Good h x)
    (t : ℕ) (h : List X) (hh : Good h) :
    1-(t:ℝ)*e ≤ expect P t h (fun l => if Good l then 1 else 0) := by
  have hb := adaptive_success (restrict P Good) Good (restrict_nonneg P Good hP)
    (fun h => (Finset.sum_le_sum (fun x _ => restrict_le P Good hP h x)).trans (hrow h))
    (fun h _ x hx => restrict_support P Good h x hx) e he hstep t h hh
  exact hb.trans (mass_le_good_probability P Good hP t h hh)
end FiniteExperiment
section PairedSlots
open scoped BigOperators Classical
variable {α : Type*} [sectionInstance90 : Fintype α] [sectionInstance91 : DecidableEq α]
def slotPair (i : α) : (α ⊕ α) × (α ⊕ α) := (Sum.inl i,Sum.inr i)
def pairedSlots (n : ℕ) : List ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) :=
  (List.finRange n).map slotPair
omit sectionInstance90 sectionInstance91 in
lemma slotPairList_fresh [Fintype α] [DecidableEq α] (l : List α) (hl : l.Nodup) (B : Set (α ⊕ α))
    (hB : ∀ i ∈ l,Sum.inl i ∉ B ∧ Sum.inr i ∉ B) : SlotsFresh (l.map slotPair) B := by
  induction l generalizing B with
  | nil => trivial
  | cons a l ih =>
    obtain ⟨ha,hl⟩ := List.nodup_cons.mp hl
    refine ⟨by simp [slotPair],(hB a (by simp)).1,(hB a (by simp)).2,?_⟩
    apply ih hl
    intro i hi
    have hn : i ≠ a := fun he => ha (he ▸ hi)
    have hb := hB i (by simp [hi])
    simpa [slotPair,hn] using hb
lemma pairedSlots_fresh (n : ℕ) : SlotsFresh (pairedSlots n) ∅ :=
  slotPairList_fresh _ (List.nodup_finRange n) ∅ (by intros; simp)
@[simp] lemma pairedSlots_length (n : ℕ) : (pairedSlots n).length = n := by simp [pairedSlots]
lemma pairedSlots_ne_nil (n : ℕ) (hn : 0<n) : pairedSlots n ≠ [] := by
  intro h; have hh := congrArg List.length h
  simp only [pairedSlots_length,List.length_nil] at hh
  omega
lemma pairedSlots_cover (n : ℕ) : pairSupport (pairedSlots n) = Set.univ := by
  ext x
  simp only [pairSupport,Set.mem_ofPred_eq,Set.mem_univ,iff_true]
  cases x with
  | inl i => exact ⟨slotPair i,by simp [pairedSlots],Or.inl rfl⟩
  | inr i => exact ⟨slotPair i,by simp [pairedSlots],Or.inr rfl⟩
lemma pairedSlots_plain (n : ℕ) (S : Set (Fin n ⊕ Fin n)) :
    PlainState (pairedSlots n) S ↔ ∀ i, (Sum.inl i ∈ S ↔ Sum.inr i ∉ S) := by
  simp only [PlainState,pairedSlots,List.mem_map,forall_exists_index,and_imp]
  constructor
  · intro h i
    have hh := h (slotPair i) i (by simp) rfl
    simp only [PairSingle,slotPair] at hh
    tauto
  · intro h p i hi he
    subst p
    have hh := h i
    simp only [PairSingle,slotPair]
    tauto
lemma transversal_plain (n : ℕ) (A : Set (Fin n)) : PlainState (pairedSlots n) (transversal A) := by
  rw [pairedSlots_plain]
  intro i
  have hl : Sum.inl i ∈ transversal A ↔ i ∈ A := by
    change i ∈ Sum.inl ⁻¹' transversal A ↔ _
    rw [preimage_inl_transversal]
  have hr : Sum.inr i ∈ transversal A ↔ i ∉ A := by
    change i ∈ Sum.inr ⁻¹' transversal A ↔ _
    rw [preimage_inr_transversal]; rfl
  rw [hl,hr,not_not]
lemma plain_eq_transversal (n : ℕ) (S : Set (Fin n ⊕ Fin n)) (hS : PlainState (pairedSlots n) S) :
    S = transversal (Sum.inl ⁻¹' S) := by
  rw [pairedSlots_plain] at hS
  ext x
  cases x with
  | inl i =>
    change i ∈ Sum.inl ⁻¹' S ↔ i ∈ Sum.inl ⁻¹' transversal (Sum.inl ⁻¹' S)
    rw [preimage_inl_transversal]
  | inr i =>
    change Sum.inr i ∈ S ↔ i ∈ Sum.inr ⁻¹' transversal (Sum.inl ⁻¹' S)
    rw [preimage_inr_transversal]
    change Sum.inr i ∈ S ↔ Sum.inl i ∉ S
    have hh := hS i
    tauto
noncomputable def plainEquivSubsets (n : ℕ) :
    {S : Set (Fin n ⊕ Fin n) // PlainState (pairedSlots n) S} ≃ Set (Fin n) where
  toFun S := Sum.inl ⁻¹' S.val
  invFun A := ⟨transversal A,transversal_plain n A⟩
  left_inv S := Subtype.ext (plain_eq_transversal n S.val S.property).symm
  right_inv A := preimage_inl_transversal A
lemma pairedPlain_card (n : ℕ) : Fintype.card {S : Set (Fin n ⊕ Fin n) // PlainState (pairedSlots n) S} = 2^n := by
  rw [Fintype.card_congr (plainEquivSubsets n),Fintype.card_set,Fintype.card_fin]
end PairedSlots
open scoped BigOperators Classical
noncomputable def subsetDeficiency {n : ℕ} (M₁ M₂ : Matroid (Fin n)) (A : Set (Fin n)) : ℕ :=
  n-((pairedMatroid M₁ M₂).eRk (transversal A)).toNat
lemma subsetDeficiency_zero {n : ℕ} (M₁ M₂ : Matroid (Fin n))
    (hE₂ : M₂.E=Set.univ) (hr : M₁.eRank=M₂.eRank) (A : Set (Fin n)) :
    subsetDeficiency M₁ M₂ A=0 ↔ M₁.IsBase A ∧ M₂.IsBase A := by
  have hR : (pairedMatroid M₁ M₂).eRank=(n:ℕ∞) := by simpa using paired_eRank M₁ M₂ hE₂ hr
  have hk : ((pairedMatroid M₁ M₂).eRk (transversal A)).toNat≤n :=
    ENat.toNat_le_of_le_natCast (by rw [← hR]; exact Matroid.eRk_le_eRank _ _)
  rw [← transversal_isBase_iff M₁ M₂ hE₂ A]
  constructor
  · intro hd
    have hn : ((pairedMatroid M₁ M₂).eRk (transversal A)).toNat=n := by unfold subsetDeficiency at hd; omega
    have he : (pairedMatroid M₁ M₂).eRk (transversal A)=(n:ℕ∞) := by
      calc
        _ = (((pairedMatroid M₁ M₂).eRk (transversal A)).toNat:ℕ∞) :=
          (ENat.natCast_toNat (Matroid.isRkFinite_set _ _).eRk_lt_top.ne).symm
        _ = _ := congrArg (fun k : ℕ => (k:ℕ∞)) hn
    have hi : (pairedMatroid M₁ M₂).Indep (transversal A) := by
      apply (Matroid.indep_iff_eRk_eq_encard_of_finite (Set.toFinite _)).mpr
      rw [he,transversal_encard,Fintype.card_fin]
    exact hi.isBase_of_eRk_ge (Set.toFinite _) (by rw [he,hR])
  · intro h
    unfold subsetDeficiency
    rw [h.eRk_eq_eRank,hR,ENat.toNat_natCast,Nat.sub_self]

noncomputable def commonSetFinsetEquiv {n : ℕ} (M₁ M₂ : Matroid (Fin n)) :
    {A : Set (Fin n) // M₁.IsBase A ∧ M₂.IsBase A} ≃
    {A : Finset (Fin n) // M₁.IsBase (A:Set (Fin n)) ∧ M₂.IsBase (A:Set (Fin n))} where
  toFun A := ⟨A.val.toFinset,by simpa only [Set.coe_toFinset] using A.property⟩
  invFun A := ⟨(A.val:Set (Fin n)),A.property⟩
  left_inv A := by apply Subtype.ext; exact Set.coe_toFinset _
  right_inv A := by apply Subtype.ext; simp
lemma zeroDeficiency_eq_commonBaseCount {n : ℕ} (M₁ M₂ : Matroid (Fin n))
    (hE₂ : M₂.E=Set.univ) (hr : M₁.eRank=M₂.eRank) :
    zeroDeficiencyCount (subsetDeficiency M₁ M₂)=commonBaseCount M₁ M₂ := by
  have hp : (fun A => subsetDeficiency M₁ M₂ A=0) = (fun A => M₁.IsBase A ∧ M₂.IsBase A) :=
    funext (fun A => propext (subsetDeficiency_zero M₁ M₂ hE₂ hr A))
  unfold zeroDeficiencyCount commonBaseCount
  rw [← Fintype.card_subtype,← Nat.card_eq_fintype_card]
  calc
    _ = Nat.card {A : Set (Fin n) // M₁.IsBase A ∧ M₂.IsBase A} :=
      Nat.card_congr (Equiv.subtypeEquivRight (fun A => subsetDeficiency_zero M₁ M₂ hE₂ hr A))
    _ = _ := Nat.card_congr (commonSetFinsetEquiv M₁ M₂)

lemma plainPartition_eq_subsets {n : ℕ} (M₁ M₂ : Matroid (Fin n)) (q : ℝ) :
    slotTotal (pairedSlots n) (matroidWeight (pairedMatroid M₁ M₂) n q) ∅ =
      deficiencyPartition (subsetDeficiency M₁ M₂) q := by
  rw [slotTotal_eq_plain_sum (pairedSlots n) (pairedSlots_fresh n) (pairedSlots_cover n)]
  rw [Finset.sum_subtype (p := PlainState (pairedSlots n)) _ (by intro S; simp)]
  unfold deficiencyPartition
  apply Fintype.sum_equiv (plainEquivSubsets n)
  intro S
  change q^(n-((pairedMatroid M₁ M₂).eRk S.val).toNat)=
    q^(n-((pairedMatroid M₁ M₂).eRk (transversal (Sum.inl ⁻¹' S.val))).toNat)
  rw [← plain_eq_transversal n S.val S.property]

theorem paired_partition_contamination {n : ℕ} (M₁ M₂ : Matroid (Fin n))
    (hE₂ : M₂.E=Set.univ) (hr : M₁.eRank=M₂.eRank) (q : ℝ) (hq0 : 0≤q) (hq1 : q≤1) :
    (commonBaseCount M₁ M₂:ℝ) ≤ slotTotal (pairedSlots n) (matroidWeight (pairedMatroid M₁ M₂) n q) ∅ ∧
      slotTotal (pairedSlots n) (matroidWeight (pairedMatroid M₁ M₂) n q) ∅ ≤
        (commonBaseCount M₁ M₂:ℝ)+(2:ℝ)^n*q := by
  have h := partition_contamination (subsetDeficiency M₁ M₂) q hq0 hq1
  rw [zeroDeficiency_eq_commonBaseCount M₁ M₂ hE₂ hr,Fintype.card_set,Fintype.card_fin] at h
  rw [plainPartition_eq_subsets]
  exact_mod_cast h
open scoped BigOperators Classical
lemma annealRho_pow_upper (n : ℕ) (hn : 0<n) : annealRho n^(2*n)≤1/2 := by
  have hn' : (0:ℝ)<n := by exact_mod_cast hn
  have hr0 : 0≤annealRho n := le_trans (by norm_num) (annealRho_bounds n hn).1
  have he : annealRho n≤Real.exp (-1/(2*(n:ℝ))) := by
    have h := Real.add_one_le_exp (-1/(2*(n:ℝ)))
    unfold annealRho
    convert h using 1 ; ring
  calc
    _ ≤ (Real.exp (-1/(2*(n:ℝ))))^(2*n) := pow_le_pow_left₀ hr0 he _
    _ = Real.exp (-1) := by
      rw [← Real.exp_nat_mul]
      congr 1
      push_cast
      field_simp
    _ ≤ 1/2 := by
      rw [Real.exp_neg]
      have h2 : (2:ℝ)≤Real.exp 1 := by nlinarith [Real.add_one_le_exp (1:ℝ)]
      simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<2) h2
lemma anneal_final_bounds (n b : ℕ) (hn : 0<n) :
    (1/2:ℝ)^annealLength n b≤annealRho n^annealLength n b ∧
      annealRho n^annealLength n b≤(1/2:ℝ)^(n+b) := by
  constructor
  · exact pow_le_pow_left₀ (by norm_num) (annealRho_bounds n hn).1 _
  · unfold annealLength
    rw [pow_mul]
    exact pow_le_pow_left₀ (pow_nonneg (le_trans (by norm_num) (annealRho_bounds n hn).1) _)
      (annealRho_pow_upper n hn) _
lemma anneal_final_contamination (n b : ℕ) (hn : 0<n) (ε : ℝ) (hb : (1/2:ℝ)^b≤ε/10) :
    (2:ℝ)^n*(annealRho n^annealLength n b)≤ε/10 := by
  calc
    _ ≤ (2:ℝ)^n*((1/2:ℝ)^(n+b)) := mul_le_mul_of_nonneg_left (anneal_final_bounds n b hn).2 (by positivity)
    _ = (1/2:ℝ)^b := by rw [pow_add,← mul_assoc,← mul_pow]; norm_num
    _ ≤ _ := hb
lemma partition_le_card {X : Type*} [Fintype X] (d : X → ℕ) (q : ℝ) (hq0 : 0≤q) (hq1 : q≤1) :
    deficiencyPartition d q≤Fintype.card X := by
  calc
    _ ≤ ∑ _ : X,(1:ℝ) := Finset.sum_le_sum (fun x _ => pow_le_one₀ hq0 hq1)
    _ = _ := by simp

lemma anneal_minimum_mass {X : Type*} [Fintype X] [Nonempty X]
    (n L j : ℕ) (hn : 0<n) (hj : j≤L) (hcard : Fintype.card X=2^n)
    (d : X → ℕ) (hd : ∀ x,d x≤n) (x : X) :
    (1/2:ℝ)^(n*(L+1))≤(annealRho n^j)^(d x)/deficiencyPartition d (annealRho n^j) := by
  have hr := annealRho_bounds n hn
  have hr0 : 0<annealRho n := lt_of_lt_of_le (by norm_num) hr.1
  have hq0 : 0<annealRho n^j := pow_pos hr0 _
  have hq1 : annealRho n^j≤1 := pow_le_one₀ hr0.le hr.2.le
  have hf : (1/2:ℝ)^(n*L)≤(annealRho n^j)^(d x) := by
    calc
      _ = ((1/2:ℝ)^L)^n := by simp only [← pow_mul,Nat.mul_comm]
      _ ≤ (annealRho n^L)^n := pow_le_pow_left₀ (by positivity)
        (pow_le_pow_left₀ (by norm_num) hr.1 L) _
      _ ≤ (annealRho n^j)^n := pow_le_pow_left₀ (by positivity)
        (pow_le_pow_of_le_one hr0.le hr.2.le hj) _
      _ ≤ _ := pow_le_pow_of_le_one hq0.le hq1 (hd x)
  have hZ := deficiencyPartition_pos d _ hq0
  calc
    _ = ((1/2:ℝ)^(n*L))/(2:ℝ)^n := by
      rw [Nat.mul_add,Nat.mul_one,pow_add]
      simp [inv_pow,div_eq_mul_inv]
    _ ≤ ((annealRho n^j)^(d x))/(2:ℝ)^n := div_le_div_of_nonneg_right hf (by positivity)
    _ ≤ _ := div_le_div_of_nonneg_left (by positivity) hZ (by
      have h := partition_le_card d (annealRho n^j) hq0.le hq1
      rw [hcard] at h
      exact_mod_cast h)
namespace FiniteChain
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X)
lemma kernel_power_action (k : ℕ) (f : X → ℝ) (x : X) :
    ∑ y,(C.kernel.power k).P x y*f y=C.iterate k f x := by
  induction k generalizing f with
  | zero => simp [FiniteKernel.power,FiniteKernel.identity]
  | succ k ih =>
    change (∑ y,(∑ z,(C.kernel.power k).P x z*C.P z y)*f y)=_
    simp_rw [Finset.sum_mul,mul_assoc]
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum]
    change (∑ z,(C.kernel.power k).P x z*C.apply f z)=_
    rw [ih]
    exact congrFun (Function.iterate_succ_apply C.apply k f).symm x
lemma kernel_power_density (k : ℕ) (x y : X) :
    (C.kernel.power k).P x y/C.π y=C.iterate k (C.pointDensity y) x := by
  rw [← C.kernel_power_action]
  simp [pointDensity,div_eq_mul_inv]
lemma kernel_point_mixing (K m : ℝ) (hK : 1≤K) (hm : 0 < m) (hπ : ∀ x,m≤C.π x)
    (hp : ∀ f : X → ℝ,C.variance f≤K*C.energy f) (k : ℕ) (x y : X) :
    |(C.kernel.power k).P x y/C.π y-1|≤Real.exp (-(k:ℝ)/K)/m := by
  rw [C.kernel_power_density]
  exact C.point_mixing_exp K m hK hm hπ hp k x y

lemma kernel_power_warm_any (K m e : ℝ) (hK : 1≤K) (hm : 0 < m)
    (hπ : ∀ x,m≤C.π x) (hp : ∀ f : X → ℝ,C.variance f≤K*C.energy f)
    (k : ℕ) (he : Real.exp (-(k:ℝ)/K)/m≤e) (he' : 0≤1+e)
    (ν : X → ℝ) (hν : ∀ x,0≤ν x) (hnorm : ∑ x,ν x≤1) (y : X) :
    (C.kernel.power k).push ν y≤(1+e)*C.π y := by
  have hrow : ∀ x,(C.kernel.power k).P x y≤(1+e)*C.π y := by
    intro x
    have h := (le_abs_self _).trans ((C.kernel_point_mixing K m hK hm hπ hp k x y).trans he)
    apply (div_le_iff₀ (C.positive y)).mp
    linarith
  calc
    _ ≤ ∑ x,ν x*((1+e)*C.π y) := Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (hrow x) (hν x))
    _ = (∑ x,ν x)*((1+e)*C.π y) := by rw [Finset.sum_mul]
    _ ≤ _ := by simpa using mul_le_mul_of_nonneg_right hnorm (mul_nonneg he' (C.positive y).le)
end FiniteChain

namespace Annealing

lemma restart_exponential (n L : ℕ) (hn : 0<n) :
    Real.exp (-((20*n^4*(n*(L+1)+2):ℕ):ℝ)/(18*(n:ℝ)^4)) /
      ((2:ℝ)^(-((n*(L+1):ℕ):ℤ))) ≤ 1/2 := by
  have hn' : (0:ℝ)<n := by exact_mod_cast hn
  have h2 : (2:ℝ)≤Real.exp 1 := by nlinarith [Real.add_one_le_exp (1:ℝ)]
  have hpow : (2:ℝ)^(n*(L+1))≤Real.exp ((n*(L+1):ℕ):ℝ) := by
    calc
      _ ≤ (Real.exp 1)^(n*(L+1)) := pow_le_pow_left₀ (by norm_num) h2 _
      _ = _ := by rw [← Real.exp_nat_mul]; simp
  rw [zpow_neg,zpow_natCast,div_inv_eq_mul]
  calc
    _ ≤ Real.exp (-((20*n^4*(n*(L+1)+2):ℕ):ℝ)/(18*(n:ℝ)^4))*
        Real.exp ((n*(L+1):ℕ):ℝ) := mul_le_mul_of_nonneg_left hpow (Real.exp_nonneg _)
    _ = Real.exp (-((20*n^4*(n*(L+1)+2):ℕ):ℝ)/(18*(n:ℝ)^4)+((n*(L+1):ℕ):ℝ)) := (Real.exp_add _ _).symm
    _ ≤ Real.exp (-1) := by
      apply Real.exp_le_exp.mpr
      have heq : -((20*n^4*(n*(L+1)+2):ℕ):ℝ)/(18*(n:ℝ)^4) =
          -(10/9)*((n:ℝ)*(L+1)+2) := by
        push_cast
        field_simp
        ; ring
      rw [heq]
      push_cast
      nlinarith [show 0≤(n:ℝ)*(L+1) by positivity]
    _ ≤ 1/2 := by rw [Real.exp_neg]; simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<2) h2
end Annealing
section ActualAnnealing
open scoped BigOperators Classical
variable {Γ : Type*} [sectionInstance93 : Fintype Γ] [sectionInstance94 : DecidableEq Γ]
lemma slotTotal_mono (ps : List (Γ × Γ)) (f g : Set Γ → ℝ)
    (h : ∀ S,f S ≤ g S) (A : Set Γ) : slotTotal ps f A ≤ slotTotal ps g A := by
  induction ps generalizing A with
  | nil => exact h A
  | cons p ps ih =>
    change coeffDeriv (pairDirection p) (slotTotal ps f) A ≤ coeffDeriv (pairDirection p) (slotTotal ps g) A
    unfold coeffDeriv
    apply Finset.sum_le_sum
    intro i _
    split_ifs
    · rfl
    · exact mul_le_mul_of_nonneg_left (ih _) (slotDirection_nonneg _ _)
lemma slotTotal_scale (ps : List (Γ × Γ)) (f : Set Γ → ℝ) (c : ℝ) (A : Set Γ) :
    slotTotal ps (fun S => c*f S) A=c*slotTotal ps f A := coeffDerivs_scale _ _ _ _
noncomputable def annealWeight (M : Matroid Γ) (n j : ℕ) : Set Γ → ℝ :=
  matroidWeight M n (annealRho n^j)
lemma annealWeight_pos (M : Matroid Γ) (n j : ℕ) (hn : 0<n) (S : Set Γ) :
    0<annealWeight M n j S :=
  matroidWeight_pos M n _ (pow_pos (lt_of_lt_of_le (by norm_num) (annealRho_bounds n hn).1) _) S
omit sectionInstance93 sectionInstance94 in
lemma annealWeight_step [Fintype Γ] [DecidableEq Γ] (M : Matroid Γ) (n j : ℕ) (_ : 0<n) (S : Set Γ) :
    annealWeight M n (j+1) S=annealWeight M n j S*annealRho n^(n-(M.eRk S).toNat) := by
  unfold annealWeight matroidWeight
  rw [pow_succ,mul_pow]
lemma annealWeight_drift (M : Matroid Γ) (n j : ℕ) (hn : 0<n) (S : Set Γ) :
    (1/2)*annealWeight M n j S ≤ annealWeight M n (j+1) S ∧
      annealWeight M n (j+1) S ≤ annealWeight M n j S := by
  rw [annealWeight_step M n j hn]
  have h := annealStep_bounds n (n-(M.eRk S).toNat) hn (Nat.sub_le _ _)
  have hp := (annealWeight_pos M n j hn S).le
  constructor
  · nlinarith [mul_nonneg hp (sub_nonneg.mpr h.1)]
  · nlinarith [mul_nonneg hp (sub_nonneg.mpr h.2)]
lemma anneal_slot_drift (ps : List (Γ × Γ)) (M : Matroid Γ) (n j : ℕ) (hn : 0<n) (A : Set Γ) :
    (1/2)*slotTotal ps (annealWeight M n j) A ≤ slotTotal ps (annealWeight M n (j+1)) A ∧
      slotTotal ps (annealWeight M n (j+1)) A ≤ slotTotal ps (annealWeight M n j) A := by
  constructor
  · rw [← slotTotal_scale]
    exact slotTotal_mono _ _ _ (fun S => (annealWeight_drift M n j hn S).1) _
  · exact slotTotal_mono _ _ _ (fun S => (annealWeight_drift M n j hn S).2) _
lemma anneal_ideal_drift (ps : List (Γ × Γ)) (hps : SlotsFresh ps ∅)
    (M : Matroid Γ) (n j : ℕ) (hn : 0<n) (p r : Γ × Γ)
    (hp : p∈ps) (hr : r∈ps) (hpr : p≠r) :
    (slotTotal ps (annealWeight M n j) ∅/slotDefect ps (annealWeight M n j) ∅ p r)/2  ≤
      slotTotal ps (annealWeight M n (j+1)) ∅/slotDefect ps (annealWeight M n (j+1)) ∅ p r ∧
    slotTotal ps (annealWeight M n (j+1)) ∅/slotDefect ps (annealWeight M n (j+1)) ∅ p r  ≤
      2*(slotTotal ps (annealWeight M n j) ∅/slotDefect ps (annealWeight M n j) ∅ p r) := by
  have h0 := slotTotal_pos ps _ (annealWeight_pos M n j hn) ∅ hps
  have h1 := slotTotal_pos ps _ (annealWeight_pos M n (j+1) hn) ∅ hps
  have hd0 := slotDefect_pos ps _ (annealWeight_pos M n j hn) ∅ hps p r hp hr hpr
  have hd1 := slotDefect_pos ps _ (annealWeight_pos M n (j+1) hn) ∅ hps p r hp hr hpr
  have ha := anneal_slot_drift ps M n j hn ∅
  have hb := anneal_slot_drift ((ps.erase p).erase r) M n j hn (insert r.1 (insert r.2 ∅))
  change (1/2)*slotDefect ps (annealWeight M n j) ∅ p r ≤ slotDefect ps (annealWeight M n (j+1)) ∅ p r ∧ slotDefect ps (annealWeight M n (j+1)) ∅ p r ≤ slotDefect ps (annealWeight M n j) ∅ p r at hb
  constructor
  · rw [div_div,div_le_div_iff₀ (mul_pos hd0 (by norm_num)) hd1]
    nlinarith [mul_nonneg h0.le (sub_nonneg.mpr hb.2),mul_nonneg hd0.le (sub_nonneg.mpr ha.1)]
  · rw [← mul_div_assoc,div_le_div_iff₀ hd1 hd0]
    nlinarith [mul_nonneg hd0.le (sub_nonneg.mpr ha.2),mul_nonneg h0.le (sub_nonneg.mpr hb.1)]

structure GoodMultipliers (gs : List (Γ × Γ)) (f : Set Γ → ℝ)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) : Prop where
  positive : ∀ p r,0<w p r
  lower : ∀ p∈gs,∀ r∈gs,p≠r → slotTotal gs f ∅/(4*slotDefect gs f ∅ p r) ≤ w p r
  upper : ∀ p∈gs,∀ r∈gs,p≠r → w p r ≤ 4*slotTotal gs f ∅/slotDefect gs f ∅ p r

lemma anneal_ratio_mean (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (M : Matroid Γ) (n j : ℕ) (hn : 0<n)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) :
    chainMean gs w (annealWeight M n j)
      (plainObservable gs (fun S => annealRho n^(n-(M.eRk S).toNat))) =
      slotTotal gs (annealWeight M n (j+1)) ∅/chainTotal gs w (annealWeight M n j) := by
  rw [plainObservable_mean gs hgs hcover]
  congr 2
  funext S
  exact (annealWeight_step M n j hn S).symm
lemma plain_probability_mean (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (f : Set Γ → ℝ)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) :
    chainMean gs w f (plainObservable gs (fun _ => 1))=slotTotal gs f ∅/chainTotal gs w f := by
  rw [plainObservable_mean gs hgs hcover]
  simp
lemma weight_mean_identity (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (f : Set Γ → ℝ) (hf : ∀ S,0<f S)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) (hw : ∀ p r,0<w p r)
    (p r : Γ × Γ) (hp : p∈gs) (hr : r∈gs) (hpr : p≠r) :
    w p r*(chainMean gs w f (plainObservable gs (fun _ => 1))/
      chainMean gs w f (defectIndicator gs p r))=slotTotal gs f ∅/slotDefect gs f ∅ p r := by
  rw [plain_probability_mean gs hgs hcover,defectIndicator_mean gs hgs hcover _ _ p r hp hr hpr]
  field_simp [(chainTotal_pos gs hgs hcover w f hf hw).ne',(hw p r).ne']

lemma plainIndex_card (n : ℕ) : Fintype.card (PlainIndex (pairedSlots n))=2^n := by
  let e : PlainIndex (pairedSlots n) ≃ {S : Set (Fin n ⊕ Fin n) // PlainState (pairedSlots n) S} :=
    { toFun := fun S => ⟨S.val.val,S.property⟩
      invFun := fun S => ⟨⟨S.val,Or.inl S.property⟩,S.property⟩
      left_inv := by intro S; rfl
      right_inv := by intro S; rfl }
  rw [Fintype.card_congr e,pairedPlain_card]
lemma anneal_plainPartition (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (M : Matroid Γ) (n j : ℕ) :
    slotTotal gs (annealWeight M n j) ∅=
      deficiencyPartition (fun S : PlainIndex gs => n-(M.eRk S.val.val).toNat) (annealRho n^j) := by
  rw [slotTotal_eq_plain_sum gs hgs hcover]
  symm
  exact plainIndex_sum gs (annealWeight M n j)
lemma actual_trace_minimum (n L j : ℕ) (hn : 0<n) (hj : j ≤ L) (M : Matroid (Fin n ⊕ Fin n))
    (w : ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ℝ)
    (hw : ∀ p r,0<w p r) (S : PlainIndex (pairedSlots n)) :
    (1/2:ℝ)^(n*(L+1))  ≤
      (metropolisTrace (pairedSlots n) (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
        w (annealWeight M n j) hw (annealWeight_pos M n j hn)).π S := by
  let := plainIndex_nonempty (pairedSlots n) (pairedSlots_fresh n) (pairedSlots_cover n)
  rw [metropolisTrace_pi,anneal_plainPartition _ (pairedSlots_fresh n) (pairedSlots_cover n)]
  exact anneal_minimum_mass n L j hn hj (plainIndex_card n) (fun S : PlainIndex (pairedSlots n) => n-(M.eRk S.val.val).toNat) (fun _ => Nat.sub_le _ _) S
lemma slotTotal_one (ps : List (Γ × Γ)) (A : Set Γ) (hps : SlotsFresh ps A) :
    slotTotal ps (fun _ => 1) A=(2:ℝ)^ps.length := by
  induction ps generalizing A with
  | nil => rfl
  | cons p ps ih =>
    rw [slotTotal_cons p ps _ A hps.1 hps.2.1 hps.2.2.1]
    have hleft : SlotsFresh ps (insert p.1 A) := hps.2.2.2.mono (by intro i hi; simp only [Set.mem_insert_iff] at hi ⊢; tauto)
    have hright : SlotsFresh ps (insert p.2 A) := hps.2.2.2.mono (by intro i hi; simp only [Set.mem_insert_iff] at hi ⊢; tauto)
    rw [ih _ hleft,ih _ hright,List.length_cons,pow_succ]
    ring
lemma initial_ideal (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (p r : Γ × Γ)
    (hp : p∈gs) (hr : r∈gs) (hpr : p≠r) :
    slotTotal gs (fun _ => 1) ∅/slotDefect gs (fun _ => 1) ∅ p r=4 := by
  have hperm := slots_perm_two hp hr hpr
  have hh := (SlotsFresh.perm hperm ∅).mp hgs
  have hrest : SlotsFresh ((gs.erase p).erase r) (insert r.1 (insert r.2 ∅)) :=
    hh.2.2.2.2.2.2.mono (by intro i hi; simp only [Set.mem_insert_iff] at hi ⊢; tauto)
  have hlen := List.Perm.length_eq hperm
  simp only [List.length_cons] at hlen
  rw [slotTotal_one _ _ hgs,slotDefect,slotTotal_one _ _ hrest,hlen,pow_succ,pow_succ]
  have hp : (2:ℝ)^((gs.erase p).erase r).length≠0 := by positivity
  field_simp
  ; ring
lemma initial_good (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (M : Matroid Γ) (n : ℕ) :
    GoodMultipliers gs (annealWeight M n 0) (fun _ _ => 4) := by
  have he : annealWeight M n 0=(fun _ => 1) := by funext S; simp [annealWeight,matroidWeight]
  rw [he]
  refine ⟨by intros; norm_num,?_,?_⟩
  · intro p hp r hr hpr
    rw [mul_comm (4:ℝ),← div_div,initial_ideal gs hgs p r hp hr hpr]
    norm_num
  · intro p hp r hr hpr
    rw [mul_div_assoc,initial_ideal gs hgs p r hp hr hpr]
    norm_num

noncomputable def empirical (H : Set Γ → ℝ) (l : List (Set Γ)) : ℝ :=
  (l.map H).sum/(l.length:ℝ)
noncomputable def learnedMultipliers (gs : List (Γ × Γ))
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) (l : List (Set Γ)) (p r : Γ × Γ) : ℝ :=
  if p∈gs ∧ r∈gs ∧ p≠r then
    w p r*(empirical (plainObservable gs (fun _ => 1)) l/empirical (defectIndicator gs p r) l)
  else w p r
noncomputable def empiricalRatio (gs : List (Γ × Γ)) (g : Set Γ → ℝ) (l : List (Set Γ)) : ℝ :=
  empirical (plainObservable gs g) l/empirical (plainObservable gs (fun _ => 1)) l

def AccuratePhase (gs : List (Γ × Γ)) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (η : ℝ) (l : List (Set Γ)) : Prop :=
  ∀ j : PhaseObservables gs,
    |empirical (phaseObservable gs g j) l-chainMean gs w f (phaseObservable gs g j)| ≤
      η*chainMean gs w f (phaseObservable gs g j)
lemma relative_error_bounds (x m η : ℝ) (h : |x-m| ≤ η*m) :
    (1-η)*m ≤ x ∧ x ≤ (1+η)*m := by
  obtain ⟨h1,h2⟩ := abs_le.mp h
  constructor <;> nlinarith
lemma accurate_plain (gs : List (Γ × Γ)) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (η : ℝ) (l : List (Set Γ)) (h : AccuratePhase gs w f g η l) :
    (1-η)*chainMean gs w f (plainObservable gs (fun _ => 1)) ≤ empirical (plainObservable gs (fun _ => 1)) l ∧
    empirical (plainObservable gs (fun _ => 1)) l ≤ (1+η)*chainMean gs w f (plainObservable gs (fun _ => 1)) :=
  relative_error_bounds _ _ _ (h (.inl none))
lemma accurate_defect (gs : List (Γ × Γ)) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (η : ℝ) (l : List (Set Γ)) (h : AccuratePhase gs w f g η l)
    (p r : Γ × Γ) (hp : p∈gs) (hr : r∈gs) (hpr : p≠r) :
    (1-η)*chainMean gs w f (defectIndicator gs p r) ≤ empirical (defectIndicator gs p r) l ∧
    empirical (defectIndicator gs p r) l ≤ (1+η)*chainMean gs w f (defectIndicator gs p r) :=
  relative_error_bounds _ _ _ (h (.inl (some ⟨(p,r),(mem_defectTypes gs (p,r)).mpr ⟨hp,hr,hpr⟩⟩)))

theorem successful_phase_learns (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (M : Matroid Γ) (n j : ℕ) (hn : 0<n)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) (hw : ∀ p r,0<w p r)
    (η : ℝ) (hη0 : 0 ≤ η) (hη1 : η ≤ 1/3) (l : List (Set Γ))
    (hacc : AccuratePhase gs w (annealWeight M n j)
      (fun S => annealRho n^(n-(M.eRk S).toNat)) η l) :
    GoodMultipliers gs (annealWeight M n (j+1)) (learnedMultipliers gs w l) := by
  let f := annealWeight M n j
  let g := fun S => annealRho n^(n-(M.eRk S).toNat)
  have hf := annealWeight_pos M n j hn
  have hΛ := chainTotal_pos gs hgs hcover w f hf hw
  have hp0 : 0<chainMean gs w f (plainObservable gs (fun _ => 1)) := by
    rw [plain_probability_mean gs hgs hcover]
    exact div_pos (slotTotal_pos gs f hf ∅ hgs) hΛ
  have hp0h := accurate_plain gs w f g η l hacc
  have hp0hp : 0<empirical (plainObservable gs (fun _ => 1)) l :=
    lt_of_lt_of_le (mul_pos (by linarith) hp0) hp0h.1
  have hpt : ∀ p∈gs,∀ r∈gs,p≠r → 0<chainMean gs w f (defectIndicator gs p r) := by
    intro p hp r hr hpr
    rw [defectIndicator_mean gs hgs hcover w f p r hp hr hpr]
    exact div_pos (mul_pos (hw p r) (slotDefect_pos gs f hf ∅ hgs p r hp hr hpr)) hΛ
  have hptp : ∀ p∈gs,∀ r∈gs,p≠r → 0<empirical (defectIndicator gs p r) l := by
    intro p hp r hr hpr
    exact lt_of_lt_of_le (mul_pos (by linarith) (hpt p hp r hr hpr))
      (accurate_defect gs w f g η l hacc p r hp hr hpr).1
  have hb : ∀ p∈gs,∀ r∈gs,p≠r →
      (slotTotal gs (annealWeight M n (j+1)) ∅/slotDefect gs (annealWeight M n (j+1)) ∅ p r)/4 ≤
        learnedMultipliers gs w l p r ∧
      learnedMultipliers gs w l p r ≤ 4*(slotTotal gs (annealWeight M n (j+1)) ∅/slotDefect gs (annealWeight M n (j+1)) ∅ p r) := by
    intro p hp r hr hpr
    rw [learnedMultipliers,ite_eq_left ⟨hp,hr,hpr⟩]
    exact learned_multiplier_good _ _ _ _ _ _ _ η (hw p r) hp0 (hpt p hp r hr hpr)
      (div_pos (slotTotal_pos gs f hf ∅ hgs) (slotDefect_pos gs f hf ∅ hgs p r hp hr hpr))
      (weight_mean_identity gs hgs hcover f hf w hw p r hp hr hpr) hη0 hη1 hp0h
      (accurate_defect gs w f g η l hacc p r hp hr hpr)
      (anneal_ideal_drift gs hgs M n j hn p r hp hr hpr)
  refine ⟨?_,?_,?_⟩
  · intro p r
    unfold learnedMultipliers
    split_ifs with h
    · exact mul_pos (hw p r) (div_pos hp0hp (hptp p h.1 r h.2.1 h.2.2))
    · exact hw p r
  · intro p hp r hr hpr
    simpa only [div_div,mul_comm] using (hb p hp r hr hpr).1
  · intro p hp r hr hpr
    simpa only [mul_div_assoc] using (hb p hp r hr hpr).2

theorem successful_phase_ratio (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (M : Matroid Γ) (n j : ℕ) (hn : 0<n)
    (w : (Γ × Γ) → (Γ × Γ) → ℝ) (hw : ∀ p r,0<w p r)
    (η : ℝ) (hη0 : 0 ≤ η) (hη1 : η<1) (l : List (Set Γ))
    (hacc : AccuratePhase gs w (annealWeight M n j)
      (fun S => annealRho n^(n-(M.eRk S).toNat)) η l) :
    (1-η)/(1+η) ≤ empiricalRatio gs (fun S => annealRho n^(n-(M.eRk S).toNat)) l/
      (slotTotal gs (annealWeight M n (j+1)) ∅/slotTotal gs (annealWeight M n j) ∅) ∧
    empiricalRatio gs (fun S => annealRho n^(n-(M.eRk S).toNat)) l/
      (slotTotal gs (annealWeight M n (j+1)) ∅/slotTotal gs (annealWeight M n j) ∅) ≤ (1+η)/(1-η) := by
  let f := annealWeight M n j
  let g := fun S => annealRho n^(n-(M.eRk S).toNat)
  have hΛ := chainTotal_pos gs hgs hcover w f (annealWeight_pos M n j hn) hw
  have hp0 : 0<chainMean gs w f (plainObservable gs (fun _ => 1)) := by
    rw [plain_probability_mean gs hgs hcover]
    exact div_pos (slotTotal_pos gs f (annealWeight_pos M n j hn) ∅ hgs) hΛ
  have hu : 0<chainMean gs w f (plainObservable gs g) := by
    rw [anneal_ratio_mean gs hgs hcover M n j hn]
    exact div_pos (slotTotal_pos gs _ (annealWeight_pos M n (j+1) hn) ∅ hgs) hΛ
  have he : chainMean gs w f (plainObservable gs g)/chainMean gs w f (plainObservable gs (fun _ => 1)) =
      slotTotal gs (annealWeight M n (j+1)) ∅/slotTotal gs (annealWeight M n j) ∅ := by
    rw [anneal_ratio_mean gs hgs hcover M n j hn,plain_probability_mean gs hgs hcover]
    dsimp only [f] at hΛ ⊢
    field_simp [hΛ.ne']
  have h := estimated_ratio_bounds η _ _ _ _ hη0 hη1 hp0 hu
    (accurate_plain gs w f g η l hacc) (relative_error_bounds _ _ _ (hacc (.inr ())))
  rw [he] at h
  exact h.2
end ActualAnnealing
namespace FiniteChain
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X)
lemma capped_power_submass (K : FiniteKernel X X) (hK : ∀ x y,K.P x y ≤ C.P x y)
    (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) (U e : ℝ) (hwarm : ∀ x,ν x ≤ U*C.π x)
    (hloss : ∀ a : X → ℝ,(∀ x,0 ≤ a x) → (∀ x,a x ≤ U*C.π x) →
      (∑ x,a x*(1-∑ y,K.P x y)) ≤ e) (T : ℕ) :
    (∑ x,ν x)-(∑ x,(K.power T).push ν x) ≤ (T:ℝ)*e := by
  have hdom := fun n x => K.power_domination C.kernel hK n ν hν x
  induction T with
  | zero => simp [FiniteKernel.power,FiniteKernel.push_identity]
  | succ T ih =>
    have h := K.one_step_defect C.kernel C.stochastic
      ((K.power T).push ν) ((C.kernel.power T).push ν)
      ((K.power T).push_nonneg ν hν) (hdom T)
    have hl := hloss ((C.kernel.power T).push ν)
      ((C.kernel.power T).push_nonneg ν hν) (C.power_warm T ν U hwarm)
    have hm := C.power_push_mass T ν
    have hm' := C.power_push_mass (T+1) ν
    rw [FiniteKernel.power_push_succ] at hm'
    rw [FiniteKernel.power_push_succ]
    rw [hm,hm'] at h
    push_cast
    linarith
variable (A : X → Prop) (Q : KilledKernel (Outside A)) (hQ : ∀ x y,Q.Q x y=C.P x.val y.val)
lemma cappedTrace_power_submass [Nonempty (Inside A)] (N T : ℕ) (hN : 0<N)
    (U : ℝ) (ν : Inside A → ℝ) (hν : ∀ x,0 ≤ ν x)
    (hwarm : ∀ x,ν x ≤ U*(C.traceChain A Q hQ).π x) :
    (∑ x,ν x)-(∑ x,((C.cappedTraceKernel A Q hQ N).power T).push ν x) ≤
      (T:ℝ)*(U/C.insideMass A/(N:ℝ)) := by
  apply (C.traceChain A Q hQ).capped_power_submass (C.cappedTraceKernel A Q hQ N)
    (C.cappedTrace_le A Q N) ν hν U _ hwarm
  intro a ha haw
  have h := C.cappedTrace_warm_loss A Q hQ N U a ha haw
  apply (le_div_iff₀ (by exact_mod_cast hN : (0:ℝ)<N)).mpr
  simpa only [cappedTraceKernel,mul_comm] using h
end FiniteChain

section RestartBridge
open scoped BigOperators Classical
variable (n : ℕ) (hn : 0<n) (M : Matroid (Fin n ⊕ Fin n))
    (hE : M.E=Set.univ) (hR : M.eRank=(n:ℕ∞))
local notation "GS" => pairedSlots n
local notation "W" => (((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ℝ)
noncomputable def actualTrace (j : ℕ) (w : W) (hw : ∀ p r,0<w p r) : FiniteChain (PlainIndex GS) :=
  metropolisTrace GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
    w (annealWeight M n j) hw (annealWeight_pos M n j hn)
include hE hR in
lemma actual_trace_poincare (j : ℕ) (w : W) (hw : GoodMultipliers GS (annealWeight M n j) w)
    (H : PlainIndex GS → ℝ) :
    (actualTrace n hn M j w hw.positive).variance H ≤
      18*(n:ℝ)^4*(actualTrace n hn M j w hw.positive).energy H := by
  have hr := annealRho_bounds n hn
  have hp : 0<annealRho n := lt_of_lt_of_le (by norm_num) hr.1
  have hs := matroidWeight_signature M hE n hR (annealRho n^j) (pow_pos hp j) (pow_le_one₀ hp.le hr.2.le)
  simpa only [actualTrace,pairedSlots_length] using
    metropolisTrace_poincare GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
      w (annealWeight M n j) hw.positive (annealWeight_pos M n j hn) hs hw.lower H
include hE hR in
lemma actual_trace_mixing_warm (L j : ℕ) (hj : j ≤ L) (w : W)
    (hw : GoodMultipliers GS (annealWeight M n j) w)
    (ν : PlainIndex GS → ℝ) (hν : ∀ x,0 ≤ ν x) (hnorm : ∑ x,ν x ≤ 1)
    (y : PlainIndex GS) :
    ((actualTrace n hn M j w hw.positive).kernel.power (20*n^4*(n*(L+1)+2))).push ν y ≤
      (3/2)*(actualTrace n hn M j w hw.positive).π y := by
  have hn' : (1:ℝ) ≤ n := by exact_mod_cast hn
  have hK : (1:ℝ) ≤ 18*(n:ℝ)^4 := by nlinarith [pow_le_pow_left₀ (by norm_num : (0:ℝ) ≤ 1) hn' 4]
  have he := Annealing.restart_exponential n L hn
  have hm : (1/2:ℝ)^(n*(L+1))=(2:ℝ)^(-((n*(L+1):ℕ):ℤ)) := by
    simp only [zpow_neg,zpow_natCast,one_div,inv_pow]
  rw [← hm] at he
  convert (actualTrace n hn M j w hw.positive).kernel_power_warm_any
    (18*(n:ℝ)^4) ((1/2)^(n*(L+1))) (1/2) hK (by positivity)
    (actual_trace_minimum n L j hn hj M w hw.positive)
    (actual_trace_poincare n hn M hE hR j w hw) _ he (by norm_num) ν hν hnorm y using 1 ; norm_num
lemma actual_mu_drift (j : ℕ) (w w' : W) (hw : ∀ p r,0<w p r) (hw' : ∀ p r,0<w' p r)
    (x : PlainIndex GS) :
    (actualTrace n hn M j w hw).π x ≤ 2*(actualTrace n hn M (j+1) w' hw').π x := by
  dsimp only [actualTrace]
  rw [metropolisTrace_pi,metropolisTrace_pi]
  have ha := annealWeight_drift M n j hn x.val.val
  have hb := anneal_slot_drift GS M n j hn ∅
  have hz := slotTotal_pos GS (annealWeight M n j) (annealWeight_pos M n j hn) ∅ (pairedSlots_fresh n)
  have hz' := slotTotal_pos GS (annealWeight M n (j+1)) (annealWeight_pos M n (j+1) hn) ∅ (pairedSlots_fresh n)
  rw [← mul_div_assoc,div_le_div_iff₀ hz hz']
  have hfp := (annealWeight_pos M n j hn x.val.val).le
  nlinarith [mul_nonneg hfp (sub_nonneg.mpr hb.2),mul_nonneg hz.le (sub_nonneg.mpr ha.1)]
end RestartBridge

section ActualRestart
open scoped BigOperators Classical
variable (n : ℕ) (hn : 0<n) (M : Matroid (Fin n ⊕ Fin n))
local notation "GS" => pairedSlots n
local notation "W" => (((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ℝ)
noncomputable def actualCappedTrace (j : ℕ) (w : W) (hw : ∀ p r,0<w p r) (cap : ℕ) :
    FiniteKernel (PlainIndex GS) (PlainIndex GS) :=
  (metropolisChain GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
    w (annealWeight M n j) hw (annealWeight_pos M n j hn)).cappedTraceKernel (plainPredicate GS)
    (metropolisKilled GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
      w (annealWeight M n j) hw (annealWeight_pos M n j hn)) (by intros; rfl) cap
lemma actualCappedTrace_le (j : ℕ) (w : W) (hw : ∀ p r,0<w p r) (cap : ℕ) (x y : PlainIndex GS) :
    (actualCappedTrace n hn M j w hw cap).P x y ≤ (actualTrace n hn M j w hw).P x y := by
  exact FiniteChain.cappedTrace_le _ _ _ cap x y
lemma actual_capped_mixing (hE : M.E=Set.univ) (hR : M.eRank=(n:ℕ∞))
    (L j : ℕ) (hj : j ≤ L) (w : W) (hw : GoodMultipliers GS (annealWeight M n j) w)
    (cap : ℕ) (ν : PlainIndex GS → ℝ) (hν : ∀ x,0 ≤ ν x) (hnorm : ∑ x,ν x ≤ 1)
    (y : PlainIndex GS) :
    ((actualCappedTrace n hn M j w hw.positive cap).power (20*n^4*(n*(L+1)+2))).push ν y ≤
      (3/2)*(actualTrace n hn M j w hw.positive).π y := by
  exact ((actualCappedTrace n hn M j w hw.positive cap).power_domination
    (actualTrace n hn M j w hw.positive).kernel (actualCappedTrace_le n hn M j w hw.positive cap)
    _ ν hν y).trans (actual_trace_mixing_warm n hn M hE hR L j hj w hw ν hν hnorm y)
lemma actual_capped_loss (j : ℕ) (w : W) (hw : GoodMultipliers GS (annealWeight M n j) w)
    (cap T : ℕ) (hcap : 0<cap) (ν : PlainIndex GS → ℝ) (hν : ∀ x,0 ≤ ν x)
    (hwarm : ∀ x,ν x ≤ 4*(actualTrace n hn M j w hw.positive).π x) :
    (∑ x,ν x)-(∑ x,((actualCappedTrace n hn M j w hw.positive cap).power T).push ν x) ≤
      (T:ℝ)*(20*(n:ℝ)^2/(cap:ℝ)) := by
  let := plainIndex_nonempty GS (pairedSlots_fresh n) (pairedSlots_cover n)
  let C := metropolisChain GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
    w (annealWeight M n j) hw.positive (annealWeight_pos M n j hn)
  let Q := metropolisKilled GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
    w (annealWeight M n j) hw.positive (annealWeight_pos M n j hn)
  have h := C.cappedTrace_power_submass (plainPredicate GS) Q (by intros; rfl) cap T hcap 4 ν hν hwarm
  change _ ≤ (T:ℝ)*(4/C.insideMass (plainPredicate GS)/(cap:ℝ)) at h
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  have hmass := plain_mass_lower GS (pairedSlots_fresh n) (pairedSlots_ne_nil n hn) (pairedSlots_cover n)
    w (annealWeight M n j) hw.positive (annealWeight_pos M n j hn) hw.upper
  simp only [pairedSlots_length] at hmass
  have hm' : 1/(5*(n:ℝ)^2) ≤ C.insideMass (plainPredicate GS) := by
    rw [metropolis_insideMass]; exact hmass
  have hn' : (0:ℝ)<n := by exact_mod_cast hn
  have hp : 0<C.insideMass (plainPredicate GS) := (by positivity : (0:ℝ)<1/(5*(n:ℝ)^2)).trans_le hm'
  apply (div_le_iff₀ hp).mpr
  have hh := (div_le_iff₀ (by positivity : (0:ℝ)<5*(n:ℝ)^2)).mp hm'
  nlinarith
noncomputable def uniformPlain (_ : PlainIndex GS) : ℝ := by
  exact 1/(2:ℝ)^n
lemma uniformPlain_mass : ∑ x : PlainIndex GS,uniformPlain n x=1 := by
  simp [uniformPlain,plainIndex_card]
lemma uniformPlain_pi (w : W) (hw : ∀ p r,0<w p r) (x : PlainIndex GS) :
    uniformPlain n x=(actualTrace n hn M 0 w hw).π x := by
  rw [actualTrace,metropolisTrace_pi]
  have he : annealWeight M n 0=(fun _ => 1) := by funext S; simp [annealWeight,matroidWeight]
  rw [he,slotTotal_one GS ∅ (pairedSlots_fresh n),pairedSlots_length]
  rfl
noncomputable def restartLaw (L cap : ℕ) (w : ℕ → W) (hw : ∀ j p r,0<w j p r) : ℕ → PlainIndex GS → ℝ
  | 0 => uniformPlain n
  | j+1 => ((actualCappedTrace n hn M (j+1) (w (j+1)) (hw (j+1)) cap).power
      (20*n^4*(n*(L+1)+2))).push (restartLaw L cap w hw j)
lemma restartLaw_nonneg (L cap : ℕ) (w : ℕ → W) (hw : ∀ j p r,0<w j p r)
    (j : ℕ) (x : PlainIndex GS) : 0 ≤ restartLaw n hn M L cap w hw j x := by
  induction j generalizing x with
  | zero => simp only [restartLaw,uniformPlain]; positivity
  | succ j ih => exact FiniteKernel.push_nonneg _ _ ih x
lemma restartLaw_mass_le (L cap : ℕ) (w : ℕ → W) (hw : ∀ j p r,0<w j p r) (j : ℕ) :
    (∑ x,restartLaw n hn M L cap w hw j x) ≤ 1 := by
  induction j with
  | zero => exact (uniformPlain_mass n).le
  | succ j ih => exact (FiniteKernel.push_mass_le _ _ (restartLaw_nonneg n hn M L cap w hw j)).trans ih
lemma restartLaw_warm (hE : M.E=Set.univ) (hR : M.eRank=(n:ℕ∞))
    (L cap : ℕ) (w : ℕ → W) (hw : ∀ j p r,0<w j p r)
    (j : ℕ) (hj : j ≤ L) (hgood : GoodMultipliers GS (annealWeight M n j) (w j))
    (x : PlainIndex GS) :
    restartLaw n hn M L cap w hw j x ≤ 2*(actualTrace n hn M j (w j) (hw j)).π x := by
  cases j with
  | zero =>
    rw [restartLaw,uniformPlain_pi n hn M (w 0) (hw 0)]
    have h := (actualTrace n hn M 0 (w 0) (hw 0)).positive x
    linarith
  | succ j =>
    have h := actual_capped_mixing n hn M hE hR L (j+1) hj (w (j+1)) hgood cap
      (restartLaw n hn M L cap w hw j) (restartLaw_nonneg n hn M L cap w hw j)
      (restartLaw_mass_le n hn M L cap w hw j) x
    change _ ≤ 2*(actualTrace n hn M (j+1) (w (j+1)) (hw (j+1))).π x
    have hp := (actualTrace n hn M (j+1) (w (j+1)) (hw (j+1))).positive x
    exact h.trans (by linarith)
lemma restartLaw_missing_mass (hE : M.E=Set.univ) (hR : M.eRank=(n:ℕ∞))
    (L cap : ℕ) (hcap : 0<cap) (w : ℕ → W) (hw : ∀ j p r,0<w j p r)
    (j : ℕ) (hj : j ≤ L)
    (hgood : ∀ a ≤ j,GoodMultipliers GS (annealWeight M n a) (w a)) :
    1-(∑ x,restartLaw n hn M L cap w hw j x) ≤
      (j:ℝ)*((20*n^4*(n*(L+1)+2):ℕ):ℝ)*(20*(n:ℝ)^2/(cap:ℝ)) := by
  induction j with
  | zero => simp [restartLaw,uniformPlain_mass]
  | succ j ih =>
    have hj' : j ≤ L := by omega
    have hb := ih hj' (fun a ha => hgood a (by omega))
    have hwarm : ∀ x,restartLaw n hn M L cap w hw j x ≤ 4*(actualTrace n hn M (j+1) (w (j+1)) (hw (j+1))).π x := by
      intro x
      have h1 := restartLaw_warm n hn M hE hR L cap w hw j hj' (hgood j (by omega)) x
      have h2 := actual_mu_drift n hn M j (w j) (w (j+1)) (hw j) (hw (j+1)) x
      linarith
    have h := actual_capped_loss n hn M (j+1) (w (j+1)) (hgood (j+1) le_rfl) cap
      (20*n^4*(n*(L+1)+2)) hcap (restartLaw n hn M L cap w hw j)
      (restartLaw_nonneg n hn M L cap w hw j) hwarm
    change 1-(∑ x,(_ : FiniteKernel _ _).push _ x) ≤ _
    simp only [Nat.cast_add,Nat.cast_one]
    nlinarith
end ActualRestart
namespace FiniteChain
open scoped BigOperators Classical
variable {X : Type*} [Fintype X] (C : FiniteChain X)
lemma pathProbability_congr_length (ν : X → ℝ) (N : ℕ) (E F : List X → Prop)
    (h : ∀ l,l.length=N+1 → (E l ↔ F l)) :
    C.pathProbability ν N E=C.pathProbability ν N F := by
  unfold pathProbability
  apply Finset.sum_congr rfl
  intro x _
  congr 1
  apply C.pathExpectation_congr_length
  intro l hl
  simp only [h l hl]
lemma pathProbability_compl (ν : X → ℝ) (N : ℕ) (E : List X → Prop) :
    C.pathProbability ν N E+C.pathProbability ν N (fun l => ¬E l)=∑ x,ν x := by
  unfold pathProbability
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro x _
  rw [← mul_add,← C.pathExpectation_add]
  calc
    _ = ν x*C.pathExpectation N x (fun _ => 1) := by
      congr 1
      apply C.pathExpectation_congr
      intro l
      by_cases h : E l <;> simp [h]
    _ = ν x := by rw [C.pathExpectation_const,mul_one]
lemma pathProbability_le_mass (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) (N : ℕ) (E : List X → Prop) :
    C.pathProbability ν N E ≤ ∑ x,ν x := by
  have h := C.pathProbability_compl ν N E
  have hn := C.pathProbability_nonneg ν hν N (fun l => ¬E l)
  linarith
end FiniteChain
section PhaseBridge
open scoped BigOperators Classical
variable {Γ : Type*} [sectionInstance97 : Fintype Γ] [sectionInstance98 : DecidableEq Γ]
omit sectionInstance97 sectionInstance98 in
lemma empirical_trajectory [Fintype Γ] [DecidableEq Γ] (gs : List (Γ × Γ)) (H : Set Γ → ℝ) (l : List (ChainIndex gs)) :
    empirical H (l.map Subtype.val)=FiniteChain.pathSum (fun S => H S.val) l/(l.length:ℝ) := by
  simp [empirical,FiniteChain.pathSum,]

theorem accurate_phase_probability (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f g : Set Γ → ℝ) (hw : GoodMultipliers gs f w) (hf : ∀ S,0<f S)
    (hsig : HasSlotSignature f) (hg : ∀ S,PlainState gs S → 1/2 ≤ g S ∧ g S ≤ 1)
    (ν : ChainIndex gs → ℝ) (hν : ∀ S,0 ≤ ν S)
    (hwarm : ∀ S,ν S ≤ (10*(gs.length:ℝ)^2)*chainWeight gs w f S.val/chainTotal gs w f)
    (L N : ℕ) (η : ℝ) (hη : 0<η) (hN : (10:ℝ)^10*(L+1)*gs.length^14/η^2 ≤ N) :
    let C := metropolisChain gs hgs hne hcover w f hw.positive hf
    (∑ S,ν S)-1/(32*(L+1:ℝ)) ≤
      C.pathProbability ν (N-1) (fun l => AccuratePhase gs w f g η (l.map Subtype.val)) := by
  let C := metropolisChain gs hgs hne hcover w f hw.positive hf
  have hn : 0<gs.length := List.length_pos_iff.mpr hne
  have hn' : (0:ℝ)<gs.length := by exact_mod_cast hn
  have hNp : (0:ℝ)<N := lt_of_lt_of_le (by positivity) hN
  have hNp' : 0<N := by exact_mod_cast hNp
  have h := metropolis_phase_failure gs hgs hne hcover w f g hw.positive hf hsig hg
    hw.lower hw.upper ν hν hwarm L N η hη hN
  change C.pathProbability ν (N-1) _ ≤ _ at h
  have he := C.pathProbability_congr_length ν (N-1)
    (fun l => ∃ j : PhaseObservables gs,η*C.mean (fun S => phaseObservable gs g j S.val)<
      |FiniteChain.pathSum (fun S => phaseObservable gs g j S.val) l/(N:ℝ)-C.mean (fun S => phaseObservable gs g j S.val)|)
    (fun l => ¬AccuratePhase gs w f g η (l.map Subtype.val)) (by
      intro l hl
      have hl' : l.length=N := by omega
      simp only [AccuratePhase,empirical_trajectory,hl',not_forall,not_le]
      simp only [C,metropolisChain_mean])
  rw [he] at h
  have hc := C.pathProbability_compl ν (N-1) (fun l => AccuratePhase gs w f g η (l.map Subtype.val))
  dsimp only
  linarith
end PhaseBridge
section EstimatorBridge
open scoped BigOperators Classical
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]
lemma product_ratios_telescope (a : ℕ → ℝ) (ha : ∀ j,a j≠0) (L : ℕ) :
    (∏ j ∈ Finset.range L,a (j+1)/a j)=a L/a 0 := by
  induction L with
  | zero => simp [ha]
  | succ L ih => rw [Finset.prod_range_succ,ih]; field_simp [ha L,ha 0]
lemma accurate_phases_product (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅)
    (hcover : pairSupport gs=Set.univ) (M : Matroid Γ) (n : ℕ) (hn : 0<n)
    (ε : ℝ) (hε0 : 0<ε) (hε1 : ε<1) (L : ℕ)
    (w : ℕ → (Γ × Γ) → (Γ × Γ) → ℝ) (hw : ∀ j p r,0<w j p r)
    (ls : ℕ → List (Set Γ))
    (hacc : ∀ j<L,AccuratePhase gs (w j) (annealWeight M n j)
      (fun S => annealRho n^(n-(M.eRk S).toNat)) (annealTolerance ε L) (ls j)) :
    let Zhat := (2:ℝ)^gs.length * ∏ j ∈ Finset.range L,
      empiricalRatio gs (fun S => annealRho n^(n-(M.eRk S).toNat)) (ls j)
    (1-ε/4)*slotTotal gs (annealWeight M n L) ∅ ≤ Zhat ∧
      Zhat ≤ (1+ε/4)*slotTotal gs (annealWeight M n L) ∅ := by
  let c := fun j => slotTotal gs (annealWeight M n j) ∅
  let R := fun j => empiricalRatio gs (fun S => annealRho n^(n-(M.eRk S).toNat)) (ls j)
  have hc : ∀ j,0<c j := fun j => slotTotal_pos gs _ (annealWeight_pos M n j hn) ∅ hgs
  have ht := product_ratios_telescope c (fun j => (hc j).ne') L
  have he : c 0=(2:ℝ)^gs.length := by
    have hf : annealWeight M n 0=(fun _ => 1) := by funext S; simp [annealWeight,matroidWeight]
    dsimp only [c]; rw [hf,slotTotal_one gs ∅ hgs]
  have hη : 0<annealTolerance ε L ∧ annealTolerance ε L<1/32 := by
    have hd : 0<32*((L:ℝ)+1) := by positivity
    constructor
    · exact div_pos hε0 hd
    · apply (div_lt_iff₀ hd).mpr
      nlinarith [Nat.cast_nonneg (α := ℝ) L]
  have hp := product_accuracy (fun j => R j/(c (j+1)/c j)) ε L hε0 hε1
    (fun j hj => successful_phase_ratio gs hgs hcover M n j hn (w j) (hw j)
      (annealTolerance ε L) hη.1.le (by linarith [hη.2]) (ls j) (hacc j hj))
  have hidentity : (∏ j ∈ Finset.range L,R j/(c (j+1)/c j)) =
      ((2:ℝ)^gs.length*(∏ j ∈ Finset.range L,R j))/c L := by
    rw [Finset.prod_div_distrib,ht,he]
    field_simp
  rw [hidentity] at hp
  constructor
  · exact (le_div_iff₀ (hc L)).mp hp.1
  · exact (div_le_iff₀ (hc L)).mp hp.2

theorem actual_estimator_accuracy {n : ℕ} (hn : 0<n) (M₁ M₂ : Matroid (Fin n))
    (hE₂ : M₂.E=Set.univ) (hr : M₁.eRank=M₂.eRank)
    (ε : ℝ) (hε0 : 0<ε) (hε1 : ε<1) (b : ℕ) (hb : (1/2:ℝ)^b ≤ ε/10)
    (hZ : 0<commonBaseCount M₁ M₂)
    (w : ℕ → ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ((Fin n ⊕ Fin n) × (Fin n ⊕ Fin n)) → ℝ)
    (hw : ∀ j p r,0<w j p r) (ls : ℕ → List (Set (Fin n ⊕ Fin n)))
    (hacc : ∀ j<annealLength n b,AccuratePhase (pairedSlots n) (w j) (annealWeight (pairedMatroid M₁ M₂) n j)
      (fun S => annealRho n^(n-((pairedMatroid M₁ M₂).eRk S).toNat))
      (annealTolerance ε (annealLength n b)) (ls j)) :
    let Zhat := (2:ℝ)^n * ∏ j ∈ Finset.range (annealLength n b),
      empiricalRatio (pairedSlots n) (fun S => annealRho n^(n-((pairedMatroid M₁ M₂).eRk S).toNat)) (ls j)
    (1-ε)*(commonBaseCount M₁ M₂:ℝ) ≤ Zhat ∧ Zhat ≤ (1+ε)*(commonBaseCount M₁ M₂:ℝ) := by
  have hp := accurate_phases_product (pairedSlots n) (pairedSlots_fresh n) (pairedSlots_cover n)
    (pairedMatroid M₁ M₂) n hn ε hε0 hε1 (annealLength n b) w hw ls hacc
  simp only [pairedSlots_length] at hp
  have hrho := annealRho_bounds n hn
  have hq0 : 0 ≤ annealRho n^annealLength n b := pow_nonneg (le_trans (by norm_num) hrho.1) _
  have hq1 : annealRho n^annealLength n b ≤ 1 := pow_le_one₀ (le_trans (by norm_num) hrho.1) hrho.2.le
  have hc := paired_partition_contamination M₁ M₂ hE₂ hr _ hq0 hq1
  have hcont := anneal_final_contamination n b hn ε hb
  have hZ' : (1:ℝ) ≤ commonBaseCount M₁ M₂ := by exact_mod_cast hZ
  apply final_estimate_accuracy ε _ _ _ hε0 hε1 (by positivity) ⟨hc.1,?_⟩ hp
  have hm := mul_le_mul_of_nonneg_left hZ' (show 0 ≤ ε/10 by positivity)
  nlinarith [hc.2]
end EstimatorBridge
namespace FiniteChain
open scoped BigOperators Classical
variable {X : Type*} [sectionInstance101 : Fintype X]
universe u

def Sample (X : Type u) : ℕ → Type u
  | 0 => X
  | k+1 => X × Sample X k
instance sampleFintype (k : ℕ) : Fintype (Sample X k) := by
  induction k with
  | zero => exact inferInstanceAs (Fintype X)
  | succ k ih =>
    letI : Fintype (Sample X k) := ih
    exact inferInstanceAs (Fintype (X × Sample X k))
def Sample.toList : {k : ℕ} → Sample X k → List X
  | 0,x => [x]
  | _+1,(x,v) => x::v.toList
omit sectionInstance101 in
lemma Sample.toList_length [Fintype X] {k : ℕ} (v : Sample X k) : v.toList.length=k+1 := by
  induction k with
  | zero => rfl
  | succ k ih => exact congrArg Nat.succ (ih v.2)
variable (C : FiniteChain X)
noncomputable def sampleMass (C : FiniteChain X) (ν : X → ℝ) : {k : ℕ} → Sample X k → ℝ
  | 0,x => ν x
  | _+1,(x,v) => ν x*sampleMass C (C.P x) v
lemma sampleMass_nonneg (ν : X → ℝ) (hν : ∀ x,0 ≤ ν x) {k : ℕ} (v : Sample X k) :
    0 ≤ C.sampleMass ν v := by
  induction k generalizing ν with
  | zero => exact hν v
  | succ k ih => exact mul_nonneg (hν _) (ih _ (C.nonnegative _) v.2)
lemma sampleMass_expect (ν : X → ℝ) (k : ℕ) (F : List X → ℝ) :
    (∑ v : Sample X k,C.sampleMass ν v*F v.toList)=
      ∑ x,ν x*C.pathExpectation k x F := by
  induction k generalizing ν F with
  | zero => rfl
  | succ k ih =>
    change (∑ v : X × Sample X k,_)=_
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro x _
    simp only [sampleMass,Sample.toList,mul_assoc,← Finset.mul_sum]
    rw [ih (C.P x) (fun l => F (x::l))]
    rfl
lemma sampleMass_total (ν : X → ℝ) (k : ℕ) :
    (∑ v : Sample X k,C.sampleMass ν v)=∑ x,ν x := by
  have h := C.sampleMass_expect ν k (fun _ => 1)
  simpa only [mul_one,C.pathExpectation_const] using h
lemma sampleMass_event (ν : X → ℝ) (k : ℕ) (E : List X → Prop) :
    (∑ v : Sample X k,if E v.toList then C.sampleMass ν v else 0)=C.pathProbability ν k E := by
  unfold pathProbability
  rw [← C.sampleMass_expect]
  apply Finset.sum_congr rfl
  intro v _
  split_ifs <;> simp
end FiniteChain
section WarmLift
open scoped BigOperators Classical
variable {Γ : Type*} [sectionInstance102 : Fintype Γ] [sectionInstance103 : DecidableEq Γ]
noncomputable def plainLift (gs : List (Γ × Γ)) (ν : PlainIndex gs → ℝ) (S : ChainIndex gs) : ℝ :=
  if h : PlainState gs S.val then ν ⟨S,h⟩ else 0
omit sectionInstance102 sectionInstance103 in
lemma plainLift_nonneg [Fintype Γ] [DecidableEq Γ] (gs : List (Γ × Γ)) (ν : PlainIndex gs → ℝ) (hν : ∀ x,0 ≤ ν x) (S : ChainIndex gs) :
    0 ≤ plainLift gs ν S := by unfold plainLift; split_ifs; exact hν _; rfl
omit sectionInstance103 in
lemma plainLift_mass [DecidableEq Γ] (gs : List (Γ × Γ)) (ν : PlainIndex gs → ℝ) :
    (∑ S,plainLift gs ν S)=∑ S : PlainIndex gs,ν S := by
  have h := Fintype.sum_subtype_add_sum_subtype (plainPredicate gs) (fun S => plainLift gs ν S)
  have ht : ∀ S : PlainIndex gs,plainLift gs ν S.val=ν S := by
    intro S; exact dite_eq_left S.property
  have hf : ∀ S : {S : ChainIndex gs // ¬plainPredicate gs S},plainLift gs ν S.val=0 := by
    intro S; exact dite_eq_right S.property
  simp_rw [ht,hf,Finset.sum_const_zero,add_zero] at h
  exact h.symm
lemma plainLift_warm (gs : List (Γ × Γ)) (hgs : SlotsFresh gs ∅) (hne : gs≠[])
    (hcover : pairSupport gs=Set.univ) (w : (Γ × Γ) → (Γ × Γ) → ℝ)
    (f : Set Γ → ℝ) (hf : ∀ S,0<f S) (hw : GoodMultipliers gs f w)
    (ν : PlainIndex gs → ℝ)
    (hν : ∀ S,ν S ≤ 2*(metropolisTrace gs hgs hne hcover w f hw.positive hf).π S)
    (S : ChainIndex gs) :
    plainLift gs ν S ≤ (10*(gs.length:ℝ)^2)*chainWeight gs w f S.val/chainTotal gs w f := by
  have hΛ := chainTotal_pos gs hgs hcover w f hf hw.positive
  unfold plainLift
  split_ifs with hS
  · have hn : (0:ℝ)<gs.length := by exact_mod_cast List.length_pos_iff.mpr hne
    have hz := slotTotal_pos gs f hf ∅ hgs
    have hbound := plain_mass_lower gs hgs hne hcover w f hw.positive hf hw.upper
    have hh := hν ⟨S,hS⟩
    rw [metropolisTrace_pi] at hh
    rw [chainWeight,chainMultiplier_plain gs w S.val hS,one_mul]
    apply hh.trans
    rw [← mul_div_assoc,div_le_div_iff₀ hz hΛ]
    have hm := (div_le_div_iff₀ (by positivity : (0:ℝ)<5*(gs.length:ℝ)^2) hΛ).mp hbound
    nlinarith [mul_nonneg (hf S.val).le (sub_nonneg.mpr (show chainTotal gs w f ≤ 5*(gs.length:ℝ)^2*slotTotal gs f ∅ by nlinarith))]
  · exact div_nonneg (mul_nonneg (by positivity) (chainWeight_pos gs w f hw.positive hf S.val).le) hΛ.le
end WarmLift
namespace FiniteExperiment
open scoped BigOperators Classical
variable {X : Type*} [Fintype X]
theorem adaptive_success_bounded (K : List X → X → ℝ) (Good : List X → Prop)
    (hK : ∀ h x,0 ≤ K h x) (hrow : ∀ h,∑ x,K h x ≤ 1)
    (hsupport : ∀ h,Good h → ∀ x,0<K h x → Good (h++[x]))
    (L : ℕ) (e : ℝ) (he : 0 ≤ e)
    (hloss : ∀ h,Good h → h.length<L → 1-e ≤ ∑ x,K h x)
    (t : ℕ) (h : List X) (hh : Good h) (hsize : h.length+t ≤ L) :
    1-(t:ℝ)*e ≤ mass K t h := by
  induction t generalizing h with
  | zero => simp [mass,expect]
  | succ t ih =>
    have hlocal : ∀ x,K h x*(1-(t:ℝ)*e) ≤ K h x*mass K t (h++[x]) := by
      intro x
      by_cases hz : K h x=0
      · simp [hz]
      · exact mul_le_mul_of_nonneg_left (ih _ (hsupport h hh x (lt_of_le_of_ne (hK h x) (Ne.symm hz))) (by simp only [List.length_append,List.length_singleton]; omega)) (hK h x)
    change 1-((t+1:ℕ):ℝ)*e ≤ ∑ x,K h x*mass K t (h++[x])
    have hs := Finset.sum_le_sum (fun x (_ : x∈Finset.univ) => hlocal x)
    rw [← Finset.sum_mul] at hs
    have hm := hloss h hh (by omega)
    have hu := hrow h
    have ht : 0 ≤ (t:ℝ)*e := mul_nonneg (Nat.cast_nonneg _) he
    push_cast
    nlinarith [mul_nonneg ht (sub_nonneg.mpr hu)]
theorem good_probability_bounded (P : List X → X → ℝ) (Good : List X → Prop)
    (hP : ∀ h x,0 ≤ P h x) (hrow : ∀ h,∑ x,P h x ≤ 1)
    (L : ℕ) (e : ℝ) (he : 0 ≤ e)
    (hstep : ∀ h,Good h → h.length<L → 1-e ≤ ∑ x,restrict P Good h x) :
    Good [] → 1-(L:ℝ)*e ≤ expect P L [] (fun l => if Good l then 1 else 0) := by
  intro hh
  have hb := adaptive_success_bounded (restrict P Good) Good (restrict_nonneg P Good hP)
    (fun h => (Finset.sum_le_sum (fun x _ => restrict_le P Good hP h x)).trans (hrow h))
    (fun h _ x hx => restrict_support P Good h x hx) L e he hstep L [] hh (by simp)
  exact hb.trans (mass_le_good_probability P Good hP L [] hh)
end FiniteExperiment
section ActualHistory
open scoped BigOperators Classical
variable {Γ : Type*} [sectionInstance105 : Fintype Γ] [DecidableEq Γ]
variable (gs : List (Γ × Γ))
noncomputable def historyWeights {X : Type*} (sample : X → List (Set Γ)) (h : List X) :
    (Γ × Γ) → (Γ × Γ) → ℝ :=
  h.foldl (fun w x => learnedMultipliers gs w (sample x)) (fun _ _ => 4)
omit sectionInstance105 in
lemma historyWeights_nil [Fintype Γ] {X : Type*} (sample : X → List (Set Γ)) : historyWeights gs sample []=(fun _ _ => 4) := rfl
omit sectionInstance105 in
lemma historyWeights_snoc [Fintype Γ] {X : Type*} (sample : X → List (Set Γ)) (h : List X) (x : X) :
    historyWeights gs sample (h++[x])=learnedMultipliers gs (historyWeights gs sample h) (sample x) := by
  simp [historyWeights,List.foldl_append]
variable (M : Matroid Γ) (n : ℕ) (η : ℝ)
inductive SuccessfulHistory {X : Type*} (sample : X → List (Set Γ)) : List X → Prop
  | nil : SuccessfulHistory sample []
  | snoc (h : List X) (x : X) (hh : SuccessfulHistory sample h)
      (hx : AccuratePhase gs (historyWeights gs sample h) (annealWeight M n h.length)
        (fun S => annealRho n^(n-(M.eRk S).toNat)) η (sample x)) : SuccessfulHistory sample (h++[x])
lemma successfulHistory_take {X : Type*} (sample : X → List (Set Γ)) (h : List X)
    (hh : SuccessfulHistory gs M n η sample h) (a : ℕ) :
    SuccessfulHistory gs M n η sample (h.take a) := by
  induction hh with
  | nil => simpa using SuccessfulHistory.nil (gs := gs) (M := M) (n := n) (η := η) (sample := sample)
  | snoc h x hh hx ih =>
    by_cases ha : a ≤ h.length
    · rw [List.take_append_of_le_length ha]
      exact ih
    · have he : a ≥ (h++[x]).length := by simp; omega
      rw [List.take_of_length_le he]
      exact SuccessfulHistory.snoc h x hh hx
lemma successfulHistory_good {X : Type*} (sample : X → List (Set Γ))
    (hgs : SlotsFresh gs ∅) (hcover : pairSupport gs=Set.univ) (hn : 0<n)
    (hη0 : 0 ≤ η) (hη1 : η ≤ 1/3) (h : List X) (hh : SuccessfulHistory gs M n η sample h) :
    GoodMultipliers gs (annealWeight M n h.length) (historyWeights gs sample h) := by
  induction hh with
  | nil => exact initial_good gs hgs M n
  | snoc h x hh hx ih =>
    rw [historyWeights_snoc,List.length_append,List.length_singleton]
    exact successful_phase_learns gs hgs hcover M n h.length hn (historyWeights gs sample h)
      ih.positive η hη0 hη1 (sample x) hx
lemma successfulHistory_snoc_iff {X : Type*} (sample : X → List (Set Γ)) (h : List X) (x : X)
    (hh : SuccessfulHistory gs M n η sample h) :
    SuccessfulHistory gs M n η sample (h++[x]) ↔
      AccuratePhase gs (historyWeights gs sample h) (annealWeight M n h.length)
        (fun S => annealRho n^(n-(M.eRk S).toNat)) η (sample x) := by
  constructor
  · intro hs
    have aux : ∀ l,SuccessfulHistory gs M n η sample l → ∀ h x,l=h++[x] →
        AccuratePhase gs (historyWeights gs sample h) (annealWeight M n h.length)
          (fun S => annealRho n^(n-(M.eRk S).toNat)) η (sample x) := by
      intro l hl h x he
      cases hl with
      | nil => simp at he
      | snoc l y hl hy =>
        have hlen := congrArg List.length he
        simp only [List.length_append,List.length_singleton] at hlen
        have hex := List.append_inj he (by omega : l.length=h.length)
        obtain ⟨rfl,hyx⟩ := hex
        have : y=x := by simpa using hyx
        subst y
        exact hy
    exact aux _ hs h x rfl
  · exact SuccessfulHistory.snoc h x hh
end ActualHistory
