     (prodE (prodE (prodE (constant 3) (snd >>> snd))
        (sumE (both fst (snd >>> snd) >>> capCode) (constant 1)))
          (both fst (snd >>> snd) >>> tauCode)))
      (prodE (constant 3) (snd >>> fst))) (sumE (snd >>> snd) (constant 1))
