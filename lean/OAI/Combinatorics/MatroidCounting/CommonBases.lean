lemma controlled_boolXor : Controlled boolXor := by unfold boolXor; cc
lemma controlled_singleAt : Controlled singleAt := by unfold singleAt boolXor; cc
lemma controlled_fullAt : Controlled fullAt := by unfold fullAt; cc
lemma controlled_emptyAt : Controlled emptyAt := by unfold emptyAt; cc
lemma controlled_plainCode : Controlled plainCode := by
  have hs := controlled_singleAt
  unfold plainCode
  cc
lemma controlled_defectAt : Controlled defectAt := by
  have h₁ := controlled_singleAt
  have h₂ := controlled_fullAt
  have h₃ := controlled_emptyAt
  unfold defectAt
  cc
