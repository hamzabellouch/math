open Expression
open scoped Classical
namespace SamplerModel
lemma Bounded.mono {n : ℕ} {O : IndependenceOracle n} {m : SamplerModel n O}
    {S T : ℕ} (hm : m.Bounded S) (h : S≤T) : m.Bounded T :=
  ⟨hm.1.trans h,hm.2.1.trans h,hm.2.2.1.trans h,hm.2.2.2.1.trans h,
    hm.2.2.2.2.1.trans h,hm.2.2.2.2.2.trans h⟩
end SamplerModel
namespace Effect
def restartScope : OraclePredicate RestartState := fun n O S z =>
  ∃ (m : SamplerModel n O),m.Bounded S ∧ ∃ h : m.Hist,h.length≤S ∧
    ∃ j,j≤S ∧ ∃ x : PlainIndex (pairedSlots n),z=m.restartValue h j x
lemma restartScope_width : ∀ n O S z,restartScope n O S z → width z≤(sourceWidthPoly 200).eval S := by
  intro n O S z hz
  obtain ⟨m,hm,h,hh,j,hj,x,rfl⟩ := hz
  rw [eval_sourceWidthPoly]
  exact m.width_restartValue S hm h hh j hj x
lemma safe_traceAt : OracleSafe traceAtCode (bankScope restartScope) := by
