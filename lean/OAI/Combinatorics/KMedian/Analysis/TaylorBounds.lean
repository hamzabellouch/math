theorem a_approx_upper {X : ℝ} (ha : 0 ≤ X) (hb : X ≤ 1) :
    0 ≤ v X - aSeries X + 3/200000 - (1 / 2891116800) := by
  by_cases ht0 : X ≤ (1 / 2)
  · exact a_approx_upper_part0 ha ht0
  · have hl0 : (1 / 2) ≤ X := (lt_of_not_ge ht0).le
    exact a_approx_upper_part1 hl0 hb

