private theorem B0_1_0_nonneg_part0 {X : ℝ} (ha : 0 ≤ X) (hb : X ≤ 1) :
    0 ≤ B0 true 0 X := by
  have hu : 0 ≤ X - 0 := sub_nonneg.mpr ha
  have hv : 0 ≤ 1 - X := sub_nonneg.mpr hb
  have hcert : 0 ≤ B0 true 0 X - 0 := by
    calc
      0 ≤ 0 := by positivity
      _ = B0 true 0 X - 0 := by
