import OAI.Combinatorics.HoneycombChords.ReflectionEquation

namespace OAI

/-! Polynomial boundary fusion identities for the honeycomb strip transfer.
The fusion maps preserve the exact boundary normalization. -/

section
namespace CriticalHoneycomb.Transfer.Reflection.Fusion
open scoped Matrix
noncomputable def wNum (r : ℂ) : Matrix Pair (Fin 3) ℂ := fun p j=>
  match p.1.val,p.2.val,j.val with
  | 0,1,0 => 1
  | 1,0,0 => 1
  | 2,1,2 => 1
  | 1,2,2 => 1
  | 1,1,1 => r^2-r^14
  | 0,2,1 => -r^12
  | 2,0,1 => r^4
  | _,_,_ => 0
noncomputable def wBarNum (r : ℂ) : Matrix Pair (Fin 3) ℂ := fun p j=>
  match p.1.val,p.2.val,j.val with
  | 0,1,0 => 1
  | 1,0,0 => 1
  | 2,1,2 => 1
  | 1,2,2 => 1
  | 1,1,1 => r^2-r^14
  | 0,2,1 => r^4
  | 2,0,1 => -r^12
  | _,_,_ => 0
noncomputable def bNum (r z : ℂ) : ℂ := z*(r^3*z^2+r^13)
noncomputable def aNum (r z : ℂ) : ℂ := (r^4*z^4+r^12)*(r^6*z^4+r^10)
noncomputable def fusionL0 (r z : ℂ) : Matrix Pair (Fin 3) ℂ :=
  bNum r z • (slot2 (dConstant r (-z*r^14)) *
    ((rNumerator r (z^2) 1 * slot1 (dConstant r (z*r^2))) * wBarNum r))
noncomputable def fusionL1 (r z : ℂ) : Matrix Pair (Fin 3) ℂ :=
  bNum r z • (slot2 (dLinear r (-z*r^14)) *
    ((rNumerator r (z^2) 1 * slot1 (dConstant r (z*r^2))) * wBarNum r)+
  slot2 (dConstant r (-z*r^14)) *
    ((rNumerator r (z^2) 1 * slot1 (dLinear r (z*r^2))) * wBarNum r))
noncomputable def fusionR0 (r z : ℂ) : Matrix Pair (Fin 3) ℂ :=
  (aNum r z*bNum r (z*r^2)*bNum r (-z*r^14)) • (wNum r * dConstant r z)
noncomputable def fusionR1 (r z : ℂ) : Matrix Pair (Fin 3) ℂ :=
  (aNum r z*bNum r (z*r^2)*bNum r (-z*r^14)) • (wNum r * dLinear r z)
lemma slot2_constant_rect (r z : ℂ) (M : Matrix Pair (Fin 3) ℂ) (p : Pair) (j : Fin 3) :
    (slot2 (dConstant r z)*M) p j=dValue r z p.2*M p j := by
  classical
  simp [Matrix.mul_apply,slot2,dConstant,dValue,Fintype.sum_prod_type,ite_mul]
lemma slot2_linear_rect (r z : ℂ) (M : Matrix Pair (Fin 3) ℂ) (p : Pair) (j : Fin 3) :
    (slot2 (dLinear r z)*M) p j=
      if p.2=0 then (z^4-1)*M (p.1,1) j else
      if p.2=1 then (r^4*(z^4-1))*M (p.1,2) j else 0 := by
  classical
  rcases p with ⟨a,b⟩
  fin_cases b <;> simp [Matrix.mul_apply,slot2,dLinear,Fintype.sum_prod_type,ite_mul]
lemma core0_rect (r z : ℂ) (A : Matrix Pair Pair ℂ) (B : Matrix Pair (Fin 3) ℂ)
    (p : Pair) (j : Fin 3) :
    (A*slot1 (dConstant r z)*B) p j=∑ k,A p k*dValue r z k.1*B k j := by
  rw [Matrix.mul_apply]
  simp only [mul_slot1_constant]
lemma core1_rect (r z : ℂ) (A : Matrix Pair Pair ℂ) (B : Matrix Pair (Fin 3) ℂ)
    (p : Pair) (j : Fin 3) :
    (A*slot1 (dLinear r z)*B) p j=∑ k,
      (if k.1=1 then A p (0,k.2)*(z^4-1) else
       if k.1=2 then A p (1,k.2)*(r^4*(z^4-1)) else 0)*B k j := by
  rw [Matrix.mul_apply]
  simp only [mul_slot1_linear]
private abbrev boundaryFusionAdd (a b : ℂ) : ℂ := a+b
private abbrev boundaryFusionMul (a b : ℂ) : ℂ := a*b
private abbrev boundaryFusionPow (a : ℂ) (n : ℕ) : ℂ := a^n
