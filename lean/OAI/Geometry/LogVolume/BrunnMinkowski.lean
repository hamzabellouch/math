namespace VarianceDuality

variable {ι : Type*} [Fintype ι]

lemma quadratic_cs (a b c : ℝ) (h : ∀ t : ℝ, 0 ≤ c - 2*t*b + t^2*a) :
    b^2 ≤ a*c := by
  have hd := discrim_le_zero (a := a) (b := -2*b) (c := c) (fun t => by
    have ht := h t
    nlinarith)
  dsimp [discrim] at hd
  nlinarith

lemma weighted_coefficient_cs (a b d : ι → ℝ) (ha : ∀ i, 0 < a i) :
    (∑ i, b i * d i)^2 ≤ (∑ i, b i^2 * a i) * (∑ i, d i^2 / a i) := by
  apply quadratic_cs
  intro t
  calc
    _ = ∑ i, (d i - t * a i * b i)^2 / a i := by
      simp only [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i _
      field_simp [ne_of_gt (ha i)]
      ring
    _ ≥ 0 := Finset.sum_nonneg (fun i _ => div_nonneg (sq_nonneg _) (ha i).le)

theorem combine_energies (q E : ℝ) (a d e₁ e₂ : ι → ℝ)
    (hq : 1 < q) (ha : ∀ i, 0 < a i)
    (h₁ : ∀ i, d i ^ 2 ≤ (q * a i) * e₁ i)
    (h₂ : ∀ i, (q-1)^2 * d i^2 ≤ ((q-1) * (q*a i)) * e₂ i)
    (hE : ∑ i, (e₁ i + e₂ i) ≤ E) :
    ∑ i, d i^2 / a i ≤ E := by
  apply le_trans (Finset.sum_le_sum (fun i _ => ?_)) hE
  have hq0 : 0 < q := by linarith
  have hm : 0 < q*a i := mul_pos hq0 (ha i)
  have hqm : 0 < q-1 := by linarith
  have he₁ : d i^2 / (q*a i) ≤ e₁ i := (div_le_iff₀ hm).mpr (by nlinarith [h₁ i])
  have he₂ : (q-1)*d i^2 / (q*a i) ≤ e₂ i := by
    apply (div_le_iff₀ hm).mpr
    have hh := h₂ i
    have ht : (q-1)*((q-1)*d i^2) ≤ (q-1)*((q*a i)*e₂ i) := by nlinarith [hh]
    exact le_of_mul_le_mul_left (by simpa only [mul_comm (e₂ i) (q * a i)] using ht) hqm
  calc
    d i^2 / a i = d i^2 / (q*a i) + (q-1)*d i^2 / (q*a i) := by
      field_simp
      ring
    _ ≤ e₁ i + e₂ i := add_le_add he₁ he₂

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem extend_dual_bound (a : ι → ℝ) (ψ : ι → E) (S : Set E)
    (hS : ∀ u ∈ S, ∑ i, ⟪u, ψ i⟫_ℝ ^ 2 / a i ≤ ‖u‖^2)
    {u : E} (hu : u ∈ closure S) :
    ∑ i, ⟪u, ψ i⟫_ℝ ^ 2 / a i ≤ ‖u‖^2 := by
  have hc : IsClosed {u : E | ∑ i, ⟪u, ψ i⟫_ℝ ^ 2 / a i ≤ ‖u‖^2} := by
    apply isClosed_le
    · exact continuous_finsetSum _ (fun i _ =>
        ((continuous_id.inner continuous_const).pow 2).div_const (a i))
    · exact continuous_norm.pow 2
  exact hc.closure_subset_iff.mpr hS hu

theorem variance_from_dense_tests (a : ι → ℝ) (ha : ∀ i, 0 < a i)
    (ψ : ι → E) (S : Set E) (hSdense : Dense S)
    (hS : ∀ u ∈ S, ∑ i, ⟪u, ψ i⟫_ℝ ^ 2 / a i ≤ ‖u‖^2)
    (b : ι → ℝ) :
    ‖∑ i, b i • ψ i‖^2 ≤ ∑ i, b i^2 * a i := by
  let u : E := ∑ i, b i • ψ i
  have hdu := extend_dual_bound a ψ S hS (hSdense u)
  have hpair : (∑ i, b i * ⟪u, ψ i⟫_ℝ) = ‖u‖^2 := by
    rw [← real_inner_self_eq_norm_sq]
    change (∑ i, b i * ⟪u, ψ i⟫_ℝ) = ⟪u, ∑ i, b i • ψ i⟫_ℝ
    simp only [inner_sum, inner_smul_right]
  have hc := weighted_coefficient_cs a b (fun i => ⟪u, ψ i⟫_ℝ) ha
  rw [hpair] at hc
  have hnon : 0 ≤ ∑ i, b i^2 * a i :=
    Finset.sum_nonneg (fun i _ => mul_nonneg (sq_nonneg _) (ha i).le)
  have hh := mul_le_mul_of_nonneg_left hdu hnon
  change ‖u‖^2 ≤ _
  by_cases hu : ‖u‖^2 = 0
  · simpa only [hu] using hnon
  · have hp : 0 < ‖u‖^2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm hu)
    nlinarith

end VarianceDuality

namespace DualEnergy
open MeasureTheory Matrix WeightedCalculus MomentCoordinates MomentDifferential MomentEquation
