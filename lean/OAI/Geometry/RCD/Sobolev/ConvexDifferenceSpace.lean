import Mathlib.Analysis.Convex.Topology
import Mathlib.Tactic

namespace OAI

/-! # The vector space generated by differences of a convex set -/

open Set
noncomputable section
namespace RegularPointCoordinates
variable {E : Type*} [AddCommGroup E] [Module ℝ E]

/-- Every vector is one nonnegative multiple of a difference of two points.
This representation retains the points needed for the distance pairing. -/
def convexDifferenceSpace (K : Set E) (hK : Convex ℝ K) (h0 : 0 ∈ K) : Submodule ℝ E where
  carrier := {v | ∃ a : ℝ, 0 ≤ a ∧ ∃ x ∈ K, ∃ y ∈ K, v = a • (x-y)}
  zero_mem' := ⟨0,le_rfl,0,h0,0,h0,by simp⟩
  add_mem' := by
    rintro u v ⟨a,ha,x,hx,y,hy,rfl⟩ ⟨b,hb,z,hz,w,hw,rfl⟩
    by_cases hab : a+b=0
    · have ha0 : a=0 := by linarith
      have hb0 : b=0 := by linarith
      exact ⟨0,le_rfl,0,h0,0,h0,by simp [ha0,hb0]⟩
    have habpos : 0<a+b := lt_of_le_of_ne (add_nonneg ha hb) (Ne.symm hab)
    have ha' : 0≤a/(a+b) := div_nonneg ha habpos.le
    have hb' : 0≤b/(a+b) := div_nonneg hb habpos.le
    have hsum : a/(a+b)+b/(a+b)=1 := by rw [← add_div,div_self hab]
    refine ⟨a+b,habpos.le,(a/(a+b)) • x+(b/(a+b)) • z,hK hx hz ha' hb' hsum,
      (a/(a+b)) • y+(b/(a+b)) • w,hK hy hw ha' hb' hsum,?_⟩
    have hca : (a+b)*(a/(a+b))=a := by field_simp
    have hcb : (a+b)*(b/(a+b))=b := by field_simp
    simp only [smul_sub,smul_add,smul_smul,hca,hcb]
    module
  smul_mem' := by
    rintro c v ⟨a,ha,x,hx,y,hy,rfl⟩
    by_cases hc : 0≤c
    · exact ⟨c*a,mul_nonneg hc ha,x,hx,y,hy,by rw [mul_smul]⟩
    · refine ⟨(-c)*a,mul_nonneg (by linarith) ha,y,hy,x,hx,?_⟩
      rw [mul_smul,smul_smul,smul_sub,smul_sub]
      module

theorem mem_convexDifferenceSpace (K : Set E) (hK : Convex ℝ K) (h0 : 0 ∈ K)
    {x : E} (hx : x ∈ K) : x ∈ convexDifferenceSpace K hK h0 := by
  exact ⟨1,by norm_num,x,hx,0,h0,by simp⟩

end RegularPointCoordinates

end

end OAI
