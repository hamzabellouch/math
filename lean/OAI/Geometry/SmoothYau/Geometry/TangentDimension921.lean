instance tangentDimension921InnerProductSpace : InnerProductSpace ℝ (QuadraticInnerSpace A hA) := Matrix.toInnerProductSpace A hA.posSemidef
instance tangentDimension921FiniteDimensional : FiniteDimensional ℝ (QuadraticInnerSpace A hA) :=
  inferInstanceAs (FiniteDimensional ℝ (ι → ℝ))

