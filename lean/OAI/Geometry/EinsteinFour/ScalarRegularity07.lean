private theorem localContinuousCutoff_apply (x : V) : localContinuousCutoff x = (localContinuousBump x : ℂ) := rfl

private theorem localContinuousCutoff_support :
    tsupport (localContinuousCutoff : V → ℂ) ⊆ closedBall 0 (1 / 2) := by
