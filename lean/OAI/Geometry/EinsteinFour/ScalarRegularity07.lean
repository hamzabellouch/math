  change (localContinuousBump x : ℂ) = 1
  rw [localContinuousBump.one_of_mem_closedBall (ball_subset_closedBall hx), Complex.ofReal_one]

theorem scalar_local_H3_continuous_real_representative (u : Lp ℝ 2 (volume : Measure V))
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 3 2 (smulLeftCLM ℂ φ (scalarComplexL2 u : T))) :
    ∃ f : V → ℝ, Continuous f ∧
      (u : V → ℝ) =ᵐ[volume.restrict (ball 0 (1 / 4))] f := by
  let φ := localContinuousCutoff
  have hc : HasCompactSupport (φ : V → ℂ) :=
    (isCompact_closedBall (0 : V) (1 / 2)).of_isClosed_subset (isClosed_tsupport _) localContinuousCutoff_support
  let v := scalarL2Multiply (φ.toLp ∞ volume) (scalarComplexL2 u)
  have hv : (v : T) = smulLeftCLM ℂ φ (scalarComplexL2 u : T) := by
    dsimp [v]
    rw [SchwartzMap.toLp]
    exact scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp ∞ volume) _
  have hveq : v =ᵐ[volume] fun x => φ x * scalarComplexL2 u x := by
    change ((φ.toLp ∞ volume) • scalarComplexL2 u : Lp ℂ 2 volume) =ᵐ[volume] _
    filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) (φ.toLp ∞ volume) (scalarComplexL2 u),
      φ.coeFn_toLp ∞ volume] with x hx hφ
    simpa only [smul_eq_mul, Pi.mul_apply, hφ] using hx
  obtain ⟨f, hf, he⟩ := scalar_L2_H3_continuous_real_representative v
    (by rw [hv]; exact hreg φ hc localContinuousCutoff_support)
  refine ⟨f, hf, ?_⟩
  apply (ae_restrict_iff' isOpen_ball.measurableSet).mpr
  filter_upwards [he, hveq, scalarComplexL2_coe u] with x hx hvx hux
  intro hxB
  rw [hvx, localContinuousCutoff_one hxB, one_mul, hux, Complex.ofReal_re] at hx
  exact hx

end
end PositiveEinsteinFour.Geometry
end


section

/-! Equal local L2 representatives give equal localized distributions. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped SchwartzMap

noncomputable section

theorem scalar_localized_distribution_eq (U : Set FourSpace) (hU : MeasurableSet U)
    (u v : Lp ℝ 2 (volume : Measure FourSpace))
    (he : (u : FourSpace → ℝ) =ᵐ[volume.restrict U] v)
    (φ : 𝓢(FourSpace, ℂ)) (hs : tsupport (φ : FourSpace → ℂ) ⊆ U) :
    smulLeftCLM ℂ φ (scalarComplexL2 u : 𝓢'(FourSpace, ℂ)) =
      smulLeftCLM ℂ φ (scalarComplexL2 v : 𝓢'(FourSpace, ℂ)) := by
  ext ψ
  change (scalarComplexL2 u : 𝓢'(FourSpace, ℂ)) (SchwartzMap.smulLeftCLM ℂ φ ψ) =
    (scalarComplexL2 v : 𝓢'(FourSpace, ℂ)) (SchwartzMap.smulLeftCLM ℂ φ ψ)
  rw [Lp.toTemperedDistribution_apply, Lp.toTemperedDistribution_apply]
  apply integral_congr_ae
  filter_upwards [(ae_restrict_iff' hU).mp he, scalarComplexL2_coe u,
    scalarComplexL2_coe v] with x hx hu hv
  rw [SchwartzMap.smulLeftCLM_apply_apply φ.hasTemperateGrowth, hu, hv]
  by_cases hxU : x ∈ U
  · rw [hx hxU]
  · have hz : φ x = 0 := image_eq_zero_of_notMem_tsupport (fun ht => hxU (hs ht))
    simp only [hz, zero_smul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Bounded localization of the intrinsic scalar H¹ space into Euclidean
L⁴. The construction uses the actual chart representative and its four
weak derivatives, with a compact smooth cutoff. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped Manifold ContDiff ENNReal

noncomputable section

local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance localSobolev_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

def scalarCutoffChartC1 (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    SmoothScalar (M := M) →ₗ[ℝ] ↥(Euclidean.C1c (E := FourSpace)) where
  toFun a := ⟨fun z => χ z * a.val ((chartAt FourSpace c).symm z),
    (scalarCutoff_contDiff χ _ hχ (fun z hz =>
      scalarCoordinates_contDiffAt a.property c z (hKt (hs hz))
        (fun j => Fin.elim0 j))).of_le (by simp), hc.mul_right⟩
  map_add' a b := by
    ext z
    change χ z * (a.val _ + b.val _) = χ z * a.val _ + χ z * b.val _
    ring
  map_smul' r a := by
    ext z
    change χ z * (r * a.val _) = r * (χ z * a.val _)
    ring

omit [T3Space M] [MeasurableSpace M] [BorelSpace M] [CompactSpace M] [Nonempty M] in
theorem scalarCutoffChart_partial (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) (i : Fin 4) (z : FourSpace) :
    partialDeriv (scalarCutoffChartC1 c hKt χ hχ hc hs a).val i z =
      χ z * partialDeriv (fun w => a.val ((chartAt FourSpace c).symm w)) i z +
        partialDeriv χ i z * a.val ((chartAt FourSpace c).symm z) := by
  by_cases hz : z ∈ K
  · have ha := (scalarCoordinates_contDiffAt a.property c z (hKt hz)
      (fun j => Fin.elim0 j)).differentiableAt (by simp)
    change DifferentiableAt ℝ (fun w => a.val ((chartAt FourSpace c).symm w)) z at ha
    change partialDeriv (fun w => χ w * a.val ((chartAt FourSpace c).symm w)) i z = _
    rw [scalar_partial_product χ _ z (hχ.differentiable (by simp) z) ha]
    ring
  · have ht : z ∉ tsupport χ := fun hz' => hz (hs hz')
    have hzero : χ z = 0 := image_eq_zero_of_notMem_tsupport ht
    have hder : partialDeriv χ i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hz' => ht
        ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) hz'))
    have hproduct : partialDeriv (scalarCutoffChartC1 c hKt χ hχ hc hs a).val i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun hz' => ht
        (tsupport_mul_subset_left ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) hz')))
    rw [hproduct, hzero, hder, zero_mul, zero_mul, zero_add]

def scalarH1CutoffDerivative (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (i : Fin 4) :
    scalarH1 d →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarLocalL2ProductCLM hK.isClosed.measurableSet χ hχ.continuous hc hs).comp
      (scalarH1ChartDerivative g o d c hK hKt i) +
    (scalarLocalL2ProductCLM hK.isClosed.measurableSet (partialDeriv χ i)
      (((hχ.fderiv_right (m := ∞) (by simp)).clm_apply
        (contDiff_const (c := coordinateVector i))).continuous)
      (hc.fderiv_apply ℝ (coordinateVector i))
      ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs)).comp
      (scalarH1ChartValue g o d c hK hKt)

theorem scalarH1CutoffDerivative_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) (i : Fin 4) :
    scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i (smoothScalarToH1 d a) =
      ScalarEuclideanSobolev.partialL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a) i := by
  let P := scalarLocalL2ProductCLM hK.isClosed.measurableSet χ hχ.continuous hc hs
  let Q := scalarLocalL2ProductCLM hK.isClosed.measurableSet (partialDeriv χ i)
    (((hχ.fderiv_right (m := ∞) (by simp)).clm_apply
      (contDiff_const (c := coordinateVector i))).continuous)
    (hc.fderiv_apply ℝ (coordinateVector i))
    ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs)
  have hD : P (scalarH1ChartDerivative g o d c hK hKt i (smoothScalarToH1 d a)) =ᵐ[volume]
      (fun z => χ z * partialDeriv (fun w => a.val ((chartAt FourSpace c).symm w)) i z) := by
    rw [scalarH1ChartDerivative_smooth]
    exact (scalarLocalL2ProductCLM_coe ..).trans
      (scalarLocalL2Product_ae_congr hK.isClosed.measurableSet χ hs
        (MemLp.coeFn_toLp (scalarCoordinate_gradient_memLp g c hK hKt a i)))
  have hV : Q (scalarH1ChartValue g o d c hK hKt (smoothScalarToH1 d a)) =ᵐ[volume]
      (fun z => partialDeriv χ i z * a.val ((chartAt FourSpace c).symm z)) :=
    (scalarLocalL2ProductCLM_coe ..).trans
      (scalarLocalL2Product_ae_congr hK.isClosed.measurableSet (partialDeriv χ i)
        ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs)
        (scalarH1ChartValue_smooth g o d c hK hKt a))
  apply Lp.ext
  have hsum := Lp.coeFn_add
    (P (scalarH1ChartDerivative g o d c hK hKt i (smoothScalarToH1 d a)))
    (Q (scalarH1ChartValue g o d c hK hKt (smoothScalarToH1 d a)))
  filter_upwards [hD, hV, hsum,
    ScalarEuclideanSobolev.partialL2_coe (scalarCutoffChartC1 c hKt χ hχ hc hs a) i]
      with z hDz hVz hsz hpz
  change ((P _ + Q _) : Lp ℝ 2 (volume : Measure FourSpace)) z = _
  exact hsz.trans (by
    rw [Pi.add_apply, hDz, hVz, hpz, scalarCutoffChart_partial])

def scalarCutoffChartL4 (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) : SmoothScalar (M := M) →ₗ[ℝ] Lp ℝ 4 (volume : Measure FourSpace) :=
  ScalarEuclideanSobolev.toL4Linear.comp (scalarCutoffChartC1 c hKt χ hχ hc hs)

theorem scalarCutoffChartL4_bound (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    ∃ C : ℝ, ∀ a : SmoothScalar (M := M),
      ‖scalarCutoffChartL4 c hKt χ hχ hc hs a‖ ≤ C * ‖smoothScalarH1Map o d a‖ := by
  refine ⟨(ScalarEuclideanSobolev.constant : ℝ) *
    ∑ i : Fin 4, ‖scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i‖, fun a => ?_⟩
  have h := ScalarEuclideanSobolev.toL4_bound_partials (scalarCutoffChartC1 c hKt χ hχ hc hs a)
  calc
    _ ≤ (ScalarEuclideanSobolev.constant : ℝ) *
        ∑ i : Fin 4, ‖ScalarEuclideanSobolev.partialL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a) i‖ := h
    _ ≤ (ScalarEuclideanSobolev.constant : ℝ) *
        ∑ i : Fin 4, ‖scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i‖ *
          ‖smoothScalarH1Map o d a‖ := by
      apply mul_le_mul_of_nonneg_left _ (NNReal.coe_nonneg _)
      apply Finset.sum_le_sum
      intro i _
      rw [← scalarH1CutoffDerivative_smooth]
      exact ContinuousLinearMap.le_opNorm _ _
    _ = _ := by rw [← Finset.sum_mul, mul_assoc]

def scalarH1CutoffL4 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (_hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) : scalarH1 d →L[ℝ] Lp ℝ 4 (volume : Measure FourSpace) :=
  (scalarCutoffChartL4 c hKt χ hχ hc hs).extendOfNorm (smoothScalarH1Map o d)

theorem scalarH1CutoffL4_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) :
    scalarH1CutoffL4 g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) =
      scalarCutoffChartL4 c hKt χ hχ hc hs a :=
  LinearMap.extendOfNorm_eq (smoothScalarH1Map_dense o d)
    (scalarCutoffChartL4_bound g o d c hK hKt χ hχ hc hs) a

end
end PositiveEinsteinFour.Geometry
end


section

/-! Affine pullback of the actual L2 function preserves first-order Sobolev
regularity.  The derivative identity is proved by changing variables in
Schwartz test integrals. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)
local notation "L2" => Lp ℂ 2 (volume : Measure V)

private theorem scalarAffine_complex_integral (A : V ≃L[ℝ] V) (q : V)
    (f : V → ℂ) :
    (∫ x, f (A x + q)) = (scalarAffineJacobian A : ℂ) * ∫ x, f x := by
  have he : MeasurableEmbedding (fun x => A x + q) :=
    (A.toHomeomorph.trans (Homeomorph.addRight q)).measurableEmbedding
  rw [← he.integral_map, scalarAffine_map_volume, integral_smul_measure,
    ENNReal.toReal_ofReal (scalarAffineJacobian_pos A).le]
  simp only [Complex.real_smul]

private theorem scalarAffine_complex_memLp (A : V ≃L[ℝ] V) (q : V)
    {f : V → ℂ} (hf : MemLp f 2 (volume : Measure V)) :
    MemLp (fun x => f (A x + q)) 2 volume := by
  have hscaled := hf.smul_measure (c := ENNReal.ofReal (scalarAffineJacobian A))
    ENNReal.ofReal_ne_top
  rw [← scalarAffine_map_volume A q] at hscaled
  exact hscaled.comp_of_map (by fun_prop)

/-- Pullback of the complex L2 representative by an invertible affine map. -/
def scalarComplexAffinePullbackL2 (A : V ≃L[ℝ] V) (q : V) (u : L2) : L2 :=
  (scalarAffine_complex_memLp A q (Lp.memLp u)).toLp _

theorem scalarComplexAffinePullbackL2_coe (A : V ≃L[ℝ] V) (q : V) (u : L2) :
    scalarComplexAffinePullbackL2 A q u =ᵐ[volume] fun x => u (A x + q) :=
  MemLp.coeFn_toLp (scalarAffine_complex_memLp A q (Lp.memLp u))

/-- Inverse affine coordinates on test functions. -/
def scalarAffineTestCLM (A : V ≃L[ℝ] V) (q : V) : S →L[ℂ] S :=
  (SchwartzMap.compSubConstCLM ℂ q).comp
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A.symm)

theorem scalarAffineTestCLM_apply (A : V ≃L[ℝ] V) (q : V) (φ : S) (x : V) :
    scalarAffineTestCLM A q φ x = φ (A.symm (x - q)) := rfl

theorem scalarAffineTestCLM_derivative (A : V ≃L[ℝ] V) (q v : V) (φ : S) :
    ∂_{A v} (scalarAffineTestCLM A q φ) = scalarAffineTestCLM A q (∂_{v} φ) := by
  ext x
  change (fderiv ℝ (fun y => ((φ : V → ℂ) ∘ A.symm) (y - q)) x) (A v) =
    (fderiv ℝ φ (A.symm (x - q))) v
  rw [fderiv_comp_sub]
  change (fderiv ℝ ((φ : V → ℂ) ∘ A.symm) (x - q)) (A v) = _
  rw [_root_.fderiv_comp (x - q) φ.differentiableAt A.symm.differentiableAt,
    A.symm.fderiv]
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
    ContinuousLinearEquiv.symm_apply_apply]

/-- Distributional affine pullback, with its change-of-variables Jacobian. -/
def scalarAffineDistribution (A : V ≃L[ℝ] V) (q : V) : T →L[ℂ] T :=
  (scalarAffineJacobian A : ℂ) • PointwiseConvergenceCLM.precomp ℂ
    (scalarAffineTestCLM A q)

theorem scalarAffineDistribution_apply (A : V ≃L[ℝ] V) (q : V) (u : T) (φ : S) :
    scalarAffineDistribution A q u φ =
      (scalarAffineJacobian A : ℂ) * u (scalarAffineTestCLM A q φ) := rfl

theorem scalarAffineDistribution_L2 (A : V ≃L[ℝ] V) (q : V) (u : L2) :
    scalarAffineDistribution A q (u : T) = (scalarComplexAffinePullbackL2 A q u : T) := by
  ext φ
  rw [scalarAffineDistribution_apply, Lp.toTemperedDistribution_apply,
    Lp.toTemperedDistribution_apply]
  change (scalarAffineJacobian A : ℂ) *
    (∫ x, scalarAffineTestCLM A q φ x * u x) =
      ∫ x, φ x * scalarComplexAffinePullbackL2 A q u x
  rw [integral_congr_ae (show (fun x => φ x * scalarComplexAffinePullbackL2 A q u x) =ᵐ[volume]
      (fun x => φ x * u (A x + q)) from
    (scalarComplexAffinePullbackL2_coe A q u).mono fun x hx => congrArg (φ x * ·) hx)]
  have h := scalarAffine_complex_integral A q
    (fun x => scalarAffineTestCLM A q φ x * u x)
  simpa only [scalarAffineTestCLM_apply, add_sub_cancel_right,
    ContinuousLinearEquiv.symm_apply_apply] using h.symm

/-- The weak derivative is transformed by the actual linear part A. -/
theorem scalarAffineDistribution_derivative (A : V ≃L[ℝ] V) (q v : V) (u : T) :
    ∂_{v} (scalarAffineDistribution A q u) =
      scalarAffineDistribution A q (∂_{A v} u) := by
  ext φ
  simp only [TemperedDistribution.lineDerivOp_apply_apply,
    scalarAffineDistribution_apply, map_neg, scalarAffineTestCLM_derivative, mul_neg]

theorem scalarAffineDistribution_memSobolev_zero (A : V ≃L[ℝ] V) (q : V)
    (u : T) (hu : MemSobolev 0 2 u) :
    MemSobolev 0 2 (scalarAffineDistribution A q u) := by
  obtain ⟨f, hf⟩ := memSobolev_zero_iff.mp hu
  apply memSobolev_zero_iff.mpr
  exact ⟨scalarComplexAffinePullbackL2 A q f, hf ▸ scalarAffineDistribution_L2 A q f⟩

/-- First-order Sobolev regularity is stable under an invertible affine
change of coordinates, with no smoothness assumption on the L2 function. -/
theorem scalarAffineDistribution_memSobolev_one (A : V ≃L[ℝ] V) (q : V)
    (u : T) (hu : MemSobolev 1 2 u) :
    MemSobolev 1 2 (scalarAffineDistribution A q u) := by
  have hcriterion := scalar_memSobolev_succ_iff 0 (scalarAffineDistribution A q u)
  rw [zero_add] at hcriterion
  apply hcriterion.mpr
  refine ⟨scalarAffineDistribution_memSobolev_zero A q u (hu.mono (by norm_num)), ?_⟩
  intro i
  change MemSobolev 0 2
    (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} (scalarAffineDistribution A q u))
  rw [scalarAffineDistribution_derivative]
  exact scalarAffineDistribution_memSobolev_zero A q _
    (by simpa only [sub_self] using hu.lineDerivOp (m := A (EuclideanSpace.basisFun (Fin 4) ℝ i)))

theorem scalarComplexAffinePullbackL2_memSobolev_one (A : V ≃L[ℝ] V) (q : V)
    (u : L2) (hu : MemSobolev 1 2 (u : T)) :
    MemSobolev 1 2 (scalarComplexAffinePullbackL2 A q u : T) := by
  rw [← scalarAffineDistribution_L2]
  exact scalarAffineDistribution_memSobolev_one A q u hu

theorem scalarComplexAffinePullbackL2_ofReal (A : V ≃L[ℝ] V) (q : V)
    (u : Lp ℝ 2 (volume : Measure V)) :
    scalarComplexAffinePullbackL2 A q (scalarComplexL2 u) =
      scalarComplexL2 (scalarAffinePullbackL2 A q u) := by
  have hq : Measure.QuasiMeasurePreserving (fun x => A x + q)
      (volume : Measure V) volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  apply Lp.ext
  filter_upwards [scalarComplexAffinePullbackL2_coe A q (scalarComplexL2 u),
    scalarComplexL2_coe (scalarAffinePullbackL2 A q u),
    scalarAffinePullbackL2_coe A q u, hq.ae_eq_comp (scalarComplexL2_coe u)]
      with x h₁ h₂ h₃ h₄
  change scalarComplexL2 u (A x + q) = (u (A x + q) : ℂ) at h₄
  rw [h₁, h₄, h₂, h₃]

/-- The real L2 affine pullback has the same H1 regularity after the
canonical complexification used by the distributional elliptic theory. -/
theorem scalarAffinePullbackL2_memSobolev_one (A : V ≃L[ℝ] V) (q : V)
    (u : Lp ℝ 2 (volume : Measure V))
    (hu : MemSobolev 1 2 (scalarComplexL2 u : T)) :
    MemSobolev 1 2 (scalarComplexL2 (scalarAffinePullbackL2 A q u) : T) := by
  rw [← scalarComplexAffinePullbackL2_ofReal]
  exact scalarComplexAffinePullbackL2_memSobolev_one A q _ hu

end
end PositiveEinsteinFour.Geometry
end


section

/-! The Schwartz test operator is exactly the normalized scalar coordinate
operator, including its real and imaginary parts. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal LineDeriv Laplacian BigOperators

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "D" => scalarSchwartzCoordinateDerivative

private theorem scalar_direct_finite_algebra (κ : ℂ) (P : Mat4) (B : Fin 4 → ℝ)
    (Q : Fin 4 → Fin 4 → ℂ) (z : Fin 4 → ℂ) :
    -κ * (∑ i, Q i i) +
      (∑ i, ∑ j, (-κ * ((P i j : ℂ) - ((1 : Mat4) i j : ℂ))) * Q i j) +
      (∑ i, (-κ * (B i : ℂ)) * z i) =
    -κ * ((∑ i, ∑ j, (P i j : ℂ) * Q i j) + ∑ i, (B i : ℂ) * z i) := by
  have hid : (∑ i, ∑ j, ((1 : Mat4) i j : ℂ) * Q i j) = ∑ i, Q i i := by
    simp [Matrix.one_apply, apply_ite]
  have hsum : (∑ i, ∑ j, ((P i j : ℂ) - ((1 : Mat4) i j : ℂ)) * Q i j) =
      (∑ i, ∑ j, (P i j : ℂ) * Q i j) - ∑ i, Q i i := by
    simp_rw [sub_mul, Finset.sum_sub_distrib]
    rw [hid]
  have hsecond : (∑ i, ∑ j, (-κ * ((P i j : ℂ) - ((1 : Mat4) i j : ℂ))) * Q i j) =
      -κ * (∑ i, ∑ j, ((P i j : ℂ) - ((1 : Mat4) i j : ℂ)) * Q i j) := by
    simp only [Finset.mul_sum, mul_assoc]
  have hfirst : (∑ i, (-κ * (B i : ℂ)) * z i) = -κ * ∑ i, (B i : ℂ) * z i := by
    simp only [Finset.mul_sum, mul_assoc]
  rw [hsecond, hfirst, hsum]
  ring

/-- The normalization and identity-matrix correction recombine to the
actual principal matrix and drift at the point x. -/
theorem scalarSchwartzDirectOperator_coordinate (P : Mat4) (B : Fin 4 → ℝ)
    (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S) (φ : S) (x : V)
    (ha : ∀ i j, a i j x =
      ((-((2 * Real.pi) ^ 2)⁻¹ * (P i j - (1 : Mat4) i j) : ℝ) : ℂ))
    (hb : ∀ i, b i x = ((-((2 * Real.pi) ^ 2)⁻¹ * B i : ℝ) : ℂ)) :
    scalarSchwartzDirectOperator a b φ x - φ x =
      (-Complex.ofReal (((2 * Real.pi) ^ 2)⁻¹)) *
        ((∑ i, ∑ j, (P i j : ℂ) * D i (D j φ) x) + ∑ i, (B i : ℂ) * D i φ x) := by
  have hΔ : (Δ φ) x = ∑ i : Fin 4, D i (D i φ) x := by
    have h := congrArg (fun ψ : S => ψ x)
      (SchwartzMap.laplacian_eq_sum (EuclideanSpace.basisFun (Fin 4) ℝ) φ)
    simpa only [sum_apply, scalarSchwartzCoordinateDerivative] using h
  simp only [scalarSchwartzDirectOperator, scalarSchwartzHelmholtz,
    add_apply, sub_apply, sum_apply, smul_apply, smul_eq_mul,
    SchwartzMap.smulLeftCLM_apply_apply (a _ _).hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply (b _).hasTemperateGrowth, hΔ,
    ha, hb, Complex.ofReal_mul, Complex.ofReal_neg, Complex.ofReal_sub]
  have h := scalar_direct_finite_algebra
    (Complex.ofReal (((2 * Real.pi) ^ 2)⁻¹)) P B
    (fun i j => D i (D j φ) x) (fun i => D i φ x)
  linear_combination h

/-- Every term of the test operator is supported in the original test
support, regardless of the coefficient values outside it. -/
theorem scalarSchwartzDirectOperator_zero_off_tsupport
    (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S) (φ : S) (x : V)
    (hx : x ∉ tsupport (φ : V → ℂ)) :
    scalarSchwartzDirectOperator a b φ x - φ x = 0 := by
  have hφ : φ x = 0 := image_eq_zero_of_notMem_tsupport hx
  have hD (i : Fin 4) : D i φ x = 0 := by
    apply image_eq_zero_of_notMem_tsupport
    intro h
    exact hx ((SchwartzMap.tsupport_lineDerivOp_subset
      (EuclideanSpace.basisFun (Fin 4) ℝ i) φ) h)
  have hD2 (i j : Fin 4) : D i (D j φ) x = 0 := by
    apply image_eq_zero_of_notMem_tsupport
    intro h
    exact hx ((SchwartzMap.tsupport_lineDerivOp_subset
      (EuclideanSpace.basisFun (Fin 4) ℝ j) φ)
      ((SchwartzMap.tsupport_lineDerivOp_subset
        (EuclideanSpace.basisFun (Fin 4) ℝ i) (D j φ)) h))
  have hΔ : (Δ φ) x = 0 := by
    rw [SchwartzMap.laplacian_eq_sum (EuclideanSpace.basisFun (Fin 4) ℝ)]
    change (∑ i : Fin 4, D i (D i φ)) x = 0
    simp only [sum_apply, hD2, Finset.sum_const_zero]
  simp only [scalarSchwartzDirectOperator, scalarSchwartzHelmholtz,
    add_apply, sub_apply, sum_apply, smul_apply, smul_eq_mul,
    SchwartzMap.smulLeftCLM_apply_apply (a _ _).hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply (b _).hasTemperateGrowth,
    hφ, hD, hD2, hΔ, mul_zero, Finset.sum_const_zero, sub_zero, add_zero]

theorem scalarSchwartz_real_second_partial (L : ℂ →L[ℝ] ℝ) (φ : S)
    (i j : Fin 4) (x : V) :
    scalarPartialMatrix (L ∘ φ) x i j = L (D i (D j φ) x) := by
  have hfirst : (fun y => partialDeriv (L ∘ φ) j y) = fun y => L (D j φ y) := by
    funext y
    exact scalarSchwartz_real_partial L φ j y
  change partialDeriv (fun y => partialDeriv (L ∘ φ) j y) i x = _
  rw [hfirst]
  exact scalarSchwartz_real_partial L (D j φ) i x

private theorem scalar_real_map_mul (L : ℂ →L[ℝ] ℝ) (r : ℝ) (z : ℂ) :
    L ((r : ℂ) * z) = r * L z := by
  rw [← Complex.real_smul, L.map_smul]
  rfl

/-- Any real-linear component, in particular real or imaginary part,
recovers the ordinary real scalar principal/drift expression. -/
theorem scalarSchwartzDirectOperator_real_coordinate (L : ℂ →L[ℝ] ℝ)
    (P : Mat4) (B : Fin 4 → ℝ) (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S)
    (φ : S) (x : V)
    (ha : ∀ i j, a i j x =
      ((-((2 * Real.pi) ^ 2)⁻¹ * (P i j - (1 : Mat4) i j) : ℝ) : ℂ))
    (hb : ∀ i, b i x = ((-((2 * Real.pi) ^ 2)⁻¹ * B i : ℝ) : ℂ)) :
    L (scalarSchwartzDirectOperator a b φ x - φ x) =
      -((2 * Real.pi) ^ 2)⁻¹ *
        (scalarPrincipalContraction P (scalarPartialMatrix (L ∘ φ) x) +
          dotProduct B (scalarPartialVector (L ∘ φ) x)) := by
  rw [scalarSchwartzDirectOperator_coordinate P B a b φ x ha hb]
  rw [← Complex.ofReal_neg]
  rw [scalar_real_map_mul]
  congr 1
  simp only [map_add, map_sum, scalar_real_map_mul, scalarPrincipalContraction,
    scalarPartialMatrix, scalarPartialVector, dotProduct]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [← scalarSchwartz_real_second_partial L φ i j x]
    rfl
  · apply Finset.sum_congr rfl
    intro i _
    rw [← scalarSchwartz_real_partial L φ i x]
    rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Extract a C1 representative on the eighth ball from quarter-ball local
H4 regularity. The cutoff and its L2 realization are constructed here. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

private def quarterC1Bump : ContDiffBump (0 : V) where
  rIn := 1 / 8
  rOut := 1 / 4
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

private def quarterC1Cutoff : S :=
  (quarterC1Bump.hasCompactSupport.comp_left
    (show Complex.ofReal (0 : ℝ) = 0 by rfl)).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp quarterC1Bump.contDiff)

private theorem quarterC1Cutoff_apply (x : V) : quarterC1Cutoff x = (quarterC1Bump x : ℂ) := rfl

private theorem quarterC1Cutoff_support :
    tsupport (quarterC1Cutoff : V → ℂ) ⊆ closedBall 0 (1 / 4) := by
  have hs : Function.support (quarterC1Cutoff : V → ℂ) =
      Function.support (quarterC1Bump : V → ℝ) := by
    ext x
    simp only [Function.mem_support, quarterC1Cutoff_apply, ne_eq, Complex.ofReal_eq_zero]
  rw [tsupport, hs]
  change tsupport (quarterC1Bump : V → ℝ) ⊆ _
  rw [quarterC1Bump.tsupport_eq]
  exact Subset.refl _

private theorem quarterC1Cutoff_one {x : V} (hx : x ∈ ball 0 (1 / 8)) :
    quarterC1Cutoff x = 1 := by
  change (quarterC1Bump x : ℂ) = 1
  rw [quarterC1Bump.one_of_mem_closedBall (ball_subset_closedBall hx), Complex.ofReal_one]

theorem scalar_quarter_H4_C1_real_representative (u : Lp ℝ 2 (volume : Measure V))
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 4) →
      MemSobolev 4 2 (smulLeftCLM ℂ φ (scalarComplexL2 u : T))) :
    ∃ f : V → ℝ, ContDiff ℝ 1 f ∧
      (u : V → ℝ) =ᵐ[volume.restrict (ball 0 (1 / 8))] f := by
  let φ := quarterC1Cutoff
  have hc : HasCompactSupport (φ : V → ℂ) :=
    (isCompact_closedBall (0 : V) (1 / 4)).of_isClosed_subset (isClosed_tsupport _) quarterC1Cutoff_support
  let v := scalarL2Multiply (φ.toLp ∞ volume) (scalarComplexL2 u)
  have hv : (v : T) = smulLeftCLM ℂ φ (scalarComplexL2 u : T) := by
    dsimp [v]
    rw [SchwartzMap.toLp]
    exact scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp ∞ volume) _
  have hveq : v =ᵐ[volume] fun x => φ x * scalarComplexL2 u x := by
    change ((φ.toLp ∞ volume) • scalarComplexL2 u : Lp ℂ 2 volume) =ᵐ[volume] _
    filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) (φ.toLp ∞ volume) (scalarComplexL2 u),
      φ.coeFn_toLp ∞ volume] with x hx hφ
    simpa only [smul_eq_mul, Pi.mul_apply, hφ] using hx
  obtain ⟨f, hf, he⟩ := scalar_L2_H4_C1_real_representative v
    (by rw [hv]; exact hreg φ hc quarterC1Cutoff_support)
  refine ⟨f, hf, ?_⟩
  apply (ae_restrict_iff' isOpen_ball.measurableSet).mpr
  filter_upwards [he, hveq, scalarComplexL2_coe u] with x hx hvx hux
  intro hxB
  rw [hvx, quarterC1Cutoff_one hxB, one_mul, hux, Complex.ofReal_re] at hx
  exact hx

end
end PositiveEinsteinFour.Geometry
end


section

/-! Real smooth approximation preserving the L2 second derivatives and
L4 first derivatives of the same real H2 function. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "L4" => Lp ℝ 4 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalarSchwartz_re_derivative (f : 𝓢(V, ℂ)) (i : Fin 4) :
    D i (f.postcompCLM Complex.reCLM) =
      (scalarSchwartzCoordinateDerivative i f).postcompCLM Complex.reCLM := by
  ext x
  change (fderiv ℝ (Complex.reCLM ∘ f) x) (EuclideanSpace.basisFun (Fin 4) ℝ i) =
    Complex.reCLM ((fderiv ℝ f x) (EuclideanSpace.basisFun (Fin 4) ℝ i))
  rw [fderiv_comp x Complex.reCLM.differentiableAt f.differentiableAt, Complex.reCLM.fderiv]
  rfl

theorem scalarSchwartz_re_toLp (f : 𝓢(V, ℂ)) (p : ℝ≥0∞) :
    (f.postcompCLM Complex.reCLM).toLp p volume = Complex.reCLM.compLp (f.toLp p volume) := by
  apply Lp.ext
  filter_upwards [(f.postcompCLM Complex.reCLM).coeFn_toLp p volume,
    Complex.reCLM.coeFn_compLp (f.toLp p volume), f.coeFn_toLp p volume] with x hf hr hc
  rw [hf, hr, hc]
  rfl

/-- A real H2 function has one smooth approximating sequence controlling
all derivatives needed by the second-order nonlinear chain rule. -/
theorem scalar_real_H2_approximation (u : L2) (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) :
    ∃ (f : ℕ → S) (G : Fin 4 → L2) (G4 : Fin 4 → L4) (H : Fin 4 → Fin 4 → L2),
      (∀ i, (G i : V → ℝ) =ᵐ[volume] G4 i) ∧
      Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 u) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 2 volume) atTop (𝓝 (G i))) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 4 volume) atTop (𝓝 (G4 i))) ∧
      (∀ i j, Tendsto (fun n => (D i (D j (f n))).toLp 2 volume) atTop (𝓝 (H i j))) := by
  obtain ⟨v, f, _, hv, hG, hG4, hH⟩ := scalar_H2_schwartz_approximation (scalarComplexL2 u) hu
  let R2 := Complex.reCLM.compLpL 2 (volume : Measure V)
  let R4 := Complex.reCLM.compLpL 4 (volume : Measure V)
  have hRu : R2 (scalarComplexL2 u) = u := by
    apply Lp.ext
    filter_upwards [Complex.reCLM.coeFn_compLp (scalarComplexL2 u), scalarComplexL2_coe u]
      with x hr hu
    change Complex.reCLM.compLp (scalarComplexL2 u) x = u x
    rw [hr, hu]
    rfl
  refine ⟨fun n => (f n).postcompCLM Complex.reCLM,
    fun i => R2 (scalarBesselFirstL2 i v), fun i => R4 (scalarBesselFirstL4 i v),
    fun i j => R2 (scalarBesselSecondL2 i j v), ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    filter_upwards [Complex.reCLM.coeFn_compLp (scalarBesselFirstL2 i v),
      Complex.reCLM.coeFn_compLp (scalarBesselFirstL4 i v), scalarBesselFirstL4_coe i v]
      with x h2 h4 he
    change Complex.reCLM.compLp (scalarBesselFirstL2 i v) x =
      Complex.reCLM.compLp (scalarBesselFirstL4 i v) x
    rw [h2, h4, he]
  · simp only [scalarSchwartz_re_toLp]
    have ht := R2.continuous.continuousAt.tendsto.comp hv
    simpa only [Function.comp_def, hRu] using! ht
  · intro i
    simp only [scalarSchwartz_re_derivative, scalarSchwartz_re_toLp]
    exact R2.continuous.continuousAt.tendsto.comp (hG i)
  · intro i
    simp only [scalarSchwartz_re_derivative, scalarSchwartz_re_toLp]
    exact R4.continuous.continuousAt.tendsto.comp (hG4 i)
  · intro i j
    simp only [scalarSchwartz_re_derivative, scalarSchwartz_re_toLp]
    exact R2.continuous.continuousAt.tendsto.comp (hH i j)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The density-weighted unknown in the coordinate Poisson equation has
the same genuine local H¹ regularity as the intrinsic solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set TemperedDistribution
open scoped Manifold ContDiff _root_.Topology SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance weightedCoordinates_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

omit [T3Space M] [MeasurableSpace M] [BorelSpace M] [CompactSpace M] [Nonempty M] in
theorem scalarDensityCutoff_smooth (g : SmoothMetric M) (c : M)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target) :
    ContDiff ℝ ∞ (fun z => χ z * chartVolumeDensity g c z) :=
  scalarCutoff_contDiff χ (chartVolumeDensity g c) hχ
    (fun z hz => chartVolumeDensity_contDiffAt g c z (hs hz))

def scalarWeightedChartL2 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hs : tsupport χ ⊆ K) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  scalarLocalL2Product hK.measurableSet (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ (hs.trans hKt)).continuous
    hc.mul_right (tsupport_mul_subset_left.trans hs)
    (scalarH1ChartValue g o d c hK hKt u)

theorem scalarWeightedChartL2_memSobolev_one (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hs : tsupport χ ⊆ K) :
    MemSobolev 1 2 (scalarComplexL2 (scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs) :
      𝓢'(FourSpace, ℂ)) := by
  exact scalarH1Chart_cutoff_memSobolev_one g o d c hK hKt u
    (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ (hs.trans hKt))
    hc.mul_right (tsupport_mul_subset_left.trans hs)

theorem scalarWeightedChartL2_coe (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hs : tsupport χ ⊆ K) :
    scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs =ᵐ[volume]
      (fun z => χ z * chartVolumeDensity g c z *
        scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z)) := by
  have hb := scalarH1ChartValue_coe g o d c hK hKt u (scalarH1BaseValue g o d u)
    (scalarH1BaseValue_spec g o d u)
  have hb' := (ae_restrict_iff' hK.measurableSet).mp hb
  have he := scalarLocalL2Product_coe hK.measurableSet
    (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ (hs.trans hKt)).continuous
    hc.mul_right (tsupport_mul_subset_left.trans hs)
    (scalarH1ChartValue g o d c hK hKt u)
  filter_upwards [he, hb'] with z hz hzb
  change scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z =
    χ z * chartVolumeDensity g c z * scalarH1ChartValue g o d c hK hKt u z at hz
  rw [hz]
  by_cases h : z ∈ K
  · rw [hzb h]
  · rw [image_eq_zero_of_notMem_tsupport (fun ht => h (hs ht))]
    simp only [zero_mul]

theorem scalarWeightedChartL2_integral (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hs : tsupport χ ⊆ K) (ψ : FourSpace → ℝ) :
    (∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z * ψ z) =
      ∫ z, χ z * chartVolumeDensity g c z *
        scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) * ψ z :=
  integral_congr_ae ((scalarWeightedChartL2_coe g o d c hK hKt u χ hχ hc hs).mono
    (fun _ hz => congrArg (· * _) hz))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Second-order Sobolev regularity under the actual affine chart rescaling. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)

theorem scalarAffineDistribution_memSobolev_two (A : V ≃L[ℝ] V) (q : V)
    (u : T) (hu : MemSobolev 2 2 u) :
    MemSobolev 2 2 (scalarAffineDistribution A q u) := by
  have hcrit := scalar_memSobolev_succ_iff 1 (scalarAffineDistribution A q u)
  norm_num at hcrit
  apply hcrit.mpr
  refine ⟨scalarAffineDistribution_memSobolev_one A q u (hu.mono (by norm_num)), ?_⟩
  intro i
  change MemSobolev 1 2
    (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} (scalarAffineDistribution A q u))
  rw [scalarAffineDistribution_derivative]
  have hd := hu.lineDerivOp (m := A (EuclideanSpace.basisFun (Fin 4) ℝ i))
  norm_num at hd
  apply scalarAffineDistribution_memSobolev_one A q
  simpa only [EuclideanSpace.basisFun_apply] using hd

theorem scalarComplexAffinePullbackL2_memSobolev_two (A : V ≃L[ℝ] V) (q : V)
    (u : Lp ℂ 2 (volume : Measure V)) (hu : MemSobolev 2 2 (u : T)) :
    MemSobolev 2 2 (scalarComplexAffinePullbackL2 A q u : T) := by
  rw [← scalarAffineDistribution_L2]
  exact scalarAffineDistribution_memSobolev_two A q u hu

end
end PositiveEinsteinFour.Geometry
end


section

/-! Integer Sobolev regularity under the actual affine chart map.
All orders are needed for the smooth harmonic representative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)

theorem scalarAffineDistribution_memSobolev_integer (n : ℕ) (A : V ≃L[ℝ] V) (q : V)
    (u : T) (hu : MemSobolev (n : ℝ) 2 u) :
    MemSobolev (n : ℝ) 2 (scalarAffineDistribution A q u) := by
  induction n generalizing u with
  | zero =>
      simp only [Nat.cast_zero] at hu ⊢
      exact scalarAffineDistribution_memSobolev_zero A q u hu
  | succ n ih =>
      rw [Nat.cast_succ] at hu ⊢
      apply (scalar_memSobolev_succ_iff (n : ℝ) _).mpr
      refine ⟨ih u (hu.mono (by linarith)), ?_⟩
      intro i
      change MemSobolev (n : ℝ) 2
        (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} (scalarAffineDistribution A q u))
      rw [scalarAffineDistribution_derivative]
      apply ih
      simpa only [add_sub_cancel_right] using
        hu.lineDerivOp (m := A (EuclideanSpace.basisFun (Fin 4) ℝ i))

theorem scalarComplexAffinePullbackL2_memSobolev_integer (n : ℕ)
    (A : V ≃L[ℝ] V) (q : V) (u : Lp ℂ 2 (volume : Measure V))
    (hu : MemSobolev (n : ℝ) 2 (u : T)) :
    MemSobolev (n : ℝ) 2 (scalarComplexAffinePullbackL2 A q u : T) := by
  rw [← scalarAffineDistribution_L2]
  exact scalarAffineDistribution_memSobolev_integer n A q u hu

theorem scalarAffinePullbackL2_memSobolev_integer (n : ℕ)
    (A : V ≃L[ℝ] V) (q : V) (u : Lp ℝ 2 (volume : Measure V))
    (hu : MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T)) :
    MemSobolev (n : ℝ) 2 (scalarComplexL2 (scalarAffinePullbackL2 A q u) : T) := by
  rw [← scalarComplexAffinePullbackL2_ofReal]
  exact scalarComplexAffinePullbackL2_memSobolev_integer n A q _ hu

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual smooth chart cutoffs obtained from a finite smooth partition
of unity. Their compact supports lie in the coordinate chart targets. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Function Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def scalarChartSupport (c : M) (ρ : SmoothScalar (M := M)) : Set FourSpace :=
  (chartAt FourSpace c) '' tsupport ρ.val

omit [IsManifold I4 ∞ M] [T3Space M] in
theorem scalarChartSupport_compact (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    IsCompact (scalarChartSupport c ρ) :=
  (isClosed_tsupport ρ.val).isCompact.image_of_continuousOn ((chartAt FourSpace c).continuousOn.mono hs)

omit [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] in
theorem scalarChartSupport_subset (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    scalarChartSupport c ρ ⊆ (chartAt FourSpace c).target := by
  rintro _ ⟨x, hx, rfl⟩
  exact (chartAt FourSpace c).map_source (hs hx)

def scalarChartCutoff (c : M) (ρ : SmoothScalar (M := M)) : FourSpace → ℝ :=
  (chartAt FourSpace c).target.indicator (fun z => ρ.val ((chartAt FourSpace c).symm z))

omit [IsManifold I4 ∞ M] [T3Space M] in
theorem scalarChartCutoff_support (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    tsupport (scalarChartCutoff c ρ) ⊆ scalarChartSupport c ρ := by
  apply closure_minimal _ (scalarChartSupport_compact c ρ hs).isClosed
  intro z hz
  have hzT : z ∈ (chartAt FourSpace c).target := by
    by_contra hn
    exact hz (by simp [scalarChartCutoff, indicator_of_notMem hn])
  have hρ : ρ.val ((chartAt FourSpace c).symm z) ≠ 0 := by
    change scalarChartCutoff c ρ z ≠ 0 at hz
    simpa only [scalarChartCutoff, indicator_of_mem hzT] using hz
  exact ⟨(chartAt FourSpace c).symm z, subset_tsupport _ hρ,
    (chartAt FourSpace c).right_inv hzT⟩

omit [T3Space M] in
theorem scalarChartCutoff_smooth (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    ContDiff ℝ ∞ (scalarChartCutoff c ρ) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · have he : scalarChartCutoff c ρ =ᶠ[𝓝 z]
        (fun w => ρ.val ((chartAt FourSpace c).symm w)) := by
      filter_upwards [(chartAt FourSpace c).open_target.mem_nhds hz] with w hw
      exact indicator_of_mem hw _
    exact (scalarCoordinates_contDiffAt ρ.property c z hz (fun j => Fin.elim0 j)).congr_of_eventuallyEq he
  · have ht : z ∉ tsupport (scalarChartCutoff c ρ) :=
      fun h => hz (scalarChartSupport_subset c ρ hs (scalarChartCutoff_support c ρ hs h))
    exact contDiffAt_const.congr_of_eventuallyEq (notMem_tsupport_iff_eventuallyEq.mp ht)

omit [IsManifold I4 ∞ M] [T3Space M] in
theorem scalarChartCutoff_compact (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    HasCompactSupport (scalarChartCutoff c ρ) :=
  (scalarChartSupport_compact c ρ hs).of_isClosed_subset (isClosed_tsupport _)
    (scalarChartCutoff_support c ρ hs)

omit [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] in
theorem scalarChartCutoff_apply (c : M) (ρ : SmoothScalar (M := M))
    {x : M} (hx : x ∈ (chartAt FourSpace c).source) :
    scalarChartCutoff c ρ (chartAt FourSpace c x) = ρ.val x := by
  rw [scalarChartCutoff, indicator_of_mem ((chartAt FourSpace c).map_source hx),
    (chartAt FourSpace c).left_inv hx]

/-- A finite set of chart centers with subordinate smooth weights. -/
structure ScalarPartition (M : Type*) [TopologicalSpace M] [ChartedSpace FourSpace M] where
  centers : Finset M
  weights : SmoothPartitionOfUnity {x : M // x ∈ centers} I4 M univ
  subordinate : weights.IsSubordinate (fun x => (chartAt FourSpace x.val).source)

namespace ScalarPartition

abbrev ι (P : ScalarPartition M) := {x : M // x ∈ P.centers}

instance (P : ScalarPartition M) : Fintype P.ι := Finset.Subtype.fintype P.centers

abbrev center (P : ScalarPartition M) (i : P.ι) : M := i.val

abbrev ρ (P : ScalarPartition M) := P.weights

end ScalarPartition

theorem scalarPartition_exists : Nonempty (ScalarPartition M) := by
  have hcover : (univ : Set M) ⊆ ⋃ x : M, (chartAt FourSpace x).source := by
    intro x _
    exact mem_iUnion_of_mem x (mem_chart_source FourSpace x)
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover
    (fun x : M => (chartAt FourSpace x).source) (fun x => (chartAt FourSpace x).open_source) hcover
  have hfinite : (univ : Set M) ⊆ ⋃ x : {x : M // x ∈ s}, (chartAt FourSpace x.val).source := by
    intro x hx
    obtain ⟨c, hc, hxc⟩ := mem_iUnion₂.mp (hs hx)
    exact mem_iUnion_of_mem ⟨c, hc⟩ hxc
  obtain ⟨ρ, hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (I := I4) (s := (univ : Set M)) isClosed_univ
    (fun x : {x : M // x ∈ s} => (chartAt FourSpace x.val).source)
    (fun x => (chartAt FourSpace x.val).open_source) hfinite
  exact ⟨⟨s, ρ, hρ⟩⟩

def scalarPartitionFunction (P : ScalarPartition M) (i : P.ι) : SmoothScalar (M := M) :=
  ⟨P.ρ i, (P.ρ i).contMDiff⟩

omit [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] in
theorem scalarPartitionFunction_support (P : ScalarPartition M) (i : P.ι) :
    tsupport (scalarPartitionFunction P i).val ⊆ (chartAt FourSpace (P.center i)).source :=
  P.subordinate i

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual Euclidean value and gradient of a compact chart cutoff form
a continuous first-jet map on intrinsic scalar H¹. All L² spaces use the
existing measurable structure and Lebesgue measure of `FourSpace`. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped Manifold ContDiff ENNReal BigOperators

noncomputable section

namespace ScalarEuclideanSobolev

def valueL2 (f : ↥(Euclidean.C1c (E := FourSpace))) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  (f.property.1.continuous.memLp_of_hasCompactSupport f.property.2).toLp f.val

theorem valueL2_coe (f : ↥(Euclidean.C1c (E := FourSpace))) :
    valueL2 f =ᵐ[volume] f.val := MemLp.coeFn_toLp _

/-- Insert one scalar L² function in a Euclidean coordinate direction. -/
def coordinateL2 (i : Fin 4) :
    Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] Lp FourSpace 2 (volume : Measure FourSpace) :=
  (ContinuousLinearMap.toSpanSingleton ℝ ((EuclideanSpace.basisFun (Fin 4) ℝ) i)).compLpL 2 volume

theorem coordinateL2_coe (i : Fin 4) (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    coordinateL2 i f =ᵐ[volume]
      fun z => f z • (EuclideanSpace.basisFun (Fin 4) ℝ) i :=
  (ContinuousLinearMap.toSpanSingleton ℝ ((EuclideanSpace.basisFun (Fin 4) ℝ) i)).coeFn_compLpL f

theorem grad_eq_sum_partial (f : FourSpace → ℝ) (z : FourSpace) :
    Euclidean.grad f z =
      ∑ i : Fin 4, partialDeriv f i z • (EuclideanSpace.basisFun (Fin 4) ℝ) i := by
  have hb (i : Fin 4) :
      (EuclideanSpace.basisFun (Fin 4) ℝ) i = coordinateVector i := by
    simp [coordinateVector, EuclideanSpace.basisFun_apply]
  calc
    _ = ∑ i : Fin 4, inner ℝ ((EuclideanSpace.basisFun (Fin 4) ℝ) i)
        (Euclidean.grad f z) • (EuclideanSpace.basisFun (Fin 4) ℝ) i :=
      ((EuclideanSpace.basisFun (Fin 4) ℝ).sum_repr' _).symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i _
      congr 1
      rw [real_inner_comm, hb]
      exact InnerProductSpace.toDual_symm_apply

theorem gradientL2_eq_sum_partialL2 (f : ↥(Euclidean.C1c (E := FourSpace))) :
    gradientL2 f = ∑ i : Fin 4, coordinateL2 i (partialL2 f i) := by
  apply Lp.ext
  have hall : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ i : Fin 4,
      coordinateL2 i (partialL2 f i) z =
        partialDeriv f.val i z • (EuclideanSpace.basisFun (Fin 4) ℝ) i := by
    apply Filter.eventually_all.mpr
    intro i
    filter_upwards [coordinateL2_coe i (partialL2 f i), partialL2_coe f i] with z hc hp
    exact hc.trans (congrArg (fun r => r • (EuclideanSpace.basisFun (Fin 4) ℝ) i) hp)
  have hg : gradientL2 f =ᵐ[volume] Euclidean.grad f.val := MemLp.coeFn_toLp _
  filter_upwards [hg, hall,
    Lp.coeFn_finsetSum Finset.univ (fun i : Fin 4 => coordinateL2 i (partialL2 f i))]
      with z hgz hz hsum
  rw [hgz, hsum]
  change Euclidean.grad f.val z = ∑ i : Fin 4, coordinateL2 i (partialL2 f i) z
  simp_rw [hz]
  exact grad_eq_sum_partial f.val z

end ScalarEuclideanSobolev

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance euclideanJet_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

def scalarH1CutoffValueL2 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    scalarH1 d →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarLocalL2ProductCLM hK.isClosed.measurableSet χ hχ.continuous hc hs).comp
    (scalarH1ChartValue g o d c hK hKt)

theorem scalarH1CutoffValueL2_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) :
    scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) =
      ScalarEuclideanSobolev.valueL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a) := by
  apply Lp.ext
  have he := (scalarLocalL2ProductCLM_coe hK.isClosed.measurableSet χ hχ.continuous hc hs
      (scalarH1ChartValue g o d c hK hKt (smoothScalarToH1 d a))).trans
    (scalarLocalL2Product_ae_congr hK.isClosed.measurableSet χ hs
      (scalarH1ChartValue_smooth g o d c hK hKt a))
  filter_upwards [he,
    ScalarEuclideanSobolev.valueL2_coe (scalarCutoffChartC1 c hKt χ hχ hc hs a)]
      with z hz hv
  exact hz.trans hv.symm

/-- Assemble the four bounded weak coordinate derivative maps into the
ordinary Euclidean vector gradient. -/
def scalarH1CutoffGradientL2 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    scalarH1 d →L[ℝ] Lp FourSpace 2 (volume : Measure FourSpace) :=
  ∑ i : Fin 4, (ScalarEuclideanSobolev.coordinateL2 i).comp
    (scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i)

theorem scalarH1CutoffGradientL2_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) :
    scalarH1CutoffGradientL2 g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) =
      ScalarEuclideanSobolev.gradientL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a) := by
  rw [ScalarEuclideanSobolev.gradientL2_eq_sum_partialL2]
  simp only [scalarH1CutoffGradientL2, sum_apply,
    ContinuousLinearMap.comp_apply, scalarH1CutoffDerivative_smooth]

/-- The compact chart localization of an intrinsic scalar H¹ first jet. -/
def scalarH1CutoffJet (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    scalarH1 d →L[ℝ]
      (Lp ℝ 2 (volume : Measure FourSpace) × Lp FourSpace 2 (volume : Measure FourSpace)) :=
  (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs).prod
    (scalarH1CutoffGradientL2 g o d c hK hKt χ hχ hc hs)

theorem scalarH1CutoffJet_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : SmoothScalar (M := M)) :
    scalarH1CutoffJet g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) =
      (ScalarEuclideanSobolev.valueL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a),
        ScalarEuclideanSobolev.gradientL2 (scalarCutoffChartC1 c hKt χ hχ hc hs a)) := by
  exact Prod.ext (scalarH1CutoffValueL2_smooth g o d c hK hKt χ hχ hc hs a)
    (scalarH1CutoffGradientL2_smooth g o d c hK hKt χ hχ hc hs a)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Uniform control from the actual H3 Bessel inverse in dimension four. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "Linf" => Lp ℂ ∞ (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)



theorem scalarIntegerBesselInverse_three_memLp_top (f : L2) :
    MemLp (scalarIntegerBesselInverse 3 f : V → ℂ) ∞ volume := by
  obtain ⟨v, hv⟩ := scalar_L2_H3_boundedContinuous_representative
    (scalarIntegerBesselInverse 3 f) (scalarIntegerBesselInverse_memSobolev 3 f)
  exact (memLp_congr_ae hv).mpr v.memLp_top

private def besselThreeUniformLinear : L2 →ₗ[ℂ] Linf where
  toFun f := (scalarIntegerBesselInverse_three_memLp_top f).toLp _
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(scalarIntegerBesselInverse_three_memLp_top (f + g)).coeFn_toLp,
      (scalarIntegerBesselInverse_three_memLp_top f).coeFn_toLp,
      (scalarIntegerBesselInverse_three_memLp_top g).coeFn_toLp,
      Lp.coeFn_add (scalarIntegerBesselInverse 3 f) (scalarIntegerBesselInverse 3 g),
      Lp.coeFn_add ((scalarIntegerBesselInverse_three_memLp_top f).toLp _)
        ((scalarIntegerBesselInverse_three_memLp_top g).toLp _)] with x hfg hf hg h2 h4
    rw [hfg, h4, Pi.add_apply, hf, hg, map_add]
    exact h2
  map_smul' c f := by
    simp only [RingHom.id_apply]
    apply Lp.ext
    filter_upwards [(scalarIntegerBesselInverse_three_memLp_top (c • f)).coeFn_toLp,
      (scalarIntegerBesselInverse_three_memLp_top f).coeFn_toLp,
      Lp.coeFn_smul c (scalarIntegerBesselInverse 3 f),
      Lp.coeFn_smul c ((scalarIntegerBesselInverse_three_memLp_top f).toLp _)] with x hcf hf h2 h4
    rw [hcf, h4, Pi.smul_apply, hf, map_smul]
    exact h2

private theorem besselThreeUniformLinear_coe (f : L2) :
    (besselThreeUniformLinear f : V → ℂ) =ᵐ[volume] scalarIntegerBesselInverse 3 f :=
  (scalarIntegerBesselInverse_three_memLp_top f).coeFn_toLp

/-- Three inverse Bessel derivatives give a continuous map from L2 to L∞. -/
def scalarBesselThreeUniform : L2 →L[ℂ] Linf where
  toLinearMap := besselThreeUniformLinear
  cont := (besselThreeUniformLinear).continuous_of_seq_closed_graph (by
    intro f x y hfx hfy
    have hlow := tendstoInMeasure_of_tendsto_Lp
      ((scalarIntegerBesselInverse 3).continuous.continuousAt.tendsto.comp hfx)
    have hhigh := tendstoInMeasure_of_tendsto_Lp hfy
    have hlow' : TendstoInMeasure volume
        (fun n => (besselThreeUniformLinear (f n) : V → ℂ)) atTop
        (scalarIntegerBesselInverse 3 x : V → ℂ) :=
      hlow.congr (fun n => (besselThreeUniformLinear_coe (f n)).symm) Filter.EventuallyEq.rfl
    apply Lp.ext
    exact (tendstoInMeasure_ae_unique hhigh hlow').trans
      (besselThreeUniformLinear_coe x).symm)

theorem scalarBesselThreeUniform_coe (f : L2) :
    (scalarBesselThreeUniform f : V → ℂ) =ᵐ[volume] scalarIntegerBesselInverse 3 f :=
  besselThreeUniformLinear_coe f

end
end PositiveEinsteinFour.Geometry
end


section

/-! Explicit first and second coordinate derivatives of a compactly
localized scalar composition. These are the formulas whose terms will
converge in L2 in the nonlinear elliptic bootstrap. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem scalar_partial_scalar_comp (f : FourSpace → ℝ) (φ : ℝ → ℝ) (x : FourSpace)
    (hf : DifferentiableAt ℝ f x) (hφ : DifferentiableAt ℝ φ (f x)) (i : Fin 4) :
    partialDeriv (fun y => φ (f y)) i x = deriv φ (f x) * partialDeriv f i x := by
  have h := hφ.hasDerivAt.comp_hasFDerivAt x hf.hasFDerivAt
  have he := congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector i)) h.fderiv
  simpa only [partialDeriv, _root_.smul_apply, smul_eq_mul, Function.comp_def] using he

theorem scalar_partial_smooth (f : FourSpace → ℝ) (hf : ContDiff ℝ ∞ f) (i : Fin 4) :
    ContDiff ℝ ∞ (fun x => partialDeriv f i x) :=
  (hf.fderiv_right (m := ∞) (by simp)).clm_apply (contDiff_const (c := coordinateVector i))

theorem scalar_partial_scalar_comp_second (f : FourSpace → ℝ) (φ : ℝ → ℝ)
    (hf : ContDiff ℝ ∞ f) (hφ : ContDiff ℝ ∞ φ) (x : FourSpace) (i j : Fin 4) :
    partialDeriv (fun y => partialDeriv (fun z => φ (f z)) j y) i x =
      deriv (deriv φ) (f x) * partialDeriv f i x * partialDeriv f j x +
        deriv φ (f x) * partialDeriv (fun y => partialDeriv f j y) i x := by
  have hφ' : ContDiff ℝ ∞ (deriv φ) := (contDiff_infty_iff_deriv.mp hφ).2
  have hd := hf.differentiable (by simp)
  have he (y : FourSpace) := scalar_partial_scalar_comp f φ y hd.differentiableAt
    (hφ.differentiable (by simp)).differentiableAt j
  simp_rw [he]
  rw [scalar_partial_product (fun y => deriv φ (f y)) (fun y => partialDeriv f j y) x
    (by simpa only [Function.comp_def] using ((hφ'.comp hf).differentiable (by simp)).differentiableAt)
    ((scalar_partial_smooth f hf j).differentiable (by simp)).differentiableAt i,
    scalar_partial_scalar_comp f (deriv φ) x hd.differentiableAt
      (hφ'.differentiable (by simp)).differentiableAt i]

theorem scalar_partial_local_composition (χ f : FourSpace → ℝ) (φ : ℝ → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hf : ContDiff ℝ ∞ f) (hφ : ContDiff ℝ ∞ φ)
    (x : FourSpace) (i : Fin 4) :
    partialDeriv (fun y => χ y * φ (f y)) i x =
      partialDeriv χ i x * φ (f x) + χ x * (deriv φ (f x) * partialDeriv f i x) := by
  rw [scalar_partial_product χ (fun y => φ (f y)) x
    (hχ.differentiable (by simp)).differentiableAt
    (by simpa only [Function.comp_def] using ((hφ.comp hf).differentiable (by simp)).differentiableAt) i,
    scalar_partial_scalar_comp f φ x (hf.differentiable (by simp)).differentiableAt
      (hφ.differentiable (by simp)).differentiableAt i]

theorem scalar_partial_local_composition_second (χ f : FourSpace → ℝ) (φ : ℝ → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hf : ContDiff ℝ ∞ f) (hφ : ContDiff ℝ ∞ φ)
    (x : FourSpace) (i j : Fin 4) :
    partialDeriv (fun y => partialDeriv (fun z => χ z * φ (f z)) j y) i x =
      partialDeriv (fun y => partialDeriv χ j y) i x * φ (f x) +
      partialDeriv χ j x * (deriv φ (f x) * partialDeriv f i x) +
      partialDeriv χ i x * (deriv φ (f x) * partialDeriv f j x) +
      χ x * (deriv (deriv φ) (f x) * partialDeriv f i x * partialDeriv f j x +
        deriv φ (f x) * partialDeriv (fun y => partialDeriv f j y) i x) := by
  let F : FourSpace → ℝ := fun y => φ (f y)
  have hg : ContDiff ℝ ∞ F := by simpa only [F, Function.comp_def] using hφ.comp hf
  have hpχ := scalar_partial_smooth χ hχ j
  have hpF := scalar_partial_smooth F hg j
  have he (y : FourSpace) := scalar_partial_product χ F y
    (hχ.differentiable (by simp)).differentiableAt
    (hg.differentiable (by simp)).differentiableAt j
  change partialDeriv (fun y => partialDeriv (fun z => χ z * F z) j y) i x = _
  simp_rw [he]
  have hadd : partialDeriv (fun y => partialDeriv χ j y * F y + χ y * partialDeriv F j y) i x =
      partialDeriv (fun y => partialDeriv χ j y * F y) i x +
        partialDeriv (fun y => χ y * partialDeriv F j y) i x := by
    have he := congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector i))
      (fderiv_fun_add (x := x) ((hpχ.mul hg).differentiable (by simp)).differentiableAt
        ((hχ.mul hpF).differentiable (by simp)).differentiableAt)
    simpa only [partialDeriv, _root_.add_apply] using! he
  rw [hadd, scalar_partial_product (fun y => partialDeriv χ j y) F x
    (hpχ.differentiable (by simp)).differentiableAt
    (hg.differentiable (by simp)).differentiableAt i,
    scalar_partial_product χ (fun y => partialDeriv F j y) x
      (hχ.differentiable (by simp)).differentiableAt
      (hpF.differentiable (by simp)).differentiableAt i]
  dsimp only [F]
  rw [scalar_partial_scalar_comp_second f φ hf hφ x i j,
    scalar_partial_scalar_comp f φ x (hf.differentiable (by simp)).differentiableAt
      (hφ.differentiable (by simp)).differentiableAt i,
    scalar_partial_scalar_comp f φ x (hf.differentiable (by simp)).differentiableAt
      (hφ.differentiable (by simp)).differentiableAt j]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! A single H2 approximation sequence with pointwise convergence as well
as all the strong derivative convergences needed in scalar composition. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "L4" => Lp ℝ 4 (volume : Measure V)
local notation "S" => 𝓢(V, ℝ)
local notation "T" => 𝓢'(V, ℂ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalar_real_H2_approximation_ae (u : L2) (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) :
    ∃ (f : ℕ → S) (G : Fin 4 → L2) (G4 : Fin 4 → L4) (H : Fin 4 → Fin 4 → L2),
      (∀ᵐ x ∂(volume : Measure V), Tendsto (fun n => f n x) atTop (𝓝 (u x))) ∧
      Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 u) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 2 volume) atTop (𝓝 (G i))) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 4 volume) atTop (𝓝 (G4 i))) ∧
      (∀ i j, Tendsto (fun n => (D i (D j (f n))).toLp 2 volume) atTop (𝓝 (H i j))) := by
  obtain ⟨f, G, G4, H, _, hf, hG, hG4, hH⟩ := scalar_real_H2_approximation u hu
  obtain ⟨ns, hns, hAE⟩ := (tendstoInMeasure_of_tendsto_Lp hf).exists_seq_tendsto_ae
  refine ⟨fun n => f (ns n), G, G4, H, ?_, hf.comp hns.tendsto_atTop,
    fun i => (hG i).comp hns.tendsto_atTop, fun i => (hG4 i).comp hns.tendsto_atTop,
    fun i j => (hH i j).comp hns.tendsto_atTop⟩
  have hco : ∀ᵐ x ∂(volume : Measure V), ∀ n, (f (ns n)).toLp 2 volume x = f (ns n) x :=
    ae_all_iff.mpr (fun n => (f (ns n)).coeFn_toLp 2 volume)
  filter_upwards [hAE, hco] with x hx he
  simpa only [he] using hx

end
end PositiveEinsteinFour.Geometry
end


section

/-! Closure of the real H2 jet, using actual derivatives of real Schwartz
approximants and the complex distributional Sobolev space. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

theorem scalarSchwartz_ofReal_derivative (f : S) (i : Fin 4) :
    scalarSchwartzCoordinateDerivative i (f.postcompCLM Complex.ofRealCLM) =
      (D i f).postcompCLM Complex.ofRealCLM := by
  ext x
  change (fderiv ℝ (Complex.ofRealCLM ∘ f) x) (EuclideanSpace.basisFun (Fin 4) ℝ i) =
    Complex.ofRealCLM ((fderiv ℝ f x) (EuclideanSpace.basisFun (Fin 4) ℝ i))
  rw [fderiv_comp x Complex.ofRealCLM.differentiableAt f.differentiableAt, Complex.ofRealCLM.fderiv]
  rfl

theorem scalarSchwartz_ofReal_toLp (f : S) :
    (f.postcompCLM Complex.ofRealCLM).toLp 2 volume = scalarComplexL2 (f.toLp 2 volume) := by
  apply Lp.ext
  filter_upwards [(f.postcompCLM Complex.ofRealCLM).coeFn_toLp 2 volume,
    scalarComplexL2_coe (f.toLp 2 volume), f.coeFn_toLp 2 volume] with x hf hr hc
  rw [hf, hr, hc]
  rfl

theorem scalarSchwartz_ofReal_weak_derivative (f : S) (i : Fin 4) :
    scalarCoordinateDerivative i (scalarComplexL2 (f.toLp 2 volume) : T) =
      (scalarComplexL2 ((D i f).toLp 2 volume) : T) := by
  rw [← scalarSchwartz_ofReal_toLp, Lp.toTemperedDistribution_toLp_eq,
    ← scalarSchwartz_ofReal_toLp, Lp.toTemperedDistribution_toLp_eq]
  change (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} (f.postcompCLM Complex.ofRealCLM : T)) = _
  rw [lineDerivOp_toTemperedDistributionCLM_eq]
  exact congrArg (fun h : 𝓢(V, ℂ) => (h : T)) (scalarSchwartz_ofReal_derivative f i)

/-- Actual first and second derivative limits of one smooth real sequence
place its value limit in the real H2 Sobolev space. -/
theorem scalar_real_H2_of_strong_jets (f : ℕ → S) (u : L2)
    (g : Fin 4 → L2) (h : Fin 4 → Fin 4 → L2)
    (hf : Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 u))
    (hg : ∀ i, Tendsto (fun n => (D i (f n)).toLp 2 volume) atTop (𝓝 (g i)))
    (hh : ∀ i j, Tendsto (fun n => (D i (D j (f n))).toLp 2 volume) atTop (𝓝 (h i j))) :
    MemSobolev 2 2 (scalarComplexL2 u : T) := by
  let C := Complex.ofRealCLM.compLpL 2 (volume : Measure V)
  apply scalar_H2_of_strong_jets (fun n => scalarComplexL2 ((f n).toLp 2 volume))
    (fun i n => scalarComplexL2 ((D i (f n)).toLp 2 volume))
    (fun i j n => scalarComplexL2 ((D i (D j (f n))).toLp 2 volume))
    (scalarComplexL2 u) (fun i => scalarComplexL2 (g i)) (fun i j => scalarComplexL2 (h i j))
  · exact C.continuous.continuousAt.tendsto.comp hf
  · intro i
    exact C.continuous.continuousAt.tendsto.comp (hg i)
  · intro i j
    exact C.continuous.continuousAt.tendsto.comp (hh i j)
  · intro n i
    exact scalarSchwartz_ofReal_weak_derivative (f n) i
  · intro n i j
    exact scalarSchwartz_ofReal_weak_derivative (D j (f n)) i

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual volume almost-everywhere statements in rescaled chart coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

theorem scalar_rescaled_ae_predicate (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0)
    (P : M → Prop) (hP : ∀ᵐ x ∂normalizedVolume g, P x) :
    ∀ᵐ y ∂(volume : Measure FourSpace),
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target →
        P ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y)) := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr
  have hmp : Measure.QuasiMeasurePreserving (fun y : FourSpace => A y + z₀) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hp := hmp.ae ((ae_restrict_iff' (chartAt FourSpace c).open_target.measurableSet).mp
    (scalar_inverse_chart_ae_predicate g c P hP))
  simpa only [A, scalarRescalingLinearEquiv_apply] using hp

end
end PositiveEinsteinFour.Geometry
end


section

/-! At sufficiently small chart scales, the actual compact extensions of
the metric coefficients satisfy all Schwartz jet bounds required by the
elliptic estimate. The coefficients are constructed, not postulated. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalarRescaledDrift_contDiffAt (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (y : FourSpace)
    (hy : scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) (i : Fin 4) :
    ContDiffAt ℝ ∞ (fun z => scalarRescaledDrift g c z₀ r z i) y := by
  change ContDiffAt ℝ ∞ (fun z => r * scalarFrozenDrift g c z₀
    (scalarRescaledPoint g c z₀ r z) i) y
  apply contDiffAt_const.mul
  apply (scalarFrozenDrift_contDiffAt g c z₀ _ hy i).comp
  exact contDiffAt_const.add
    (((Matrix.toEuclideanCLM (n := Fin 4) (𝕜 := ℝ))
      (chartGramMatrix g c 1 z₀)).contDiff.contDiffAt.const_smul r)

theorem scalarRescaledPoint_compact_eventually (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) {K : Set FourSpace} (hK : IsCompact K)
    (S : Set FourSpace) (hS : S ∈ 𝓝 z₀.val) :
    ∀ᶠ r in 𝓝 (0 : ℝ), ∀ y ∈ K,
      scalarRescaledPoint g c z₀ r y ∈ S := by
  let T : Set (ℝ × FourSpace) := {q | scalarRescaledPoint g c z₀ q.1 q.2 ∈ S}
  have hcont : Continuous (fun q : ℝ × FourSpace => scalarRescaledPoint g c z₀ q.1 q.2) :=
    continuous_const.add (continuous_fst.smul
      (((Matrix.toEuclideanCLM (n := Fin 4) (𝕜 := ℝ))
        (chartGramMatrix g c 1 z₀)).continuous.comp continuous_snd))
  have htube : T ∈ 𝓝 (0 : ℝ) ×ˢ 𝓝ˢ K := by
    apply hK.mem_prod_nhdsSet_of_forall
    intro y _
    rw [← nhds_prod_eq]
    apply hcont.continuousAt
    simpa only [scalarRescaledPoint, zero_smul, add_zero] using hS
  obtain ⟨U, hU, V, hV, hUV⟩ := Filter.mem_prod_iff.mp htube
  filter_upwards [hU] with r hr y hy
  have hyV : y ∈ V := subset_of_mem_nhdsSet hV hy
  exact hUV (show (r, y) ∈ U ×ˢ V from ⟨hr, hyV⟩)

theorem scalarRescaledPoint_compact_target (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) {K : Set FourSpace} (hK : IsCompact K) :
    ∀ᶠ r in 𝓝 (0 : ℝ), ∀ y ∈ K,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
  scalarRescaledPoint_compact_eventually g c z₀ hK _
    ((chartAt FourSpace c).open_target.mem_nhds z₀.property)

theorem scalarRescaledSchwartz_small_compact (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ η : ℝ, 0 < η ∧ ∀ r : ℝ, |r| < η →
      ∃ (a : Fin 4 → Fin 4 → 𝓢(FourSpace, ℂ)) (b : Fin 4 → 𝓢(FourSpace, ℂ)),
        (∀ i j y, a i j y = (scalarCutoffPrincipal g c z₀ χ r i j y : ℂ)) ∧
        (∀ i y, b i y = (scalarCutoffDrift g c z₀ χ r i y : ℂ)) ∧
        (∀ i j y, ‖a i j y‖ ≤ δ) ∧
        (∀ i j k y, ‖scalarSchwartzCoordinateDerivative k (a i j) y‖ ≤ δ) ∧
        (∀ i j k l y, ‖scalarSchwartzCoordinateDerivative k
          (scalarSchwartzCoordinateDerivative l (a i j)) y‖ ≤ δ) ∧
        (∀ i y, ‖b i y‖ ≤ δ) ∧
        (∀ i k y, ‖scalarSchwartzCoordinateDerivative k (b i) y‖ ≤ δ) := by
  have hP : ∀ᶠ r in 𝓝 (0 : ℝ), ∀ i j y,
      |scalarCutoffPrincipal g c z₀ χ r i j y| < δ ∧
      (∀ k, |partialDeriv (scalarCutoffPrincipal g c z₀ χ r i j) k y| < δ) ∧
      (∀ k l, |partialDeriv
        (fun z => partialDeriv (scalarCutoffPrincipal g c z₀ χ r i j) l z) k y| < δ) := by
    apply eventually_all.mpr
    intro i
    apply eventually_all.mpr
    intro j
    obtain ⟨η, hη, hb⟩ := scalarCutoffPrincipal_jets_uniform g c z₀ χ hχ hc i j δ hδ
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hη] with r hr
    apply hb r
    simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr
  have hB : ∀ᶠ r in 𝓝 (0 : ℝ), ∀ i y,
      |scalarCutoffDrift g c z₀ χ r i y| < δ ∧
      (∀ k, |partialDeriv (scalarCutoffDrift g c z₀ χ r i) k y| < δ) ∧
      (∀ k l, |partialDeriv
        (fun z => partialDeriv (scalarCutoffDrift g c z₀ χ r i) l z) k y| < δ) := by
    apply eventually_all.mpr
    intro i
    obtain ⟨η, hη, hb⟩ := scalarCutoffDrift_jets_uniform g c z₀ χ hχ hc i δ hδ
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hη] with r hr
    apply hb r
    simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr
  have hT := scalarRescaledPoint_compact_target g c z₀ hc
  obtain ⟨η, hη, hball⟩ := Metric.mem_nhds_iff.mp (hP.and (hB.and hT))
  refine ⟨η, hη, ?_⟩
  intro r hr
  obtain ⟨hPr, hBr, hTr⟩ := hball
    (show r ∈ ball (0 : ℝ) η by simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr)
  let a : Fin 4 → Fin 4 → 𝓢(FourSpace, ℂ) := fun i j =>
    scalarCutoffSchwartz χ (fun y => scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j)
      hχ hc (fun y hy => (scalarRescaledPrincipal_contDiffAt g c z₀ r y (hTr y hy) i j).sub
        contDiffAt_const)
  let b : Fin 4 → 𝓢(FourSpace, ℂ) := fun i =>
    scalarCutoffSchwartz χ (fun y => scalarRescaledDrift g c z₀ r y i)
      hχ hc (fun y hy => scalarRescaledDrift_contDiffAt g c z₀ r y (hTr y hy) i)
  have ha (i j : Fin 4) := scalarCutoffSchwartz_jet_bounds χ
    (fun y => scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) hχ hc
    (fun y hy => (scalarRescaledPrincipal_contDiffAt g c z₀ r y (hTr y hy) i j).sub
      contDiffAt_const) δ
    (fun y => (hPr i j y).1.le)
    (fun k y => ((hPr i j y).2.1 k).le)
    (fun k l y => ((hPr i j y).2.2 k l).le)
  have hb (i : Fin 4) := scalarCutoffSchwartz_jet_bounds χ
    (fun y => scalarRescaledDrift g c z₀ r y i) hχ hc
    (fun y hy => scalarRescaledDrift_contDiffAt g c z₀ r y (hTr y hy) i) δ
    (fun y => (hBr i y).1.le)
    (fun k y => ((hBr i y).2.1 k).le)
    (fun k l y => ((hBr i y).2.2 k l).le)
  exact ⟨a, b, fun _ _ _ => rfl, fun _ _ => rfl, fun i j => (ha i j).1,
    fun i j => (ha i j).2.1, fun i j => (ha i j).2.2,
    fun i => (hb i).1, fun i => (hb i).2.1⟩

theorem scalarRescaledSchwartz_small (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (_hs : tsupport χ ⊆ closedBall (0 : FourSpace) 1)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ η : ℝ, 0 < η ∧ ∀ r : ℝ, |r| < η →
      ∃ (a : Fin 4 → Fin 4 → 𝓢(FourSpace, ℂ)) (b : Fin 4 → 𝓢(FourSpace, ℂ)),
        (∀ i j y, a i j y = (scalarCutoffPrincipal g c z₀ χ r i j y : ℂ)) ∧
        (∀ i y, b i y = (scalarCutoffDrift g c z₀ χ r i y : ℂ)) ∧
        (∀ i j y, ‖a i j y‖ ≤ δ) ∧
        (∀ i j k y, ‖scalarSchwartzCoordinateDerivative k (a i j) y‖ ≤ δ) ∧
        (∀ i j k l y, ‖scalarSchwartzCoordinateDerivative k
          (scalarSchwartzCoordinateDerivative l (a i j)) y‖ ≤ δ) ∧
        (∀ i y, ‖b i y‖ ≤ δ) ∧
        (∀ i k y, ‖scalarSchwartzCoordinateDerivative k (b i) y‖ ≤ δ) :=
  scalarRescaledSchwartz_small_compact g c z₀ χ hχ hc δ hδ

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual weak Poisson equation tested against compact coordinate
functions, with the volume density absorbed into the same H1 solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff _root_.Topology BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalarChartOperator_eq_zero_off_tsupport (g : SmoothMetric M) (c : M)
    (ψ : FourSpace → ℝ) {z : FourSpace} (hz : z ∉ tsupport ψ) :
    scalarChartOperator g c ψ z = 0 := by
  rw [scalarChartOperator_congr_nhds g c (notMem_tsupport_iff_eventuallyEq.mp hz)]
  simp [scalarChartOperator, partialDeriv]

variable [T3Space M] [CompactSpace M] [Nonempty M] [MeasurableSpace M] [BorelSpace M]

local instance weightedTests_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarWeightedChartL2_test_equation (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : SmoothScalar (M := M)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) f)
          (scalarH1Value d v)))
    (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψt : tsupport ψ ⊆ (chartAt FourSpace c).target)
    (hone : ∀ z ∈ tsupport ψ, χ z = 1) :
    (∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
      scalarChartOperator g c ψ z) =
      ∫ z, chartVolumeDensity g c z *
        (f.val ((chartAt FourSpace c).symm z) * ψ z) := by
  rw [scalarWeightedChartL2_integral]
  calc
    _ = ∫ z, chartVolumeDensity g c z *
        (scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) *
          scalarChartOperator g c ψ z) := by
      apply integral_congr_ae
      filter_upwards with z
      by_cases hz : z ∈ tsupport ψ
      · rw [hone z hz]
        ring
      · rw [scalarChartOperator_eq_zero_off_tsupport g c ψ hz]
        ring
    _ = ∫ z in (chartAt FourSpace c).target, chartVolumeDensity g c z *
        (scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) *
          scalarChartOperator g c ψ z) := by
      symm
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      intro z hz
      rw [scalarChartOperator_eq_zero_off_tsupport g c ψ (fun h => hz (hψt h))]
      ring
    _ = ∫ z in (chartAt FourSpace c).target, chartVolumeDensity g c z *
        (f.val ((chartAt FourSpace c).symm z) * ψ z) :=
      scalarH1_weak_coordinate_distribution g o d f u hw c ψ hψ hψc hψt
    _ = _ := by
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      intro z hz
      rw [image_eq_zero_of_notMem_tsupport (fun h => hz (hψt h))]
      ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual compactly supported scalar coordinate components of a smooth
two-form, including their ordinary product-rule derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormCutoffC1 (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) :
    SmoothH1TwoForm o →ₗ[ℝ] ↥(Euclidean.C1c (E := FourSpace)) where
  toFun u := ⟨fun z => χ z * twoFormCoordinates o (u : smoothTwoForms o).val c z a,
    (scalarCutoff_contDiff χ _ hχ (fun z hz =>
      (u : smoothTwoForms o).property.coordinates_contDiffAt c z (hKt (hs hz)) a)).of_le
        (by simp), hc.mul_right⟩
  map_add' u v := by
    ext z
    change χ z * twoFormCoordinates o
      ((u : smoothTwoForms o).val + (v : smoothTwoForms o).val) c z a = _
    rw [twoFormCoordinates_add]
    change χ z * (_ + _) = χ z * _ + χ z * _
    ring
  map_smul' r u := by
    ext z
    change χ z * twoFormCoordinates o (r • (u : smoothTwoForms o).val) c z a = _
    rw [twoFormCoordinates_smul]
    change χ z * (r * _) = r * (χ z * _)
    ring

theorem twoFormCutoffC1_partial (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) (u : SmoothH1TwoForm o)
    (i : Fin 4) (z : FourSpace) :
    partialDeriv (twoFormCutoffC1 c hKt χ hχ hc hs a u).val i z =
      χ z * partialDeriv (fun w => twoFormCoordinates o (u : smoothTwoForms o).val c w a) i z +
        partialDeriv χ i z * twoFormCoordinates o (u : smoothTwoForms o).val c z a := by
  by_cases hz : z ∈ K
  · have hu := ((u : smoothTwoForms o).property.coordinates_contDiffAt c z (hKt hz) a).differentiableAt
      (by simp)
    change partialDeriv (fun w => χ w * twoFormCoordinates o (u : smoothTwoForms o).val c w a) i z = _
    rw [scalar_partial_product χ _ z (hχ.differentiable (by simp) z) hu]
    ring
  · have ht : z ∉ tsupport χ := fun h => hz (hs h)
    have hzero : χ z = 0 := image_eq_zero_of_notMem_tsupport ht
    have hder : partialDeriv χ i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => ht ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h))
    have hp : partialDeriv (twoFormCutoffC1 c hKt χ hχ hc hs a u).val i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => ht
        (tsupport_mul_subset_left ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h)))
    rw [hp, hzero, hder, zero_mul, zero_mul, zero_add]

theorem twoFormCutoffC1_support (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) :
    tsupport (twoFormCutoffC1 c hKt χ hχ hc hs a u).val ⊆ K :=
  tsupport_mul_subset_left.trans hs

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual derivatives of a Gaussian with a smooth scalar amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators

noncomputable section

theorem fourHeatGaussian_smooth (t : ℝ) : ContDiff ℝ ∞ (fourHeatGaussian t) := by
  unfold fourHeatGaussian
  exact contDiff_const.mul ((contDiff_const.mul (contDiff_norm_sq ℝ)).exp)

theorem fourHeatGaussian_amplitude_partial (t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (i : Fin 4) (x : FourSpace) :
    partialDeriv (fun y => fourHeatGaussian t y * u y) i x =
      fourHeatGaussian t x * (partialDeriv u i x - x i / (2 * t) * u x) := by
  rw [scalar_partial_product _ _ x
    ((fourHeatGaussian_smooth t).differentiable (by simp)).differentiableAt
    (hu.differentiable (by simp)).differentiableAt i, fourHeatGaussian_partial t ht]
  ring

theorem fourHeatGaussian_amplitude_second (t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (i j : Fin 4) (x : FourSpace) :
    partialDeriv (partialDeriv (fun y => fourHeatGaussian t y * u y) i) j x =
      fourHeatGaussian t x *
        (partialDeriv (partialDeriv u i) j x -
          (x i * partialDeriv u j x + x j * partialDeriv u i x) / (2 * t) +
          (x i * x j / (4 * t ^ 2) - (if i = j then 1 else 0) / (2 * t)) * u x) := by
  have h := scalar_partial_local_composition_second (fourHeatGaussian t) u id
    (fourHeatGaussian_smooth t) hu contDiff_id x j i
  simp only [deriv_id', deriv_const', zero_mul, one_mul, id_eq] at h
  rw [h, fourHeatGaussian_partial_partial t ht,
    fourHeatGaussian_partial t ht, fourHeatGaussian_partial t ht]
  ring

theorem fourHeatGaussian_amplitude_flat (t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (x : FourSpace) :
    (∑ i : Fin 4, partialDeriv
      (partialDeriv (fun y => fourHeatGaussian t y * u y) i) i x) =
      fourHeatGaussian t x * ((∑ i : Fin 4, partialDeriv (partialDeriv u i) i x) -
        (∑ i : Fin 4, x i * partialDeriv u i x) / t +
        (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u x) := by
  simp_rw [fourHeatGaussian_amplitude_second t ht u hu]
  rw [EuclideanSpace.real_norm_sq_eq]
  simp only [Fin.sum_univ_four, ite_true]
  ring

theorem fourHeatGaussian_amplitude_time (t : ℝ) (ht : 0 < t)
    (u : FourSpace → ℝ) (x : FourSpace) :
    HasDerivAt (fun s => fourHeatGaussian s x * u x)
      (fourHeatGaussian t x * (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u x) t := by
  convert (fourHeatGaussian_hasDerivAt_time t ht x).mul_const (u x) using 1
  ring

theorem fourHeatGaussian_amplitude_residual (t : ℝ) (ht : 0 < t)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (x : FourSpace) :
    deriv (fun s => fourHeatGaussian s x * u x) t -
      (∑ i : Fin 4, partialDeriv
        (partialDeriv (fun y => fourHeatGaussian t y * u y) i) i x) =
      fourHeatGaussian t x *
        ((∑ i : Fin 4, x i * partialDeriv u i x) / t -
          ∑ i : Fin 4, partialDeriv (partialDeriv u i) i x) := by
  rw [(fourHeatGaussian_amplitude_time t ht u x).deriv,
    fourHeatGaussian_amplitude_flat t ht.ne' u hu x]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Strong L2 control of the finite coordinate jets of the Bessel inverse.
All derivatives are the actual distributional derivatives. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter LineDeriv
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)

/-- A finite ordered coordinate derivative on tempered distributions. -/
def scalarCoordinateJet : List (Fin 4) → T →L[ℂ] T
  | [] => ContinuousLinearMap.id ℂ T
  | i :: is => (lineDerivOpCLM ℂ T (EuclideanSpace.basisFun (Fin 4) ℝ i)).comp
      (scalarCoordinateJet is)

@[simp] theorem scalarCoordinateJet_nil (u : T) : scalarCoordinateJet [] u = u := rfl

@[simp] theorem scalarCoordinateJet_cons (i : Fin 4) (is : List (Fin 4)) (u : T) :
    scalarCoordinateJet (i :: is) u = scalarCoordinateDerivative i (scalarCoordinateJet is u) := rfl

theorem scalarCoordinateJet_memSobolev (is : List (Fin 4)) {s : ℝ} {u : T}
    (hu : MemSobolev s 2 u) :
    MemSobolev (s - (is.length : ℝ)) 2 (scalarCoordinateJet is u) := by
  induction is with
  | nil => simpa using hu
  | cons i is ih =>
    have h := ih.lineDerivOp (m := EuclideanSpace.basisFun (Fin 4) ℝ i)
    simpa only [scalarCoordinateJet_cons, scalarCoordinateDerivative,
      List.length_cons, Nat.cast_add, Nat.cast_one, sub_add_eq_sub_sub] using h

private theorem besselJet_exists (n : ℕ) (is : List (Fin 4))
    (hle : is.length ≤ n) (f : L2) :
    ∃ v : L2, scalarCoordinateJet is (scalarIntegerBesselInverse n f : T) = (v : T) := by
  apply memSobolev_zero_iff.mp
  exact (scalarCoordinateJet_memSobolev is (scalarIntegerBesselInverse_memSobolev n f)).mono
    (sub_nonneg.mpr (by exact_mod_cast hle))

private def besselJetLinear (n : ℕ) (is : List (Fin 4)) (hle : is.length ≤ n) : L2 →ₗ[ℂ] L2 where
  toFun f := (besselJet_exists n is hle f).choose
  map_add' f g := by
    apply scalarL2_distribution_injective
    change (((besselJet_exists n is hle (f + g)).choose) : T) = _
    rw [← (besselJet_exists n is hle (f + g)).choose_spec]
    simpa only [← Lp.toTemperedDistributionCLM_apply, map_add] using
      congrArg₂ (fun a b : T => a + b) (besselJet_exists n is hle f).choose_spec
        (besselJet_exists n is hle g).choose_spec
  map_smul' c f := by
    simp only [RingHom.id_apply]
    apply scalarL2_distribution_injective
    change (((besselJet_exists n is hle (c • f)).choose) : T) = _
    rw [← (besselJet_exists n is hle (c • f)).choose_spec]
    simpa only [← Lp.toTemperedDistributionCLM_apply, map_smul] using
      congrArg (fun a : T => c • a) (besselJet_exists n is hle f).choose_spec

private theorem besselJetLinear_distribution (n : ℕ) (is : List (Fin 4))
    (hle : is.length ≤ n) (f : L2) :
    (besselJetLinear n is hle f : T) =
      scalarCoordinateJet is (scalarIntegerBesselInverse n f : T) :=
  (besselJet_exists n is hle f).choose_spec.symm

/-- Every derivative of order at most n of the inverse n-th Bessel operator is
continuous from L2 to L2. -/
def scalarBesselJetL2 (n : ℕ) (is : List (Fin 4)) (hle : is.length ≤ n) : L2 →L[ℂ] L2 where
  toLinearMap := besselJetLinear n is hle
  cont := (besselJetLinear n is hle).continuous_of_seq_closed_graph (by
    intro f x y hfx hfy
    have hl := (scalarCoordinateJet is).continuous.continuousAt.tendsto.comp
      ((Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp
        ((scalarIntegerBesselInverse n).continuous.continuousAt.tendsto.comp hfx))
    have hr := (Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp hfy
    have heq : (y : T) = scalarCoordinateJet is (scalarIntegerBesselInverse n x : T) := by
      have hr' : Tendsto (fun k => (besselJetLinear n is hle (f k) : T)) atTop
          (𝓝 (y : T)) := by
        simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply] using hr
      have hl' : Tendsto (fun k => (besselJetLinear n is hle (f k) : T)) atTop
          (𝓝 (scalarCoordinateJet is (scalarIntegerBesselInverse n x : T))) := by
        simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply,
          besselJetLinear_distribution] using hl
      exact tendsto_nhds_unique hr' hl'
    apply scalarL2_distribution_injective
    exact heq.trans (besselJetLinear_distribution n is hle x).symm)

theorem scalarBesselJetL2_distribution (n : ℕ) (is : List (Fin 4))
    (hle : is.length ≤ n) (f : L2) :
    (scalarBesselJetL2 n is hle f : T) =
      scalarCoordinateJet is (scalarIntegerBesselInverse n f : T) :=
  besselJetLinear_distribution n is hle f

theorem scalarBesselJetL2_memSobolev (n : ℕ) (is : List (Fin 4))
    (hle : is.length ≤ n) (f : L2) :
    MemSobolev ((n : ℝ) - is.length) 2 (scalarBesselJetL2 n is hle f : T) := by
  rw [scalarBesselJetL2_distribution]
  exact scalarCoordinateJet_memSobolev is (scalarIntegerBesselInverse_memSobolev n f)

def scalarSchwartzCoordinateJet : List (Fin 4) → S →L[ℂ] S
  | [] => ContinuousLinearMap.id ℂ S
  | i :: is => (lineDerivOpCLM ℂ S (EuclideanSpace.basisFun (Fin 4) ℝ i)).comp
      (scalarSchwartzCoordinateJet is)

theorem scalarSchwartzCoordinateJet_distribution (is : List (Fin 4)) (φ : S) :
    (scalarSchwartzCoordinateJet is φ : T) = scalarCoordinateJet is (φ : T) := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    calc
      _ = scalarCoordinateDerivative i (scalarSchwartzCoordinateJet is φ : T) :=
        (lineDerivOp_toTemperedDistributionCLM_eq (scalarSchwartzCoordinateJet is φ)
          (EuclideanSpace.basisFun (Fin 4) ℝ i)).symm
      _ = _ := by rw [ih]; rfl

theorem scalarSchwartzBesselJet_toLp (n : ℕ) (is : List (Fin 4)) (hle : is.length ≤ n) (φ : S) :
    (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).toLp 2 volume =
      scalarBesselJetL2 n is hle (φ.toLp 2 volume) := by
  apply scalarL2_distribution_injective
  change ((scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).toLp 2 volume : T) =
    (scalarBesselJetL2 n is hle (φ.toLp 2 volume) : T)
  rw [Lp.toTemperedDistribution_toLp_eq, scalarSchwartzCoordinateJet_distribution,
    scalarBesselJetL2_distribution, ← scalarSchwartzIntegerBesselInverse_toLp,
    Lp.toTemperedDistribution_toLp_eq]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The distributional derivative of an actual compact C1 first jet in
four-dimensional Euclidean space. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped SchwartzMap ENNReal

noncomputable section

theorem scalarC1_weak_derivative (f : ↥(Euclidean.C1c (E := FourSpace)))
    (q : 𝓢(FourSpace, ℝ)) (i : Fin 4) :
    (∫ x, f.val x * partialDeriv q i x) = -(∫ x, partialDeriv f.val i x * q x) := by
  have hd := ScalarEuclideanSobolev.continuous_partial f.property.1 i
  have hq := ScalarEuclideanSobolev.continuous_partial (q.smooth 1) i
  exact integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    ((hd.mul q.continuous).integrable_of_hasCompactSupport
      ((f.property.2.fderiv_apply ℝ (coordinateVector i)).mul_right))
    ((f.property.1.continuous.mul hq).integrable_of_hasCompactSupport f.property.2.mul_right)
    ((f.property.1.continuous.mul q.continuous).integrable_of_hasCompactSupport f.property.2.mul_right)
    (fun x _ => f.property.1.differentiable one_ne_zero x)
    (fun x _ => q.differentiableAt)

theorem scalarC1_complex_derivative (f : ↥(Euclidean.C1c (E := FourSpace))) (i : Fin 4) :
    scalarCoordinateDerivative i
      (scalarComplexL2 (ScalarEuclideanSobolev.valueL2 f) : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 (ScalarEuclideanSobolev.partialL2 f i) : 𝓢'(FourSpace, ℂ)) := by
  apply scalarComplexL2_weak_derivative
  intro q
  have hleft : (∫ x, ScalarEuclideanSobolev.valueL2 f x * partialDeriv q i x) =
      ∫ x, f.val x * partialDeriv q i x := by
    apply integral_congr_ae
    filter_upwards [ScalarEuclideanSobolev.valueL2_coe f] with x hx
    rw [hx]
  have hright : (∫ x, ScalarEuclideanSobolev.partialL2 f i x * q x) =
      ∫ x, partialDeriv f.val i x * q x := by
    apply integral_congr_ae
    filter_upwards [ScalarEuclideanSobolev.partialL2_coe f i] with x hx
    rw [hx]
  rw [hleft, hright]
  exact scalarC1_weak_derivative f q i

def scalarGradientCoordinateL2 (i : Fin 4) :
    Lp FourSpace 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (PiLp.proj 2 (fun _ : Fin 4 => ℝ) i).compLpL 2 volume

theorem scalarGradientCoordinateL2_smooth (f : ↥(Euclidean.C1c (E := FourSpace))) (i : Fin 4) :
    scalarGradientCoordinateL2 i (ScalarEuclideanSobolev.gradientL2 f) =
      ScalarEuclideanSobolev.partialL2 f i := by
  have hc := (PiLp.proj 2 (fun _ : Fin 4 => ℝ) i : FourSpace →L[ℝ] ℝ).coeFn_compLpL
    (p := 2) (μ := (volume : Measure FourSpace)) (ScalarEuclideanSobolev.gradientL2 f)
  have hg : ScalarEuclideanSobolev.gradientL2 f =ᵐ[volume] Euclidean.grad f.val :=
    MemLp.coeFn_toLp _
  apply Lp.ext
  filter_upwards [hc, hg, ScalarEuclideanSobolev.partialL2_coe f i] with x hcx hgx hpx
  unfold scalarGradientCoordinateL2
  rw [hcx, hgx, hpx, ScalarEuclideanSobolev.grad_eq_sum_partial]
  simp [PiLp.proj_apply, EuclideanSpace.basisFun_apply, smul_eq_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual H1 coordinate jet agrees with the L4 derivatives supplied by H2. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance cutoffH2_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1CutoffDerivative_distribution (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : scalarH1 d) (i : Fin 4) :
    scalarCoordinateDerivative i
      (scalarComplexL2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u) :
        𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 (scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i u) :
        𝓢'(FourSpace, ℂ)) := by
  exact scalarLocalL2_complex_derivative hK.isClosed.measurableSet
    (scalarH1ChartValue g o d c hK hKt u)
    (scalarH1ChartDerivative g o d c hK hKt i u) i
    (fun q hq hqc hqs => scalarH1Chart_weak_derivative_integral
      g o d c hK hKt u q hq hqc hqs i) χ hχ hc hs

theorem scalarH1CutoffDerivative_memLp_four (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : scalarH1 d)
    (hH2 : MemSobolev 2 2
      (scalarComplexL2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u) :
        𝓢'(FourSpace, ℂ))) (i : Fin 4) :
    MemLp (scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i u : FourSpace → ℝ)
      4 volume := by
  obtain ⟨v, hv, hv4⟩ := scalar_H2_first_L4 _ hH2 i
  rw [scalarH1CutoffDerivative_distribution] at hv
  have he := scalarL2_distribution_injective hv
  rw [he] at hv4
  have hr : MemLp (fun x : FourSpace =>
      (scalarComplexL2 (scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i u) x).re)
      4 volume := (memLp_re_im_iff.mpr hv4).1
  apply (memLp_congr_ae ?_).mp hr
  filter_upwards [scalarComplexL2_coe
    (scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i u)] with x hx
  exact congrArg Complex.re hx

end
end PositiveEinsteinFour.Geometry
end


section

/-! Open manifold neighborhoods whose smooth cutoffs lie in the H2 chart region. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Metric
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

omit [T3Space M] in
theorem scalar_elliptic_cutoff_neighborhood (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : 0 < r) :
    ∃ U : Set M, IsOpen U ∧ (chartAt FourSpace c).symm z₀ ∈ U ∧
      U ⊆ (chartAt FourSpace c).source ∧
      ∀ ρ : SmoothScalar (M := M), tsupport ρ.val ⊆ U →
        tsupport (scalarChartCutoff c ρ) ⊆
          (scalarRescaledPoint g c z₀ r) '' closedBall 0 (1 / 2) := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let P : FourSpace ≃ₜ FourSpace := A.toHomeomorph.trans (Homeomorph.addRight z₀.val)
  have hP (y : FourSpace) : P y = scalarRescaledPoint g c z₀ r y :=
    scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
  let V : Set FourSpace := P '' ball 0 (1 / 2)
  have hV : IsOpen V := P.isOpenMap _ isOpen_ball
  let U : Set M := (chartAt FourSpace c).source ∩ (chartAt FourSpace c) ⁻¹' V
  have hU : IsOpen U := (chartAt FourSpace c).isOpen_inter_preimage hV
  have hsub : U ⊆ (chartAt FourSpace c).source := inter_subset_left
  refine ⟨U, hU, ?_, hsub, ?_⟩
  · refine ⟨(chartAt FourSpace c).map_target z₀.property, ?_⟩
    change chartAt FourSpace c ((chartAt FourSpace c).symm z₀) ∈ V
    rw [(chartAt FourSpace c).right_inv z₀.property]
    exact ⟨0, by simp, by simp [P]⟩
  · intro ρ hρ z hz
    obtain ⟨x, hx, rfl⟩ := scalarChartCutoff_support c ρ (hρ.trans hsub) hz
    obtain ⟨y, hy, he⟩ := (hρ hx).2
    exact ⟨y, ball_subset_closedBall hy, (hP y).symm.trans he⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! The ordinary continuous H¹-to-L⁴ embedding for the actual compact
four-manifold, assembled from compact chart cutoffs. No sharp constant is
asserted here. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff ENNReal

noncomputable section

local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance manifoldSobolev_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance manifoldSobolev_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def smoothScalarContinuous : SmoothScalar (M := M) →ₗ[ℝ] C(M, ℝ) where
  toFun a := ⟨a.val, a.property.continuous⟩
  map_add' a b := by ext; rfl
  map_smul' r a := by ext; rfl

def smoothScalarBaseL4 (g : SmoothMetric M) :
    SmoothScalar (M := M) →ₗ[ℝ] Lp ℝ 4 (normalizedVolume g) :=
  (ContinuousMap.toLp 4 (normalizedVolume g) ℝ).toLinearMap.comp smoothScalarContinuous

theorem smoothScalarBaseL4_coe (g : SmoothMetric M) (a : SmoothScalar (M := M)) :
    smoothScalarBaseL4 g a =ᵐ[normalizedVolume g] a.val :=
  ContinuousMap.coeFn_toLp (p := 4) (𝕜 := ℝ) (normalizedVolume g)
    (smoothScalarContinuous a)

def smoothScalarProduct (ρ a : SmoothScalar (M := M)) : SmoothScalar (M := M) :=
  ⟨fun x => ρ.val x * a.val x, ρ.property.mul a.property⟩

theorem smoothScalarPieceL4_bound (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : SmoothScalar (M := M),
      ‖smoothScalarBaseL4 g (smoothScalarProduct ρ a)‖ ≤ C * ‖smoothScalarH1Map o d a‖ := by
  let K := scalarChartSupport c ρ
  have hK : IsCompact K := scalarChartSupport_compact c ρ hs
  have hKt : K ⊆ (chartAt FourSpace c).target := scalarChartSupport_subset c ρ hs
  let χ := scalarChartCutoff c ρ
  have hχ : ContDiff ℝ ∞ χ := scalarChartCutoff_smooth c ρ hs
  have hc : HasCompactSupport χ := scalarChartCutoff_compact c ρ hs
  have hχK : tsupport χ ⊆ K := scalarChartCutoff_support c ρ hs
  obtain ⟨D, hD, hDb⟩ := scalarChart_reverse_eLpNorm_bound g c hK hKt
  obtain ⟨B, hBb⟩ := scalarCutoffChartL4_bound g o d c hK hKt χ hχ hc hχK
  let A := D ^ ((1 / (4 : ℝ≥0∞)).toReal)
  have hA : A ≠ (∞ : ℝ≥0∞) := ENNReal.rpow_ne_top_of_nonneg (by positivity) hD
  refine ⟨A.toReal * max B 0, mul_nonneg ENNReal.toReal_nonneg (le_max_right _ _), fun a => ?_⟩
  have hsupport : Function.support (smoothScalarProduct ρ a).val ⊆
      (chartAt FourSpace c).symm '' K := by
    intro x hx
    have hxρ : x ∈ tsupport ρ.val := subset_tsupport _ (left_ne_zero_of_mul hx)
    exact ⟨chartAt FourSpace c x, ⟨x, hxρ, rfl⟩, (chartAt FourSpace c).left_inv (hs hxρ)⟩
  have hlocal : (fun z => (smoothScalarProduct ρ a).val ((chartAt FourSpace c).symm z))
      =ᵐ[volume.restrict K] (scalarCutoffChartC1 c hKt χ hχ hc hχK a).val := by
    filter_upwards [ae_restrict_mem hK.isClosed.measurableSet] with z hz
    change ρ.val ((chartAt FourSpace c).symm z) * a.val ((chartAt FourSpace c).symm z) =
      χ z * a.val ((chartAt FourSpace c).symm z)
    change _ = scalarChartCutoff c ρ z * _
    rw [scalarChartCutoff, indicator_of_mem (hKt hz)]
  have hb := hDb 4 (smoothScalarProduct ρ a).val hsupport
  have hLp := ScalarEuclideanSobolev.toL4_coe (scalarCutoffChartC1 c hKt χ hχ hc hχK a)
  have he : eLpNorm (smoothScalarBaseL4 g (smoothScalarProduct ρ a)) 4 (normalizedVolume g) ≤
      A * eLpNorm (scalarCutoffChartL4 c hKt χ hχ hc hχK a) 4 volume := by
    rw [eLpNorm_congr_ae (smoothScalarBaseL4_coe g (smoothScalarProduct ρ a))]
    calc
      _ ≤ A * eLpNorm (fun z => (smoothScalarProduct ρ a).val ((chartAt FourSpace c).symm z))
          4 (volume.restrict K) := hb
      _ = A * eLpNorm (scalarCutoffChartC1 c hKt χ hχ hc hχK a).val 4
          (volume.restrict K) := by rw [eLpNorm_congr_ae hlocal]
      _ ≤ A * eLpNorm (scalarCutoffChartC1 c hKt χ hχ hc hχK a).val 4 volume :=
        mul_le_mul' le_rfl (eLpNorm_mono_measure _ Measure.restrict_le_self)
      _ = _ := by rw [← eLpNorm_congr_ae hLp]; rfl
  have hr := ENNReal.toReal_mono (ENNReal.mul_ne_top hA (Lp.eLpNorm_ne_top _)) he
  have hn : ‖smoothScalarBaseL4 g (smoothScalarProduct ρ a)‖ ≤
      A.toReal * ‖scalarCutoffChartL4 c hKt χ hχ hc hχK a‖ := by
    simpa only [Lp.norm_def, ENNReal.toReal_mul] using hr
  calc
    _ ≤ A.toReal * (B * ‖smoothScalarH1Map o d a‖) :=
      hn.trans (mul_le_mul_of_nonneg_left (hBb a) ENNReal.toReal_nonneg)
    _ ≤ A.toReal * (max B 0 * ‖smoothScalarH1Map o d a‖) := by
      gcongr
      exact le_max_left _ _
    _ = _ := by ring

omit [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] in
theorem smoothScalar_partition (P : ScalarPartition M) (a : SmoothScalar (M := M)) :
    (∑ i : P.ι, smoothScalarProduct (scalarPartitionFunction P i) a) = a := by
  apply Subtype.ext
  funext x
  have he : (∑ i : P.ι, (P.ρ i) x) = 1 := by
    simpa only [finsum_eq_sum_of_fintype] using P.ρ.sum_eq_one (mem_univ x)
  simp only [Submodule.coe_sum, Finset.sum_apply, smoothScalarProduct,
    scalarPartitionFunction, ← Finset.sum_mul, he, one_mul]

theorem smoothScalarBaseL4_bound (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : SmoothScalar (M := M),
      ‖smoothScalarBaseL4 g a‖ ≤ C * ‖smoothScalarH1Map o d a‖ := by
  obtain ⟨P⟩ := scalarPartition_exists (M := M)
  have hpiece (i : P.ι) := smoothScalarPieceL4_bound g o d (P.center i)
    (scalarPartitionFunction P i) (scalarPartitionFunction_support P i)
  choose C hC hCb using hpiece
  refine ⟨∑ i, C i, Finset.sum_nonneg (fun i _ => hC i), fun a => ?_⟩
  calc
    _ = ‖∑ i : P.ι, smoothScalarBaseL4 g (smoothScalarProduct (scalarPartitionFunction P i) a)‖ := by
      rw [← map_sum, smoothScalar_partition]
    _ ≤ ∑ i : P.ι, ‖smoothScalarBaseL4 g (smoothScalarProduct (scalarPartitionFunction P i) a)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i : P.ι, C i * ‖smoothScalarH1Map o d a‖ := Finset.sum_le_sum (fun i _ => hCb i a)
    _ = _ := (Finset.sum_mul ..).symm

def scalarH1BaseL4 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) :
    scalarH1 d →L[ℝ] Lp ℝ 4 (normalizedVolume g) :=
  (smoothScalarBaseL4 g).extendOfNorm (smoothScalarH1Map o d)

theorem scalarH1BaseL4_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (a : SmoothScalar (M := M)) :
    scalarH1BaseL4 g o d (smoothScalarToH1 d a) = smoothScalarBaseL4 g a := by
  obtain ⟨C, _, hC⟩ := smoothScalarBaseL4_bound g o d
  exact LinearMap.extendOfNorm_eq (smoothScalarH1Map_dense o d) ⟨C, hC⟩ a

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual rescaled metric coefficients satisfy the quantitative
hypotheses of the local elliptic inverse, including the adjoint drift. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Metric
open scoped Manifold ContDiff SchwartzMap LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "D" => scalarSchwartzCoordinateDerivative

def scalarEllipticEstimateConstant : ℝ :=
  16 * (2 * Real.pi) ^ 2 + 36 * (2 * Real.pi) + 20

def scalarEllipticSmallSize : ℝ := (2 * scalarEllipticEstimateConstant)⁻¹

theorem scalarEllipticEstimateConstant_pos : 0 < scalarEllipticEstimateConstant := by
  unfold scalarEllipticEstimateConstant
  positivity

theorem scalarEllipticSmallSize_pos : 0 < scalarEllipticSmallSize := by
  unfold scalarEllipticSmallSize
  exact inv_pos.mpr (mul_pos two_pos scalarEllipticEstimateConstant_pos)

theorem scalarEllipticSmallSize_small :
    (16 * (2 * Real.pi) ^ 2 + 36 * (2 * Real.pi) + 20) * scalarEllipticSmallSize < 1 := by
  change scalarEllipticEstimateConstant * (2 * scalarEllipticEstimateConstant)⁻¹ < 1
  have he : scalarEllipticEstimateConstant * (2 * scalarEllipticEstimateConstant)⁻¹ = 1 / 2 := by
    field_simp [ne_of_gt scalarEllipticEstimateConstant_pos]
  rw [he]
  norm_num

private theorem scalarScaledSchwartz_derivative (κ : ℝ) (φ : S) (i : Fin 4) :
    D i ((-κ) • φ) = (-κ) • D i φ := by
  exact LineDeriv.lineDerivOp_smul _ _ _

private theorem scalarScaledSchwartz_bound (κ ε : ℝ) (φ : S) (y : V)
    (hφ : ‖φ y‖ ≤ ε) : ‖((-κ) • φ) y‖ ≤ |κ| * ε := by
  change ‖(-κ) • φ y‖ ≤ _
  rw [norm_smul, Real.norm_eq_abs, abs_neg]
  exact mul_le_mul_of_nonneg_left hφ (abs_nonneg κ)

private theorem scalar_rescaling_budget (κ δ : ℝ) (hδ : 0 ≤ δ) :
    |κ| * (δ / (9 * (|κ| + 1))) ≤ δ / 9 := by
  have hd : 0 < |κ| + 1 := by positivity
  have he : 0 ≤ δ / (9 * (|κ| + 1)) := div_nonneg hδ (by positivity)
  calc
    _ ≤ (|κ| + 1) * (δ / (9 * (|κ| + 1))) :=
      mul_le_mul_of_nonneg_right (by linarith) he
    _ = δ / 9 := by field_simp [ne_of_gt hd]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

/-- At every sufficiently small scale, the actual normalized principal
coefficients and their actual adjoint drift obey one fixed inverse budget.
The unexpanded drift b is retained for the exact adjoint test identity. -/
theorem scalarRescaledAdjointSchwartz_small (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) :
    ∃ η : ℝ, 0 < η ∧ ∀ r : ℝ, |r| < η →
      ∃ (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S),
        (∀ i j y, a i j y =
          (-(((2 * Real.pi) ^ 2)⁻¹) : ℝ) •
            (scalarCutoffPrincipal g c z₀ χ r i j y : ℂ)) ∧
        (∀ i y, b i y =
          (-(((2 * Real.pi) ^ 2)⁻¹) : ℝ) •
            (scalarCutoffDrift g c z₀ χ r i y : ℂ)) ∧
        (∀ i j y, ‖a i j y‖ ≤ scalarEllipticSmallSize) ∧
        (∀ i j k y, ‖D k (a i j) y‖ ≤ scalarEllipticSmallSize) ∧
        (∀ i j k l y, ‖D k (D l (a i j)) y‖ ≤ scalarEllipticSmallSize) ∧
        (∀ j y, ‖scalarAdjointDrift a b j y‖ ≤ scalarEllipticSmallSize) ∧
        (∀ j k y, ‖D k (scalarAdjointDrift a b j) y‖ ≤ scalarEllipticSmallSize) := by
  let κ : ℝ := ((2 * Real.pi) ^ 2)⁻¹
  let δ : ℝ := scalarEllipticSmallSize
  let ε : ℝ := δ / (9 * (|κ| + 1))
  have hδ : 0 < δ := scalarEllipticSmallSize_pos
  have hε : 0 < ε := div_pos hδ (by positivity)
  have hbudget : |κ| * ε ≤ δ / 9 := scalar_rescaling_budget κ δ hδ.le
  have hnine : δ / 9 ≤ δ := by linarith
  obtain ⟨η, hη, hsmall⟩ := scalarRescaledSchwartz_small_compact g c z₀ χ hχ hc ε hε
  refine ⟨η, hη, ?_⟩
  intro r hr
  obtain ⟨a₀, b₀, ha₀, hb₀, ha, ha1, ha2, hb, hb1⟩ := hsmall r hr
  let a : Fin 4 → Fin 4 → S := fun i j => (-κ) • a₀ i j
  let b : Fin 4 → S := fun i => (-κ) • b₀ i
  have hA (i j : Fin 4) (y : V) : ‖a i j y‖ ≤ δ / 9 :=
    (scalarScaledSchwartz_bound κ ε (a₀ i j) y (ha i j y)).trans hbudget
  have hA1 (i j k : Fin 4) (y : V) : ‖D k (a i j) y‖ ≤ δ / 9 := by
    change ‖D k ((-κ) • a₀ i j) y‖ ≤ _
    rw [scalarScaledSchwartz_derivative]
    exact (scalarScaledSchwartz_bound κ ε (D k (a₀ i j)) y (ha1 i j k y)).trans hbudget
  have hA2 (i j k l : Fin 4) (y : V) : ‖D k (D l (a i j)) y‖ ≤ δ / 9 := by
    change ‖D k (D l ((-κ) • a₀ i j)) y‖ ≤ _
    rw [scalarScaledSchwartz_derivative, scalarScaledSchwartz_derivative]
    exact (scalarScaledSchwartz_bound κ ε (D k (D l (a₀ i j))) y
      (ha2 i j k l y)).trans hbudget
  have hB (i : Fin 4) (y : V) : ‖b i y‖ ≤ δ / 9 :=
    (scalarScaledSchwartz_bound κ ε (b₀ i) y (hb i y)).trans hbudget
  have hB1 (i k : Fin 4) (y : V) : ‖D k (b i) y‖ ≤ δ / 9 := by
    change ‖D k ((-κ) • b₀ i) y‖ ≤ _
    rw [scalarScaledSchwartz_derivative]
    exact (scalarScaledSchwartz_bound κ ε (D k (b₀ i)) y (hb1 i k y)).trans hbudget
  refine ⟨a, b, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j y
    change (-κ) • a₀ i j y = _
    rw [ha₀]
  · intro i y
    change (-κ) • b₀ i y = _
    rw [hb₀]
  · intro i j y
    exact (hA i j y).trans hnine
  · intro i j k y
    exact (hA1 i j k y).trans hnine
  · intro i j k l y
    exact (hA2 i j k l y).trans hnine
  · intro j y
    simpa only [mul_div_cancel₀ _ (by norm_num : (9 : ℝ) ≠ 0)] using
      scalarAdjointDrift_bound a b (δ / 9) hA1 hB j y
  · intro j k y
    simpa only [mul_div_cancel₀ _ (by norm_num : (9 : ℝ) ≠ 0)] using
      scalarAdjointDrift_derivative_bound a b (δ / 9) hA2 hB1 j k y

end
end PositiveEinsteinFour.Geometry
end


section

/-! Taking real parts preserves the actual second-order Sobolev space.
The proof transports a single smooth approximation and all its derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "C2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

 theorem scalar_realPart_memSobolev_two (u : C2) (hu : MemSobolev 2 2 (u : T)) :
    MemSobolev 2 2 (scalarComplexL2 (Complex.reCLM.compLp u) : T) := by
  obtain ⟨v, f, _, hf, hg, _, hh⟩ := scalar_H2_schwartz_approximation u hu
  let R := Complex.reCLM.compLpL 2 (volume : Measure V)
  apply scalar_real_H2_of_strong_jets (fun n => (f n).postcompCLM Complex.reCLM)
    (R u) (fun i => R (scalarBesselFirstL2 i v))
    (fun i j => R (scalarBesselSecondL2 i j v))
  · simp only [scalarSchwartz_re_toLp]
    exact R.continuous.continuousAt.tendsto.comp hf
  · intro i
    simp only [scalarSchwartz_re_derivative, scalarSchwartz_re_toLp]
    exact R.continuous.continuousAt.tendsto.comp (hg i)
  · intro i j
    simp only [scalarSchwartz_re_derivative, scalarSchwartz_re_toLp]
    exact R.continuous.continuousAt.tendsto.comp (hh i j)

theorem scalar_real_H2_realization (u : C2) (hu : MemSobolev 2 2 (u : T))
    (b : V → ℝ) (hb : (u : V → ℂ) =ᵐ[volume] fun x => (b x : ℂ)) :
    ∃ v : Lp ℝ 2 (volume : Measure V), MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] b := by
  refine ⟨Complex.reCLM.compLp u, scalar_realPart_memSobolev_two u hu, ?_⟩
  filter_upwards [Complex.reCLM.coeFn_compLp u, hb] with x hr hx
  rw [hr, hx]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Fixed real Schwartz multipliers on L2 and actual compact localizations
of a smooth scalar composition. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped SchwartzMap ENNReal ContDiff LineDeriv NNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "S" => 𝓢(V, ℝ)

def scalarRealSchwartzMultiply (a : S) : L2 →L[ℝ] L2 :=
  scalarL2BoundedMultiplier a a.continuous.aestronglyMeasurable
    (C := SchwartzMap.seminorm ℝ 0 0 a) (fun x => by
      simpa only [Real.norm_eq_abs] using SchwartzMap.norm_le_seminorm ℝ a x)

theorem scalarRealSchwartzMultiply_coe (a : S) (f : L2) :
    scalarRealSchwartzMultiply a f =ᵐ[volume] fun x => a x * f x :=
  scalarL2BoundedMultiplier_coe _ _ _ f

def scalarLocalizedCompose (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) (f : S) : S :=
  hc.mul_right.toSchwartzMap ((χ.smooth' : ContDiff ℝ ∞ χ).mul (hφ.comp f.smooth'))

theorem scalarLocalizedCompose_apply (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) (f : S) (x : V) :
    scalarLocalizedCompose χ hc φ hφ f x = χ x * φ (f x) := rfl

theorem scalarLocalizedCompose_valueLp (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) {C : ℝ≥0} (hLip : LipschitzWith C φ)
    (hzero : φ 0 = 0) (f : S) :
    (scalarLocalizedCompose χ hc φ hφ f).toLp 2 volume =
      scalarRealSchwartzMultiply χ (hLip.compLp hzero (f.toLp 2 volume)) := by
  apply Lp.ext
  filter_upwards [(scalarLocalizedCompose χ hc φ hφ f).coeFn_toLp 2 volume,
    scalarRealSchwartzMultiply_coe χ (hLip.compLp hzero (f.toLp 2 volume)),
    hLip.coeFn_compLp hzero (f.toLp 2 volume), f.coeFn_toLp 2 volume]
      with x hs hm hp hf
  rw [hs, hm, hp, Function.comp_apply, hf]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth finite partitions subordinate to the actual small elliptic neighborhoods. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem scalarPartition_subordinate_neighborhoods (U : M → Set M)
    (hU : ∀ x, IsOpen (U x)) (hxU : ∀ x, x ∈ U x)
    (hchart : ∀ x, U x ⊆ (chartAt FourSpace x).source) :
    ∃ P : ScalarPartition M, ∀ i : P.ι,
      tsupport (scalarPartitionFunction P i).val ⊆ U (P.center i) := by
  have hcover : (univ : Set M) ⊆ ⋃ x : M, U x := by
    intro x _
    exact mem_iUnion_of_mem x (hxU x)
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover U hU hcover
  have hfinite : (univ : Set M) ⊆ ⋃ x : {x : M // x ∈ s}, U x.val := by
    intro x hx
    obtain ⟨c, hc, hxc⟩ := mem_iUnion₂.mp (hs hx)
    exact mem_iUnion_of_mem ⟨c, hc⟩ hxc
  obtain ⟨ρ, hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (I := I4) (s := (univ : Set M)) isClosed_univ
    (fun x : {x : M // x ∈ s} => U x.val) (fun x => hU x.val) hfinite
  let P : ScalarPartition M := ⟨s, ρ, fun i => (hρ i).trans (hchart i.val)⟩
  exact ⟨P, hρ⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Compactness of each compact chart localization of the intrinsic scalar
H¹ space. The actual first jet lies in the closed Euclidean graph, with
support in the fixed compact set, so Euclidean Rellich applies. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped Manifold ContDiff ENNReal

noncomputable section

local instance : MeasurableSpace FourSpace := borel FourSpace
local instance : BorelSpace FourSpace := ⟨rfl⟩
local instance : MeasureSpace FourSpace := measureSpaceOfInnerProductSpace

theorem scalarBorel_valueL2 (f : ↥(Euclidean.C1c (E := FourSpace))) :
    scalarBorelLpEquiv ℝ 2 (ScalarEuclideanSobolev.valueL2 f) =
      Euclidean.toL2 (μ := (volume : Measure FourSpace)) f := by
  apply Lp.ext
  exact (scalarBorelLpEquiv_ae ℝ 2 _ _ (ScalarEuclideanSobolev.valueL2_coe f)).trans
    (MemLp.coeFn_toLp _).symm

theorem scalarBorel_gradientL2 (f : ↥(Euclidean.C1c (E := FourSpace))) :
    scalarBorelLpEquiv FourSpace 2 (ScalarEuclideanSobolev.gradientL2 f) =
      Euclidean.toL2Grad (μ := (volume : Measure FourSpace)) f := by
  apply Lp.ext
  exact (scalarBorelLpEquiv_ae FourSpace 2 _ _ (MemLp.coeFn_toLp _)).trans
    (MemLp.coeFn_toLp _).symm

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance rellichLocalization_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
  {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K)

def scalarH1BorelCutoffJet :
    scalarH1 d →L[ℝ] Euclidean.H1Target (μ := (volume : Measure FourSpace)) :=
  ((scalarBorelLpEquiv ℝ 2).toContinuousLinearEquiv.toContinuousLinearMap.comp
    (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs)).prod
  ((scalarBorelLpEquiv FourSpace 2).toContinuousLinearEquiv.toContinuousLinearMap.comp
    (scalarH1CutoffGradientL2 g o d c hK hKt χ hχ hc hs))

theorem scalarH1BorelCutoffJet_smooth (a : SmoothScalar (M := M)) :
    scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) =
      Euclidean.graph (μ := (volume : Measure FourSpace))
        (scalarCutoffChartC1 c hKt χ hχ hc hs a) := by
  apply Prod.ext
  · change scalarBorelLpEquiv ℝ 2
      (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a)) = _
    rw [scalarH1CutoffValueL2_smooth, scalarBorel_valueL2]
    rfl
  · change scalarBorelLpEquiv FourSpace 2
      (scalarH1CutoffGradientL2 g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a)) = _
    rw [scalarH1CutoffGradientL2_smooth, scalarBorel_gradientL2]
    rfl

theorem scalarH1BorelCutoffJet_mem (u : scalarH1 d) :
    scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs u ∈
      Euclidean.h1 (μ := (volume : Measure FourSpace)) := by
  refine (smoothScalarH1Map_dense o d).induction_on
    (p := fun v => scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs v ∈
      Euclidean.h1 (μ := (volume : Measure FourSpace))) u ?_ ?_
  · exact (Euclidean.isClosed_h1 (μ := (volume : Measure FourSpace))).preimage
      (scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs).continuous
  · intro a
    change scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs (smoothScalarToH1 d a) ∈ _
    rw [scalarH1BorelCutoffJet_smooth]
    exact Submodule.le_topologicalClosure _ ⟨_, rfl⟩

def scalarH1CutoffEuclideanH1 :
    scalarH1 d →L[ℝ] ↥(Euclidean.h1 (μ := (volume : Measure FourSpace))) :=
  (scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs).codRestrict _
    (scalarH1BorelCutoffJet_mem g o d c hK hKt χ hχ hc hs)

theorem scalarH1CutoffEuclideanH1_supported (u : scalarH1 d) :
    scalarH1CutoffEuclideanH1 g o d c hK hKt χ hχ hc hs u ∈
      Euclidean.h1On K hK.isClosed.measurableSet := by
  refine (smoothScalarH1Map_dense o d).induction_on
    (p := fun v => scalarH1CutoffEuclideanH1 g o d c hK hKt χ hχ hc hs v ∈
      Euclidean.h1On K hK.isClosed.measurableSet) u ?_ ?_
  · exact (Euclidean.isClosed_range_extendByZero K hK.isClosed.measurableSet).preimage
      ((Euclidean.h1ToL2 (μ := (volume : Measure FourSpace))).comp
        (scalarH1CutoffEuclideanH1 g o d c hK hKt χ hχ hc hs)).continuous
  · intro a
    change (scalarH1BorelCutoffJet g o d c hK hKt χ hχ hc hs
      (smoothScalarToH1 d a)).1 ∈
        LinearMap.range ((Lp.extendByZeroₗᵢ
          (μ := (volume : Measure FourSpace)) (E := ℝ) (p := 2)
          (s := K) hK.isClosed.measurableSet).toLinearMap)
    rw [scalarH1BorelCutoffJet_smooth]
    exact Euclidean.mem_range_extendByZeroₗᵢ_toLp_of_tsupport_subset
      (μ := (volume : Measure FourSpace)) hK.isClosed.measurableSet
      (scalarCutoffChartC1 c hKt χ hχ hc hs a).val
      (Euclidean.memLp_of_mem_C1c (μ := (volume : Measure FourSpace))
        (scalarCutoffChartC1 c hKt χ hχ hc hs a).property)
      ((tsupport_mul_subset_left).trans hs)

def scalarH1CutoffSupportedH1 :
    scalarH1 d →L[ℝ] ↥(Euclidean.h1On K hK.isClosed.measurableSet) :=
  (scalarH1CutoffEuclideanH1 g o d c hK hKt χ hχ hc hs).codRestrict _
    (scalarH1CutoffEuclideanH1_supported g o d c hK hKt χ hχ hc hs)

/-- Compactness of a fixed chart cutoff, in the original Lebesgue L² space. -/
theorem scalarH1CutoffValueL2_compact :
    IsCompactOperator (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs) := by
  have h := (Euclidean.isCompactOperator_h1OnToL2 hK hK.isClosed.measurableSet).comp_clm
    (scalarH1CutoffSupportedH1 g o d c hK hKt χ hχ hc hs)
  have h' := h.clm_comp
    (scalarBorelLpEquiv ℝ 2).symm.toContinuousLinearEquiv.toContinuousLinearMap
  convert h' using 1
  funext u
  change scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u =
    (scalarBorelLpEquiv ℝ 2).symm
      (scalarBorelLpEquiv ℝ 2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u))
  exact ((scalarBorelLpEquiv ℝ 2).symm_apply_apply _).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The same weighted H1 representative satisfies the actual geometric
equation after the invertible frozen-frame change of coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff BigOperators

noncomputable section

theorem scalarAffineL2_integral (A : FourSpace ≃L[ℝ] FourSpace) (q : FourSpace)
    (w : Lp ℝ 2 (volume : Measure FourSpace)) (ψ : FourSpace → ℝ) :
    (∫ y, scalarAffinePullbackL2 A q w y * ψ y) =
      scalarAffineJacobian A * ∫ z, w z * ψ (A.symm (z - q)) := by
  rw [integral_congr_ae ((scalarAffinePullbackL2_coe A q w).mono
    (fun y hy => congrArg (· * ψ y) hy))]
  have h := scalarAffine_integral A q (fun z => w z * ψ (A.symm (z - q)))
  simpa only [add_sub_cancel_right, ContinuousLinearEquiv.symm_apply_apply] using h

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance rescaledTests_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarRescaled_test_equation (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : SmoothScalar (M := M)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) f)
          (scalarH1Value d v)))
    (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψt : ∀ y ∈ tsupport ψ,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (hone : ∀ y ∈ tsupport ψ, χ (scalarRescaledPoint g c z₀ r y) = 1) :
    (∫ y, scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
        (scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs) y *
          scalarRescaledOperator g c z₀ r ψ y) =
      ∫ y, r ^ 2 * chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
        f.val ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y)) * ψ y := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr
  let ψ₀ : FourSpace → ℝ := fun z => ψ (A.symm (z - z₀))
  have hp : ContDiff ℝ ∞ ψ₀ :=
    hψ.comp (A.symm.contDiff.comp (contDiff_id.sub contDiff_const))
  have hpc : HasCompactSupport ψ₀ := by
    have h := hψc.comp_homeomorph
      ((Homeomorph.addRight (-z₀.val)).trans A.symm.toHomeomorph)
    change HasCompactSupport (fun z => ψ (A.symm (z + -z₀.val))) at h
    simpa only [ψ₀, sub_eq_add_neg] using h
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr]
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hps {z : FourSpace} (hz : z ∈ tsupport ψ₀) : A.symm (z - z₀) ∈ tsupport ψ :=
    tsupport_comp_subset_preimage (f := fun z => A.symm (z - z₀)) ψ (by fun_prop) hz
  have hpt : tsupport ψ₀ ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have h := hψt _ (hps hz)
    rwa [hinv] at h
  have hpo : ∀ z ∈ tsupport ψ₀, χ z = 1 := by
    intro z hz
    have h := hone _ (hps hz)
    rwa [hinv] at h
  have heq := scalarWeightedChartL2_test_equation g o d f u hw c hK hKt
    χ hχ hc hs ψ₀ hp hpc hpt hpo
  have hop (z : FourSpace) : scalarRescaledOperator g c z₀ r ψ (A.symm (z - z₀)) =
      r ^ 2 * scalarChartOperator g c ψ₀ z := by
    have h := scalarRescaledOperator_eq_chart g c z₀ r hr ψ hψ (A.symm (z - z₀))
    rw [hinv] at h
    exact h.symm
  rw [scalarAffineL2_integral]
  change scalarAffineJacobian A * (∫ z, _ * scalarRescaledOperator g c z₀ r ψ
    (A.symm (z - z₀))) = _
  simp_rw [hop]
  have hmul : (∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
      (r ^ 2 * scalarChartOperator g c ψ₀ z)) =
      r ^ 2 * ∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
        scalarChartOperator g c ψ₀ z := by
    rw [← integral_const_mul]
    congr 1
    funext z
    ring
  rw [hmul, heq]
  have hsource := scalarAffine_integral A z₀.val (fun z =>
    chartVolumeDensity g c z * (f.val ((chartAt FourSpace c).symm z) * ψ₀ z))
  have htest (y : FourSpace) : ψ₀ (A y + z₀) = ψ y := by
    simp only [ψ₀, add_sub_cancel_right, A.symm_apply_apply]
  change (∫ y, chartVolumeDensity g c (A y + z₀) *
    (f.val ((chartAt FourSpace c).symm (A y + z₀)) * ψ₀ (A y + z₀))) = _ at hsource
  have hpoint (y : FourSpace) : A y + z₀ = scalarRescaledPoint g c z₀ r y :=
    scalarRescalingLinearEquiv_apply g c z₀ r hr y
  have htest' (y : FourSpace) : ψ₀ (scalarRescaledPoint g c z₀ r y) = ψ y := by
    rw [← hpoint, htest]
  simp only [hpoint, htest'] at hsource
  rw [mul_left_comm (scalarAffineJacobian A) (r ^ 2), ← hsource,
    ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with y
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The second coordinate product rule needs only local C2 regularity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter
open scoped ContDiff _root_.Topology

noncomputable section

theorem scalar_partial_second_product_at (f u : FourSpace → ℝ) (x : FourSpace)
    (hf : ContDiffAt ℝ 2 f x) (hu : ContDiffAt ℝ 2 u x) (i j : Fin 4) :
    partialDeriv (partialDeriv (fun y => f y * u y) i) j x =
      partialDeriv (partialDeriv f i) j x * u x +
      partialDeriv f i x * partialDeriv u j x +
      partialDeriv f j x * partialDeriv u i x +
      f x * partialDeriv (partialDeriv u i) j x := by
  have hfd : DifferentiableAt ℝ f x := hf.differentiableAt (by norm_num)
  have hud : DifferentiableAt ℝ u x := hu.differentiableAt (by norm_num)
  have hfpi : DifferentiableAt ℝ (partialDeriv f i) x :=
    ((hf.fderiv_right (m := 1) (by norm_num)).clm_apply
      (contDiffAt_const (c := coordinateVector i))).differentiableAt one_ne_zero
  have hupi : DifferentiableAt ℝ (partialDeriv u i) x :=
    ((hu.fderiv_right (m := 1) (by norm_num)).clm_apply
      (contDiffAt_const (c := coordinateVector i))).differentiableAt one_ne_zero
  have heq : partialDeriv (fun y => f y * u y) i =ᶠ[𝓝 x]
      (fun y => partialDeriv f i y * u y + f y * partialDeriv u i y) := by
    filter_upwards [hf.eventually (by norm_num), hu.eventually (by norm_num)] with y hfy huy
    exact scalar_partial_product f u y
      (hfy.differentiableAt (by norm_num)) (huy.differentiableAt (by norm_num)) i
  change fderiv ℝ (partialDeriv (fun y => f y * u y) i) x (coordinateVector j) = _
  have hadd := fderiv_fun_add (hfpi.mul hud) (hfd.mul hupi)
  change fderiv ℝ (fun y => partialDeriv f i y * u y + f y * partialDeriv u i y) x =
    fderiv ℝ (partialDeriv f i * u) x + fderiv ℝ (f * partialDeriv u i) x at hadd
  rw [heq.fderiv_eq, hadd, fderiv_mul hfpi hud, fderiv_mul hfd hupi]
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul, partialDeriv]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Returning an actual H2 scalar from normalized coordinates to its chart. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℂ 2 (volume : Measure V)

theorem scalar_H2_unscale (A : V ≃L[ℝ] V) (q : V) (b χ : V → ℝ)
    (v : L2) (hv2 : MemSobolev 2 2 (v : 𝓢'(V, ℂ)))
    (hv : (v : V → ℂ) =ᵐ[volume] fun y => (χ y * b (A y + q) : ℝ)) :
    ∃ w : L2, MemSobolev 2 2 (w : 𝓢'(V, ℂ)) ∧
      (w : V → ℂ) =ᵐ[volume] fun z => (χ (A.symm (z - q)) * b z : ℝ) := by
  let w := scalarComplexAffinePullbackL2 A.symm (-A.symm q) v
  refine ⟨w, scalarComplexAffinePullbackL2_memSobolev_two _ _ v hv2, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving (fun z : V => A.symm z + (-A.symm q))
      volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  filter_upwards [scalarComplexAffinePullbackL2_coe A.symm (-A.symm q) v,
    hmp.ae_eq_comp hv] with z hz he
  dsimp only [Function.comp_apply] at he
  rw [hz]
  change v (A.symm z + (-A.symm q)) = _ at he
  rw [he]
  simp only [map_add, ContinuousLinearEquiv.apply_symm_apply, map_neg,
    neg_add_cancel_right]
  rw [map_sub]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undoing the affine normalization at the finite orders needed for
smooth harmonic representatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)
local notation "L2" => Lp ℂ 2 (volume : Measure V)

theorem scalar_integer_unscale (n : ℕ) (A : V ≃L[ℝ] V) (q : V) (b χ : V → ℝ)
    (v : L2) (hv2 : MemSobolev (n : ℝ) 2 (v : T))
    (hv : (v : V → ℂ) =ᵐ[volume] fun y => (χ y * b (A y + q) : ℝ)) :
    ∃ w : L2, MemSobolev (n : ℝ) 2 (w : T) ∧
      (w : V → ℂ) =ᵐ[volume] fun z => (χ (A.symm (z - q)) * b z : ℝ) := by
  let w := scalarComplexAffinePullbackL2 A.symm (-A.symm q) v
  refine ⟨w, scalarComplexAffinePullbackL2_memSobolev_integer n _ _ v hv2, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving (fun z : V => A.symm z + (-A.symm q))
      volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  filter_upwards [scalarComplexAffinePullbackL2_coe A.symm (-A.symm q) v,
    hmp.ae_eq_comp hv] with z hz he
  dsimp only [Function.comp_apply] at he
  rw [hz]
  change v (A.symm z + (-A.symm q)) = _ at he
  rw [he]
  simp only [map_add, ContinuousLinearEquiv.apply_symm_apply, map_neg,
    neg_add_cancel_right]
  rw [map_sub]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual weak Poisson equation tested against compact coordinate
functions, with the volume density absorbed into the same H1 solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff _root_.Topology BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

variable [T3Space M] [CompactSpace M] [Nonempty M] [MeasurableSpace M] [BorelSpace M]

local instance weightedL2Tests_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarWeightedChartL2_L2_test_equation (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f)
          (scalarH1Value d v)))
    (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψt : tsupport ψ ⊆ (chartAt FourSpace c).target)
    (hone : ∀ z ∈ tsupport ψ, χ z = 1) :
    (∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
      scalarChartOperator g c ψ z) =
      ∫ z, chartVolumeDensity g c z *
        (f ((chartAt FourSpace c).symm z) * ψ z) := by
  rw [scalarWeightedChartL2_integral]
  calc
    _ = ∫ z, chartVolumeDensity g c z *
        (scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) *
          scalarChartOperator g c ψ z) := by
      apply integral_congr_ae
      filter_upwards with z
      by_cases hz : z ∈ tsupport ψ
      · rw [hone z hz]
        ring
      · rw [scalarChartOperator_eq_zero_off_tsupport g c ψ hz]
        ring
    _ = ∫ z in (chartAt FourSpace c).target, chartVolumeDensity g c z *
        (scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) *
          scalarChartOperator g c ψ z) := by
      symm
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      intro z hz
      rw [scalarChartOperator_eq_zero_off_tsupport g c ψ (fun h => hz (hψt h))]
      ring
    _ = ∫ z in (chartAt FourSpace c).target, chartVolumeDensity g c z *
        (f ((chartAt FourSpace c).symm z) * ψ z) :=
      scalarH1_L2_weak_coordinate_distribution g o d f u hw c ψ hψ hψc hψt
    _ = _ := by
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      intro z hz
      rw [image_eq_zero_of_notMem_tsupport (fun h => hz (hψt h))]
      ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Uniform first-jet bounds for each compact chart cutoff of a two-form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormCutoffC1_control (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (u : SmoothH1TwoForm o) (a : Fin 2 → Fin 4) (z : FourSpace), z ∈ K →
      |(twoFormCutoffC1 c hKt χ hχ hc hs a u).val z| ≤
        B * twoFormControl (u : smoothTwoForms o) ((chartAt FourSpace c).symm z) ∧
      ∀ i : Fin 4, |partialDeriv (twoFormCutoffC1 c hKt χ hχ hc hs a u).val i z| ≤
        B * twoFormControl (u : smoothTwoForms o) ((chartAt FourSpace c).symm z) := by
  obtain ⟨A, hA, hAb⟩ := twoFormChart_compact_control g o c hK hKt
  let J : FourSpace → ℝ := fun z => |χ z| + ∑ i : Fin 4, |partialDeriv χ i z|
  have hJ : Continuous J := hχ.continuous.abs.add
    (continuous_finsetSum _ (fun i _ =>
      (((hχ.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const).continuous).abs))
  obtain ⟨D₀, hD₀⟩ := (hK.image hJ).isBounded.exists_norm_le
  let D := max D₀ 0
  have hD : 0 ≤ D := le_max_right _ _
  have hj (z : FourSpace) (hz : z ∈ K) : J z ≤ D :=
    (le_abs_self _).trans ((hD₀ _ ⟨z, hz, rfl⟩).trans (le_max_left _ _))
  have hval (z : FourSpace) (hz : z ∈ K) : |χ z| ≤ D :=
    (le_add_of_nonneg_right (Finset.sum_nonneg (fun _ _ => abs_nonneg _))).trans (hj z hz)
  have hder (z : FourSpace) (hz : z ∈ K) (i : Fin 4) : |partialDeriv χ i z| ≤ D := by
    have hi : |partialDeriv χ i z| ≤ ∑ j : Fin 4, |partialDeriv χ j z| :=
      Finset.single_le_sum (fun j _ => abs_nonneg (partialDeriv χ j z)) (Finset.mem_univ i)
    exact (hi.trans (le_add_of_nonneg_left (abs_nonneg (χ z)))).trans (hj z hz)
  refine ⟨2 * D * A, by positivity, fun u a z hz => ?_⟩
  have hu := hAb (u : smoothTwoForms o).val (u : smoothTwoForms o).property z hz
  let F := twoFormControl (u : smoothTwoForms o) ((chartAt FourSpace c).symm z)
  have hF : 0 ≤ F := twoFormControl_nonneg _ _
  have hV : ‖(u : smoothTwoForms o).val ((chartAt FourSpace c).symm z)‖ ≤ F :=
    le_add_of_nonneg_right (Real.sqrt_nonneg _)
  have hcoeff : |twoFormCoordinates o (u : smoothTwoForms o).val c z a| ≤ A * F :=
    (hu.1 a).trans (mul_le_mul_of_nonneg_left hV hA)
  have hpartial (i : Fin 4) :
      |partialDeriv (fun w => twoFormCoordinates o (u : smoothTwoForms o).val c w a) i z| ≤ A * F :=
    hu.2 i a
  refine ⟨?_, fun i => ?_⟩
  · change |χ z * twoFormCoordinates o (u : smoothTwoForms o).val c z a| ≤ _
    rw [abs_mul]
    calc
      _ ≤ D * (A * F) := mul_le_mul (hval z hz) hcoeff (abs_nonneg _) hD
      _ ≤ (2 * D * A) * F := by nlinarith [mul_nonneg hD (mul_nonneg hA hF)]
  · rw [twoFormCutoffC1_partial]
    calc
      _ ≤ |χ z * partialDeriv (fun w => twoFormCoordinates o (u : smoothTwoForms o).val c w a) i z| +
          |partialDeriv χ i z * twoFormCoordinates o (u : smoothTwoForms o).val c z a| := abs_add_le _ _
      _ ≤ D * (A * F) + D * (A * F) := by
        rw [abs_mul, abs_mul]
        exact add_le_add (mul_le_mul (hval z hz) (hpartial i) (abs_nonneg _) hD)
          (mul_le_mul (hder z hz i) hcoeff (abs_nonneg _) hD)
      _ = _ := by ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Nondivergence form of a local scalar Laplace-type operator applied to
the actual Gaussian ansatz. The coefficients here are their values at the
point of evaluation; no equation or geometric coefficient identity is assumed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

def fourHeatLocalOperator (a : Matrix (Fin 4) (Fin 4) ℝ) (b : Fin 4 → ℝ)
    (c : ℝ) (u : FourSpace → ℝ) (x : FourSpace) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a i j * partialDeriv (partialDeriv u i) j x) +
    (∑ i : Fin 4, b i * partialDeriv u i x) + c * u x

def fourHeatConjugatedOperator (a : Matrix (Fin 4) (Fin 4) ℝ) (b : Fin 4 → ℝ)
    (c t : ℝ) (u : FourSpace → ℝ) (x : FourSpace) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a i j *
      (partialDeriv (partialDeriv u i) j x -
        (x i * partialDeriv u j x + x j * partialDeriv u i x) / (2 * t) +
        (x i * x j / (4 * t ^ 2) - (if i = j then 1 else 0) / (2 * t)) * u x)) +
    (∑ i : Fin 4, b i * (partialDeriv u i x - x i / (2 * t) * u x)) + c * u x

theorem fourHeatLocalOperator_gaussian (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (x : FourSpace) :
    fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * u y) x =
      fourHeatGaussian t x * fourHeatConjugatedOperator a b c t u x := by
  unfold fourHeatLocalOperator fourHeatConjugatedOperator
  simp_rw [fourHeatGaussian_amplitude_second t ht u hu,
    fourHeatGaussian_amplitude_partial t ht u hu]
  let K := fourHeatGaussian t x
  let Q := fun i j : Fin 4 => partialDeriv (partialDeriv u i) j x -
    (x i * partialDeriv u j x + x j * partialDeriv u i x) / (2 * t) +
    (x i * x j / (4 * t ^ 2) - (if i = j then 1 else 0) / (2 * t)) * u x
  let P := fun i : Fin 4 => partialDeriv u i x - x i / (2 * t) * u x
  change -(∑ i, ∑ j, a i j * (K * Q i j)) + (∑ i, b i * (K * P i)) + c * (K * u x) =
    K * (-(∑ i, ∑ j, a i j * Q i j) + (∑ i, b i * P i) + c * u x)
  have hQ : (∑ i, ∑ j, a i j * (K * Q i j)) = K * ∑ i, ∑ j, a i j * Q i j := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hP : (∑ i, b i * (K * P i)) = K * ∑ i, b i * P i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hQ, hP]
  ring

theorem fourHeatLocalOperator_residual (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (ht : 0 < t)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (x : FourSpace) :
    deriv (fun s => fourHeatGaussian s x * u x) t +
      fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * u y) x =
      fourHeatGaussian t x *
        ((‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u x +
          fourHeatConjugatedOperator a b c t u x) := by
  rw [(fourHeatGaussian_amplitude_time t ht u x).deriv,
    fourHeatLocalOperator_gaussian a b c t ht.ne' u hu x]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Spatial derivatives of a jointly C2 time-space function are jointly
continuous on their actual open domain. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter
open scoped ContDiff _root_.Topology

noncomputable section

theorem fourHeat_slice_partial (F : ℝ × FourSpace → ℝ) (z : ℝ × FourSpace)
    (hF : DifferentiableAt ℝ F z) (i : Fin 4) :
    partialDeriv (fun x => F (z.1, x)) i z.2 =
      fderiv ℝ F z (0, coordinateVector i) := by
  have he := (hasFDerivAt_const (𝕜 := ℝ) z.1 z.2).prodMk (hasFDerivAt_id z.2)
  have h := hF.hasFDerivAt.comp z.2 he
  change HasFDerivAt (fun x => F (z.1, x)) _ z.2 at h
  unfold partialDeriv
  rw [h.fderiv]
  rfl

theorem fourHeat_slice_partial_contDiffAt (F : ℝ × FourSpace → ℝ) (z : ℝ × FourSpace)
    (hF : ContDiffAt ℝ 2 F z) (i : Fin 4) :
    ContDiffAt ℝ 1 (fun w : ℝ × FourSpace => partialDeriv (fun x => F (w.1, x)) i w.2) z := by
  have hC : ContDiffAt ℝ 1 (fun w => fderiv ℝ F w (0, coordinateVector i)) z :=
    (hF.fderiv_right (m := 1) (by norm_num)).clm_apply contDiffAt_const
  apply hC.congr_of_eventuallyEq
  filter_upwards [hF.eventually (by norm_num)] with w hw
  exact fourHeat_slice_partial F w (hw.differentiableAt (by norm_num)) i

theorem fourHeat_slice_partial_continuousAt (F : ℝ × FourSpace → ℝ) (z : ℝ × FourSpace)
    (hF : ContDiffAt ℝ 1 F z) (i : Fin 4) :
    ContinuousAt (fun w : ℝ × FourSpace => partialDeriv (fun x => F (w.1, x)) i w.2) z := by
  have hC : ContDiffAt ℝ 0 (fun w => fderiv ℝ F w (0, coordinateVector i)) z :=
    (hF.fderiv_right (m := 0) (by norm_num)).clm_apply contDiffAt_const
  apply hC.continuousAt.congr_of_eventuallyEq
  filter_upwards [hF.eventually (by norm_num)] with w hw
  exact fourHeat_slice_partial F w (hw.differentiableAt (by norm_num)) i

theorem fourHeat_slice_second_continuousAt (F : ℝ × FourSpace → ℝ) (z : ℝ × FourSpace)
    (hF : ContDiffAt ℝ 2 F z) (i j : Fin 4) :
    ContinuousAt (fun w : ℝ × FourSpace =>
      partialDeriv (partialDeriv (fun x => F (w.1, x)) i) j w.2) z := by
  exact fourHeat_slice_partial_continuousAt
    (fun w => partialDeriv (fun x => F (w.1, x)) i w.2) z
    (fourHeat_slice_partial_contDiffAt F z hF i) j

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual radial primitive used to solve successive local heat transport equations. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory
open scoped Interval

noncomputable section

def fourHeatRadialPrimitive (k : ℕ) (f : ℝ → ℝ) (r : ℝ) : ℝ :=
  (r ^ k)⁻¹ * ∫ s : ℝ in 0..r, s ^ (k - 1) * f s

theorem fourHeatRadialPrimitive_hasDerivAt (k : ℕ) (hk : 0 < k)
    (f : ℝ → ℝ) (hf : Continuous f) (r : ℝ) (hr : r ≠ 0) :
    HasDerivAt (fourHeatRadialPrimitive k f)
      ((f r - (k : ℝ) * fourHeatRadialPrimitive k f r) / r) r := by
  have hw : Continuous (fun s : ℝ => s ^ (k - 1) * f s) :=
    (continuous_id.pow _).mul hf
  have hi := (hw.integral_hasStrictDerivAt (0 : ℝ) r).hasDerivAt
  have hp := ((hasDerivAt_id r).pow k).inv (pow_ne_zero k hr)
  have hd := hp.mul hi
  unfold fourHeatRadialPrimitive
  convert hd using 1
  · rfl
  · simp only [id_eq, mul_one, Pi.inv_apply, Pi.pow_apply]
    have hpow : r ^ k = r ^ (k - 1) * r := by
      conv_lhs => rw [← Nat.sub_add_cancel hk, pow_succ]
    rw [hpow]
    field_simp
    ring

theorem fourHeatRadialPrimitive_transport (k : ℕ) (hk : 0 < k)
    (f : ℝ → ℝ) (hf : Continuous f) (r : ℝ) (hr : r ≠ 0) :
    r * deriv (fourHeatRadialPrimitive k f) r +
      (k : ℝ) * fourHeatRadialPrimitive k f r = f r := by
  rw [(fourHeatRadialPrimitive_hasDerivAt k hk f hf r hr).deriv]
  field_simp
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Uniform convergence of the lower coordinate jets in a common smooth approximation. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "Linf" => Lp ℂ ∞ (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)



variable (n : ℕ) (is : List (Fin 4)) (h3 : is.length + 3 ≤ n)

private def jetL2 : L2 →L[ℂ] L2 := scalarBesselJetL2 n is (by omega)

private theorem jetL2_memLp_top (f : L2) :
    MemLp (jetL2 n is h3 f : V → ℂ) ∞ volume := by
  have hreg : MemSobolev 3 2 (jetL2 n is h3 f : T) := by
    apply (scalarBesselJetL2_memSobolev n is (by omega) f).mono
    have hc : (is.length : ℝ) + 3 ≤ n := by exact_mod_cast h3
    linarith
  obtain ⟨v, hv⟩ := scalar_L2_H3_boundedContinuous_representative _ hreg
  exact (memLp_congr_ae hv).mpr v.memLp_top

private def jetUniformLinear : L2 →ₗ[ℂ] Linf where
  toFun f := (jetL2_memLp_top n is h3 f).toLp _
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(jetL2_memLp_top n is h3 (f + g)).coeFn_toLp,
      (jetL2_memLp_top n is h3 f).coeFn_toLp,
      (jetL2_memLp_top n is h3 g).coeFn_toLp,
      Lp.coeFn_add (jetL2 n is h3 f) (jetL2 n is h3 g),
      Lp.coeFn_add ((jetL2_memLp_top n is h3 f).toLp _)
        ((jetL2_memLp_top n is h3 g).toLp _)] with x hfg hf hg h2 h4
    rw [hfg, h4, Pi.add_apply, hf, hg, map_add]
    exact h2
  map_smul' c f := by
    simp only [RingHom.id_apply]
    apply Lp.ext
    filter_upwards [(jetL2_memLp_top n is h3 (c • f)).coeFn_toLp,
      (jetL2_memLp_top n is h3 f).coeFn_toLp,
      Lp.coeFn_smul c (jetL2 n is h3 f),
      Lp.coeFn_smul c ((jetL2_memLp_top n is h3 f).toLp _)] with x hcf hf h2 h4
    rw [hcf, h4, Pi.smul_apply, hf, map_smul]
    exact h2

private theorem jetUniformLinear_coe (f : L2) :
    (jetUniformLinear n is h3 f : V → ℂ) =ᵐ[volume] jetL2 n is h3 f :=
  (jetL2_memLp_top n is h3 f).coeFn_toLp

/-- Jets leaving at least three Sobolev derivatives are continuous in L∞. -/
def scalarBesselJetUniform : L2 →L[ℂ] Linf where
  toLinearMap := jetUniformLinear n is h3
  cont := (jetUniformLinear n is h3).continuous_of_seq_closed_graph (by
    intro f x y hfx hfy
    have hlow := tendstoInMeasure_of_tendsto_Lp
      ((jetL2 n is h3).continuous.continuousAt.tendsto.comp hfx)
    have hhigh := tendstoInMeasure_of_tendsto_Lp hfy
    have hlow' : TendstoInMeasure volume
        (fun k => (jetUniformLinear n is h3 (f k) : V → ℂ)) atTop
        (jetL2 n is h3 x : V → ℂ) :=
      hlow.congr (fun k => (jetUniformLinear_coe n is h3 (f k)).symm) Filter.EventuallyEq.rfl
    apply Lp.ext
    exact (tendstoInMeasure_ae_unique hhigh hlow').trans
      (jetUniformLinear_coe n is h3 x).symm)

theorem scalarBesselJetUniform_coe (f : L2) :
    (scalarBesselJetUniform n is h3 f : V → ℂ) =ᵐ[volume] jetL2 n is h3 f :=
  jetUniformLinear_coe n is h3 f

end
end PositiveEinsteinFour.Geometry
end


section

/-! Bounded reconstruction of a compactly supported Euclidean chart
function into the actual base L² space. Null sets are respected by the
proved reverse chart norm comparison. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Function
open scoped Manifold ContDiff ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance reconstruction_baseProbability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarChartReconstructionFun (c : M) (K : Set FourSpace) (f : FourSpace → ℝ) : M → ℝ :=
  ((chartAt FourSpace c).symm '' K).indicator (fun x => f (chartAt FourSpace c x))

omit [IsManifold I4 ∞ M] [CompactSpace M] [Nonempty M] in
private theorem reconstruction_set_measurable (c : M) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    MeasurableSet ((chartAt FourSpace c).symm '' K) :=
  (hK.image_of_continuousOn ((chartAt FourSpace c).symm.continuousOn.mono hKt)).isClosed.measurableSet

omit [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] in
theorem scalarChartReconstructionFun_chart (c : M) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target) (f : FourSpace → ℝ)
    {z : FourSpace} (hz : z ∈ K) :
    scalarChartReconstructionFun c K f ((chartAt FourSpace c).symm z) = f z := by
  have hzS : (chartAt FourSpace c).symm z ∈ (chartAt FourSpace c).symm '' K := ⟨z, hz, rfl⟩
  rw [scalarChartReconstructionFun, indicator_of_mem hzS,
    (chartAt FourSpace c).right_inv (hKt hz)]

omit [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] in
theorem scalarChartReconstructionFun_add (c : M) (K : Set FourSpace)
    (f h : FourSpace → ℝ) :
    scalarChartReconstructionFun c K (fun z => f z + h z) =
      fun x => scalarChartReconstructionFun c K f x + scalarChartReconstructionFun c K h x := by
  classical
  funext x
  by_cases hx : x ∈ (chartAt FourSpace c).symm '' K <;>
    simp [scalarChartReconstructionFun, hx]

omit [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] in
theorem scalarChartReconstructionFun_smul (c : M) (K : Set FourSpace)
    (r : ℝ) (f : FourSpace → ℝ) :
    scalarChartReconstructionFun c K (fun z => r • f z) =
      fun x => r • scalarChartReconstructionFun c K f x := by
  classical
  funext x
  by_cases hx : x ∈ (chartAt FourSpace c).symm '' K <;>
    simp [scalarChartReconstructionFun, hx]

omit [IsManifold I4 ∞ M] [CompactSpace M] [Nonempty M] in
theorem scalarChartReconstructionFun_stronglyMeasurable (c : M) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    {f : FourSpace → ℝ} (hf : StronglyMeasurable f) :
    StronglyMeasurable (scalarChartReconstructionFun c K f) := by
  classical
  let C : M → FourSpace := (chartAt FourSpace c).source.piecewise
    (chartAt FourSpace c) (fun _ => 0)
  have hC : Measurable C := (chartAt FourSpace c).continuousOn.measurable_piecewise
    continuousOn_const (chartAt FourSpace c).open_source.measurableSet
  have he : scalarChartReconstructionFun c K f =
      ((chartAt FourSpace c).symm '' K).indicator (fun x => f (C x)) := by
    funext x
    by_cases hx : x ∈ (chartAt FourSpace c).symm '' K
    · obtain ⟨z, hz, rfl⟩ := hx
      have hzS : (chartAt FourSpace c).symm z ∈ (chartAt FourSpace c).symm '' K := ⟨z, hz, rfl⟩
      rw [scalarChartReconstructionFun, indicator_of_mem hzS, indicator_of_mem hzS]
      rw [show C ((chartAt FourSpace c).symm z) =
          chartAt FourSpace c ((chartAt FourSpace c).symm z) from
        piecewise_eq_of_mem _ _ _ ((chartAt FourSpace c).map_target (hKt hz))]
    · simp only [scalarChartReconstructionFun, indicator_of_notMem hx]
  rw [he]
  exact (hf.comp_measurable hC).indicator (reconstruction_set_measurable c hK hKt)

theorem scalarChartReconstruction_eLpNorm_bound (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    ∃ A : ℝ≥0∞, A ≠ (∞ : ℝ≥0∞) ∧ ∀ f : FourSpace → ℝ,
      eLpNorm (scalarChartReconstructionFun c K f) 2 (normalizedVolume g) ≤
        A * eLpNorm f 2 volume := by
  obtain ⟨D, hD, hDb⟩ := scalarChart_reverse_eLpNorm_bound g c hK hKt
  let A : ℝ≥0∞ := D ^ ((1 / (2 : ℝ≥0∞)).toReal)
  refine ⟨A, ENNReal.rpow_ne_top_of_nonneg (by norm_num) hD, fun f => ?_⟩
  have hs : support (scalarChartReconstructionFun c K f) ⊆
      (chartAt FourSpace c).symm '' K := by
    intro x hx
    by_contra hn
    exact hx (indicator_of_notMem hn _)
  have he : (fun z => scalarChartReconstructionFun c K f ((chartAt FourSpace c).symm z))
      =ᵐ[volume.restrict K] f := by
    filter_upwards [ae_restrict_mem hK.isClosed.measurableSet] with z hz
    exact scalarChartReconstructionFun_chart c hKt f hz
  calc
    _ ≤ A * eLpNorm (fun z => scalarChartReconstructionFun c K f
        ((chartAt FourSpace c).symm z)) 2 (volume.restrict K) := hDb 2 _ hs
    _ = A * eLpNorm f 2 (volume.restrict K) := by rw [eLpNorm_congr_ae he]
    _ ≤ _ := mul_le_mul' le_rfl (eLpNorm_mono_measure _ Measure.restrict_le_self)

theorem scalarChartReconstructionFun_ae (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    {f h : FourSpace → ℝ} (he : f =ᵐ[volume] h) :
    scalarChartReconstructionFun c K f =ᵐ[normalizedVolume g]
      scalarChartReconstructionFun c K h := by
  obtain ⟨A, _, hA⟩ := scalarChartReconstruction_eLpNorm_bound g c hK hKt
  have hf : (fun z => f z - h z) =ᵐ[volume] 0 := he.mono (fun _ hx => sub_eq_zero.mpr hx)
  have hzero : eLpNorm (scalarChartReconstructionFun c K (fun z => f z - h z))
      2 (normalizedVolume g) = 0 := by
    apply le_antisymm _ zero_le
    simpa only [eLpNorm_congr_ae hf, eLpNorm_zero, mul_zero] using hA (fun z => f z - h z)
  have hzero' := (eLpNorm_eq_zero_iff (by norm_num : (2 : ℝ≥0∞) ≠ 0)).mp hzero
  filter_upwards [hzero'] with x hx
  have hid : scalarChartReconstructionFun c K (fun z => f z - h z) x =
      scalarChartReconstructionFun c K f x - scalarChartReconstructionFun c K h x := by
    classical
    by_cases hx : x ∈ (chartAt FourSpace c).symm '' K <;>
      simp [scalarChartReconstructionFun, hx]
  exact sub_eq_zero.mp (hid.symm.trans hx)

theorem scalarChartReconstruction_memLp (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    MemLp (scalarChartReconstructionFun c K f) 2 (normalizedVolume g) := by
  obtain ⟨A, hA, hAb⟩ := scalarChartReconstruction_eLpNorm_bound g c hK hKt
  exact lt_of_le_of_lt (hAb f)
    (lt_top_iff_ne_top.mpr (ENNReal.mul_ne_top hA (Lp.eLpNorm_ne_top f)))

private def scalarChartReconstructionLp (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (f : Lp ℝ 2 (volume : Measure FourSpace)) : Lp ℝ 2 (normalizedVolume g) :=
  (scalarChartReconstruction_memLp g c hK hKt f).toLp _

private theorem scalarChartReconstructionLp_coe (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    scalarChartReconstructionLp g c hK hKt f =ᵐ[normalizedVolume g]
      scalarChartReconstructionFun c K f := MemLp.coeFn_toLp _

private def scalarChartReconstructionLinear (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    Lp ℝ 2 (volume : Measure FourSpace) →ₗ[ℝ] Lp ℝ 2 (normalizedVolume g) where
  toFun := scalarChartReconstructionLp g c hK hKt
  map_add' f h := by
    apply Lp.ext
    have he := scalarChartReconstructionFun_ae g c hK hKt (Lp.coeFn_add f h)
    filter_upwards [scalarChartReconstructionLp_coe g c hK hKt (f + h),
      scalarChartReconstructionLp_coe g c hK hKt f,
      scalarChartReconstructionLp_coe g c hK hKt h,
      Lp.coeFn_add (scalarChartReconstructionLp g c hK hKt f)
        (scalarChartReconstructionLp g c hK hKt h), he] with x hsum hf hh hLp heq
    rw [hsum, hLp, Pi.add_apply, hf, hh, heq]
    exact congrFun (scalarChartReconstructionFun_add c K f h) x
  map_smul' r f := by
    apply Lp.ext
    have he := scalarChartReconstructionFun_ae g c hK hKt (Lp.coeFn_smul r f)
    filter_upwards [scalarChartReconstructionLp_coe g c hK hKt (r • f),
      scalarChartReconstructionLp_coe g c hK hKt f,
      Lp.coeFn_smul r (scalarChartReconstructionLp g c hK hKt f), he]
        with x hrf hf hLp heq
    simp only [RingHom.id_apply]
    rw [hrf, hLp, Pi.smul_apply, hf, heq]
    exact congrFun (scalarChartReconstructionFun_smul c K r f) x

private theorem scalarChartReconstructionLinear_bound (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    ∃ C : ℝ, ∀ f : Lp ℝ 2 (volume : Measure FourSpace),
      ‖scalarChartReconstructionLinear g c hK hKt f‖ ≤ C * ‖f‖ := by
  obtain ⟨A, hA, hAb⟩ := scalarChartReconstruction_eLpNorm_bound g c hK hKt
  refine ⟨A.toReal, fun f => ?_⟩
  have hr := ENNReal.toReal_mono (ENNReal.mul_ne_top hA (Lp.eLpNorm_ne_top f)) (hAb f)
  change ‖(scalarChartReconstruction_memLp g c hK hKt f).toLp
    (scalarChartReconstructionFun c K f)‖ ≤ _
  rw [Lp.norm_toLp]
  simpa only [Lp.norm_def, ENNReal.toReal_mul] using hr

/-- Reconstruction through a compact coordinate set, in actual base volume. -/
def scalarChartReconstruction (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarChartReconstructionLinear g c hK hKt).mkContinuousOfExistsBound
    (scalarChartReconstructionLinear_bound g c hK hKt)

theorem scalarChartReconstruction_coe (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    scalarChartReconstruction g c hK hKt f =ᵐ[normalizedVolume g]
      scalarChartReconstructionFun c K f := scalarChartReconstructionLp_coe g c hK hKt f

theorem scalarChartReconstruction_chartCutoff (g : SmoothMetric M) (c : M)
    (ρ a : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
      (scalarChartSupport_subset c ρ hs)
      (ScalarEuclideanSobolev.valueL2 (scalarCutoffChartC1 c
        (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
        (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
        (scalarChartCutoff_support c ρ hs) a)) =
      smoothScalarBaseL2 g (smoothScalarProduct ρ a) := by
  let K := scalarChartSupport c ρ
  let f := scalarCutoffChartC1 c (scalarChartSupport_subset c ρ hs)
    (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ hs)
    (scalarChartCutoff_compact c ρ hs) (scalarChartCutoff_support c ρ hs) a
  have he : scalarChartReconstructionFun c K f.val = (smoothScalarProduct ρ a).val := by
    funext x
    by_cases hx : x ∈ (chartAt FourSpace c).symm '' K
    · have hxs : x ∈ (chartAt FourSpace c).source := by
        obtain ⟨z, hz, rfl⟩ := hx
        exact (chartAt FourSpace c).map_target (scalarChartSupport_subset c ρ hs hz)
      change ((chartAt FourSpace c).symm '' K).indicator (fun y =>
        scalarChartCutoff c ρ (chartAt FourSpace c y) *
          a.val ((chartAt FourSpace c).symm (chartAt FourSpace c y))) x = ρ.val x * a.val x
      rw [indicator_of_mem hx, scalarChartCutoff_apply c ρ hxs,
        (chartAt FourSpace c).left_inv hxs]
    · have hρ : ρ.val x = 0 := by
        by_contra hn
        have ht := subset_tsupport ρ.val hn
        exact hx ⟨chartAt FourSpace c x, ⟨x, ht, rfl⟩, (chartAt FourSpace c).left_inv (hs ht)⟩
      change ((chartAt FourSpace c).symm '' K).indicator _ x = ρ.val x * a.val x
      rw [indicator_of_notMem hx, hρ, zero_mul]
  have hpoint : scalarChartReconstructionFun c K f.val =ᵐ[normalizedVolume g]
      (smoothScalarProduct ρ a).val := Filter.Eventually.of_forall (congrFun he)
  apply Lp.ext
  exact (scalarChartReconstruction_coe g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs) (ScalarEuclideanSobolev.valueL2 f)).trans
      ((scalarChartReconstructionFun_ae g c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs) (ScalarEuclideanSobolev.valueL2_coe f)).trans
        (hpoint.trans
          (ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
            (⟨(smoothScalarProduct ρ a).val,
              (smoothScalarProduct ρ a).property.continuous⟩ : C(M, ℝ))).symm))

end
end PositiveEinsteinFour.Geometry
end


section

/-! An actual chart H2 representative is the existing intrinsic cutoff value. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Filter
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance cutoffH2Realization_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1CutoffValue_H2_of_rep (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : scalarH1 d)
    (v : Lp ℂ 2 (volume : Measure FourSpace))
    (hv2 : MemSobolev 2 2 (v : 𝓢'(FourSpace, ℂ)))
    (hv : (v : FourSpace → ℂ) =ᵐ[volume] fun z =>
      (χ z * scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z) : ℝ)) :
    MemSobolev 2 2
      (scalarComplexL2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u) :
        𝓢'(FourSpace, ℂ)) := by
  have hchart := scalarH1ChartValue_coe g o d c hK hKt u
    (scalarH1BaseValue g o d u) (scalarH1BaseValue_spec g o d u)
  have hcut := (scalarLocalL2ProductCLM_coe hK.isClosed.measurableSet χ hχ.continuous hc hs
    (scalarH1ChartValue g o d c hK hKt u)).trans
    (scalarLocalL2Product_ae_congr hK.isClosed.measurableSet χ hs hchart)
  have heq : scalarComplexL2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u) = v := by
    apply Lp.ext
    filter_upwards [scalarComplexL2_coe (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u),
      hcut, hv] with z hcomplex hreal hrep
    exact hcomplex.trans ((congrArg Complex.ofReal hreal).trans hrep.symm)
  rwa [heq]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Freezing an actual Euclidean L2 chart equation, with its source
transformed by the same affine map as the unknown. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

local notation "L2" => Lp ℝ 2 (volume : Measure FourSpace)

theorem scalarEuclidean_rescaled_equation (g : SmoothMetric M) (c : M)
    (w F : L2) (V : Set FourSpace)
    (hw : ∀ (φ : FourSpace → ℝ), ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ V →
      (∫ z, w z * scalarChartOperator g c φ z) = ∫ z, F z * φ z)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ)
    (ht : ∀ y ∈ tsupport ψ, scalarRescaledPoint g c z₀ r y ∈ V) :
    (∫ y, scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀ w y *
      scalarRescaledOperator g c z₀ r ψ y) =
    ∫ y, (r ^ 2 • scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀ F) y * ψ y := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr
  let φ : FourSpace → ℝ := fun z => ψ (A.symm (z - z₀))
  have hφ : ContDiff ℝ ∞ φ := hψ.comp (A.symm.contDiff.comp (contDiff_id.sub contDiff_const))
  have hcφ : HasCompactSupport φ := by
    have h := hcψ.comp_homeomorph ((Homeomorph.addRight (-z₀.val)).trans A.symm.toHomeomorph)
    change HasCompactSupport (fun z => ψ (A.symm (z + -z₀.val))) at h
    simpa only [φ, sub_eq_add_neg] using h
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr]
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hsφ : tsupport φ ⊆ V := by
    intro z hz
    have hy := tsupport_comp_subset_preimage (f := fun z => A.symm (z - z₀)) ψ (by fun_prop) hz
    have h := ht _ hy
    rwa [hinv] at h
  have hop (z : FourSpace) : scalarRescaledOperator g c z₀ r ψ (A.symm (z - z₀)) =
      r ^ 2 * scalarChartOperator g c φ z := by
    have h := scalarRescaledOperator_eq_chart g c z₀ r hr ψ hψ (A.symm (z - z₀))
    rw [hinv] at h
    exact h.symm
  have hsource : (∫ y, (r ^ 2 • scalarAffinePullbackL2 A z₀ F) y * ψ y) =
      r ^ 2 * (scalarAffineJacobian A * ∫ z, F z * φ z) := by
    calc
      _ = ∫ y, r ^ 2 * (scalarAffinePullbackL2 A z₀ F y * ψ y) := by
        apply integral_congr_ae
        filter_upwards [Lp.coeFn_smul (r ^ 2) (scalarAffinePullbackL2 A z₀ F)] with y hy
        rw [hy]
        change (r ^ 2 * scalarAffinePullbackL2 A z₀ F y) * ψ y = _
        ring
      _ = r ^ 2 * ∫ y, scalarAffinePullbackL2 A z₀ F y * ψ y := integral_const_mul _ _
      _ = _ := by rw [scalarAffineL2_integral]
  rw [hsource, scalarAffineL2_integral]
  change scalarAffineJacobian A * (∫ z, w z * scalarRescaledOperator g c z₀ r ψ
    (A.symm (z - z₀))) = _
  simp_rw [hop]
  have hm : (∫ z, w z * (r ^ 2 * scalarChartOperator g c φ z)) =
      r ^ 2 * ∫ z, w z * scalarChartOperator g c φ z := by
    rw [← integral_const_mul]
    congr 1
    funext z
    ring
  rw [hm, hw φ hφ hcφ hsφ]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite distributional jets characterize integer Sobolev regularity.
This closes the higher nonlinear chain rules after their L2 product limits. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

theorem scalarCoordinateJet_append (is js : List (Fin 4)) (u : T) :
    scalarCoordinateJet (is ++ js) u = scalarCoordinateJet is (scalarCoordinateJet js u) := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    simp only [List.cons_append, scalarCoordinateJet_cons, ih]

/-- Only the finitely many coordinate derivatives through order n are needed. -/
theorem scalar_memSobolev_of_coordinate_jets (n : ℕ) (u : T)
    (hj : ∀ is : List (Fin 4), is.length ≤ n → ∃ v : L2, scalarCoordinateJet is u = (v : T)) :
    MemSobolev (n : ℝ) 2 u := by
  induction n generalizing u with
  | zero =>
    obtain ⟨v, hv⟩ := hj [] (by simp)
    simpa only [Nat.cast_zero, scalarCoordinateJet_nil] using memSobolev_zero_iff.mpr ⟨v, hv⟩
  | succ n ih =>
    rw [Nat.cast_add, Nat.cast_one, scalar_memSobolev_succ_iff]
    refine ⟨ih u (fun is hs => hj is (by omega)), fun i => ?_⟩
    apply ih
    intro is hs
    obtain ⟨v, hv⟩ := hj (is ++ [i]) (by simp; omega)
    refine ⟨v, ?_⟩
    simpa only [scalarCoordinateJet_append, scalarCoordinateJet_cons, scalarCoordinateJet_nil] using hv

/-- Strong L2 limits of every finite jet remain the actual derivatives of the
value limit and yield integer Sobolev regularity. -/
theorem scalar_integer_jets_closed (n : ℕ) (u : L2) (fs : ℕ → L2)
    (G : List (Fin 4) → L2) (Gs : List (Fin 4) → ℕ → L2)
    (hvalue : Tendsto fs atTop (𝓝 u))
    (hG : ∀ is, is.length ≤ n → Tendsto (Gs is) atTop (𝓝 (G is)))
    (hjets : ∀ is, is.length ≤ n → ∀ k,
      scalarCoordinateJet is (fs k : T) = (Gs is k : T)) :
    MemSobolev (n : ℝ) 2 (u : T) := by
  apply scalar_memSobolev_of_coordinate_jets
  intro is hs
  refine ⟨G is, ?_⟩
  have hleft := (scalarCoordinateJet is).continuous.continuousAt.tendsto.comp
    ((Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp hvalue)
  have hright := (Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp (hG is hs)
  have hl : Tendsto (fun k => (Gs is k : T)) atTop (𝓝 (scalarCoordinateJet is (u : T))) := by
    simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply, hjets is hs] using hleft
  have hr : Tendsto (fun k => (Gs is k : T)) atTop (𝓝 (G is : T)) := by
    simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply] using hright
  exact tendsto_nhds_unique hl hr

end
end PositiveEinsteinFour.Geometry
end


section

/-! Concrete chart and coefficient cutoffs for the local regularity
application. The chart cutoff is one on the whole rescaled unit ball. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology SchwartzMap

noncomputable section

def scalarCoefficientBump : ContDiffBump (0 : FourSpace) where
  rIn := 1
  rOut := 2
  rIn_pos := zero_lt_one
  rIn_lt_rOut := by norm_num

theorem scalarCoefficientBump_one {y : FourSpace} (hy : y ∈ closedBall 0 1) :
    scalarCoefficientBump y = 1 := scalarCoefficientBump.one_of_mem_closedBall hy

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem exists_scalar_chart_cutoff (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c) :
    ∃ χ : FourSpace → ℝ, ContDiff ℝ ∞ χ ∧ HasCompactSupport χ ∧
      tsupport χ ⊆ (chartAt FourSpace c).target ∧
      ∃ η : ℝ, 0 < η ∧ ∀ r : ℝ, |r| < η → ∀ y ∈ closedBall (0 : FourSpace) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target ∧
          χ (scalarRescaledPoint g c z₀ r y) = 1 := by
  obtain ⟨d, hd, hdt⟩ := Metric.nhds_basis_closedBall.mem_iff.mp
    ((chartAt FourSpace c).open_target.mem_nhds z₀.property)
  let χ : ContDiffBump z₀.val :=
    { rIn := d / 2
      rOut := d
      rIn_pos := half_pos hd
      rIn_lt_rOut := half_lt_self hd }
  have hs : tsupport (χ : FourSpace → ℝ) ⊆ (chartAt FourSpace c).target := by
    rw [χ.tsupport_eq]
    exact hdt
  refine ⟨χ, χ.contDiff, χ.hasCompactSupport, hs, ?_⟩
  have hone : {z : FourSpace | χ z = 1} ∈ 𝓝 z₀.val := χ.eventuallyEq_one
  have he := scalarRescaledPoint_compact_eventually g c z₀ (isCompact_closedBall 0 1)
    _ hone
  obtain ⟨η, hη, hηs⟩ := Metric.mem_nhds_iff.mp he
  refine ⟨η, hη, ?_⟩
  intro r hr y hy
  have hχ : χ (scalarRescaledPoint g c z₀ r y) = 1 :=
    hηs (by simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr) y hy
  refine ⟨hs (subset_tsupport _ ?_), hχ⟩
  exact fun h => zero_ne_one (h.symm.trans hχ)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The localized first derivative identity as an identity of actual L2
functions. The multiplier is uniformly bounded by the scalar derivative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped SchwartzMap ENNReal ContDiff LineDeriv NNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

theorem scalarRealSchwartzDerivative_apply (f : S) (i : Fin 4) (x : V) :
    D i f x = partialDeriv f i x := by
  simp only [SchwartzMap.lineDerivOp_apply_eq_fderiv, partialDeriv,
    coordinateVector, EuclideanSpace.basisFun_apply]

def scalarDerivativeMultiplier (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ)
    {C : ℝ} (hC : ∀ s, |deriv φ s| ≤ C)
    (u : V → ℝ) (hu : AEStronglyMeasurable u (volume : Measure V)) : L2 →L[ℝ] L2 :=
  scalarL2BoundedMultiplier (fun x => deriv φ (u x))
    ((hφ.continuous_deriv (by simp)).comp_aestronglyMeasurable hu) (fun x => hC (u x))

theorem scalarDerivativeMultiplier_coe (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ)
    {C : ℝ} (hC : ∀ s, |deriv φ s| ≤ C)
    (u : V → ℝ) (hu : AEStronglyMeasurable u (volume : Measure V)) (f : L2) :
    scalarDerivativeMultiplier φ hφ hC u hu f =ᵐ[volume] fun x => deriv φ (u x) * f x :=
  scalarL2BoundedMultiplier_coe _ _ _ _

theorem scalarLocalizedCompose_first_L2 (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) {C : ℝ≥0} (hLip : LipschitzWith C φ)
    (hzero : φ 0 = 0) {B : ℝ} (hB : ∀ s, |deriv φ s| ≤ B)
    (f : S) (i : Fin 4) :
    (D i (scalarLocalizedCompose χ hc φ hφ f)).toLp 2 volume =
      scalarRealSchwartzMultiply (D i χ) (hLip.compLp hzero (f.toLp 2 volume)) +
      scalarRealSchwartzMultiply χ
        (scalarDerivativeMultiplier φ hφ hB f f.continuous.aestronglyMeasurable
          ((D i f).toLp 2 volume)) := by
  apply Lp.ext
  let v := hLip.compLp hzero (f.toLp 2 volume)
  let w := scalarDerivativeMultiplier φ hφ hB f f.continuous.aestronglyMeasurable
    ((D i f).toLp 2 volume)
  filter_upwards [(D i (scalarLocalizedCompose χ hc φ hφ f)).coeFn_toLp 2 volume,
    Lp.coeFn_add (scalarRealSchwartzMultiply (D i χ) v) (scalarRealSchwartzMultiply χ w),
    scalarRealSchwartzMultiply_coe (D i χ) v, scalarRealSchwartzMultiply_coe χ w,
    scalarDerivativeMultiplier_coe φ hφ hB f f.continuous.aestronglyMeasurable
      ((D i f).toLp 2 volume),
    hLip.coeFn_compLp hzero (f.toLp 2 volume), f.coeFn_toLp 2 volume,
    (D i f).coeFn_toLp 2 volume] with x hf' hadd hχ' hχ hw hv hfv hdf
  simp only [Pi.add_apply] at hadd
  rw [hf', hadd, hχ', hχ, hw, hv, Function.comp_apply, hfv, hdf,
    scalarRealSchwartzDerivative_apply, scalarRealSchwartzDerivative_apply,
    scalarRealSchwartzDerivative_apply]
  exact scalar_partial_local_composition χ f φ χ.smooth' f.smooth' hφ x i

end
end PositiveEinsteinFour.Geometry
end


section

/-! The same weighted H1 representative satisfies the actual geometric
equation after the invertible frozen-frame change of coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance rescaledL2Tests_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarRescaled_L2_test_equation (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f)
          (scalarH1Value d v)))
    (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψt : ∀ y ∈ tsupport ψ,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (hone : ∀ y ∈ tsupport ψ, χ (scalarRescaledPoint g c z₀ r y) = 1) :
    (∫ y, scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
        (scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs) y *
          scalarRescaledOperator g c z₀ r ψ y) =
      ∫ y, r ^ 2 * chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
        f ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y)) * ψ y := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr
  let ψ₀ : FourSpace → ℝ := fun z => ψ (A.symm (z - z₀))
  have hp : ContDiff ℝ ∞ ψ₀ :=
    hψ.comp (A.symm.contDiff.comp (contDiff_id.sub contDiff_const))
  have hpc : HasCompactSupport ψ₀ := by
    have h := hψc.comp_homeomorph
      ((Homeomorph.addRight (-z₀.val)).trans A.symm.toHomeomorph)
    change HasCompactSupport (fun z => ψ (A.symm (z + -z₀.val))) at h
    simpa only [ψ₀, sub_eq_add_neg] using h
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr]
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hps {z : FourSpace} (hz : z ∈ tsupport ψ₀) : A.symm (z - z₀) ∈ tsupport ψ :=
    tsupport_comp_subset_preimage (f := fun z => A.symm (z - z₀)) ψ (by fun_prop) hz
  have hpt : tsupport ψ₀ ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have h := hψt _ (hps hz)
    rwa [hinv] at h
  have hpo : ∀ z ∈ tsupport ψ₀, χ z = 1 := by
    intro z hz
    have h := hone _ (hps hz)
    rwa [hinv] at h
  have heq := scalarWeightedChartL2_L2_test_equation g o d f u hw c hK hKt
    χ hχ hc hs ψ₀ hp hpc hpt hpo
  have hop (z : FourSpace) : scalarRescaledOperator g c z₀ r ψ (A.symm (z - z₀)) =
      r ^ 2 * scalarChartOperator g c ψ₀ z := by
    have h := scalarRescaledOperator_eq_chart g c z₀ r hr ψ hψ (A.symm (z - z₀))
    rw [hinv] at h
    exact h.symm
  rw [scalarAffineL2_integral]
  change scalarAffineJacobian A * (∫ z, _ * scalarRescaledOperator g c z₀ r ψ
    (A.symm (z - z₀))) = _
  simp_rw [hop]
  have hmul : (∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
      (r ^ 2 * scalarChartOperator g c ψ₀ z)) =
      r ^ 2 * ∫ z, scalarWeightedChartL2 g o d c hK hKt u χ hχ hc hs z *
        scalarChartOperator g c ψ₀ z := by
    rw [← integral_const_mul]
    congr 1
    funext z
    ring
  rw [hmul, heq]
  have hsource := scalarAffine_integral A z₀.val (fun z =>
    chartVolumeDensity g c z * (f ((chartAt FourSpace c).symm z) * ψ₀ z))
  have htest (y : FourSpace) : ψ₀ (A y + z₀) = ψ y := by
    simp only [ψ₀, add_sub_cancel_right, A.symm_apply_apply]
  change (∫ y, chartVolumeDensity g c (A y + z₀) *
    (f ((chartAt FourSpace c).symm (A y + z₀)) * ψ₀ (A y + z₀))) = _ at hsource
  have hpoint (y : FourSpace) : A y + z₀ = scalarRescaledPoint g c z₀ r y :=
    scalarRescalingLinearEquiv_apply g c z₀ r hr y
  have htest' (y : FourSpace) : ψ₀ (scalarRescaledPoint g c z₀ r y) = ψ y := by
    rw [← hpoint, htest]
  simp only [hpoint, htest'] at hsource
  rw [mul_left_comm (scalarAffineJacobian A) (r ^ 2), ← hsource,
    ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with y
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The rescaled source is the actual smooth scalar and chart density,
with the scale factor dictated by the transformed geometric equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def scalarRescaledSource (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c)
    (r : ℝ) (f : SmoothScalar (M := M)) (y : FourSpace) : ℝ :=
  r ^ 2 * chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
    f.val ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))

theorem scalarRescaledPoint_contDiff (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) :
    ContDiff ℝ ∞ (scalarRescaledPoint g c z₀ r) :=
  contDiff_const.add
    (((Matrix.toEuclideanCLM (n := Fin 4) (𝕜 := ℝ))
      (chartGramMatrix g c 1 z₀)).contDiff.const_smul r)

theorem scalarRescaledSource_contDiffAt (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (f : SmoothScalar (M := M)) (y : FourSpace)
    (hy : scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (scalarRescaledSource g c z₀ r f) y := by
  have hp := (scalarRescaledPoint_contDiff g c z₀ r).contDiffAt (x := y)
  have hf : ContDiffAt ℝ ∞ (fun z => f.val ((chartAt FourSpace c).symm z))
      (scalarRescaledPoint g c z₀ r y) :=
    (f.property.contMDiffAt.comp _
      (contMDiffAt_symm_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas c) hy)).contDiffAt
  exact (contDiffAt_const.mul ((chartVolumeDensity_contDiffAt g c _ hy).comp y hp)).mul
    (hf.comp y hp)

theorem scalarRescaledSource_complex_contDiffAt (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (f : SmoothScalar (M := M)) (y : FourSpace)
    (hy : scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (fun x =>
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledSource g c z₀ r f x : ℝ) : ℂ)) y :=
  Complex.ofRealCLM.contDiff.contDiffAt.comp y
    (contDiffAt_const.mul (scalarRescaledSource_contDiffAt g c z₀ r f y hy))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The L⁴ Sobolev representative is the same actual base function as its L² representative of the intrinsic first-jet completion. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff ENNReal

noncomputable section

local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

def scalarL4ToL2Linear {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] : Lp ℝ 4 μ →ₗ[ℝ] Lp ℝ 2 μ where
  toFun f := ((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)).toLp f
  map_add' f g := by
    apply Lp.ext
    filter_upwards [MemLp.coeFn_toLp ((Lp.memLp (f + g)).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)),
      MemLp.coeFn_toLp ((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)),
      MemLp.coeFn_toLp ((Lp.memLp g).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)),
      Lp.coeFn_add f g, Lp.coeFn_add
        (((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)).toLp f)
        (((Lp.memLp g).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)).toLp g)]
      with x hsum hf hg hsource htarget
    rw [hsum, hsource, htarget, Pi.add_apply, Pi.add_apply, hf, hg]
  map_smul' r f := by
    apply Lp.ext
    filter_upwards [MemLp.coeFn_toLp ((Lp.memLp (r • f)).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)),
      MemLp.coeFn_toLp ((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)),
      Lp.coeFn_smul r f, Lp.coeFn_smul r
        (((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)).toLp f)]
      with x hrf hf hsource htarget
    simp only [RingHom.id_apply]
    rw [hrf, hsource, htarget, Pi.smul_apply, Pi.smul_apply, hf]

theorem scalarL4ToL2Linear_bound {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (f : Lp ℝ 4 μ) : ‖scalarL4ToL2Linear μ f‖ ≤ ‖f‖ := by
  have h := eLpNorm_le_eLpNorm_of_exponent_le (μ := μ) (f := (f : X → ℝ))
    (by norm_num : (2 : ℝ≥0∞) ≤ 4)
  have hr := ENNReal.toReal_mono (Lp.eLpNorm_ne_top f) h
  change ‖((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4)).toLp f‖ ≤ _
  rw [Lp.norm_toLp, Lp.norm_def]
  exact hr

def scalarL4ToL2 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] : Lp ℝ 4 μ →L[ℝ] Lp ℝ 2 μ :=
  (scalarL4ToL2Linear μ).mkContinuous 1 (fun f => by
    simpa only [one_mul] using scalarL4ToL2Linear_bound μ f)

theorem scalarL4ToL2_coe {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (f : Lp ℝ 4 μ) : scalarL4ToL2 μ f =ᵐ[μ] f :=
  MemLp.coeFn_toLp ((Lp.memLp f).mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 4))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance sobolevRepresentative_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance sobolevRepresentative_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarH1BaseL4_toL2 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (u : scalarH1 d) :
    scalarL4ToL2 (normalizedVolume g) (scalarH1BaseL4 g o d u) = scalarH1BaseValue g o d u := by
  have he : (scalarL4ToL2 (normalizedVolume g)).comp (scalarH1BaseL4 g o d) =
      scalarH1BaseValue g o d := by
    apply DFunLike.ext'
    apply ((scalarL4ToL2 (normalizedVolume g)).comp (scalarH1BaseL4 g o d)).continuous.ext_on
      (smoothScalarH1Map_dense o d) (scalarH1BaseValue g o d).continuous
    rintro _ ⟨a, rfl⟩
    change scalarL4ToL2 (normalizedVolume g) (scalarH1BaseL4 g o d (smoothScalarToH1 d a)) =
      scalarH1BaseValue g o d (smoothScalarToH1 d a)
    rw [scalarH1BaseL4_smooth, scalarH1BaseValue_smooth]
    apply Lp.ext
    exact (scalarL4ToL2_coe (normalizedVolume g) _).trans
      ((smoothScalarBaseL4_coe g a).trans
        (ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
          (smoothScalarContinuous a)).symm)
  exact congrArg (fun T : scalarH1 d →L[ℝ] Lp ℝ 2 (normalizedVolume g) => T u) he

theorem scalarH1BaseL4_coe (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (u : scalarH1 d) :
    scalarH1BaseL4 g o d u =ᵐ[normalizedVolume g] scalarH1BaseValue g o d u := by
  rw [← scalarH1BaseL4_toL2 g o d u]
  exact (scalarL4ToL2_coe (normalizedVolume g) _).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual compact chart first jet is bounded by the intrinsic
two-form H1 norm, uniformly over smooth sections. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormCutoff_jet_bound (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : SmoothH1TwoForm o) (a : Fin 2 → Fin 4),
      ‖ScalarEuclideanSobolev.valueL2 (twoFormCutoffC1 c hKt χ hχ hc hs a u)‖ ≤ C * ‖u‖ ∧
      ‖ScalarEuclideanSobolev.gradientL2 (twoFormCutoffC1 c hKt χ hχ hc hs a u)‖ ≤ C * ‖u‖ := by
  obtain ⟨B, hB, hBb⟩ := twoFormCutoffC1_control (o := o) c hK hKt χ hχ hc hs
  obtain ⟨L, hL, hLb⟩ := twoForm_chart_localization_bound g o c hK hKt
  refine ⟨4 * B * L, by positivity, fun u a => ?_⟩
  let f := twoFormCutoffC1 c hKt χ hχ hc hs a u
  have hfs : tsupport f.val ⊆ K := twoFormCutoffC1_support c hKt χ hχ hc hs a u
  have hval : ‖ScalarEuclideanSobolev.valueL2 f‖ ≤ B * L * ‖u‖ := by
    exact hLb u f.val (f.property.1.continuous.memLp_of_hasCompactSupport f.property.2)
      B hB ((subset_tsupport f.val).trans hfs) (fun z hz => (hBb u a z hz).1)
  have hpartial (i : Fin 4) : ‖ScalarEuclideanSobolev.partialL2 f i‖ ≤ B * L * ‖u‖ := by
    have hf : MemLp (partialDeriv f.val i) 2 (volume : Measure FourSpace) :=
      (ScalarEuclideanSobolev.continuous_partial f.property.1 i).memLp_of_hasCompactSupport
      (f.property.2.fderiv_apply ℝ (coordinateVector i))
    exact hLb u (partialDeriv f.val i) hf B hB
      ((subset_tsupport (partialDeriv f.val i)).trans
        ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hfs))
      (fun z hz => (hBb u a z hz).2 i)
  have hnonneg : 0 ≤ B * L * ‖u‖ := mul_nonneg (mul_nonneg hB hL) (norm_nonneg _)
  refine ⟨hval.trans (by nlinarith only [hnonneg]), ?_⟩
  calc
    _ ≤ ∑ i : Fin 4, ‖ScalarEuclideanSobolev.partialL2 f i‖ :=
      ScalarEuclideanSobolev.gradientL2_norm_le_sum f
    _ ≤ ∑ _i : Fin 4, B * L * ‖u‖ := Finset.sum_le_sum (fun i _ => hpartial i)
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth scalar multiplication and the finite partition identity for
actual smooth two-form sections. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormFrameValue_mul (ρ : M → ℝ) (u : M → TwoFormFour) (e : FrameBundle g) :
    twoFormFrameValue o (fun x => ρ x • u x) e = ρ e.base • twoFormFrameValue o u e :=
  (twoFormFrameActionLinear _).map_smul _ _

theorem twoFormChartValue_mul (ρ : M → ℝ) (u : M → TwoFormFour) (c : M)
    (S : Mat4) (hS : Sᵀ * S = 1) :
    twoFormChartValue o (fun x => ρ x • u x) c S hS =
      fun z => ρ ((chartAt FourSpace c).symm z) • twoFormChartValue o u c S hS z := by
  funext z
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · simp only [twoFormChartValue, dite_eq_left hz, twoFormFrameValue_mul]
    rfl
  · simp only [twoFormChartValue, dite_eq_right hz, smul_zero]

theorem TwoFormSmooth.mul {u : M → TwoFormFour} (hu : TwoFormSmooth o u)
    {ρ : M → ℝ} (hρ : ContMDiff I4 𝓘(ℝ, ℝ) ∞ ρ) :
    TwoFormSmooth o (fun x => ρ x • u x) := by
  intro c S hS U hU hUt hp
  rw [twoFormChartValue_mul]
  apply ContDiffOn.fun_smul _ (hu c S hS U hU hUt hp)
  intro z hz
  exact (scalarCoordinates_contDiffAt hρ c z (hUt hz) (fun j => Fin.elim0 j)).contDiffWithinAt

def smoothTwoFormProduct (ρ : SmoothScalar (M := M)) (u : smoothTwoForms o) : smoothTwoForms o :=
  ⟨fun x => ρ.val x • u.val x, u.property.mul ρ.property⟩

theorem smoothTwoFormProduct_add (ρ : SmoothScalar (M := M)) (u v : smoothTwoForms o) :
    smoothTwoFormProduct ρ (u + v) = smoothTwoFormProduct ρ u + smoothTwoFormProduct ρ v := by
  apply Subtype.ext
  funext x
  exact smul_add _ _ _

theorem smoothTwoFormProduct_smul (ρ : SmoothScalar (M := M)) (r : ℝ) (u : smoothTwoForms o) :
    smoothTwoFormProduct ρ (r • u) = r • smoothTwoFormProduct ρ u := by
  apply Subtype.ext
  funext x
  change ρ.val x • (r • u.val x) = r • (ρ.val x • u.val x)
  exact smul_comm _ _ _

variable [T3Space M] [CompactSpace M]

omit [T3Space M] [CompactSpace M] in
theorem smoothTwoForm_partition (P : ScalarPartition M) (u : smoothTwoForms o) :
    (∑ i : P.ι, smoothTwoFormProduct (scalarPartitionFunction P i) u) = u := by
  have hp (x : M) : (∑ i : P.ι, (scalarPartitionFunction P i).val x) = 1 := by
    simpa only [scalarPartitionFunction, finsum_eq_sum_of_fintype] using P.ρ.sum_eq_one (Set.mem_univ x)
  apply Subtype.ext
  funext x
  simp only [Submodule.coe_sum, Finset.sum_apply, smoothTwoFormProduct]
  rw [← Finset.sum_smul, hp, one_smul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The exact eikonal and radial transport terms of the local Gaussian
ansatz, computed from the actual coordinate derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

def fourHeatEikonalDefect (a : Matrix (Fin 4) (Fin 4) ℝ) (x : FourSpace) : ℝ :=
  (‖x‖ ^ 2 - ∑ i : Fin 4, ∑ j : Fin 4, a i j * x i * x j) / 4

def fourHeatRadialTransport (a : Matrix (Fin 4) (Fin 4) ℝ) (b : Fin 4 → ℝ)
    (u : FourSpace → ℝ) (x : FourSpace) : ℝ :=
  ((∑ i : Fin 4, ∑ j : Fin 4,
      a i j * (x i * partialDeriv u j x + x j * partialDeriv u i x)) +
    ((∑ i : Fin 4, a i i) - 4 - ∑ i : Fin 4, b i * x i) * u x) / 2

theorem fourHeatConjugatedOperator_decomposition (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (u : FourSpace → ℝ) (x : FourSpace) :
    (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u x +
      fourHeatConjugatedOperator a b c t u x =
      fourHeatLocalOperator a b c u x + fourHeatRadialTransport a b u x / t +
        fourHeatEikonalDefect a x / t ^ 2 * u x := by
  unfold fourHeatConjugatedOperator fourHeatLocalOperator fourHeatRadialTransport
    fourHeatEikonalDefect
  norm_num [Fin.sum_univ_four]
  ring

theorem fourHeatLocalOperator_transport_residual (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (ht : 0 < t)
    (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (x : FourSpace) :
    deriv (fun s => fourHeatGaussian s x * u x) t +
      fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * u y) x =
      fourHeatGaussian t x *
        (fourHeatLocalOperator a b c u x + fourHeatRadialTransport a b u x / t +
          fourHeatEikonalDefect a x / t ^ 2 * u x) := by
  rw [fourHeatLocalOperator_residual a b c t ht u hu x,
    fourHeatConjugatedOperator_decomposition]

theorem fourHeatEikonalDefect_zero (a : Matrix (Fin 4) (Fin 4) ℝ) (x : FourSpace)
    (h : ∀ i : Fin 4, (∑ j : Fin 4, a i j * x j) = x i) :
    fourHeatEikonalDefect a x = 0 := by
  have hq : (∑ i : Fin 4, ∑ j : Fin 4, a i j * x i * x j) = ‖x‖ ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq]
    apply Finset.sum_congr rfl
    intro i _
    calc
      _ = x i * ∑ j : Fin 4, a i j * x j := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = x i ^ 2 := by rw [h]; ring
  simp only [fourHeatEikonalDefect, hq, sub_self, zero_div]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The Gaussian local-operator calculation applies to the actual metric
chart operator through its affine rescaling identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem fourHeatLocalOperator_rescaled (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (u : FourSpace → ℝ) (y : FourSpace) :
    fourHeatLocalOperator (scalarRescaledPrincipal g c z₀ r y)ᵀ
      (fun i => -scalarRescaledDrift g c z₀ r y i) 0 u y =
        -scalarRescaledOperator g c z₀ r u y := by
  unfold fourHeatLocalOperator scalarRescaledOperator scalarPrincipalContraction
    scalarPartialMatrix scalarPartialVector dotProduct
  simp only [Matrix.transpose_apply, neg_mul, Finset.sum_neg_distrib, zero_mul, add_zero]
  rw [Finset.sum_comm (f := fun i j =>
    scalarRescaledPrincipal g c z₀ r y j i * partialDeriv (partialDeriv u i) j y)]
  ring

theorem fourHeatScalarChart_residual (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0)
    (t : ℝ) (ht : 0 < t) (u : FourSpace → ℝ) (hu : ContDiff ℝ ∞ u) (y : FourSpace) :
    deriv (fun s => fourHeatGaussian s y * u y) t -
      r ^ 2 * scalarChartOperator g c
        (fun z => fourHeatGaussian t ((scalarRescalingLinearEquiv g c z₀ r hr).symm (z - z₀)) *
          u ((scalarRescalingLinearEquiv g c z₀ r hr).symm (z - z₀)))
        (scalarRescaledPoint g c z₀ r y) =
      fourHeatGaussian t y *
        ((‖y‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u y +
          fourHeatConjugatedOperator (scalarRescaledPrincipal g c z₀ r y)ᵀ
            (fun i => -scalarRescaledDrift g c z₀ r y i) 0 t u y) := by
  have hs := (fourHeatGaussian_smooth t).mul hu
  rw [scalarRescaledOperator_eq_chart g c z₀ r hr _ hs y]
  rw [sub_eq_add_neg, ← fourHeatLocalOperator_rescaled]
  exact fourHeatLocalOperator_residual _ _ _ t ht u hu y

end
end PositiveEinsteinFour.Geometry
end


section

/-! Critical L4 control of the finite Bessel jets retaining one derivative. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter LineDeriv Set
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "L4" => Lp ℂ 4 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

private theorem schwartz_L4_coefficient : ∃ C : ℝ, ∀ φ : S,
    eLpNorm φ 4 volume ≤ (ScalarEuclideanSobolev.constant : ℝ≥0∞) *
      (ENNReal.ofReal C * eLpNorm φ 2 volume +
        ∑ i : Fin 4, eLpNorm
          ((∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ : S) : V → ℂ) 2 volume) := by
  refine ⟨?C, ?_⟩
  swap
  · intro φ
    exact scalar_schwartz_L4_bound φ

private theorem schwartz_eLpNorm_two (φ : S) :
    eLpNorm φ 2 volume = ENNReal.ofReal ‖φ.toLp 2 volume‖ := by
  rw [ofReal_norm]
  exact (Lp.enorm_toLp (φ.memLp 2 volume)).symm

variable (n : ℕ) (is : List (Fin 4)) (h1 : is.length + 1 ≤ n)

private def l4JetL2 : L2 →L[ℂ] L2 := scalarBesselJetL2 n is (by omega)

private def l4NextJetL2 (j : Fin 4) : L2 →L[ℂ] L2 :=
  scalarBesselJetL2 n (j :: is) (by simp; omega)

private def l4JetBound (C B : ℝ) : ℝ≥0∞ :=
  (ScalarEuclideanSobolev.constant : ℝ≥0∞) *
    (ENNReal.ofReal C * ENNReal.ofReal (‖l4JetL2 n is h1‖ * B) +
      ∑ j : Fin 4, ENNReal.ofReal (‖l4NextJetL2 n is h1 j‖ * B))

private theorem l4JetBound_lt_top (C B : ℝ) : l4JetBound n is h1 C B < ∞ := by
  apply ENNReal.mul_lt_top ENNReal.coe_lt_top
  apply ENNReal.add_lt_top.mpr
  constructor
  · exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
  · exact ENNReal.sum_lt_top.mpr (fun _ _ => ENNReal.ofReal_lt_top)

private theorem schwartz_jet_L4_bound (C B : ℝ)
    (hC : ∀ φ : S, eLpNorm φ 4 volume ≤ (ScalarEuclideanSobolev.constant : ℝ≥0∞) *
      (ENNReal.ofReal C * eLpNorm φ 2 volume +
        ∑ i : Fin 4, eLpNorm
          ((∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ : S) : V → ℂ) 2 volume))
    (φ : S) (hB : ‖φ.toLp 2 volume‖ ≤ B) :
    eLpNorm (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)) 4 volume ≤
      l4JetBound n is h1 C B := by
  apply (hC _).trans
  apply mul_le_mul_of_nonneg_left ?_ (by positivity)
  apply add_le_add
  · apply mul_le_mul_of_nonneg_left ?_ (by positivity)
    rw [schwartz_eLpNorm_two, scalarSchwartzBesselJet_toLp n is (by omega)]
    exact ENNReal.ofReal_le_ofReal (((l4JetL2 n is h1).le_opNorm _).trans
      (mul_le_mul_of_nonneg_left hB (norm_nonneg _)))
  · apply Finset.sum_le_sum
    intro j _
    have hd : (∂_{EuclideanSpace.basisFun (Fin 4) ℝ j}
        (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)) : S) =
        scalarSchwartzCoordinateJet (j :: is) (scalarSchwartzIntegerBesselInverse n φ) := rfl
    rw [hd, schwartz_eLpNorm_two, scalarSchwartzBesselJet_toLp n (j :: is) (by simp; omega)]
    exact ENNReal.ofReal_le_ofReal (((l4NextJetL2 n is h1 j).le_opNorm _).trans
      (mul_le_mul_of_nonneg_left hB (norm_nonneg _)))

/-- The critical four-dimensional estimate applies to each actual derivative
with at least one derivative remaining. -/
theorem scalarBesselJetL2_memLp_four (f : L2) :
    MemLp (scalarBesselJetL2 n is (by omega) f : V → ℂ) 4 volume := by
  obtain ⟨C, hC⟩ := schwartz_L4_coefficient
  obtain ⟨vs, hvs, ht⟩ := mem_closure_iff_seq_limit.mp
    (SchwartzMap.denseRange_toLpCLM (E := V) (F := ℂ)
      (μ := (volume : Measure V)) (p := 2) (by norm_num) f)
  choose φ hφ using hvs
  have hconv : Tendsto (fun k => (φ k).toLp 2 volume) atTop (𝓝 f) := by
    have he : (fun k => (φ k).toLp 2 volume) = vs := funext (fun k => hφ k)
    rwa [he]
  obtain ⟨B, hB⟩ := (Metric.isBounded_range_of_tendsto _ hconv).exists_norm_le
  have hB' (k : ℕ) : ‖(φ k).toLp 2 volume‖ ≤ B := hB _ (mem_range_self k)
  have hco (k : ℕ) : (l4JetL2 n is h1 ((φ k).toLp 2 volume) : V → ℂ) =ᵐ[volume]
      scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n (φ k)) := by
    rw [show l4JetL2 n is h1 ((φ k).toLp 2 volume) =
      (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n (φ k))).toLp 2 volume
      from (scalarSchwartzBesselJet_toLp n is (by omega) (φ k)).symm]
    exact SchwartzMap.coeFn_toLp _ _ _
  have hb : ∀ᶠ k in atTop,
      eLpNorm (l4JetL2 n is h1 ((φ k).toLp 2 volume) : V → ℂ) 4 volume ≤
        l4JetBound n is h1 C B := by
    apply Eventually.of_forall
    intro k
    rw [eLpNorm_congr_ae (hco k)]
    exact schwartz_jet_L4_bound n is h1 C B hC (φ k) (hB' k)
  have ht := (l4JetL2 n is h1).continuous.continuousAt.tendsto.comp hconv
  exact (eLpNorm_le_of_tendstoInMeasure hb (tendstoInMeasure_of_tendsto_Lp ht)
    (fun _ => (Lp.memLp _).aestronglyMeasurable)).trans_lt (l4JetBound_lt_top n is h1 C B)

private def jetL4Linear : L2 →ₗ[ℂ] L4 where
  toFun f := (scalarBesselJetL2_memLp_four n is h1 f).toLp _
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(scalarBesselJetL2_memLp_four n is h1 (f + g)).coeFn_toLp,
      (scalarBesselJetL2_memLp_four n is h1 f).coeFn_toLp,
      (scalarBesselJetL2_memLp_four n is h1 g).coeFn_toLp,
      Lp.coeFn_add (l4JetL2 n is h1 f) (l4JetL2 n is h1 g),
      Lp.coeFn_add ((scalarBesselJetL2_memLp_four n is h1 f).toLp _)
        ((scalarBesselJetL2_memLp_four n is h1 g).toLp _)] with x hfg hf hg h2 h4
    rw [hfg, h4, Pi.add_apply, hf, hg, map_add]
    exact h2
  map_smul' c f := by
    simp only [RingHom.id_apply]
    apply Lp.ext
    filter_upwards [(scalarBesselJetL2_memLp_four n is h1 (c • f)).coeFn_toLp,
      (scalarBesselJetL2_memLp_four n is h1 f).coeFn_toLp,
      Lp.coeFn_smul c (l4JetL2 n is h1 f),
      Lp.coeFn_smul c ((scalarBesselJetL2_memLp_four n is h1 f).toLp _)] with x hcf hf h2 h4
    rw [hcf, h4, Pi.smul_apply, hf, map_smul]
    exact h2

private theorem jetL4Linear_coe (f : L2) :
    (jetL4Linear n is h1 f : V → ℂ) =ᵐ[volume] l4JetL2 n is h1 f :=
  (scalarBesselJetL2_memLp_four n is h1 f).coeFn_toLp

def scalarBesselJetL4 : L2 →L[ℂ] L4 where
  toLinearMap := jetL4Linear n is h1
  cont := (jetL4Linear n is h1).continuous_of_seq_closed_graph (by
    intro f x y hfx hfy
    have hlow := tendstoInMeasure_of_tendsto_Lp
      ((l4JetL2 n is h1).continuous.continuousAt.tendsto.comp hfx)
    have hhigh := tendstoInMeasure_of_tendsto_Lp hfy
    have hlow' : TendstoInMeasure volume
        (fun k => (jetL4Linear n is h1 (f k) : V → ℂ)) atTop
        (l4JetL2 n is h1 x : V → ℂ) :=
      hlow.congr (fun k => (jetL4Linear_coe n is h1 (f k)).symm) Filter.EventuallyEq.rfl
    apply Lp.ext
    exact (tendstoInMeasure_ae_unique hhigh hlow').trans
      (jetL4Linear_coe n is h1 x).symm)

theorem scalarBesselJetL4_coe (f : L2) :
    (scalarBesselJetL4 n is h1 f : V → ℂ) =ᵐ[volume]
      scalarBesselJetL2 n is (by omega) f := jetL4Linear_coe n is h1 f

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and affine rescaling for a C1
local representative of an actual base L2 scalar. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M]
  [MeasurableSpace M] [BorelSpace M]

theorem scalar_chart_C1_unweight (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : 0 < r) {R : ℝ} (hR : 0 < R) (hR1 : R ≤ 1)
    (b : Lp ℝ 2 (normalizedVolume g))
    (ht : ∀ y ∈ closedBall (0 : FourSpace) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (F : FourSpace → ℝ) (hF : ContDiff ℝ 1 F)
    (heq : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : FourSpace) R)] F) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ H : FourSpace → ℝ, ContDiffOn ℝ 1 H U ∧
        (fun z => b ((chartAt FourSpace c).symm z)) =ᵐ[volume.restrict U] H := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) R}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    exact hR
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball hR1 hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContDiffOn ℝ 1 H U := by
    intro z hz
    apply ContDiffAt.contDiffWithinAt
    exact (hF.contDiffAt.comp z
      (A.symm.contDiff.contDiffAt.comp z (contDiffAt_id.sub contDiffAt_const))).div
      ((chartVolumeDensity_contDiffAt g c z (hUt hz)).of_le (by simp))
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual base H1 value remains L4 on compact metric charts. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

theorem scalarChartValue_memLp_four (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (b : Lp ℝ 2 (normalizedVolume g)) (hb : MemLp (b : M → ℝ) 4 (normalizedVolume g)) :
    MemLp (scalarChartValue g c hK hKt b : FourSpace → ℝ) 4 (volume.restrict K) := by
  have hexp : (4 : ℝ≥0∞) / 2 = 2 := by
    rw [show (4 : ℝ≥0∞) = 2 * 2 by norm_num]
    exact ENNReal.mul_div_cancel_right (by norm_num) (by norm_num)
  have hb2 : MemLp (fun x => ‖b x‖ ^ (2 : ℕ)) 2 (normalizedVolume g) := by
    simpa only [hexp, ENNReal.toReal_ofNat, Real.rpow_ofNat] using hb.norm_rpow_div 2
  obtain ⟨C, hC, hc⟩ := scalarChart_eLpNorm_bound g c hK hKt
  have hl2 : MemLp (fun z => ‖b ((chartAt FourSpace c).symm z)‖ ^ (2 : ℕ))
      2 (volume.restrict K) :=
    (hc (fun x => ‖b x‖ ^ (2 : ℕ))).trans_lt
      (ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hC) hb2)
  have hv2 : MemLp (fun z => ‖scalarChartValue g c hK hKt b z‖ ^ (2 : ℕ))
      2 (volume.restrict K) := by
    apply (memLp_congr_ae ?_).mp hl2
    filter_upwards [scalarChartValue_coe g c hK hKt b] with z hz
    rw [hz]
  apply (memLp_norm_rpow_iff (p := 4) (q := 2)
    (Lp.aestronglyMeasurable (scalarChartValue g c hK hKt b))
    (by norm_num) (by norm_num)).mp
  simpa only [hexp, ENNReal.toReal_ofNat, Real.rpow_ofNat] using hv2

local instance chartValueL4_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1ChartValue_memLp_four (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) :
    MemLp (scalarH1ChartValue g o d c hK hKt u : FourSpace → ℝ) 4 (volume.restrict K) := by
  apply scalarChartValue_memLp_four g c hK hKt
  exact (memLp_congr_ae (scalarH1BaseL4_coe g o d u)).mp (Lp.memLp _)

theorem scalarLocalL2Product_memLp_four {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : Continuous χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (f : Lp ℝ 2 (volume.restrict K))
    (hf : MemLp (f : FourSpace → ℝ) 4 (volume.restrict K)) :
    MemLp (scalarLocalL2Product hK χ hχ hc hs f : FourSpace → ℝ) 4 volume := by
  obtain ⟨C, hC⟩ := (hc.isCompact_range hχ).isBounded.exists_norm_le
  have hp : MemLp (fun z => χ z * f z) 4 (volume.restrict K) := by
    apply hf.of_le_mul (c := C)
      (hχ.aestronglyMeasurable.mul (Lp.aestronglyMeasurable f))
    filter_upwards with z
    rw [Pi.mul_apply, norm_mul]
    exact mul_le_mul_of_nonneg_right (hC _ (mem_range_self z)) (norm_nonneg _)
  have heq : K.indicator (fun z => χ z * f z) = (fun z => χ z * f z) := by
    apply indicator_eq_self.mpr
    intro z hz
    exact hs (subset_tsupport χ (left_ne_zero_of_mul hz))
  have hglob : MemLp (fun z => χ z * f z) 4 volume := by
    rw [← heq]
    exact (memLp_indicator_iff_restrict hK).mpr hp
  exact (memLp_congr_ae (scalarLocalL2Product_coe hK χ hχ hc hs f).symm).mp hglob

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and affine rescaling for a continuous
local representative of an actual base L2 scalar. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M]
  [MeasurableSpace M] [BorelSpace M]

theorem scalar_chart_continuous_unweight (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : 0 < r) {R : ℝ} (hR : 0 < R) (hR1 : R ≤ 1)
    (b : Lp ℝ 2 (normalizedVolume g))
    (ht : ∀ y ∈ closedBall (0 : FourSpace) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (F : FourSpace → ℝ) (hF : Continuous F)
    (heq : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : FourSpace) R)] F) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ H : FourSpace → ℝ, ContinuousOn H U ∧
        (fun z => b ((chartAt FourSpace c).symm z)) =ᵐ[volume.restrict U] H := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) R}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    exact hR
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball hR1 hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContinuousOn H U := by
    intro z hz
    apply ContinuousAt.continuousWithinAt
    exact (hF.continuousAt.comp (by fun_prop)).div
      (chartVolumeDensity_contDiffAt g c z (hUt hz)).continuousAt
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! Bounded derivative multipliers converge strongly on moving L2 fields. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped ContDiff _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)

theorem scalarDerivativeMultiplier_tendsto (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ)
    {B : ℝ} (hB : ∀ s, |deriv φ s| ≤ B) (u : ℕ → V → ℝ) (v : V → ℝ)
    (hu : ∀ n, AEStronglyMeasurable (u n) (volume : Measure V))
    (hv : AEStronglyMeasurable v (volume : Measure V))
    (huv : ∀ᵐ x ∂(volume : Measure V), Tendsto (fun n => u n x) atTop (𝓝 (v x)))
    (f : ℕ → L2) (g : L2) (hfg : Tendsto f atTop (𝓝 g)) :
    Tendsto (fun n => scalarDerivativeMultiplier φ hφ hB (u n) (hu n) (f n)) atTop
      (𝓝 (scalarDerivativeMultiplier φ hφ hB v hv g)) := by
  have hp : ∀ᵐ x ∂(volume : Measure V), Tendsto (fun n => deriv φ (u n x)) atTop
      (𝓝 (deriv φ (v x))) := by
    filter_upwards [huv] with x hx
    exact (hφ.continuous_deriv (by simp)).continuousAt.tendsto.comp hx
  exact scalarCompositionL2Multiply_tendsto
    (fun n => (hφ.continuous_deriv (by simp)).comp_aestronglyMeasurable (hu n))
    ((hφ.continuous_deriv (by simp)).comp_aestronglyMeasurable hv)
    ((abs_nonneg (deriv φ 0)).trans (hB 0)) (fun n x => hB (u n x))
    (fun x => hB (v x)) hp hfg

end
end PositiveEinsteinFour.Geometry
end


