section

/-! Initial mass of the finite Gaussian parametrix. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped _root_.Topology

noncomputable section

theorem fourHeatGaussian_amplitude_integrable (f : FourSpace → ℝ) (hf : Continuous f)
    (C : ℝ) (hC : ∀ y, ‖f y‖ ≤ C) (t : ℝ) (ht : 0 < t) :
    Integrable (fun x => fourHeatGaussian t x * f x) := by
  apply ((fourHeatGaussian_integrable t ht).mul_const C).mono'
    ((fourHeatGaussian_continuous t).mul hf).aestronglyMeasurable
  exact Eventually.of_forall fun x => by
    change ‖fourHeatGaussian t x * f x‖ ≤ fourHeatGaussian t x * C
    rw [norm_mul, Real.norm_eq_abs, abs_of_pos (fourHeatGaussian_pos t ht x)]
    exact mul_le_mul_of_nonneg_left (hC x) (fourHeatGaussian_pos t ht x).le

theorem fourHeatGaussian_amplitude_limit (f : FourSpace → ℝ) (hf : Continuous f)
    (C : ℝ) (hC : ∀ y, ‖f y‖ ≤ C) :
    Tendsto (fun t => ∫ x : FourSpace, fourHeatGaussian t x * f x)
      (𝓝[Set.Ioi 0] 0) (𝓝 (f 0)) := by
  simpa only [zero_sub, neg_neg, neg_zero] using
    fourHeatGaussian_approximate_identity (fun y => f (-y))
      (hf.comp continuous_neg) C (fun y => hC (-y)) 0

theorem fourHeatPolynomial_gaussian_integral (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ i, Continuous (u i)) (C : Fin 4 → ℝ) (hC : ∀ i x, ‖u i x‖ ≤ C i)
    (t : ℝ) (ht : 0 < t) :
    (∫ x : FourSpace, fourHeatGaussian t x * fourHeatPolynomial u t x) =
      (∫ x : FourSpace, fourHeatGaussian t x * u 0 x) +
      t * (∫ x : FourSpace, fourHeatGaussian t x * u 1 x) +
      t ^ 2 * (∫ x : FourSpace, fourHeatGaussian t x * u 2 x) +
      t ^ 3 * (∫ x : FourSpace, fourHeatGaussian t x * u 3 x) := by
  have hi (i : Fin 4) := fourHeatGaussian_amplitude_integrable (u i) (hu i) (C i) (hC i) t ht
  have he (x : FourSpace) : fourHeatGaussian t x * fourHeatPolynomial u t x =
      fourHeatGaussian t x * u 0 x + t * (fourHeatGaussian t x * u 1 x) +
      t ^ 2 * (fourHeatGaussian t x * u 2 x) +
      t ^ 3 * (fourHeatGaussian t x * u 3 x) := by
    unfold fourHeatPolynomial
    ring
  simp_rw [he]
  rw [integral_add (f := fun x => fourHeatGaussian t x * u 0 x +
      t * (fourHeatGaussian t x * u 1 x) + t ^ 2 * (fourHeatGaussian t x * u 2 x))
      (g := fun x => t ^ 3 * (fourHeatGaussian t x * u 3 x))
      (((hi 0).add ((hi 1).const_mul t)).add ((hi 2).const_mul (t ^ 2)))
      ((hi 3).const_mul (t ^ 3)),
    integral_add (f := fun x => fourHeatGaussian t x * u 0 x +
      t * (fourHeatGaussian t x * u 1 x))
      (g := fun x => t ^ 2 * (fourHeatGaussian t x * u 2 x))
      ((hi 0).add ((hi 1).const_mul t)) ((hi 2).const_mul (t ^ 2)),
    integral_add (f := fun x => fourHeatGaussian t x * u 0 x)
      (g := fun x => t * (fourHeatGaussian t x * u 1 x))
      (hi 0) ((hi 1).const_mul t)]
  simp only [integral_const_mul]

theorem fourHeatPolynomial_approximate_identity (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ i, Continuous (u i)) (C : Fin 4 → ℝ) (hC : ∀ i x, ‖u i x‖ ≤ C i) :
    Tendsto (fun t => ∫ x : FourSpace, fourHeatGaussian t x * fourHeatPolynomial u t x)
      (𝓝[Set.Ioi 0] 0) (𝓝 (u 0 0)) := by
  have ht : Tendsto (fun t : ℝ => t) (𝓝[Set.Ioi 0] 0) (𝓝 (0 : ℝ)) :=
    tendsto_id.mono_left nhdsWithin_le_nhds
  have hL (i : Fin 4) := fourHeatGaussian_amplitude_limit (u i) (hu i) (C i) (hC i)
  have h := (((hL 0).add (ht.mul (hL 1))).add ((ht.pow 2).mul (hL 2))).add
    ((ht.pow 3).mul (hL 3))
  simp only [zero_mul, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
    zero_pow (by norm_num : (3 : ℕ) ≠ 0), add_zero] at h
  apply h.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  exact (fourHeatPolynomial_gaussian_integral u hu C hC t ht).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! Joint continuity, including the first spatial derivatives, of the
finite heat amplitude polynomial. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem fourHeatPolynomial_joint_continuous (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ m, Continuous (u m)) :
    Continuous (fun z : ℝ × FourSpace => fourHeatPolynomial u z.1 z.2) := by
  have h0 : Continuous (fun z : ℝ × FourSpace => u 0 z.2) := (hu 0).comp continuous_snd
  have h1 : Continuous (fun z : ℝ × FourSpace => u 1 z.2) := (hu 1).comp continuous_snd
  have h2 : Continuous (fun z : ℝ × FourSpace => u 2 z.2) := (hu 2).comp continuous_snd
  have h3 : Continuous (fun z : ℝ × FourSpace => u 3 z.2) := (hu 3).comp continuous_snd
  exact ((h0.add (continuous_fst.mul h1)).add ((continuous_fst.pow 2).mul h2)).add
    ((continuous_fst.pow 3).mul h3)

theorem fourHeatPolynomial_partial (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ m, ContDiff ℝ 1 (u m)) (t : ℝ) (x : FourSpace) (i : Fin 4) :
    partialDeriv (fourHeatPolynomial u t) i x =
      fourHeatPolynomial (fun m => partialDeriv (u m) i) t x := by
  have h0 := (hu 0).differentiable one_ne_zero
  have h1 := (hu 1).differentiable one_ne_zero
  have h2 := (hu 2).differentiable one_ne_zero
  have h3 := (hu 3).differentiable one_ne_zero
  unfold fourHeatPolynomial
  rw [fourHeat_partial_add _ _ x (by fun_prop) (by fun_prop),
    fourHeat_partial_add _ _ x (by fun_prop) (by fun_prop),
    fourHeat_partial_add _ _ x h0.differentiableAt (by fun_prop)]
  simp only [fourHeat_partial_const_mul]

theorem fourHeatPolynomial_partial_joint_continuous (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ m, ContDiff ℝ 1 (u m)) (i : Fin 4) :
    Continuous (fun z : ℝ × FourSpace => partialDeriv (fourHeatPolynomial u z.1) i z.2) := by
  simp_rw [fourHeatPolynomial_partial u hu]
  exact fourHeatPolynomial_joint_continuous _
    (fun m => (fourHeat_partial_contDiff 0 (u m) (hu m) i).continuous)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first two jets of the actual radial integral at its center.
These are the local derivatives used in the second heat coefficient. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem fourHeatRadialAverage_partial_zero (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (i : Fin 4) :
    partialDeriv (fourHeatRadialAverage m f) i 0 = partialDeriv f i 0 / (m + 2 : ℝ) := by
  rw [fourHeatRadialAverage_partial m f hf, fourHeatRadialAverage_zero]
  push_cast
  ring

theorem fourHeatRadialAverage_second_zero (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 2 f) (i j : Fin 4) :
    partialDeriv (partialDeriv (fourHeatRadialAverage m f) i) j 0 =
      partialDeriv (partialDeriv f i) j 0 / (m + 3 : ℝ) := by
  have he : partialDeriv (fourHeatRadialAverage m f) i =
      fourHeatRadialAverage (m + 1) (partialDeriv f i) :=
    funext (fun x => fourHeatRadialAverage_partial m f (hf.of_le (by norm_num)) x i)
  rw [he, fourHeatRadialAverage_partial_zero (m + 1) (partialDeriv f i)
    (fourHeat_partial_contDiff 1 f hf i) j]
  push_cast
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Continuous compact chart tensors and their exact smooth realizations
on the intrinsic frame bundle. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M]
  {g : SmoothMetric M} {o : FrameOrientation g}

def heatChartTensor (g : SmoothMetric M) (c : M)
    (F : FourSpace → CovariantCoordinates 2) (hF : ContinuousOn F (chartAt FourSpace c).target)
    (hc : HasCompactSupport F) (hs : tsupport F ⊆ (chartAt FourSpace c).target) :
    C(FrameBundle g, TwoTensorEuclidean) :=
  ⟨fun f => WithLp.toLp 2 (heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f),
    (PiLp.continuous_toLp 2 _).comp
      (heatNormalFrameTensorLift_continuous g c (chartAt FourSpace c).symm F
        (fun _ h => h) hF hc hs)⟩

theorem heatChartTensor_smooth (c : M) (F : FourSpace → CovariantCoordinates 2)
    (hF : ContDiffOn ℝ ∞ F (chartAt FourSpace c).target)
    (hFa : ∀ z i j, F z ![j,i] = -F z ![i,j])
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (hFs : tsupport F ⊆ K) :
    heatChartTensor g c F hF.continuousOn
      (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt) =
      smoothTwoFormEuclideanValue (twoFormChartTest o c F hF hFa hK hKt hFs) := by
  apply ContinuousMap.ext
  intro f
  by_cases hf : f.base ∈ (chartAt FourSpace c).source
  · change WithLp.toLp 2 (heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f) =
      WithLp.toLp 2 (twoFormFramedValue o (twoFormChartTest o c F hF hFa hK hKt hFs).val f)
    rw [heatNormalFrameTensorLift, ite_eq_left (show f.base ∈ (chartAt FourSpace c).symm.target from hf)]
    rw [
      heat_framedValue_chart o _ c f hf,
      twoFormChartTest_coordinates c F hF hFa hK hKt hFs _ ((chartAt FourSpace c).map_source hf),
      OpenPartialHomeomorph.symm_symm]
  · have hzero := twoFormChartTest_zero_off (o := o) c F hF hFa hK hKt hFs f.base (by
      rintro ⟨z, hz, hzf⟩
      exact hf (hzf ▸ (chartAt FourSpace c).map_target (hKt hz)))
    change WithLp.toLp 2 (heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f) =
      WithLp.toLp 2 (twoFormFramedValue o (twoFormChartTest o c F hF hFa hK hKt hFs).val f)
    rw [heatNormalFrameTensorLift, ite_eq_right (show f.base ∉ (chartAt FourSpace c).symm.target from hf)]
    rw [twoFormFramedValue_eq]
    change WithLp.toLp 2 (0 : CovariantCoordinates 2) =
      WithLp.toLp 2 (twoFormTensor (twoFormFrameAction _ ((twoFormChartTest o c F hF hFa hK hKt hFs).val f.base)))
    rw [hzero]
    change WithLp.toLp 2 (0 : CovariantCoordinates 2) =
      WithLp.toLp 2 (twoFormTensorLinear ((twoFormFrameActionLinear _) 0))
    rw [map_zero, map_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The family and geometric coefficient operators agree throughout a
common normal ball, including all differentiated lower order terms. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatFamilyNormal_on_ball {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hpoint : D.point = fun x => P (x, frameCoordinateState g c e))
    (r : ℝ) (hrD : r ≤ D.radius)
    (hP : ∀ x ∈ ball (0 : FourSpace) r, ContDiffAt ℝ 2 P (x, frameCoordinateState g c e))
    (hsource : ∀ x ∈ ball (0 : FourSpace) r,
      frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hdet : ∀ x ∈ ball (0 : FourSpace) r,
      0 < (heatFamilyMetric g c P (x, frameCoordinateState g c e)).det) :
    ∀ x ∈ ball (0 : FourSpace) r,
      (heatFamilyMetric g c P (x, frameCoordinateState g c e))⁻¹ = (heatNormalMetric g o e x)⁻¹ ∧
      heatFamilyDrift g c P (x, frameCoordinateState g c e) = heatNormalDrift g o e x ∧
      heatFamilyFirst g c P (x, frameCoordinateState g c e) = heatNormalBundleFirst D x ∧
      heatFamilyZero g c P (x, frameCoordinateState g c e) = heatNormalBundleZero D x ∧
      heatFamilyLeading g c P (x, frameCoordinateState g c e) = heatNormalLeadingAmplitude g o e x := by
  let q := frameCoordinateState g c e
  have hm (x : FourSpace) (hx : x ∈ ball 0 r) :
      heatFamilyMetric g c P (x, q) = heatNormalMetric g o e x :=
    D.metric_slice_eq P hpoint x (ball_subset_ball hrD hx)
      ((hP x hx).differentiableAt (by norm_num)) (hsource x hx)
  have hJ (x : FourSpace) (hx : x ∈ ball 0 r) :
      heatFamilyDensity g c P (x, q) = frameExponentialJacobian g o e x :=
    congrArg (fun A : Mat4 => Real.sqrt A.det) (hm x hx)
  have hc (x : FourSpace) (hx : x ∈ ball 0 r) : (P (x, q)).1 ∈ (chartAt FourSpace c).target := by
    simpa only [hpoint] using D.in_chart x (ball_subset_ball hrD hx)
  have hA (i : Fin 4) (x : FourSpace) (hx : x ∈ ball 0 r) :
      heatFamilyTwoFormConnection g c P i (x, q) = heatTwoFormConnection g c D.point i x := by
    rw [heatFamilyTwoFormConnection_slice g c P (x, q) ((hP x hx).differentiableAt (by norm_num)) i]
    rw [hpoint]
  have hb (x : FourSpace) (hx : x ∈ ball 0 r) :
      heatFamilyDrift g c P (x, q) = heatNormalDrift g o e x := by
    have hma : (fun y => (heatFamilyMetric g c P (y, q))⁻¹) =ᶠ[𝓝 x]
        (fun y => (heatNormalMetric g o e y)⁻¹) := by
      filter_upwards [isOpen_ball.mem_nhds hx] with y hy
      rw [hm y hy]
    have hj : (fun y => heatFamilyDensity g c P (y, q)) =ᶠ[𝓝 x]
        frameExponentialJacobian g o e := by
      filter_upwards [isOpen_ball.mem_nhds hx] with y hy
      exact hJ y hy
    funext j
    rw [heatFamilyDrift_slice g c P (x, q) (hP x hx) (hc x hx) (hdet x hx) j]
    exact congrFun (fourHeatDensityDrift_germ hma hj) j
  intro x hx
  refine ⟨congrArg Inv.inv (hm x hx), hb x hx, ?_, ?_, ?_⟩
  · unfold heatFamilyFirst heatNormalBundleFirst
    rw [hm x hx]
    funext i
    congr 1
    funext j
    exact hA j x hx
  · have hframe : (P (x, q)).2.det ≠ 0 := by
      have hg := congrArg Matrix.det (D.orthonormal x (ball_subset_ball hrD hx))
      rw [hpoint] at hg
      simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hg
      change (P (x, q)).2.det * (metricInChart g c (P (x, q)).1).det * (P (x, q)).2.det = 1 at hg
      intro hz
      rw [hz] at hg
      norm_num at hg
    rw [heatFamilyZero_slice g c P (x, q) (hP x hx) (hc x hx) hframe (hdet x hx), hm x hx]
    have hb' : fourHeatDensityDrift (fun y => (heatFamilyMetric g c P (y, q))⁻¹)
        (fun y => heatFamilyDensity g c P (y, q)) x = heatNormalDrift g o e x := by
      funext j
      exact (heatFamilyDrift_slice g c P (x, q) (hP x hx) (hc x hx) (hdet x hx) j).symm.trans
        (congrFun (hb x hx) j)
    rw [hb']
    simp only [heatNormalBundleZero, hpoint]
    rfl
  · exact congrArg (fun a : ℝ => (Real.sqrt a)⁻¹) (hJ x hx)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The one-form coefficient family restricts to the actual normal operator. -/
namespace PositiveEinsteinFour.Geometry
open EinsteinFour Matrix Filter
open scoped ContDiff _root_.Topology Matrix.Norms.Elementwise
noncomputable section

theorem fourHeatOneConnectionZero_germ (a : Mat4) (b : Fin 4 → ℝ)
    {A A' : Fin 4 → FourSpace → Mat4} (V : Mat4) {x : FourSpace}
    (hA : ∀ i, A i =ᶠ[𝓝 x] A' i) :
    fourHeatOneConnectionZero a b A V x = fourHeatOneConnectionZero a b A' V x := by
  have hv (i : Fin 4) : A i x = A' i x := (hA i).self_of_nhds
  have hd (i j : Fin 4) (k l : Fin 4) :
      partialDeriv (fun y => A i y k l) j x = partialDeriv (fun y => A' i y k l) j x :=
    fourHeat_partial_germ ((hA i).mono fun y hy => congrArg (fun B : Mat4 => B k l) hy) j
  simp only [fourHeatOneConnectionZero, hv, hd]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem heatFamilyOneFirst_slice (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : DifferentiableAt ℝ P z) :
    heatFamilyOneFirst g c P z = fun i => fourHeatOneConnectionFirst
      (heatFamilyMetric g c P z)⁻¹
      (fun j => heatNormalFrameConnection g c (fun x => P (x, z.2)) j z.1) i := by
  funext i
  simp only [heatFamilyOneFirst, heatFamilyConnection_slice g c P z hP]

theorem heatFamilyOneZero_slice (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 2 P z) (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z).det) :
    heatFamilyOneZero g c P z = fourHeatOneConnectionZero
      (heatFamilyMetric g c P z)⁻¹
      (fourHeatDensityDrift (fun x => (heatFamilyMetric g c P (x, z.2))⁻¹)
        (fun x => heatFamilyDensity g c P (x, z.2)) z.1)
      (heatNormalFrameConnection g c (fun x => P (x, z.2)))
      (((3 : ℝ) • (1 : Mat4))) z.1 := by
  have hp := hP.differentiableAt (by norm_num)
  have hA (i : Fin 4) (k l : Fin 4) :
      DifferentiableAt ℝ (fun y => heatFamilyConnection g c P i y k l) z :=
    (heatFamilyConnection_contDiffAt 1 g c P z hP hz hframe i k l).differentiableAt one_ne_zero
  have he (i : Fin 4) (k l : Fin 4) :
      (fun x => heatFamilyConnection g c P i (x, z.2) k l) =ᶠ[𝓝 z.1]
        (fun x => heatNormalFrameConnection g c (fun y => P (y, z.2)) i x k l) := by
    have hi : Tendsto (fun x : FourSpace => (x, z.2)) (𝓝 z.1) (𝓝 z) :=
      continuousAt_id.prodMk continuousAt_const
    filter_upwards [hi.eventually (hP.eventually (by simp))] with x hx
    exact congrArg (fun A : Mat4 => A k l)
      (heatFamilyConnection_slice g c P (x, z.2) (hx.differentiableAt (by norm_num)) i)
  have hD (i j : Fin 4) (k l : Fin 4) :
      heatFamilyScalarPartial (fun y => heatFamilyConnection g c P i y k l) j z =
        partialDeriv (fun y => heatNormalFrameConnection g c (fun x => P (x, z.2)) i y k l) j z.1 := by
    rw [heatFamilyScalarPartial_slice _ z (hA i k l) j]
    exact fourHeat_partial_germ (he i k l) j
  have hb : heatFamilyDrift g c P z =
      fourHeatDensityDrift (fun x => (heatFamilyMetric g c P (x, z.2))⁻¹)
        (fun x => heatFamilyDensity g c P (x, z.2)) z.1 := by
    funext j
    exact heatFamilyDrift_slice g c P z hP hz hmetric j
  simp only [heatFamilyOneZero, fourHeatOneConnectionZero, hb,
    heatFamilyConnection_slice g c P z hp, hD]


end
end PositiveEinsteinFour.Geometry
end


section

/-! One global finite-smooth family extends all actual normal
coefficients near a given frame, with a positive leading amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

structure HeatFamilySmoothCoefficients where
  a : HeatRadialFrameSpace → Mat4
  b : HeatRadialFrameSpace → Fin 4 → ℝ
  B : HeatRadialFrameSpace → Fin 4 → HeatMat6
  C : HeatRadialFrameSpace → HeatMat6
  U : HeatRadialFrameSpace → ℝ
  a_regular : ∀ i j, ContDiff ℝ 10 (fun z => a z i j)
  b_regular : ∀ i, ContDiff ℝ 10 (fun z => b z i)
  B_regular : ∀ i k l, ContDiff ℝ 10 (fun z => B z i k l)
  C_regular : ∀ k l, ContDiff ℝ 10 (fun z => C z k l)
  U_regular : ContDiff ℝ 10 U
  U_pos : ∀ z, 0 < U z

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem exists_heatFamilySmoothCoefficients (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z₀ : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 12 P z₀) (hz : (P z₀).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z₀).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z₀).det) :
    ∃ E : HeatFamilySmoothCoefficients,
      E.a =ᶠ[𝓝 z₀] (fun z => (heatFamilyMetric g c P z)⁻¹) ∧
      E.b =ᶠ[𝓝 z₀] heatFamilyDrift g c P ∧
      E.B =ᶠ[𝓝 z₀] heatFamilyFirst g c P ∧
      E.C =ᶠ[𝓝 z₀] heatFamilyZero g c P ∧
      E.U =ᶠ[𝓝 z₀] heatFamilyLeading g c P := by
  choose A hA hAc hAe using fun i j => heatFamily_scalar_extension 10
    (fun z => (heatFamilyMetric g c P z)⁻¹ i j) z₀
    (heatFamilyInverse_contDiffAt 10 g c P z₀ (hP.of_le (by norm_num)) hz hmetric.ne' i j)
  choose b hb hbc hbe using fun i => heatFamily_scalar_extension 10
    (fun z => heatFamilyDrift g c P z i) z₀
    (heatFamilyDrift_contDiffAt 10 g c P z₀ hP hz hmetric i)
  choose B hB hBc hBe using fun i k l => heatFamily_scalar_extension 10
    (fun z => heatFamilyFirst g c P z i k l) z₀
    (heatFamilyFirst_contDiffAt 10 g c P z₀ (hP.of_le (by norm_num)) hz hframe hmetric.ne' i k l)
  choose C hC hCc hCe using fun k l => heatFamily_scalar_extension 10
    (fun z => heatFamilyZero g c P z k l) z₀
    (heatFamilyZero_contDiffAt 10 g c P z₀ hP hz hframe hmetric k l)
  have hUpos : 0 < heatFamilyLeading g c P z₀ := inv_pos.mpr
    (Real.sqrt_pos.mpr (Real.sqrt_pos.mpr hmetric))
  obtain ⟨U, hU, hUp, hUe⟩ := heatFamily_positive_extension 10
    (heatFamilyLeading g c P) z₀
    (heatFamilyLeading_contDiffAt 10 g c P z₀ (hP.of_le (by norm_num)) hz hmetric) hUpos
  refine ⟨{
    a := fun z i j => A i j z
    b := fun z i => b i z
    B := fun z i k l => B i k l z
    C := fun z k l => C k l z
    U := U
    a_regular := hA
    b_regular := hb
    B_regular := hB
    C_regular := hC
    U_regular := hU
    U_pos := hUp }, ?_, ?_, ?_, ?_, hUe⟩
  · filter_upwards [eventually_all.mpr (fun i => eventually_all.mpr (hAe i))] with z hz
    funext i j
    exact hz i j
  · filter_upwards [eventually_all.mpr hbe] with z hz
    funext i
    exact hz i
  · filter_upwards [eventually_all.mpr (fun i => eventually_all.mpr
      (fun k => eventually_all.mpr (hBe i k)))] with z hz
    funext i k l
    exact hz i k l
  · filter_upwards [eventually_all.mpr (fun k => eventually_all.mpr (hCe k))] with z hz
    funext k l
    exact hz k l

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite smooth extensions of the actual normal-frame bundle coefficients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

structure HeatNormalBundleExtension {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) where
  base : HeatNormalExtension 10 g o e
  B : FourSpace → Fin 4 → HeatMat6
  C : FourSpace → HeatMat6
  B_regular : ∀ i k l, ContDiff ℝ 10 (fun x => B x i k l)
  C_regular : ∀ k l, ContDiff ℝ 10 (fun x => C x k l)
  B_near : B =ᶠ[𝓝 0] heatNormalBundleFirst D
  C_near : C =ᶠ[𝓝 0] heatNormalBundleZero D

theorem exists_heatNormalBundleExtension {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) :
    Nonempty (HeatNormalBundleExtension D) := by
  obtain ⟨base⟩ := exists_heatNormalExtension 10 g o e
  choose B hB hBc hBe using fun i k l => heatScalar_extension 10
    (fun x => heatNormalBundleFirst D x i k l)
    ((D.bundleFirst_regular i k l).of_le (by norm_num))
  choose C hC hCc hCe using fun k l => heatScalar_extension 10
    (fun x => heatNormalBundleZero D x k l) (D.bundleZero_regular k l)
  refine ⟨{
    base := base
    B := fun x i k l => B i k l x
    C := fun x k l => C k l x
    B_regular := hB
    C_regular := hC
    B_near := ?_
    C_near := ?_ }⟩
  · have h := eventually_all.mpr (fun i => eventually_all.mpr
      (fun k => eventually_all.mpr (fun l => hBe i k l)))
    filter_upwards [h] with x hx
    funext i k l
    exact hx i k l
  · have h := eventually_all.mpr (fun k => eventually_all.mpr (fun l => hCe k l))
    filter_upwards [h] with x hx
    funext k l
    exact hx k l

theorem HeatNormalBundleExtension.radial_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ k l : Fin 6,
      (∑ i : Fin 4, x i * E.B x i k l) = 0 := by
  filter_upwards [E.B_near, D.bundleFirst_radial_near hRic he] with x hx hrad
  simpa only [hx] using hrad

end
end PositiveEinsteinFour.Geometry
