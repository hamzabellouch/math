section

/-! Existence of an extremizer for the actual subcritical scalar Sobolev
operator, using compactness and the exact weighted Hilbert norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance variationalMinimum_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance variationalMinimum_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarWeightedBaseLp_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) (a : SmoothScalar (M := M)) :
    scalarWeightedBaseLp g o d p hp (smoothScalarToWeightedH1 d a) =ᵐ[normalizedVolume g]
      a.val := by
  have h := scalarWeightedBaseLp_coe g o d p hp (smoothScalarToWeightedH1 d a)
  rw [scalarWeightedH1ToH1_smooth, scalarH1BaseValue_smooth] at h
  exact h.trans (ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
    (⟨a.val, a.property.continuous⟩ : C(M, ℝ)))

theorem scalarWeightedBaseLp_ne_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    scalarWeightedBaseLp g o d p hp ≠ 0 := by
  intro hz
  have h := scalarWeightedBaseLp_smooth g o d p hp (smoothScalarConst 1)
  rw [hz, zero_apply] at h
  have he := (Lp.coeFn_zero ℝ p (normalizedVolume g)).symm.trans h
  obtain ⟨x, hx⟩ := he.exists
  exact zero_ne_one hx

/-- The actual subcritical Sobolev operator attains its norm. -/
theorem scalarWeighted_subcritical_extremal (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4) :
    ∃ u : scalarWeightedH1 d, ‖u‖ = 1 ∧
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) u‖ =
        ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)‖ := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  have hT : 0 < ‖T‖ := by
    by_contra h
    have hn : ‖T‖ ≤ 0 := le_of_not_gt h
    apply scalarWeightedBaseLp_ne_zero g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
    apply ContinuousLinearMap.ext
    intro v
    change T v = 0
    apply norm_eq_zero.mp
    exact le_antisymm ((T.le_opNorm v).trans
      (mul_nonpos_of_nonpos_of_nonneg hn (norm_nonneg v))) (norm_nonneg _)
  have hx (n : ℕ) : ∃ x : scalarWeightedH1 d,
      ‖x‖ < 1 ∧ ‖T‖ - 1 / ((n : ℝ) + 1) < ‖T x‖ :=
    T.exists_lt_apply_of_lt_opNorm (sub_lt_self _ (by positivity))
  choose u hu hTu using hx
  have hnorm : Tendsto (fun n => ‖T (u n)‖) atTop (𝓝 ‖T‖) := by
    have hlo : Tendsto (fun n : ℕ => ‖T‖ - 1 / ((n : ℝ) + 1)) atTop (𝓝 ‖T‖) := by
      simpa only [sub_zero] using tendsto_const_nhds.sub
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le hlo tendsto_const_nhds
      (fun n => (hTu n).le) (fun n => T.unit_le_opNorm _ (hu n).le)
  obtain ⟨y, φ, hφ, hlim⟩ := scalarWeighted_subcritical_subsequence g o d hp hp4 u
    (fun n => (hu n).le)
  have hy : ‖y‖ = ‖T‖ := tendsto_nhds_unique hlim.norm (hnorm.comp hφ.tendsto_atTop)
  have hc := scalar_extremizing_sequence_cauchy T hT (u ∘ φ)
    (fun n => (hu (φ n)).le) y hlim hy
  obtain ⟨x, hxlim⟩ := cauchySeq_tendsto_of_complete hc
  have hxle : ‖x‖ ≤ 1 := le_of_tendsto hxlim.norm (Eventually.of_forall (fun n => (hu (φ n)).le))
  have hTx : T x = y := tendsto_nhds_unique (T.continuous.tendsto x |>.comp hxlim) hlim
  refine ⟨x, le_antisymm hxle ?_, by rw [hTx, hy]⟩
  have hbound := T.le_opNorm x
  rw [hTx, hy] at hbound
  nlinarith

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first distributional product rule from actual H2 approximations. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalar_real_L2_distribution_injective :
    Function.Injective (fun f : L2 => (scalarComplexL2 f : T)) := by
  intro f g h
  have he := scalarL2_distribution_injective h
  apply Lp.ext
  filter_upwards [scalarComplexL2_coe f, scalarComplexL2_coe g] with x hf hg
  have hh : scalarComplexL2 f x = scalarComplexL2 g x := by rw [he]
  rw [hf, hg] at hh
  exact Complex.ofReal_injective hh

/-- The product of H2 factors has an L2 weak derivative with the actual
Leibniz formula. The result identifies the derivative of any L2 realization
of the pointwise product. -/
theorem scalar_real_weak_product (u v w du dv : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T))
    (hv : MemSobolev 2 2 (scalarComplexL2 v : T))
    (hw : (w : V → ℝ) =ᵐ[volume] fun x => u x * v x)
    (i : Fin 4)
    (hdu : scalarCoordinateDerivative i (scalarComplexL2 u : T) = (scalarComplexL2 du : T))
    (hdv : scalarCoordinateDerivative i (scalarComplexL2 v : T) = (scalarComplexL2 dv : T)) :
    ∃ z : L2, scalarCoordinateDerivative i (scalarComplexL2 w : T) = (scalarComplexL2 z : T) ∧
      (z : V → ℝ) =ᵐ[volume] fun x => du x * v x + u x * dv x := by
  obtain ⟨fs, F, F4, _, _, hf, hF, hF4, _, hFco, _⟩ := scalar_real_integer_approximation 2 u hu
  obtain ⟨gs, G, G4, _, _, hg, hG, hG4, _, hGco, _⟩ := scalar_real_integer_approximation 2 v hv
  have hFu : F [] = u := tendsto_nhds_unique (hF [] (by simp)) hf
  have hGv : G [] = v := tendsto_nhds_unique (hG [] (by simp)) hg
  have hFdu : F [i] = du := scalar_real_L2_distribution_injective
    ((scalar_real_jet_limit [i] fs u (F [i]) hf (hF [i] (by simp))).symm.trans hdu)
  have hGdv : G [i] = dv := scalar_real_L2_distribution_injective
    ((scalar_real_jet_limit [i] gs v (G [i]) hg (hG [i] (by simp))).symm.trans hdv)
  let w₀ : L2 := scalarL4Product (F4 []) (G4 [])
  have hww : w₀ = w := by
    apply Lp.ext
    filter_upwards [scalarL4Product_coe (F4 []) (G4 []), hFco [] (by simp), hGco [] (by simp), hw]
      with x hp hfu hgv hwx
    change scalarL4Product (F4 []) (G4 []) x = _
    rw [hp, ← hfu, ← hgv, hFu, hGv, hwx]
  let z : L2 := scalarL4Product (F4 [i]) (G4 []) + scalarL4Product (F4 []) (G4 [i])
  refine ⟨z, ?_, ?_⟩
  · have hvalue : Tendsto (fun k => (scalarRealSchwartzProduct (fs k) (gs k)).toLp 2 volume)
        atTop (𝓝 w) := by
      simp only [scalarRealSchwartzProduct_L2_four]
      rw [← hww]
      exact scalarL4Product_tendsto (hF4 [] (by simp)) (hG4 [] (by simp))
    have hderiv : Tendsto (fun k => (scalarRealSchwartzJet [i]
        (scalarRealSchwartzProduct (fs k) (gs k))).toLp 2 volume) atTop (𝓝 z) := by
      change Tendsto (fun k => (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i}
        (scalarRealSchwartzProduct (fs k) (gs k))).toLp 2 volume) atTop (𝓝 z)
      simp only [scalarRealSchwartzProduct_first_L2]
      exact (scalarL4Product_tendsto (hF4 [i] (by simp)) (hG4 [] (by simp))).add
        (scalarL4Product_tendsto (hF4 [] (by simp)) (hG4 [i] (by simp)))
    exact scalar_real_jet_limit [i] _ w z hvalue hderiv
  · filter_upwards [Lp.coeFn_add (scalarL4Product (F4 [i]) (G4 []))
        (scalarL4Product (F4 []) (G4 [i])),
      scalarL4Product_coe (F4 [i]) (G4 []), scalarL4Product_coe (F4 []) (G4 [i]),
      hFco [i] (by simp), hGco [] (by simp), hFco [] (by simp), hGco [i] (by simp)]
      with x hsum hp hq hdu' hv' hu' hdv'
    change (scalarL4Product (F4 [i]) (G4 []) + scalarL4Product (F4 []) (G4 [i])) x = _
    rw [hsum, Pi.add_apply, hp, hq, ← hdu', ← hv', ← hu', ← hdv', hFdu, hGv, hFu, hGdv]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local covariant derivatives of intrinsic H1 two-forms as actual
bounded maps into Euclidean L2. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Matrix
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormCutoffPartial_smooth (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (i : Fin 4) : ContDiff ℝ ∞ (fun z => partialDeriv χ i z) :=
  (hχ.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const

def twoFormConnectionCutoff (c : M) (S : Mat4) (χ : FourSpace → ℝ)
    (i r s : Fin 4) (z : FourSpace) : ℝ :=
  χ z * chartTwoFormConnection (g := g) c S i z r s

theorem twoFormConnectionCutoff_smooth (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    {K : Set FourSpace} (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hs : tsupport χ ⊆ K)
    (i r s : Fin 4) : ContDiff ℝ ∞ (twoFormConnectionCutoff (g := g) c S χ i r s) :=
  scalarCutoff_contDiff χ _ hχ (fun z hz =>
    chartTwoFormConnection_contDiffAt c S hS i z (hKt (hs hz)) r s)

variable [T3Space M] [MeasurableSpace M] [BorelSpace M] [CompactSpace M] [Nonempty M]

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (i : Fin 4)

def twoFormGramConnectionL2 : TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  ∑ k : Fin 2, ∑ q : Fin 4,
    twoFormGramValueL2 c S hK hKt (twoFormConnectionCutoff (g := g) c S χ i q (v k))
      (twoFormConnectionCutoff_smooth c S hS hKt χ hχ hs i q (v k))
      hc.mul_right (tsupport_mul_subset_left.trans hs) (Function.update v k q)

def twoFormGramCovariantL2 : TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i -
    twoFormGramValueL2 c S hK hKt (fun z => partialDeriv χ i z)
      (twoFormCutoffPartial_smooth χ hχ i) (hc.fderiv_apply ℝ (coordinateVector i))
      ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v -
    twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i

theorem twoFormGramValueL2_coe (u : SmoothH1TwoForm o) :
    twoFormGramValueL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u) =ᵐ[volume]
      fun z => χ z * frameTensor (chartGramMatrix g c S z)
        (twoFormCoordinates o (u : smoothTwoForms o).val c z) v := by
  rw [twoFormGramValueL2_smooth]
  exact (ScalarEuclideanSobolev.valueL2_coe _).trans
    (Filter.Eventually.of_forall (twoFormGramCutoffC1_apply c S hKt χ hχ hc hs v u))

theorem twoFormGramConnectionL2_coe (u : SmoothH1TwoForm o) :
    twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i (smoothTwoFormToH1 u) =ᵐ[volume]
      fun z => χ z * tensorSlotAction (chartTwoFormConnection (g := g) c S i z)
        (frameTensor (chartGramMatrix g c S z)
          (twoFormCoordinates o (u : smoothTwoForms o).val c z)) v := by
  let F := fun k q => twoFormGramValueL2 c S hK hKt
    (twoFormConnectionCutoff (g := g) c S χ i q (v k))
    (twoFormConnectionCutoff_smooth c S hS hKt χ hχ hs i q (v k))
    hc.mul_right (tsupport_mul_subset_left.trans hs) (Function.update v k q)
    (smoothTwoFormToH1 u)
  have he (k : Fin 2) (q : Fin 4) := twoFormGramValueL2_coe c S hK hKt
    (twoFormConnectionCutoff (g := g) c S χ i q (v k))
    (twoFormConnectionCutoff_smooth c S hS hKt χ hχ hs i q (v k))
    hc.mul_right (tsupport_mul_subset_left.trans hs) (Function.update v k q) u
  have hinner : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ k : Fin 2,
      (∑ q, F k q) z = ∑ q, F k q z :=
    Filter.eventually_all.mpr (fun k => Lp.coeFn_finsetSum Finset.univ (F k))
  have hall := Filter.eventually_all.mpr (fun k => Filter.eventually_all.mpr (he k))
  change (∑ k, ∑ q, F k q) =ᵐ[volume] _
  filter_upwards [Lp.coeFn_finsetSum Finset.univ (fun k => ∑ q, F k q), hinner, hall]
    with z hout hin hz
  rw [hout]
  change (∑ k, (∑ q, F k q) z) = _
  calc
    _ = ∑ k : Fin 2, ∑ q : Fin 4,
        twoFormConnectionCutoff (g := g) c S χ i q (v k) z *
          frameTensor (chartGramMatrix g c S z)
            (twoFormCoordinates o (u : smoothTwoForms o).val c z) (Function.update v k q) := by
      apply Finset.sum_congr rfl
      intro k _
      rw [hin k]
      exact Finset.sum_congr rfl (fun q _ => hz k q)
    _ = _ := by
      simp only [twoFormConnectionCutoff, tensorSlotAction, covariantSlotAction,
        Finset.mul_sum, mul_assoc]

theorem twoFormGramCovariantL2_coe (u : SmoothH1TwoForm o) :
    twoFormGramCovariantL2 c S hS hK hKt χ hχ hc hs v i (smoothTwoFormToH1 u) =ᵐ[volume]
      fun z => χ z * frameTensor (chartGramMatrix g c S z)
        (tensorCovariantDirection (connectionMatrix g c)
          (twoFormCoordinates o (u : smoothTwoForms o).val c) i z) v := by
  let D := twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i (smoothTwoFormToH1 u)
  let B := twoFormGramValueL2 c S hK hKt (fun z => partialDeriv χ i z)
    (twoFormCutoffPartial_smooth χ hχ i) (hc.fderiv_apply ℝ (coordinateVector i))
    ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v (smoothTwoFormToH1 u)
  let A := twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i (smoothTwoFormToH1 u)
  have hD : D =ᵐ[volume] fun z =>
      partialDeriv (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val i z := by
    dsimp [D]
    rw [twoFormGramPartialL2_smooth]
    exact ScalarEuclideanSobolev.partialL2_coe _ i
  have hB := twoFormGramValueL2_coe c S hK hKt (fun z => partialDeriv χ i z)
    (twoFormCutoffPartial_smooth χ hχ i) (hc.fderiv_apply ℝ (coordinateVector i))
    ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v u
  have hA := twoFormGramConnectionL2_coe c S hS hK hKt χ hχ hc hs v i u
  change D - B - A =ᵐ[volume] _
  filter_upwards [Lp.coeFn_sub (D - B) A, Lp.coeFn_sub D B, hD, hB, hA]
    with z hsub hsub' hd hb ha
  rw [hsub, Pi.sub_apply, hsub', Pi.sub_apply, hd, hb, ha]
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · exact (twoFormGramCutoff_covariant c S hS hKt χ hχ hc hs v u i z hz).symm
  · have ht : z ∉ tsupport χ := fun h => hz (hKt (hs h))
    have hv : χ z = 0 := image_eq_zero_of_notMem_tsupport ht
    have hdχ : partialDeriv χ i z = 0 := image_eq_zero_of_notMem_tsupport
      (fun h => ht ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h))
    have hdv : partialDeriv (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hz (hKt
        (twoFormGramCutoffC1_support c S hKt χ hχ hc hs v u
          ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h))))
    rw [hv, hdχ, hdv, zero_mul, zero_mul, zero_mul, sub_self, sub_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normal metric as a jointly regular pullback in the common
radial-frame family. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heatFamilyBasePartial_slice (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (z : HeatRadialFrameSpace) (hP : DifferentiableAt ℝ P z) (i : Fin 4) :
    (heatFamilyPartial P i z).1 =
      fderiv ℝ (fun x => (P (x, z.2)).1) z.1 (coordinateVector i) := by
  have hs : DifferentiableAt ℝ (fun x : FourSpace => P (x, z.2)) z.1 :=
    hP.comp z.1 (differentiableAt_id.prodMk (differentiableAt_const z.2))
  rw [heatFamilyPartial_slice P z hP i]
  exact (congrArg (fun L : FourSpace →L[ℝ] FourSpace => L (coordinateVector i))
    hs.hasFDerivAt.fst.fderiv).symm

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyMetric (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace) : Mat4 :=
  fun i j => WithLp.ofLp (heatFamilyPartial P i z).1 ⬝ᵥ
    (metricInChart g c (P z).1 *ᵥ WithLp.ofLp (heatFamilyPartial P j z).1)

theorem heatFamilyMetric_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target) (i j : Fin 4) :
    ContDiffAt ℝ n (fun y => heatFamilyMetric g c P y i j) z := by
  have hP0 : ContDiffAt ℝ n P z := hP.of_le (by exact_mod_cast Nat.le_succ n)
  have hD (a b : Fin 4) : ContDiffAt ℝ n
      (fun y => (heatFamilyPartial P a y).1 b) z := by
    let π : FourSpace →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 4 => ℝ) b
    exact π.contDiff.contDiffAt.comp z (heatFamilyPartial_contDiffAt n P z hP a).fst
  have hG (a b : Fin 4) : ContDiffAt ℝ n
      (fun y => metricInChart g c (P y).1 a b) z := by
    exact ContDiffAt.comp (f := fun y => (P y).1)
      (g := fun w => metricInChart g c w a b) z
      ((metricInChart_contDiffAt g c (P z).1 hz a b).of_le (by simp)) hP0.fst
  unfold heatFamilyMetric dotProduct Matrix.mulVec
  apply ContDiffAt.sum
  intro a _
  apply (hD i a).mul
  apply ContDiffAt.sum
  intro b _
  exact (hG a b).mul (hD j b)

variable [T3Space M] [CompactSpace M]

theorem heatFamilyMetric_exponential_germ (g : SmoothMetric M) (o : FrameOrientation g)
    (c : M) (e : FrameBundle g) (he : e.base ∈ (chartAt FourSpace c).source)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hP : ContDiffAt ℝ 1 P (0, frameCoordinateState g c e))
    (hexp : (fun v => (P (v, frameCoordinateState g c e)).1) =ᶠ[𝓝 0]
      (fun v => chartAt FourSpace c (frameExponential g o e v))) :
    (fun v => heatFamilyMetric g c P (v, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalMetric g o e := by
  let q := frameCoordinateState g c e
  have hi : Tendsto (fun v : FourSpace => (v, q)) (𝓝 0) (𝓝 (0, q)) :=
    (continuous_id.prodMk continuous_const).continuousAt
  have hr := hi.eventually (hP.eventually (by simp))
  have hs : ∀ᶠ v in 𝓝 (0 : FourSpace), frameExponential g o e v ∈
      (chartAt FourSpace c).source :=
    (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
      ((chartAt FourSpace c).open_source.mem_nhds (by simpa only [frameExponential_zero] using he))
  filter_upwards [hr, hexp.eventuallyEq_nhds, hs] with v hv hvg hvs
  ext i j
  have hd := hvg.fderiv_eq (𝕜 := ℝ)
  rw [heatNormalMetric_chart_pairing g o e c v hvs i j]
  change WithLp.ofLp (heatFamilyPartial P i (v, q)).1 ⬝ᵥ
    (metricInChart g c (P (v, q)).1 *ᵥ WithLp.ofLp (heatFamilyPartial P j (v, q)).1) = _
  rw [heatFamilyBasePartial_slice P (v, q) (hv.differentiableAt one_ne_zero) i,
    heatFamilyBasePartial_slice P (v, q) (hv.differentiableAt one_ne_zero) j]
  dsimp only [Prod.fst, Prod.snd, q]
  have hb : (P (v, frameCoordinateState g c e)).1 =
      chartAt FourSpace c (frameExponential g o e v) := hvg.self_of_nhds
  rw [hb, hd]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smoothness of the actual inverse normal metric, by the finite adjugate
formula. No choice of matrix norm or inverse regularity is assumed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped Manifold ContDiff

noncomputable section

private theorem heatMatrixDeterminant_smoothAt (A : FourSpace → Mat4) (x : FourSpace)
    (hA : ∀ i j, ContDiffAt ℝ ∞ (fun y => A y i j) x) :
    ContDiffAt ℝ ∞ (fun y => (A y).det) x := by
  simp only [Matrix.det_apply']
  apply ContDiffAt.sum
  intro σ _
  exact contDiffAt_const.mul (contDiffAt_prod fun i _ => hA (σ i) i)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalInverse_smoothAt_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (i j : Fin 4) :
    ContDiffAt ℝ ∞ (fun v => (heatNormalMetric g o e v)⁻¹ i j) 0 := by
  let A := heatNormalMetric g o e
  have hA : ∀ i j, ContDiffAt ℝ ∞ (fun v => A v i j) 0 :=
    heatNormalMetric_smoothAt_zero g o e
  have hinv : ContDiffAt ℝ ∞ (fun v => ((A v).det)⁻¹) 0 :=
    (heatMatrixDeterminant_smoothAt A 0 hA).inv (by
      change (heatNormalMetric g o e 0).det ≠ 0
      rw [heatNormalMetric_zero, Matrix.det_one]
      norm_num)
  have hadj : ContDiffAt ℝ ∞ (fun v => (A v).adjugate i j) 0 := by
    simp only [Matrix.adjugate_apply]
    apply heatMatrixDeterminant_smoothAt
    intro r t
    by_cases hr : r = j
    · subst r
      simpa only [Matrix.updateRow_self] using
        (contDiffAt_const : ContDiffAt ℝ ∞
          (fun _ : FourSpace => (Pi.single i (1 : ℝ) : Fin 4 → ℝ) t) 0)
    · simpa only [Matrix.updateRow_ne hr] using hA r t
  simpa only [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
    using hinv.mul hadj

end
end PositiveEinsteinFour.Geometry
end


section

/-! Transport of the actual normal metric and its inverse by the base
Jacobian of the constructed frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_matrix_congruence_pairing (H J : Mat4) (i j : Fin 4) :
    (Jᵀ * H * J) i j = (fun r => J r i) ⬝ᵥ (H *ᵥ fun r => J r j) := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, dotProduct, Matrix.mulVec,
    Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  ring

theorem heat_matrix_inverse_congruence (H J : Mat4) (hJ : IsUnit J.det) :
    J * (Jᵀ * H * J)⁻¹ * Jᵀ = H⁻¹ := by
  have hJt : IsUnit Jᵀ.det := by simpa only [Matrix.det_transpose] using hJ
  rw [Matrix.mul_inv_rev, Matrix.mul_inv_rev]
  calc
    _ = (J * J⁻¹) * H⁻¹ * (Jᵀ⁻¹ * Jᵀ) := by simp only [Matrix.mul_assoc]
    _ = H⁻¹ := by rw [Matrix.mul_nonsing_inv J hJ, Matrix.nonsing_inv_mul Jᵀ hJt]; simp

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.metric_pullback {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source) :
    heatNormalMetric g o e x =
      (jacobianMatrix (fun y => (D.point y).1) x)ᵀ *
        metricInChart g c (D.point x).1 * jacobianMatrix (fun y => (D.point y).1) x := by
  have hF : (fun y => (D.point y).1) =ᶠ[𝓝 x]
      (fun y => chartAt FourSpace c (frameExponential g o e y)) := by
    filter_upwards [isOpen_ball.mem_nhds hx] with y hy
    exact D.exponential y hy
  have hd : fderiv ℝ (fun y => (D.point y).1) x =
      fderiv ℝ (fun y => chartAt FourSpace c (frameExponential g o e y)) x := hF.fderiv_eq
  ext i j
  rw [heat_matrix_congruence_pairing]
  have h := heatNormalMetric_chart_pairing g o e c x hs i j
  rw [← hd, ← D.exponential x hx] at h
  exact h

theorem HeatNormalFrameData.inverseMetric_transport {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hg : (heatNormalMetric g o e x).det ≠ 0) :
    jacobianMatrix (fun y => (D.point y).1) x * (heatNormalMetric g o e x)⁻¹ *
      (jacobianMatrix (fun y => (D.point y).1) x)ᵀ = (metricInChart g c (D.point x).1)⁻¹ := by
  have hG := D.metric_pullback x hx hs
  have hJ : IsUnit (jacobianMatrix (fun y => (D.point y).1) x).det := by
    apply isUnit_iff_ne_zero.mpr
    intro hz
    apply hg
    rw [hG, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hz]
    ring
  rw [hG]
  exact heat_matrix_inverse_congruence _ _ hJ

theorem HeatNormalFrameData.inverseMetric_transport_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    ∀ᶠ x in 𝓝 (0 : FourSpace),
      jacobianMatrix (fun y => (D.point y).1) x * (heatNormalMetric g o e x)⁻¹ *
        (jacobianMatrix (fun y => (D.point y).1) x)ᵀ = (metricInChart g c (D.point x).1)⁻¹ := by
  have hs : ∀ᶠ x in 𝓝 (0 : FourSpace), frameExponential g o e x ∈
      (chartAt FourSpace c).source :=
    (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
      ((chartAt FourSpace c).open_source.mem_nhds (by simpa only [frameExponential_zero] using he))
  filter_upwards [hs, ball_mem_nhds (0 : FourSpace) D.radius_pos,
    heatNormalMetric_eventually_nondegenerate g o e] with x hs hx hg
  exact D.inverseMetric_transport x hx hs hg

end
end PositiveEinsteinFour.Geometry
end


section

/-! Linear operations and local vanishing for the actual radial integral. -/
namespace PositiveEinsteinFour.Geometry
open EinsteinFour Set Filter MeasureTheory
open scoped BigOperators ContDiff _root_.Topology Interval
noncomputable section

theorem heatWeighted_integrable (m : ℕ) (U F : FourSpace → ℝ)
    (hU : Continuous U) (hF : Continuous F) (hU0 : ∀ x, U x ≠ 0) (x : FourSpace) :
    IntervalIntegrable (fun s : ℝ => s ^ m * (F (s • x) / U (s • x))) volume 0 1 := by
  have hs : Continuous (fun s : ℝ => s • x) := continuous_id.smul continuous_const
  exact ((continuous_id.pow m).mul ((hF.comp hs).div (hU.comp hs)
    (fun s => hU0 (s • x)))).intervalIntegrable 0 1

theorem fourHeatWeightedRadialAverage_sum {ι : Type*} [Fintype ι]
    (m : ℕ) (U : FourSpace → ℝ) (F : ι → FourSpace → ℝ)
    (hU : Continuous U) (hF : ∀ i, Continuous (F i)) (hU0 : ∀ x, U x ≠ 0) (x : FourSpace) :
    fourHeatWeightedRadialAverage m U (fun y => ∑ i, F i y) x =
      ∑ i, fourHeatWeightedRadialAverage m U (F i) x := by
  unfold fourHeatWeightedRadialAverage fourHeatRadialAverage
  simp only [Finset.sum_div, Finset.mul_sum]
  rw [intervalIntegral.integral_finsetSum (fun i _ => heatWeighted_integrable m U (F i) hU (hF i) hU0 x)]
  rw [Finset.mul_sum]

theorem fourHeatWeightedRadialAverage_add (m : ℕ) (U F G : FourSpace → ℝ)
    (hU : Continuous U) (hF : Continuous F) (hG : Continuous G) (hU0 : ∀ x, U x ≠ 0)
    (x : FourSpace) :
    fourHeatWeightedRadialAverage m U (fun y => F y + G y) x =
      fourHeatWeightedRadialAverage m U F x + fourHeatWeightedRadialAverage m U G x := by
  unfold fourHeatWeightedRadialAverage fourHeatRadialAverage
  simp only [add_div, mul_add]
  rw [intervalIntegral.integral_add (heatWeighted_integrable m U F hU hF hU0 x)
    (heatWeighted_integrable m U G hU hG hU0 x)]
  ring

theorem fourHeatWeightedRadialAverage_const_mul (m : ℕ) (U F : FourSpace → ℝ) (a : ℝ)
    (x : FourSpace) :
    fourHeatWeightedRadialAverage m U (fun y => a * F y) x =
      a * fourHeatWeightedRadialAverage m U F x := by
  unfold fourHeatWeightedRadialAverage fourHeatRadialAverage
  have he (s : ℝ) : s ^ m * (a * F (s • x) / U (s • x)) =
      a * (s ^ m * (F (s • x) / U (s • x))) := by ring
  simp_rw [he]
  rw [intervalIntegral.integral_const_mul]
  ring

theorem fourHeatWeightedRadialAverage_zero_germ (m : ℕ) (U F : FourSpace → ℝ)
    (hF : F =ᶠ[𝓝 0] fun _ => 0) :
    fourHeatWeightedRadialAverage m U F =ᶠ[𝓝 0] fun _ => 0 := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hF
  filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) hr] with x hx
  have hz : fourHeatRadialAverage m (fun y => F y / U y) x = 0 := by
    unfold fourHeatRadialAverage
    have he : (∫ s : ℝ in 0..1, s ^ m * (F (s • x) / U (s • x))) =
        ∫ _s : ℝ in 0..1, (0 : ℝ) := by
      apply intervalIntegral.integral_congr
      intro s hs
      have hs' : s ∈ Icc (0 : ℝ) 1 := by simpa only [uIcc_of_le zero_le_one] using hs
      have hnorm : ‖s • x‖ ≤ ‖x‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hs'.1]
        exact mul_le_of_le_one_left (norm_nonneg x) hs'.2
      have hmem : s • x ∈ Metric.ball (0 : FourSpace) r := by
        rw [Metric.mem_ball, dist_zero_right]
        exact hnorm.trans_lt (by simpa only [Metric.mem_ball, dist_zero_right] using hx)
      change s ^ m * (F (s • x) / U (s • x)) = 0
      rw [hball hmem, zero_div, mul_zero]
    rw [he]
    simp
  change U x * fourHeatRadialAverage m (fun y => F y / U y) x = 0
  rw [hz, mul_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarBaseSpectralEquiv := (scalarBaseEigenbasis g o d).repr


def scalarBaseSpectralMultiplier
    (a : ScalarBaseEigenIndex g o d → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ μ, |a μ| ≤ C) : Lp ℝ 2 (normalizedVolume g) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarBaseSpectralEquiv g o d).symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((lp.mapCLM 2
      (fun μ => a μ • ContinuousLinearMap.id ℝ (ℝ))
      hC (fun μ => by
        calc
          ‖a μ • ContinuousLinearMap.id ℝ (ℝ)‖ ≤ |a μ| := by
            apply ContinuousLinearMap.opNorm_le_bound _ (abs_nonneg _)
            intro v
            change ‖a μ • v‖ ≤ |a μ| * ‖v‖
            rw [norm_smul, Real.norm_eq_abs]
          _ ≤ C := ha μ)).comp
      (scalarBaseSpectralEquiv g o d).toContinuousLinearEquiv.toContinuousLinearMap)

theorem scalarBaseSpectralMultiplier_coordinate
    (a : ScalarBaseEigenIndex g o d → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ μ, |a μ| ≤ C) (f : Lp ℝ 2 (normalizedVolume g)) (μ : ScalarBaseEigenIndex g o d) :
    (scalarBaseSpectralEquiv g o d (scalarBaseSpectralMultiplier g o d a C hC ha f)) μ =
      a μ • (scalarBaseSpectralEquiv g o d f) μ := by
  change ((scalarBaseSpectralEquiv g o d)
    ((scalarBaseSpectralEquiv g o d).symm _)) μ = _
  rw [LinearIsometryEquiv.apply_symm_apply]
  rfl

theorem scalarBaseSpectralMultiplier_norm
    (a : ScalarBaseEigenIndex g o d → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ μ, |a μ| ≤ C) (f : Lp ℝ 2 (normalizedVolume g)) :
    ‖scalarBaseSpectralMultiplier g o d a C hC ha f‖ ≤ C * ‖f‖ := by
  rw [← (scalarBaseSpectralEquiv g o d).norm_map (scalarBaseSpectralMultiplier g o d a C hC ha f),
    ← (scalarBaseSpectralEquiv g o d).norm_map f]
  calc
    _ ≤ ‖C • scalarBaseSpectralEquiv g o d f‖ := by
      apply lp.norm_mono (by norm_num : (2 : ℝ≥0∞) ≠ 0)
      intro μ
      rw [scalarBaseSpectralMultiplier_coordinate, norm_smul, Real.norm_eq_abs]
      change |a μ| * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ≤
        ‖C • (scalarBaseSpectralEquiv g o d f) μ‖
      change |a μ| * |(scalarBaseSpectralEquiv g o d f) μ| ≤
        |C * (scalarBaseSpectralEquiv g o d f) μ|
      rw [abs_mul, abs_of_nonneg hC]
      exact mul_le_mul_of_nonneg_right (ha μ) (abs_nonneg _)
    _ = _ := by rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hC]

theorem scalarBaseSpectralMultiplier_inner
    (a : ScalarBaseEigenIndex g o d → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ μ, |a μ| ≤ C) (f h : Lp ℝ 2 (normalizedVolume g)) :
    inner ℝ (scalarBaseSpectralMultiplier g o d a C hC ha f) h =
      ∑' μ, a μ * inner ℝ ((scalarBaseSpectralEquiv g o d f) μ)
        ((scalarBaseSpectralEquiv g o d h) μ) := by
  rw [← (scalarBaseSpectralEquiv g o d).inner_map_map, lp.inner_eq_tsum]
  apply tsum_congr
  intro μ
  rw [scalarBaseSpectralMultiplier_coordinate, real_inner_smul_left]

theorem scalarBaseSpectralMultiplier_selfAdjoint
    (a : ScalarBaseEigenIndex g o d → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ μ, |a μ| ≤ C) (f h : Lp ℝ 2 (normalizedVolume g)) :
    inner ℝ (scalarBaseSpectralMultiplier g o d a C hC ha f) h =
      inner ℝ f (scalarBaseSpectralMultiplier g o d a C hC ha h) := by
  calc
    _ = ∑' μ, a μ * inner ℝ ((scalarBaseSpectralEquiv g o d f) μ)
        ((scalarBaseSpectralEquiv g o d h) μ) := scalarBaseSpectralMultiplier_inner g o d a C hC ha f h
    _ = ∑' μ, a μ * inner ℝ ((scalarBaseSpectralEquiv g o d h) μ)
        ((scalarBaseSpectralEquiv g o d f) μ) := by
      apply tsum_congr
      intro μ
      rw [real_inner_comm]
    _ = inner ℝ (scalarBaseSpectralMultiplier g o d a C hC ha h) f :=
      (scalarBaseSpectralMultiplier_inner g o d a C hC ha h f).symm
    _ = _ := real_inner_comm _ _

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and the invertible affine rescaling
in the local smooth representative of the actual scalar weak eigenfunction. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance eigenUnweighting_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_eigen_local_chart_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (u : scalarH1 d) (κ : ℝ)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        κ * inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v)) (c : M) (z₀ : ChartTarget c) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ F : FourSpace → ℝ, ContDiffOn ℝ (⊤ : ℕ∞) F U ∧
        (fun z => scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z)) =ᵐ[
          volume.restrict U] F := by
  obtain ⟨r, hr, ht, w, hw, hreg⟩ := scalar_eigen_local_all_orders g o d u κ hw c z₀
  obtain ⟨F, hF, hFw⟩ := scalar_half_smooth_real_representative w
    (fun n φ hc hs => hreg n φ hc (hs.trans ball_subset_closedBall))
  have hwsmall : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarH1BaseValue g o d u ((chartAt FourSpace c).symm
        (scalarRescaledPoint g c z₀ r y))) =ᵐ[
      volume.restrict (ball (0 : FourSpace) (1 / 8))] w :=
    ae_restrict_of_ae_restrict_of_subset
      (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1)) hw
  have heq := hwsmall.trans hFw
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) (1 / 8)}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    norm_num
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1) hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContDiffOn ℝ (⊤ : ℕ∞) H U := by
    intro z hz
    apply ContDiffAt.contDiffWithinAt
    exact ((hF.contDiffAt).comp z
      (A.symm.contDiff.contDiffAt.comp z (contDiffAt_id.sub contDiffAt_const))).div
      (chartVolumeDensity_contDiffAt g c z (hUt hz))
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual first weak derivative of the localized H2 composition. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv ContDiff NNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (f : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} f

theorem scalar_localized_H2_composition_derivative (u : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) (Du : Fin 4 → L2)
    (hDu : ∀ i, scalarCoordinateDerivative i (scalarComplexL2 u : T) = (scalarComplexL2 (Du i) : T))
    (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) {C : ℝ≥0} (hLip : LipschitzWith C φ)
    (hzero : φ 0 = 0) {B₁ B₂ : ℝ} (h₁ : ∀ s, |deriv φ s| ≤ B₁)
    (h₂ : ∀ s, |deriv (deriv φ) s| ≤ B₂) :
    ∃ v : L2, MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] (fun x => χ x * φ (u x)) ∧
      ∀ i, scalarCoordinateDerivative i (scalarComplexL2 v : T) =
        (scalarComplexL2 (scalarRealSchwartzMultiply (D i χ) (hLip.compLp hzero u) +
          scalarRealSchwartzMultiply χ (scalarDerivativeMultiplier φ hφ h₁ u
            (Lp.aestronglyMeasurable u) (Du i))) : T) := by
  obtain ⟨v, hv, hve⟩ := scalar_localized_H2_composition u hu χ hc φ hφ hLip hzero h₁ h₂
  obtain ⟨fs, G, _, _, hpoint, hf, hG, _, _⟩ := scalar_real_H2_approximation_ae u hu
  let U₀ := hLip.compLp hzero u
  let Un : ℕ → L2 := fun k => hLip.compLp hzero ((fs k).toLp 2 volume)
  have hU : Tendsto Un atTop (𝓝 U₀) :=
    (hLip.continuous_compLp hzero).continuousAt.tendsto.comp hf
  have hvalue : scalarRealSchwartzMultiply χ U₀ = v := by
    apply Lp.ext
    filter_upwards [scalarRealSchwartzMultiply_coe χ U₀, hLip.coeFn_compLp hzero u, hve]
      with x hm hu' hv'
    rw [hm, hu', Function.comp_apply, hv']
  refine ⟨v, hv, hve, fun i => ?_⟩
  have hGi : G i = Du i := scalar_real_L2_distribution_injective
    ((scalar_real_jet_limit [i] fs u (G i) hf (hG i)).symm.trans (hDu i))
  have hT := scalarDerivativeMultiplier_tendsto φ hφ h₁ (fun k x => fs k x) u
    (fun k => (fs k).continuous.aestronglyMeasurable) (Lp.aestronglyMeasurable u)
    hpoint (fun k => (D i (fs k)).toLp 2 volume) (G i) (hG i)
  rw [hGi] at hT
  have hlocal : Tendsto (fun k => (scalarLocalizedCompose χ hc φ hφ (fs k)).toLp 2 volume)
      atTop (𝓝 v) := by
    simp only [scalarLocalizedCompose_valueLp χ hc φ hφ hLip hzero]
    rw [← hvalue]
    exact (scalarRealSchwartzMultiply χ).continuous.continuousAt.tendsto.comp hU
  have hfirst : Tendsto (fun k => (D i (scalarLocalizedCompose χ hc φ hφ (fs k))).toLp 2 volume)
      atTop (𝓝 (scalarRealSchwartzMultiply (D i χ) U₀ +
        scalarRealSchwartzMultiply χ (scalarDerivativeMultiplier φ hφ h₁ u
          (Lp.aestronglyMeasurable u) (Du i)))) := by
    simp only [scalarLocalizedCompose_first_L2 χ hc φ hφ hLip hzero h₁]
    exact ((scalarRealSchwartzMultiply (D i χ)).continuous.continuousAt.tendsto.comp hU).add
      ((scalarRealSchwartzMultiply χ).continuous.continuousAt.tendsto.comp hT)
  exact scalar_real_jet_limit [i] (fun k => scalarLocalizedCompose χ hc φ hφ (fs k)) v _ hlocal hfirst

end
end PositiveEinsteinFour.Geometry
end


section

/-! The H3 algebra in dimension four, using the actual H2-by-H3 product
and the first distributional Leibniz identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_real_sobolev_add (s : ℝ) (u v : L2)
    (hu : MemSobolev s 2 (scalarComplexL2 u : T))
    (hv : MemSobolev s 2 (scalarComplexL2 v : T)) :
    MemSobolev s 2 (scalarComplexL2 (u + v) : T) := by
  have he : (scalarComplexL2 (u + v) : T) = (scalarComplexL2 u : T) + (scalarComplexL2 v : T) := by
    change (Lp.toTemperedDistributionCLM ℂ volume 2)
      ((Complex.ofRealCLM.compLpL 2 (volume : Measure V)) (u + v)) = _
    rw [map_add, map_add]
    rfl
  rw [he]
  exact hu.add hv

/-- Two H3 functions have an actual H3 pointwise product. -/
theorem scalar_real_H3_product (u v : L2)
    (hu : MemSobolev 3 2 (scalarComplexL2 u : T))
    (hv : MemSobolev 3 2 (scalarComplexL2 v : T)) :
    ∃ w : L2, MemSobolev 3 2 (scalarComplexL2 w : T) ∧
      (w : V → ℝ) =ᵐ[volume] fun x => u x * v x := by
  obtain ⟨w, hw, hwe⟩ := scalar_real_H2_H3_product u v (hu.mono (by norm_num)) hv
  refine ⟨w, ?_, hwe⟩
  have hh := scalar_memSobolev_succ_iff 2 (scalarComplexL2 w : T)
  norm_num only [show (2 : ℝ) + 1 = 3 by norm_num] at hh
  apply hh.mpr
  refine ⟨hw, fun i => ?_⟩
  obtain ⟨du, hdu, hdu2⟩ := scalar_real_derivative_sobolev 2 u (by norm_num; exact hu) i
  obtain ⟨dv, hdv, hdv2⟩ := scalar_real_derivative_sobolev 2 v (by norm_num; exact hv) i
  obtain ⟨a, ha, hae⟩ := scalar_real_H2_H3_product du v hdu2 hv
  obtain ⟨b, hb, hbe⟩ := scalar_real_H2_H3_product dv u hdv2 hu
  obtain ⟨z, hz, hze⟩ := scalar_real_weak_product u v w du dv
    (hu.mono (by norm_num)) (hv.mono (by norm_num)) hwe i hdu hdv
  have he : z = a + b := by
    apply Lp.ext
    filter_upwards [hze, hae, hbe, Lp.coeFn_add a b] with x hz ha hb hab
    rw [hz, hab, Pi.add_apply, ha, hb]
    ring
  rw [hz, he]
  exact scalar_real_sobolev_add 2 a b ha hb

end
end PositiveEinsteinFour.Geometry
end


section

/-! Division by the actual smooth positive chart density at finite Sobolev orders. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric Filter
open scoped SchwartzMap ENNReal ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)
local notation "L2" => Lp ℂ 2 (volume : Measure V)

private def integerDensityCutoffL2 (φ : S) (w : L2) : L2 :=
  scalarL2Multiply (φ.toLp ∞ volume) w

private theorem integerDensityCutoffL2_distribution (φ : S) (w : L2) :
    (integerDensityCutoffL2 φ w : T) = smulLeftCLM ℂ φ (w : T) := by
  unfold integerDensityCutoffL2
  rw [SchwartzMap.toLp]
  exact scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp ∞ volume) w

private theorem integerDensityCutoffL2_coe (φ : S) (w : L2) :
    (integerDensityCutoffL2 φ w : V → ℂ) =ᵐ[volume] fun y => φ y * w y := by
  change (((φ.toLp ∞ volume) • w : L2) : V → ℂ) =ᵐ[volume] _
  filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) (φ.toLp ∞ volume) w,
    φ.coeFn_toLp ∞ volume] with y hy hφ
  simpa only [smul_eq_mul, Pi.mul_apply, hφ] using hy

private theorem integerDensityCutoff_support (χ ρ : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hρ : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y) :
    tsupport ((scalarCutoffSchwartz χ (fun y => (ρ y)⁻¹) hχ hc hρ) : V → ℂ) ⊆
      tsupport χ :=
  (tsupport_comp_subset (g := Complex.ofReal) (by simp)
    (fun y => χ y * (ρ y)⁻¹)).trans tsupport_mul_subset_left

theorem scalar_integer_density_division (n : ℕ) (ρ b : V → ℝ) (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ ball (0 : V) (1 / 2))
    (hρ : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y)
    (hρ0 : ∀ y ∈ tsupport χ, ρ y ≠ 0) :
    ∃ v : L2, MemSobolev (n : ℝ) 2 (v : T) ∧
      (v : V → ℂ) =ᵐ[volume] fun y => (χ y * b y : ℝ) := by
  let φ := scalarCutoffSchwartz χ (fun y => (ρ y)⁻¹) hχ hc hρ
  have hφχ : tsupport (φ : V → ℂ) ⊆ tsupport χ := integerDensityCutoff_support χ ρ hχ hc hρ
  have hφc : HasCompactSupport (φ : V → ℂ) :=
    hc.of_isClosed_subset (isClosed_tsupport _) hφχ
  have hφs : tsupport (φ : V → ℂ) ⊆ ball (0 : V) (1 / 2) :=
    hφχ.trans hs
  refine ⟨integerDensityCutoffL2 φ (scalarComplexL2 w), ?_, ?_⟩
  · rw [integerDensityCutoffL2_distribution]
    exact hreg φ hφc hφs
  have hglob := (ae_restrict_iff' isOpen_ball.measurableSet).mp heq
  filter_upwards [integerDensityCutoffL2_coe φ (scalarComplexL2 w), scalarComplexL2_coe w,
    hglob] with y hv hw hy
  rw [hv, hw]
  change ((χ y * (ρ y)⁻¹ : ℝ) : ℂ) * (w y : ℂ) = _
  by_cases hz : χ y = 0
  · simp only [hz, zero_mul, Complex.ofReal_zero]
  · have ht : y ∈ tsupport χ := subset_tsupport χ hz
    have hin : y ∈ ball (0 : V) 1 := ball_subset_ball (by norm_num : (1 / 2 : ℝ) ≤ 1) (hs ht)
    rw [← hy hin, ← Complex.ofReal_mul]
    congr 1
    calc
      χ y * (ρ y)⁻¹ * (ρ y * b y) = χ y * ((ρ y)⁻¹ * ρ y) * b y := by ring
      _ = χ y * b y := by rw [inv_mul_cancel₀ (hρ0 y ht), mul_one]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The reciprocal-variable Hessian identity in the subcritical scalar
equation used to prove the sharp four-dimensional Sobolev inequality. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix MeasureTheory
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {μ : Measure (FrameBundle g)}
  {d : MetricGreenData g μ} {a : M → ℝ}

theorem scalar_inverse_cube_gradient (s : ScalarCovariantData d a)
    (ha : ∀ x, a x ≠ 0)
    (v : ScalarCovariantData d (fun x => (a x ^ 3)⁻¹))
    (e : FrameBundle g) (i : Fin 4) :
    scalarGradient g (fun x => (a x ^ 3)⁻¹) e i =
      (-3 / a e.base ^ 4) * scalarGradient g a e i := by
  obtain ⟨e₀, he⟩ := ((d.flow i).map 0).surjective e
  have h := v.derivativeValue i 0 e₀
  have h' := ((s.derivativeValue i 0 e₀).pow 3).inv
    (pow_ne_zero 3 (ha _))
  simp only [Pi.pow_apply] at h'
  have heq := h.unique h'
  rw [he] at heq
  rw [heq]
  field_simp [ha e.base]
  ring

theorem scalar_reciprocal_equation_derivative (s : ScalarCovariantData d a)
    (p : ℝ) (ha : ∀ x, 0 < a x)
    (hEq : ∀ e : FrameBundle g,
      a e.base * scalarLaplacian g a e -
        2 * (∑ i, scalarGradient g a e i ^ 2) + 2 * a e.base ^ 2 =
          2 * (a e.base) ^ (4 - p))
    (e : FrameBundle g) (j : Fin 4) :
    a e.base * (∑ i, scalarThird g a e j i i) -
        4 * (∑ i, scalarGradient g a e i * scalarHessian g a e i j) +
        scalarLaplacian g a e * scalarGradient g a e j +
        4 * a e.base * scalarGradient g a e j =
      2 * (4 - p) * (a e.base) ^ (3 - p) * scalarGradient g a e j := by
  obtain ⟨e₀, he⟩ := ((d.flow j).map 0).surjective e
  have hL := (((s.derivativeValue j 0 e₀).mul (s.derivativeLaplacian j 0 e₀)).sub
    ((HasDerivAt.fun_sum (fun i (_ : i ∈ Finset.univ) =>
      (s.derivativeGradient j i 0 e₀).pow 2)).const_mul 2)).add
        (((s.derivativeValue j 0 e₀).pow 2).const_mul 2)
  have hR := ((s.derivativeValue j 0 e₀).rpow_const
    (p := 4 - p) (Or.inl (ne_of_gt (ha _)))).const_mul 2
  have hf : (fun t => a ((d.flow j).map t e₀).base *
      scalarLaplacian g a ((d.flow j).map t e₀) -
        2 * (∑ i, scalarGradient g a ((d.flow j).map t e₀) i ^ 2) +
          2 * a ((d.flow j).map t e₀).base ^ 2) =
        (fun t => 2 * (a ((d.flow j).map t e₀).base) ^ (4 - p)) :=
    funext (fun t => hEq _)
  change HasDerivAt (fun t => a ((d.flow j).map t e₀).base *
      scalarLaplacian g a ((d.flow j).map t e₀) -
        2 * (∑ i, scalarGradient g a ((d.flow j).map t e₀) i ^ 2) +
          2 * a ((d.flow j).map t e₀).base ^ 2) _ 0 at hL
  rw [hf] at hL
  have h := hL.unique hR
  rw [he] at h
  have hexp : 4 - p - 1 = 3 - p := by ring
  simp only [hexp, Nat.cast_ofNat, Nat.reduceSub, pow_one] at h
  have hs : (∑ i, 2 * scalarGradient g a e i * scalarHessian g a e j i) =
      2 * (∑ i, scalarGradient g a e i * scalarHessian g a e i j) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [s.hessianSymmetric e j i]
    ring
  rw [hs] at h
  linarith only [h]

theorem scalar_inverse_hessian_algebra (x L D : ℝ) (hx : x ≠ 0)
    (v : Fin 4 → ℝ) (H : Matrix (Fin 4) (Fin 4) ℝ) (j : Fin 4) :
    (∑ i, ((-3 / x ^ 4) * v i) *
      (H i j - if i = j then L / 4 else 0)) +
      (3 / 4 : ℝ) * (x ^ 3)⁻¹ * (D + 4 * v j) =
        (3 / 4 : ℝ) / x ^ 4 *
          (x * D - 4 * (∑ i, v i * H i j) + L * v j + 4 * x * v j) := by
  have hs : (∑ i, v i * (if i = j then L / 4 else 0)) = v j * L / 4 := by
    simp only [mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    ring
  simp_rw [mul_sub, mul_assoc, Finset.sum_sub_distrib]
  rw [← Finset.mul_sum, ← Finset.mul_sum, hs]
  field_simp [hx]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Normalization and the actual energy minimum for the subcritical scalar
Sobolev quotient.  The constant function gives the upper bound one. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

private theorem scalar_normalize_extremal
    {H E : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (T : H →L[ℝ] E) (hT : 0 < ‖T‖) (x : H)
    (hx : ‖x‖ = 1) (hTx : ‖T x‖ = ‖T‖) :
    ∃ w : H, ‖T w‖ = 1 ∧ 0 < ‖w‖ ^ 2 ∧
      ∀ v : H, ‖w‖ ^ 2 * ‖T v‖ ^ 2 ≤ ‖v‖ ^ 2 := by
  let w := ‖T‖⁻¹ • x
  have hw : ‖w‖ = ‖T‖⁻¹ := by
    simp only [w, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hT), hx, mul_one]
  have hTw : ‖T w‖ = 1 := by
    simp only [w, map_smul, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hT), hTx, inv_mul_cancel₀ (ne_of_gt hT)]
  refine ⟨w, hTw, by rw [hw]; positivity, fun v => ?_⟩
  have hb : ‖T‖⁻¹ * ‖T v‖ ≤ ‖v‖ := by
    have h := mul_le_mul_of_nonneg_left (T.le_opNorm v) (inv_nonneg.mpr hT.le)
    simpa only [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hT), one_mul] using h
  calc
    ‖w‖ ^ 2 * ‖T v‖ ^ 2 = (‖T‖⁻¹ * ‖T v‖) ^ 2 := by rw [hw]; ring
    _ ≤ ‖v‖ ^ 2 := (sq_le_sq₀ (by positivity) (norm_nonneg v)).mpr hb

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance normalizedMinimum_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance normalizedMinimum_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarWeightedBaseLp_one (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    scalarWeightedBaseLp g o d p hp (smoothScalarToWeightedH1 d (smoothScalarConst 1)) =
      Lp.const p (normalizedVolume g) (1 : ℝ) := by
  apply Lp.ext
  exact (scalarWeightedBaseLp_smooth g o d p hp (smoothScalarConst 1)).trans
    (Lp.coeFn_const p (normalizedVolume g) (1 : ℝ)).symm

theorem smoothScalarToWeightedH1_one_norm_sq (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) :
    ‖smoothScalarToWeightedH1 d (smoothScalarConst 1)‖ ^ 2 = 1 := by
  rw [smoothScalarToWeightedH1_norm_sq o d]
  have hd : smoothScalarDirichlet d (smoothScalarConst 1) (smoothScalarConst 1) = 0 := by
    simp only [smoothScalarDirichlet, smoothScalarGradientL2, LinearMap.comp_apply,
      smoothScalarGradient_const, map_zero, inner_zero_left, Finset.sum_const_zero]
  rw [hd]
  change (∫ _ : M, (1 : ℝ) ^ 2 ∂normalizedVolume g) + 0 / 2 = 1
  simp only [one_pow, integral_const, probReal_univ, one_smul, zero_div, add_zero]

/-- The normalized actual subcritical minimum is positive, at most one, and
bounds the homogeneous energy of every completed scalar first jet. -/
theorem scalar_subcritical_normalized_minimum (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4) :
    ∃ w : scalarWeightedH1 d,
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1 ∧
      0 < ‖w‖ ^ 2 ∧ ‖w‖ ^ 2 ≤ 1 ∧
      ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
        ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2
          ≤ ‖v‖ ^ 2 := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  have hT : 0 < ‖T‖ := by
    by_contra h
    have hn : ‖T‖ ≤ 0 := le_of_not_gt h
    apply scalarWeightedBaseLp_ne_zero g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
    apply ContinuousLinearMap.ext
    intro v
    change T v = 0
    apply norm_eq_zero.mp
    exact le_antisymm ((T.le_opNorm v).trans
      (mul_nonpos_of_nonpos_of_nonneg hn (norm_nonneg v))) (norm_nonneg _)
  obtain ⟨x, hx, hTx⟩ := scalarWeighted_subcritical_extremal g o d hp hp4
  obtain ⟨w, hw, hwpos, hmin⟩ := scalar_normalize_extremal T hT x hx hTx
  refine ⟨w, hw, hwpos, ?_, hmin⟩
  have h := hmin (smoothScalarToWeightedH1 d (smoothScalarConst 1))
  have hnorm : ‖T (smoothScalarToWeightedH1 d (smoothScalarConst 1))‖ = 1 := by
    rw [show T (smoothScalarToWeightedH1 d (smoothScalarConst 1)) =
      Lp.const (ENNReal.ofReal p) (normalizedVolume g) (1 : ℝ) from
        scalarWeightedBaseLp_one g o d _ _]
    rw [Lp.norm_const _ _ _ (ne_of_gt (ENNReal.ofReal_pos.mpr (by linarith)))]
    simp only [norm_one, probReal_univ, Real.one_rpow, mul_one]
  simpa only [hnorm, one_pow, mul_one, smoothScalarToWeightedH1_one_norm_sq g o d] using h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual local H4 regularity for a positive continuous weak Euler solution.
All coefficients, density factors and localized nonlinear sources are constructed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance positiveEulerH4_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_positive_Euler_local_H4 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (v : M → ℝ) (hv : Continuous v) (hpos : ∀ x, 0 < v x)
    (hurep : (scalarH1BaseValue g o d u : M → ℝ) =ᵐ[normalizedVolume g] v)
    (α β q : ℝ)
    (hf : (f : M → ℝ) =ᵐ[normalizedVolume g] fun x => α * v x + β * (v x) ^ q)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure V),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          v ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w ∧
        ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 4) →
          MemSobolev 4 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := scalarRescaledSourceL2 g c f χ hχ hc ht z₀ r hr.ne'
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d f u hw c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c f χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  have htests (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ =
        ∫ y, φ y * ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F w a b
      (ball 0 1) hA hB hreal φ hφc hφs (scalar_real_L2_test_integrable F φ _)
  have hwbase : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarH1BaseValue g o d u
        ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
          volume.restrict (ball (0 : V) 1)] w := by
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ w₀
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w y = w₀ (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm

  let ρ : V → ℝ := fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y)
  let b₀ : V → ℝ := fun y => v ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))
  have hurep' := scalar_rescaled_ae_predicate g c z₀ r hr.ne'
    (fun x => scalarH1BaseValue g o d u x = v x) hurep
  have hwv : (fun y => ρ y * b₀ y) =ᵐ[volume.restrict (ball (0 : V) 1)] w := by
    filter_upwards [hwbase, ae_restrict_of_ae hurep',
      ae_restrict_mem isOpen_ball.measurableSet] with y hy huv hyB
    exact (congrArg (fun t : ℝ => ρ y * t) (huv (htarget y hyB))).symm.trans hy
  have hreg2 (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2)) :
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
    exact scalar_ball_L2_forcing_gain a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
      (scalarComplexL2 w : T) (fun y => ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ))
      (((Lp.memLp F).const_mul _).ofReal) hW htests
      (1 / 2) (by norm_num) (by norm_num) φ hφc hφs
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹
  let Ft := scalarComplexL2 (κ • F)
  have hpair (φ : S) : (Ft : T) φ = ∫ y, φ y * ((κ * F y : ℝ) : ℂ) := by
    rw [Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [scalarComplexL2_coe (κ • F), Lp.coeFn_smul κ F] with y hc hs
    rw [hc, hs]
    rfl
  have htests' (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ = (Ft : T) φ :=
    (htests φ hφc hφs).trans (hpair φ).symm
  have hρ (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) : ContDiffAt ℝ ∞ ρ y :=
    (chartVolumeDensity_contDiffAt g c _
      (htarget y (closedBall_subset_ball (by norm_num) hy))).comp y (by
        unfold scalarRescaledPoint
        fun_prop)
  have hρ0 (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) : ρ y ≠ 0 :=
    (chartVolumeDensity_pos g c _
      (htarget y (closedBall_subset_ball (by norm_num) hy))).ne'
  obtain ⟨L, U, hL, hU, hrange⟩ := scalar_positive_continuous_range v hv hpos
  have hf' := scalar_rescaled_ae_predicate g c z₀ r hr.ne'
    (fun x => f x = α * v x + β * (v x) ^ q) hf
  have hFt : (Ft : V → ℂ) =ᵐ[volume.restrict (ball (0 : V) (1 / 2))]
      fun y => (ρ y * ((κ * r ^ 2 * α) * b₀ y +
        (κ * r ^ 2 * β) * (b₀ y) ^ q) : ℝ) := by
    filter_upwards [ae_restrict_of_ae (scalarComplexL2_coe (κ • F)),
      ae_restrict_of_ae (Lp.coeFn_smul κ F),
      ae_restrict_of_ae (scalarRescaledSourceL2_coe g c f χ hχ hc ht z₀ r hr.ne'),
      ae_restrict_of_ae hf', ae_restrict_mem isOpen_ball.measurableSet]
      with y hC hmul hF hfY hy
    have hy1 : y ∈ closedBall (0 : V) 1 :=
      closedBall_subset_closedBall (by norm_num) (ball_subset_closedBall hy)
    change scalarComplexL2 (κ • F) y = _
    rw [hC, hmul]
    change ((κ * F y : ℝ) : ℂ) = _
    rw [hF, (hchart r hr₁ y hy1).2, hfY (htarget y
      (ball_subset_ball (by norm_num) hy))]
    congr 1
    dsimp only [ρ, b₀]
    ring
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, w, hwv, ?_⟩
  intro φ hφc hφs
  apply scalar_half_ball_H2_forcing_gain a (scalarAdjointDrift a b)
    scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
    scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
    (scalarComplexL2 w : T) hW _ φ hφc hφs
  intro ψ hψc hψs
  rw [scalar_localize_eq_of_tests (ball 0 1) _ (Ft : T) htests' ψ hψc
    (hψs.trans (ball_subset_ball (by norm_num)))]
  exact scalar_local_H2_nonlinear_source ρ b₀ w hwv hreg2 hρ hρ0 L U q
    (κ * r ^ 2 * α) (κ * r ^ 2 * β) hL hU (fun y _ => hrange _)
    Ft hFt ψ hψc hψs

end
end PositiveEinsteinFour.Geometry
end


section

/-! All integer local regularity for actual scalar weak eigenfunctions.
The eigenvalue becomes a compact zeroth-order coefficient; no regularity premise is added. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance localChain_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_resolvent_chain_local (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∀ (U : ℕ → scalarH1 d),
        (∀ k (v : scalarH1 d),
          (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (U (k + 1))) (scalarH1Gradient d i v)) =
            inner ℝ (scalarH1BaseValue g o d (U k) - scalarH1BaseValue g o d (U (k + 1)))
              (scalarH1BaseValue g o d v)) →
      ∃ w : ℕ → Lp ℝ 2 (volume : Measure V),
        (∀ k, (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d (U k)
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w k) ∧
        ∀ (n : ℕ) (φ : S), HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
          MemSobolev ((2 * n + 1 : ℕ) : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 (w n) : T)) := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, ?_⟩
  intro U hw
  let f := fun k => scalarH1BaseValue g o d (U (k + 1) - U k)
  have hwp (k : ℕ) (v : scalarH1 d) :
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (U (k + 1))) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o (f k)) (scalarH1Value d v)) := by
    have hi : inner ℝ (scalarBasePullback g o (f k)) (scalarH1Value d v) =
        inner ℝ (f k) (scalarH1BaseValue g o d v) := by
      rw [← scalarH1BaseValue_spec g o d v]
      exact (scalarBasePullback g o).inner_map_map (f k) (scalarH1BaseValue g o d v)
    rw [hi]
    dsimp only [f]
    rw [map_sub, inner_sub_left]
    have he := hw k v
    rw [inner_sub_left] at he
    linarith only [he]
  let w₀ := fun k => scalarWeightedChartL2 g o d c hc ht (U k) χ hχ hc (Subset.refl _)
  let w := fun k => scalarAffinePullbackL2 A z₀ (w₀ k)
  have hW (k : ℕ) : MemSobolev 1 2 (scalarComplexL2 (w k) : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ (w₀ k)
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht (U k) χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := fun k => scalarRescaledSourceL2 g c (f k) χ hχ hc ht z₀ r hr.ne'
  have hreal (k : ℕ) (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w (k + 1) y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F k y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d (f k) (U (k + 1)) (hwp k) c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c (f k) χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  have htests (k : ℕ) (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 (w (k + 1)) : T) -
          (scalarComplexL2 (w (k + 1)) : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 (w (k + 1)) : T)) φ =
        ∫ y, φ y * ((-((2 * Real.pi) ^ 2)⁻¹ * F k y : ℝ) : ℂ) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r (F k) (w (k + 1)) a b
      (ball 0 1) hA hB (hreal k) φ hφc hφs (scalar_real_L2_test_integrable (F k) φ _)
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹ * r ^ 2
  have htestChain (k : ℕ) (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2)) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 (w (k + 1)) : T) -
          (scalarComplexL2 (w (k + 1)) : T) -
          smulLeftCLM ℂ (-scalarAdjointPotential a b + scalarEigenCutoff κ : S)
            (scalarComplexL2 (w (k + 1)) : T)) φ =
        -(κ : ℂ) * (scalarComplexL2 (w k) : T) φ := by
    have hφs₁ := hφs.trans (ball_subset_ball (by norm_num : (1 / 2 : ℝ) ≤ 1))
    have hFeq : F k = r ^ 2 • (w (k + 1) - w k) :=
      scalarRescaledDifferenceSource g o d c χ hχ hc ht (U (k + 1)) (U k) z₀ r hr.ne'
    have he := (htests k φ hφc hφs₁).trans (scalar_eigen_source_pairing
      (w (k + 1) - w k) (F k) (-((2 * Real.pi) ^ 2)⁻¹) (r ^ 2) hFeq φ)
    rw [scalarComplexL2_sub_distribution, sub_apply] at he
    rw [scalar_multiplier_add]
    simp only [sub_apply, add_apply] at he ⊢
    rw [scalar_multiplier_constant_on_test (scalarEigenCutoff κ) φ
      (scalarComplexL2 (w (k + 1)) : T) (κ : ℂ)
      (fun x hx => scalarEigenCutoff_on_ball κ x (hφs₁ hx))]
    change _ = (κ : ℂ) * (_ - _) at he
    linear_combination he
  refine ⟨w, ?_, ?_⟩
  · intro k
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht (U k) χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ (w₀ k)
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ k (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w k y = w₀ k (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm
  · intro n φ hφc hφs
    exact scalar_iterate_open_integer_gain a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b + scalarEigenCutoff κ)
      (-(κ : ℂ)) (fun k => (scalarComplexL2 (w k) : T)) hW htestChain n φ hφc hφs

end
end PositiveEinsteinFour.Geometry
end


section

/-! The difference between localized covariant and ordinary derivatives
is H1: it consists of smooth cutoff and connection coefficients times
localized components of the two-form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Matrix
open scoped BigOperators Manifold ContDiff SchwartzMap

noncomputable section

theorem scalarReal_memSobolev_sum {ι : Type*} (s : Finset ι)
    (F : ι → Lp ℝ 2 (volume : Measure FourSpace))
    (hF : ∀ i ∈ s, MemSobolev 1 2 (scalarComplexL2 (F i) : 𝓢'(FourSpace, ℂ))) :
    MemSobolev 1 2 (scalarComplexL2 (∑ i ∈ s, F i) : 𝓢'(FourSpace, ℂ)) := by
  let C : Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] 𝓢'(FourSpace, ℂ) :=
    ((Lp.toTemperedDistributionCLM ℂ volume 2).restrictScalars ℝ).comp
      (Complex.ofRealCLM.compLpL 2 volume)
  have hC (f : Lp ℝ 2 (volume : Measure FourSpace)) :
      C f = (scalarComplexL2 f : 𝓢'(FourSpace, ℂ)) := rfl
  change MemSobolev 1 2 (C (∑ i ∈ s, F i))
  rw [map_sum]
  induction s using Finset.cons_induction_on with
  | empty => simpa only [Finset.sum_empty] using memSobolev_fun_zero FourSpace ℂ 1 2
  | cons i s hi ih =>
      rw [Finset.sum_cons]
      exact (hF i (Finset.mem_cons_self i s)).add
        (ih (fun j hj => hF j (Finset.mem_cons_of_mem hj)))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (i : Fin 4) (u : TwoFormH1 o)

theorem twoFormGramConnection_memSobolev_one :
    MemSobolev 1 2 (scalarComplexL2
      (twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i u) : 𝓢'(FourSpace, ℂ)) := by
  change MemSobolev 1 2 (scalarComplexL2 (∑ k : Fin 2, ∑ q : Fin 4,
    twoFormGramValueL2 c S hK hKt (twoFormConnectionCutoff (g := g) c S χ i q (v k))
      (twoFormConnectionCutoff_smooth c S hS hKt χ hχ hs i q (v k))
      hc.mul_right (tsupport_mul_subset_left.trans hs) (Function.update v k q) u) :
        𝓢'(FourSpace, ℂ))
  apply scalarReal_memSobolev_sum
  intro k _
  apply scalarReal_memSobolev_sum
  intro q _
  exact twoFormGram_memSobolev_one c S hK hKt _ _ _ _ _ u

def twoFormGramDerivativeCorrection : Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormGramValueL2 c S hK hKt (fun z => partialDeriv χ i z)
    (twoFormCutoffPartial_smooth χ hχ i) (hc.fderiv_apply ℝ (coordinateVector i))
    ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v u +
    twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i u

theorem twoFormGramCovariant_add_correction :
    twoFormGramCovariantL2 c S hS hK hKt χ hχ hc hs v i u +
      twoFormGramDerivativeCorrection c S hS hK hKt χ hχ hc hs v i u =
    twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i u := by
  let P := twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i u
  let B := twoFormGramValueL2 c S hK hKt (fun z => partialDeriv χ i z)
    (twoFormCutoffPartial_smooth χ hχ i) (hc.fderiv_apply ℝ (coordinateVector i))
    ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v u
  let A := twoFormGramConnectionL2 c S hS hK hKt χ hχ hc hs v i u
  change (P - B - A) + (B + A) = P
  abel

theorem twoFormGramDerivativeCorrection_memSobolev_one :
    MemSobolev 1 2 (scalarComplexL2
      (twoFormGramDerivativeCorrection c S hS hK hKt χ hχ hc hs v i u) : 𝓢'(FourSpace, ℂ)) := by
  let C : Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] 𝓢'(FourSpace, ℂ) :=
    ((Lp.toTemperedDistributionCLM ℂ volume 2).restrictScalars ℝ).comp
      (Complex.ofRealCLM.compLpL 2 volume)
  change MemSobolev 1 2 (C (_ + _))
  rw [map_add]
  exact (twoFormGram_memSobolev_one c S hK hKt _ _ _ _ v u).add
    (twoFormGramConnection_memSobolev_one c S hS hK hKt χ hχ hc hs v i u)

theorem twoFormGramDerivativeCorrection_derivative (j : Fin 4) :
    ∃ D : Lp ℝ 2 (volume : Measure FourSpace),
      scalarCoordinateDerivative j (scalarComplexL2
        (twoFormGramDerivativeCorrection c S hS hK hKt χ hχ hc hs v i u) : 𝓢'(FourSpace, ℂ)) =
        (scalarComplexL2 D : 𝓢'(FourSpace, ℂ)) := by
  obtain ⟨D, hD, _⟩ := scalar_real_derivative_sobolev 0 _
    (by simpa only [Nat.cast_zero, zero_add] using
      twoFormGramDerivativeCorrection_memSobolev_one c S hS hK hKt χ hχ hc hs v i u) j
  exact ⟨D, hD⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Six-component Euclidean L2 realizations of the local two-form and
its covariant derivative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Matrix Set
open scoped BigOperators Manifold ContDiff

noncomputable section

def twoFormComponentIndex : Fin 6 → Fin 2 → Fin 4 :=
  ![![0,1], ![0,2], ![0,3], ![1,2], ![1,3], ![2,3]]

theorem twoFormTensor_component (a : TwoFormFour) (r : Fin 6) :
    twoFormTensor a (twoFormComponentIndex r) = a r := by
  fin_cases r <;> rfl

theorem twoForm_sum_components (a : TwoFormFour) :
    (∑ r : Fin 6, a r • (EuclideanSpace.basisFun (Fin 6) ℝ) r) = a := by
  ext r
  simp [EuclideanSpace.basisFun_apply, Pi.single_apply, smul_eq_mul]

def twoFormComponentL2 (r : Fin 6) :
    Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  (ContinuousLinearMap.toSpanSingleton ℝ ((EuclideanSpace.basisFun (Fin 6) ℝ) r)).compLpL 2 volume

theorem twoFormComponentL2_coe (r : Fin 6) (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    twoFormComponentL2 r f =ᵐ[volume]
      fun z => f z • (EuclideanSpace.basisFun (Fin 6) ℝ) r :=
  (ContinuousLinearMap.toSpanSingleton ℝ ((EuclideanSpace.basisFun (Fin 6) ℝ) r)).coeFn_compLpL f

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormAssembleL2 (F : Fin 6 → TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace)) :
    TwoFormH1 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  ∑ r : Fin 6, (twoFormComponentL2 r).comp (F r)

theorem twoFormAssembleL2_coe
    (F : Fin 6 → TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace))
    (u : TwoFormH1 o) (a : FourSpace → TwoFormFour)
    (ha : ∀ r, F r u =ᵐ[volume] fun z => a z r) :
    twoFormAssembleL2 F u =ᵐ[volume] a := by
  have he : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ r : Fin 6,
      twoFormComponentL2 r (F r u) z = a z r • (EuclideanSpace.basisFun (Fin 6) ℝ) r := by
    apply Filter.eventually_all.mpr
    intro r
    filter_upwards [twoFormComponentL2_coe r (F r u), ha r] with z hc hz
    rw [hc, hz]
  change (∑ r : Fin 6, twoFormComponentL2 r (F r u)) =ᵐ[volume] a
  filter_upwards [Lp.coeFn_finsetSum Finset.univ (fun r => twoFormComponentL2 r (F r u)), he]
    with z hsum hz
  rw [hsum]
  change (∑ r, twoFormComponentL2 r (F r u) z) = a z
  simp_rw [hz]
  exact twoForm_sum_components (a z)

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K)

def twoFormGramVectorL2 :
    TwoFormH1 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  twoFormAssembleL2 (fun r => twoFormGramValueL2 c S hK hKt χ hχ hc hs (twoFormComponentIndex r))

theorem twoFormGramVectorL2_coe (u : SmoothH1TwoForm o) :
    twoFormGramVectorL2 c S hK hKt χ hχ hc hs (smoothTwoFormToH1 u) =ᵐ[volume]
      fun z => χ z • twoFormChartValue o (u : smoothTwoForms o).val c S hS z := by
  apply twoFormAssembleL2_coe
  intro r
  rw [twoFormGramValueL2_smooth]
  filter_upwards [ScalarEuclideanSobolev.valueL2_coe
    (twoFormGramCutoffC1 c S hKt χ hχ hc hs (twoFormComponentIndex r) u)] with z hz
  rw [hz, twoFormGramCutoffC1_value c S hS, twoFormTensor_component]
  rfl

def twoFormGramNablaL2 (i : Fin 4) :
    TwoFormH1 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  twoFormAssembleL2 (fun r =>
    twoFormGramCovariantL2 c S hS hK hKt χ hχ hc hs (twoFormComponentIndex r) i)

theorem twoFormGramNablaL2_coe (u : SmoothH1TwoForm o)
    (U : Set FourSpace) (hU : IsOpen U) (hUt : U ⊆ (chartAt FourSpace c).target)
    (hKU : K ⊆ U)
    (hp : ∀ z (hz : z ∈ U), chartGramSection g c S hS ⟨z, hUt hz⟩ ∈ o.positive)
    (i : Fin 4) :
    twoFormGramNablaL2 c S hS hK hKt χ hχ hc hs i (smoothTwoFormToH1 u) =ᵐ[volume]
      fun z => χ z • twoFormLocalNabla (g := g) c S
        (twoFormChartValue o (u : smoothTwoForms o).val c S hS) i z := by
  apply twoFormAssembleL2_coe
  intro r
  filter_upwards [twoFormGramCovariantL2_coe c S hS hK hKt χ hχ hc hs (twoFormComponentIndex r) i u]
    with z hz
  rw [hz]
  by_cases hzK : z ∈ K
  · rw [(u : smoothTwoForms o).property.localNabla_tensor c S hS U hU hUt hp z (hKU hzK) i,
      twoFormTensor_component]
    rfl
  · have hzero : χ z = 0 := image_eq_zero_of_notMem_tsupport (fun h => hzK (hs h))
    rw [hzero, zero_mul, zero_smul]
    rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! The normal volume density and leading heat amplitude in a common
family, including their actual exponential identifications. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyDensity (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace) : ℝ :=
  Real.sqrt (heatFamilyMetric g c P z).det

def heatFamilyLeading (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace) : ℝ :=
  (Real.sqrt (heatFamilyDensity g c P z))⁻¹

theorem heatFamilyDensity_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hdet : (heatFamilyMetric g c P z).det ≠ 0) :
    ContDiffAt ℝ n (heatFamilyDensity g c P) z :=
  (heatFamilyMatrixDeterminant_contDiffAt n _ z
    (heatFamilyMetric_contDiffAt n g c P z hP hz)).sqrt hdet

theorem heatFamilyLeading_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hdet : 0 < (heatFamilyMetric g c P z).det) :
    ContDiffAt ℝ n (heatFamilyLeading g c P) z := by
  have hJ : 0 < heatFamilyDensity g c P z := Real.sqrt_pos.mpr hdet
  exact ((heatFamilyDensity_contDiffAt n g c P z hP hz hdet.ne').sqrt hJ.ne').inv
    (Real.sqrt_pos.mpr hJ).ne'

theorem heatFamilyInverse_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hdet : (heatFamilyMetric g c P z).det ≠ 0) (i j : Fin 4) :
    ContDiffAt ℝ n (fun y => (heatFamilyMetric g c P y)⁻¹ i j) z :=
  heatFamilyMatrixInverse_contDiffAt n _ z
    (heatFamilyMetric_contDiffAt n g c P z hP hz) hdet i j

variable [T3Space M] [CompactSpace M]

theorem heatFamilyDensity_exponential_germ (g : SmoothMetric M) (o : FrameOrientation g)
    (c : M) (e : FrameBundle g) (he : e.base ∈ (chartAt FourSpace c).source)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hP : ContDiffAt ℝ 1 P (0, frameCoordinateState g c e))
    (hexp : (fun v => (P (v, frameCoordinateState g c e)).1) =ᶠ[𝓝 0]
      (fun v => chartAt FourSpace c (frameExponential g o e v))) :
    (fun v => heatFamilyDensity g c P (v, frameCoordinateState g c e))
      =ᶠ[𝓝 0] frameExponentialJacobian g o e := by
  filter_upwards [heatFamilyMetric_exponential_germ g o c e he P hP hexp] with v hv
  exact congrArg (fun A : Mat4 => Real.sqrt A.det) hv

theorem heatFamilyLeading_exponential_germ (g : SmoothMetric M) (o : FrameOrientation g)
    (c : M) (e : FrameBundle g) (he : e.base ∈ (chartAt FourSpace c).source)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hP : ContDiffAt ℝ 1 P (0, frameCoordinateState g c e))
    (hexp : (fun v => (P (v, frameCoordinateState g c e)).1) =ᶠ[𝓝 0]
      (fun v => chartAt FourSpace c (frameExponential g o e v))) :
    (fun v => heatFamilyLeading g c P (v, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalLeadingAmplitude g o e := by
  filter_upwards [heatFamilyDensity_exponential_germ g o c e he P hP hexp] with v hv
  exact congrArg (fun a : ℝ => (Real.sqrt a)⁻¹) hv

end
end PositiveEinsteinFour.Geometry
end


section

/-! Pointwise identification on the whole common normal ball, rather
than only equality of germs at its center. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatFamilyMetric_exponential_eq (g : SmoothMetric M) (o : FrameOrientation g)
    (c : M) (e : FrameBundle g) (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (x : FourSpace) (hP : DifferentiableAt ℝ P (x, frameCoordinateState g c e))
    (hsource : frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hexp : (fun v => (P (v, frameCoordinateState g c e)).1) =ᶠ[𝓝 x]
      (fun v => chartAt FourSpace c (frameExponential g o e v))) :
    heatFamilyMetric g c P (x, frameCoordinateState g c e) = heatNormalMetric g o e x := by
  let q := frameCoordinateState g c e
  have hd := hexp.fderiv_eq (𝕜 := ℝ)
  have hv : (P (x, q)).1 = chartAt FourSpace c (frameExponential g o e x) := hexp.self_of_nhds
  ext i j
  rw [heatNormalMetric_chart_pairing g o e c x hsource i j]
  change WithLp.ofLp (heatFamilyPartial P i (x, q)).1 ⬝ᵥ
    (metricInChart g c (P (x, q)).1 *ᵥ WithLp.ofLp (heatFamilyPartial P j (x, q)).1) = _
  rw [heatFamilyBasePartial_slice P (x, q) hP i,
    heatFamilyBasePartial_slice P (x, q) hP j]
  dsimp only [Prod.fst, Prod.snd, q]
  rw [hv, hd]

theorem HeatNormalFrameData.metric_slice_eq {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hpoint : D.point = fun v => P (v, frameCoordinateState g c e))
    (x : FourSpace) (hx : x ∈ ball 0 D.radius)
    (hP : DifferentiableAt ℝ P (x, frameCoordinateState g c e))
    (hsource : frameExponential g o e x ∈ (chartAt FourSpace c).source) :
    heatFamilyMetric g c P (x, frameCoordinateState g c e) = heatNormalMetric g o e x := by
  apply heatFamilyMetric_exponential_eq g o c e P x hP hsource
  filter_upwards [isOpen_ball.mem_nhds hx] with v hv
  simpa only [hpoint] using D.exponential v hv

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normalized leading scalar amplitude solves its transport
equation on a normal-coordinate ball. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

abbrev heatNormalDrift (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (x : FourSpace) : Fin 4 → ℝ :=
  fourHeatDensityDrift (fun y => (heatNormalMetric g o e y)⁻¹)
    (frameExponentialJacobian g o e) x

theorem heatNormalInverse_symm (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (x : FourSpace) :
    ((heatNormalMetric g o e x)⁻¹)ᵀ = (heatNormalMetric g o e x)⁻¹ := by
  rw [Matrix.transpose_nonsing_inv, heatNormalMetric_symm]

theorem heatNormalLeadingAmplitude_transport_neighborhood (g : SmoothMetric M)
    (o : FrameOrientation g) (hRic : RicciThree g) (e : FrameBundle g)
    (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      fourHeatRadialTransport (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
        (heatNormalLeadingAmplitude g o e) x = 0 := by
  let a := fun y => (heatNormalMetric g o e y)⁻¹
  let J := frameExponentialJacobian g o e
  let u := heatNormalLeadingAmplitude g o e
  have ha : ∀ᶠ x in 𝓝 (0 : FourSpace),
      ∀ i j, DifferentiableAt ℝ (fun y => a y i j) x := by
    apply eventually_all.mpr
    intro i
    apply eventually_all.mpr
    intro j
    have hn := ((heatNormalInverse_smoothAt_zero g o e i j).of_le
      (show (1 : ℕ∞ω) ≤ ∞ by simp)).eventually (by simp)
    filter_upwards [hn] with x hx
    exact hx.differentiableAt one_ne_zero
  have hJ : ∀ᶠ x in 𝓝 (0 : FourSpace), DifferentiableAt ℝ J x := by
    have hn := ((frameExponentialJacobian_smoothAt_zero g o e).of_le
      (show (1 : ℕ∞ω) ≤ ∞ by simp)).eventually (by simp)
    filter_upwards [hn] with x hx
    exact hx.differentiableAt one_ne_zero
  have hu : ∀ᶠ x in 𝓝 (0 : FourSpace), DifferentiableAt ℝ u x := by
    have hn := ((heatNormalLeadingAmplitude_smoothAt_zero g o e).of_le
      (show (1 : ℕ∞ω) ≤ ∞ by simp)).eventually (by simp)
    filter_upwards [hn] with x hx
    exact hx.differentiableAt one_ne_zero
  have hnear : ∀ᶠ x in 𝓝 (0 : FourSpace),
      (∀ i j, DifferentiableAt ℝ (fun y => a y i j) x) ∧
      DifferentiableAt ℝ J x ∧ DifferentiableAt ℝ u x ∧
      (heatNormalMetric g o e x).det ≠ 0 ∧ 0 < J x := by
    filter_upwards [ha, hJ, hu, heatNormalMetric_eventually_nondegenerate g o e,
      frameExponentialJacobian_eventually_pos g o e] with x ha hJ hu hd hp
    exact ⟨ha, hJ, hu, hd, hp⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hnear
  refine ⟨r, hr, ?_⟩
  intro x hx
  have hrad : ∀ᶠ y in 𝓝 x, ∀ i, ∑ j : Fin 4, a y i j * y j = y i := by
    filter_upwards [isOpen_ball.mem_nhds hx] with y hy
    intro i
    exact congrFun (heatNormalMetric_inverse_radial g o hRic e he y (hball hy).2.2.2.1) i
  have hcol : ∀ j, ∑ i : Fin 4, a x i j * x i = x j := by
    intro j
    have hs (i : Fin 4) : a x i j = a x j i :=
      congrFun (congrFun (heatNormalInverse_symm g o e x) j) i
    simp_rw [hs]
    exact hrad.self_of_nhds j
  have hnorm : ∀ᶠ y in 𝓝 x, u y ^ 2 * J y = 1 := by
    filter_upwards [isOpen_ball.mem_nhds hx] with y hy
    exact heatNormalLeadingAmplitude_normalization g o e y (hball hy).2.2.2.2
  exact fourHeatDensity_leading_transport a J u x (hball hx).1
    (hball hx).2.1 (hball hx).2.2.1 hrad hcol hnorm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The determinant used in Euclidean change of variables is the actual
normal volume density. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric
open scoped Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_jacobianMatrix_det (F : FourSpace → FourSpace) (x : FourSpace) :
    (jacobianMatrix F x).det = (fderiv ℝ F x).det := by
  have h : jacobianMatrix F x = LinearMap.toMatrix
      (PiLp.basisFun 2 ℝ (Fin 4)) (PiLp.basisFun 2 ℝ (Fin 4))
      (fderiv ℝ F x).toLinearMap := by
    ext i j
    simp only [LinearMap.toMatrix_apply, PiLp.basisFun_repr, PiLp.basisFun_apply]
    rfl
  rw [h, LinearMap.det_toMatrix]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem HeatNormalFrameData.volume_jacobian (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source) :
    frameExponentialJacobian g o e x =
      |(fderiv ℝ (fun y => (D.point y).1) x).det| *
        chartVolumeDensity g c (D.point x).1 := by
  change Real.sqrt (heatNormalMetric g o e x).det = _
  rw [D.metric_pullback x hx hs, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
  have hh : (jacobianMatrix (fun y => (D.point y).1) x).det *
      (metricInChart g c (D.point x).1).det *
      (jacobianMatrix (fun y => (D.point y).1) x).det =
      (jacobianMatrix (fun y => (D.point y).1) x).det ^ 2 *
        (metricInChart g c (D.point x).1).det := by ring
  rw [hh, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs, heat_jacobianMatrix_det]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact coordinate transformation of the density drift. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem heatPullbackMetric_jacobian_unit (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace)
    (hdet : (heatPullbackMetric g c F x).det ≠ 0) :
    IsUnit (jacobianMatrix F x).det := by
  apply isUnit_iff_ne_zero.mpr
  intro hz
  apply hdet
  simp only [heatPullbackMetric, Matrix.det_mul, Matrix.det_transpose, hz, zero_mul, mul_zero]

theorem heatPullback_drift (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace) (hF : ContDiffAt ℝ 2 F x)
    (hx : F x ∈ (chartAt FourSpace c).target)
    (hpos : 0 < (heatPullbackMetric g c F x).det) (r : Fin 4) :
    fourHeatDensityDrift (fun y => (heatPullbackMetric g c F y)⁻¹)
      (fun y => Real.sqrt (heatPullbackMetric g c F y).det) x r =
      ∑ i, ∑ j, (heatPullbackMetric g c F x)⁻¹ i j * heatPullbackConnection g c F i x r j := by
  exact heatCompatibleMetric_drift _ x (heatPullbackMetric_regular g c F x hF hx)
    hpos (fun i => heatPullbackConnection g c F i x)
    (heatPullbackConnection_compatible g c F x hF hx
      (heatPullbackMetric_jacobian_unit g c F x hpos.ne'))
    (heatPullbackConnection_torsion g c F x hF) r

theorem heatPullback_drift_transport (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace) (hF : ContDiffAt ℝ 2 F x)
    (hx : F x ∈ (chartAt FourSpace c).target)
    (hpos : 0 < (heatPullbackMetric g c F x).det) (r : Fin 4) :
    (∑ k, jacobianMatrix F x r k * fourHeatDensityDrift
      (fun y => (heatPullbackMetric g c F y)⁻¹)
      (fun y => Real.sqrt (heatPullbackMetric g c F y).det) x k) -
      (∑ i, ∑ j, (heatPullbackMetric g c F x)⁻¹ i j *
        partialDeriv (fun y => jacobianMatrix F y r j) i x) =
      ∑ p, ∑ q, (metricInChart g c (F x))⁻¹ p q * christoffel g c (F x) r p q := by
  simp_rw [heatPullback_drift g c F x hF hx hpos]
  have hJ := heatPullbackMetric_jacobian_unit g c F x hpos.ne'
  exact heat_drift_transport_algebra (jacobianMatrix F x)
    (heatPullbackMetric g c F x)⁻¹ (metricInChart g c (F x))⁻¹
    (fun i => heatPullbackConnection g c F i x)
    (fun i => matrixPartial (jacobianMatrix F) i x)
    (fun i => connectionMatrix g c i (F x))
    (fun i => pulledConnection_equation _ _ _ hJ)
    (heat_matrix_inverse_congruence _ _ hJ) r

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarBaseHeatRate (μ : ScalarBaseEigenIndex g o d) : ℝ :=
  μ.1.val⁻¹ - 1

theorem scalarBaseHeatRate_nonneg
    (μ : ScalarBaseEigenIndex g o d) : 0 ≤ scalarBaseHeatRate g o d μ :=
  sub_nonneg.mpr ((one_le_inv₀ (scalarBaseResolvent_eigenvalue g o d μ.1.property).1).mpr
    (scalarBaseResolvent_eigenvalue g o d μ.1.property).2)

omit [SecondCountableTopology M] in
theorem scalarBaseHeatRate_eq_zero
    (μ : ScalarBaseEigenIndex g o d) : scalarBaseHeatRate g o d μ = 0 ↔ μ.1.val = 1 := by
  change μ.1.val⁻¹ - 1 = 0 ↔ _
  rw [sub_eq_zero, inv_eq_one]

def scalarBaseHeatWeight (t : ℝ≥0)
    (μ : ScalarBaseEigenIndex g o d) : ℝ :=
  Real.exp (-(t : ℝ) * scalarBaseHeatRate g o d μ)

theorem scalarBaseHeatWeight_bound (t : ℝ≥0)
    (μ : ScalarBaseEigenIndex g o d) : |scalarBaseHeatWeight g o d t μ| ≤ 1 := by
  rw [scalarBaseHeatWeight, abs_of_pos (Real.exp_pos _), Real.exp_le_one_iff]
  exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr t.coe_nonneg)
    (scalarBaseHeatRate_nonneg g o d μ)

def scalarBaseHeat (t : ℝ≥0) : Lp ℝ 2 (normalizedVolume g) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  scalarBaseSpectralMultiplier g o d (scalarBaseHeatWeight g o d t) 1 zero_le_one
    (scalarBaseHeatWeight_bound g o d t)

theorem scalarBaseHeat_coordinate (t : ℝ≥0) (f : Lp ℝ 2 (normalizedVolume g))
    (μ : ScalarBaseEigenIndex g o d) :
    (scalarBaseSpectralEquiv g o d (scalarBaseHeat g o d t f)) μ =
      scalarBaseHeatWeight g o d t μ • (scalarBaseSpectralEquiv g o d f) μ :=
  scalarBaseSpectralMultiplier_coordinate g o d _ _ _ _ f μ

theorem scalarBaseHeat_zero (f : Lp ℝ 2 (normalizedVolume g)) :
    scalarBaseHeat g o d 0 f = f := by
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext μ
  rw [scalarBaseHeat_coordinate]
  simp only [scalarBaseHeatWeight, NNReal.coe_zero, neg_zero, zero_mul, Real.exp_zero, one_smul]

theorem scalarBaseHeat_add (t s : ℝ≥0) (f : Lp ℝ 2 (normalizedVolume g)) :
    scalarBaseHeat g o d (t + s) f = scalarBaseHeat g o d t (scalarBaseHeat g o d s f) := by
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext μ
  rw [scalarBaseHeat_coordinate, scalarBaseHeat_coordinate, scalarBaseHeat_coordinate, smul_smul]
  congr 1
  simp only [scalarBaseHeatWeight, NNReal.coe_add]
  rw [← Real.exp_add]
  congr 1
  ring

theorem scalarBaseHeat_contraction (t : ℝ≥0) (f : Lp ℝ 2 (normalizedVolume g)) :
    ‖scalarBaseHeat g o d t f‖ ≤ ‖f‖ := by
  simpa only [scalarBaseHeat, one_mul] using scalarBaseSpectralMultiplier_norm g o d
    (scalarBaseHeatWeight g o d t) 1 zero_le_one (scalarBaseHeatWeight_bound g o d t) f

theorem scalarBaseHeat_selfAdjoint (t : ℝ≥0) (f h : Lp ℝ 2 (normalizedVolume g)) :
    inner ℝ (scalarBaseHeat g o d t f) h = inner ℝ f (scalarBaseHeat g o d t h) :=
  scalarBaseSpectralMultiplier_selfAdjoint g o d _ _ _ _ f h

theorem scalarBaseHeat_nonneg (t : ℝ≥0) (f : Lp ℝ 2 (normalizedVolume g)) :
    0 ≤ inner ℝ (scalarBaseHeat g o d t f) f := by
  rw [scalarBaseHeat, scalarBaseSpectralMultiplier_inner]
  exact tsum_nonneg fun μ => mul_nonneg (Real.exp_pos _).le (real_inner_self_nonneg (x := _))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalarBaseSpectralMultiplier_sub_norm_sq
    (a b : ScalarBaseEigenIndex g o d → ℝ)
    (ha : ∀ μ, |a μ| ≤ 1) (hb : ∀ μ, |b μ| ≤ 1) (f : Lp ℝ 2 (normalizedVolume g)) :
    ‖scalarBaseSpectralMultiplier g o d a 1 zero_le_one ha f -
      scalarBaseSpectralMultiplier g o d b 1 zero_le_one hb f‖ ^ 2 =
      ∑' μ, (a μ - b μ) ^ 2 * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2 := by
  rw [← real_inner_self_eq_norm_sq, ← (scalarBaseSpectralEquiv g o d).inner_map_map,
    map_sub, lp.inner_eq_tsum]
  apply tsum_congr
  intro μ
  change inner ℝ
    ((scalarBaseSpectralEquiv g o d (scalarBaseSpectralMultiplier g o d a 1 zero_le_one ha f)) μ -
      (scalarBaseSpectralEquiv g o d (scalarBaseSpectralMultiplier g o d b 1 zero_le_one hb f)) μ)
    ((scalarBaseSpectralEquiv g o d (scalarBaseSpectralMultiplier g o d a 1 zero_le_one ha f)) μ -
      (scalarBaseSpectralEquiv g o d (scalarBaseSpectralMultiplier g o d b 1 zero_le_one hb f)) μ) = _
  rw [scalarBaseSpectralMultiplier_coordinate, scalarBaseSpectralMultiplier_coordinate,
    ← sub_smul, real_inner_smul_left, real_inner_smul_right, real_inner_self_eq_norm_sq]
  ring

theorem scalarBaseSpectralMultiplier_tendsto {α : Type*} {l : Filter α}
    (a : α → ScalarBaseEigenIndex g o d → ℝ)
    (b : ScalarBaseEigenIndex g o d → ℝ)
    (ha : ∀ x μ, |a x μ| ≤ 1) (hb : ∀ μ, |b μ| ≤ 1)
    (hab : ∀ μ, Tendsto (fun x => a x μ) l (𝓝 (b μ))) (f : Lp ℝ 2 (normalizedVolume g)) :
    Tendsto (fun x => scalarBaseSpectralMultiplier g o d (a x) 1 zero_le_one (ha x) f) l
      (𝓝 (scalarBaseSpectralMultiplier g o d b 1 zero_le_one hb f)) := by
  have hsum : Summable (fun μ : ScalarBaseEigenIndex g o d =>
      4 * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2) := by
    have hs := lp.summable_inner (𝕜 := ℝ)
      (scalarBaseSpectralEquiv g o d f) (scalarBaseSpectralEquiv g o d f)
    simp only [real_inner_self_eq_norm_sq] at hs
    exact hs.mul_left 4
  have hbound (x : α) (μ : ScalarBaseEigenIndex g o d) :
      ‖(a x μ - b μ) ^ 2 * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2‖ ≤
        4 * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2 := by
    have hdiff : |a x μ - b μ| ≤ 2 :=
      (abs_sub (a x μ) (b μ)).trans (by linarith only [ha x μ, hb μ])
    have hsq : (a x μ - b μ) ^ 2 ≤ 4 := by
      have hprod := mul_nonneg (sub_nonneg.mpr hdiff)
        (add_nonneg (show (0 : ℝ) ≤ 2 by norm_num) (abs_nonneg (a x μ - b μ)))
      nlinarith only [hprod, sq_abs (a x μ - b μ)]
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _))]
    exact mul_le_mul_of_nonneg_right hsq (sq_nonneg _)
  have hpoint (μ : ScalarBaseEigenIndex g o d) :
      Tendsto (fun x => (a x μ - b μ) ^ 2 * ‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2)
        l (𝓝 (0 : ℝ)) := by
    convert (((hab μ).sub_const (b μ)).pow 2).mul_const
      (‖(scalarBaseSpectralEquiv g o d f) μ‖ ^ 2) using 1
    simp
  have ht := tendsto_tsum_of_dominated_convergence hsum hpoint
    (Eventually.of_forall hbound)
  simp only [tsum_zero] at ht
  have hn : Tendsto (fun x => ‖scalarBaseSpectralMultiplier g o d (a x) 1 zero_le_one (ha x) f -
      scalarBaseSpectralMultiplier g o d b 1 zero_le_one hb f‖ ^ 2) l (𝓝 (0 : ℝ)) := by
    simpa only [scalarBaseSpectralMultiplier_sub_norm_sq] using ht
  have hs := (Real.continuous_sqrt.tendsto (0 : ℝ)).comp hn
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  convert hs using 1
  · funext x
    exact (Real.sqrt_sq (norm_nonneg _)).symm
  · exact congrArg nhds Real.sqrt_zero.symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The critical limit in the scalar Sobolev inequality.  The limit is
taken for each actual smooth test function under an integrable bound. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology ENNReal

noncomputable section

private def scalarCriticalExponent (n : ℕ) : ℝ := 4 - 1 / ((n : ℝ) + 1)

private theorem scalarCriticalExponent_bounds (n : ℕ) :
    2 < scalarCriticalExponent n ∧ scalarCriticalExponent n < 4 := by
  have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) n]
  have hi : 1 / ((n : ℝ) + 1) ≤ 1 := (div_le_one (by positivity)).mpr hn
  have hp : 0 < 1 / ((n : ℝ) + 1) := by positivity
  dsimp [scalarCriticalExponent]
  constructor <;> linarith

private theorem scalarCriticalExponent_tendsto :
    Tendsto scalarCriticalExponent atTop (𝓝 4) := by
  change Tendsto (fun n : ℕ => 4 - 1 / ((n : ℝ) + 1)) atTop (𝓝 4)
  simpa only [sub_zero] using
    (tendsto_const_nhds (x := (4 : ℝ))).sub
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))

theorem scalar_moment_critical_limit {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsFiniteMeasure μ] [TopologicalSpace X]
    [OpensMeasurableSpace X] [CompactSpace X] (f : C(X, ℝ)) :
    Tendsto (fun n => (∫ x, |f x| ^ scalarCriticalExponent n ∂μ) ^
      (2 / scalarCriticalExponent n)) atTop (𝓝 (Real.sqrt (∫ x, f x ^ 4 ∂μ))) := by
  have hb : Integrable (fun x => 1 + |f x| ^ 4) μ := by
    exact (continuous_const.add (f.continuous.abs.pow 4)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hm (n : ℕ) : AEStronglyMeasurable (fun x => |f x| ^ scalarCriticalExponent n) μ := by
    exact (f.continuous.abs.rpow_const (fun _ => Or.inr
      (le_of_lt (lt_trans (by norm_num) (scalarCriticalExponent_bounds n).1)))).aestronglyMeasurable
  have hbound (n : ℕ) : ∀ᵐ x ∂μ, ‖|f x| ^ scalarCriticalExponent n‖ ≤ 1 + |f x| ^ 4 := by
    filter_upwards [] with x
    rw [Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
    by_cases hsmall : |f x| ≤ 1
    · have h := Real.rpow_le_one (abs_nonneg (f x)) hsmall
        (le_of_lt (lt_trans (by norm_num) (scalarCriticalExponent_bounds n).1))
      exact h.trans (le_add_of_nonneg_right (pow_nonneg (abs_nonneg _) 4))
    · have h := Real.rpow_le_rpow_of_exponent_le (le_of_not_ge hsmall)
        (scalarCriticalExponent_bounds n).2.le
      have h4 : |f x| ^ scalarCriticalExponent n ≤ |f x| ^ (4 : ℕ) := by
        simpa only [Real.rpow_ofNat] using h
      exact h4.trans (le_add_of_nonneg_left zero_le_one)
  have hpw (x : X) : Tendsto (fun n => |f x| ^ scalarCriticalExponent n)
      atTop (𝓝 (f x ^ 4)) := by
    have h := (tendsto_const_nhds (x := |f x|)).rpow scalarCriticalExponent_tendsto
      (Or.inr (by norm_num : (0 : ℝ) < 4))
    simpa only [Real.rpow_ofNat, (by decide : Even (4 : ℕ)).pow_abs] using h
  have hint := tendsto_integral_of_dominated_convergence (fun x => 1 + |f x| ^ 4)
    hm hb hbound (Filter.Eventually.of_forall hpw)
  have hpow : Tendsto (fun n => 2 / scalarCriticalExponent n) atTop (𝓝 (1 / 2 : ℝ)) := by
    convert tendsto_const_nhds.div scalarCriticalExponent_tendsto (by norm_num : (4 : ℝ) ≠ 0) using 1
    norm_num
  simpa only [Real.sqrt_eq_rpow] using hint.rpow hpow (Or.inr (by norm_num : (0 : ℝ) < 1 / 2))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance scalarCritical_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarCritical_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- Subcritical inequalities with the sharp constant pass to the exact
critical inequality used in the two Weyl-block gaps. -/
theorem sharpScalarSobolev_of_subcritical_moments (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (hsub : ∀ (p : ℝ), 2 < p → p < 4 → ∀ a : SmoothScalar (M := M),
      (∫ x, |a.val x| ^ p ∂normalizedVolume g) ^ (2 / p) ≤
        (∫ x, a.val x ^ 2 ∂normalizedVolume g) + smoothScalarDirichlet d a a / 2) :
    SharpScalarSobolev o d := by
  intro a
  apply le_of_tendsto (scalar_moment_critical_limit (normalizedVolume g)
    (⟨a.val, a.property.continuous⟩ : C(M, ℝ)))
  exact Eventually.of_forall fun n => hsub (scalarCriticalExponent n)
    (scalarCriticalExponent_bounds n).1 (scalarCriticalExponent_bounds n).2 a

end
end PositiveEinsteinFour.Geometry
end


section

/-! Global smooth representatives of actual intrinsic weak scalar eigenfunctions, obtained from the proved local coordinate regularity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance eigenSmooth_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance eigenSmooth_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_weak_eigen_smooth_representative (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (u : scalarH1 d) (κ : ℝ)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        κ * inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v)) :
    ∃ F : SmoothScalar (M := M), scalarH1Value d u =
      smoothScalarValueL2 g (canonicalFrameMeasure g o) F := by
  let b := scalarH1BaseValue g o d u
  have hlocal (x : M) : ∃ U : Set M, ∃ F : M → ℝ,
      IsOpen U ∧ x ∈ U ∧ ContMDiffOn I4 𝓘(ℝ, ℝ) ∞ F U ∧
        (b : M → ℝ) =ᵐ[(normalizedVolume g).restrict U] F := by
    let z₀ : ChartTarget x := ⟨chartAt FourSpace x x,
      (chartAt FourSpace x).map_source (mem_chart_source FourSpace x)⟩
    obtain ⟨U, hU, hxU, _, F, hF, he⟩ := scalar_eigen_local_chart_smooth g o d u κ hw x z₀
    let W := (chartAt FourSpace x).source ∩ (chartAt FourSpace x) ⁻¹' U
    refine ⟨W, fun y => F (chartAt FourSpace x y),
      (chartAt FourSpace x).isOpen_inter_preimage hU, ⟨mem_chart_source FourSpace x, hxU⟩,
      ?_, scalar_chart_representative_ae g x U hU b F he⟩
    intro y hy
    have hFC : ContDiffAt ℝ (⊤ : ℕ∞) F (chartAt FourSpace x y) :=
      (hF _ hy.2).contDiffAt (hU.mem_nhds hy.2)
    exact (hFC.contMDiffAt.comp y
      (contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x) hy.1)).contMDiffWithinAt
  obtain ⟨F, hF⟩ := scalar_smooth_representative_of_local g b hlocal
  have hb : smoothScalarBaseL2 g F = b := by
    apply Lp.ext
    have hcoe := ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
      (⟨F.val, F.property.continuous⟩ : C(M, ℝ))
    filter_upwards [hcoe, hF] with x hx hFx
    exact hx.trans hFx
  refine ⟨F, ?_⟩
  rw [← scalarH1BaseValue_spec g o d u]
  change scalarBasePullback g o b = _
  rw [← hb, scalarBasePullback_smooth]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Integer Sobolev products at the orders used after the first nonlinear
gain. The induction uses actual weak derivatives, starting with H3. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_real_integer_product (n : ℕ) (hn : 3 ≤ n) :
    ∀ u v : L2, MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T) →
      MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) →
      ∃ w : L2, MemSobolev (n : ℝ) 2 (scalarComplexL2 w : T) ∧
        (w : V → ℝ) =ᵐ[volume] fun x => u x * v x := by
  induction n, hn using Nat.le_induction with
  | base =>
    intro u v hu hv
    exact scalar_real_H3_product u v hu hv
  | succ n hn ih =>
    intro u v hu hv
    have hu' : MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T) :=
      hu.mono (by exact_mod_cast Nat.le_succ n)
    have hv' : MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) :=
      hv.mono (by exact_mod_cast Nat.le_succ n)
    obtain ⟨w, hw, hwe⟩ := ih u v hu' hv'
    refine ⟨w, ?_, hwe⟩
    have hreg : MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 w : T) := by
      apply (scalar_memSobolev_succ_iff (n : ℝ) _).mpr
      refine ⟨hw, fun i => ?_⟩
      obtain ⟨du, hdu, hduN⟩ := scalar_real_derivative_sobolev n u
        (by simpa only [Nat.cast_add, Nat.cast_one] using hu) i
      obtain ⟨dv, hdv, hdvN⟩ := scalar_real_derivative_sobolev n v
        (by simpa only [Nat.cast_add, Nat.cast_one] using hv) i
      obtain ⟨a, ha, hae⟩ := ih du v hduN hv'
      obtain ⟨b, hb, hbe⟩ := ih u dv hu' hdvN
      have hu2 : MemSobolev 2 2 (scalarComplexL2 u : T) :=
        hu'.mono (by exact_mod_cast (show 2 ≤ n by omega))
      have hv2 : MemSobolev 2 2 (scalarComplexL2 v : T) :=
        hv'.mono (by exact_mod_cast (show 2 ≤ n by omega))
      obtain ⟨z, hz, hze⟩ := scalar_real_weak_product u v w du dv hu2 hv2 hwe i hdu hdv
      have he : z = a + b := by
        apply Lp.ext
        filter_upwards [hze, hae, hbe, Lp.coeFn_add a b] with x hz ha hb hab
        rw [hz, hab, Pi.add_apply, ha, hb]
      rw [hz, he]
      exact scalar_real_sobolev_add (n : ℝ) a b ha hb
    simpa only [Nat.cast_add, Nat.cast_one] using hreg

end
end PositiveEinsteinFour.Geometry
end


section

/-! Absolute values in actual Lp and the convergence of positive smooth
regularizations of an approximating scalar sequence. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} {p : ℝ≥0∞}

def scalarLpAbs (f : Lp ℝ p μ) : Lp ℝ p μ :=
  lipschitzWith_one_norm.compLp norm_zero f

theorem scalarLpAbs_coe (f : Lp ℝ p μ) :
    scalarLpAbs f =ᵐ[μ] fun x => |f x| :=
  lipschitzWith_one_norm.coeFn_compLp norm_zero f

theorem scalarLpAbs_nonneg (f : Lp ℝ p μ) : ∀ᵐ x ∂μ, 0 ≤ scalarLpAbs f x := by
  filter_upwards [scalarLpAbs_coe f] with x hx
  rw [hx]
  exact abs_nonneg _

theorem scalarLpAbs_norm [Fact (1 ≤ p)] (f : Lp ℝ p μ) : ‖scalarLpAbs f‖ = ‖f‖ := by
  rw [Lp.norm_def, Lp.norm_def, eLpNorm_congr_ae (scalarLpAbs_coe f)]
  exact congrArg ENNReal.toReal (eLpNorm_norm f (Lp.aestronglyMeasurable f))

theorem scalarLpAbs_continuous [Fact (1 ≤ p)] :
    Continuous (scalarLpAbs : Lp ℝ p μ → Lp ℝ p μ) :=
  lipschitzWith_one_norm.continuous_compLp norm_zero

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance scalarLpAbs_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarLpAbs_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarWeightedBaseLp_absRegularized_error (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (p : ℝ≥0∞)
    [Fact (1 ≤ p)] (hp : p ≤ 4) (a : SmoothScalar (M := M)) (ε : ℝ) (hε : 0 < ε) :
    ‖scalarWeightedBaseLp g o d p hp
        (smoothScalarToWeightedH1 d (smoothScalarAbsRegularized a ε hε)) -
      scalarLpAbs (scalarWeightedBaseLp g o d p hp (smoothScalarToWeightedH1 d a))‖ ≤ ε := by
  let T := scalarWeightedBaseLp g o d p hp
  have hb : ‖T (smoothScalarToWeightedH1 d (smoothScalarAbsRegularized a ε hε)) -
      scalarLpAbs (T (smoothScalarToWeightedH1 d a))‖ ≤
        ‖Lp.const p (normalizedVolume g) ε‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [Lp.coeFn_sub
      (T (smoothScalarToWeightedH1 d (smoothScalarAbsRegularized a ε hε)))
      (scalarLpAbs (T (smoothScalarToWeightedH1 d a))),
      scalarWeightedBaseLp_smooth g o d p hp (smoothScalarAbsRegularized a ε hε),
      scalarLpAbs_coe (T (smoothScalarToWeightedH1 d a)),
      scalarWeightedBaseLp_smooth g o d p hp a,
      Lp.coeFn_const p (normalizedVolume g) ε] with x hsub hreg habs ha hc
    simp only [Pi.sub_apply] at hsub
    rw [hsub, hreg, habs, ha, hc]
    simpa only [Real.norm_eq_abs, Function.const_apply, abs_of_pos hε] using
      smoothScalarAbsRegularized_error a ε hε x
  have hn : ‖Lp.const p (normalizedVolume g) ε‖ = ε := by
    rw [Lp.norm_const _ _ _ (ne_of_gt (zero_lt_one.trans_le (Fact.out : 1 ≤ p)))]
    simp only [Real.norm_eq_abs, abs_of_pos hε, probReal_univ, Real.one_rpow, mul_one]
  exact hb.trans_eq hn

end
end PositiveEinsteinFour.Geometry
end


section

/-! Positive reciprocal solutions of the subcritical scalar equation
are constant. This supplies the rigidity step in the normalized
Sobolev minimization argument, independently of minimizer existence. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {μ : Measure (FrameBundle g)}
  {d : MetricGreenData g μ} {a : M → ℝ}

def scalarSubcriticalWeight (p : ℝ) (a : M → ℝ) (x : M) : ℝ :=
  (3 / 2 : ℝ) / a x ^ 4 * (4 - p) * a x ^ (3 - p)

theorem scalar_inverse_hessian_divergence (s : ScalarCovariantData d a)
    (p : ℝ) (ha : ∀ x, 0 < a x)
    (v : ScalarCovariantData d (fun x => (a x ^ 3)⁻¹))
    (hEq : ∀ e : FrameBundle g,
      a e.base * scalarLaplacian g a e -
        2 * (∑ i, scalarGradient g a e i ^ 2) + 2 * a e.base ^ 2 =
          2 * (a e.base) ^ (4 - p))
    (e : FrameBundle g) (j : Fin 4) :
    (∑ i, scalarGradient g (fun x => (a x ^ 3)⁻¹) e i *
        scalarTraceFreeHessian g a e i j) +
      (3 / 4 : ℝ) * (a e.base ^ 3)⁻¹ *
        ((∑ i, scalarThird g a e j i i) + 4 * scalarGradient g a e j) =
      scalarSubcriticalWeight p a e.base * scalarGradient g a e j := by
  simp_rw [scalar_inverse_cube_gradient s (fun x => ne_of_gt (ha x)) v]
  change (∑ i, ((-3 / a e.base ^ 4) * scalarGradient g a e i) *
      (scalarHessian g a e i j - if i = j then scalarLaplacian g a e / 4 else 0)) +
      (3 / 4 : ℝ) * (a e.base ^ 3)⁻¹ *
        ((∑ i, scalarThird g a e j i i) + 4 * scalarGradient g a e j) = _
  rw [scalar_inverse_hessian_algebra (a e.base) (scalarLaplacian g a e)
    (∑ i, scalarThird g a e j i i) (ne_of_gt (ha e.base))
    (scalarGradient g a e) (scalarHessian g a e) j,
    scalar_reciprocal_equation_derivative s p ha hEq]
  unfold scalarSubcriticalWeight
  ring

variable [T3Space M] [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  [Nonempty M] [PreconnectedSpace M]

local instance nonlinearRigidity_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

/-- The Hessian sign identity forces any positive smooth reciprocal
solution with exponent below four to be constant. -/
theorem scalar_reciprocal_subcritical_constants (g : SmoothMetric M)
    (o : FrameOrientation g) (hRic : RicciThree g) {a : M → ℝ}
    (ha : ContMDiff I4 𝓘(ℝ, ℝ) ∞ a) (hpos : ∀ x, 0 < a x)
    (p : ℝ) (hp : p < 4)
    (hEq : ∀ e : FrameBundle g,
      a e.base * scalarLaplacian g a e -
        2 * (∑ i, scalarGradient g a e i ^ 2) + 2 * a e.base ^ 2 =
          2 * (a e.base) ^ (4 - p)) :
    ∃ c : ℝ, ∀ x, a x = c := by
  let d := canonicalParallelMetricData g o hRic
  let μ := canonicalFrameMeasure g o
  obtain ⟨s⟩ := d.scalarCalculus.toPetersenInput a ha
  have hw : ContMDiff I4 𝓘(ℝ, ℝ) ∞ (fun x => (a x ^ 3)⁻¹) :=
    (ha.pow 3).inv₀ (fun x => pow_ne_zero 3 (ne_of_gt (hpos x)))
  obtain ⟨v⟩ := d.scalarCalculus.toPetersenInput _ hw
  have h := s.weighted_traceFree_green v
  have he (e : FrameBundle g) :
      (∑ j, scalarGradient g a e j *
        ((∑ i, scalarGradient g (fun x => (a x ^ 3)⁻¹) e i *
          scalarTraceFreeHessian g a e i j) +
          (3 / 4 : ℝ) * (a e.base ^ 3)⁻¹ *
            ((∑ i, scalarThird g a e j i i) + 4 * scalarGradient g a e j))) =
      scalarSubcriticalWeight p a e.base * (∑ j, scalarGradient g a e j ^ 2) := by
    simp_rw [scalar_inverse_hessian_divergence s p hpos v hEq]
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  simp_rw [he] at h
  have hkpos (x : M) : 0 < scalarSubcriticalWeight p a x := by
    unfold scalarSubcriticalWeight
    have hx := hpos x
    have hsub : 0 < 4 - p := sub_pos.mpr hp
    positivity
  have hleft : 0 ≤ ∫ e, (a e.base ^ 3)⁻¹ *
      (∑ i, ∑ j, scalarTraceFreeHessian g a e i j ^ 2) ∂μ := by
    apply integral_nonneg
    intro e
    exact mul_nonneg (inv_nonneg.mpr (pow_nonneg (hpos _).le _))
      (Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => sq_nonneg _)))
  have hright : 0 ≤ ∫ e, scalarSubcriticalWeight p a e.base *
      (∑ j, scalarGradient g a e j ^ 2) ∂μ := by
    apply integral_nonneg
    intro e
    exact mul_nonneg (hkpos _).le (Finset.sum_nonneg (fun j _ => sq_nonneg _))
  have hzero : (∫ e, scalarSubcriticalWeight p a e.base *
      (∑ j, scalarGradient g a e j ^ 2) ∂μ) = 0 := by
    linarith only [h, hleft, hright]
  have hk : Continuous (scalarSubcriticalWeight p a) := by
    have hr : Continuous (fun x => a x ^ (3 - p)) :=
      ha.continuous.rpow_const (fun x => Or.inl (ne_of_gt (hpos x)))
    exact ((continuous_const.div (ha.continuous.pow 4)
      (fun x => pow_ne_zero 4 (ne_of_gt (hpos x)))).mul continuous_const).mul hr
  exact scalar_constants_of_gradient_eq_zero g o hRic ha
    (scalarGradient_zero_of_weighted_energy g o ha hk hkpos hzero)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Positive continuous weak Euler solutions have actual C1 representatives.
Local H4 regularity, Fourier embedding and chart unweighting give the
representatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance positiveEulerC1_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_positive_Euler_C1 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (v : M → ℝ) (hv : Continuous v) (hpos : ∀ x, 0 < v x)
    (hurep : (scalarH1BaseValue g o d u : M → ℝ) =ᵐ[normalizedVolume g] v)
    (α β q : ℝ)
    (hf : (f : M → ℝ) =ᵐ[normalizedVolume g] fun x => α * v x + β * (v x) ^ q)
    (hw : ∀ a : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i a)) =
        -(inner ℝ (scalarBasePullback g o f) (scalarH1Value d a))) :
    ContMDiff I4 𝓘(ℝ, ℝ) 1 v := by
  let b := scalarH1BaseValue g o d u
  have hlocal (x : M) : ∃ U : Set M, ∃ F : M → ℝ,
      IsOpen U ∧ x ∈ U ∧ ContMDiffOn I4 𝓘(ℝ, ℝ) 1 F U ∧
        (b : M → ℝ) =ᵐ[(normalizedVolume g).restrict U] F := by
    let z₀ : ChartTarget x := ⟨chartAt FourSpace x x,
      (chartAt FourSpace x).map_source (mem_chart_source FourSpace x)⟩
    obtain ⟨r, hr, ht, w, he, hreg⟩ :=
      scalar_positive_Euler_local_H4 g o d f u v hv hpos hurep α β q hf hw x z₀
    obtain ⟨G, hG, hwG⟩ := scalar_quarter_H4_C1_real_representative w hreg
    have hbr := scalar_rescaled_ae_predicate g x z₀ r hr.ne'
      (fun y => b y = v y) hurep
    have he' : (fun y => chartVolumeDensity g x (scalarRescaledPoint g x z₀ r y) *
        b ((chartAt FourSpace x).symm (scalarRescaledPoint g x z₀ r y))) =ᵐ[
          volume.restrict (ball (0 : FourSpace) (1 / 8))] G := by
      have he₁ := ae_restrict_of_ae_restrict_of_subset
        (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1)) he
      filter_upwards [he₁, hwG, ae_restrict_of_ae hbr,
        ae_restrict_mem isOpen_ball.measurableSet] with y hvw hwg hrep hy
      rw [hrep (ht y (ball_subset_closedBall (ball_subset_ball (by norm_num) hy)))]
      exact hvw.trans hwg
    obtain ⟨U, hU, hxU, _, H, hH, heH⟩ := scalar_chart_C1_unweight g x z₀ r hr
      (by norm_num : (0 : ℝ) < 1 / 8) (by norm_num) b ht G hG he'
    let W := (chartAt FourSpace x).source ∩ (chartAt FourSpace x) ⁻¹' U
    refine ⟨W, fun y => H (chartAt FourSpace x y),
      (chartAt FourSpace x).isOpen_inter_preimage hU, ⟨mem_chart_source FourSpace x, hxU⟩,
      ?_, scalar_chart_representative_ae g x U hU b H heH⟩
    intro y hy
    have hHC : ContDiffAt ℝ 1 H (chartAt FourSpace x y) :=
      (hH _ hy.2).contDiffAt (hU.mem_nhds hy.2)
    exact (hHC.contMDiffAt.comp y
      (contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x) hy.1)).contMDiffWithinAt
  obtain ⟨F, hF, hFb⟩ := scalar_C1_representative_of_local g b hlocal
  let := normalizedVolume_isOpenPosMeasure g
  have hFv : F = v := Measure.eq_of_ae_eq (hFb.trans hurep) hF.continuous hv
  rwa [hFv] at hF

end
end PositiveEinsteinFour.Geometry
end


section

/-! Localized powers on a positive range have the actual weak first derivative,
including the cutoff term. No smoothness of the original scalar is assumed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped SchwartzMap ENNReal ContDiff NNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (f : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} f

theorem scalar_localized_positive_power_weak_derivative (u : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) (Du : Fin 4 → L2)
    (hDu : ∀ i, scalarCoordinateDerivative i (scalarComplexL2 u : T) = (scalarComplexL2 (Du i) : T))
    (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (a B q : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hrange : ∀ᵐ x ∂(volume : Measure V), x ∈ tsupport (χ : V → ℝ) → u x ∈ Icc a B) :
    ∃ v : L2, MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] (fun x => χ x * (u x) ^ q) ∧
      ∀ i, ∃ z : L2, scalarCoordinateDerivative i (scalarComplexL2 v : T) = (scalarComplexL2 z : T) ∧
        (z : V → ℝ) =ᵐ[volume] fun x => D i χ x * (u x) ^ q +
          q * (χ x * (u x) ^ (q - 1)) * Du i x := by
  obtain ⟨φ, hφ, hφc, hzero, ⟨C, hC⟩, hext⟩ := scalar_positive_power_extension a B q ha hB
  have hφ' : ContDiff ℝ ∞ (deriv φ) := (contDiff_infty_iff_deriv.mp hφ).2
  obtain ⟨E, hE⟩ := (hφ'.continuous_deriv (by simp)).bounded_above_of_compact_support hφc.deriv.deriv
  have h₂ (s : ℝ) : |deriv (deriv φ) s| ≤ E := by
    simpa only [Real.norm_eq_abs] using hE s
  have hLip : LipschitzWith C φ := lipschitzWith_of_nnnorm_deriv_le
    (hφ.differentiable (by simp)) (fun s => by
      exact_mod_cast (show ‖deriv φ s‖ ≤ (C : ℝ) by simpa only [Real.norm_eq_abs] using hC s))
  obtain ⟨v, hv, hve, hdv⟩ := scalar_localized_H2_composition_derivative u hu Du hDu χ hc
    φ hφ hLip hzero hC h₂
  refine ⟨v, hv, ?_, fun i => ?_⟩
  · filter_upwards [hve, hrange] with x hv hr
    rw [hv]
    by_cases hx : x ∈ tsupport (χ : V → ℝ)
    · rw [(hext _ (hr hx)).1]
    · rw [image_eq_zero_of_notMem_tsupport hx, zero_mul, zero_mul]
  · let z : L2 := scalarRealSchwartzMultiply (D i χ) (hLip.compLp hzero u) +
      scalarRealSchwartzMultiply χ (scalarDerivativeMultiplier φ hφ hC u
        (Lp.aestronglyMeasurable u) (Du i))
    refine ⟨z, hdv i, ?_⟩
    filter_upwards [Lp.coeFn_add
        (scalarRealSchwartzMultiply (D i χ) (hLip.compLp hzero u))
        (scalarRealSchwartzMultiply χ (scalarDerivativeMultiplier φ hφ hC u
          (Lp.aestronglyMeasurable u) (Du i))),
      scalarRealSchwartzMultiply_coe (D i χ) (hLip.compLp hzero u),
      scalarRealSchwartzMultiply_coe χ (scalarDerivativeMultiplier φ hφ hC u
        (Lp.aestronglyMeasurable u) (Du i)), hLip.coeFn_compLp hzero u,
      scalarDerivativeMultiplier_coe φ hφ hC u (Lp.aestronglyMeasurable u) (Du i), hrange]
      with x hsum hfirst hsecond hvalue hderiv hr
    dsimp only [z]
    rw [hsum, Pi.add_apply, hfirst, hsecond, hvalue, Function.comp_apply, hderiv]
    by_cases hx : x ∈ tsupport (χ : V → ℝ)
    · rw [(hext _ (hr hx)).1, (hext _ (hr hx)).2]
      ring
    · have hχ : χ x = 0 := image_eq_zero_of_notMem_tsupport hx
      have hdχ : D i χ x = 0 := image_eq_zero_of_notMem_tsupport
        (fun h => hx (SchwartzMap.tsupport_lineDerivOp_subset
          (EuclideanSpace.basisFun (Fin 4) ℝ i) χ h))
      simp only [hχ, hdχ, zero_mul, mul_zero, add_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual first and second covariant derivatives of a reciprocal scalar,
for the substitution in the subcritical Euler equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {μ : Measure (FrameBundle g)}
  {d : MetricGreenData g μ} {a : M → ℝ}

theorem scalar_reciprocal_gradient (s : ScalarCovariantData d a)
    (ha : ∀ x, a x ≠ 0) (v : ScalarCovariantData d (fun x => (a x)⁻¹))
    (e : FrameBundle g) (i : Fin 4) :
    scalarGradient g (fun x => (a x)⁻¹) e i =
      -scalarGradient g a e i / a e.base ^ 2 := by
  obtain ⟨e₀, he⟩ := ((d.flow i).map 0).surjective e
  have h := v.derivativeValue i 0 e₀
  have h' := (s.derivativeValue i 0 e₀).inv (ha _)
  have heq := h.unique h'
  rwa [he] at heq

theorem scalar_reciprocal_hessian (s : ScalarCovariantData d a)
    (ha : ∀ x, a x ≠ 0) (v : ScalarCovariantData d (fun x => (a x)⁻¹))
    (e : FrameBundle g) (i j : Fin 4) :
    scalarHessian g (fun x => (a x)⁻¹) e i j =
      2 / a e.base ^ 3 * scalarGradient g a e i * scalarGradient g a e j -
        scalarHessian g a e i j / a e.base ^ 2 := by
  obtain ⟨e₀, he⟩ := ((d.flow i).map 0).surjective e
  have h := v.derivativeGradient i j 0 e₀
  have h' := (s.derivativeGradient i j 0 e₀).neg.div
    ((s.derivativeValue i 0 e₀).pow 2) (pow_ne_zero 2 (ha _))
  have hf : (fun t => scalarGradient g (fun x => (a x)⁻¹) ((d.flow i).map t e₀) j) =
      (fun t => -scalarGradient g a ((d.flow i).map t e₀) j /
        a ((d.flow i).map t e₀).base ^ 2) :=
    funext (fun t => scalar_reciprocal_gradient s ha v _ j)
  rw [hf] at h
  simp only [Pi.pow_apply, Pi.neg_apply] at h'
  have heq := h.unique h'
  rw [he] at heq
  rw [heq]
  simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one]
  field_simp [ha e.base]
  ring

theorem scalar_reciprocal_laplacian (s : ScalarCovariantData d a)
    (ha : ∀ x, a x ≠ 0) (v : ScalarCovariantData d (fun x => (a x)⁻¹))
    (e : FrameBundle g) :
    scalarLaplacian g (fun x => (a x)⁻¹) e =
      2 / a e.base ^ 3 * (∑ i, scalarGradient g a e i ^ 2) -
        scalarLaplacian g a e / a e.base ^ 2 := by
  unfold scalarLaplacian
  simp_rw [scalar_reciprocal_hessian s ha v, Finset.sum_sub_distrib]
  rw [Finset.sum_div, Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  ring

theorem scalar_reciprocal_gradient_energy (s : ScalarCovariantData d a)
    (ha : ∀ x, a x ≠ 0) (v : ScalarCovariantData d (fun x => (a x)⁻¹))
    (e : FrameBundle g) :
    (∑ i, scalarGradient g (fun x => (a x)⁻¹) e i ^ 2) =
      (∑ i, scalarGradient g a e i ^ 2) / a e.base ^ 4 := by
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  rw [scalar_reciprocal_gradient s ha v]
  field_simp [ha e.base]

theorem scalar_reciprocal_euler_equation (s : ScalarCovariantData d a)
    (ha : ∀ x, 0 < a x) (v : ScalarCovariantData d (fun x => (a x)⁻¹))
    (p : ℝ)
    (hEq : ∀ e : FrameBundle g, -scalarLaplacian g a e + 2 * a e.base =
      2 * a e.base ^ (p - 1)) (e : FrameBundle g) :
    (a e.base)⁻¹ * scalarLaplacian g (fun x => (a x)⁻¹) e -
        2 * (∑ i, scalarGradient g (fun x => (a x)⁻¹) e i ^ 2) +
          2 * ((a e.base)⁻¹) ^ 2 = 2 * ((a e.base)⁻¹) ^ (4 - p) := by
  have hn := fun x => ne_of_gt (ha x)
  rw [scalar_reciprocal_laplacian s hn v, scalar_reciprocal_gradient_energy s hn v]
  have hpow : a e.base ^ (p - 1) = a e.base ^ (p - 4) * a e.base ^ 3 := by
    rw [← Real.rpow_natCast, ← Real.rpow_add (ha _)]
    congr 1
    ring
  have hInv : ((a e.base)⁻¹) ^ (4 - p) = a e.base ^ (p - 4) := by
    rw [Real.inv_rpow (ha _).le, ← Real.rpow_neg (ha _).le]
    congr 1
    ring
  rw [hInv]
  have h := hEq e
  rw [hpow] at h
  field_simp [hn e.base]
  linear_combination (a e.base) * h

end
end PositiveEinsteinFour.Geometry
end


section

/-! The Euler identity for a normalized Hilbert-energy minimum. -/

namespace PositiveEinsteinFour.Geometry

open Filter
open scoped _root_.Topology

noncomputable section

/-- The quadratic energy has its usual derivative along an affine line in
the completed energy space; no smooth representative is required. -/
theorem scalar_energy_line_hasDerivAt
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] (w b : H) :
    HasDerivAt (fun t : ℝ => ‖w + t • b‖ ^ 2) (2 * inner ℝ w b) 0 := by
  have hline : HasDerivAt (fun t : ℝ => w + t • b) b 0 := by
    simpa only [Pi.add_def, id_eq, zero_add, one_smul] using
      (hasDerivAt_const (0 : ℝ) w).add ((hasDerivAt_id (0 : ℝ)).smul_const b)
  simpa only [zero_smul, add_zero] using hline.norm_sq

/-- Fermat's rule applied to the homogeneous Sobolev quotient.  The only
analytic ingredient here is the directional derivative of its norm term. -/
theorem scalar_energy_minimum_euler
    {H E : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [NormedAddCommGroup E] [NormedSpace ℝ E] (T : H →L[ℝ] E)
    (w b : H) (hunit : ‖T w‖ = 1)
    (hmin : ∀ v : H, ‖w‖ ^ 2 * ‖T v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (I : ℝ) (hvar : HasDerivAt (fun t : ℝ => ‖T (w + t • b)‖ ^ 2) (2 * I) 0) :
    inner ℝ w b = ‖w‖ ^ 2 * I := by
  let F (t : ℝ) := ‖w + t • b‖ ^ 2 - ‖w‖ ^ 2 * ‖T (w + t • b)‖ ^ 2
  have hlocal : IsLocalMin F 0 := by
    apply Filter.Eventually.of_forall
    intro t
    change F 0 ≤ F t
    simp only [F, zero_smul, add_zero, hunit, one_pow, mul_one, sub_self]
    exact sub_nonneg.mpr (hmin (w + t • b))
  have hdiff : HasDerivAt F (2 * inner ℝ w b - ‖w‖ ^ 2 * (2 * I)) 0 :=
    (scalar_energy_line_hasDerivAt w b).sub (hvar.const_mul (‖w‖ ^ 2))
  have hzero := hlocal.hasDerivAt_eq_zero hdiff
  linarith

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff NNReal ENNReal

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance scalarEuler_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarEuler_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- The actual weak Euler equation for a normalized subcritical minimum,
against every smooth scalar test function. -/
theorem scalar_subcritical_minimum_weak_euler (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (a : SmoothScalar (M := M)) :
    inner ℝ w (smoothScalarToWeightedH1 d a) = ‖w‖ ^ 2 *
      ∫ x, |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^
        (p - 2) * scalarWeightedBaseLp g o d (ENNReal.ofReal p)
          (by exact_mod_cast hp4.le) w x * a.val x ∂normalizedVolume g := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  have hvar := scalarLpNormSq_hasDerivAt_continuous hp (T w)
    (T (smoothScalarToWeightedH1 d a)) hw
    (⟨a.val, a.property.continuous⟩ : C(M, ℝ)) (scalarWeightedBaseLp_smooth g o d _ _ a)
  apply scalar_energy_minimum_euler T w (smoothScalarToWeightedH1 d a) hw hmin
  simpa only [T, map_add, map_smul, ContinuousMap.coe_mk] using hvar

/-- Existence of an actual normalized subcritical weak Euler solution. -/
theorem scalar_subcritical_weak_euler_exists (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4) :
    ∃ w : scalarWeightedH1 d,
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1 ∧
      0 < ‖w‖ ^ 2 ∧ ‖w‖ ^ 2 ≤ 1 ∧
      ∀ a : SmoothScalar (M := M),
        inner ℝ w (smoothScalarToWeightedH1 d a) = ‖w‖ ^ 2 *
          ∫ x, |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^
            (p - 2) * scalarWeightedBaseLp g o d (ENNReal.ofReal p)
              (by exact_mod_cast hp4.le) w x * a.val x ∂normalizedVolume g := by
  obtain ⟨w, hw, hm, hm1, hmin⟩ := scalar_subcritical_normalized_minimum g o d hp hp4
  exact ⟨w, hw, hm, hm1, scalar_subcritical_minimum_weak_euler g o d hp hp4 w hw hmin⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual compact chart value map extends from smooth sections to
the intrinsic L2 completion. Its bound uses only the chart volume density. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Matrix Set
open scoped BigOperators Manifold ContDiff ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def smoothL2AsH1 : SmoothL2TwoForm o →ₗ[ℝ] SmoothH1TwoForm o where
  toFun := id
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable (c : M) (S : Mat4) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K)

def smoothTwoFormGramL2Linear :
    SmoothL2TwoForm o →ₗ[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  (twoFormGramVectorL2 c S hK hKt χ hχ hc hs).toLinearMap.comp
    (smoothTwoFormToH1.toLinearMap.comp smoothL2AsH1)

theorem smoothTwoFormGramL2Linear_bound (hS : Sᵀ * S = 1) :
    ∃ C : ℝ, ∀ u : SmoothL2TwoForm o,
      ‖smoothTwoFormGramL2Linear c S hK hKt χ hχ hc hs u‖ ≤ C * ‖u‖ := by
  obtain ⟨D, hD, hDb⟩ := scalarChart_eLpNorm_bound g c hK hKt
  obtain ⟨B, hB⟩ := (hc.isCompact_range hχ.continuous).isBounded.exists_norm_le
  let C := max B 0
  have hC : 0 ≤ C := le_max_right _ _
  refine ⟨C * D.toReal, fun u => ?_⟩
  let X := smoothTwoFormGramL2Linear c S hK hKt χ hχ hc hs u
  let F := fun x => ‖(u : smoothTwoForms o).val x‖
  let G := fun z => χ z • twoFormChartValue o (u : smoothTwoForms o).val c S hS z
  have he : X =ᵐ[volume] G :=
    twoFormGramVectorL2_coe c S hS hK hKt χ hχ hc hs (smoothL2AsH1 u)
  have hmem : AEStronglyMeasurable G volume := (Lp.aestronglyMeasurable X).congr he
  have hsupport : Function.support G ⊆ K := by
    intro z hz
    by_contra hzK
    apply hz
    change χ z • _ = 0
    rw [image_eq_zero_of_notMem_tsupport (fun h => hzK (hs h)), zero_smul]
  have hi : K.indicator G = G := indicator_eq_self.mpr hsupport
  have hlocal : eLpNorm G 2 volume ≤ ENNReal.ofReal C *
      eLpNorm (fun z => F ((chartAt FourSpace c).symm z)) 2 (volume.restrict K) := by
    calc
      _ = eLpNorm G 2 (volume.restrict K) := by
        conv_lhs => rw [← hi]
        exact eLpNorm_indicator_eq_eLpNorm_restrict hK.isClosed.measurableSet
      _ ≤ _ := eLpNorm_le_mul_eLpNorm_of_ae_le_mul hmem.restrict (by
        filter_upwards [ae_restrict_mem hK.isClosed.measurableSet] with z hz
        change ‖χ z • twoFormChartValue o (u : smoothTwoForms o).val c S hS z‖ ≤ C * ‖F _‖
        rw [norm_smul, twoFormChartValue_norm o (u : smoothTwoForms o).val c S hS z (hKt hz)]
        rw [Real.norm_of_nonneg (norm_nonneg _)]
        exact mul_le_mul_of_nonneg_right ((hB (χ z) (mem_range_self z)).trans (le_max_left _ _))
          (norm_nonneg _)) 2
  have hF : eLpNorm F 2 (normalizedVolume g) ≠ (∞ : ℝ≥0∞) := by
    rw [← eLpNorm_congr_ae (twoFormValueNormL2_coe (u : smoothTwoForms o))]
    exact Lp.eLpNorm_ne_top _
  have hb := hlocal.trans (mul_le_mul' le_rfl (hDb F))
  have ht : ENNReal.ofReal C * (D * eLpNorm F 2 (normalizedVolume g)) ≠ (∞ : ℝ≥0∞) :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top hD hF)
  have hr := ENNReal.toReal_mono ht hb
  have hn : (eLpNorm F 2 (normalizedVolume g)).toReal = ‖u‖ := by
    rw [← eLpNorm_congr_ae (twoFormValueNormL2_coe (u : smoothTwoForms o)), ← Lp.norm_def,
      twoFormValueNormL2_eq_L2norm]
  rw [← eLpNorm_congr_ae he, ← Lp.norm_def, ENNReal.toReal_mul, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal hC, hn] at hr
  exact hr.trans_eq (by ring)

def smoothTwoFormGramL2 (hS : Sᵀ * S = 1) :
    SmoothL2TwoForm o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  (smoothTwoFormGramL2Linear c S hK hKt χ hχ hc hs).mkContinuousOfExistsBound
    (smoothTwoFormGramL2Linear_bound c S hK hKt χ hχ hc hs hS)

def twoFormL2GramValue (hS : Sᵀ * S = 1) :
    TwoFormL2 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  (smoothTwoFormGramL2 c S hK hKt χ hχ hc hs hS).fromCompletion

theorem twoFormL2GramValue_smooth (hS : Sᵀ * S = 1) (u : SmoothL2TwoForm o) :
    twoFormL2GramValue c S hK hKt χ hχ hc hs hS (smoothTwoFormToL2 u) =
      smoothTwoFormGramL2Linear c S hK hKt χ hχ hc hs u :=
  ContinuousLinearMap.fromCompletion_apply_coe _ u

end
end PositiveEinsteinFour.Geometry
end


section

/-! The mass and first-order coefficients of an actual compact chart
test form are smooth, compactly supported Euclidean L2 functions. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Matrix Set
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

theorem twoFormLocalNabla_contDiffAt (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (a : FourSpace → TwoFormFour) (z : FourSpace) (hz : z ∈ (chartAt FourSpace c).target)
    (ha : ContDiffAt ℝ ∞ a z) (i : Fin 4) :
    ContDiffAt ℝ ∞ (twoFormLocalNabla (g := g) c S a i) z := by
  have hsum : ContDiffAt ℝ ∞ (fun w => ∑ r : Fin 6, a w r •
      twoFormSkewAction (twoFormExtract (chartTwoFormConnection (g := g) c S i w))
        ((EuclideanSpace.basisFun (Fin 6) ℝ) r)) z := by
    apply ContDiffAt.sum
    intro r _
    exact ((PiLp.proj 2 (fun _ : Fin 6 => ℝ) r).contDiff.comp_contDiffAt z ha).smul
      (twoFormConnectionAction_contDiffAt c S hS i z hz _)
  have he (w : FourSpace) :
      twoFormSkewAction (twoFormExtract (chartTwoFormConnection (g := g) c S i w)) (a w) =
        ∑ r : Fin 6, a w r •
          twoFormSkewAction (twoFormExtract (chartTwoFormConnection (g := g) c S i w))
            ((EuclideanSpace.basisFun (Fin 6) ℝ) r) := by
    let L := twoFormSkewActionLinear (twoFormExtract (chartTwoFormConnection (g := g) c S i w))
    calc
      _ = L (∑ r : Fin 6, a w r • (EuclideanSpace.basisFun (Fin 6) ℝ) r) :=
        congrArg L (twoForm_sum_components (a w)).symm
      _ = _ := by rw [map_sum]; simp only [map_smul]; rfl
  exact ((ha.fderiv_right (m := ∞) (by simp)).clm_apply contDiffAt_const).add
    (hsum.congr_of_eventuallyEq (Filter.Eventually.of_forall he))

def twoFormMassTest (c : M) (a : FourSpace → TwoFormFour) (z : FourSpace) : TwoFormFour :=
  chartVolumeDensity g c z • a z

def twoFormEnergyTest (c : M) (S : Mat4) (a : FourSpace → TwoFormFour)
    (i : Fin 4) (z : FourSpace) : TwoFormFour :=
  chartVolumeDensity g c z • ∑ j : Fin 4,
    (metricInChart g c z)⁻¹ i j • twoFormLocalNabla (g := g) c S a j z

theorem twoFormMassTest_support (c : M) (a : FourSpace → TwoFormFour) :
    tsupport (twoFormMassTest (g := g) c a) ⊆ tsupport a :=
  tsupport_smul_subset_right _ _

theorem twoFormEnergyTest_support (c : M) (S : Mat4) (a : FourSpace → TwoFormFour)
    (i : Fin 4) : tsupport (twoFormEnergyTest (g := g) c S a i) ⊆ tsupport a := by
  apply closure_minimal _ (isClosed_tsupport a)
  intro z hz
  by_contra hn
  have he (j : Fin 4) := twoFormLocalNabla_zero_off (g := g) c S a z hn j
  apply hz
  simp only [twoFormEnergyTest, he, smul_zero, Finset.sum_const_zero]

theorem twoFormMassTest_smooth (c : M) (a : FourSpace → TwoFormFour)
    (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target)
    (hs : tsupport a ⊆ (chartAt FourSpace c).target) :
    ContDiff ℝ ∞ (twoFormMassTest (g := g) c a) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · exact (chartVolumeDensity_contDiffAt g c z hz).smul
      ((ha z hz).contDiffAt ((chartAt FourSpace c).open_target.mem_nhds hz))
  · exact contDiffAt_const.congr_of_eventuallyEq
      (notMem_tsupport_iff_eventuallyEq.mp (fun h => hz (hs (twoFormMassTest_support c a h))))

theorem twoFormEnergyTest_smooth (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (a : FourSpace → TwoFormFour) (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target)
    (hs : tsupport a ⊆ (chartAt FourSpace c).target) (i : Fin 4) :
    ContDiff ℝ ∞ (twoFormEnergyTest (g := g) c S a i) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · apply (chartVolumeDensity_contDiffAt g c z hz).smul
    apply ContDiffAt.sum
    intro j _
    exact (scalarPrincipalCoefficients_smooth g c z hz i j).smul
      (twoFormLocalNabla_contDiffAt c S hS a z hz
        ((ha z hz).contDiffAt ((chartAt FourSpace c).open_target.mem_nhds hz)) j)
  · exact contDiffAt_const.congr_of_eventuallyEq
      (notMem_tsupport_iff_eventuallyEq.mp
        (fun h => hz (hs (twoFormEnergyTest_support c S a i h))))

def twoFormMassTestL2 (c : M) (a : FourSpace → TwoFormFour)
    (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target) (hc : HasCompactSupport a)
    (hs : tsupport a ⊆ (chartAt FourSpace c).target) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  ((twoFormMassTest_smooth (g := g) c a ha hs).continuous.memLp_of_hasCompactSupport
    (hc.of_isClosed_subset (isClosed_tsupport _) (twoFormMassTest_support (g := g) c a))).toLp
      (twoFormMassTest (g := g) c a)

def twoFormEnergyTestL2 (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (a : FourSpace → TwoFormFour) (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target)
    (hc : HasCompactSupport a) (hs : tsupport a ⊆ (chartAt FourSpace c).target) (i : Fin 4) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  ((twoFormEnergyTest_smooth (g := g) c S hS a ha hs i).continuous.memLp_of_hasCompactSupport
    (hc.of_isClosed_subset (isClosed_tsupport _) (twoFormEnergyTest_support (g := g) c S a i))).toLp
      (twoFormEnergyTest (g := g) c S a i)

theorem twoFormMassTestL2_coe (c : M) (a : FourSpace → TwoFormFour)
    (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target) (hc : HasCompactSupport a)
    (hs : tsupport a ⊆ (chartAt FourSpace c).target) :
    twoFormMassTestL2 (g := g) c a ha hc hs =ᵐ[volume] twoFormMassTest (g := g) c a :=
  MemLp.coeFn_toLp _

theorem twoFormEnergyTestL2_coe (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (a : FourSpace → TwoFormFour) (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target)
    (hc : HasCompactSupport a) (hs : tsupport a ⊆ (chartAt FourSpace c).target) (i : Fin 4) :
    twoFormEnergyTestL2 (g := g) c S hS a ha hc hs i =ᵐ[volume] twoFormEnergyTest (g := g) c S a i :=
  MemLp.coeFn_toLp _

end
end PositiveEinsteinFour.Geometry
end


section

/-! The six L2 coordinates of the actual localized two-form inherit the
first-order distributional regularity of the H1 completion. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped Manifold ContDiff SchwartzMap

noncomputable section

def twoFormVectorComponentL2 (r : Fin 6) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (PiLp.proj 2 (fun _ : Fin 6 => ℝ) r).compLpL 2 volume

theorem twoFormVectorComponentL2_coe (r : Fin 6)
    (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    twoFormVectorComponentL2 r f =ᵐ[volume] fun z => f z r :=
  (PiLp.proj 2 (fun _ : Fin 6 => ℝ) r : TwoFormFour →L[ℝ] ℝ).coeFn_compLpL
    (p := 2) (μ := (volume : Measure FourSpace)) f

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormVectorComponentL2_assemble
    (F : Fin 6 → TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace))
    (u : TwoFormH1 o) (r : Fin 6) :
    twoFormVectorComponentL2 r (twoFormAssembleL2 F u) = F r u := by
  let a : FourSpace → TwoFormFour := fun z => WithLp.toLp 2 (fun k => F k u z)
  have ha : twoFormAssembleL2 F u =ᵐ[volume] a :=
    twoFormAssembleL2_coe F u a (fun _ => Filter.Eventually.of_forall (fun _ => rfl))
  apply Lp.ext
  filter_upwards [twoFormVectorComponentL2_coe r (twoFormAssembleL2 F u), ha] with z hp hz
  exact hp.trans (congrArg (fun v : TwoFormFour => v r) hz)

theorem twoFormGramVectorComponent (c : M) (S : Mat4) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : TwoFormH1 o) (r : Fin 6) :
    twoFormVectorComponentL2 r (twoFormGramVectorL2 c S hK hKt χ hχ hc hs u) =
      twoFormGramValueL2 c S hK hKt χ hχ hc hs (twoFormComponentIndex r) u :=
  twoFormVectorComponentL2_assemble _ u r

theorem twoFormGramVectorComponent_memSobolev_one (c : M) (S : Mat4) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : TwoFormH1 o) (r : Fin 6) :
    MemSobolev 1 2 (scalarComplexL2
      (twoFormVectorComponentL2 r (twoFormGramVectorL2 c S hK hKt χ hχ hc hs u)) :
        𝓢'(FourSpace, ℂ)) := by
  rw [twoFormGramVectorComponent]
  exact twoFormGram_memSobolev_one c S hK hKt χ hχ hc hs (twoFormComponentIndex r) u

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar drift coefficients vary jointly in the actual normal
family; their slice is the geometric density drift. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyDrift (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (j : Fin 4) : ℝ :=
  -((∑ i : Fin 4, heatFamilyScalarPartial (fun y => (heatFamilyMetric g c P y)⁻¹ i j) i z) +
    (heatFamilyDensity g c P z)⁻¹ * ∑ i : Fin 4,
      (heatFamilyMetric g c P z)⁻¹ i j * heatFamilyScalarPartial (heatFamilyDensity g c P) i z)

theorem heatFamilyDrift_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 2 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hdet : 0 < (heatFamilyMetric g c P z).det) (j : Fin 4) :
    ContDiffAt ℝ n (fun y => heatFamilyDrift g c P y j) z := by
  have hP1 : ContDiffAt ℝ (n + 1 + 1 : ℕ) P z := by simpa only [Nat.add_assoc] using hP
  have hA (i j : Fin 4) := heatFamilyInverse_contDiffAt (n + 1) g c P z hP1 hz hdet.ne' i j
  have hJ := heatFamilyDensity_contDiffAt (n + 1) g c P z hP1 hz hdet.ne'
  have hle : (n : ℕ∞ω) ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hJn : heatFamilyDensity g c P z ≠ 0 := (Real.sqrt_pos.mpr hdet).ne'
  apply ((ContDiffAt.sum (fun i _ =>
    heatFamilyScalarPartial_contDiffAt n _ z (hA i j) i)).add ?_).neg
  exact ((hJ.of_le hle).inv hJn).mul (ContDiffAt.sum (fun i _ =>
    ((hA i j).of_le hle).mul (heatFamilyScalarPartial_contDiffAt n _ z hJ i)))

theorem heatFamilyDrift_slice (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 2 P z) (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hdet : 0 < (heatFamilyMetric g c P z).det) (j : Fin 4) :
    heatFamilyDrift g c P z j =
      fourHeatDensityDrift (fun x => (heatFamilyMetric g c P (x, z.2))⁻¹)
        (fun x => heatFamilyDensity g c P (x, z.2)) z.1 j := by
  have hA (i : Fin 4) : DifferentiableAt ℝ
      (fun y => (heatFamilyMetric g c P y)⁻¹ i j) z :=
    (heatFamilyInverse_contDiffAt 1 g c P z hP hz hdet.ne' i j).differentiableAt one_ne_zero
  have hJ : DifferentiableAt ℝ (heatFamilyDensity g c P) z :=
    (heatFamilyDensity_contDiffAt 1 g c P z hP hz hdet.ne').differentiableAt one_ne_zero
  simp only [heatFamilyDrift, fourHeatDensityDrift,
    heatFamilyScalarPartial_slice _ z hJ,
    heatFamilyScalarPartial_slice _ z (hA _)]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The drift used by the actual normal parametrix has the geometric
coordinate transformation law on a proved neighborhood of its center. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem fourHeatDensityDrift_congr (a A : FourSpace → Mat4) (ρ R : FourSpace → ℝ)
    (x : FourSpace) (ha : a =ᶠ[𝓝 x] A) (hρ : ρ =ᶠ[𝓝 x] R) (i : Fin 4) :
    fourHeatDensityDrift a ρ x i = fourHeatDensityDrift A R x i := by
  have hd (j : Fin 4) : partialDeriv (fun y => a y j i) j x =
      partialDeriv (fun y => A y j i) j x := by
    have he : (fun y => a y j i) =ᶠ[𝓝 x] (fun y => A y j i) :=
      ha.mono (fun y hy => congrArg (fun T : Mat4 => T j i) hy)
    exact congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector j))
      he.fderiv_eq
  have hρd (j : Fin 4) : partialDeriv ρ j x = partialDeriv R j x :=
    congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector j)) hρ.fderiv_eq
  simp only [fourHeatDensityDrift, ha.self_of_nhds, hρ.self_of_nhds, hd, hρd]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.metric_pullback_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g}
    (D : HeatNormalFrameData g o c e) (he : e.base ∈ (chartAt FourSpace c).source) :
    heatNormalMetric g o e =ᶠ[𝓝 (0 : FourSpace)]
      heatPullbackMetric g c (fun y => (D.point y).1) := by
  have hs : ∀ᶠ x in 𝓝 (0 : FourSpace), frameExponential g o e x ∈
      (chartAt FourSpace c).source :=
    (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
      ((chartAt FourSpace c).open_source.mem_nhds (by simpa only [frameExponential_zero] using he))
  filter_upwards [hs, ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hs hx
  exact D.metric_pullback x hx hs

theorem HeatNormalFrameData.drift_transport_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g}
    (D : HeatNormalFrameData g o c e) (he : e.base ∈ (chartAt FourSpace c).source) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ r : Fin 4,
      (∑ k, jacobianMatrix (fun y => (D.point y).1) x r k * heatNormalDrift g o e x k) -
        (∑ i, ∑ j, (heatNormalMetric g o e x)⁻¹ i j *
          partialDeriv (fun y => jacobianMatrix (fun z => (D.point z).1) y r j) i x) =
        ∑ p, ∑ q, (metricInChart g c (D.point x).1)⁻¹ p q *
          christoffel g c (D.point x).1 r p q := by
  let F := fun y => (D.point y).1
  have hF : ∀ᶠ x in 𝓝 (0 : FourSpace), ContDiffAt ℝ 2 F x :=
    (D.regular.fst.of_le (show (2 : ℕ∞ω) ≤ 12 by norm_num)).eventually (by norm_num)
  have hG := D.metric_pullback_near he
  filter_upwards [hF, hG.eventuallyEq_nhds, hG, frameExponentialJacobian_eventually_pos g o e,
    ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hFx hGx hG0 hρx hx
  intro r
  have hρ : 0 < (heatNormalMetric g o e x).det := Real.sqrt_pos.mp hρx
  have hd (k : Fin 4) : heatNormalDrift g o e x k =
      fourHeatDensityDrift (fun y => (heatPullbackMetric g c F y)⁻¹)
        (fun y => Real.sqrt (heatPullbackMetric g c F y).det) x k := by
    apply fourHeatDensityDrift_congr
    · exact hGx.mono fun y hy => congrArg Inv.inv hy
    · exact hGx.mono fun y hy => congrArg (fun G : Mat4 => Real.sqrt G.det) hy
  simp_rw [hd, hG0]
  exact heatPullback_drift_transport g c F x hFx (D.in_chart x hx)
    (by simpa only [hG0] using hρ) r

end
end PositiveEinsteinFour.Geometry
end


section

/-! Cancellation of both singular time terms for the actual normal metric,
Jacobian density and normalized leading scalar heat amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalGaussian_leading_residual (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r, ∀ t > (0 : ℝ),
      deriv (fun s => fourHeatGaussian s x * heatNormalLeadingAmplitude g o e x) t +
        fourHeatLocalOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x) 0
          (fun y => fourHeatGaussian t y * heatNormalLeadingAmplitude g o e y) x =
      fourHeatGaussian t x *
        fourHeatLocalOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x) 0
          (heatNormalLeadingAmplitude g o e) x := by
  obtain ⟨r₁, hr₁, hT⟩ := heatNormalLeadingAmplitude_transport_neighborhood g o hRic e he
  obtain ⟨r₂, hr₂, hE⟩ := heatNormalMetric_eikonal_neighborhood g o hRic e he
  have hu : ∀ᶠ x in 𝓝 (0 : FourSpace), ContDiffAt ℝ 2
      (heatNormalLeadingAmplitude g o e) x :=
    ((heatNormalLeadingAmplitude_smoothAt_zero g o e).of_le (by simp)).eventually (by norm_num)
  have hn : ∀ᶠ x in 𝓝 (0 : FourSpace), x ∈ ball 0 r₁ ∧ x ∈ ball 0 r₂ ∧
      ContDiffAt ℝ 2 (heatNormalLeadingAmplitude g o e) x := by
    filter_upwards [ball_mem_nhds (0 : FourSpace) hr₁,
      ball_mem_nhds (0 : FourSpace) hr₂, hu] with x hx₁ hx₂ hux
    exact ⟨hx₁, hx₂, hux⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx t ht
  rw [fourHeatLocalOperator_transport_residual_at _ _ _ t ht _ x (hball hx).2.2,
    hT x (hball hx).1, hE x (hball hx).2.1]
  simp

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normal-coordinate integration formula, with no assumed
Jacobian or measure-identification input. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter MeasureTheory
open scoped Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  [MeasurableSpace M] [BorelSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem heatNormalScalarLift_integral (D : HeatNormalFrameData g o c e)
    (C : OpenPartialHomeomorph FourSpace M)
    (hE : EqOn C (frameExponential g o e) C.source)
    (hCt : C.target ⊆ (chartAt FourSpace c).source)
    (hP : ContDiffOn ℝ 2 D.point C.source)
    (hD : C.source ⊆ Metric.ball 0 D.radius)
    (ψ : FourSpace → ℝ) (hs : tsupport ψ ⊆ C.source) :
    (∫ y, heatNormalScalarLift C ψ y ∂normalizedVolume g) =
      (normalizedChartFactor g).toReal *
        ∫ x, frameExponentialJacobian g o e x * ψ x := by
  let P := fun y => (D.point y).1
  have heq : EqOn P (fun y => chartAt FourSpace c (C y)) C.source := by
    intro x hx
    exact (D.exponential x (hD hx)).trans (congrArg (chartAt FourSpace c) (hE hx).symm)
  have hd (x : FourSpace) (hx : x ∈ C.source) :
      HasFDerivAt (fun y => chartAt FourSpace c (C y)) (fderiv ℝ P x) x := by
    have hp : DifferentiableAt ℝ P x :=
      (hP.contDiffAt (C.open_source.mem_nhds hx)).fst.differentiableAt (by norm_num)
    apply hp.hasFDerivAt.congr_of_eventuallyEq
    filter_upwards [C.open_source.mem_nhds hx] with y hy
    exact (heq hy).symm
  rw [heatNormalScalarLift_integral_chart g c C hCt (fun x => fderiv ℝ P x) hd]
  congr 1
  calc
    _ = ∫ x in C.source, frameExponentialJacobian g o e x * ψ x := by
      apply setIntegral_congr_fun C.open_source.measurableSet
      intro x hx
      have hc : frameExponential g o e x ∈ (chartAt FourSpace c).source := by
        rw [← hE hx]
        exact hCt (C.map_source hx)
      have hv := D.volume_jacobian x (hD hx) hc
      change |(fderiv ℝ P x).det| * chartVolumeDensity g c (chartAt FourSpace c (C x)) *
        ψ x = _
      have heqx : P x = chartAt FourSpace c (C x) := heq hx
      rw [← heqx]
      exact congrArg (fun z : ℝ => z * ψ x) hv.symm
    _ = _ := setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hs h)), mul_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite smooth extensions of local heat data. A positive leading
amplitude has a positive extension, so the transport integrals can be
constructed globally without division at a zero. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped ContDiff _root_.Topology

noncomputable section

theorem heatScalarCutoff_contDiff (n : ℕ) (χ f : FourSpace → ℝ)
    (hχ : ContDiff ℝ n χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ n f y) :
    ContDiff ℝ n (fun y => χ y * f y) := by
  rw [contDiff_iff_contDiffAt]
  intro y
  by_cases hy : y ∈ tsupport χ
  · exact hχ.contDiffAt.mul (hf y hy)
  · have hz : (fun z => χ z * f z) =ᶠ[𝓝 y] (fun _ => 0) := by
      filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hy] with z hz
      simp only [hz, Pi.zero_apply, zero_mul]
    exact contDiffAt_const.congr_of_eventuallyEq hz

private def heatScalarBump (r : ℝ) (hr : 0 < r) : ContDiffBump (0 : FourSpace) where
  rIn := r / 4
  rOut := r / 2
  rIn_pos := by positivity
  rIn_lt_rOut := by linarith

theorem heatScalar_extension (n : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiffAt ℝ n f 0) :
    ∃ F : FourSpace → ℝ, ContDiff ℝ n F ∧ HasCompactSupport F ∧ F =ᶠ[𝓝 0] f := by
  obtain ⟨r, hr, hreg⟩ := Metric.eventually_nhds_iff.mp (hf.eventually (by simp))
  let χ := heatScalarBump r hr
  have hs : tsupport χ ⊆ ball (0 : FourSpace) r := by
    rw [χ.tsupport_eq]
    exact closedBall_subset_ball (by change r / 2 < r; linarith)
  have hF : ContDiff ℝ n (fun y => χ y * f y) :=
    heatScalarCutoff_contDiff n χ f χ.contDiff
      (fun y hy => hreg (by simpa only [mem_ball] using hs hy))
  refine ⟨fun y => χ y * f y, hF, χ.hasCompactSupport.mul_right, ?_⟩
  filter_upwards [χ.eventuallyEq_one] with y hy
  simp only [hy, Pi.one_apply, one_mul]

theorem heatScalar_positive_extension (n : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiffAt ℝ n f 0) (hpos : 0 < f 0) :
    ∃ F : FourSpace → ℝ, ContDiff ℝ n F ∧ (∀ y, 0 < F y) ∧ F =ᶠ[𝓝 0] f := by
  have hp : ∀ᶠ y in 𝓝 (0 : FourSpace), 0 < f y :=
    hf.continuousAt.preimage_mem_nhds (isOpen_Ioi.mem_nhds hpos)
  obtain ⟨r, hr, hreg⟩ := Metric.eventually_nhds_iff.mp ((hf.eventually (by simp)).and hp)
  let χ := heatScalarBump r hr
  have hs : tsupport χ ⊆ ball (0 : FourSpace) r := by
    rw [χ.tsupport_eq]
    exact closedBall_subset_ball (by change r / 2 < r; linarith)
  have hnear (y : FourSpace) (hy : y ∈ tsupport χ) : ContDiffAt ℝ n f y ∧ 0 < f y :=
    hreg (by simpa only [mem_ball] using hs hy)
  have hχ : ContDiff ℝ n χ := χ.contDiff
  let F := fun y => χ y * f y + (1 - χ y)
  refine ⟨F, (heatScalarCutoff_contDiff n χ f hχ (fun y hy => (hnear y hy).1)).add
    (contDiff_const.sub hχ), ?_, ?_⟩
  · intro y
    change 0 < χ y * f y + (1 - χ y)
    by_cases hz : χ y = 0
    · simp [hz]
    · have hχp : 0 < χ y := lt_of_le_of_ne χ.nonneg (Ne.symm hz)
      have hy : y ∈ tsupport χ := subset_tsupport χ hz
      exact add_pos_of_pos_of_nonneg (mul_pos hχp (hnear y hy).2)
        (sub_nonneg.mpr χ.le_one)
  · filter_upwards [χ.eventuallyEq_one] with y hy
    simp only [F, hy, Pi.one_apply, one_mul, sub_self, add_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

omit [SecondCountableTopology M] in
theorem scalarBaseHeatWeight_continuous
    (μ : ScalarBaseEigenIndex g o d) :
    Continuous (fun t : ℝ≥0 => scalarBaseHeatWeight g o d t μ) := by
  change Continuous (fun t : ℝ≥0 => Real.exp (-(t : ℝ) * scalarBaseHeatRate g o d μ))
  exact Real.continuous_exp.comp (continuous_subtype_val.neg.mul_const _)

theorem scalarBaseHeat_continuous (f : Lp ℝ 2 (normalizedVolume g)) :
    Continuous (fun t : ℝ≥0 => scalarBaseHeat g o d t f) := by
  apply continuous_iff_continuousAt.mpr
  intro t
  exact scalarBaseSpectralMultiplier_tendsto g o d (scalarBaseHeatWeight g o d)
    (scalarBaseHeatWeight g o d t) (scalarBaseHeatWeight_bound g o d)
    (scalarBaseHeatWeight_bound g o d t)
    (fun μ => (scalarBaseHeatWeight_continuous g o d μ).continuousAt) f

theorem scalarBaseHeat_tendsto_zero_time (f : Lp ℝ 2 (normalizedVolume g)) :
    Tendsto (fun t : ℝ≥0 => scalarBaseHeat g o d t f) (𝓝 0) (𝓝 f) := by
  have h := (scalarBaseHeat_continuous g o d f).continuousAt (x := 0)
  change Tendsto (fun t : ℝ≥0 => scalarBaseHeat g o d t f) (𝓝 0)
    (𝓝 (scalarBaseHeat g o d 0 f)) at h
  rwa [scalarBaseHeat_zero] at h

theorem scalarBaseHeat_joint_continuous :
    Continuous (fun tf : ℝ≥0 × Lp ℝ 2 (normalizedVolume g) => scalarBaseHeat g o d tf.1 tf.2) := by
  apply continuous_iff_continuousAt.mpr
  intro tf
  apply Metric.continuousAt_iff.mpr
  intro ε hε
  have htime := Metric.continuousAt_iff.mp
    ((scalarBaseHeat_continuous g o d tf.2).continuousAt (x := tf.1))
    (ε / 2) (half_pos hε)
  obtain ⟨δ, hδ, htime⟩ := htime
  refine ⟨min δ (ε / 2), lt_min hδ (half_pos hε), ?_⟩
  intro sf hsf
  have hst : dist sf.1 tf.1 < δ := by
    calc
      dist sf.1 tf.1 ≤ dist sf tf := by rw [Prod.dist_eq]; exact le_max_left _ _
      _ < δ := lt_of_lt_of_le hsf (min_le_left _ _)
  have hsu : dist sf.2 tf.2 < ε / 2 := by
    calc
      dist sf.2 tf.2 ≤ dist sf tf := by rw [Prod.dist_eq]; exact le_max_right _ _
      _ < ε / 2 := lt_of_lt_of_le hsf (min_le_right _ _)
  calc
    dist (scalarBaseHeat g o d sf.1 sf.2) (scalarBaseHeat g o d tf.1 tf.2) ≤
        dist (scalarBaseHeat g o d sf.1 sf.2) (scalarBaseHeat g o d sf.1 tf.2) +
        dist (scalarBaseHeat g o d sf.1 tf.2) (scalarBaseHeat g o d tf.1 tf.2) := dist_triangle _ _ _
    _ ≤ dist sf.2 tf.2 + dist (scalarBaseHeat g o d sf.1 tf.2) (scalarBaseHeat g o d tf.1 tf.2) := by
      apply add_le_add_left
      rw [dist_eq_norm, ← map_sub, dist_eq_norm]
      exact scalarBaseHeat_contraction g o d sf.1 (sf.2 - tf.2)
    _ < ε / 2 + ε / 2 := add_lt_add hsu (htime hst)
    _ = ε := add_halves ε

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalarBaseResolvent_coordinate (f : Lp ℝ 2 (normalizedVolume g))
    (i : ScalarBaseEigenIndex g o d) :
    scalarBaseSpectralEquiv g o d (scalarBaseResolvent g o d f) i =
      i.1.val • scalarBaseSpectralEquiv g o d f i := by
  change (scalarBaseEigenbasis g o d).repr (scalarBaseResolvent g o d f) i =
    i.1.val • (scalarBaseEigenbasis g o d).repr f i
  rw [HilbertBasis.repr_apply_apply, HilbertBasis.repr_apply_apply]
  simp only [scalarBaseEigenbasis, HilbertBasis.coe_mk]
  change inner ℝ (scalarBaseEigenvector g o d i) (scalarBaseResolvent g o d f) =
    i.1.val * inner ℝ (scalarBaseEigenvector g o d i) f
  have he := Module.End.mem_eigenspace_iff.mp
    (scalarBaseEigenvector_hasEigenvector g o d i).1
  change scalarBaseResolvent g o d (scalarBaseEigenvector g o d i) =
    i.1.val • scalarBaseEigenvector g o d i at he
  have hs : inner ℝ (scalarBaseEigenvector g o d i) (scalarBaseResolvent g o d f) =
      inner ℝ (scalarBaseResolvent g o d (scalarBaseEigenvector g o d i)) f :=
    (scalarBaseResolvent_symmetric g o d (scalarBaseEigenvector g o d i) f).symm
  rw [hs, he, real_inner_smul_left]

theorem scalarBaseHeatPowerWeight_bound (t : ℝ≥0) (ht : 0 < t)
    (n : ℕ) (μ : ScalarBaseEigenIndex g o d) :
    |μ.1.val⁻¹ ^ n * scalarBaseHeatWeight g o d t μ| ≤
      Real.exp t * (n.factorial : ℝ) / (t : ℝ) ^ n := by
  have htR : 0 < (t : ℝ) := ht
  have hm := (scalarBaseResolvent_eigenvalue g o d μ.1.property).1
  change 0 < μ.1.val at hm
  have hy : 0 ≤ (t : ℝ) * μ.1.val⁻¹ := mul_nonneg htR.le (inv_pos.mpr hm).le
  have hn : 0 < (n.factorial : ℝ) := by exact_mod_cast n.factorial_pos
  have he := (div_le_iff₀ hn).mp
    (Real.pow_div_factorial_le_exp ((t : ℝ) * μ.1.val⁻¹) hy n)
  have he' := mul_le_mul_of_nonneg_right he (Real.exp_pos (-((t : ℝ) * μ.1.val⁻¹))).le
  have heq : (Real.exp ((t : ℝ) * μ.1.val⁻¹) * (n.factorial : ℝ)) *
      Real.exp (-((t : ℝ) * μ.1.val⁻¹)) = (n.factorial : ℝ) := by
    rw [mul_right_comm, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
  rw [heq] at he'
  have hw : scalarBaseHeatWeight g o d t μ =
      Real.exp t * Real.exp (-((t : ℝ) * μ.1.val⁻¹)) := by
    rw [scalarBaseHeatWeight, scalarBaseHeatRate, ← Real.exp_add]
    congr 1
    ring
  rw [hw, abs_of_pos (mul_pos (pow_pos (inv_pos.mpr hm) n)
    (mul_pos (Real.exp_pos _) (Real.exp_pos _)))]
  calc
    _ = (Real.exp t / (t : ℝ) ^ n) *
        (((t : ℝ) * μ.1.val⁻¹) ^ n * Real.exp (-((t : ℝ) * μ.1.val⁻¹))) := by
      rw [mul_pow]
      field_simp [ne_of_gt htR]
    _ ≤ (Real.exp t / (t : ℝ) ^ n) * (n.factorial : ℝ) :=
      mul_le_mul_of_nonneg_left he' (by positivity)
    _ = _ := by ring

def scalarBaseHeatPowerSource (t : ℝ≥0) (ht : 0 < t) (n : ℕ) :
    Lp ℝ 2 (normalizedVolume g) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  scalarBaseSpectralMultiplier g o d (fun μ => μ.1.val⁻¹ ^ n * scalarBaseHeatWeight g o d t μ)
    (Real.exp t * (n.factorial : ℝ) / (t : ℝ) ^ n) (by positivity)
    (scalarBaseHeatPowerWeight_bound g o d t ht n)

theorem scalarBaseResolvent_power_coordinate (n : ℕ) (f : Lp ℝ 2 (normalizedVolume g))
    (μ : ScalarBaseEigenIndex g o d) :
    (scalarBaseSpectralEquiv g o d ((scalarBaseResolvent g o d ^ n) f)) μ =
      μ.1.val ^ n • (scalarBaseSpectralEquiv g o d f) μ := by
  induction n generalizing f with
  | zero => simp
  | succ n ih =>
      rw [pow_succ]
      change (scalarBaseSpectralEquiv g o d
        ((scalarBaseResolvent g o d ^ n) (scalarBaseResolvent g o d f))) μ = _
      rw [ih, scalarBaseResolvent_coordinate, smul_smul, ← pow_succ]

theorem scalarBaseHeatPowerSource_resolvent (t : ℝ≥0) (ht : 0 < t)
    (n : ℕ) (f : Lp ℝ 2 (normalizedVolume g)) :
    (scalarBaseResolvent g o d ^ n) (scalarBaseHeatPowerSource g o d t ht n f) =
      scalarBaseHeat g o d t f := by
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext μ
  rw [scalarBaseResolvent_power_coordinate, scalarBaseHeat_coordinate]
  change μ.1.val ^ n • (scalarBaseSpectralEquiv g o d
    (scalarBaseSpectralMultiplier g o d _ _ _ _ f)) μ = _
  rw [scalarBaseSpectralMultiplier_coordinate, smul_smul]
  congr 1
  have hm : μ.1.val ≠ 0 := (scalarBaseResolvent_eigenvalue g o d μ.1.property).1.ne'
  rw [← mul_assoc, ← mul_pow,
    mul_inv_cancel₀ hm, one_pow, one_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual scalar spectral vectors are smooth functions satisfying the
geometric Laplace eigenvalue equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance eigenPointwise_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalar_weak_eigen_smooth (u : scalarH1 d) (κ : ℝ)
    (hu : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        κ * inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v)) :
    ∃ F : SmoothScalar (M := M), u = smoothScalarToH1 d F ∧
      smoothScalarLaplacian g F = (-κ) • F := by
  obtain ⟨F, hF⟩ := scalar_weak_eigen_smooth_representative g o d u κ hu
  have hueq : u = smoothScalarToH1 d F := scalarH1_eq_smooth_of_value d u F hF
  let r : SmoothScalar (M := M) := smoothScalarLaplacian g F + κ • F
  have hr (b : SmoothScalar (M := M)) :
      inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) r)
        (smoothScalarValueL2 g (canonicalFrameMeasure g o) b) = 0 := by
    have he := hu (smoothScalarToH1 d b)
    rw [hueq] at he
    simp only [scalarH1BaseValue_smooth] at he
    change smoothScalarDirichlet d F b =
      κ * inner ℝ (smoothScalarBaseL2 g F) (smoothScalarBaseL2 g b) at he
    have hi := (scalarBasePullback g o).inner_map_map (smoothScalarBaseL2 g F)
      (smoothScalarBaseL2 g b)
    rw [scalarBasePullback_smooth, scalarBasePullback_smooth] at hi
    rw [← hi, smoothScalarDirichlet_symm d F b,
      smoothScalarDirichlet_laplacian_pairing] at he
    dsimp only [r]
    rw [map_add, map_smul, inner_add_left, real_inner_smul_left,
      smoothScalarLaplacian_valueL2]
    have hc := real_inner_comm (smoothScalarValueL2 g (canonicalFrameMeasure g o) b)
      (smoothScalarLaplacianL2 (μ := canonicalFrameMeasure g o) F)
    linarith only [he, hc]
  have hz : smoothScalarValueL2 g (canonicalFrameMeasure g o) r = 0 :=
    inner_self_eq_zero.mp (hr r)
  have hr0 : r = 0 := smoothScalarValueL2_injective g o (by simpa only [map_zero] using hz)
  refine ⟨F, hueq, ?_⟩
  change smoothScalarLaplacian g F + κ • F = 0 at hr0
  have heq := eq_neg_of_add_eq_zero_left hr0
  ext x
  have hx := congrArg (fun a : SmoothScalar (M := M) => a.val x) heq
  change (smoothScalarLaplacian g F).val x = (-κ) * F.val x
  change (smoothScalarLaplacian g F).val x = -(κ * F.val x) at hx
  simpa only [neg_mul] using hx

variable [SecondCountableTopology M]

theorem scalarBaseEigenvector_smooth (i : ScalarBaseEigenIndex g o d) :
    ∃ F : SmoothScalar (M := M), scalarBaseEigenvector g o d i = smoothScalarBaseL2 g F ∧
      smoothScalarLaplacian g F = (-(i.1.val⁻¹ - 1)) • F := by
  obtain ⟨u, hval, hu⟩ := scalarBaseResolvent_eigenvector_weak g o d
    (scalarBaseEigenvector_hasEigenvector g o d i)
  obtain ⟨F, hF, hL⟩ := scalar_weak_eigen_smooth g o d u (i.1.val⁻¹ - 1) (fun v => by
    rw [hu v, hval])
  refine ⟨F, ?_, hL⟩
  rw [← hval, hF, scalarH1BaseValue_smooth]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The positive subcritical Euler equation has only the unit solution
on the actual closed connected normalized Einstein manifold. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  [MeasurableSpace M] [BorelSpace M] [Nonempty M] [PreconnectedSpace M]

local instance eulerRigidity_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

theorem scalar_positive_subcritical_euler (g : SmoothMetric M)
    (o : FrameOrientation g) (hRic : RicciThree g) {u : M → ℝ}
    (hu : ContMDiff I4 𝓘(ℝ, ℝ) ∞ u) (hpos : ∀ x, 0 < u x)
    (p : ℝ) (hp₀ : 2 < p) (hp₁ : p < 4)
    (hEq : ∀ e : FrameBundle g, -scalarLaplacian g u e + 2 * u e.base =
      2 * u e.base ^ (p - 1)) : ∀ x, u x = 1 := by
  let d := canonicalParallelMetricData g o hRic
  obtain ⟨s⟩ := d.scalarCalculus.toPetersenInput u hu
  have hv : ContMDiff I4 𝓘(ℝ, ℝ) ∞ (fun x => (u x)⁻¹) :=
    hu.inv₀ (fun x => ne_of_gt (hpos x))
  obtain ⟨v⟩ := d.scalarCalculus.toPetersenInput _ hv
  obtain ⟨c, hc⟩ := scalar_reciprocal_subcritical_constants g o hRic hv
    (fun x => inv_pos.mpr (hpos x)) p hp₁
    (scalar_reciprocal_euler_equation s hpos v p hEq)
  have hconst (x : M) : u x = c⁻¹ := by
    have h := congrArg Inv.inv (hc x)
    simpa only [inv_inv] using h
  have hG (e : FrameBundle g) (i : Fin 4) : scalarGradient g u e i = 0 := by
    obtain ⟨e₀, he⟩ := ((d.toMetricGreenData.flow i).map 0).surjective e
    have h := s.derivativeValue i 0 e₀
    have hf : (fun t => u ((d.toMetricGreenData.flow i).map t e₀).base) =
        (fun _ : ℝ => c⁻¹) := funext (fun _ => hconst _)
    rw [hf] at h
    have hz := h.unique (hasDerivAt_const 0 c⁻¹)
    rwa [he] at hz
  have hH (e : FrameBundle g) (i j : Fin 4) : scalarHessian g u e i j = 0 := by
    obtain ⟨e₀, he⟩ := ((d.toMetricGreenData.flow i).map 0).surjective e
    have h := s.derivativeGradient i j 0 e₀
    have hf : (fun t => scalarGradient g u ((d.toMetricGreenData.flow i).map t e₀) j) =
        (fun _ : ℝ => 0) := funext (fun _ => hG _ j)
    rw [hf] at h
    have hz := h.unique (hasDerivAt_const 0 0)
    rwa [he] at hz
  let x₀ : M := Classical.arbitrary M
  have hcpos : 0 < c⁻¹ := by rw [← hconst x₀]; exact hpos x₀
  have hunit := hEq (frameAt g x₀)
  simp only [scalarLaplacian, hH, Finset.sum_const_zero, neg_zero, zero_add, hconst] at hunit
  have hpEq : (c⁻¹) ^ (p - 2) = 1 := by
    have hpow : (c⁻¹) ^ (p - 1) = (c⁻¹) ^ (p - 2) * c⁻¹ := by
      calc
        _ = (c⁻¹) ^ ((p - 2) + 1) := by congr 1; ring
        _ = _ := by rw [Real.rpow_add hcpos, Real.rpow_one]
    rw [hpow] at hunit
    nlinarith only [hunit, hcpos]
  have hcunit : c⁻¹ = 1 :=
    (Real.rpow_left_inj hcpos.le zero_le_one (ne_of_gt (sub_pos.mpr hp₀))).mp
      (by simpa only [Real.one_rpow] using hpEq)
  intro x
  exact (hconst x).trans hcunit

end
end PositiveEinsteinFour.Geometry
end


section

/-! The rational Kato test is an admissible actual Sobolev variation of the
normalized minimum.  Its Euler identity is derived directly from that
minimum, with no additional extension of the weak equation assumed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance katoTesting_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance katoTesting_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- The actual base representative has the same composition law as its
frame pullback.  Membership in L² is the only integrability requirement. -/
theorem scalarH1_base_composition (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (u v : scalarH1 d) (φ : ℝ → ℝ)
    (hv : scalarH1Value d v =ᵐ[canonicalFrameMeasure g o]
      fun e => φ (scalarH1Value d u e))
    (hmem : MemLp (fun x => φ (scalarH1BaseValue g o d u x)) 2 (normalizedVolume g)) :
    scalarH1BaseValue g o d v =ᵐ[normalizedVolume g]
      fun x => φ (scalarH1BaseValue g o d u x) := by
  let f : Lp ℝ 2 (normalizedVolume g) := hmem.toLp _
  have hf : f =ᵐ[normalizedVolume g] fun x => φ (scalarH1BaseValue g o d u x) :=
    MemLp.coeFn_toLp hmem
  have hpu : scalarH1Value d u =ᵐ[canonicalFrameMeasure g o]
      fun e => scalarH1BaseValue g o d u e.base := by
    rw [← scalarH1BaseValue_spec g o d u]
    exact Lp.coeFn_compMeasurePreserving _ (canonicalFrameMeasure_base g o)
  have hpf : scalarBasePullback g o f = scalarH1Value d v := by
    apply Lp.ext
    have hf' := (canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae hf
    filter_upwards [Lp.coeFn_compMeasurePreserving f (canonicalFrameMeasure_base g o),
      hf', hpu, hv] with e he hf heU heV
    change Lp.compMeasurePreserving FrameBundle.base (canonicalFrameMeasure_base g o) f e = _
    rw [he]
    change f e.base = _
    rw [hf, heV, heU]
  have hb : scalarH1BaseValue g o d v = f := by
    apply (scalarBasePullback g o).injective
    rw [scalarH1BaseValue_spec, hpf]
  rw [hb]
  exact hf

theorem scalarH1_katoTest_base_exists (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {lam : ℝ} (hlam : 0 < lam)
    (u : scalarH1 d) :
    ∃ v : scalarH1 d,
      (scalarH1BaseValue g o d v : M → ℝ) =ᵐ[normalizedVolume g]
        (fun x => scalarKatoTest lam (scalarH1BaseValue g o d u x)) ∧
      ∀ i : Fin 4, scalarH1Gradient d i v =ᵐ[canonicalFrameMeasure g o]
        fun e => scalarKatoTestRate lam (scalarH1Value d u e) * scalarH1Gradient d i u e := by
  obtain ⟨v, hv, hgrad⟩ := scalarH1_katoTest_exists d hlam u
  refine ⟨v, ?_, hgrad⟩
  apply scalarH1_base_composition g o d u v (scalarKatoTest lam)
    hv
  apply (Lp.memLp (scalarH1BaseValue g o d u)).of_le_mul
    ((scalarKatoTest_smooth hlam).continuous.comp_aestronglyMeasurable
      (Lp.aestronglyMeasurable (scalarH1BaseValue g o d u)))
  exact Eventually.of_forall fun x => by
    simpa only [Real.norm_eq_abs] using scalarKatoTest_abs_le hlam (scalarH1BaseValue g o d u x)

theorem scalarH1_katoSquare_base_exists (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {lam : ℝ} (hlam : 0 < lam)
    (u : scalarH1 d) :
    ∃ v : scalarH1 d,
      (scalarH1BaseValue g o d v : M → ℝ) =ᵐ[normalizedVolume g]
        (fun x => scalarKatoSquare lam (scalarH1BaseValue g o d u x)) ∧
      ∀ i : Fin 4, scalarH1Gradient d i v =ᵐ[canonicalFrameMeasure g o]
        fun e => scalarKatoSquareRate lam (scalarH1Value d u e) * scalarH1Gradient d i u e := by
  obtain ⟨v, hv, hgrad⟩ := scalarH1_katoSquare_exists d hlam u
  refine ⟨v, ?_, hgrad⟩
  apply scalarH1_base_composition g o d u v (scalarKatoSquare lam)
    hv
  have hLip : LipschitzWith (⟨6 / lam + 1, by positivity⟩ : ℝ≥0) (scalarKatoSquare lam) :=
    lipschitzWith_of_nnnorm_deriv_le ((scalarKatoSquare_smooth hlam).differentiable (by simp))
      (fun s => by
        have hb := scalarKatoSquareRate_abs_le hlam s
        rw [← scalarKatoSquare_deriv hlam s] at hb
        exact_mod_cast (show ‖deriv (scalarKatoSquare lam) s‖ ≤ 6 / lam + 1 by
          simpa only [Real.norm_eq_abs] using hb))
  exact hLip.comp_memLp (scalarKatoSquare_zero lam) (Lp.memLp (scalarH1BaseValue g o d u))

/-- Admissibility and the exact nonlinear Euler identity for a rational
test of an actual homogeneous minimum. -/
theorem scalar_minimum_kato_test (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ z : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) z‖ ^ 2 ≤ ‖z‖ ^ 2)
    {lam : ℝ} (hlam : 0 < lam) :
    ∃ v : scalarH1 d,
      scalarH1BaseValue g o d v =ᵐ[normalizedVolume g]
        (fun x => scalarKatoTest lam
          (scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w) x)) ∧
      (∀ i : Fin 4, scalarH1Gradient d i v =ᵐ[canonicalFrameMeasure g o]
        fun e => scalarKatoTestRate lam (scalarH1Value d (scalarWeightedH1ToH1 d w) e) *
          scalarH1Gradient d i (scalarWeightedH1ToH1 d w) e) ∧
      inner ℝ w (scalarWeightedH1Equiv d v) = ‖w‖ ^ 2 *
        ∫ x, |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^
          (p - 2) * scalarWeightedBaseLp g o d (ENNReal.ofReal p)
            (by exact_mod_cast hp4.le) w x *
          scalarKatoTest lam (scalarWeightedBaseLp g o d (ENNReal.ofReal p)
            (by exact_mod_cast hp4.le) w x) ∂normalizedVolume g := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  let u := scalarWeightedH1ToH1 d w
  obtain ⟨v, hv, hgrad⟩ := scalarH1_katoTest_base_exists g o d hlam u
  have hvalue : (T (scalarWeightedH1Equiv d v) : M → ℝ) =ᵐ[normalizedVolume g]
      fun x => scalarKatoTest lam (T w x) := by
    have hz := scalarWeightedBaseLp_coe g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) (scalarWeightedH1Equiv d v)
    simp only [scalarWeightedH1ToH1_equiv] at hz
    have hu := scalarWeightedBaseLp_coe g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w
    filter_upwards [hz, hu, hv] with x hx hy hvx
    exact hx.trans (hvx.trans (congrArg (scalarKatoTest lam) hy.symm))
  have hb : ∀ᵐ x ∂normalizedVolume g,
      |T (scalarWeightedH1Equiv d v) x| ≤ lam⁻¹ * |T w x| := by
    filter_upwards [hvalue] with x hx
    rw [hx]
    exact scalarKatoTest_abs_le hlam _
  have hvar := scalarLpRelativeNormSq_hasDerivAt hp (T w)
    (T (scalarWeightedH1Equiv d v)) hw (inv_nonneg.mpr hlam.le) hb
  have he := scalar_energy_minimum_euler T w (scalarWeightedH1Equiv d v) hw hmin _
    (by simpa only [map_add, map_smul] using hvar)
  refine ⟨v, hv, hgrad, ?_⟩
  rw [he]
  congr 1
  apply integral_congr_ae
  filter_upwards [hvalue] with x hx
  rw [hx]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Products with one extra Sobolev derivative, including the H2 endpoint,
for the localized positive-power bootstrap. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_real_sobolev_smul (s r : ℝ) (u : L2)
    (hu : MemSobolev s 2 (scalarComplexL2 u : T)) :
    MemSobolev s 2 (scalarComplexL2 (r • u) : T) := by
  rw [scalarComplexL2_real_smul_distribution]
  exact hu.smul (r : ℂ)

theorem scalar_real_integer_product_extra (n : ℕ) (hn : 2 ≤ n) (u v : L2)
    (hu : MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T))
    (hv : MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 v : T)) :
    ∃ w : L2, MemSobolev (n : ℝ) 2 (scalarComplexL2 w : T) ∧
      (w : V → ℝ) =ᵐ[volume] fun x => u x * v x := by
  by_cases h : n = 2
  · subst n
    exact scalar_real_H2_H3_product u v hu (by norm_num at hv; exact hv)
  · exact scalar_real_integer_product n (by omega) u v hu (hv.mono (by linarith))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The absolute value of a subcritical extremizer belongs to the actual
energy space and has the same minimum energy. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance scalarNonnegative_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarNonnegative_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_subcritical_minimum_absolute (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2) :
    ∃ v : scalarWeightedH1 d,
      scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v =
        scalarLpAbs (scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w) ∧
      ‖v‖ ^ 2 = ‖w‖ ^ 2 := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  obtain ⟨u, hu, hlim⟩ := mem_closure_iff_seq_limit.mp ((smoothScalarToWeightedH1_dense d) w)
  choose a ha using hu
  have halim : Tendsto (fun n => smoothScalarToWeightedH1 d (a n)) atTop (𝓝 w) := by
    simpa only [ha] using hlim
  let ε (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
  have hε (n : ℕ) : 0 < ε n := by dsimp [ε]; positivity
  have hεlim : Tendsto ε atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  let v (n : ℕ) := smoothScalarToWeightedH1 d (smoothScalarAbsRegularized (a n) (ε n) (hε n))
  let y := scalarLpAbs (T w)
  have hy : ‖y‖ = 1 := (scalarLpAbs_norm (T w)).trans hw
  have habslim : Tendsto (fun n => scalarLpAbs (T (smoothScalarToWeightedH1 d (a n))))
      atTop (𝓝 y) := scalarLpAbs_continuous.continuousAt.tendsto.comp
        (T.continuous.continuousAt.tendsto.comp halim)
  have herr : Tendsto (fun n => T (v n) - scalarLpAbs (T (smoothScalarToWeightedH1 d (a n))))
      atTop (𝓝 0) :=
    squeeze_zero_norm (fun n => scalarWeightedBaseLp_absRegularized_error
      g o d _ _ (a n) (ε n) (hε n)) hεlim
  have hvlim : Tendsto (fun n => T (v n)) atTop (𝓝 y) := by
    simpa only [sub_add_cancel, zero_add] using herr.add habslim
  have hlo : Tendsto (fun n => ‖w‖ ^ 2 * ‖T (v n)‖ ^ 2) atTop (𝓝 (‖w‖ ^ 2)) := by
    simpa only [hy, one_pow, mul_one] using (hvlim.norm.pow 2).const_mul (‖w‖ ^ 2)
  have hup : Tendsto (fun n => ‖smoothScalarToWeightedH1 d (a n)‖ ^ 2 + (ε n) ^ 2)
      atTop (𝓝 (‖w‖ ^ 2)) := by
    simpa only [zero_pow (by decide : (2 : ℕ) ≠ 0), add_zero] using
      (halim.norm.pow 2).add (hεlim.pow 2)
  have henergy : Tendsto (fun n => ‖v n‖ ^ 2) atTop (𝓝 (‖w‖ ^ 2)) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le hlo hup (fun n => hmin (v n))
      (fun n => smoothScalarAbsRegularized_energy_le o d (a n) (ε n) (hε n))
  obtain ⟨z, hz, hznorm, _⟩ := scalar_energy_minimizing_sequence_limit
    T (‖w‖ ^ 2) hmin v y hy hvlim henergy
  exact ⟨z, hz, hznorm⟩

/-- There is a nonnegative normalized weak Euler minimizer in the actual
completed scalar Sobolev space, with positive energy at most one. -/
theorem scalar_subcritical_nonnegative_minimum (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4) :
    ∃ w : scalarWeightedH1 d,
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1 ∧
      0 < ‖w‖ ^ 2 ∧ ‖w‖ ^ 2 ≤ 1 ∧
      (∀ᵐ x ∂normalizedVolume g,
        0 ≤ scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x) ∧
      (∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
        ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2) := by
  obtain ⟨u, hu, hu0, hu1, hmin⟩ := scalar_subcritical_normalized_minimum g o d hp hp4
  obtain ⟨w, hw, hnorm⟩ := scalar_subcritical_minimum_absolute g o d hp4 u hu hmin
  refine ⟨w, ?_, hnorm ▸ hu0, hnorm ▸ hu1, ?_, ?_⟩
  · rw [hw, scalarLpAbs_norm]
    exact hu
  · rw [hw]
    exact scalarLpAbs_nonneg _
  · simpa only [hnorm] using hmin

end
end PositiveEinsteinFour.Geometry
end


section

/-! Recovery of the full actual Sobolev jet from its scalar Lp representative,
and the weighted pairing on smooth scalar functions. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance scalarSmoothRep_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarSmoothRep_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarWeightedBaseLp_injective (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (p : ℝ≥0∞)
    [Fact (1 ≤ p)] (hp : p ≤ 4) : Function.Injective (scalarWeightedBaseLp g o d p hp) := by
  intro u v huv
  have hu := scalarWeightedBaseLp_coe g o d p hp u
  have hv := scalarWeightedBaseLp_coe g o d p hp v
  rw [huv] at hu
  have hb := Lp.ext (hu.symm.trans hv)
  apply (scalarWeightedH1Equiv d).symm.injective
  apply scalarH1Value_injective d
  change scalarH1Value d (scalarWeightedH1ToH1 d u) =
    scalarH1Value d (scalarWeightedH1ToH1 d v)
  rw [← scalarH1BaseValue_spec g o d (scalarWeightedH1ToH1 d u),
    ← scalarH1BaseValue_spec g o d (scalarWeightedH1ToH1 d v), hb]

theorem scalarWeightedH1_eq_smooth_of_Lp_representative (g : SmoothMetric M)
    (o : FrameOrientation g) (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4)
    (u : scalarWeightedH1 d) (a : SmoothScalar (M := M))
    (hrep : scalarWeightedBaseLp g o d p hp u =ᵐ[normalizedVolume g] a.val) :
    u = smoothScalarToWeightedH1 d a := by
  apply scalarWeightedBaseLp_injective g o d p hp
  exact Lp.ext (hrep.trans (scalarWeightedBaseLp_smooth g o d p hp a).symm)

theorem smoothScalarToWeightedH1_inner (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (a b : SmoothScalar (M := M)) :
    inner ℝ (smoothScalarToWeightedH1 d a) (smoothScalarToWeightedH1 d b) =
      (∫ x, a.val x * b.val x ∂normalizedVolume g) + smoothScalarDirichlet d a b / 2 := by
  have hvalue : inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) a)
      (smoothScalarValueL2 g (canonicalFrameMeasure g o) b) =
        ∫ x, a.val x * b.val x ∂normalizedVolume g := by
    rw [← scalarBasePullback_smooth g o a, ← scalarBasePullback_smooth g o b,
      (scalarBasePullback g o).inner_map_map, smoothScalarBaseL2_inner]
  change inner ℝ (scalarWeightedH1Equiv d (smoothScalarToH1 d a))
    (scalarWeightedH1Equiv d (smoothScalarToH1 d b)) = _
  rw [scalarWeightedH1_inner]
  simp only [scalarH1Value_smooth, scalarH1Gradient_smooth, hvalue]
  change (∫ x, a.val x * b.val x ∂normalizedVolume g) +
      (1 / 2 : ℝ) * smoothScalarDirichlet d a b = _
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Pairing an L2 two-form coefficient with a smooth compact vector
coefficient is a bounded map into scalar L2. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set

noncomputable section

variable (b : FourSpace → TwoFormFour) (hb : Continuous b) (hc : HasCompactSupport b)

include hb hc

theorem twoFormCoefficient_bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ z, ‖b z‖ ≤ C := by
  obtain ⟨C, hC⟩ := (hc.isCompact_range hb).isBounded.exists_norm_le
  exact ⟨max C 0, le_max_right _ _, fun z => (hC _ (mem_range_self z)).trans (le_max_left _ _)⟩

def twoFormCoefficientBound : ℝ := Classical.choose (twoFormCoefficient_bound b hb hc)

theorem twoFormCoefficientBound_nonneg : 0 ≤ twoFormCoefficientBound b hb hc :=
  (Classical.choose_spec (twoFormCoefficient_bound b hb hc)).1

theorem twoFormCoefficientBound_le (z : FourSpace) : ‖b z‖ ≤ twoFormCoefficientBound b hb hc :=
  (Classical.choose_spec (twoFormCoefficient_bound b hb hc)).2 z

theorem twoFormCoefficientPair_memLp (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    MemLp (fun z => inner ℝ (f z) (b z)) 2 volume := by
  apply (Lp.memLp f).of_le_mul ((Lp.aestronglyMeasurable f).inner hb.aestronglyMeasurable)
  filter_upwards with z
  exact (norm_inner_le_norm (f z) (b z)).trans
    ((mul_le_mul_of_nonneg_left (twoFormCoefficientBound_le b hb hc z) (norm_nonneg _)).trans_eq
      (mul_comm _ _))

def twoFormCoefficientPair (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  (twoFormCoefficientPair_memLp b hb hc f).toLp _

theorem twoFormCoefficientPair_coe (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    twoFormCoefficientPair b hb hc f =ᵐ[volume] fun z => inner ℝ (f z) (b z) :=
  MemLp.coeFn_toLp _

def twoFormCoefficientPairLinear :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →ₗ[ℝ] Lp ℝ 2 (volume : Measure FourSpace) where
  toFun := twoFormCoefficientPair b hb hc
  map_add' f h := by
    apply Lp.ext
    filter_upwards [twoFormCoefficientPair_coe b hb hc (f + h),
      twoFormCoefficientPair_coe b hb hc f, twoFormCoefficientPair_coe b hb hc h,
      Lp.coeFn_add f h, Lp.coeFn_add (twoFormCoefficientPair b hb hc f)
        (twoFormCoefficientPair b hb hc h)] with z hsum hf hh hfh hp
    rw [hsum, hfh, Pi.add_apply, inner_add_left, hp, Pi.add_apply, hf, hh]
  map_smul' r f := by
    apply Lp.ext
    filter_upwards [twoFormCoefficientPair_coe b hb hc (r • f),
      twoFormCoefficientPair_coe b hb hc f, Lp.coeFn_smul r f,
      Lp.coeFn_smul r (twoFormCoefficientPair b hb hc f)] with z hrf hf hs hp
    simp only [RingHom.id_apply]
    rw [hrf, hs, Pi.smul_apply, real_inner_smul_left, hp, Pi.smul_apply, hf]
    rfl

theorem twoFormCoefficientPair_norm (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    ‖twoFormCoefficientPair b hb hc f‖ ≤ twoFormCoefficientBound b hb hc * ‖f‖ := by
  apply Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [twoFormCoefficientPair_coe b hb hc f] with z hz
  rw [hz]
  exact (norm_inner_le_norm (f z) (b z)).trans
    ((mul_le_mul_of_nonneg_left (twoFormCoefficientBound_le b hb hc z) (norm_nonneg _)).trans_eq
      (mul_comm _ _))

def twoFormCoefficientPairL2 :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (twoFormCoefficientPairLinear b hb hc).mkContinuous (twoFormCoefficientBound b hb hc)
    (twoFormCoefficientPair_norm b hb hc)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Arbitrary alternating tensor coordinates are fixed linear combinations
of the six actual two-form components, also after H1 completion. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Matrix
open scoped BigOperators Manifold ContDiff

noncomputable section

theorem twoFormTensor_coordinate_expansion (a : TwoFormFour) (v : Fin 2 → Fin 4) :
    twoFormTensor a v = ∑ r : Fin 6, a r * twoFormTensor (EuclideanSpace.basisFun (Fin 6) ℝ r) v := by
  have h := congrArg (fun x : TwoFormFour => twoFormTensorLinear x v) (twoForm_sum_components a)
  simp only [map_sum, map_smul] at h
  exact h.symm

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K)

theorem twoFormGramValue_tensor_coe (v : Fin 2 → Fin 4) (w : SmoothH1TwoForm o) :
    twoFormGramValueL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 w) =ᵐ[volume] fun z =>
      χ z * twoFormTensor (twoFormChartValue o (w : smoothTwoForms o).val c S hS z) v := by
  rw [twoFormGramValueL2_smooth]
  exact (ScalarEuclideanSobolev.valueL2_coe _).trans (Filter.Eventually.of_forall
    (twoFormGramCutoffC1_value c S hS hKt χ hχ hc hs v w))

include hS in
theorem twoFormGramValue_component_expansion (v : Fin 2 → Fin 4) (u : TwoFormH1 o) :
    twoFormGramValueL2 c S hK hKt χ hχ hc hs v u =
      ∑ r : Fin 6, twoFormTensor (EuclideanSpace.basisFun (Fin 6) ℝ r) v •
        twoFormGramValueL2 c S hK hKt χ hχ hc hs (twoFormComponentIndex r) u := by
  let C : Fin 6 → ℝ := fun r => twoFormTensor (EuclideanSpace.basisFun (Fin 6) ℝ r) v
  let L : TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
    ∑ r : Fin 6, C r • twoFormGramValueL2 c S hK hKt χ hχ hc hs (twoFormComponentIndex r)
  change twoFormGramValueL2 c S hK hKt χ hχ hc hs v u = L u
  refine UniformSpace.Completion.induction_on u
    (isClosed_eq (twoFormGramValueL2 c S hK hKt χ hχ hc hs v).continuous L.continuous) ?_
  intro w
  let F := fun r : Fin 6 => C r • twoFormGramValueL2 c S hK hKt χ hχ hc hs
    (twoFormComponentIndex r) (smoothTwoFormToH1 w)
  have he : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ r : Fin 6,
      F r z = C r * (χ z * twoFormChartValue o (w : smoothTwoForms o).val c S hS z r) := by
    apply Filter.eventually_all.mpr
    intro r
    filter_upwards [Lp.coeFn_smul (C r) (twoFormGramValueL2 c S hK hKt χ hχ hc hs
        (twoFormComponentIndex r) (smoothTwoFormToH1 w)),
      twoFormGramValue_tensor_coe c S hS hK hKt χ hχ hc hs (twoFormComponentIndex r) w]
      with z hmul hval
    change (C r • twoFormGramValueL2 c S hK hKt χ hχ hc hs
      (twoFormComponentIndex r) (smoothTwoFormToH1 w)) z = _
    rw [hmul]
    change C r * twoFormGramValueL2 c S hK hKt χ hχ hc hs
      (twoFormComponentIndex r) (smoothTwoFormToH1 w) z = _
    rw [hval, twoFormTensor_component]
  change twoFormGramValueL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 w) = ∑ r : Fin 6, F r
  apply Lp.ext
  filter_upwards [twoFormGramValue_tensor_coe c S hS hK hKt χ hχ hc hs v w,
    Lp.coeFn_finsetSum Finset.univ F, he] with z hleft hright hall
  rw [hleft, hright]
  change χ z * twoFormTensor (twoFormChartValue o (w : smoothTwoForms o).val c S hS z) v =
    ∑ r : Fin 6, F r z
  rw [twoFormTensor_coordinate_expansion, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [hall r]
  dsimp only [C]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The finitely many reconstructed coordinate components control each
partition piece in the intrinsic L2 norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

local instance twoFormLocalNorm_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

omit [T3Space M] [MeasurableSpace M] [BorelSpace M] [Nonempty M] in
theorem twoForm_product_coordinate_bound (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : smoothTwoForms o) (x : M),
      ‖(smoothTwoFormProduct ρ u).val x‖ ≤
        C * ∑ a : Fin 2 → Fin 4, |ρ.val x * twoFormCoordinates o u.val c (chartAt FourSpace c x) a| := by
  obtain ⟨C, hC, hCb⟩ := twoForm_chart_reverse_bound g o c
    (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs)
  refine ⟨C, hC, fun u x => ?_⟩
  by_cases hx : ρ.val x = 0
  · change ‖ρ.val x • u.val x‖ ≤ _
    simp only [hx, zero_smul, norm_zero, zero_mul, abs_zero, Finset.sum_const_zero, mul_zero, le_refl]
  · have ht := subset_tsupport ρ.val hx
    have hz : chartAt FourSpace c x ∈ scalarChartSupport c ρ := ⟨x, ht, rfl⟩
    have hb := hCb u.val (chartAt FourSpace c x) hz (ρ.val x)
    rw [(chartAt FourSpace c).left_inv (hs ht)] at hb
    change ‖ρ.val x • u.val x‖ ≤ _
    simpa only [norm_smul, Real.norm_eq_abs] using hb

theorem twoForm_product_local_norm (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : SmoothH1TwoForm o,
      ‖twoFormValueNormL2 (smoothTwoFormProduct ρ (u : smoothTwoForms o))‖ ≤
        C * ∑ a : Fin 2 → Fin 4,
          ‖twoFormReconstructedValue c ρ hs a (smoothTwoFormToH1 u)‖ := by
  obtain ⟨C, hC, hCb⟩ := twoForm_product_coordinate_bound (o := o) c ρ hs
  refine ⟨C, hC, fun u => ?_⟩
  let R := fun a : Fin 2 → Fin 4 => twoFormReconstructedValue c ρ hs a (smoothTwoFormToH1 u)
  let S : Lp ℝ 2 (normalizedVolume g) := ∑ a : Fin 2 → Fin 4, scalarLpAbs (R a)
  have hall : ∀ᵐ x ∂normalizedVolume g, ∀ a : Fin 2 → Fin 4,
      scalarLpAbs (R a) x = |ρ.val x * twoFormCoordinates o (u : smoothTwoForms o).val c (chartAt FourSpace c x) a| := by
    apply Filter.eventually_all.mpr
    intro a
    filter_upwards [scalarLpAbs_coe (R a), twoFormReconstructedValue_smooth_coe c ρ hs a u] with x ha hr
    exact ha.trans (congrArg abs hr)
  have hdom : ‖twoFormValueNormL2 (smoothTwoFormProduct ρ (u : smoothTwoForms o))‖ ≤ C * ‖S‖ := by
    apply Lp.norm_le_mul_norm_of_ae_le_mul
    filter_upwards [hall, Lp.coeFn_finsetSum Finset.univ (fun a => scalarLpAbs (R a)),
      twoFormValueNormL2_coe (smoothTwoFormProduct ρ (u : smoothTwoForms o))] with x hx hsum hval
    change ‖twoFormValueNormL2 (smoothTwoFormProduct ρ (u : smoothTwoForms o)) x‖ ≤ C * ‖S x‖
    have hvalue : ‖twoFormValueNormL2 (smoothTwoFormProduct ρ (u : smoothTwoForms o)) x‖ =
        ‖(smoothTwoFormProduct ρ (u : smoothTwoForms o)).val x‖ := by
      rw [hval, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    have hS : S x = ∑ a : Fin 2 → Fin 4,
        |ρ.val x * twoFormCoordinates o (u : smoothTwoForms o).val c (chartAt FourSpace c x) a| := by
      exact (show S x = ∑ a : Fin 2 → Fin 4, scalarLpAbs (R a) x from
        by simpa only [Finset.sum_apply] using hsum).trans
          (Finset.sum_congr rfl (fun a _ => hx a))
    calc
      _ = ‖(smoothTwoFormProduct ρ (u : smoothTwoForms o)).val x‖ := hvalue
      _ ≤ C * ∑ a : Fin 2 → Fin 4,
          |ρ.val x * twoFormCoordinates o (u : smoothTwoForms o).val c (chartAt FourSpace c x) a| :=
        hCb (u : smoothTwoForms o) x
      _ = C * ‖S x‖ := by
        rw [Real.norm_eq_abs, hS, abs_of_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _))]
  apply hdom.trans
  apply mul_le_mul_of_nonneg_left _ hC
  calc
    ‖S‖ ≤ ∑ a : Fin 2 → Fin 4, ‖scalarLpAbs (R a)‖ := norm_sum_le _ _
    _ = _ := by simp only [scalarLpAbs_norm]; rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Separating the scalar test derivative from the connection term in
the actual two-form weak equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

theorem twoFormLocalNabla_smul_const (c : M) (S : Mat4)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (b : TwoFormFour) (i : Fin 4) (z : FourSpace) :
    twoFormLocalNabla (g := g) c S (fun w => ψ w • b) i z =
      partialDeriv ψ i z • b + ψ z •
        twoFormSkewAction (twoFormExtract (chartTwoFormConnection (g := g) c S i z)) b := by
  have hd := ((hψ.differentiable (by simp) z).hasFDerivAt.smul_const b).fderiv
  unfold twoFormLocalNabla
  rw [hd]
  have hc := (twoFormSkewActionLinear
    (twoFormExtract (chartTwoFormConnection (g := g) c S i z))).map_smul (ψ z) b
  change partialDeriv ψ i z • b + _ = _
  exact congrArg (fun v => partialDeriv ψ i z • b + v) hc

def twoFormWeightedConnection (c : M) (S : Mat4) (b : TwoFormFour)
    (i : Fin 4) (z : FourSpace) : TwoFormFour :=
  chartVolumeDensity g c z • ∑ j : Fin 4, (metricInChart g c z)⁻¹ i j •
    twoFormSkewAction (twoFormExtract (chartTwoFormConnection (g := g) c S j z)) b

theorem twoFormEnergyTest_smul_const (c : M) (S : Mat4)
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (b : TwoFormFour) (i : Fin 4) (z : FourSpace) :
    twoFormEnergyTest (g := g) c S (fun w => ψ w • b) i z =
      (∑ j : Fin 4, (chartVolumeDensity g c z * (metricInChart g c z)⁻¹ i j * partialDeriv ψ j z) • b) +
      ψ z • twoFormWeightedConnection (g := g) c S b i z := by
  simp only [twoFormEnergyTest, twoFormLocalNabla_smul_const c S ψ hψ,
    smul_add, Finset.sum_add_distrib, Finset.smul_sum, twoFormWeightedConnection, smul_smul]
  congr 1
  · apply Finset.sum_congr rfl
    intro j _
    rw [mul_assoc]
  · apply Finset.sum_congr rfl
    intro j _
    congr 1
    ring

theorem twoFormWeightedConnection_contDiffAt (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (b : TwoFormFour) (i : Fin 4) (z : FourSpace) (hz : z ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (twoFormWeightedConnection (g := g) c S b i) z := by
  apply (chartVolumeDensity_contDiffAt g c z hz).smul
  exact ContDiffAt.sum (fun j _ => (scalarPrincipalCoefficients_smooth g c z hz i j).smul
    (twoFormConnectionAction_contDiffAt c S hS j z hz b))

theorem twoFormCutoffWeightedConnection_smooth (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    (b : TwoFormFour) (i : Fin 4) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target) :
    ContDiff ℝ ∞ (fun z => χ z • twoFormWeightedConnection (g := g) c S b i z) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ tsupport χ
  · exact hχ.contDiffAt.smul (twoFormWeightedConnection_contDiffAt c S hS b i z (hs hz))
  · apply contDiffAt_const.congr_of_eventuallyEq
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hz] with w hw
    rw [hw]
    exact zero_smul _ _

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite regularity of the actual differential expression used in the
heat transport recursion. Each application loses two derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem fourHeat_partial_contDiff (n : ℕ) (u : FourSpace → ℝ)
    (hu : ContDiff ℝ (n + 1 : ℕ) u) (i : Fin 4) :
    ContDiff ℝ n (partialDeriv u i) :=
  (hu.fderiv_right (m := n) (by norm_num [Nat.cast_add])).clm_apply
    (contDiff_const (c := coordinateVector i))

theorem fourHeatLocalOperator_contDiff (n : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ) (c u : FourSpace → ℝ)
    (ha : ∀ i j, ContDiff ℝ n (fun x => a x i j))
    (hb : ∀ i, ContDiff ℝ n (fun x => b x i)) (hc : ContDiff ℝ n c)
    (hu : ContDiff ℝ (n + 2 : ℕ) u) :
    ContDiff ℝ n (fun x => fourHeatLocalOperator (a x) (b x) (c x) u x) := by
  have hp (i : Fin 4) : ContDiff ℝ (n + 1 : ℕ) (partialDeriv u i) := by
    apply fourHeat_partial_contDiff (n + 1) u _ i
    simpa only [Nat.add_assoc] using hu
  have hpp (i j : Fin 4) : ContDiff ℝ n (partialDeriv (partialDeriv u i) j) :=
    fourHeat_partial_contDiff n _ (hp i) j
  have hp' (i : Fin 4) : ContDiff ℝ n (partialDeriv u i) :=
    (hp i).of_le (by exact_mod_cast Nat.le_succ n)
  have hu' : ContDiff ℝ n u := hu.of_le (by exact_mod_cast Nat.le_add_right n 2)
  exact ((ContDiff.sum (fun i _ => ContDiff.sum (fun j _ => (ha i j).mul
    (hpp i j)))).neg.add (ContDiff.sum (fun i _ => (hb i).mul (hp' i)))).add
      (hc.mul hu')

theorem fourHeat_partial_germ {u v : FourSpace → ℝ} {x : FourSpace}
    (h : u =ᶠ[nhds x] v) (i : Fin 4) : partialDeriv u i x = partialDeriv v i x := by
  exact congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector i)) h.fderiv_eq

theorem fourHeatRadialTransport_germ (a : Mat4) (b : Fin 4 → ℝ)
    {u v : FourSpace → ℝ} {x : FourSpace} (h : u =ᶠ[nhds x] v) :
    fourHeatRadialTransport a b u x = fourHeatRadialTransport a b v x := by
  unfold fourHeatRadialTransport
  simp only [fourHeat_partial_germ h, h.self_of_nhds]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual scalar and matrix coefficients of the two-form heat
operator form one finite-regularity family. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyFirst (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (i : Fin 4) : HeatMat6 :=
  fourHeatConnectionFirst (heatFamilyMetric g c P z)⁻¹
    (fun j => heatFamilyTwoFormConnection g c P j z) i

def heatFamilyZero (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace) : HeatMat6 :=
  heatFamilyPotential g c P z +
    (∑ i : Fin 4, heatFamilyDrift g c P z i • heatFamilyTwoFormConnection g c P i z) -
    ∑ i : Fin 4, ∑ j : Fin 4, (heatFamilyMetric g c P z)⁻¹ i j •
      ((Matrix.of fun k l => heatFamilyScalarPartial
        (fun y => heatFamilyTwoFormConnection g c P i y k l) j z) +
        heatFamilyTwoFormConnection g c P j z * heatFamilyTwoFormConnection g c P i z)

theorem heatFamilyFirst_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : (heatFamilyMetric g c P z).det ≠ 0)
    (i : Fin 4) (k l : Fin 6) :
    ContDiffAt ℝ n (fun y => heatFamilyFirst g c P y i k l) z := by
  change ContDiffAt ℝ n (fun y => (-2 : ℝ) * ∑ j : Fin 4,
    (heatFamilyMetric g c P y)⁻¹ i j * heatFamilyTwoFormConnection g c P j y k l) z
  exact contDiffAt_const.mul (ContDiffAt.sum (fun j _ =>
    (heatFamilyInverse_contDiffAt n g c P z hP hz hmetric i j).mul
      (heatFamilyTwoFormConnection_contDiffAt n g c P z hP hz hframe j k l)))

theorem heatFamilyZero_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 2 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z).det)
    (k l : Fin 6) :
    ContDiffAt ℝ n (fun y => heatFamilyZero g c P y k l) z := by
  have hle : (n : ℕ∞ω) ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hP1 : ContDiffAt ℝ (n + 1 + 1 : ℕ) P z := by simpa only [Nat.add_assoc] using hP
  have hA (i : Fin 4) (k l : Fin 6) : ContDiffAt ℝ (n + 1 : ℕ)
      (fun y => heatFamilyTwoFormConnection g c P i y k l) z :=
    heatFamilyTwoFormConnection_contDiffAt (n + 1) g c P z hP1 hz hframe i k l
  have hA0 (i : Fin 4) (k l : Fin 6) := (hA i k l).of_le hle
  have hD (i j : Fin 4) (k l : Fin 6) :=
    heatFamilyScalarPartial_contDiffAt n _ z (hA i k l) j
  have hV := heatFamilyPotential_contDiffAt n g c P z
    (hP.of_le (by exact_mod_cast (show n ≤ n + 2 by omega))) hz k l
  have hInv (i j : Fin 4) := heatFamilyInverse_contDiffAt n g c P z
    (hP.of_le (by exact_mod_cast (show n + 1 ≤ n + 2 by omega))) hz hmetric.ne' i j
  change ContDiffAt ℝ n (fun y => heatFamilyPotential g c P y k l +
    (∑ i : Fin 4, heatFamilyDrift g c P y i * heatFamilyTwoFormConnection g c P i y k l) -
    ∑ i : Fin 4, ∑ j : Fin 4, (heatFamilyMetric g c P y)⁻¹ i j *
      (heatFamilyScalarPartial (fun w => heatFamilyTwoFormConnection g c P i w k l) j y +
        ∑ q : Fin 6, heatFamilyTwoFormConnection g c P j y k q *
          heatFamilyTwoFormConnection g c P i y q l)) z
  apply (hV.add (ContDiffAt.sum (fun i _ =>
    (heatFamilyDrift_contDiffAt n g c P z hP hz hmetric i).mul (hA0 i k l)))).sub
  apply ContDiffAt.sum
  intro i _
  apply ContDiffAt.sum
  intro j _
  exact (hInv i j).mul ((hD i j k l).add
    (ContDiffAt.sum (fun q _ => (hA0 j k q).mul (hA0 i q l))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual scalar and matrix coefficients of the one-form heat
operator form one finite-regularity family. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyOneFirst (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (i : Fin 4) : Mat4 :=
  fourHeatOneConnectionFirst (heatFamilyMetric g c P z)⁻¹
    (fun j => heatFamilyConnection g c P j z) i

def heatFamilyOneZero (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace) : Mat4 :=
  ((3 : ℝ) • (1 : Mat4)) +
    (∑ i : Fin 4, heatFamilyDrift g c P z i • heatFamilyConnection g c P i z) -
    ∑ i : Fin 4, ∑ j : Fin 4, (heatFamilyMetric g c P z)⁻¹ i j •
      ((Matrix.of fun k l => heatFamilyScalarPartial
        (fun y => heatFamilyConnection g c P i y k l) j z) +
        heatFamilyConnection g c P j z * heatFamilyConnection g c P i z)

theorem heatFamilyOneFirst_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 1 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : (heatFamilyMetric g c P z).det ≠ 0)
    (i : Fin 4) (k l : Fin 4) :
    ContDiffAt ℝ n (fun y => heatFamilyOneFirst g c P y i k l) z := by
  change ContDiffAt ℝ n (fun y => (-2 : ℝ) * ∑ j : Fin 4,
    (heatFamilyMetric g c P y)⁻¹ i j * heatFamilyConnection g c P j y k l) z
  exact contDiffAt_const.mul (ContDiffAt.sum (fun j _ =>
    (heatFamilyInverse_contDiffAt n g c P z hP hz hmetric i j).mul
      (heatFamilyConnection_contDiffAt n g c P z hP hz hframe j k l)))

theorem heatFamilyOneZero_contDiffAt (n : ℕ) (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ (n + 2 : ℕ) P z)
    (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z).det)
    (k l : Fin 4) :
    ContDiffAt ℝ n (fun y => heatFamilyOneZero g c P y k l) z := by
  have hle : (n : ℕ∞ω) ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hP1 : ContDiffAt ℝ (n + 1 + 1 : ℕ) P z := by simpa only [Nat.add_assoc] using hP
  have hA (i : Fin 4) (k l : Fin 4) : ContDiffAt ℝ (n + 1 : ℕ)
      (fun y => heatFamilyConnection g c P i y k l) z :=
    heatFamilyConnection_contDiffAt (n + 1) g c P z hP1 hz hframe i k l
  have hA0 (i : Fin 4) (k l : Fin 4) := (hA i k l).of_le hle
  have hD (i j : Fin 4) (k l : Fin 4) :=
    heatFamilyScalarPartial_contDiffAt n _ z (hA i k l) j
  have hV : ContDiffAt ℝ n (fun _ : HeatRadialFrameSpace => ((3 : ℝ) • (1 : Mat4)) k l) z := contDiffAt_const
  have hInv (i j : Fin 4) := heatFamilyInverse_contDiffAt n g c P z
    (hP.of_le (by exact_mod_cast (show n + 1 ≤ n + 2 by omega))) hz hmetric.ne' i j
  change ContDiffAt ℝ n (fun y => ((3 : ℝ) • (1 : Mat4)) k l +
    (∑ i : Fin 4, heatFamilyDrift g c P y i * heatFamilyConnection g c P i y k l) -
    ∑ i : Fin 4, ∑ j : Fin 4, (heatFamilyMetric g c P y)⁻¹ i j *
      (heatFamilyScalarPartial (fun w => heatFamilyConnection g c P i w k l) j y +
        ∑ q : Fin 4, heatFamilyConnection g c P j y k q *
          heatFamilyConnection g c P i y q l)) z
  apply (hV.add (ContDiffAt.sum (fun i _ =>
    (heatFamilyDrift_contDiffAt n g c P z hP hz hmetric i).mul (hA0 i k l)))).sub
  apply ContDiffAt.sum
  intro i _
  apply ContDiffAt.sum
  intro j _
  exact (hInv i j).mul ((hD i j k l).add
    (ContDiffAt.sum (fun q _ => (hA0 j k q).mul (hA0 i q l))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Pointwise drift transport wherever the actual normal frame is regular
and the actual exponential remains in its coordinate chart. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric Set Filter
open scoped BigOperators ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem HeatNormalFrameData.metric_pullback_germ (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source) :
    heatNormalMetric g o e =ᶠ[𝓝 x] heatPullbackMetric g c (fun y => (D.point y).1) := by
  have hsource : ∀ᶠ y in 𝓝 x, frameExponential g o e y ∈ (chartAt FourSpace c).source :=
    (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
      ((chartAt FourSpace c).open_source.mem_nhds hs)
  filter_upwards [isOpen_ball.mem_nhds hx, hsource] with y hy hsy
  exact D.metric_pullback y hy hsy

theorem HeatNormalFrameData.drift_transport_at (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius) (hP : ContDiffAt ℝ 2 D.point x)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hdet : 0 < (heatNormalMetric g o e x).det) (r : Fin 4) :
    (∑ k, jacobianMatrix (fun y => (D.point y).1) x r k * heatNormalDrift g o e x k) -
      (∑ i, ∑ j, (heatNormalMetric g o e x)⁻¹ i j *
        partialDeriv (fun y => jacobianMatrix (fun z => (D.point z).1) y r j) i x) =
      ∑ p, ∑ q, (metricInChart g c (D.point x).1)⁻¹ p q *
        christoffel g c (D.point x).1 r p q := by
  let F := fun y => (D.point y).1
  have hG := D.metric_pullback_germ x hx hs
  have hd (k : Fin 4) : heatNormalDrift g o e x k =
      fourHeatDensityDrift (fun y => (heatPullbackMetric g c F y)⁻¹)
        (fun y => Real.sqrt (heatPullbackMetric g c F y).det) x k := by
    apply fourHeatDensityDrift_congr
    · exact hG.mono fun y hy => congrArg Inv.inv hy
    · exact hG.mono fun y hy => congrArg (fun G : Mat4 => Real.sqrt G.det) hy
  simp_rw [hd, hG.self_of_nhds]
  exact heatPullback_drift_transport g c F x hP.fst (D.in_chart x hx)
    (by simpa only [hG.self_of_nhds] using hdet) r

end
end PositiveEinsteinFour.Geometry
end


section

/-! Applying the actual metric and drift transformations to the normal
rough operator. All local hypotheses come from the constructed frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.rough_pullback_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g}
    (D : HeatNormalFrameData g o c e) (he : e.base ∈ (chartAt FourSpace c).source)
    (T : FourSpace → CovariantCoordinates 2)
    (hT : ∀ z ∈ (chartAt FourSpace c).target, ∀ a, ContDiffAt ℝ ∞ (fun y => T y a) z) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ v : Fin 2 → Fin 4,
      -(∑ i, ∑ j, (heatNormalMetric g o e x)⁻¹ i j *
        tensorCovariantDirection (heatNormalFrameConnection g c D.point)
          (tensorCovariantDirection (heatNormalFrameConnection g c D.point)
            (fun y => frameTensor (D.point y).2 (T (D.point y).1)) i) j x v) +
        (∑ i, heatNormalDrift g o e x i *
          tensorCovariantDirection (heatNormalFrameConnection g c D.point)
            (fun y => frameTensor (D.point y).2 (T (D.point y).1)) i x v) =
        -frameTensor (D.point x).2
          (twoFormSecondTrace (metricInChart g c (D.point x).1)⁻¹
            (covariantDerivative g c (covariantDerivative g c T) (D.point x).1)) v := by
  have hp : ∀ᶠ x in 𝓝 (0 : FourSpace), ContDiffAt ℝ 2 D.point x :=
    (D.regular.of_le (show (2 : ℕ∞ω) ≤ 12 by norm_num)).eventually (by norm_num)
  have hg : ∀ᶠ x in 𝓝 (0 : FourSpace),
      (D.point x).2ᵀ * metricInChart g c (D.point x).1 * (D.point x).2 = 1 := by
    filter_upwards [ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    exact D.orthonormal x hx
  filter_upwards [hp, hg.eventually_nhds, D.inverseMetric_transport_near he,
    D.drift_transport_near he, ball_mem_nhds (0 : FourSpace) D.radius_pos]
      with x hpx hgx ha hb hx
  intro v
  exact heatNormal_rough_pullback g c D.point T x hpx hT (D.in_chart x hx) hgx
    (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x) ha hb v

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth scalar eigenfunctions chosen from the actual orthonormal basis,
with their exact heat evolution and geometric Laplace equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarBaseEigenfunction (i : ScalarBaseEigenIndex g o d) : SmoothScalar (M := M) :=
  (scalarBaseEigenvector_smooth g o d i).choose

theorem scalarBaseEigenfunction_L2 (i : ScalarBaseEigenIndex g o d) :
    scalarBaseEigenvector g o d i = smoothScalarBaseL2 g (scalarBaseEigenfunction g o d i) :=
  (scalarBaseEigenvector_smooth g o d i).choose_spec.1

theorem scalarBaseEigenfunction_laplacian (i : ScalarBaseEigenIndex g o d) :
    smoothScalarLaplacian g (scalarBaseEigenfunction g o d i) =
      (-scalarBaseHeatRate g o d i) • scalarBaseEigenfunction g o d i :=
  (scalarBaseEigenvector_smooth g o d i).choose_spec.2

theorem scalarBaseHeat_eigenvector (t : ℝ≥0) (i : ScalarBaseEigenIndex g o d) :
    scalarBaseHeat g o d t (scalarBaseEigenvector g o d i) =
      scalarBaseHeatWeight g o d t i • scalarBaseEigenvector g o d i := by
  classical
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext j
  rw [scalarBaseHeat_coordinate, map_smul]
  have hbi : scalarBaseEigenbasis g o d i = scalarBaseEigenvector g o d i := by
    simp only [scalarBaseEigenbasis, HilbertBasis.coe_mk]
  have hb : scalarBaseSpectralEquiv g o d (scalarBaseEigenvector g o d i) =
      lp.single 2 i (1 : ℝ) := by
    change (scalarBaseEigenbasis g o d).repr _ = _
    simpa only [hbi] using (scalarBaseEigenbasis g o d).repr_self i
  rw [hb]
  by_cases h : j = i
  · subst j
    simp
  · simp [lp.single_apply, h]

theorem scalarBaseEigenfunction_norm (i : ScalarBaseEigenIndex g o d) :
    ‖smoothScalarBaseL2 g (scalarBaseEigenfunction g o d i)‖ = 1 := by
  rw [← scalarBaseEigenfunction_L2]
  exact (scalarBaseEigenvector_orthonormal g o d).1 i

end
end PositiveEinsteinFour.Geometry
end


section

/-! The fixed space of the actual scalar shifted resolvent is precisely the
constant functions on the connected manifold. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance scalarFixed_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalarBaseResolvent_fixed_smooth (f : Lp ℝ 2 (normalizedVolume g))
    (hf : scalarBaseResolvent g o d f = f) :
    ∃ F : SmoothScalar (M := M), f = smoothScalarBaseL2 g F ∧ smoothScalarLaplacian g F = 0 := by
  let u := scalarBaseShiftedSolution g o d f
  have hu : scalarH1BaseValue g o d u = f := hf
  have hw (v : scalarH1 d) :
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        (0 : ℝ) * inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v) := by
    have he := scalarBaseShiftedSolution_weak g o d f v
    rw [scalarH1_inner_base, hu] at he
    change inner ℝ f (scalarH1BaseValue g o d v) + _ = _ at he
    simpa only [zero_mul] using (add_left_cancel (a := inner ℝ f
      (scalarH1BaseValue g o d v)) (show inner ℝ f (scalarH1BaseValue g o d v) +
        (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        inner ℝ f (scalarH1BaseValue g o d v) + 0 by simpa only [add_zero] using he))
  obtain ⟨F, hF, hL⟩ := scalar_weak_eigen_smooth g o d u 0 hw
  refine ⟨F, ?_, ?_⟩
  · rw [← hu, hF, scalarH1BaseValue_smooth]
  · simpa only [neg_zero, zero_smul] using hL

theorem scalarBaseResolvent_fixed_one :
    scalarBaseResolvent g o d (smoothScalarBaseL2 g (smoothScalarConst 1)) =
      smoothScalarBaseL2 g (smoothScalarConst 1) := by
  have hu : scalarBaseShiftedSolution g o d (smoothScalarBaseL2 g (smoothScalarConst 1)) =
      scalarH1One d := by
    apply ext_inner_right ℝ
    intro v
    rw [scalarBaseShiftedSolution_weak, scalarH1_inner_base]
    simp only [scalarH1Gradient_one, inner_zero_left, Finset.sum_const_zero, add_zero]
    change inner ℝ (smoothScalarBaseL2 g (smoothScalarConst 1)) (scalarH1BaseValue g o d v) =
      inner ℝ (scalarH1BaseValue g o d (smoothScalarToH1 d (smoothScalarConst 1)))
        (scalarH1BaseValue g o d v)
    rw [scalarH1BaseValue_smooth]
  change scalarH1BaseValue g o d (scalarBaseShiftedSolution g o d _) = _
  rw [hu]
  exact scalarH1BaseValue_smooth g o d (smoothScalarConst 1)

variable [PreconnectedSpace M]

theorem scalarBaseResolvent_fixed_constant (hRic : RicciThree g)
    (f : Lp ℝ 2 (normalizedVolume g)) (hf : scalarBaseResolvent g o d f = f) :
    ∃ c : ℝ, f = c • smoothScalarBaseL2 g (smoothScalarConst 1) := by
  obtain ⟨F, hF, hL⟩ := scalarBaseResolvent_fixed_smooth g o d f hf
  have hLap (e : FrameBundle g) : scalarLaplacian g F e = 0 := by
    rw [scalarLaplacian_eq_base]
    exact congrArg (fun a : SmoothScalar (M := M) => a.val e.base) hL
  obtain ⟨c, hc⟩ := scalarLaplacian_kernel_constants g o hRic F.property hLap
  have hFc : F = c • smoothScalarConst 1 := by
    apply Subtype.ext
    funext x
    change F.val x = c * 1
    simpa only [mul_one] using hc x
  refine ⟨c, ?_⟩
  rw [hF, hFc]
  apply (scalarBasePullback g o).injective
  rw [map_smul, scalarBasePullback_smooth, scalarBasePullback_smooth, map_smul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Rescaling the normalized positive Euler minimizer to the already proved
unit-coefficient rigidity theorem. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {μ : Measure (FrameBundle g)}

theorem smoothScalarHessian_const_smul (d : ParallelMetricData g μ)
    (c : ℝ) (a : SmoothScalar (M := M)) (e : FrameBundle g) (i j : Fin 4) :
    scalarHessian g (c • a).val e i j = c * scalarHessian g a.val e i j := by
  let sa := Classical.choice (d.scalarCalculus.toPetersenInput a.val a.property)
  let sb := Classical.choice (d.scalarCalculus.toPetersenInput (c • a).val (c • a).property)
  obtain ⟨f, hf⟩ := ((d.toMetricGreenData.flow i).map 0).surjective e
  change (d.toMetricGreenData.flow i).map 0 f = e at hf
  have hg (z : FrameBundle g) : scalarGradient g (c • a).val z j =
      c * scalarGradient g a.val z j := by
    change (smoothScalarGradient d j (c • a)) z = _
    rw [map_smul]
    rfl
  have h := sb.derivativeGradient i j 0 f
  have h' := (sa.derivativeGradient i j 0 f).const_mul c
  have heq : (fun t => scalarGradient g (c • a).val ((d.toMetricGreenData.flow i).map t f) j) =
      fun t => c * scalarGradient g a.val ((d.toMetricGreenData.flow i).map t f) j :=
    funext (fun t => hg _)
  rw [heq] at h
  have hu := h.unique h'
  rwa [hf] at hu

theorem smoothScalarLaplacian_const_smul (d : ParallelMetricData g μ)
    (c : ℝ) (a : SmoothScalar (M := M)) (e : FrameBundle g) :
    scalarLaplacian g (c • a).val e = c * scalarLaplacian g a.val e := by
  simp only [scalarLaplacian, smoothScalarHessian_const_smul d, Finset.mul_sum]

variable [T3Space M] [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  [Nonempty M] [PreconnectedSpace M]

local instance scalarEulerScaling_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- Once positive smooth regularity is known, the normalized minimum has
energy one and its representative is the constant one. -/
theorem scalar_positive_normalized_euler_minimum_one (g : SmoothMetric M)
    (o : FrameOrientation g) (hRic : RicciThree g) (a : SmoothScalar (M := M))
    (hpos : ∀ x, 0 < a.val x) {p m : ℝ} (hp : 2 < p) (hp4 : p < 4) (hm : 0 < m)
    (hnorm : (∫ x, a.val x ^ p ∂normalizedVolume g) = 1)
    (hEq : ∀ e : FrameBundle g, -scalarLaplacian g a.val e + 2 * a.val e.base =
      2 * m * a.val e.base ^ (p - 1)) : m = 1 ∧ ∀ x, a.val x = 1 := by
  let c := m ^ (1 / (p - 2))
  have hc : 0 < c := Real.rpow_pos_of_pos hm _
  have hcm : c ^ (p - 2) = m := by
    rw [show c = m ^ (1 / (p - 2)) from rfl, ← Real.rpow_mul hm.le]
    have he : 1 / (p - 2) * (p - 2) = 1 := by
      field_simp [ne_of_gt (sub_pos.mpr hp)]
    rw [he, Real.rpow_one]
  have hcp : c ^ (p - 1) = m * c := by
    calc
      _ = c ^ ((p - 2) + 1) := by congr 1; ring
      _ = c ^ (p - 2) * c := by rw [Real.rpow_add hc, Real.rpow_one]
      _ = m * c := by rw [hcm]
  let d := canonicalParallelMetricData g o hRic
  let b : SmoothScalar (M := M) := c • a
  have hbpos (x : M) : 0 < b.val x := mul_pos hc (hpos x)
  have hbEq (e : FrameBundle g) : -scalarLaplacian g b.val e + 2 * b.val e.base =
      2 * b.val e.base ^ (p - 1) := by
    rw [show b = c • a from rfl, smoothScalarLaplacian_const_smul d]
    change -(c * scalarLaplacian g a.val e) + 2 * (c * a.val e.base) =
      2 * (c * a.val e.base) ^ (p - 1)
    rw [Real.mul_rpow hc.le (hpos e.base).le, hcp]
    linear_combination c * hEq e
  have hbunit := scalar_positive_subcritical_euler g o hRic b.property hbpos p hp hp4 hbEq
  have haconst (x : M) : a.val x = c⁻¹ := by
    have hu := hbunit x
    change c * a.val x = 1 at hu
    apply (mul_left_cancel₀ (ne_of_gt hc))
    rw [hu, mul_inv_cancel₀ (ne_of_gt hc)]
  have hpower : (c⁻¹) ^ p = 1 := by
    simpa only [haconst, integral_const, probReal_univ, one_smul] using hnorm
  have hcunit : c⁻¹ = 1 :=
    (Real.rpow_left_inj (inv_nonneg.mpr hc.le) zero_le_one (by linarith : p ≠ 0)).mp
      (by simpa only [Real.one_rpow] using hpower)
  have hc1 : c = 1 := by simpa only [inv_inv, inv_one] using congrArg Inv.inv hcunit
  refine ⟨?_, fun x => (haconst x).trans hcunit⟩
  simpa only [hc1, Real.one_rpow] using hcm.symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual rational-test energy and the resulting L⁸ gain for the
subcritical minimizing scalar. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal BigOperators

noncomputable section

local instance katoEnergy_four : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

private theorem kato_square_bound {a b c : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hc : 0 ≤ c) (h : a ≤ b * c) : a ^ 2 ≤ (b ^ 2 + 1) * c ^ 2 := by
  calc
    a ^ 2 ≤ (b * c) ^ 2 := (sq_le_sq₀ ha (mul_nonneg hb hc)).2 h
    _ ≤ (b ^ 2 + 1) * c ^ 2 := by
      rw [mul_pow]
      nlinarith [sq_nonneg c]

private theorem kato_real_inner {X : Type*} [MeasurableSpace X]
    {μ : Measure X} (a b : Lp ℝ 2 μ) :
    inner ℝ a b = ∫ x, a x * b x ∂μ := by
  rw [L2.inner_def]
  simp only [RCLike.inner_apply', conj_trivial]

private theorem kato_gradient_le {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {lam : ℝ} (hlam : 0 < lam) (f : X → ℝ)
    (a b c : Lp ℝ 2 μ)
    (hb : b =ᵐ[μ] fun x => scalarKatoTestRate lam (f x) * a x)
    (hc : c =ᵐ[μ] fun x => scalarKatoSquareRate lam (f x) * a x) :
    ‖c‖ ^ 2 ≤ 2 * inner ℝ a b := by
  rw [scalarL2_norm_sq, kato_real_inner, ← integral_const_mul]
  apply integral_mono_ae (Lp.memLp c).integrable_sq
    (((Lp.memLp a).integrable_mul (Lp.memLp b)).const_mul 2)
  filter_upwards [hb, hc] with x hbx hcx
  change c x ^ 2 ≤ 2 * (a x * b x)
  rw [hbx, hcx, mul_pow]
  have h := mul_le_mul_of_nonneg_right (scalarKatoSquareRate_sq_le hlam (f x))
    (sq_nonneg (a x))
  nlinarith only [h]

/-- The subcritical nonlinear potential is in L² because the actual H¹
value is already in L⁴. -/
theorem scalarKato_potential_memLp {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {f : X → ℝ} (hf : MemLp f 4 μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) :
    MemLp (fun x => |f x| ^ (p - 2)) 2 μ := by
  have hs := scalarKato_square_memLp hf
  have hdom : MemLp (fun x => 1 + f x ^ 2) 2 μ :=
    (memLp_const (1 : ℝ)).add hs
  have hc : Continuous (fun s : ℝ => |s| ^ (p - 2)) :=
    continuous_abs.rpow_const (fun _ => Or.inr (by linarith : 0 ≤ p - 2))
  apply hdom.mono' (hc.comp_aestronglyMeasurable hf.aestronglyMeasurable)
  exact Eventually.of_forall fun x => by
    change ‖|f x| ^ (p - 2)‖ ≤ 1 + f x ^ 2
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
    by_cases hx : |f x| ≤ 1
    · exact (Real.rpow_le_one (abs_nonneg _) hx (by linarith)).trans (by nlinarith [sq_nonneg (f x)])
    · have h := Real.rpow_le_rpow_of_exponent_le (le_of_not_ge hx)
        (show p - 2 ≤ 2 by linarith)
      rw [Real.rpow_two, sq_abs] at h
      exact h.trans (by linarith)


variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance katoEnergy_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance katoEnergy_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- The rational square has controlled actual first-jet energy. -/
theorem scalar_minimum_kato_energy (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ z : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) z‖ ^ 2 ≤ ‖z‖ ^ 2)
    {lam : ℝ} (hlam : 0 < lam) :
    ∃ z : scalarH1 d,
      scalarH1BaseValue g o d z =ᵐ[normalizedVolume g]
        (fun x => scalarKatoSquare lam
          (scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w) x)) ∧
      ‖z‖ ^ 2 ≤
        (∫ x, scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w) x ^ 4 ∂normalizedVolume g) +
        4 * ∫ x, |scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w) x| ^ (p - 2) *
          scalarKatoSquare lam (scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w) x) ^ 2
          ∂normalizedVolume g := by
  let u := scalarWeightedH1ToH1 d w
  let f := scalarH1BaseValue g o d u
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  obtain ⟨v, hv, hvg, he⟩ := scalar_minimum_kato_test g o d hp hp4 w hw hmin hlam
  obtain ⟨z, hz, hzg⟩ := scalarH1_katoSquare_base_exists g o d hlam u
  refine ⟨z, hz, ?_⟩
  have hT : (T w : M → ℝ) =ᵐ[normalizedVolume g] f :=
    scalarWeightedBaseLp_coe g o d _ _ w
  let R := ∫ x, |f x| ^ (p - 2) * scalarKatoSquare lam (f x) ^ 2 ∂normalizedVolume g
  have hR : 0 ≤ R := integral_nonneg fun x => mul_nonneg
    (Real.rpow_nonneg (abs_nonneg _) _) (sq_nonneg _)
  have he' : inner ℝ w (scalarWeightedH1Equiv d v) = ‖w‖ ^ 2 * R := by
    rw [he]
    congr 1
    apply integral_congr_ae
    filter_upwards [hT] with x hx
    rw [hx, mul_assoc, scalarKato_test_square hlam]
  have hinner : inner ℝ (scalarH1Value d u) (scalarH1Value d v) ≥ 0 := by
    rw [← scalarH1BaseValue_spec g o d u, ← scalarH1BaseValue_spec g o d v,
      (scalarBasePullback g o).inner_map_map, kato_real_inner]
    apply integral_nonneg_of_ae
    filter_upwards [hv] with x hx
    rw [hx, scalarKato_test_square hlam]
    exact sq_nonneg _
  have hwback : scalarWeightedH1Equiv d u = w :=
    (scalarWeightedH1Equiv d).apply_symm_apply w
  have hei : inner ℝ w (scalarWeightedH1Equiv d v) =
      inner ℝ (scalarH1Value d u) (scalarH1Value d v) + (1 / 2 : ℝ) *
        ∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v) := by
    conv_lhs => rw [← hwback]
    exact scalarWeightedH1_inner d u v
  rw [hei] at he'
  have hgrad : (∑ i : Fin 4, ‖scalarH1Gradient d i z‖ ^ 2) ≤
      2 * ∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v) := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun i _ => kato_gradient_le hlam (scalarH1Value d u)
      (scalarH1Gradient d i u) (scalarH1Gradient d i v) (scalarH1Gradient d i z)
      (hvg i) (hzg i)
  have hg : (∑ i : Fin 4, ‖scalarH1Gradient d i z‖ ^ 2) ≤ 4 * R := by
    have hmR := mul_le_mul_of_nonneg_right hm hR
    nlinarith
  have hf4 : MemLp (fun x => f x) 4 (normalizedVolume g) :=
    (memLp_congr_ae (scalarH1BaseL4_coe g o d u)).mp (Lp.memLp (scalarH1BaseL4 g o d u))
  have hval : ‖scalarH1Value d z‖ ^ 2 ≤ ∫ x, f x ^ 4 ∂normalizedVolume g := by
    rw [← scalarH1BaseValue_spec g o d z, (scalarBasePullback g o).norm_map, scalarL2_norm_sq]
    have hi4 : Integrable (fun x => f x ^ 4) (normalizedVolume g) := by
      have h := hf4.integrable_norm_pow (by decide : (4 : ℕ) ≠ 0)
      have hh : (fun x => ‖f x‖ ^ 4) = (fun x => f x ^ 4) := by
        funext x
        rw [Real.norm_eq_abs, ← abs_pow, abs_of_nonneg (show 0 ≤ f x ^ 4 by positivity)]
      rwa [hh] at h
    apply integral_mono_ae (Lp.memLp (scalarH1BaseValue g o d z)).integrable_sq hi4
    filter_upwards [hz] with x hx
    rw [hx]
    exact scalarKatoSquare_sq_le hlam (f x)
  rw [scalarH1_norm_sq]
  change ‖scalarH1Value d z‖ ^ 2 + (∑ i : Fin 4, ‖scalarH1Gradient d i z‖ ^ 2) ≤
    (∫ x, f x ^ 4 ∂normalizedVolume g) + 4 * R
  exact add_le_add hval hg

/-- The actual normalized homogeneous minimum has an L⁸ base value. -/
theorem scalar_minimum_memLp_eight (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ z : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) z‖ ^ 2 ≤ ‖z‖ ^ 2) :
    MemLp (scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w)) 8 (normalizedVolume g) := by
  let u := scalarWeightedH1ToH1 d w
  let f := scalarH1BaseValue g o d u
  let E := scalarH1BaseL4 g o d
  have hf : MemLp (fun x => f x) 4 (normalizedVolume g) :=
    (memLp_congr_ae (scalarH1BaseL4_coe g o d u)).mp (Lp.memLp (E u))
  let C := ‖E‖ ^ 2 + 1
  apply scalarKato_memLp_eight_of_energy hf (scalarKato_potential_memLp hf hp hp4)
    (C := C) (by dsimp [C]; positivity)
  · intro lam hlam
    obtain ⟨z, hz, _⟩ := scalar_minimum_kato_energy g o d hp hp4 w hw hm hmin hlam
    exact (memLp_congr_ae ((scalarH1BaseL4_coe g o d z).trans hz)).mp (Lp.memLp (E z))
  · intro lam hlam
    obtain ⟨z, hz, henergy⟩ := scalar_minimum_kato_energy g o d hp hp4 w hw hm hmin hlam
    have he : (E z : M → ℝ) =ᵐ[normalizedVolume g]
        fun x => scalarKatoSquare lam (f x) := (scalarH1BaseL4_coe g o d z).trans hz
    have hmoment : Real.sqrt (∫ x, scalarKatoSquare lam (f x) ^ 4 ∂normalizedVolume g) = ‖E z‖ ^ 2 := by
      rw [scalarLp_four_norm_sq]
      congr 1
      exact (integral_congr_ae (he.fun_comp fun r : ℝ => r ^ 4)).symm
    rw [hmoment]
    have hnorm := E.le_opNorm z
    have hsq : ‖E z‖ ^ 2 ≤ C * ‖z‖ ^ 2 :=
      kato_square_bound (norm_nonneg (E z)) (norm_nonneg E) (norm_nonneg z) hnorm
    exact hsq.trans (mul_le_mul_of_nonneg_left henergy (by dsimp [C]; positivity))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Higher integer regularity of the positive power needed by the Euler
source. The range condition is only on the support of the localization. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped SchwartzMap ENNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (f : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} f

/-- A positive bounded local power loses at most one of the available
integer Sobolev derivatives. Combined with the two-derivative elliptic gain,
this is the required ascending bootstrap. -/
theorem scalar_localized_integer_positive_power (n : ℕ) (hn : 2 ≤ n) :
    ∀ (u : L2) (χ : S), HasCompactSupport (χ : V → ℝ) →
      ∀ (a B q : ℝ), 0 < a → 0 ≤ B →
      MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 u : T) →
      (∀ᵐ x ∂(volume : Measure V), x ∈ tsupport (χ : V → ℝ) → u x ∈ Icc a B) →
      ∃ v : L2, MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) ∧
        (v : V → ℝ) =ᵐ[volume] fun x => χ x * (u x) ^ q := by
  induction n, hn using Nat.le_induction with
  | base =>
    intro u χ hc a B q ha hB hu hrange
    apply scalar_localized_H2_positive_power u (hu.mono (by norm_num)) χ hc a B q ha hB
    filter_upwards [hrange] with x hx hχ
    exact hx (subset_tsupport (χ : V → ℝ) hχ)
  | succ n hn ih =>
    intro u χ hc a B q ha hB hu hrange
    have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn
    have huLow : MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 u : T) :=
      hu.mono (by push_cast; linarith)
    have hu2 : MemSobolev 2 2 (scalarComplexL2 u : T) :=
      huLow.mono (by linarith)
    have hderiv (i : Fin 4) := scalar_real_derivative_sobolev (n + 1) u hu i
    choose Du hDu hDuN using hderiv
    obtain ⟨v, _, hve, hDv⟩ := scalar_localized_positive_power_weak_derivative u hu2 Du hDu
      χ hc a B q ha hB hrange
    obtain ⟨w, hw, hwe⟩ := ih u χ hc a B q ha hB huLow hrange
    have hvw : v = w := Lp.ext (hve.trans hwe.symm)
    have hvN : MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) := by rwa [hvw]
    refine ⟨v, ?_, hve⟩
    have hvSucc : MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 v : T) := by
      apply (scalar_memSobolev_succ_iff (n : ℝ) _).mpr
      refine ⟨hvN, fun i => ?_⟩
      have hs : tsupport ((D i χ : S) : V → ℝ) ⊆ tsupport (χ : V → ℝ) :=
        SchwartzMap.tsupport_lineDerivOp_subset (EuclideanSpace.basisFun (Fin 4) ℝ i) χ
      have hcD : HasCompactSupport ((D i χ : S) : V → ℝ) :=
        hc.of_isClosed_subset (isClosed_tsupport _) hs
      have hrD : ∀ᵐ x ∂(volume : Measure V),
          x ∈ tsupport ((D i χ : S) : V → ℝ) → u x ∈ Icc a B := by
        filter_upwards [hrange] with x hx hxs
        exact hx (hs hxs)
      obtain ⟨A, hA, hAe⟩ := ih u (D i χ) hcD a B q ha hB huLow hrD
      obtain ⟨P, hP, hPe⟩ := ih u χ hc a B (q - 1) ha hB huLow hrange
      obtain ⟨C, hC, hCe⟩ := scalar_real_integer_product_extra n hn P (Du i) hP
        (by simpa only [Nat.cast_add, Nat.cast_one] using hDuN i)
      obtain ⟨z, hz, hze⟩ := hDv i
      have he : z = A + q • C := by
        apply Lp.ext
        filter_upwards [hze, hAe, hPe, hCe, Lp.coeFn_add A (q • C), Lp.coeFn_smul q C]
          with x hz hA hP hC hadd hsmul
        rw [hz, hadd, Pi.add_apply, hsmul, Pi.smul_apply, smul_eq_mul, hA, hC, hP]
        ring
      rw [hz, he]
      exact scalar_real_sobolev_add (n : ℝ) A (q • C) hA
        (scalar_real_sobolev_smul (n : ℝ) q C hC)
    simpa only [Nat.cast_add, Nat.cast_one] using hvSucc

end
end PositiveEinsteinFour.Geometry
end


section

/-! The concrete shifted scalar resolvent supplies the local elliptic chain.
No regularity of its L2 input is assumed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance resolventChain_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarBaseResolventJet (n : ℕ) (f : Lp ℝ 2 (normalizedVolume g)) : scalarH1 d :=
  scalarBaseShiftedSolution g o d ((scalarBaseResolvent g o d ^ n) f)

theorem scalarBaseResolventJet_value (n : ℕ) (f : Lp ℝ 2 (normalizedVolume g)) :
    scalarH1BaseValue g o d (scalarBaseResolventJet g o d n f) =
      (scalarBaseResolvent g o d ^ (n + 1)) f := by
  rw [pow_succ']
  rfl

theorem scalarBaseResolventJet_weak (k : ℕ) (f : Lp ℝ 2 (normalizedVolume g)) (v : scalarH1 d) :
    (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (scalarBaseResolventJet g o d (k + 1) f))
      (scalarH1Gradient d i v)) =
      inner ℝ (scalarH1BaseValue g o d (scalarBaseResolventJet g o d k f) -
        scalarH1BaseValue g o d (scalarBaseResolventJet g o d (k + 1) f))
          (scalarH1BaseValue g o d v) := by
  have he := scalarBaseShiftedSolution_weak g o d ((scalarBaseResolvent g o d ^ (k + 1)) f) v
  change inner ℝ (scalarBaseResolventJet g o d (k + 1) f) v = _ at he
  rw [scalarH1_inner_base, ← scalarBaseResolventJet_value] at he
  rw [inner_sub_left]
  linarith only [he]

theorem scalarBaseResolvent_local_orders (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : FourSpace) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∀ f : Lp ℝ 2 (normalizedVolume g), ∃ w : ℕ → Lp ℝ 2 (volume : Measure FourSpace),
        (∀ k, (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          ((scalarBaseResolvent g o d ^ (k + 1)) f)
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : FourSpace) 1)] w k) ∧
        ∀ (n : ℕ) (φ : 𝓢(FourSpace, ℂ)), HasCompactSupport (φ : FourSpace → ℂ) →
          tsupport (φ : FourSpace → ℂ) ⊆ ball 0 (1 / 2) →
          MemSobolev ((2 * n + 1 : ℕ) : ℝ) 2
            (smulLeftCLM ℂ φ (scalarComplexL2 (w n) : 𝓢'(FourSpace, ℂ))) := by
  obtain ⟨r, hr, ht, hchain⟩ := scalar_resolvent_chain_local g o d c z₀
  refine ⟨r, hr, ht, ?_⟩
  intro f
  obtain ⟨w, hw, hreg⟩ := hchain (fun n => scalarBaseResolventJet g o d n f)
    (fun k v => scalarBaseResolventJet_weak g o d k f v)
  refine ⟨w, ?_, hreg⟩
  intro k
  simpa only [scalarBaseResolventJet_value] using hw k

end
end PositiveEinsteinFour.Geometry
end


section

/-! Once the nonlinear source belongs to L2, the proved smooth-test Euler
equation extends to every actual H1 test by density. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance scalarWeakEulerL2_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarWeakEulerL2_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_minimum_euler_all_H1_of_L2_source
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (F : Lp ℝ 2 (normalizedVolume g))
    (hF : F =ᵐ[normalizedVolume g] fun x =>
      |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^ (p - 2) *
        scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x)
    (v : scalarWeightedH1 d) :
    inner ℝ w v = ‖w‖ ^ 2 * inner ℝ (scalarBasePullback g o F)
      (scalarH1Value d (scalarWeightedH1ToH1 d v)) := by
  refine (smoothScalarToWeightedH1_dense d).induction_on
    (p := fun v => inner ℝ w v = ‖w‖ ^ 2 * inner ℝ (scalarBasePullback g o F)
      (scalarH1Value d (scalarWeightedH1ToH1 d v))) v ?_ ?_
  · exact isClosed_eq (continuous_const.inner continuous_id)
      (continuous_const.mul (continuous_const.inner
        ((scalarH1Value d).continuous.comp (scalarWeightedH1ToH1 d).continuous)))
  · intro a
    rw [scalarWeightedH1ToH1_smooth, scalarH1Value_smooth]
    rw [← scalarBasePullback_smooth g o a, (scalarBasePullback g o).inner_map_map,
      smoothScalarBaseL2_inner_right]
    rw [scalar_subcritical_minimum_weak_euler g o d hp hp4 w hw hmin a]
    congr 1
    apply integral_congr_ae
    filter_upwards [hF] with x hx
    rw [hx]

theorem scalar_weighted_euler_to_weak_poisson
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (w : scalarWeightedH1 d) (Z : ScalarL2 g (canonicalFrameMeasure g o)) (m : ℝ)
    (hweak : ∀ v : scalarWeightedH1 d, inner ℝ w v = m * inner ℝ Z
      (scalarH1Value d (scalarWeightedH1ToH1 d v))) (v : scalarH1 d) :
    (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (scalarWeightedH1ToH1 d w))
      (scalarH1Gradient d i v)) =
      -(inner ℝ ((2 : ℝ) • scalarH1Value d (scalarWeightedH1ToH1 d w) - (2 * m) • Z)
        (scalarH1Value d v)) := by
  have h := hweak (scalarWeightedH1Equiv d v)
  rw [scalarWeightedH1ToH1_equiv] at h
  have hw : w = scalarWeightedH1Equiv d (scalarWeightedH1ToH1 d w) :=
    ((scalarWeightedH1Equiv d).apply_symm_apply w).symm
  conv_lhs at h => rw [hw, scalarWeightedH1_inner]
  rw [inner_sub_left, real_inner_smul_left, real_inner_smul_left]
  linarith

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth compact coefficients for the actual Weitzenböck potential in
an orthonormal chart. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Matrix
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

def twoFormChartPotential (c : M) (S : Mat4) (z : FourSpace) : TwoFormFour →L[ℝ] TwoFormFour :=
  (2 : ℝ) • twoFormCurvatureOperator (frameTensor (chartGramMatrix g c S z)
    (curvatureCoordinates g c z)) - (5 : ℝ) • ContinuousLinearMap.id ℝ TwoFormFour

theorem twoFormChartPotential_contDiffAt (c : M) (S : Mat4) (z : FourSpace)
    (hz : z ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (twoFormChartPotential (g := g) c S) z :=
  ((twoFormCurvatureOperator.contDiff.contDiffAt.comp z
    (chartMetricCurvature_contDiffAt c S z hz)).const_smul (2 : ℝ)).sub contDiffAt_const

def twoFormPotentialCoefficient (c : M) (S : Mat4) (η : FourSpace → ℝ) (r : Fin 6)
    (z : FourSpace) : TwoFormFour :=
  η z • WithLp.toLp 2 (fun k : Fin 6 =>
    twoFormChartPotential (g := g) c S z (EuclideanSpace.basisFun (Fin 6) ℝ k) r)

theorem twoFormPotentialCoefficient_smooth (c : M) (S : Mat4)
    (η : FourSpace → ℝ) (hη : ContDiff ℝ ∞ η)
    (hs : tsupport η ⊆ (chartAt FourSpace c).target) (r : Fin 6) :
    ContDiff ℝ ∞ (twoFormPotentialCoefficient (g := g) c S η r) := by
  apply (contDiff_piLp (p := 2)).mpr
  intro k
  apply scalarCutoff_contDiff η _ hη
  intro z hz
  exact (PiLp.proj 2 (fun _ : Fin 6 => ℝ) r).contDiff.contDiffAt.comp z
    ((twoFormChartPotential_contDiffAt c S z (hs hz)).clm_apply contDiffAt_const)

theorem twoFormPotentialCoefficient_compact (c : M) (S : Mat4)
    (η : FourSpace → ℝ) (hc : HasCompactSupport η) (r : Fin 6) :
    HasCompactSupport (twoFormPotentialCoefficient (g := g) c S η r) := hc.smul_right

theorem twoForm_linear_coordinate (L : TwoFormFour →L[ℝ] TwoFormFour)
    (a : TwoFormFour) (r : Fin 6) :
    L a r = ∑ k : Fin 6, a k * L (EuclideanSpace.basisFun (Fin 6) ℝ k) r := by
  have h := congrArg (fun x : TwoFormFour => L x r) (twoForm_sum_components a)
  simp only [map_sum, map_smul] at h
  exact h.symm

theorem twoFormPotentialCoefficient_pair (c : M) (S : Mat4)
    (η : FourSpace → ℝ) (r : Fin 6) (a : TwoFormFour) (z : FourSpace) :
    inner ℝ a (twoFormPotentialCoefficient (g := g) c S η r z) =
      η z * twoFormChartPotential (g := g) c S z a r := by
  rw [twoForm_linear_coordinate]
  simp only [twoFormPotentialCoefficient, inner_smul_right, PiLp.inner_apply,
    RCLike.inner_apply', conj_trivial]

end
end PositiveEinsteinFour.Geometry
end


section

/-! A smooth compact coefficient paired with an H1 two-form is H1.
This supplies L2 derivatives of the lower-order connection terms. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped BigOperators SchwartzMap ENNReal ContDiff

noncomputable section

variable (b : FourSpace → TwoFormFour) (hb : ContDiff ℝ ∞ b) (hc : HasCompactSupport b)

def twoFormCoefficientSchwartz (r : Fin 6) : 𝓢(FourSpace, ℂ) :=
  let L : TwoFormFour →L[ℝ] ℂ := Complex.ofRealCLM.comp (PiLp.proj 2 (fun _ : Fin 6 => ℝ) r)
  (hc.comp_left (g := L) (map_zero L)).toSchwartzMap (L.contDiff.comp hb)

theorem twoFormCoefficientSchwartz_apply (r : Fin 6) (z : FourSpace) :
    twoFormCoefficientSchwartz b hb hc r z = (b z r : ℂ) := rfl

theorem twoFormCoefficientPair_complex (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    scalarComplexL2 (twoFormCoefficientPairL2 b hb.continuous hc f) =
      ∑ r : Fin 6, scalarL2Multiply ((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume)
        (scalarComplexL2 (twoFormVectorComponentL2 r f)) := by
  let P : Fin 6 → Lp ℂ 2 (volume : Measure FourSpace) := fun r => scalarL2Multiply ((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume)
    (scalarComplexL2 (twoFormVectorComponentL2 r f))
  have hp : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ r : Fin 6,
      P r z = (b z r : ℂ) * (f z r : ℂ) := by
    apply Filter.eventually_all.mpr
    intro r
    filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) ((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume)
        (scalarComplexL2 (twoFormVectorComponentL2 r f)),
      (twoFormCoefficientSchwartz b hb hc r).coeFn_toLp (∞ : ℝ≥0∞) volume,
      scalarComplexL2_coe (twoFormVectorComponentL2 r f), twoFormVectorComponentL2_coe r f]
        with z hmul hcoef hreal hcomp
    change (((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume) •
      scalarComplexL2 (twoFormVectorComponentL2 r f)) z = _
    rw [hmul]
    change ((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume) z *
      scalarComplexL2 (twoFormVectorComponentL2 r f) z = _
    rw [hcoef, hreal, hcomp]
    rfl
  apply Lp.ext
  filter_upwards [scalarComplexL2_coe (twoFormCoefficientPairL2 b hb.continuous hc f),
    twoFormCoefficientPair_coe b hb.continuous hc f, Lp.coeFn_finsetSum Finset.univ P, hp]
    with z hreal hpair hsum hpz
  rw [hreal]
  change (twoFormCoefficientPair b hb.continuous hc f z : ℂ) = _
  rw [hpair, hsum]
  change (inner ℝ (f z) (b z) : ℂ) = ∑ r : Fin 6, P r z
  simp_rw [hpz]
  simp only [PiLp.inner_apply, RCLike.inner_apply', conj_trivial]
  change Complex.ofRealHom (∑ r : Fin 6, f z r * b z r) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro r _
  change (↑(f z r * b z r) : ℂ) = ↑(b z r) * ↑(f z r)
  rw [Complex.ofReal_mul, mul_comm]

theorem twoFormCoefficientPair_distribution (f : Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    (scalarComplexL2 (twoFormCoefficientPairL2 b hb.continuous hc f) : 𝓢'(FourSpace, ℂ)) =
      ∑ r : Fin 6, smulLeftCLM ℂ (twoFormCoefficientSchwartz b hb hc r)
        (scalarComplexL2 (twoFormVectorComponentL2 r f) : 𝓢'(FourSpace, ℂ)) := by
  rw [twoFormCoefficientPair_complex b hb hc f]
  change (Lp.toTemperedDistributionCLM ℂ volume 2) (∑ r : Fin 6,
    scalarL2Multiply ((twoFormCoefficientSchwartz b hb hc r).toLp (∞ : ℝ≥0∞) volume)
      (scalarComplexL2 (twoFormVectorComponentL2 r f))) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro r _
  exact scalarL2Multiply_distribution _ (twoFormCoefficientSchwartz b hb hc r).hasTemperateGrowth
    ((twoFormCoefficientSchwartz b hb hc r).memLp (∞ : ℝ≥0∞) volume) _

theorem twoFormCoefficientPair_memSobolev_one (f : Lp TwoFormFour 2 (volume : Measure FourSpace))
    (hf : ∀ r : Fin 6, MemSobolev 1 2
      (scalarComplexL2 (twoFormVectorComponentL2 r f) : 𝓢'(FourSpace, ℂ))) :
    MemSobolev 1 2 (scalarComplexL2 (twoFormCoefficientPairL2 b hb.continuous hc f) :
      𝓢'(FourSpace, ℂ)) := by
  rw [twoFormCoefficientPair_distribution]
  have hs (s : Finset (Fin 6)) : MemSobolev 1 2 (∑ r ∈ s,
      smulLeftCLM ℂ (twoFormCoefficientSchwartz b hb hc r)
        (scalarComplexL2 (twoFormVectorComponentL2 r f) : 𝓢'(FourSpace, ℂ))) := by
    induction s using Finset.induction_on with
    | empty => simpa only [Finset.sum_empty] using memSobolev_fun_zero FourSpace ℂ 1 2
    | @insert r s hr ih =>
      rw [Finset.sum_insert hr]
      have hfr : MemSobolev ((1 : ℕ) : ℝ) 2
          (scalarComplexL2 (twoFormVectorComponentL2 r f) : 𝓢'(FourSpace, ℂ)) := by
        simpa only [Nat.cast_one] using hf r
      have hm := scalar_memSobolev_schwartz_multiplier 1 (twoFormCoefficientSchwartz b hb hc r)
        (scalarComplexL2 (twoFormVectorComponentL2 r f) : 𝓢'(FourSpace, ℂ)) hfr
      have hm' := hm.add (by simpa only [Nat.cast_one] using ih)
      simpa only [Nat.cast_one] using hm'
  exact hs Finset.univ

end
end PositiveEinsteinFour.Geometry
end


section

/-! Duality between scalar L2 coefficient pairing and compact vector
tests. These identities keep the actual pointwise test functions. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set

noncomputable section

def twoFormWeightedTestL2 (b : FourSpace → TwoFormFour) (hb : Continuous b)
    (hc : HasCompactSupport b) (ψ : FourSpace → ℝ) (hψ : Continuous ψ) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  ((hψ.smul hb).memLp_of_hasCompactSupport hc.smul_left).toLp (fun z => ψ z • b z)

theorem twoFormWeightedTestL2_coe (b : FourSpace → TwoFormFour) (hb : Continuous b)
    (hc : HasCompactSupport b) (ψ : FourSpace → ℝ) (hψ : Continuous ψ) :
    twoFormWeightedTestL2 b hb hc ψ hψ =ᵐ[volume] fun z => ψ z • b z :=
  MemLp.coeFn_toLp _

theorem twoFormCoefficientPair_test (b : FourSpace → TwoFormFour) (hb : Continuous b)
    (hc : HasCompactSupport b) (f : Lp TwoFormFour 2 (volume : Measure FourSpace))
    (ψ : FourSpace → ℝ) (hψ : Continuous ψ) (hcψ : HasCompactSupport ψ) :
    inner ℝ (twoFormCoefficientPairL2 b hb hc f)
      ((hψ.memLp_of_hasCompactSupport hcψ).toLp ψ) =
      inner ℝ f (twoFormWeightedTestL2 b hb hc ψ hψ) := by
  rw [L2.inner_def, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [twoFormCoefficientPair_coe b hb hc f,
    (hψ.memLp_of_hasCompactSupport hcψ).coeFn_toLp,
    twoFormWeightedTestL2_coe b hb hc ψ hψ] with z hbz hψz htz
  change inner ℝ (twoFormCoefficientPair b hb hc f z) _ = _
  rw [hbz, hψz, htz, real_inner_smul_right]
  simp only [RCLike.inner_apply', conj_trivial]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Concrete smooth coefficients for the scalar component divergence
equations of a two-form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Matrix Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

def twoFormMassCoefficient (c : M) (χ : FourSpace → ℝ) (b : TwoFormFour) (z : FourSpace) : TwoFormFour :=
  (χ z * chartVolumeDensity g c z) • b

def twoFormFluxCoefficient (c : M) (χ : FourSpace → ℝ) (b : TwoFormFour)
    (i j : Fin 4) (z : FourSpace) : TwoFormFour :=
  (χ z * (chartVolumeDensity g c z * (metricInChart g c z)⁻¹ i j)) • b

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) (χ : FourSpace → ℝ)
  (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ (chartAt FourSpace c).target) (b : TwoFormFour)

include hχ hs

theorem twoFormMassCoefficient_smooth : ContDiff ℝ ∞ (twoFormMassCoefficient (g := g) c χ b) :=
  (scalarCutoff_contDiff χ (chartVolumeDensity g c) hχ
    (fun z hz => chartVolumeDensity_contDiffAt g c z (hs hz))).smul contDiff_const

theorem twoFormFluxCoefficient_smooth (i j : Fin 4) :
    ContDiff ℝ ∞ (twoFormFluxCoefficient (g := g) c χ b i j) :=
  (scalarCutoff_contDiff χ _ hχ (fun z hz =>
    (chartVolumeDensity_contDiffAt g c z (hs hz)).mul
      (scalarPrincipalCoefficients_smooth g c z (hs hz) i j))).smul contDiff_const

def twoFormMassPair :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormCoefficientPairL2 (twoFormMassCoefficient (g := g) c χ b)
    (twoFormMassCoefficient_smooth (g := g) c χ hχ hs b).continuous hc.mul_right.smul_right

def twoFormFluxPair (i j : Fin 4) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormCoefficientPairL2 (twoFormFluxCoefficient (g := g) c χ b i j)
    (twoFormFluxCoefficient_smooth (g := g) c χ hχ hs b i j).continuous hc.mul_right.smul_right

def twoFormConnectionPair (i : Fin 4) :
    Lp TwoFormFour 2 (volume : Measure FourSpace) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormCoefficientPairL2 (fun z => χ z • twoFormWeightedConnection (g := g) c S b i z)
    (twoFormCutoffWeightedConnection_smooth c S hS b i χ hχ hs).continuous hc.smul_right

def twoFormDivergenceFlux (N : Fin 4 → Lp TwoFormFour 2 (volume : Measure FourSpace)) (j : Fin 4) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  ∑ i : Fin 4, twoFormFluxPair (g := g) c χ hχ hc hs b i j (N i)

def twoFormDivergenceSource (V F : Lp TwoFormFour 2 (volume : Measure FourSpace))
    (N : Fin 4 → Lp TwoFormFour 2 (volume : Measure FourSpace)) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  twoFormMassPair (g := g) c χ hχ hc hs b (F - V) -
    ∑ i : Fin 4, twoFormConnectionPair (g := g) c S hS χ hχ hc hs b i (N i)

end
end PositiveEinsteinFour.Geometry
end


section

/-! A finite family of compact coordinate maps controls the global
two-form L2 value map. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormValueNormL2_partition (P : ScalarPartition M) (u : smoothTwoForms o) :
    ‖twoFormValueNormL2 u‖ ≤ ∑ i : P.ι,
      ‖twoFormValueNormL2 (smoothTwoFormProduct (scalarPartitionFunction P i) u)‖ := by
  let R := fun i : P.ι => twoFormValueNormL2 (smoothTwoFormProduct (scalarPartitionFunction P i) u)
  have hall : ∀ᵐ x ∂normalizedVolume g, ∀ i : P.ι,
      R i x = ‖(smoothTwoFormProduct (scalarPartitionFunction P i) u).val x‖ := by
    apply Filter.eventually_all.mpr
    intro i
    exact twoFormValueNormL2_coe (smoothTwoFormProduct (scalarPartitionFunction P i) u)
  have hpoint (x : M) : ‖u.val x‖ ≤ ∑ i : P.ι,
      ‖(smoothTwoFormProduct (scalarPartitionFunction P i) u).val x‖ := by
    have he := congrArg (fun w : smoothTwoForms o => w.val x) (smoothTwoForm_partition P u)
    simp only [Submodule.coe_sum, Finset.sum_apply] at he
    rw [← he]
    exact norm_sum_le _ _
  have hdom : ‖twoFormValueNormL2 u‖ ≤ ‖∑ i : P.ι, R i‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [hall, Lp.coeFn_finsetSum Finset.univ R,
      twoFormValueNormL2_coe u]
        with x hx hsum hval
    rw [hval, hsum]
    simp only [Finset.sum_apply, Real.norm_eq_abs]
    simp_rw [hx]
    rw [abs_of_nonneg (norm_nonneg _), abs_of_nonneg (Finset.sum_nonneg (fun _ _ => norm_nonneg _))]
    exact hpoint x
  exact hdom.trans (norm_sum_le _ _)

theorem twoFormValueNormL2_eq_H1value_norm (u : SmoothH1TwoForm o) :
    ‖twoFormValueNormL2 (u : smoothTwoForms o)‖ =
      ‖twoFormH1ToL2 (smoothTwoFormToH1 u)‖ := by
  rw [twoFormH1ToL2_smooth, smoothTwoFormToL2.norm_map]
  apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
  have h := twoFormValueNormL2_norm_sq (u : smoothTwoForms o)
  have hi : ‖smoothH1ToL2 u‖ ^ 2 = smoothTwoFormL2Inner (u : smoothTwoForms o) u := by
    rw [← real_inner_self_eq_norm_sq]
    rfl
  exact h.trans hi.symm

theorem twoFormH1_partition_bound (P : ScalarPartition M) :
    ∃ C : P.ι → ℝ, (∀ i, 0 ≤ C i) ∧ ∀ u : TwoFormH1 o,
      ‖twoFormH1ToL2 u‖ ≤ ∑ i : P.ι, C i * ∑ a : Fin 2 → Fin 4,
        ‖twoFormReconstructedValue (P.center i) (scalarPartitionFunction P i)
          (scalarPartitionFunction_support P i) a u‖ := by
  choose C hC hb using (fun i : P.ι => twoForm_product_local_norm (o := o)
    (P.center i) (scalarPartitionFunction P i) (scalarPartitionFunction_support P i))
  refine ⟨C, hC, fun u => ?_⟩
  refine UniformSpace.Completion.induction_on u
    (isClosed_le (continuous_norm.comp twoFormH1ToL2.continuous)
      (continuous_finsetSum _ (fun i _ => continuous_const.mul
        (continuous_finsetSum _ (fun a _ => continuous_norm.comp
          (twoFormReconstructedValue (P.center i) (scalarPartitionFunction P i)
            (scalarPartitionFunction_support P i) a).continuous))))) ?_
  intro v
  change ‖twoFormH1ToL2 (smoothTwoFormToH1 v)‖ ≤ _
  rw [← twoFormValueNormL2_eq_H1value_norm]
  exact (twoFormValueNormL2_partition P (v : smoothTwoForms o)).trans
    (Finset.sum_le_sum (fun i _ => hb i v))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar heat coefficients are actual integrals. Their finite
regularity and transport equations follow from the radial integral solver. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

def fourHeatCoefficient (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (c U : FourSpace → ℝ) : ℕ → FourSpace → ℝ
  | 0 => U
  | m + 1 => fourHeatWeightedRadialAverage m U
      (fun x => -fourHeatLocalOperator (a x) (b x) (c x) (fourHeatCoefficient a b c U m) x)

theorem fourHeatCoefficient_contDiff (m : ℕ) : ∀ (n : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ) (c U : FourSpace → ℝ),
    (∀ i j, ContDiff ℝ (n + 3 * m : ℕ) (fun x => a x i j)) →
    (∀ i, ContDiff ℝ (n + 3 * m : ℕ) (fun x => b x i)) →
    ContDiff ℝ (n + 3 * m : ℕ) c → ContDiff ℝ (n + 3 * m : ℕ) U →
    (∀ x, U x ≠ 0) → ContDiff ℝ n (fourHeatCoefficient a b c U m) := by
  induction m with
  | zero =>
    intro n a b c U ha hb hc hU hU0
    simpa only [fourHeatCoefficient, mul_zero, add_zero] using hU
  | succ m ih =>
    intro n a b c U ha hb hc hU hU0
    have he : n + 3 * (m + 1) = (n + 3) + 3 * m := by omega
    have hreg : ContDiff ℝ (n + 3 : ℕ) (fourHeatCoefficient a b c U m) :=
      ih (n + 3) a b c U (fun i j => he ▸ ha i j) (fun i => he ▸ hb i)
        (he ▸ hc) (he ▸ hU) hU0
    have hle : ((n + 1 : ℕ) : ℕ∞ω) ≤ (n + 3 * (m + 1) : ℕ) := by
      exact_mod_cast (show n + 1 ≤ n + 3 * (m + 1) by omega)
    apply fourHeatWeightedRadialAverage_contDiff n m U _ (hU.of_le hle) _ hU0
    apply ContDiff.neg
    apply fourHeatLocalOperator_contDiff (n + 1) a b c _
      (fun i j => (ha i j).of_le hle) (fun i => (hb i).of_le hle) (hc.of_le hle)
    simpa only [Nat.add_assoc] using hreg

theorem fourHeatCoefficient_transport (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ) (c U : FourSpace → ℝ)
    (x : FourSpace) (hU : ContDiff ℝ 1 U) (hU0 : ∀ y, U y ≠ 0)
    (ha : ∀ i j, ContDiff ℝ 1 (fun y => a y i j))
    (hb : ∀ i, ContDiff ℝ 1 (fun y => b y i)) (hc : ContDiff ℝ 1 c)
    (hm : ContDiff ℝ 3 (fourHeatCoefficient a b c U m))
    (hrow : ∀ i, ∑ j : Fin 4, a x i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a x i j * x i = x j)
    (hTU : fourHeatRadialTransport (a x) (b x) U x = 0) :
    fourHeatRadialTransport (a x) (b x) (fourHeatCoefficient a b c U (m + 1)) x +
      (m + 1 : ℝ) * fourHeatCoefficient a b c U (m + 1) x =
        -fourHeatLocalOperator (a x) (b x) (c x) (fourHeatCoefficient a b c U m) x := by
  apply fourHeatWeightedRadialAverage_transport m (a x) (b x) U _ x hU _ hU0
    hrow hcol hTU
  exact (fourHeatLocalOperator_contDiff 1 a b c _ ha hb hc hm).neg

theorem fourHeatCoefficient_center (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ) (c U : FourSpace → ℝ)
    (hU0 : U 0 ≠ 0) :
    (m + 1 : ℝ) * fourHeatCoefficient a b c U (m + 1) 0 =
      -fourHeatLocalOperator (a 0) (b 0) (c 0) (fourHeatCoefficient a b c U m) 0 := by
  simp only [fourHeatCoefficient, fourHeatWeightedRadialAverage, fourHeatRadialAverage_zero]
  have hm : (m + 1 : ℝ) ≠ 0 := by positivity
  field_simp

end
end PositiveEinsteinFour.Geometry
end


section

/-! Locality of the coefficient operator through its actual second
derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter
open scoped _root_.Topology

noncomputable section

theorem fourHeat_second_germ {u v : FourSpace → ℝ} {x : FourSpace}
    (h : u =ᶠ[𝓝 x] v) (i j : Fin 4) :
    partialDeriv (partialDeriv u i) j x = partialDeriv (partialDeriv v i) j x := by
  have hp : partialDeriv u i =ᶠ[𝓝 x] partialDeriv v i := by
    filter_upwards [h.eventuallyEq_nhds] with y hy
    exact fourHeat_partial_germ hy i
  exact fourHeat_partial_germ hp j

theorem fourHeatLocalOperator_germ (a : Mat4) (b : Fin 4 → ℝ) (c : ℝ)
    {u v : FourSpace → ℝ} {x : FourSpace} (h : u =ᶠ[𝓝 x] v) :
    fourHeatLocalOperator a b c u x = fourHeatLocalOperator a b c v x := by
  simp only [fourHeatLocalOperator, fourHeat_second_germ h, fourHeat_partial_germ h,
    h.self_of_nhds]

theorem fourHeatBundleOperator_germ (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6)
    {u v : FourSpace → Fin 6 → ℝ} {x : FourSpace}
    (h : ∀ q, (fun y => u y q) =ᶠ[𝓝 x] fun y => v y q) (k : Fin 6) :
    fourHeatBundleOperator a b B C u x k = fourHeatBundleOperator a b B C v x k := by
  simp only [fourHeatBundleOperator, fourHeatLocalOperator_germ a b 0 (h k),
    fourHeatBundleFirst, fourHeatBundleZero, fourHeat_partial_germ (h _),
    fun q => (h q).self_of_nhds]

theorem fourHeatBundleOperator_zero_of_locally_zero (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) {u : FourSpace → Fin 6 → ℝ} {x : FourSpace}
    (h : ∀ q, (fun y => u y q) =ᶠ[𝓝 x] fun _ => (0 : ℝ)) (k : Fin 6) :
    fourHeatBundleOperator a b B C u x k = 0 := by
  rw [fourHeatBundleOperator_germ a b B C h k]
  have hp (i : Fin 4) : partialDeriv (fun _ : FourSpace => (0 : ℝ)) i = fun _ => 0 := by
    funext y
    simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]
  simp only [fourHeatBundleOperator, fourHeatBundleFirst, fourHeatBundleZero,
    fourHeatLocalOperator, hp]
  simp only [mul_zero, Finset.sum_const_zero, neg_zero, add_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Linearity of the local heat operator on actual twice differentiable
functions. These formulas allow cancellation in the finite heat ansatz. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem fourHeat_partial_const_mul (r : ℝ) (u : FourSpace → ℝ) (i : Fin 4)
    (x : FourSpace) : partialDeriv (fun y => r * u y) i x = r * partialDeriv u i x := by
  change fderiv ℝ (r • u) x (coordinateVector i) = _
  rw [fderiv_const_smul_field]
  rfl

theorem fourHeat_partial_add (u v : FourSpace → ℝ) (x : FourSpace)
    (hu : DifferentiableAt ℝ u x) (hv : DifferentiableAt ℝ v x) (i : Fin 4) :
    partialDeriv (fun y => u y + v y) i x = partialDeriv u i x + partialDeriv v i x := by
  simp only [partialDeriv, fderiv_fun_add hu hv, _root_.add_apply]

theorem fourHeat_second_const_mul (r : ℝ) (u : FourSpace → ℝ) (i j : Fin 4)
    (x : FourSpace) : partialDeriv (partialDeriv (fun y => r * u y) i) j x =
      r * partialDeriv (partialDeriv u i) j x := by
  simp only [funext (fourHeat_partial_const_mul r u i), fourHeat_partial_const_mul]

theorem fourHeat_second_add (u v : FourSpace → ℝ) (hu : ContDiff ℝ 2 u)
    (hv : ContDiff ℝ 2 v) (x : FourSpace) (i j : Fin 4) :
    partialDeriv (partialDeriv (fun y => u y + v y) i) j x =
      partialDeriv (partialDeriv u i) j x + partialDeriv (partialDeriv v i) j x := by
  have he : partialDeriv (fun y => u y + v y) i =
      fun y => partialDeriv u i y + partialDeriv v i y := by
    funext y
    exact fourHeat_partial_add u v y (hu.differentiable (by norm_num)).differentiableAt
      (hv.differentiable (by norm_num)).differentiableAt i
  rw [he]
  exact fourHeat_partial_add _ _ x
    ((fourHeat_partial_contDiff 1 u hu i).differentiable one_ne_zero).differentiableAt
    ((fourHeat_partial_contDiff 1 v hv i).differentiable one_ne_zero).differentiableAt j

theorem fourHeatLocalOperator_const_mul (a : Mat4) (b : Fin 4 → ℝ) (c r : ℝ)
    (u : FourSpace → ℝ) (x : FourSpace) :
    fourHeatLocalOperator a b c (fun y => r * u y) x =
      r * fourHeatLocalOperator a b c u x := by
  unfold fourHeatLocalOperator
  simp only [fourHeat_second_const_mul, fourHeat_partial_const_mul]
  simp only [Fin.sum_univ_four]
  ring

theorem fourHeatLocalOperator_add (a : Mat4) (b : Fin 4 → ℝ) (c : ℝ)
    (u v : FourSpace → ℝ) (hu : ContDiff ℝ 2 u) (hv : ContDiff ℝ 2 v) (x : FourSpace) :
    fourHeatLocalOperator a b c (fun y => u y + v y) x =
      fourHeatLocalOperator a b c u x + fourHeatLocalOperator a b c v x := by
  unfold fourHeatLocalOperator
  simp only [fourHeat_second_add u v hu hv,
    fourHeat_partial_add u v x (hu.differentiable (by norm_num)).differentiableAt
      (hv.differentiable (by norm_num)).differentiableAt,
    mul_add, Finset.sum_add_distrib]
  ring

theorem fourHeatRadialTransport_const_mul (a : Mat4) (b : Fin 4 → ℝ) (r : ℝ)
    (u : FourSpace → ℝ) (x : FourSpace) :
    fourHeatRadialTransport a b (fun y => r * u y) x =
      r * fourHeatRadialTransport a b u x := by
  unfold fourHeatRadialTransport
  simp only [fourHeat_partial_const_mul, Fin.sum_univ_four]
  ring

theorem fourHeatRadialTransport_add (a : Mat4) (b : Fin 4 → ℝ)
    (u v : FourSpace → ℝ) (hu : Differentiable ℝ u) (hv : Differentiable ℝ v)
    (x : FourSpace) :
    fourHeatRadialTransport a b (fun y => u y + v y) x =
      fourHeatRadialTransport a b u x + fourHeatRadialTransport a b v x := by
  unfold fourHeatRadialTransport
  simp only [fourHeat_partial_add u v x hu.differentiableAt hv.differentiableAt,
    Fin.sum_univ_four]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! A uniform finite jet bound on compact subneighborhoods of the common
normal family. The constants bound derivatives in all family variables. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise BigOperators

noncomputable section

theorem heatFamilyScalarJet_bound (f : HeatRadialFrameSpace → ℝ)
    (z₀ : HeatRadialFrameSpace) (R : ℝ) (hR : 0 < R)
    (hf : ∀ z ∈ ball z₀ R, ContDiffAt ℝ 10 f z) :
    ∃ C ≥ (0 : ℝ), ∀ k : ℕ, k ≤ 10 → ∀ z ∈ closedBall z₀ (R / 2),
      ‖iteratedFDeriv ℝ k f z‖ ≤ C := by
  have hs : closedBall z₀ (R / 2) ⊆ ball z₀ R :=
    closedBall_subset_ball (half_lt_self hR)
  have hb (k : Fin 11) : ∃ C ≥ (0 : ℝ), ∀ z ∈ closedBall z₀ (R / 2),
      ‖iteratedFDeriv ℝ k.val f z‖ ≤ C := by
    have hc : ContinuousOn (iteratedFDeriv ℝ k.val f) (closedBall z₀ (R / 2)) := by
      intro z hz
      exact ((hf z (hs hz)).continuousAt_iteratedFDeriv
        (by exact_mod_cast (show k.val ≤ 10 by omega))).continuousWithinAt
    obtain ⟨C, hC⟩ := (isCompact_closedBall z₀ (R / 2)).exists_bound_of_continuousOn hc
    exact ⟨max C 0, le_max_right _ _, fun z hz => (hC z hz).trans (le_max_left _ _)⟩
  choose C hC hb using hb
  refine ⟨∑ k : Fin 11, C k, Finset.sum_nonneg (fun k _ => hC k), ?_⟩
  intro k hk z hz
  let i : Fin 11 := ⟨k, by omega⟩
  exact (hb i z hz).trans
    (Finset.single_le_sum (fun j _ => hC j) (Finset.mem_univ i))

abbrev HeatFamilyCoefficientIndex :=
  (Fin 4 × Fin 4) ⊕ (Fin 4 ⊕ (Unit ⊕ ((Fin 4 × Fin 6 × Fin 6) ⊕ (Fin 6 × Fin 6))))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatFamilyCoefficient (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) :
    HeatFamilyCoefficientIndex → HeatRadialFrameSpace → ℝ
  | .inl (i, j), z => (heatFamilyMetric g c P z)⁻¹ i j
  | .inr (.inl i), z => heatFamilyDrift g c P z i
  | .inr (.inr (.inl _)), z => heatFamilyLeading g c P z
  | .inr (.inr (.inr (.inl (i, k, l)))), z => heatFamilyFirst g c P z i k l
  | .inr (.inr (.inr (.inr (k, l)))), z => heatFamilyZero g c P z k l

theorem heatFamilyCoefficient_contDiffAt (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 12 P z) (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z).det)
    (a : HeatFamilyCoefficientIndex) : ContDiffAt ℝ 10 (heatFamilyCoefficient g c P a) z := by
  rcases a with ⟨i, j⟩ | i | u | ⟨i, k, l⟩ | ⟨k, l⟩
  · exact heatFamilyInverse_contDiffAt 10 g c P z (hP.of_le (by norm_num)) hz hmetric.ne' i j
  · exact heatFamilyDrift_contDiffAt 10 g c P z hP hz hmetric i
  · exact heatFamilyLeading_contDiffAt 10 g c P z (hP.of_le (by norm_num)) hz hmetric
  · exact heatFamilyFirst_contDiffAt 10 g c P z (hP.of_le (by norm_num)) hz hframe hmetric.ne' i k l
  · exact heatFamilyZero_contDiffAt 10 g c P z hP hz hframe hmetric k l

theorem heatFamilyCoefficient_local_bound (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z₀ : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 12 P z₀) (hz : (P z₀).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z₀).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z₀).det) :
    ∃ r > (0 : ℝ), ∃ C ≥ (0 : ℝ), ∀ a : HeatFamilyCoefficientIndex,
      ∀ k : ℕ, k ≤ 10 → ∀ z ∈ closedBall z₀ r,
        ‖iteratedFDeriv ℝ k (heatFamilyCoefficient g c P a) z‖ ≤ C := by
  have hf (a : HeatFamilyCoefficientIndex) : ContDiffAt ℝ 10 (heatFamilyCoefficient g c P a) z₀ :=
    heatFamilyCoefficient_contDiffAt g c P z₀ hP hz hframe hmetric a
  have hn : ∀ᶠ z in 𝓝 z₀, ∀ a : HeatFamilyCoefficientIndex,
      ContDiffAt ℝ 10 (heatFamilyCoefficient g c P a) z := by
    exact eventually_all.mpr (fun a => (hf a).eventually (by norm_num))
  obtain ⟨R, hR, hball⟩ := Metric.eventually_nhds_iff.mp hn
  have hb (a : HeatFamilyCoefficientIndex) : ∃ C ≥ (0 : ℝ), ∀ k : ℕ, k ≤ 10 →
      ∀ z ∈ closedBall z₀ (R / 2),
        ‖iteratedFDeriv ℝ k (heatFamilyCoefficient g c P a) z‖ ≤ C :=
    heatFamilyScalarJet_bound _ z₀ R hR (fun z hz => hball hz a)
  choose C hC hb using hb
  refine ⟨R / 2, half_pos hR, ∑ a : HeatFamilyCoefficientIndex, C a,
    Finset.sum_nonneg (fun a _ => hC a), ?_⟩
  intro a k hk z hz
  exact (hb a k hk z hz).trans
    (Finset.single_le_sum (fun b _ => hC b) (Finset.mem_univ a))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual finite smooth extensions of the normal-coordinate coefficients.
They agree with the geometric operator near the center. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalDrift_smoothAt_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (j : Fin 4) :
    ContDiffAt ℝ ∞ (fun x => heatNormalDrift g o e x j) 0 := by
  have hA := heatNormalInverse_smoothAt_zero g o e
  have hJ := frameExponentialJacobian_smoothAt_zero g o e
  have hAp (i : Fin 4) : ContDiffAt ℝ ∞
      (partialDeriv (fun y => (heatNormalMetric g o e y)⁻¹ i j) i) 0 :=
    ((hA i j).fderiv_right (m := ∞) (by simp)).clm_apply contDiffAt_const
  have hJp (i : Fin 4) : ContDiffAt ℝ ∞
      (partialDeriv (frameExponentialJacobian g o e) i) 0 :=
    (hJ.fderiv_right (m := ∞) (by simp)).clm_apply contDiffAt_const
  have hJ0 : frameExponentialJacobian g o e 0 ≠ 0 := by
    rw [frameExponentialJacobian_zero]; exact one_ne_zero
  exact ((ContDiffAt.sum (fun i _ => hAp i)).add
    ((hJ.inv hJ0).mul (ContDiffAt.sum (fun i _ => (hA i j).mul (hJp i))))).neg

structure HeatNormalExtension (n : ℕ) (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) where
  a : FourSpace → Mat4
  b : FourSpace → Fin 4 → ℝ
  U : FourSpace → ℝ
  a_regular : ∀ i j, ContDiff ℝ n (fun x => a x i j)
  b_regular : ∀ i, ContDiff ℝ n (fun x => b x i)
  U_regular : ContDiff ℝ n U
  U_pos : ∀ x, 0 < U x
  a_near : a =ᶠ[𝓝 0] (fun x => (heatNormalMetric g o e x)⁻¹)
  b_near : b =ᶠ[𝓝 0] heatNormalDrift g o e
  U_near : U =ᶠ[𝓝 0] heatNormalLeadingAmplitude g o e

theorem exists_heatNormalExtension (n : ℕ) (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) : Nonempty (HeatNormalExtension n g o e) := by
  choose A hA hAc hAe using fun i j => heatScalar_extension n
    (fun x => (heatNormalMetric g o e x)⁻¹ i j)
    ((heatNormalInverse_smoothAt_zero g o e i j).of_le (by simp))
  choose B hB hBc hBe using fun i => heatScalar_extension n
    (fun x => heatNormalDrift g o e x i)
    ((heatNormalDrift_smoothAt_zero g o e i).of_le (by simp))
  obtain ⟨U, hU, hUp, hUe⟩ := heatScalar_positive_extension n
    (heatNormalLeadingAmplitude g o e)
    ((heatNormalLeadingAmplitude_smoothAt_zero g o e).of_le (by simp))
    (by rw [heatNormalLeadingAmplitude_zero]; exact zero_lt_one)
  refine ⟨{
    a := fun x i j => A i j x
    b := fun x i => B i x
    U := U
    a_regular := hA
    b_regular := hB
    U_regular := hU
    U_pos := hUp
    a_near := ?_
    b_near := ?_
    U_near := hUe }⟩
  · have h := eventually_all.mpr (fun i => eventually_all.mpr (fun j => hAe i j))
    filter_upwards [h] with x hx
    funext i j
    exact hx i j
  · have h := eventually_all.mpr (fun i => hBe i)
    filter_upwards [h] with x hx
    funext i
    exact hx i

theorem HeatNormalExtension.transport_neighborhood {n : ℕ}
    {g : SmoothMetric M} {o : FrameOrientation g} {e : FrameBundle g}
    (D : HeatNormalExtension n g o e) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      (∀ i, ∑ j : Fin 4, D.a x i j * x j = x i) ∧
      (∀ j, ∑ i : Fin 4, D.a x i j * x i = x j) ∧
      fourHeatEikonalDefect (D.a x) x = 0 ∧
      fourHeatRadialTransport (D.a x) (D.b x) D.U x = 0 := by
  obtain ⟨r₁, hr₁, hT⟩ := heatNormalLeadingAmplitude_transport_neighborhood g o hRic e he
  have hn : ∀ᶠ x in 𝓝 (0 : FourSpace),
      D.a x = (heatNormalMetric g o e x)⁻¹ ∧ D.b x = heatNormalDrift g o e x ∧
      D.U =ᶠ[𝓝 x] heatNormalLeadingAmplitude g o e ∧
      (heatNormalMetric g o e x).det ≠ 0 ∧ x ∈ ball 0 r₁ := by
    filter_upwards [D.a_near, D.b_near, D.U_near.eventuallyEq_nhds,
      heatNormalMetric_eventually_nondegenerate g o e, ball_mem_nhds (0 : FourSpace) hr₁]
      with x ha hb hU hd hx
    exact ⟨ha, hb, hU, hd, hx⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx
  obtain ⟨ha, hb, hU, hd, hx₁⟩ := hball hx
  have hrow (i : Fin 4) : ∑ j : Fin 4, D.a x i j * x j = x i := by
    rw [ha]
    exact congrFun (heatNormalMetric_inverse_radial g o hRic e he x hd) i
  have hcol (j : Fin 4) : ∑ i : Fin 4, D.a x i j * x i = x j := by
    rw [ha]
    have hs (i : Fin 4) : (heatNormalMetric g o e x)⁻¹ i j =
        (heatNormalMetric g o e x)⁻¹ j i :=
      congrFun (congrFun (heatNormalInverse_symm g o e x) j) i
    simp_rw [hs]
    simpa only [ha] using hrow j
  refine ⟨hrow, hcol, ?_, ?_⟩
  · rw [ha]
    exact heatNormalMetric_eikonal g o hRic e he x hd
  · rw [fourHeatRadialTransport_germ _ _ hU, ha, hb]
    exact hT x hx₁

end
end PositiveEinsteinFour.Geometry
end


section

/-! Identification of the coordinate Hessian contraction with the
actual framed rough trace of a smooth two-form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_orthonormal_inverse (H E : Mat4) (hE : Eᵀ * H * E = 1) :
    E * Eᵀ = H⁻¹ := by
  have hu : IsUnit E.det := by
    apply isUnit_iff_ne_zero.mpr
    intro hz
    have h := congrArg Matrix.det hE
    simp only [Matrix.det_mul, Matrix.det_transpose, hz, zero_mul, Matrix.det_one] at h
    norm_num at h
  have h := heat_matrix_inverse_congruence H E hu
  simpa only [hE, inv_one, mul_one] using h

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem heat_framedSecond_chart {g : SmoothMetric M} {o : FrameOrientation g}
    {u : M → TwoFormFour} (hu : TwoFormSmooth o u) (c : M) (e : FrameBundle g)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    twoFormFramedSecondDerivative o u e = frameTensor (frameChartMatrix g c e)
      (twoFormSecondCovariantCoordinates o u c (chartAt FourSpace c e.base)) := by
  have hb := mem_chart_source FourSpace e.base
  have ht := hu.secondCovariant_transition e.base c
    (chartAt FourSpace e.base e.base) ((chartAt FourSpace e.base).map_source hb)
    (by simpa only [(chartAt FourSpace e.base).left_inv hb] using he)
  have hz : chartTransition e.base c (chartAt FourSpace e.base e.base) =
      chartAt FourSpace c e.base := by
    change chartAt FourSpace c ((chartAt FourSpace e.base).symm
      (chartAt FourSpace e.base e.base)) = _
    rw [(chartAt FourSpace e.base).left_inv hb]
  rw [hz] at ht
  rw [frameChartMatrix_eq, frameTensor_mul, ← ht]
  rfl

variable [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.roughTrace_as_actual {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g}
    (D : HeatNormalFrameData g o c e) {u : M → TwoFormFour}
    (hu : TwoFormSmooth o u) (x : FourSpace) (hx : x ∈ ball 0 D.radius) :
    twoFormFramedRoughTrace o u (D.frame x hx) =
      frameTensor (D.point x).2 (twoFormSecondTrace (metricInChart g c (D.point x).1)⁻¹
        (twoFormSecondCovariantCoordinates o u c (D.point x).1)) := by
  have hsource : (D.frame x hx).base ∈ (chartAt FourSpace c).source :=
    (chartAt FourSpace c).map_target (D.in_chart x hx)
  have h := heat_framedSecond_chart hu c (D.frame x hx) hsource
  have hm : frameChartMatrix g c (D.frame x hx) = (D.point x).2 :=
    frameChartMatrix_chartFrameState g c
      ⟨D.point x, D.in_chart x hx, D.orthonormal x hx⟩
  have hb : chartAt FourSpace c (D.frame x hx).base = (D.point x).1 :=
    (chartAt FourSpace c).right_inv (D.in_chart x hx)
  rw [hm, hb] at h
  funext v
  change (∑ i, twoFormFramedSecondDerivative o u (D.frame x hx)
    (Fin.cons i (Fin.cons i v))) = _
  rw [h, twoFormSecondTrace_frame, heat_orthonormal_inverse _ _ (D.orthonormal x hx)]

theorem HeatNormalFrameData.actual_tensor_rough_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g}
    (D : HeatNormalFrameData g o c e) (he : e.base ∈ (chartAt FourSpace c).source)
    {u : M → TwoFormFour} (hu : TwoFormSmooth o u) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ hx : x ∈ ball 0 D.radius, ∀ v : Fin 2 → Fin 4,
      -(∑ i, ∑ j, (heatNormalMetric g o e x)⁻¹ i j *
        tensorCovariantDirection (heatNormalFrameConnection g c D.point)
          (tensorCovariantDirection (heatNormalFrameConnection g c D.point)
            (fun y => frameTensor (D.point y).2 (twoFormCoordinates o u c (D.point y).1)) i) j x v) +
        (∑ i, heatNormalDrift g o e x i *
          tensorCovariantDirection (heatNormalFrameConnection g c D.point)
            (fun y => frameTensor (D.point y).2 (twoFormCoordinates o u c (D.point y).1)) i x v) =
        -twoFormFramedRoughTrace o u (D.frame x hx) v := by
  filter_upwards [D.rough_pullback_near he (twoFormCoordinates o u c)
    (fun z hz => hu.coordinates_contDiffAt c z hz)] with x h
  intro hx v
  rw [D.roughTrace_as_actual hu x hx]
  exact h v

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite scalar chain rules and the actual change of normal-coordinate
Laplacian. The Jacobian derivative cancels the density drift exactly. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped Manifold ContDiff _root_.Topology BigOperators Matrix.Norms.Elementwise

noncomputable section

theorem heat_scalar_second_comp (F : FourSpace → FourSpace) (f : FourSpace → ℝ)
    (x : FourSpace) (hF : ContDiffAt ℝ 2 F x) (hf : ContDiffAt ℝ 2 f (F x)) (i j : Fin 4) :
    partialDeriv (partialDeriv (fun y => f (F y)) i) j x =
      (∑ r, partialDeriv (fun y => jacobianMatrix F y r i) j x * partialDeriv f r (F x)) +
        ∑ r, ∑ s, jacobianMatrix F x r i * jacobianMatrix F x s j *
          partialDeriv (partialDeriv f r) s (F x) := by
  have hFd := hF.differentiableAt (by norm_num)
  have hfr (r : Fin 4) : ContDiffAt ℝ 1 (partialDeriv f r) (F x) :=
    (hf.fderiv_right (m := 1) (by norm_num)).clm_apply contDiffAt_const
  have hJ (r : Fin 4) : DifferentiableAt ℝ (fun y => jacobianMatrix F y r i) x :=
    (heatJacobian_entry_regular 1 hF r i).differentiableAt one_ne_zero
  have hG (r : Fin 4) : DifferentiableAt ℝ (fun y => partialDeriv f r (F y)) x :=
    ((hfr r).differentiableAt one_ne_zero).comp x hFd
  have he : partialDeriv (fun y => f (F y)) i =ᶠ[𝓝 x]
      (fun y => ∑ r, jacobianMatrix F y r i * partialDeriv f r (F y)) := by
    have hFn := (hF.of_le (show (1 : ℕ∞ω) ≤ 2 by norm_num)).eventually (by norm_num)
    have hfn : ∀ᶠ y in 𝓝 x, ContDiffAt ℝ 1 f (F y) :=
      hF.continuousAt.tendsto.eventually
        ((hf.of_le (show (1 : ℕ∞ω) ≤ 2 by norm_num)).eventually (by norm_num))
    filter_upwards [hFn, hfn] with y hFy hfy
    exact partialDeriv_comp (hFy.differentiableAt one_ne_zero)
      (hfy.differentiableAt one_ne_zero) i
  have hd := congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector j)) he.fderiv_eq
  change partialDeriv (partialDeriv (fun y => f (F y)) i) j x = _ at hd
  rw [hd]
  rw [fderiv_fun_sum (u := Finset.univ)
    (A := fun r y => jacobianMatrix F y r i * partialDeriv f r (F y))
    (fun r _ => (hJ r).mul (hG r)), _root_.sum_apply]
  simp only [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro r _
  rw [fderiv_fun_mul (hJ r) (hG r)]
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
  have hc := partialDeriv_comp hFd ((hfr r).differentiableAt one_ne_zero) j
  change fderiv ℝ (fun y => partialDeriv f r (F y)) x (coordinateVector j) = _ at hc
  rw [hc, Finset.mul_sum]
  simp only [mul_assoc, partialDeriv]
  ring

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalar_finite_chart_laplacian (g : SmoothMetric M) {f : M → ℝ}
    (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f) (c : M) (z : ChartTarget c) :
    scalarLaplacianBase g f ((chartAt FourSpace c).symm z) =
      scalarChartOperator g c (fun y => f ((chartAt FourSpace c).symm y)) z := by
  have hc := scalar_finite_derivative_transition g hf c ((chartAt FourSpace c).symm z)
    2 (by omega) z z.property (mem_chart_source FourSpace ((chartAt FourSpace c).symm z))
  rw [chartTransitionMatrix_to_center c z z.property] at hc
  have he : chartScalarLaplacian g f c z =
      scalarLaplacianBase g f ((chartAt FourSpace c).symm z) := by
    rw [chartScalarLaplacian, hc]
    simp_rw [← frameTensor_mul]
    exact scalarLaplacian_eq_base g f (chartGramSection g c 1 (by simp) z)
  rw [← he, chartScalarLaplacian_coefficients g f c z z.property]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar spectral multipliers and heat evolution for the actual metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

local instance scalarProjection_frameCompact : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

def scalarBaseHarmonicWeight
    (μ : ScalarBaseEigenIndex g o d) : ℝ :=
  if μ.1.val = 1 then 1 else 0

omit [SecondCountableTopology M] in
theorem scalarBaseHarmonicWeight_bound
    (μ : ScalarBaseEigenIndex g o d) : |scalarBaseHarmonicWeight g o d μ| ≤ 1 := by
  simp only [scalarBaseHarmonicWeight]
  split_ifs <;> norm_num

def scalarBaseHarmonicProjection : Lp ℝ 2 (normalizedVolume g) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  scalarBaseSpectralMultiplier g o d (scalarBaseHarmonicWeight g o d) 1 zero_le_one
    (scalarBaseHarmonicWeight_bound g o d)

theorem scalarBaseHarmonicProjection_coordinate (f : Lp ℝ 2 (normalizedVolume g))
    (μ : ScalarBaseEigenIndex g o d) :
    (scalarBaseSpectralEquiv g o d (scalarBaseHarmonicProjection g o d f)) μ =
      scalarBaseHarmonicWeight g o d μ • (scalarBaseSpectralEquiv g o d f) μ :=
  scalarBaseSpectralMultiplier_coordinate g o d _ _ _ _ f μ

theorem scalarBaseHarmonicProjection_fixed (f : Lp ℝ 2 (normalizedVolume g)) :
    scalarBaseResolvent g o d (scalarBaseHarmonicProjection g o d f) =
      scalarBaseHarmonicProjection g o d f := by
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext μ
  rw [scalarBaseResolvent_coordinate, scalarBaseHarmonicProjection_coordinate]
  by_cases hμ : μ.1.val = 1
  · simp [scalarBaseHarmonicWeight, hμ]
  · simp only [scalarBaseHarmonicWeight, ite_eq_right hμ, zero_smul, smul_zero]

theorem scalarBaseHarmonicProjection_of_fixed (f : Lp ℝ 2 (normalizedVolume g))
    (hf : scalarBaseResolvent g o d f = f) : scalarBaseHarmonicProjection g o d f = f := by
  apply (scalarBaseSpectralEquiv g o d).injective
  apply lp.ext
  funext i
  rw [scalarBaseHarmonicProjection_coordinate]
  by_cases hi : i.1.val = 1
  · simp only [scalarBaseHarmonicWeight, ite_eq_left hi, one_smul]
  · have he := congrArg (fun v => scalarBaseSpectralEquiv g o d v i) hf
    rw [scalarBaseResolvent_coordinate] at he
    have hprod : (i.1.val - 1) * scalarBaseSpectralEquiv g o d f i = 0 := by
      change i.1.val * scalarBaseSpectralEquiv g o d f i = scalarBaseSpectralEquiv g o d f i at he
      linarith only [he]
    have hz := (mul_eq_zero.mp hprod).resolve_left (sub_ne_zero.mpr hi)
    simp only [scalarBaseHarmonicWeight, ite_eq_right hi, zero_smul, hz]

variable [PreconnectedSpace M]

theorem scalarBaseHarmonicProjection_mean (hRic : RicciThree g) (f : Lp ℝ 2 (normalizedVolume g)) :
    scalarBaseHarmonicProjection g o d f =
      inner ℝ (smoothScalarBaseL2 g (smoothScalarConst 1)) f •
        smoothScalarBaseL2 g (smoothScalarConst 1) := by
  let one := smoothScalarBaseL2 g (smoothScalarConst 1)
  have hfixed := scalarBaseHarmonicProjection_fixed g o d f
  obtain ⟨c, hc⟩ := scalarBaseResolvent_fixed_constant g o d hRic _ hfixed
  have hmean : inner ℝ (scalarBaseHarmonicProjection g o d f) one = inner ℝ f one := by
    have he := scalarBaseSpectralMultiplier_selfAdjoint g o d
      (scalarBaseHarmonicWeight g o d) 1 zero_le_one (scalarBaseHarmonicWeight_bound g o d) f one
    change inner ℝ (scalarBaseHarmonicProjection g o d f) one =
      inner ℝ f (scalarBaseHarmonicProjection g o d one) at he
    rw [scalarBaseHarmonicProjection_of_fixed g o d one (scalarBaseResolvent_fixed_one g o d)] at he
    exact he
  have h11 : inner ℝ one one = 1 := by
    have hp := (scalarBasePullback g o).inner_map_map one one
    change inner ℝ (scalarBasePullback g o (smoothScalarBaseL2 g (smoothScalarConst 1)))
      (scalarBasePullback g o (smoothScalarBaseL2 g (smoothScalarConst 1))) = _ at hp
    rw [scalarBasePullback_smooth] at hp
    have hf : inner ℝ (scalarL2One g (canonicalFrameMeasure g o))
        (scalarL2One g (canonicalFrameMeasure g o)) = 1 := by
      simpa only [scalarH1Mean_apply, scalarH1Value_one] using scalarH1Mean_one d
    exact hp.symm.trans hf
  change scalarBaseHarmonicProjection g o d f = inner ℝ one f • one
  change scalarBaseHarmonicProjection g o d f = c • one at hc
  rw [hc, real_inner_smul_left, h11, mul_one] at hmean
  have hcmean : c = inner ℝ one f := hmean.trans (real_inner_comm _ _)
  rw [hc, hcmean]

omit [PreconnectedSpace M] in
theorem scalarBaseHeatWeight_tendsto
    (μ : ScalarBaseEigenIndex g o d) :
    Tendsto (fun t : ℝ≥0 => scalarBaseHeatWeight g o d t μ) atTop
      (𝓝 (scalarBaseHarmonicWeight g o d μ)) := by
  by_cases hμ : μ.1.val = 1
  · have hr := (scalarBaseHeatRate_eq_zero g o d μ).mpr hμ
    simpa only [scalarBaseHeatWeight, hr, mul_zero, Real.exp_zero,
      scalarBaseHarmonicWeight, ite_eq_left hμ] using
      (tendsto_const_nhds : Tendsto (fun _ : ℝ≥0 => (1 : ℝ)) atTop (𝓝 1))
  · have hp : 0 < scalarBaseHeatRate g o d μ := lt_of_le_of_ne
      (scalarBaseHeatRate_nonneg g o d μ)
      (Ne.symm (mt (scalarBaseHeatRate_eq_zero g o d μ).mp hμ))
    have ht : Tendsto (fun t : ℝ≥0 => (t : ℝ)) atTop atTop :=
      NNReal.tendsto_coe_atTop.mpr tendsto_id
    have hn := ht.atTop_mul_const_of_neg (neg_neg_of_pos hp)
    have he := Real.tendsto_exp_atBot.comp hn
    simpa only [Function.comp_def, scalarBaseHeatWeight, mul_neg, neg_mul,
      scalarBaseHarmonicWeight, ite_eq_right hμ] using he

omit [PreconnectedSpace M] in
theorem scalarBaseHeat_tendsto_harmonic (f : Lp ℝ 2 (normalizedVolume g)) :
    Tendsto (fun t : ℝ≥0 => scalarBaseHeat g o d t f) atTop
      (𝓝 (scalarBaseHarmonicProjection g o d f)) :=
  scalarBaseSpectralMultiplier_tendsto g o d (scalarBaseHeatWeight g o d) (scalarBaseHarmonicWeight g o d)
    (scalarBaseHeatWeight_bound g o d) (scalarBaseHarmonicWeight_bound g o d)
    (scalarBaseHeatWeight_tendsto g o d) f

end
end PositiveEinsteinFour.Geometry
end


section

/-! All local integer Sobolev orders of the actual positive-time scalar heat
output, on a single chart neighborhood. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalarBaseHeat_local_all_orders (t : ℝ≥0) (ht : 0 < t)
    (f : Lp ℝ 2 (normalizedVolume g)) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : FourSpace) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure FourSpace),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarBaseHeat g o d t f
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : FourSpace) 1)] w ∧
        ∀ (n : ℕ) (φ : 𝓢(FourSpace, ℂ)), HasCompactSupport (φ : FourSpace → ℂ) →
          tsupport (φ : FourSpace → ℂ) ⊆ ball 0 (1 / 2) →
          MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : 𝓢'(FourSpace, ℂ))) := by
  obtain ⟨r, hr, htarget, hchain⟩ := scalarBaseResolvent_local_orders g o d c z₀
  let F := fun n => scalarBaseHeatPowerSource g o d t ht (n + 1) f
  obtain ⟨w₀, hw₀, _⟩ := hchain (F 0)
  have he₀ : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarBaseHeat g o d t f
        ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : FourSpace) 1)] w₀ 0 := by
    have he := scalarBaseHeatPowerSource_resolvent g o d t ht 1 f
    simpa only [Nat.zero_add, F, he] using hw₀ 0
  refine ⟨r, hr, htarget, w₀ 0, he₀, ?_⟩
  intro n φ hc hs
  obtain ⟨w, hw, hreg⟩ := hchain (F n)
  have he : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarBaseHeat g o d t f
        ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : FourSpace) 1)] w n := by
    simpa only [F, scalarBaseHeatPowerSource_resolvent] using hw n
  have heq := scalar_localized_distribution_eq (ball (0 : FourSpace) 1)
    isOpen_ball.measurableSet (w₀ 0) (w n) (he₀.symm.trans he) φ
    (hs.trans (ball_subset_ball (by norm_num : (1 / 2 : ℝ) ≤ 1)))
  rw [heq]
  exact (hreg n φ hc hs).mono (by exact_mod_cast (show n ≤ 2 * n + 1 by omega))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual L2 values and Laplacians of C4 cutoffs. Their spectral pairing
is obtained from the finite-regularity geometric Green identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

local instance scalarFinite_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarFiniteValueL2 (f : M → ℝ) (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f) :
    Lp ℝ 2 (normalizedVolume g) :=
  ContinuousMap.toLp 2 (normalizedVolume g) ℝ ⟨f, hf.continuous⟩

def scalarFiniteLaplacianL2 (f : M → ℝ) (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f) :
    Lp ℝ 2 (normalizedVolume g) :=
  ContinuousMap.toLp 2 (normalizedVolume g) ℝ
    ⟨scalarLaplacianBase g f, scalar_finite_laplacian_continuous hf⟩

omit [SecondCountableTopology M] in
theorem scalarFiniteValueL2_coe (f : M → ℝ) (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f) :
    scalarFiniteValueL2 g f hf =ᵐ[normalizedVolume g] f :=
  ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g) _

omit [SecondCountableTopology M] in
theorem scalarFiniteLaplacianL2_coe (f : M → ℝ) (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f) :
    scalarFiniteLaplacianL2 g f hf =ᵐ[normalizedVolume g] scalarLaplacianBase g f :=
  ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g) _

theorem scalarFiniteLaplacian_eigen (f : M → ℝ) (hf : ContMDiff I4 𝓘(ℝ, ℝ) 4 f)
    (i : ScalarBaseEigenIndex g o d) :
    inner ℝ (scalarFiniteLaplacianL2 g f hf) (scalarBaseEigenvector g o d i) =
      -scalarBaseHeatRate g o d i *
        inner ℝ (scalarFiniteValueL2 g f hf) (scalarBaseEigenvector g o d i) := by
  let F := scalarBaseEigenfunction g o d i
  have hF : scalarBaseEigenvector g o d i =ᵐ[normalizedVolume g] F.val := by
    rw [scalarBaseEigenfunction_L2]
    exact ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g) _
  have h1 : inner ℝ (scalarFiniteLaplacianL2 g f hf) (scalarBaseEigenvector g o d i) =
      ∫ x, scalarLaplacianBase g f x * F.val x ∂normalizedVolume g := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [scalarFiniteLaplacianL2_coe g f hf, hF] with x hx hFx
    simp only [RCLike.inner_apply', conj_trivial, hx, hFx]
  have h2 : inner ℝ (scalarFiniteValueL2 g f hf) (scalarBaseEigenvector g o d i) =
      ∫ x, f x * F.val x ∂normalizedVolume g := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [scalarFiniteValueL2_coe g f hf, hF] with x hx hFx
    simp only [RCLike.inner_apply', conj_trivial, hx, hFx]
  have hLF (x : M) : scalarLaplacianBase g F.val x =
      -scalarBaseHeatRate g o d i * F.val x := by
    exact congrArg (fun v : SmoothScalar (M := M) => v.val x)
      (scalarBaseEigenfunction_laplacian g o d i)
  rw [h1, h2, scalar_finite_laplacian_base_symmetric o d hf
    (F.property.of_le (by simp))]
  simp_rw [hLF, mul_left_comm (f _) (-scalarBaseHeatRate g o d i)]
  exact integral_const_mul _ _

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual smooth scalar eigenfunctions are total in H1, not merely L2. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

local instance (g : SmoothMetric M) : CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

omit [SecondCountableTopology M] in
theorem scalarH1BaseValue_injective : Function.Injective (scalarH1BaseValue g o d) := by
  intro u v h
  apply scalarH1Value_injective d
  exact (scalarH1BaseValue_spec g o d u).symm.trans
    ((congrArg (scalarBasePullback g o) h).trans (scalarH1BaseValue_spec g o d v))

omit [SecondCountableTopology M] in
theorem scalarBaseShiftedSolution_dense : DenseRange (scalarBaseShiftedSolution g o d) :=
  adjoint_denseRange_of_injective _ (scalarH1BaseValue_injective g o d)

theorem scalarBaseShiftedSolution_eigen_smooth (i : ScalarBaseEigenIndex g o d) :
    scalarBaseShiftedSolution g o d (scalarBaseEigenvector g o d i) =
      i.1.val • smoothScalarToH1 d (scalarBaseEigenfunction g o d i) := by
  apply scalarH1BaseValue_injective g o d
  change scalarBaseResolvent g o d (scalarBaseEigenvector g o d i) = _
  rw [map_smul, scalarH1BaseValue_smooth, ← scalarBaseEigenfunction_L2]
  exact Module.End.mem_eigenspace_iff.mp (scalarBaseEigenvector_hasEigenvector g o d i).1

theorem scalarH1_eigenfunctions_total :
    (Submodule.span ℝ (range (fun i : ScalarBaseEigenIndex g o d =>
      smoothScalarToH1 d (scalarBaseEigenfunction g o d i)))).topologicalClosure = ⊤ := by
  have he := dense_span_continuousLinearMap_image (scalarBaseEigenvector g o d)
    (by rw [scalarBaseEigenvector_span, scalarBaseSpectral_total])
    (scalarBaseShiftedSolution g o d) (scalarBaseShiftedSolution_dense g o d)
  have hs : Submodule.span ℝ (range (fun i =>
      scalarBaseShiftedSolution g o d (scalarBaseEigenvector g o d i))) ≤
      Submodule.span ℝ (range (fun i : ScalarBaseEigenIndex g o d =>
        smoothScalarToH1 d (scalarBaseEigenfunction g o d i))) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change scalarBaseShiftedSolution g o d (scalarBaseEigenvector g o d i) ∈ _
    rw [scalarBaseShiftedSolution_eigen_smooth]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  apply top_unique
  rw [← he]
  exact Submodule.topologicalClosure_mono hs

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual Bochner heat convolution, its eigenmode pairing and its
quadratic norm bound for a linearly vanishing residual. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set MeasureTheory
open scoped ContDiff Manifold _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarHeatConvolution (R : ℝ → Lp ℝ 2 (normalizedVolume g)) (t : ℝ) : Lp ℝ 2 (normalizedVolume g) :=
  ∫ s in (0 : ℝ)..t, scalarBaseHeat g o d (t - s).toNNReal (R s)

theorem scalarHeatConvolution_integrable
    (R : ℝ → Lp ℝ 2 (normalizedVolume g)) (t : ℝ) (ht : 0 ≤ t) (hR : ContinuousOn R (Icc 0 t)) :
    IntervalIntegrable (fun s => scalarBaseHeat g o d (t - s).toNNReal (R s)) volume 0 t := by
  have htime : Continuous (fun s : ℝ => (t - s).toNNReal) :=
    continuous_real_toNNReal.comp (continuous_const.sub continuous_id)
  exact ((scalarBaseHeat_joint_continuous g o d).comp_continuousOn
    (htime.continuousOn.prodMk hR)).intervalIntegrable_of_Icc ht

theorem scalarHeatConvolution_norm_le
    (R : ℝ → Lp ℝ 2 (normalizedVolume g)) (t : ℝ) (ht : 0 ≤ t) (B : ℝ)
    (hR : ∀ s ∈ Icc 0 t, ‖R s‖ ≤ B * s) :
    ‖scalarHeatConvolution g o d R t‖ ≤ B * t ^ 2 / 2 := by
  have hi : IntervalIntegrable (fun s : ℝ => B * s) volume 0 t :=
    (continuous_const.mul continuous_id).intervalIntegrable _ _
  calc
    _ ≤ ∫ s in (0 : ℝ)..t, B * s := by
      apply intervalIntegral.norm_integral_le_of_norm_le ht _ hi
      exact Filter.Eventually.of_forall fun s hs =>
        (scalarBaseHeat_contraction g o d (t - s).toNNReal (R s)).trans
          (hR s ⟨hs.1.le, hs.2⟩)
    _ = _ := by rw [intervalIntegral.integral_const_mul, integral_id]; ring

theorem scalarHeatConvolution_eigen
    (R : ℝ → Lp ℝ 2 (normalizedVolume g)) (t : ℝ) (ht : 0 ≤ t) (hR : ContinuousOn R (Icc 0 t))
    (i : ScalarBaseEigenIndex g o d) :
    inner ℝ (scalarHeatConvolution g o d R t) (scalarBaseEigenvector g o d i) =
      ∫ s in (0 : ℝ)..t, Real.exp (-(i.1.val⁻¹ - 1) * (t - s)) *
        inner ℝ (R s) (scalarBaseEigenvector g o d i) := by
  have hi := scalarHeatConvolution_integrable g o d R t ht hR
  have hp := (innerSL ℝ (scalarBaseEigenvector g o d i)).intervalIntegral_comp_comm hi
  change (∫ s in (0 : ℝ)..t,
    inner ℝ (scalarBaseEigenvector g o d i) (scalarBaseHeat g o d (t - s).toNNReal (R s))) =
      inner ℝ (scalarBaseEigenvector g o d i) (scalarHeatConvolution g o d R t) at hp
  rw [real_inner_comm, ← hp]
  apply intervalIntegral.integral_congr
  intro s hs
  have hs' : s ∈ Icc 0 t := by simpa only [uIcc_of_le ht] using hs
  change inner ℝ (scalarBaseEigenvector g o d i) (scalarBaseHeat g o d (t - s).toNNReal (R s)) =
    Real.exp (-(i.1.val⁻¹ - 1) * (t - s)) * inner ℝ (R s) (scalarBaseEigenvector g o d i)
  rw [real_inner_comm, scalarBaseHeat_selfAdjoint, scalarBaseHeat_eigenvector, real_inner_smul_right]
  unfold scalarBaseHeatWeight scalarBaseHeatRate
  rw [Real.coe_toNNReal _ (sub_nonneg.mpr hs'.2)]
  ring_nf

end
end PositiveEinsteinFour.Geometry
end


section

/-! Higher local Euler powers after dividing by the actual smooth positive density. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff NNReal

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

theorem scalar_local_integer_power_source (n : ℕ) (hn : 2 ≤ n) (ρ b : V → ℝ)
    (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : 𝓢(V, ℂ), HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev ((n : ℝ) + 1) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (hρ : ∀ y ∈ closedBall (0 : V) (1 / 2), ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y)
    (hρ0 : ∀ y ∈ closedBall (0 : V) (1 / 2), ρ y ≠ 0)
    (a B q : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ x ∈ closedBall (0 : V) (1 / 2), b x ∈ Icc a B)
    (ψ : S) (hc : HasCompactSupport (ψ : V → ℝ))
    (hs : tsupport (ψ : V → ℝ) ⊆ ball 0 (1 / 2)) :
    ∃ v : Lp ℝ 2 (volume : Measure V), MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] fun y => ψ y * (b y) ^ q := by
  obtain ⟨χ, hχ, hχc, hχs, hone⟩ := scalar_half_ball_cutoff_of_compact hc hs
  obtain ⟨z, hz2, hz⟩ := scalar_integer_density_division (n + 1) ρ b w heq
    (fun φ hc hs => by simpa only [Nat.cast_add, Nat.cast_one] using hreg φ hc hs) χ hχ hχc hχs
    (fun y hy => hρ y (ball_subset_closedBall (hχs hy)))
    (fun y hy => hρ0 y (ball_subset_closedBall (hχs hy)))
  obtain ⟨u, hu2, hu⟩ := scalar_real_integer_realization (n + 1) z hz2 (fun y => χ y * b y) hz
  have hru : ∀ᵐ x ∂(volume : Measure V), x ∈ tsupport (ψ : V → ℝ) → u x ∈ Icc a B := by
    filter_upwards [hu] with x hx hxs
    rw [hx, hone x hxs, one_mul]
    exact hRange x (ball_subset_closedBall (hs hxs))
  obtain ⟨v, hv2, hv⟩ := scalar_localized_integer_positive_power n hn u ψ hc a B q ha hB
    (by simpa only [Nat.cast_add, Nat.cast_one] using hu2) hru
  refine ⟨v, hv2, ?_⟩
  filter_upwards [hv, hu] with x hx hu
  rw [hx]
  by_cases hψ : ψ x = 0
  · simp only [hψ, zero_mul]
  · rw [hu, hone x (subset_tsupport (ψ : V → ℝ) hψ), one_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! A compact smooth cutoff transfers Sobolev regularity from a local
almost-everywhere representative to the actual L2 function. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped SchwartzMap ENNReal ContDiff BigOperators

noncomputable section

theorem scalar_local_sobolev_transfer (n : ℕ) (f : Lp ℝ 2 (volume : Measure FourSpace))
    (v : Lp ℂ 2 (volume : Measure FourSpace)) (hv : MemSobolev (n : ℝ) 2 (v : 𝓢'(FourSpace, ℂ)))
    (U : Set FourSpace) (hU : MeasurableSet U)
    (he : (v : FourSpace → ℂ) =ᵐ[volume.restrict U] fun z => (f z : ℂ))
    (a : FourSpace → ℝ) (ha : ContDiff ℝ ∞ a) (hc : HasCompactSupport a)
    (hs : tsupport a ⊆ U) :
    MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ (fun z => (a z : ℂ))
      (scalarComplexL2 f : 𝓢'(FourSpace, ℂ))) := by
  let φ : 𝓢(FourSpace, ℂ) := (hc.toSchwartzMap ha).postcompCLM Complex.ofRealCLM
  let A := φ.toLp (∞ : ℝ≥0∞) volume
  have hlocal := (ae_restrict_iff' hU).mp he
  have hmul : scalarL2Multiply A (scalarComplexL2 f) = scalarL2Multiply A v := by
    apply Lp.ext
    filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) A (scalarComplexL2 f),
      Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) A v, φ.coeFn_toLp (∞ : ℝ≥0∞) volume,
      scalarComplexL2_coe f, hlocal] with z hleft hright hA hf hz
    change (A • scalarComplexL2 f : Lp ℂ 2 volume) z = (A • v : Lp ℂ 2 volume) z
    rw [hleft, hright]
    change A z * scalarComplexL2 f z = A z * v z
    rw [hA, hf]
    change (a z : ℂ) * (f z : ℂ) = (a z : ℂ) * v z
    by_cases hza : a z = 0
    · simp only [hza, Complex.ofReal_zero, zero_mul]
    · rw [hz (hs (subset_tsupport a hza))]
  have hdist := congrArg (fun w : Lp ℂ 2 (volume : Measure FourSpace) =>
    (w : 𝓢'(FourSpace, ℂ))) hmul
  change (scalarL2Multiply (φ.toLp (∞ : ℝ≥0∞) volume) (scalarComplexL2 f) :
    𝓢'(FourSpace, ℂ)) = (scalarL2Multiply (φ.toLp (∞ : ℝ≥0∞) volume) v :
      𝓢'(FourSpace, ℂ)) at hdist
  simp only [SchwartzMap.toLp] at hdist
  rw [scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp (∞ : ℝ≥0∞) volume),
    scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp (∞ : ℝ≥0∞) volume)] at hdist
  change MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 f : 𝓢'(FourSpace, ℂ)))
  rw [hdist]
  exact scalar_memSobolev_schwartz_multiplier n φ (v : 𝓢'(FourSpace, ℂ)) hv

theorem scalarReal_memSobolev_finset (n : ℕ) {ι : Type*} (s : Finset ι)
    (F : ι → Lp ℝ 2 (volume : Measure FourSpace))
    (hF : ∀ i ∈ s, MemSobolev (n : ℝ) 2 (scalarComplexL2 (F i) : 𝓢'(FourSpace, ℂ))) :
    MemSobolev (n : ℝ) 2 (scalarComplexL2 (∑ i ∈ s, F i) : 𝓢'(FourSpace, ℂ)) := by
  let C : Lp ℝ 2 (volume : Measure FourSpace) →L[ℝ] 𝓢'(FourSpace, ℂ) :=
    ((Lp.toTemperedDistributionCLM ℂ volume 2).restrictScalars ℝ).comp
      (Complex.ofRealCLM.compLpL 2 volume)
  change MemSobolev (n : ℝ) 2 (C (∑ i ∈ s, F i))
  rw [map_sum]
  induction s using Finset.cons_induction_on with
  | empty => simpa only [Finset.sum_empty] using memSobolev_fun_zero FourSpace ℂ (n : ℝ) 2
  | cons i s hi ih =>
      rw [Finset.sum_cons]
      exact (hF i (Finset.mem_cons_self i s)).add
        (ih (fun j hj => hF j (Finset.mem_cons_of_mem hj)))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The L8 gain puts the actual subcritical nonlinearity in L2, allowing
the weak equation to use every H1 test and the proved elliptic estimates. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory Filter
open scoped ENNReal

noncomputable section

theorem scalar_nonlinear_memLp_two_of_eight {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {f : X → ℝ} (hf : MemLp f 8 μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) :
    MemLp (fun x => |f x| ^ (p - 2) * f x) 2 μ := by
  have hexp : (6 : ℝ≥0∞) / 3 = 2 := by
    rw [show (6 : ℝ≥0∞) = 2 * 3 by norm_num]
    exact ENNReal.mul_div_cancel_right (by norm_num) (by norm_num)
  have hcube : MemLp (fun x => |f x| ^ 3) 2 μ := by
    have h := (hf.mono_exponent (by norm_num : (6 : ℝ≥0∞) ≤ 8)).norm_rpow_div 3
    simpa only [ENNReal.toReal_ofNat, Real.rpow_ofNat, Real.norm_eq_abs, hexp] using h
  have hc : Continuous (fun s : ℝ => |s| ^ (p - 2) * s) :=
    (continuous_abs.rpow_const (fun _ => Or.inr (by linarith : 0 ≤ p - 2))).mul continuous_id
  have hdom : MemLp (fun x => 1 + |f x| ^ 3) 2 μ := (memLp_const (1 : ℝ)).add hcube
  apply hdom.mono' (hc.comp_aestronglyMeasurable hf.aestronglyMeasurable)
  filter_upwards [] with x
  have hnorm : ‖|f x| ^ (p - 2) * f x‖ = |f x| ^ (p - 1) := by
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
      ← Real.rpow_add_one' (abs_nonneg _) (by linarith : p - 2 + 1 ≠ 0)]
    congr 1
    ring
  rw [hnorm]
  by_cases hsmall : |f x| ≤ 1
  · exact (Real.rpow_le_one (abs_nonneg _) hsmall (by linarith : 0 ≤ p - 1)).trans
      (le_add_of_nonneg_right (pow_nonneg (abs_nonneg _) 3))
  · have h := Real.rpow_le_rpow_of_exponent_le (le_of_not_ge hsmall)
      (by linarith : p - 1 ≤ 3)
    have h3 : |f x| ^ (p - 1) ≤ |f x| ^ (3 : ℕ) := by
      simpa only [Real.rpow_ofNat] using h
    exact h3.trans (le_add_of_nonneg_left zero_le_one)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The weak minimum equation becomes the pointwise geometric Euler
equation once its actual representative is smooth and positive. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def smoothScalarPositivePower (a : SmoothScalar (M := M))
    (ha : ∀ x, 0 < a.val x) (q : ℝ) : SmoothScalar (M := M) := by
  refine ⟨fun x => a.val x ^ q, ?_⟩
  intro x
  exact (Real.contDiffAt_rpow_const_of_ne (ne_of_gt (ha x))).comp_contMDiffAt
    a.property.contMDiffAt

variable [T3Space M] [CompactSpace M] [MeasurableSpace M] [BorelSpace M] [Nonempty M]

local instance scalarSmoothEuler_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarSmoothEuler_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_subcritical_pointwise_euler_of_positive_representative
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (a : SmoothScalar (M := M)) (hpos : ∀ x, 0 < a.val x)
    (hrep : scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w =ᵐ[normalizedVolume g] a.val) :
    (∫ x, a.val x ^ p ∂normalizedVolume g) = 1 ∧
      ∀ e : FrameBundle g, -scalarLaplacian g a.val e + 2 * a.val e.base =
        2 * ‖w‖ ^ 2 * a.val e.base ^ (p - 1) := by
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  have heq := scalarWeightedH1_eq_smooth_of_Lp_representative g o d _ _ w a hrep
  have hnorm : (∫ x, a.val x ^ p ∂normalizedVolume g) = 1 := by
    have h := scalarLp_moment_eq_norm_rpow (by linarith : 0 < p) (T w)
    rw [hw, Real.one_rpow] at h
    rw [← h]
    apply integral_congr_ae
    filter_upwards [hrep] with x hx
    rw [hx, abs_of_pos (hpos x)]
  refine ⟨hnorm, ?_⟩
  let μ := canonicalFrameMeasure g o
  let F := smoothScalarPositivePower a hpos (p - 1)
  have hvalue (b : SmoothScalar (M := M)) :
      inner ℝ (smoothScalarValueL2 g μ a) (smoothScalarValueL2 g μ b) =
        ∫ x, a.val x * b.val x ∂normalizedVolume g := by
    rw [← scalarBasePullback_smooth g o a, ← scalarBasePullback_smooth g o b,
      (scalarBasePullback g o).inner_map_map, smoothScalarBaseL2_inner]
  have hsource (b : SmoothScalar (M := M)) :
      (∫ x, |T w x| ^ (p - 2) * T w x * b.val x ∂normalizedVolume g) =
        inner ℝ (smoothScalarValueL2 g μ F) (smoothScalarValueL2 g μ b) := by
    rw [← scalarBasePullback_smooth g o F, ← scalarBasePullback_smooth g o b,
      (scalarBasePullback g o).inner_map_map, smoothScalarBaseL2_inner]
    apply integral_congr_ae
    filter_upwards [hrep] with x hx
    change T w x = a.val x at hx
    rw [hx, abs_of_pos (hpos x)]
    change a.val x ^ (p - 2) * a.val x * b.val x = a.val x ^ (p - 1) * b.val x
    rw [show p - 1 = (p - 2) + 1 by ring, Real.rpow_add (hpos x), Real.rpow_one]
  let r := -(smoothScalarLaplacian g a) + (2 : ℝ) • a - (2 * ‖w‖ ^ 2) • F
  have hr : smoothScalarValueL2 g μ r = -smoothScalarLaplacianL2 (μ := μ) a +
      (2 : ℝ) • smoothScalarValueL2 g μ a -
      (2 * ‖w‖ ^ 2) • smoothScalarValueL2 g μ F := by
    dsimp only [r]
    rw [map_sub, map_add, map_neg, map_smul, map_smul, smoothScalarLaplacian_valueL2]
  have ht (b : SmoothScalar (M := M)) :
      inner ℝ (smoothScalarValueL2 g μ r) (smoothScalarValueL2 g μ b) = 0 := by
    have h := scalar_subcritical_minimum_weak_euler g o d hp hp4 w hw hmin b
    rw [hsource b] at h
    conv_lhs at h => rw [heq, smoothScalarToWeightedH1_inner g o d]
    have hgreen : smoothScalarDirichlet d a b =
        -(inner ℝ (smoothScalarLaplacianL2 (μ := μ) a) (smoothScalarValueL2 g μ b)) := by
      rw [smoothScalarDirichlet_symm, smoothScalarDirichlet_laplacian_pairing,
        real_inner_comm]
    rw [hgreen, ← hvalue b] at h
    rw [hr, inner_sub_left, inner_add_left, inner_neg_left,
      real_inner_smul_left, real_inner_smul_left]
    linarith
  have hz : smoothScalarValueL2 g μ r = 0 := inner_self_eq_zero.mp (ht r)
  have hrzero : r = 0 := smoothScalarValueL2_injective g o (by simpa only [map_zero] using hz)
  intro e
  have h := congrArg (fun b : SmoothScalar (M := M) => b.val e.base) hrzero
  change -scalarLaplacianBase g a.val e.base + 2 * a.val e.base -
    (2 * ‖w‖ ^ 2) * a.val e.base ^ (p - 1) = 0 at h
  rw [scalarLaplacian_eq_base]
  linarith

theorem scalar_subcritical_minimum_one_of_positive_representative [PreconnectedSpace M]
    (g : SmoothMetric M) (o : FrameOrientation g) (hRic : RicciThree g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : 0 < ‖w‖ ^ 2)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (a : SmoothScalar (M := M)) (hpos : ∀ x, 0 < a.val x)
    (hrep : scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w =ᵐ[normalizedVolume g] a.val) :
    ‖w‖ ^ 2 = 1 ∧ ∀ x, a.val x = 1 := by
  obtain ⟨hnorm, heuler⟩ := scalar_subcritical_pointwise_euler_of_positive_representative
    g o d hp hp4 w hw hmin a hpos hrep
  exact scalar_positive_normalized_euler_minimum_one g o hRic a hpos hp hp4 hm hnorm heuler

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth compact coefficients of the actual localized weak two-form
have L2 distributional derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
  (hKt : K ⊆ (chartAt FourSpace c).target) (χ : FourSpace → ℝ)
  (hχ : ContDiff ℝ ∞ χ) (hcχ : HasCompactSupport χ) (hs : tsupport χ ⊆ K)
  (u : TwoFormH1 o) (b : FourSpace → TwoFormFour) (hb : ContDiff ℝ ∞ b) (hcb : HasCompactSupport b)

theorem twoFormGramCoefficient_memSobolev_one :
    MemSobolev 1 2 (scalarComplexL2 (twoFormCoefficientPairL2 b hb.continuous hcb
      (twoFormGramVectorL2 c S hK hKt χ hχ hcχ hs u)) : 𝓢'(FourSpace, ℂ)) :=
  twoFormCoefficientPair_memSobolev_one b hb hcb _
    (fun r => twoFormGramVectorComponent_memSobolev_one c S hK hKt χ hχ hcχ hs u r)

theorem twoFormGramCoefficient_derivative (i : Fin 4) :
    ∃ D : Lp ℝ 2 (volume : Measure FourSpace),
      scalarCoordinateDerivative i (scalarComplexL2 (twoFormCoefficientPairL2 b hb.continuous hcb
        (twoFormGramVectorL2 c S hK hKt χ hχ hcχ hs u)) : 𝓢'(FourSpace, ℂ)) =
        (scalarComplexL2 D : 𝓢'(FourSpace, ℂ)) := by
  obtain ⟨D, hD, _⟩ := scalar_real_derivative_sobolev 0
    (twoFormCoefficientPairL2 b hb.continuous hcb (twoFormGramVectorL2 c S hK hKt χ hχ hcχ hs u))
    (by simpa only [Nat.cast_zero, zero_add] using
      twoFormGramCoefficient_memSobolev_one c S hK hKt χ hχ hcχ hs u b hb hcb) i
  exact ⟨D, hD⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Replacing the covariant flux by the ordinary principal flux leaves
an actual H1 correction with L2 divergence. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Matrix
open scoped BigOperators Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) {K : Set FourSpace}
  (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K)

def twoFormGramPartialVectorL2 (i : Fin 4) :
    TwoFormH1 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  twoFormAssembleL2 (fun r => twoFormGramPartialL2 c S hK hKt χ hχ hc hs (twoFormComponentIndex r) i)

def twoFormGramCorrectionVectorL2 (i : Fin 4) :
    TwoFormH1 o →L[ℝ] Lp TwoFormFour 2 (volume : Measure FourSpace) :=
  twoFormGramPartialVectorL2 c S hK hKt χ hχ hc hs i -
    twoFormGramNablaL2 c S hS hK hKt χ hχ hc hs i

theorem twoFormGramCorrectionVector_component (i : Fin 4) (u : TwoFormH1 o) (r : Fin 6) :
    twoFormVectorComponentL2 r (twoFormGramCorrectionVectorL2 c S hS hK hKt χ hχ hc hs i u) =
      twoFormGramDerivativeCorrection c S hS hK hKt χ hχ hc hs (twoFormComponentIndex r) i u := by
  change twoFormVectorComponentL2 r (twoFormGramPartialVectorL2 c S hK hKt χ hχ hc hs i u -
    twoFormGramNablaL2 c S hS hK hKt χ hχ hc hs i u) = _
  rw [map_sub]
  dsimp only [twoFormGramPartialVectorL2, twoFormGramNablaL2]
  rw [twoFormVectorComponentL2_assemble, twoFormVectorComponentL2_assemble]
  apply sub_eq_iff_eq_add.mpr
  exact (twoFormGramCovariant_add_correction c S hS hK hKt χ hχ hc hs
    (twoFormComponentIndex r) i u).symm.trans (add_comm _ _)

theorem twoFormGramCorrectionVector_component_H1 (i : Fin 4) (u : TwoFormH1 o) (r : Fin 6) :
    MemSobolev 1 2 (scalarComplexL2 (twoFormVectorComponentL2 r
      (twoFormGramCorrectionVectorL2 c S hS hK hKt χ hχ hc hs i u)) : 𝓢'(FourSpace, ℂ)) := by
  rw [twoFormGramCorrectionVector_component]
  exact twoFormGramDerivativeCorrection_memSobolev_one c S hS hK hKt χ hχ hc hs
    (twoFormComponentIndex r) i u

def twoFormPrincipalFlux (b : TwoFormFour) (u : TwoFormH1 o) (j : Fin 4) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  ∑ i : Fin 4, twoFormFluxPair (g := g) c χ hχ hc (hs.trans hKt) b i j
    (twoFormGramPartialVectorL2 c S hK hKt χ hχ hc hs i u)

def twoFormFluxCorrection (b : TwoFormFour) (u : TwoFormH1 o) (j : Fin 4) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  ∑ i : Fin 4, twoFormFluxPair (g := g) c χ hχ hc (hs.trans hKt) b i j
    (twoFormGramCorrectionVectorL2 c S hS hK hKt χ hχ hc hs i u)

theorem twoFormPrincipalFlux_eq (b : TwoFormFour) (u : TwoFormH1 o) (j : Fin 4) :
    twoFormDivergenceFlux (g := g) c χ hχ hc (hs.trans hKt) b
      (fun i => twoFormGramNablaL2 c S hS hK hKt χ hχ hc hs i u) j +
      twoFormFluxCorrection c S hS hK hKt χ hχ hc hs b u j =
    twoFormPrincipalFlux c S hK hKt χ hχ hc hs b u j := by
  change (∑ i : Fin 4, _) + (∑ i : Fin 4, _) = ∑ i : Fin 4, _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  change _ + twoFormFluxPair (g := g) c χ hχ hc (hs.trans hKt) b i j
    (twoFormGramPartialVectorL2 c S hK hKt χ hχ hc hs i u -
      twoFormGramNablaL2 c S hS hK hKt χ hχ hc hs i u) = _
  rw [map_sub]
  abel

theorem twoFormFluxCorrection_memSobolev_one (b : TwoFormFour) (u : TwoFormH1 o) (j : Fin 4) :
    MemSobolev 1 2 (scalarComplexL2
      (twoFormFluxCorrection c S hS hK hKt χ hχ hc hs b u j) : 𝓢'(FourSpace, ℂ)) := by
  apply scalarReal_memSobolev_sum
  intro i _
  exact twoFormCoefficientPair_memSobolev_one (twoFormFluxCoefficient (g := g) c χ b i j)
    (twoFormFluxCoefficient_smooth (g := g) c χ hχ (hs.trans hKt) b i j)
    hc.mul_right.smul_right _
    (twoFormGramCorrectionVector_component_H1 c S hS hK hKt χ hχ hc hs i u)

theorem twoFormFluxCorrection_derivatives (b : TwoFormFour) (u : TwoFormH1 o) :
    ∃ D : Fin 4 → Lp ℝ 2 (volume : Measure FourSpace), ∀ j,
      scalarCoordinateDerivative j (scalarComplexL2
        (twoFormFluxCorrection c S hS hK hKt χ hχ hc hs b u j) : 𝓢'(FourSpace, ℂ)) =
        (scalarComplexL2 (D j) : 𝓢'(FourSpace, ℂ)) := by
  have he (j : Fin 4) : ∃ D : Lp ℝ 2 (volume : Measure FourSpace),
      scalarCoordinateDerivative j (scalarComplexL2
        (twoFormFluxCorrection c S hS hK hKt χ hχ hc hs b u j) : 𝓢'(FourSpace, ℂ)) =
        (scalarComplexL2 D : 𝓢'(FourSpace, ℂ)) := by
    obtain ⟨D, hD, _⟩ := scalar_real_derivative_sobolev 0 _
      (by simpa only [Nat.cast_zero, zero_add] using
        twoFormFluxCorrection_memSobolev_one c S hS hK hKt χ hχ hc hs b u j) j
    exact ⟨D, hD⟩
  choose D hD using he
  exact ⟨D, hD⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual Rellich compactness for intrinsic two-forms on a closed manifold.
Finite chart localization reduces the inclusion to the scalar Euclidean
Rellich theorem; the partition estimate controls the intrinsic L2 norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormH1ToL2_compact : IsCompactOperator (twoFormH1ToL2 (o := o)) := by
  obtain ⟨P⟩ := scalarPartition_exists (M := M)
  obtain ⟨C, hC, hb⟩ := twoFormH1_partition_bound (o := o) P
  let J := P.ι × (Fin 2 → Fin 4)
  let R : J → TwoFormH1 o →L[ℝ] Lp ℝ 2 (normalizedVolume g) := fun j =>
    twoFormReconstructedValue (P.center j.1) (scalarPartitionFunction P j.1)
      (scalarPartitionFunction_support P j.1) j.2
  let Q := ContinuousLinearMap.pi R
  have hQ : IsCompactOperator Q := compact_finite_pi R (fun j =>
    twoFormReconstructedValue_compact (P.center j.1) (scalarPartitionFunction P j.1)
      (scalarPartitionFunction_support P j.1) j.2)
  let D : ℝ := (∑ i : P.ι, C i) * Fintype.card (Fin 2 → Fin 4)
  have hD : 0 ≤ D := mul_nonneg (Finset.sum_nonneg (fun i _ => hC i)) (Nat.cast_nonneg _)
  apply compact_of_norm_domination twoFormH1ToL2 Q hQ D hD
  intro u
  apply (hb u).trans
  calc
    _ ≤ ∑ i : P.ι, C i * ((Fintype.card (Fin 2 → Fin 4) : ℝ) * ‖Q u‖) := by
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_left _ (hC i)
      calc
        _ ≤ ∑ a : Fin 2 → Fin 4, ‖Q u‖ := by
          apply Finset.sum_le_sum
          intro a _
          exact norm_le_pi_norm (Q u) (i, a)
        _ = _ := by simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    _ = D * ‖Q u‖ := by rw [← Finset.sum_mul]; dsimp [D]; ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact component test coefficients on the region where a localization
cutoff is one. The cutoff introduces no term in the tested equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

variable (c : M) (S : Mat4) (χ ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ)
  (hon : ∀ z ∈ tsupport ψ, χ z = 1) (b : TwoFormFour)

include hon in
theorem twoFormMassTest_separated (z : FourSpace) :
    twoFormMassTest (g := g) c (fun w => ψ w • b) z =
      ψ z • twoFormMassCoefficient (g := g) c χ b z := by
  have he : ψ z * χ z = ψ z := by
    by_cases hz : z ∈ tsupport ψ
    · rw [hon z hz, mul_one]
    · rw [image_eq_zero_of_notMem_tsupport hz, zero_mul]
  simp only [twoFormMassTest, twoFormMassCoefficient, smul_smul]
  congr 1
  calc
    _ = (ψ z * χ z) * chartVolumeDensity g c z := by rw [he]; ring
    _ = _ := by ring

include hon hψ in
theorem twoFormEnergyTest_separated (i : Fin 4) (z : FourSpace) :
    twoFormEnergyTest (g := g) c S (fun w => ψ w • b) i z =
      (∑ j : Fin 4, partialDeriv ψ j z • twoFormFluxCoefficient (g := g) c χ b i j z) +
        ψ z • (χ z • twoFormWeightedConnection (g := g) c S b i z) := by
  have hval : ψ z * χ z = ψ z := by
    by_cases hz : z ∈ tsupport ψ
    · rw [hon z hz, mul_one]
    · rw [image_eq_zero_of_notMem_tsupport hz, zero_mul]
  have hder (j : Fin 4) : χ z * partialDeriv ψ j z = partialDeriv ψ j z := by
    by_cases hz : z ∈ tsupport ψ
    · rw [hon z hz, one_mul]
    · have hd : partialDeriv ψ j z = 0 := image_eq_zero_of_notMem_tsupport
        (fun h => hz ((tsupport_fderiv_apply_subset ℝ (coordinateVector j)) h))
      rw [hd, mul_zero]
  rw [twoFormEnergyTest_smul_const c S ψ hψ b i z]
  apply congrArg₂ (· + ·)
  · apply Finset.sum_congr rfl
    intro j _
    simp only [twoFormFluxCoefficient, smul_smul]
    congr 1
    calc
      _ = (chartVolumeDensity g c z * (metricInChart g c z)⁻¹ i j) *
          (χ z * partialDeriv ψ j z) := by rw [hder j]
      _ = _ := by ring
  · rw [smul_smul, hval]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Integration by parts at the finite regularity of the compact heat
parametrix. Only the coefficients near the actual compact support matter. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped ContDiff _root_.Topology

noncomputable section

theorem fourHeat_local_product_integrable (f q : FourSpace → ℝ)
    (hq : Continuous q) (hc : HasCompactSupport q)
    (hf : ∀ x ∈ tsupport q, ContinuousAt f x) :
    Integrable (fun x => f x * q x) := by
  have hs : tsupport (fun x => f x * q x) ⊆ tsupport q := tsupport_mul_subset_right
  have hp : Continuous (fun x => f x * q x) := by
    apply continuous_of_tsupport
    intro x hx
    exact (hf x (hs hx)).mul hq.continuousAt
  exact hp.integrable_of_hasCompactSupport hc.mul_left

theorem fourHeat_local_integration_by_parts (f u : FourSpace → ℝ)
    (hu : ContDiff ℝ 1 u) (hc : HasCompactSupport u)
    (hf : ∀ x ∈ tsupport u, ContDiffAt ℝ 1 f x) (i : Fin 4) :
    (∫ x, f x * partialDeriv u i x) = -(∫ x, partialDeriv f i x * u x) := by
  have hDu : ContDiff ℝ 0 (partialDeriv u i) :=
    (hu.fderiv_right (m := 0) (by norm_num)).clm_apply contDiff_const
  have hs : tsupport (partialDeriv u i) ⊆ tsupport u :=
    tsupport_fderiv_apply_subset ℝ (coordinateVector i)
  have hcD : HasCompactSupport (partialDeriv u i) :=
    hc.of_isClosed_subset (isClosed_tsupport _) hs
  have hDf : Integrable (fun x => partialDeriv f i x * u x) := by
    apply fourHeat_local_product_integrable _ u hu.continuous hc
    intro x hx
    exact (((hf x hx).fderiv_right (m := 0) (by norm_num)).clm_apply
      contDiffAt_const).continuousAt
  have hfD : Integrable (fun x => f x * partialDeriv u i x) :=
    fourHeat_local_product_integrable f _ hDu.continuous hcD
      (fun x hx => (hf x (hs hx)).continuousAt)
  have hfu : Integrable (fun x => f x * u x) :=
    fourHeat_local_product_integrable f u hu.continuous hc
      (fun x hx => (hf x hx).continuousAt)
  exact integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable hDf hfD hfu
    (fun x hx => (hf x hx).differentiableAt one_ne_zero)
    (fun x _ => hu.differentiable one_ne_zero x)

theorem fourHeat_local_second_integration (f u : FourSpace → ℝ)
    (hu : ContDiff ℝ 2 u) (hc : HasCompactSupport u)
    (hf : ∀ x ∈ tsupport u, ContDiffAt ℝ 2 f x) (i j : Fin 4) :
    (∫ x, f x * partialDeriv (partialDeriv u i) j x) =
      ∫ x, partialDeriv (partialDeriv f j) i x * u x := by
  have hDu : ContDiff ℝ 1 (partialDeriv u i) :=
    (hu.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const
  have hs : tsupport (partialDeriv u i) ⊆ tsupport u :=
    tsupport_fderiv_apply_subset ℝ (coordinateVector i)
  have hcD : HasCompactSupport (partialDeriv u i) :=
    hc.of_isClosed_subset (isClosed_tsupport _) hs
  rw [fourHeat_local_integration_by_parts f _ hDu hcD
    (fun x hx => (hf x (hs hx)).of_le (by norm_num)) j]
  rw [fourHeat_local_integration_by_parts (partialDeriv f j) u
    (hu.of_le (by norm_num)) hc (fun x hx =>
      ((hf x hx).fderiv_right (m := 1) (by norm_num)).clm_apply contDiffAt_const) i]
  simp only [neg_neg]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The finite third-order scalar heat ansatz and its exact differential
identities. The coefficients here are actual scalar functions. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

def fourHeatPolynomial (u : Fin 4 → FourSpace → ℝ) (t : ℝ) (x : FourSpace) : ℝ :=
  u 0 x + t * u 1 x + t ^ 2 * u 2 x + t ^ 3 * u 3 x

theorem fourHeatPolynomial_contDiff (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ i, ContDiff ℝ 2 (u i)) (t : ℝ) : ContDiff ℝ 2 (fourHeatPolynomial u t) :=
  (((hu 0).add (contDiff_const.mul (hu 1))).add
    (contDiff_const.mul (hu 2))).add (contDiff_const.mul (hu 3))

theorem fourHeatPolynomial_hasDerivAt (u : Fin 4 → FourSpace → ℝ) (t : ℝ)
    (x : FourSpace) : HasDerivAt (fun s => fourHeatPolynomial u s x)
      (u 1 x + 2 * t * u 2 x + 3 * t ^ 2 * u 3 x) t := by
  have h := (((hasDerivAt_const t (u 0 x)).add ((hasDerivAt_id t).mul_const (u 1 x))).add
    (((hasDerivAt_id t).pow 2).mul_const (u 2 x))).add
      (((hasDerivAt_id t).pow 3).mul_const (u 3 x))
  convert h using 1
  · rfl
  · norm_num

theorem fourHeatPolynomial_operator (a : Mat4) (b : Fin 4 → ℝ) (c : ℝ)
    (u : Fin 4 → FourSpace → ℝ) (hu : ∀ i, ContDiff ℝ 2 (u i)) (t : ℝ) (x : FourSpace) :
    fourHeatLocalOperator a b c (fourHeatPolynomial u t) x =
      fourHeatLocalOperator a b c (u 0) x + t * fourHeatLocalOperator a b c (u 1) x +
        t ^ 2 * fourHeatLocalOperator a b c (u 2) x +
        t ^ 3 * fourHeatLocalOperator a b c (u 3) x := by
  have h0 := hu 0
  have h1 := hu 1
  have h2 := hu 2
  have h3 := hu 3
  unfold fourHeatPolynomial
  rw [fourHeatLocalOperator_add a b c _ _ (by fun_prop) (by fun_prop),
    fourHeatLocalOperator_add a b c _ _ (by fun_prop) (by fun_prop),
    fourHeatLocalOperator_add a b c _ _ h0 (by fun_prop)]
  simp only [fourHeatLocalOperator_const_mul]

theorem fourHeatPolynomial_transport (a : Mat4) (b : Fin 4 → ℝ)
    (u : Fin 4 → FourSpace → ℝ) (hu : ∀ i, ContDiff ℝ 2 (u i)) (t : ℝ) (x : FourSpace) :
    fourHeatRadialTransport a b (fourHeatPolynomial u t) x =
      fourHeatRadialTransport a b (u 0) x + t * fourHeatRadialTransport a b (u 1) x +
        t ^ 2 * fourHeatRadialTransport a b (u 2) x +
        t ^ 3 * fourHeatRadialTransport a b (u 3) x := by
  have h0 : Differentiable ℝ (u 0) := (hu 0).differentiable (by norm_num)
  have h1 : Differentiable ℝ (u 1) := (hu 1).differentiable (by norm_num)
  have h2 : Differentiable ℝ (u 2) := (hu 2).differentiable (by norm_num)
  have h3 : Differentiable ℝ (u 3) := (hu 3).differentiable (by norm_num)
  unfold fourHeatPolynomial
  rw [fourHeatRadialTransport_add a b _ _ (by fun_prop) (by fun_prop),
    fourHeatRadialTransport_add a b _ _ (by fun_prop) (by fun_prop),
    fourHeatRadialTransport_add a b _ _ h0 (by fun_prop)]
  simp only [fourHeatRadialTransport_const_mul]

theorem fourHeatPolynomial_gaussian_residual (a : Mat4) (b : Fin 4 → ℝ) (c : ℝ)
    (u : Fin 4 → FourSpace → ℝ) (hu : ∀ i, ContDiff ℝ 2 (u i))
    (t : ℝ) (ht : 0 < t) (x : FourSpace)
    (hE : fourHeatEikonalDefect a x = 0)
    (h0 : fourHeatRadialTransport a b (u 0) x = 0)
    (h1 : fourHeatRadialTransport a b (u 1) x + u 1 x =
      -fourHeatLocalOperator a b c (u 0) x)
    (h2 : fourHeatRadialTransport a b (u 2) x + 2 * u 2 x =
      -fourHeatLocalOperator a b c (u 1) x)
    (h3 : fourHeatRadialTransport a b (u 3) x + 3 * u 3 x =
      -fourHeatLocalOperator a b c (u 2) x) :
    deriv (fun s => fourHeatGaussian s x * fourHeatPolynomial u s x) t +
      fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * fourHeatPolynomial u t y) x =
      fourHeatGaussian t x * t ^ 3 * fourHeatLocalOperator a b c (u 3) x := by
  have hd := (fourHeatGaussian_hasDerivAt_time t ht x).mul
    (fourHeatPolynomial_hasDerivAt u t x)
  change HasDerivAt (fun s => fourHeatGaussian s x * fourHeatPolynomial u s x) _ t at hd
  have hr := fourHeatLocalOperator_transport_residual_at a b c t ht
    (fourHeatPolynomial u t) x (fourHeatPolynomial_contDiff u hu t).contDiffAt
  rw [(fourHeatGaussian_amplitude_time t ht (fourHeatPolynomial u t) x).deriv,
    hE, zero_div, zero_mul, add_zero] at hr
  rw [fourHeatPolynomial_operator a b c u hu t x,
    fourHeatPolynomial_transport a b u hu t x, h0] at hr
  have h1' : fourHeatRadialTransport a b (u 1) x =
      -fourHeatLocalOperator a b c (u 0) x - u 1 x := by linarith only [h1]
  have h2' : fourHeatRadialTransport a b (u 2) x =
      -fourHeatLocalOperator a b c (u 1) x - 2 * u 2 x := by linarith only [h2]
  have h3' : fourHeatRadialTransport a b (u 3) x =
      -fourHeatLocalOperator a b c (u 2) x - 3 * u 3 x := by linarith only [h3]
  rw [h1', h2', h3'] at hr
  rw [hd.deriv]
  calc
    _ = fourHeatGaussian t x * (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) *
          fourHeatPolynomial u t x +
        fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * fourHeatPolynomial u t y) x +
        fourHeatGaussian t x * (u 1 x + 2 * t * u 2 x + 3 * t ^ 2 * u 3 x) := by ring
    _ = _ := by rw [hr]; field_simp [ht.ne']; ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Radial integration preserves finite differentiability. This avoids
spending an extra derivative at every transport step in the bundle heat
construction. Only the two derivatives in the local operator are lost. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped ContDiff

noncomputable section

theorem fourHeatRadialAverage_preserves_contDiff (n : ℕ) :
    ∀ (m : ℕ) (f : FourSpace → ℝ), ContDiff ℝ n f →
      ContDiff ℝ n (fourHeatRadialAverage m f) := by
  induction n with
  | zero =>
    intro m f hf
    apply contDiff_zero.mpr
    have hc : Continuous (Function.uncurry (fun x : FourSpace => fun s : ℝ =>
        s ^ m * f (s • x))) :=
      (continuous_snd.pow m).mul (hf.continuous.comp (continuous_snd.smul continuous_fst))
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hc 0 1
  | succ n ih =>
    intro m f hf
    have hf1 : ContDiff ℝ 1 f := hf.of_le (by exact_mod_cast Nat.le_add_left 1 n)
    have hp (i : Fin 4) : ContDiff ℝ n (partialDeriv f i) :=
      fourHeat_partial_contDiff n f hf i
    let D : FourSpace → FourSpace →L[ℝ] ℝ := fun x =>
      ∑ i : Fin 4, fourHeatRadialAverage (m + 1) (partialDeriv f i) x •
        PiLp.proj 2 (fun _ : Fin 4 => ℝ) i
    have hD : ContDiff ℝ n D := by
      apply ContDiff.sum
      intro i _
      exact (ih (m + 1) (partialDeriv f i) (hp i)).smul contDiff_const
    apply contDiff_succ_iff_hasFDerivAt.mpr
    refine ⟨D, hD, ?_⟩
    intro x
    have h := (fourHeatRadialAverage_hasFDerivAt m f hf1 x).differentiableAt.hasFDerivAt
    rwa [fourHeatRadialAverage_fderiv m f hf1 x] at h

theorem fourHeatWeightedRadialAverage_preserves_contDiff (n m : ℕ) (U F : FourSpace → ℝ)
    (hU : ContDiff ℝ n U) (hF : ContDiff ℝ n F) (hU0 : ∀ x, U x ≠ 0) :
    ContDiff ℝ n (fourHeatWeightedRadialAverage m U F) :=
  hU.mul (fourHeatRadialAverage_preserves_contDiff n m _ (hF.div hU hU0))

theorem fourHeatCoefficient_contDiff_two_derivatives (m : ℕ) : ∀ (n : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ) (c U : FourSpace → ℝ),
    (∀ i j, ContDiff ℝ (n + 2 * m : ℕ) (fun x => a x i j)) →
    (∀ i, ContDiff ℝ (n + 2 * m : ℕ) (fun x => b x i)) →
    ContDiff ℝ (n + 2 * m : ℕ) c → ContDiff ℝ (n + 2 * m : ℕ) U →
    (∀ x, U x ≠ 0) → ContDiff ℝ n (fourHeatCoefficient a b c U m) := by
  induction m with
  | zero =>
    intro n a b c U ha hb hc hU hU0
    simpa only [fourHeatCoefficient, mul_zero, add_zero] using hU
  | succ m ih =>
    intro n a b c U ha hb hc hU hU0
    have he : n + 2 * (m + 1) = (n + 2) + 2 * m := by omega
    have hreg : ContDiff ℝ (n + 2 : ℕ) (fourHeatCoefficient a b c U m) :=
      ih (n + 2) a b c U (fun i j => he ▸ ha i j) (fun i => he ▸ hb i)
        (he ▸ hc) (he ▸ hU) hU0
    have hle : (n : ℕ∞ω) ≤ (n + 2 * (m + 1) : ℕ) := by
      exact_mod_cast (show n ≤ n + 2 * (m + 1) by omega)
    apply fourHeatWeightedRadialAverage_preserves_contDiff n m U _ (hU.of_le hle) _ hU0
    exact (fourHeatLocalOperator_contDiff n a b c _
      (fun i j => (ha i j).of_le hle) (fun i => (hb i).of_le hle) (hc.of_le hle) hreg).neg

end
end PositiveEinsteinFour.Geometry
end


section

/-! A uniform jet bound for coefficients constructed from the actual
metric, exponential maps and radial parallel frames. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem exists_heatActualFamilyBound (g : SmoothMetric M) (o : FrameOrientation g)
    (c : M) (e : FrameBundle g) (he : e.base ∈ (chartAt FourSpace c).source) :
    ∃ F : HeatRadialFrameFlow g c (frameCoordinateState g c e),
      ∃ t > (0 : ℝ), t ∈ Ioo (-F.time) F.time ∧ ∃ r > (0 : ℝ), ∃ C ≥ (0 : ℝ),
        (∀ a : HeatFamilyCoefficientIndex, ∀ k : ℕ, k ≤ 10 →
          ∀ z ∈ closedBall (0, frameCoordinateState g c e) r,
            ‖iteratedFDeriv ℝ k (heatFamilyCoefficient g c (heatRadialFrameFamily F t) a) z‖ ≤ C) ∧
        ∀ e' : FrameBundle g, e'.base ∈ (chartAt FourSpace c).source →
          frameCoordinateState g c e' ∈ ball (frameCoordinateState g c e) r →
          (fun v => (heatRadialFrameFamily F t (v, frameCoordinateState g c e')).1)
            =ᶠ[𝓝 0] (fun v => chartAt FourSpace c (frameExponential g o e' v)) := by
  obtain ⟨F, t, ht, htI, R, hR, hreg, hbase⟩ := exists_heatRadialNormalFamily g o c e he
  let p := frameCoordinateState g c e
  let P := heatRadialFrameFamily F t
  obtain ⟨hP, hc, _⟩ := hreg (0, p) (mem_ball_self hR)
  obtain ⟨hzero, hexp⟩ := hbase e he (mem_ball_self hR)
  have hf : (P (0, p)).2.det ≠ 0 := by
    rw [show P (0, p) = p from hzero]
    intro hz
    have hh := congrArg Matrix.det (frameChartMatrix_normalizes g c e he)
    simp only [Matrix.det_mul, Matrix.det_one] at hh
    change p.2ᵀ.det * (metricInChart g c p.1).det * p.2.det = 1 at hh
    rw [Matrix.det_transpose, hz] at hh
    norm_num at hh
  have hm : heatFamilyMetric g c P (0, p) = 1 := by
    have hh := (heatFamilyMetric_exponential_germ g o c e he P
      (hP.of_le (by norm_num)) hexp).self_of_nhds
    exact hh.trans (heatNormalMetric_zero g o e)
  have hmp : 0 < (heatFamilyMetric g c P (0, p)).det := by rw [hm, Matrix.det_one]; norm_num
  obtain ⟨r, hr, C, hC, hb⟩ := heatFamilyCoefficient_local_bound g c P (0, p) hP hc hf hmp
  let ρ := min r R
  have hρ : 0 < ρ := lt_min hr hR
  refine ⟨F, t, ht, htI, ρ, hρ, C, hC, ?_, ?_⟩
  · intro a k hk z hz
    exact hb a k hk z (closedBall_subset_closedBall (min_le_left _ _) hz)
  · intro e' he' hclose
    exact (hbase e' he' (ball_subset_ball (min_le_right _ _) hclose)).2

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact spatial slices of the lower order family coefficients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem fourHeatDensityDrift_germ {a a' : FourSpace → Mat4} {J J' : FourSpace → ℝ}
    {x : FourSpace} (ha : a =ᶠ[𝓝 x] a') (hJ : J =ᶠ[𝓝 x] J') :
    fourHeatDensityDrift a J x = fourHeatDensityDrift a' J' x := by
  have hpartial (i j : Fin 4) : partialDeriv (fun y => a y i j) i x =
      partialDeriv (fun y => a' y i j) i x :=
    fourHeat_partial_germ (ha.mono fun y hy => congrArg (fun A : Mat4 => A i j) hy) i
  funext j
  simp only [fourHeatDensityDrift, hpartial, fourHeat_partial_germ hJ,
    ha.self_of_nhds, hJ.self_of_nhds]

theorem fourHeatConnectionZero_germ (a : Mat4) (b : Fin 4 → ℝ)
    {A A' : Fin 4 → FourSpace → HeatMat6} (V : HeatMat6) {x : FourSpace}
    (hA : ∀ i, A i =ᶠ[𝓝 x] A' i) :
    fourHeatConnectionZero a b A V x = fourHeatConnectionZero a b A' V x := by
  have hv (i : Fin 4) : A i x = A' i x := (hA i).self_of_nhds
  have hd (i j : Fin 4) (k l : Fin 6) :
      partialDeriv (fun y => A i y k l) j x = partialDeriv (fun y => A' i y k l) j x :=
    fourHeat_partial_germ ((hA i).mono fun y hy => congrArg (fun B : HeatMat6 => B k l) hy) j
  simp only [fourHeatConnectionZero, hv, hd]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem heatFamilyFirst_slice (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : DifferentiableAt ℝ P z) :
    heatFamilyFirst g c P z = fun i => fourHeatConnectionFirst
      (heatFamilyMetric g c P z)⁻¹
      (fun j => heatTwoFormConnection g c (fun x => P (x, z.2)) j z.1) i := by
  funext i
  simp only [heatFamilyFirst, heatFamilyTwoFormConnection_slice g c P z hP]

theorem heatFamilyZero_slice (g : SmoothMetric M) (c : M)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace) (z : HeatRadialFrameSpace)
    (hP : ContDiffAt ℝ 2 P z) (hz : (P z).1 ∈ (chartAt FourSpace c).target)
    (hframe : (P z).2.det ≠ 0) (hmetric : 0 < (heatFamilyMetric g c P z).det) :
    heatFamilyZero g c P z = fourHeatConnectionZero
      (heatFamilyMetric g c P z)⁻¹
      (fourHeatDensityDrift (fun x => (heatFamilyMetric g c P (x, z.2))⁻¹)
        (fun x => heatFamilyDensity g c P (x, z.2)) z.1)
      (heatTwoFormConnection g c (fun x => P (x, z.2)))
      (heatNormalPotential g c (fun x => P (x, z.2)) z.1) z.1 := by
  have hp := hP.differentiableAt (by norm_num)
  have hA (i : Fin 4) (k l : Fin 6) :
      DifferentiableAt ℝ (fun y => heatFamilyTwoFormConnection g c P i y k l) z :=
    (heatFamilyTwoFormConnection_contDiffAt 1 g c P z hP hz hframe i k l).differentiableAt one_ne_zero
  have he (i : Fin 4) (k l : Fin 6) :
      (fun x => heatFamilyTwoFormConnection g c P i (x, z.2) k l) =ᶠ[𝓝 z.1]
        (fun x => heatTwoFormConnection g c (fun y => P (y, z.2)) i x k l) := by
    have hi : Tendsto (fun x : FourSpace => (x, z.2)) (𝓝 z.1) (𝓝 z) :=
      continuousAt_id.prodMk continuousAt_const
    filter_upwards [hi.eventually (hP.eventually (by simp))] with x hx
    exact congrArg (fun A : HeatMat6 => A k l)
      (heatFamilyTwoFormConnection_slice g c P (x, z.2) (hx.differentiableAt (by norm_num)) i)
  have hD (i j : Fin 4) (k l : Fin 6) :
      heatFamilyScalarPartial (fun y => heatFamilyTwoFormConnection g c P i y k l) j z =
        partialDeriv (fun y => heatTwoFormConnection g c (fun x => P (x, z.2)) i y k l) j z.1 := by
    rw [heatFamilyScalarPartial_slice _ z (hA i k l) j]
    exact fourHeat_partial_germ (he i k l) j
  have hb : heatFamilyDrift g c P z =
      fourHeatDensityDrift (fun x => (heatFamilyMetric g c P (x, z.2))⁻¹)
        (fun x => heatFamilyDensity g c P (x, z.2)) z.1 := by
    funext j
    exact heatFamilyDrift_slice g c P z hP hz hmetric j
  have hV : heatFamilyPotential g c P z =
      heatNormalPotential g c (fun x => P (x, z.2)) z.1 := rfl
  simp only [heatFamilyZero, fourHeatConnectionZero, hb, hV,
    heatFamilyTwoFormConnection_slice g c P z hp, hD]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Joint finite smooth extensions for the normal coefficient family.
The leading amplitude remains strictly positive away from the chart. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heatFamilyCutoff_contDiff (n : ℕ) (χ f : HeatRadialFrameSpace → ℝ)
    (hχ : ContDiff ℝ n χ) (hf : ∀ z ∈ tsupport χ, ContDiffAt ℝ n f z) :
    ContDiff ℝ n (fun z => χ z * f z) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ tsupport χ
  · exact hχ.contDiffAt.mul (hf z hz)
  · have he : (fun y => χ y * f y) =ᶠ[𝓝 z] (fun _ => 0) := by
      filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hz] with y hy
      simp only [hy, Pi.zero_apply, zero_mul]
    exact contDiffAt_const.congr_of_eventuallyEq he

private def heatFamilyBump (z₀ : HeatRadialFrameSpace) (r : ℝ) (hr : 0 < r) :
    ContDiffBump z₀ where
  rIn := r / 4
  rOut := r / 2
  rIn_pos := by positivity
  rIn_lt_rOut := by linarith

theorem heatFamily_scalar_extension (n : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (z₀ : HeatRadialFrameSpace) (hf : ContDiffAt ℝ n f z₀) :
    ∃ F : HeatRadialFrameSpace → ℝ, ContDiff ℝ n F ∧ HasCompactSupport F ∧
      F =ᶠ[𝓝 z₀] f := by
  obtain ⟨r, hr, hreg⟩ := Metric.eventually_nhds_iff.mp (hf.eventually (by simp))
  let χ := heatFamilyBump z₀ r hr
  have hs : tsupport χ ⊆ ball z₀ r := by
    calc
      tsupport χ = closedBall z₀ (r / 2) := χ.tsupport_eq
      _ ⊆ ball z₀ r := closedBall_subset_ball (by linarith)
  refine ⟨fun z => χ z * f z,
    heatFamilyCutoff_contDiff n χ f χ.contDiff (fun z hz => hreg (hs hz)),
    χ.hasCompactSupport.mul_right, ?_⟩
  filter_upwards [χ.eventuallyEq_one] with z hz
  simp only [hz, Pi.one_apply, one_mul]

theorem heatFamily_positive_extension (n : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (z₀ : HeatRadialFrameSpace) (hf : ContDiffAt ℝ n f z₀) (hpos : 0 < f z₀) :
    ∃ F : HeatRadialFrameSpace → ℝ, ContDiff ℝ n F ∧ (∀ z, 0 < F z) ∧
      F =ᶠ[𝓝 z₀] f := by
  have hp : ∀ᶠ z in 𝓝 z₀, 0 < f z :=
    hf.continuousAt.preimage_mem_nhds (isOpen_Ioi.mem_nhds hpos)
  obtain ⟨r, hr, hreg⟩ := Metric.eventually_nhds_iff.mp ((hf.eventually (by simp)).and hp)
  let χ := heatFamilyBump z₀ r hr
  have hs : tsupport χ ⊆ ball z₀ r := by
    calc
      tsupport χ = closedBall z₀ (r / 2) := χ.tsupport_eq
      _ ⊆ ball z₀ r := closedBall_subset_ball (by linarith)
  have hnear (z : HeatRadialFrameSpace) (hz : z ∈ tsupport χ) :
      ContDiffAt ℝ n f z ∧ 0 < f z := hreg (hs hz)
  refine ⟨fun z => χ z * f z + (1 - χ z),
    (heatFamilyCutoff_contDiff n χ f χ.contDiff (fun z hz => (hnear z hz).1)).add
      (contDiff_const.sub χ.contDiff), ?_, ?_⟩
  · intro z
    by_cases hz : χ z = 0
    · simp [hz]
    · exact add_pos_of_pos_of_nonneg
        (mul_pos (lt_of_le_of_ne χ.nonneg (Ne.symm hz))
          (hnear z (subset_tsupport χ hz)).2) (sub_nonneg.mpr χ.le_one)
  · filter_upwards [χ.eventuallyEq_one] with z hz
    simp only [hz, Pi.one_apply, one_mul, sub_self, add_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual finite-regularity coefficients of the two-form operator in
normal coordinates and the radially parallel frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def heatNormalBundleFirst {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (i : Fin 4) : HeatMat6 :=
  fourHeatConnectionFirst (heatNormalMetric g o e x)⁻¹
    (fun j => heatTwoFormConnection g c D.point j x) i

def heatNormalBundleZero {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (x : FourSpace) : HeatMat6 :=
  fourHeatConnectionZero (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
    (heatTwoFormConnection g c D.point) (heatNormalPotential g c D.point x) x

theorem HeatNormalFrameData.bundleFirst_regular {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i : Fin 4) (k l : Fin 6) :
    ContDiffAt ℝ 11 (fun x => heatNormalBundleFirst D x i k l) 0 := by
  apply fourHeatConnectionFirst_contDiffAt
  · intro i j
    exact (heatNormalInverse_smoothAt_zero g o e i j).of_le (by simp)
  · exact D.twoForm_connection_regular

theorem HeatNormalFrameData.bundleZero_regular {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (k l : Fin 6) : ContDiffAt ℝ 10 (fun x => heatNormalBundleZero D x k l) 0 := by
  apply fourHeatConnectionZero_contDiffAt
  · intro i j
    exact (heatNormalInverse_smoothAt_zero g o e i j).of_le (by simp)
  · intro i
    exact (heatNormalDrift_smoothAt_zero g o e i).of_le (by simp)
  · exact D.twoForm_connection_regular
  · intro k l
    exact (D.potential_regular k l).of_le (by norm_num)

theorem HeatNormalFrameData.bundleFirst_radial {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (hRic : RicciThree g) (he : e ∈ o.positive) (x : FourSpace)
    (hx : x ∈ ball 0 D.radius) (hdet : (heatNormalMetric g o e x).det ≠ 0) :
    (∑ i : Fin 4, x i • heatNormalBundleFirst D x i) = 0 := by
  apply fourHeatConnectionFirst_radial
  · intro j
    have hrow := congrFun (heatNormalMetric_inverse_radial g o hRic e he x hdet) j
    have hs (i : Fin 4) : (heatNormalMetric g o e x)⁻¹ i j =
        (heatNormalMetric g o e x)⁻¹ j i :=
      congrFun (congrFun (heatNormalInverse_symm g o e x) j) i
    simpa only [Matrix.mulVec, dotProduct, hs] using hrow
  · exact D.twoForm_connection_radial x hx

theorem HeatNormalFrameData.bundleFirst_radial_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ k l : Fin 6,
      (∑ i : Fin 4, x i * heatNormalBundleFirst D x i k l) = 0 := by
  filter_upwards [ball_mem_nhds (0 : FourSpace) D.radius_pos,
    heatNormalMetric_eventually_nondegenerate g o e] with x hx hd
  intro k l
  have h := D.bundleFirst_radial hRic he x hx hd
  simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply]
    using congrArg (fun A : HeatMat6 => A k l) h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Four actual scalar heat coefficients for the normal metric. Their
transport equations hold for the geometric operator on a proved ball. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def heatNormalExtension (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) : HeatNormalExtension 12 g o e :=
  Classical.choice (exists_heatNormalExtension 12 g o e)

def heatNormalCoefficient (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (m : ℕ) : FourSpace → ℝ :=
  let D := heatNormalExtension g o e
  fourHeatCoefficient D.a D.b (fun _ => 0) D.U m

theorem heatNormalCoefficient_contDiff (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (m : ℕ) (hm : m ≤ 3) :
    ContDiff ℝ 3 (heatNormalCoefficient g o e m) := by
  let D := heatNormalExtension g o e
  have hle : ((3 + 3 * m : ℕ) : ℕ∞ω) ≤ 12 := by
    exact_mod_cast (show 3 + 3 * m ≤ 12 by omega)
  exact fourHeatCoefficient_contDiff m 3 D.a D.b (fun _ => 0) D.U
    (fun i j => (D.a_regular i j).of_le hle)
    (fun i => (D.b_regular i).of_le hle) contDiff_const (D.U_regular.of_le hle)
    (fun x => (D.U_pos x).ne')

theorem heatNormalCoefficient_leading (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) :
    heatNormalCoefficient g o e 0 =ᶠ[𝓝 0] heatNormalLeadingAmplitude g o e :=
  (heatNormalExtension g o e).U_near

theorem heatNormalCoefficient_zero_center (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) : heatNormalCoefficient g o e 0 0 = 1 := by
  rw [(heatNormalCoefficient_leading g o e).self_of_nhds,
    heatNormalLeadingAmplitude_zero]

theorem heatNormalCoefficient_transport (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      fourHeatEikonalDefect (heatNormalMetric g o e x)⁻¹ x = 0 ∧
      fourHeatRadialTransport (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
        (heatNormalCoefficient g o e 0) x = 0 ∧
      ∀ m ≤ 2, fourHeatRadialTransport (heatNormalMetric g o e x)⁻¹
        (heatNormalDrift g o e x) (heatNormalCoefficient g o e (m + 1)) x +
        (m + 1 : ℝ) * heatNormalCoefficient g o e (m + 1) x =
        -fourHeatLocalOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x) 0
          (heatNormalCoefficient g o e m) x := by
  let D := heatNormalExtension g o e
  obtain ⟨r₀, hr₀, hD⟩ := D.transport_neighborhood hRic he
  have hn : ∀ᶠ x in 𝓝 (0 : FourSpace), x ∈ ball 0 r₀ ∧
      D.a x = (heatNormalMetric g o e x)⁻¹ ∧ D.b x = heatNormalDrift g o e x := by
    filter_upwards [ball_mem_nhds (0 : FourSpace) hr₀, D.a_near, D.b_near] with x hx ha hb
    exact ⟨hx, ha, hb⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx
  obtain ⟨hx₀, ha, hb⟩ := hball hx
  obtain ⟨hrow, hcol, hE, hT⟩ := hD x hx₀
  refine ⟨by simpa only [ha] using hE, by simpa only [ha, hb] using! hT, ?_⟩
  intro m hm
  have h := fourHeatCoefficient_transport m D.a D.b (fun _ => 0) D.U x
    (D.U_regular.of_le (by norm_num)) (fun y => (D.U_pos y).ne')
    (fun i j => (D.a_regular i j).of_le (by norm_num))
    (fun i => (D.b_regular i).of_le (by norm_num)) contDiff_const
    (heatNormalCoefficient_contDiff g o e m (by omega)) hrow hcol hT
  simpa only [ha, hb] using! h

end
end PositiveEinsteinFour.Geometry
end


section

/-! The normal amplitude pairs with a test tensor by evaluating the test
in the same normal orthonormal frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped Matrix.Norms.Elementwise

noncomputable section

theorem heat_normal_frame_pairing (G E F : Mat4)
    (hE : Eᵀ * G * E = 1) (hF : Fᵀ * G * F = 1)
    (T U : CovariantCoordinates 2) :
    frameTensorPairing (frameTensor F (frameTensor E⁻¹ T)) (frameTensor F U) =
      frameTensorPairing T (frameTensor E U) := by
  have hd : E.det ≠ 0 := by
    intro hz
    have h := congrArg Matrix.det hE
    simp only [Matrix.det_mul, Matrix.det_transpose, hz, zero_mul, Matrix.det_one] at h
    norm_num at h
  have hi : E⁻¹ * E = 1 := Matrix.nonsing_inv_mul E (isUnit_iff_ne_zero.mpr hd)
  have hi' : E * E⁻¹ = 1 := Matrix.mul_nonsing_inv E (isUnit_iff_ne_zero.mpr hd)
  have ht : Eᵀ * E⁻¹ᵀ = 1 := by rw [← Matrix.transpose_mul, hi, Matrix.transpose_one]
  have hEE : E * Eᵀ = F * Fᵀ :=
    (heat_orthonormal_inverse G E hE).trans (heat_orthonormal_inverse G F hF).symm
  have hQ : (E⁻¹ * F) * (E⁻¹ * F)ᵀ = 1 := by
    rw [Matrix.transpose_mul]
    calc
      _ = E⁻¹ * (F * Fᵀ) * E⁻¹ᵀ := by simp only [Matrix.mul_assoc]
      _ = E⁻¹ * (E * Eᵀ) * E⁻¹ᵀ := by rw [← hEE]
      _ = (E⁻¹ * E) * (Eᵀ * E⁻¹ᵀ) := by simp only [Matrix.mul_assoc]
      _ = 1 := by rw [hi, ht, Matrix.one_mul]
  have hf : frameTensor F U = frameTensor (E⁻¹ * F) (frameTensor E U) := by
    rw [← frameTensor_mul, ← Matrix.mul_assoc, hi', Matrix.one_mul]
  rw [← frameTensor_mul, hf]
  exact frameTensor_pairing_orthogonal (E⁻¹ * F) hQ T (frameTensor E U)

end
end PositiveEinsteinFour.Geometry
end


