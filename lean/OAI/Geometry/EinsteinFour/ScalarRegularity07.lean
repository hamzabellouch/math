section

/-! A continuous representative of the actual nonnegative normalized subcritical
minimum is strictly positive, using its proved L2 weak equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff BigOperators NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [PreconnectedSpace M]

local instance continuousMinimum_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance continuousMinimum_probability (g : SmoothMetric M) : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_subcritical_minimum_positive_of_continuous
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (hn : ∀ᵐ x ∂normalizedVolume g,
      0 ≤ scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x)
    (f : M → ℝ) (hf : Continuous f)
    (hrep : scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w =ᵐ[normalizedVolume g] f) : ∀ x, 0 < f x := by
  let u := scalarWeightedH1ToH1 d w
  let T := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le)
  have hbase : scalarH1BaseValue g o d u =ᵐ[normalizedVolume g] f :=
    (scalarWeightedBaseLp_coe g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w).symm.trans hrep
  have hV : scalarH1Value d u =ᵐ[canonicalFrameMeasure g o] fun e => f e.base := by
    rw [← scalarH1BaseValue_spec g o d u]
    have hh := (canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae hbase
    filter_upwards [Lp.coeFn_compMeasurePreserving (scalarH1BaseValue g o d u)
      (canonicalFrameMeasure_base g o), hh] with e he hh
    exact he.trans hh
  have hnonneg : ∀ x, 0 ≤ f x := by
    have hb : ∀ᵐ x ∂normalizedVolume g, 0 ≤ f x := by
      filter_upwards [hn, hrep] with x hx he
      rwa [he] at hx
    exact scalar_continuous_base_nonneg_of_frame_ae g o f hf
      ((canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae hb)
  obtain ⟨F, hF, heq⟩ := scalar_minimum_L2_source g o d hp hp4 w hw hm hmin
  let Z := scalarBasePullback g o F
  let S := (2 : ℝ) • scalarH1Value d u - (2 * ‖w‖ ^ 2) • Z
  have hZ : Z =ᵐ[canonicalFrameMeasure g o]
      fun e => |f e.base| ^ (p - 2) * f e.base := by
    have hFb := (canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae hF
    have hrb := (canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae hrep
    filter_upwards [Lp.coeFn_compMeasurePreserving F (canonicalFrameMeasure_base g o),
      hFb, hrb] with e he hFe hre
    change Lp.compMeasurePreserving FrameBundle.base (canonicalFrameMeasure_base g o) F e = _
    rw [he]
    change F e.base = _
    rw [hFe, hre]
  have hsource : ∀ᵐ e ∂canonicalFrameMeasure g o, S e ≤ 2 * f e.base := by
    filter_upwards [Lp.coeFn_sub ((2 : ℝ) • scalarH1Value d u) ((2 * ‖w‖ ^ 2) • Z),
      Lp.coeFn_smul (2 : ℝ) (scalarH1Value d u), Lp.coeFn_smul (2 * ‖w‖ ^ 2) Z,
      hV, hZ] with e hs h₁ h₂ hv hz
    simp only [Pi.sub_apply] at hs
    simp only [Pi.smul_apply, smul_eq_mul] at h₁ h₂
    change ((2 : ℝ) • scalarH1Value d u - (2 * ‖w‖ ^ 2) • Z) e ≤ _
    rw [hs, h₁, h₂, hv, hz]
    exact sub_le_self _ (mul_nonneg (by positivity)
      (mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _) (hnonneg _)))
  have hne : ∃ x, 0 < f x := by
    by_contra hnot
    have hfzero : ∀ x, f x = 0 := fun x =>
      le_antisymm (le_of_not_gt (fun hx => hnot ⟨x, hx⟩)) (hnonneg x)
    have hTzero : T w = 0 := by
      apply Lp.ext
      filter_upwards [hrep, Lp.coeFn_zero ℝ (ENNReal.ofReal p) (normalizedVolume g)] with x hx hz
      exact hx.trans ((hfzero x).trans hz.symm)
    have hnorm : ‖T w‖ = 1 := hw
    rw [hTzero, norm_zero] at hnorm
    norm_num at hnorm
  exact scalarH1_continuous_strong_minimum g o d u S heq f hf hV
    hnonneg hsource hne

end
end PositiveEinsteinFour.Geometry
end


section

/-! Global smooth representatives of actual intrinsic weak scalar eigenfunctions, obtained from the proved local coordinate regularity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

local instance heatSmooth_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance heatSmooth_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarBaseHeat_smooth_representative (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (t : ℝ≥0) (ht : 0 < t) (input : Lp ℝ 2 (normalizedVolume g)) :
    ∃ F : SmoothScalar (M := M), scalarBaseHeat g o d t input = smoothScalarBaseL2 g F := by
  let b := scalarBaseHeat g o d t input
  have hlocal (x : M) : ∃ U : Set M, ∃ F : M → ℝ,
      IsOpen U ∧ x ∈ U ∧ ContMDiffOn I4 𝓘(ℝ, ℝ) ∞ F U ∧
        (b : M → ℝ) =ᵐ[(normalizedVolume g).restrict U] F := by
    let z₀ : ChartTarget x := ⟨chartAt FourSpace x x,
      (chartAt FourSpace x).map_source (mem_chart_source FourSpace x)⟩
    obtain ⟨U, hU, hxU, _, F, hF, he⟩ := scalarBaseHeat_local_chart_smooth g o d t ht input x z₀
    let W := (chartAt FourSpace x).source ∩ (chartAt FourSpace x) ⁻¹' U
    refine ⟨W, fun y => F (chartAt FourSpace x y),
      (chartAt FourSpace x).isOpen_inter_preimage hU, ⟨mem_chart_source FourSpace x, hxU⟩,
      ?_, scalar_chart_representative_ae g x U hU b F he⟩
    intro y hy
    have hFC : ContDiffAt ℝ (⊤ : ℕ∞) F (chartAt FourSpace x y) :=
      (hF _ hy.2).contDiffAt (hU.mem_nhds hy.2)
    exact (hFC.contMDiffAt.comp y
      (contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x) hy.1)).contMDiffWithinAt
  obtain ⟨F, hF⟩ := scalar_smooth_representative_of_local g b hlocal
  have hb : smoothScalarBaseL2 g F = b := by
    apply Lp.ext
    have hcoe := ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
      (⟨F.val, F.property.continuous⟩ : C(M, ℝ))
    filter_upwards [hcoe, hF] with x hx hFx
    exact hx.trans hFx
  exact ⟨F, hb.symm⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! All integer local regularity for the positive Euler equation. The initial
H2 gain is bootstrapped using the actual positive-power source and the local
elliptic estimate, on a fixed coordinate half ball. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)
local notation "D" => scalarSchwartzCoordinateDerivative
local notation "M" => smulLeftCLM ℂ

theorem scalar_local_positive_Euler_all_orders
    (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S) (δ : ℝ) (hδ : 0 ≤ δ)
    (ha : ∀ i j x, ‖a i j x‖ ≤ δ)
    (ha1 : ∀ i j k x, ‖D k (a i j) x‖ ≤ δ)
    (ha2 : ∀ i j k l x, ‖D k (D l (a i j)) x‖ ≤ δ)
    (hb : ∀ i x, ‖b i x‖ ≤ δ)
    (hb1 : ∀ i k x, ‖D k (b i) x‖ ≤ δ)
    (hsmall : (16 * (2 * Real.pi) ^ 2 + 36 * (2 * Real.pi) + 20) * δ < 1)
    (c : S) (w : Lp ℝ 2 (volume : Measure V))
    (hw : MemSobolev 1 2 (scalarComplexL2 w : T))
    (hbase : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (M φ (scalarComplexL2 w : T)))
    (ρ u : V → ℝ)
    (heq : (fun y => ρ y * u y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hρ : ∀ y ∈ closedBall (0 : V) (1 / 2), ContDiffAt ℝ ∞ ρ y)
    (hρ0 : ∀ y ∈ closedBall (0 : V) (1 / 2), ρ y ≠ 0)
    (l B q A C : ℝ) (hl : 0 < l) (hB : 0 ≤ B)
    (hRange : ∀ x ∈ closedBall (0 : V) (1 / 2), u x ∈ Icc l B)
    (F : Lp ℂ 2 (volume : Measure V))
    (hF : (F : V → ℂ) =ᵐ[volume.restrict (ball (0 : V) (1 / 2))]
      fun y => (ρ y * (A * u y + C * (u y) ^ q) : ℝ))
    (htest : ∀ ψ : S, HasCompactSupport (ψ : V → ℂ) →
      tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2) →
      (scalarPerturbedOperator a b (scalarComplexL2 w : T) - (scalarComplexL2 w : T) -
        M c (scalarComplexL2 w : T)) ψ = (F : T) ψ) :
    ∀ n : ℕ, ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev (n : ℝ) 2 (M φ (scalarComplexL2 w : T)) := by
  let W : T := scalarComplexL2 w
  let O : T := scalarPerturbedOperator a b W - W - M c W
  have hOF (ψ : S) (hc : HasCompactSupport (ψ : V → ℂ))
      (hs : tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2)) : M ψ O = M ψ (F : T) :=
    scalar_localize_eq_of_tests (ball 0 (1 / 2)) O (F : T) htest ψ hc hs
  have hsource2 (ψ : S) (hc : HasCompactSupport (ψ : V → ℂ))
      (hs : tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2)) : MemSobolev 2 2 (M ψ O) := by
    rw [hOF ψ hc hs]
    exact scalar_local_H2_nonlinear_source ρ u w heq hbase hρ hρ0 l B q A C hl hB hRange F hF ψ hc hs
  have hreg : ∀ k : ℕ, ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev ((k : ℝ) + 4) 2 (M φ W) := by
    intro k
    induction k with
    | zero =>
      intro φ hc hs
      have h := scalar_half_open_integer_forcing_gain a b δ hδ ha ha1 ha2 hb hb1 hsmall
        2 c W hw hsource2 φ hc hs
      norm_num only [Nat.cast_zero, Nat.cast_ofNat, zero_add] at h ⊢
      exact h
    | succ k ih =>
      intro φ hc hs
      have hsource (ψ : S) (hψc : HasCompactSupport (ψ : V → ℂ))
          (hψs : tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2)) :
          MemSobolev ((k + 3 : ℕ) : ℝ) 2 (M ψ O) := by
        rw [hOF ψ hψc hψs]
        apply scalar_local_integer_nonlinear_source (k + 3) (by omega) ρ u w heq
          (fun χ hχc hχs => ?_) hρ hρ0 l B q A C hl hB hRange F hF ψ hψc hψs
        have he : ((k + 3 : ℕ) : ℝ) + 1 = (k : ℝ) + 4 := by
          push_cast
          ring
        rw [he]
        exact ih χ hχc hχs
      have h := scalar_half_open_integer_forcing_gain a b δ hδ ha ha1 ha2 hb hb1 hsmall
        (k + 3) c W hw hsource φ hc hs
      have he : (k.succ : ℝ) + 4 = ((k + 3 : ℕ) : ℝ) + 2 := by
        push_cast
        ring
      rw [he]
      exact h
  intro n φ hc hs
  exact (hreg n φ hc hs).mono (by linarith)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual variational minimum has local second Sobolev derivatives,
without any assumed smoothness or positivity of its representative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff BigOperators SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance minimumH2_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

local instance minimumH2_probability (g : SmoothMetric M) : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_subcritical_minimum_local_H2
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : FourSpace) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ v : Lp ℝ 2 (volume : Measure FourSpace),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d (scalarWeightedH1ToH1 d w)
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : FourSpace) 1)] v ∧
        ∀ φ : 𝓢(FourSpace, ℂ), HasCompactSupport (φ : FourSpace → ℂ) →
          tsupport (φ : FourSpace → ℂ) ⊆ closedBall 0 (1 / 2) →
          MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 v : 𝓢'(FourSpace, ℂ))) := by
  obtain ⟨F, _, hF⟩ := scalar_minimum_L2_source g o d hp hp4 w hw hm hmin
  let u := scalarWeightedH1ToH1 d w
  let S := (2 : ℝ) • scalarH1BaseValue g o d u - (2 * ‖w‖ ^ 2) • F
  apply scalar_local_weighted_H2 g o d S u _ c z₀
  intro v
  have he : scalarBasePullback g o S = (2 : ℝ) • scalarH1Value d u -
      (2 * ‖w‖ ^ 2) • scalarBasePullback g o F := by
    simp only [S, map_sub, map_smul, scalarH1BaseValue_spec]
  rw [he]
  exact hF v

end
end PositiveEinsteinFour.Geometry
end


section

/-! The subcritical nonlinear chain rule on the actual H1 closure. Smooth
bounded-derivative truncations converge strongly in the value and all four
weak derivatives, using L8 values and L4 gradients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff _root_.Topology NNReal ENNReal

noncomputable section

private def nonlinearEpsilon (n : ℕ) : ℝ := ((n : ℝ) + 1)⁻¹

private theorem nonlinearEpsilon_pos (n : ℕ) : 0 < nonlinearEpsilon n := by
  unfold nonlinearEpsilon
  positivity

private theorem nonlinearEpsilon_le_one (n : ℕ) : nonlinearEpsilon n ≤ 1 := by
  apply inv_le_one_of_one_le₀
  change 1 ≤ (n : ℝ) + 1
  linarith [Nat.cast_nonneg (α := ℝ) n]

private theorem nonlinearEpsilon_tendsto :
    Tendsto nonlinearEpsilon atTop (𝓝 0) :=
  tendsto_inv_atTop_zero.comp
    (tendsto_atTop_add_const_right atTop 1 tendsto_natCast_atTop_atTop)

private theorem nonlinear_square_rpow (q s : ℝ) :
    (s ^ 2) ^ (q / 2) = |s| ^ q := by
  rw [← sq_abs, ← Real.rpow_natCast_mul (abs_nonneg s)]
  congr 1
  ring

private theorem nonlinear_power_tendsto {q : ℝ} (hq : 0 < q) (s : ℝ) :
    Tendsto (fun n => (s ^ 2 + nonlinearEpsilon n) ^ (q / 2)) atTop (𝓝 (|s| ^ q)) := by
  have hbase : Tendsto (fun n => s ^ 2 + nonlinearEpsilon n) atTop (𝓝 (s ^ 2)) :=
    by simpa only [add_zero] using
      (show Tendsto (fun _ : ℕ => s ^ 2) atTop (𝓝 (s ^ 2)) from tendsto_const_nhds).add
        nonlinearEpsilon_tendsto
  have ht := hbase.rpow_const (Or.inr (show 0 ≤ q / 2 by positivity))
  simpa only [add_zero, nonlinear_square_rpow] using ht

private theorem nonlinear_value_tendsto {q : ℝ} (hq : 0 < q) (s : ℝ) :
    Tendsto (fun n => scalarNonlinearTruncation q (nonlinearEpsilon n) s)
      atTop (𝓝 (|s| ^ q * s)) := by
  have hd : Tendsto (fun n => 1 + nonlinearEpsilon n * s ^ 2) atTop (𝓝 (1 : ℝ)) := by
    simpa using tendsto_const_nhds.add (nonlinearEpsilon_tendsto.mul_const (s ^ 2))
  have h := ((nonlinear_power_tendsto hq s).const_mul s).div hd one_ne_zero
  simpa only [scalarNonlinearTruncation, Pi.div_apply, div_one, mul_comm] using! h

private theorem nonlinear_derivative_tendsto {q : ℝ} (hq : 0 < q) (s : ℝ) :
    Tendsto (fun n => deriv (scalarNonlinearTruncation q (nonlinearEpsilon n)) s)
      atTop (𝓝 ((q + 1) * |s| ^ q)) := by
  simp_rw [scalarNonlinearTruncation_deriv q (nonlinearEpsilon_pos _)]
  by_cases hs : s = 0
  · subst s
    simpa only [scalarNonlinearTruncationDerivative, zero_pow (by decide : 2 ≠ 0),
      zero_add, mul_zero, zero_mul, div_one, zero_div, add_zero, sub_zero, mul_one,
      abs_zero, Real.zero_rpow hq.ne', mul_zero] using nonlinear_power_tendsto hq 0
  have hs2 : s ^ 2 ≠ 0 := pow_ne_zero _ hs
  have ha : Tendsto (fun n => s ^ 2 + nonlinearEpsilon n) atTop (𝓝 (s ^ 2)) := by
    simpa using tendsto_const_nhds.add nonlinearEpsilon_tendsto
  have hb : Tendsto (fun n => 1 + nonlinearEpsilon n * s ^ 2) atTop (𝓝 (1 : ℝ)) := by
    simpa using tendsto_const_nhds.add (nonlinearEpsilon_tendsto.mul_const (s ^ 2))
  have hc : Tendsto (fun n => q * s ^ 2 / (s ^ 2 + nonlinearEpsilon n))
      atTop (𝓝 q) := by
    have hn : Tendsto (fun _ : ℕ => q * s ^ 2) atTop (𝓝 (q * s ^ 2)) :=
      tendsto_const_nhds
    simpa only [Pi.div_apply, mul_div_cancel_right₀ _ hs2] using! hn.div ha hs2
  have hd : Tendsto (fun n => 2 * nonlinearEpsilon n * s ^ 2 /
      (1 + nonlinearEpsilon n * s ^ 2)) atTop (𝓝 (0 : ℝ)) := by
    simpa only [Pi.div_apply, zero_mul, mul_zero, zero_div] using!
      ((nonlinearEpsilon_tendsto.const_mul 2).mul_const (s ^ 2)).div hb one_ne_zero
  have h1 : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 1) := tendsto_const_nhds
  have h := ((nonlinear_power_tendsto hq s).div hb one_ne_zero).mul
    ((h1.add hc).sub hd)
  simpa only [scalarNonlinearTruncationDerivative, Pi.div_apply, Pi.add_apply, Pi.sub_apply,
    div_one, sub_zero, mul_comm, add_comm] using! h

private theorem nonlinear_value_bound {q ε : ℝ}
    (hq : 0 < q) (hq2 : q < 2) (hε : 0 < ε) (hε1 : ε ≤ 1) (s : ℝ) :
    |scalarNonlinearTruncation q ε s| ≤ |s| * (1 + s ^ 2) := by
  have hp : 0 ≤ (s ^ 2 + ε) ^ (q / 2) := Real.rpow_nonneg (by positivity) _
  rw [scalarNonlinearTruncation, abs_div, abs_mul, abs_of_nonneg hp,
    abs_of_pos (show 0 < 1 + ε * s ^ 2 by positivity)]
  apply (div_le_iff₀ (by positivity)).mpr
  calc
    _ ≤ |s| * (1 + s ^ 2) :=
      mul_le_mul_of_nonneg_left (scalarNonlinearTruncation_power_bound hq hq2 hε hε1 s)
        (abs_nonneg _)
    _ ≤ _ := le_mul_of_one_le_right (by positivity) (by nlinarith [sq_nonneg s])

section Measure

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

private theorem nonlinear_L2_tendsto (f : ℕ → Lp ℝ 2 μ) (g : Lp ℝ 2 μ)
    (B : X → ℝ) (hB : MemLp B 2 μ)
    (hfB : ∀ n, ∀ᵐ x ∂μ, |f n x| ≤ B x)
    (hgB : ∀ᵐ x ∂μ, |g x| ≤ B x)
    (hlim : ∀ᵐ x ∂μ, Tendsto (fun n => f n x) atTop (𝓝 (g x))) :
    Tendsto f atTop (𝓝 g) := by
  let d : ℕ → Lp ℝ 2 μ := fun n => f n - g
  have hd (n : ℕ) : d n =ᵐ[μ] fun x => f n x - g x := Lp.coeFn_sub _ _
  have hint := tendsto_integral_of_dominated_convergence (fun x => (2 * B x) ^ 2)
    (fun n => ((Lp.aestronglyMeasurable (f n)).sub (Lp.aestronglyMeasurable g)).pow 2)
    (by simpa only [mul_pow] using hB.integrable_sq.const_mul (2 ^ 2 : ℝ))
    (fun n => by
      filter_upwards [hfB n, hgB] with x hfx hgx
      simp only [Pi.pow_apply, Pi.sub_apply]
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      have ha : |f n x - g x| ≤ 2 * B x := (abs_sub _ _).trans (by linarith)
      simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg _) (by linarith [abs_nonneg (g x)])).2 ha)
    (f := fun _ => (0 : ℝ)) (by
      filter_upwards [hlim] with x hx
      simpa only [Pi.pow_apply, Pi.sub_apply, sub_self, zero_pow (by decide : 2 ≠ 0)] using!
        (hx.sub_const (g x)).pow 2)
  have hs : Tendsto (fun n => ‖d n‖ ^ 2) atTop (𝓝 0) := by
    convert hint using 1
    · funext n
      rw [scalarL2_norm_sq]
      exact integral_congr_ae ((hd n).fun_comp fun t : ℝ => t ^ 2)
    · simp
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  have h := Real.continuous_sqrt.continuousAt.tendsto.comp hs
  simpa only [Function.comp_def, Real.sqrt_sq_eq_abs,
    abs_of_nonneg (norm_nonneg _), Real.sqrt_zero, d] using h

variable [IsFiniteMeasure μ]

private theorem nonlinear_value_dominator {f : X → ℝ} (hf : MemLp f 8 μ) :
    MemLp (fun x => |f x| * (1 + f x ^ 2)) 2 μ := by
  have hexp : (6 : ℝ≥0∞) / 3 = 2 := by
    rw [show (6 : ℝ≥0∞) = 2 * 3 by norm_num]
    exact ENNReal.mul_div_cancel_right (by norm_num) (by norm_num)
  have hcube : MemLp (fun x => |f x| ^ (3 : ℕ)) 2 μ := by
    have h := (hf.mono_exponent (by norm_num : (6 : ℝ≥0∞) ≤ 8)).norm_rpow_div 3
    simpa only [ENNReal.toReal_ofNat, Real.rpow_ofNat, Real.norm_eq_abs,
      hexp] using h
  convert (hf.mono_exponent (by norm_num : (2 : ℝ≥0∞) ≤ 8)).norm.add hcube using 1
  funext x
  change |f x| * (1 + f x ^ 2) = ‖f x‖ + |f x| ^ 3
  rw [Real.norm_eq_abs, ← sq_abs]
  ring

private theorem nonlinear_gradient_dominator {f v : X → ℝ}
    (hf : MemLp f 8 μ) (hv : MemLp v 4 μ) :
    MemLp (fun x => 5 * (1 + f x ^ 2) * |v x|) 2 μ := by
  have hexp : (8 : ℝ≥0∞) / 2 = 4 := by
    rw [show (8 : ℝ≥0∞) = 4 * 2 by norm_num]
    exact ENNReal.mul_div_cancel_right (by norm_num) (by norm_num)
  have hs : MemLp (fun x => f x ^ 2) 4 μ := by
    have h := hf.norm_rpow_div 2
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two, Real.norm_eq_abs, sq_abs,
      hexp] using h
  have : ENNReal.HolderTriple (4 : ℝ≥0∞) 4 2 := by
    constructor
    change ((4 : ℝ≥0) : ℝ≥0∞)⁻¹ + ((4 : ℝ≥0) : ℝ≥0∞)⁻¹ = ((2 : ℝ≥0) : ℝ≥0∞)⁻¹
    rw [← ENNReal.coe_inv (by norm_num : (4 : ℝ≥0) ≠ 0),
      ← ENNReal.coe_inv (by norm_num : (2 : ℝ≥0) ≠ 0), ← ENNReal.coe_add]
    norm_num
  exact ((memLp_const (1 : ℝ)).add hs |>.const_mul 5).mul hv.norm

end Measure

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {μ : Measure (FrameBundle g)}
  [CompactSpace (FrameBundle g)] [IsFiniteMeasure μ]

/-- The subcritical power has an actual H1 first jet once its value is L8
and its four weak derivatives are L4. -/
theorem scalarH1_subcritical_compose (d : ParallelMetricData g μ) (u : scalarH1 d)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4)
    (hu : MemLp (scalarH1Value d u : FrameBundle g → ℝ) 8 μ)
    (hDu : ∀ i, MemLp (scalarH1Gradient d i u : FrameBundle g → ℝ) 4 μ) :
    ∃ v : scalarH1 d,
      (scalarH1Value d v : FrameBundle g → ℝ) =ᵐ[μ]
        (fun x => |scalarH1Value d u x| ^ (p - 2) * scalarH1Value d u x) ∧
      ∀ i, (scalarH1Gradient d i v : FrameBundle g → ℝ) =ᵐ[μ]
        (fun x => (p - 1) * |scalarH1Value d u x| ^ (p - 2) * scalarH1Gradient d i u x) := by
  let f : FrameBundle g → ℝ := scalarH1Value d u
  let F : FrameBundle g → ℝ := fun x => |f x| ^ (p - 2) * f x
  let G : Fin 4 → FrameBundle g → ℝ := fun i x =>
    (p - 1) * |f x| ^ (p - 2) * scalarH1Gradient d i u x
  have hF : MemLp F 2 μ := scalar_nonlinear_memLp_two_of_eight hu hp hp4
  have hG (i : Fin 4) : MemLp (G i) 2 μ :=
    scalar_subcritical_nonlinear_gradient_memLp_two hu (hDu i) hp hp4
  have hvn (n : ℕ) : ∃ v : scalarH1 d,
      (scalarH1Value d v : FrameBundle g → ℝ) =ᵐ[μ]
        (fun x => scalarNonlinearTruncation (p - 2) (nonlinearEpsilon n) (f x)) ∧
      ∀ i, (scalarH1Gradient d i v : FrameBundle g → ℝ) =ᵐ[μ]
        (fun x => deriv (scalarNonlinearTruncation (p - 2) (nonlinearEpsilon n)) (f x) *
          scalarH1Gradient d i u x) := by
    let D : ℝ≥0 := ⟨5 / nonlinearEpsilon n,
      le_of_lt (div_pos (by norm_num) (nonlinearEpsilon_pos n))⟩
    exact scalarH1_compose_exists_of_deriv_bound d _
      (scalarNonlinearTruncation_smooth _ (nonlinearEpsilon_pos n))
      (scalarNonlinearTruncation_zero _ _) (D := D)
      (scalarNonlinearTruncation_deriv_bounded (by linarith) (by linarith)
        (nonlinearEpsilon_pos n) (nonlinearEpsilon_le_one n)) u
  choose vn hvn hDn using hvn
  let V : ScalarL2 g μ := hF.toLp F
  let W : Fin 4 → ScalarL2 g μ := fun i => (hG i).toLp (G i)
  have hV : Tendsto (fun n => scalarH1Value d (vn n)) atTop (𝓝 V) := by
    apply nonlinear_L2_tendsto _ V _ (nonlinear_value_dominator hu)
    · intro n
      filter_upwards [hvn n] with x hx
      rw [hx]
      exact nonlinear_value_bound (by linarith) (by linarith)
        (nonlinearEpsilon_pos n) (nonlinearEpsilon_le_one n) _
    · filter_upwards [hF.coeFn_toLp] with x hx
      rw [hx]
      exact le_of_tendsto (nonlinear_value_tendsto (by linarith : 0 < p - 2) (f x) |>.norm)
        (Eventually.of_forall fun n => by
          simpa only [Real.norm_eq_abs] using nonlinear_value_bound (by linarith) (by linarith)
            (nonlinearEpsilon_pos n) (nonlinearEpsilon_le_one n) (f x))
    · filter_upwards [ae_all_iff.mpr hvn, hF.coeFn_toLp] with x hx hFx
      simp_rw [hx]
      rw [hFx]
      exact nonlinear_value_tendsto (by linarith) (f x)
  have hW (i : Fin 4) : Tendsto (fun n => scalarH1Gradient d i (vn n)) atTop (𝓝 (W i)) := by
    apply nonlinear_L2_tendsto _ (W i) _ (nonlinear_gradient_dominator hu (hDu i))
    · intro n
      filter_upwards [hDn n i] with x hx
      rw [hx, abs_mul]
      exact mul_le_mul_of_nonneg_right
        (scalarNonlinearTruncation_deriv_growth (by linarith) (by linarith)
          (nonlinearEpsilon_pos n) (nonlinearEpsilon_le_one n) (f x)) (abs_nonneg _)
    · filter_upwards [(hG i).coeFn_toLp] with x hx
      rw [hx]
      have ht := (nonlinear_derivative_tendsto (by linarith : 0 < p - 2) (f x)).mul_const
        (scalarH1Gradient d i u x)
      have he : p - 2 + 1 = p - 1 := by ring
      rw [he] at ht
      exact le_of_tendsto ht.norm (Eventually.of_forall fun n => by
        rw [Real.norm_eq_abs, abs_mul]
        exact mul_le_mul_of_nonneg_right
          (scalarNonlinearTruncation_deriv_growth (by linarith) (by linarith)
            (nonlinearEpsilon_pos n) (nonlinearEpsilon_le_one n) (f x)) (abs_nonneg _))
    · filter_upwards [ae_all_iff.mpr (fun n => hDn n i), (hG i).coeFn_toLp] with x hx hGx
      simp_rw [hx]
      rw [hGx]
      have ht := (nonlinear_derivative_tendsto (by linarith : 0 < p - 2) (f x)).mul_const
        (scalarH1Gradient d i u x)
      simpa only [show p - 2 + 1 = p - 1 by ring] using ht
  obtain ⟨v, hv, hgrad⟩ := scalarH1_jet_limit d vn V W hV hW
  refine ⟨v, ?_, fun i => ?_⟩
  · rw [hv]
    exact hF.coeFn_toLp
  · rw [hgrad i]
    exact (hG i).coeFn_toLp

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite-dimensional weak kernels for the bounded curvature potential
in the two-form Weitzenböck equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormPotentialResolvent (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    TwoFormL2 o →L[ℝ] TwoFormL2 o := twoFormRoughResolvent.comp B

theorem twoFormPotentialResolvent_compact (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    IsCompactOperator (twoFormPotentialResolvent B) :=
  twoFormRoughResolvent_compact.comp_clm B

def twoFormWeakPotentialKernel (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    Submodule ℝ (TwoFormH1 o) :=
  (ContinuousLinearMap.id ℝ (TwoFormH1 o) -
    twoFormRoughSolution.comp (B.comp twoFormH1ToL2)).ker

theorem mem_twoFormWeakPotentialKernel (B : TwoFormL2 o →L[ℝ] TwoFormL2 o)
    (u : TwoFormH1 o) : u ∈ twoFormWeakPotentialKernel B ↔
      u = twoFormRoughSolution (B (twoFormH1ToL2 u)) := by
  simp only [twoFormWeakPotentialKernel, LinearMap.mem_ker, ContinuousLinearMap.coe_coe,
    sub_apply, ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply, sub_eq_zero]

theorem twoFormWeakPotentialKernel_weak (B : TwoFormL2 o →L[ℝ] TwoFormL2 o)
    (u : TwoFormH1 o) : u ∈ twoFormWeakPotentialKernel B ↔
      ∀ v, inner ℝ u v = inner ℝ (B (twoFormH1ToL2 u)) (twoFormH1ToL2 v) := by
  rw [mem_twoFormWeakPotentialKernel]
  constructor
  · intro hu v
    conv_lhs => rw [hu]
    exact twoFormRoughSolution_weak _ _
  · exact twoFormRoughSolution_unique _ u

def twoFormPotentialKernelValue (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    twoFormWeakPotentialKernel B →ₗ[ℝ]
      Module.End.eigenspace (twoFormPotentialResolvent B).toLinearMap 1 where
  toFun u := ⟨twoFormH1ToL2 u.val, by
    rw [Module.End.mem_eigenspace_iff]
    change twoFormH1ToL2 (twoFormRoughSolution (B (twoFormH1ToL2 u.val))) =
      (1 : ℝ) • twoFormH1ToL2 u.val
    rw [one_smul, ← (mem_twoFormWeakPotentialKernel B u.val).mp u.property]⟩
  map_add' u v := Subtype.ext (map_add twoFormH1ToL2 u.val v.val)
  map_smul' r u := Subtype.ext (map_smul twoFormH1ToL2 r u.val)

theorem twoFormPotentialKernelValue_injective (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    Function.Injective (twoFormPotentialKernelValue B) := by
  intro u v huv
  have hval : twoFormH1ToL2 u.val = twoFormH1ToL2 v.val := congrArg Subtype.val huv
  apply Subtype.ext
  rw [(mem_twoFormWeakPotentialKernel B u.val).mp u.property,
    (mem_twoFormWeakPotentialKernel B v.val).mp v.property, hval]

theorem twoFormWeakPotentialKernel_finite (B : TwoFormL2 o →L[ℝ] TwoFormL2 o) :
    FiniteDimensional ℝ (twoFormWeakPotentialKernel B) := by
  let _ := ContinuousLinearMap.finite_dimensional_eigenspace
    (twoFormPotentialResolvent_compact B) (1 : ℝ) one_ne_zero
  exact FiniteDimensional.of_injective (twoFormPotentialKernelValue B)
    (twoFormPotentialKernelValue_injective B)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual rough solution operator preserves the two Hodge summands. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormH1HodgeIsometry : TwoFormH1 o →ₗᵢ[ℝ] TwoFormH1 o where
  toLinearMap := twoFormH1Hodge.toLinearMap
  norm_map' := twoFormH1Hodge_norm

theorem twoFormH1Hodge_inner (u v : TwoFormH1 o) :
    inner ℝ (twoFormH1Hodge u) (twoFormH1Hodge v) = inner ℝ u v :=
  twoFormH1HodgeIsometry.inner_map_map u v

theorem twoFormH1Hodge_selfAdjoint (u v : TwoFormH1 o) :
    inner ℝ (twoFormH1Hodge u) v = inner ℝ u (twoFormH1Hodge v) := by
  have h := twoFormH1Hodge_inner u (twoFormH1Hodge v)
  rw [twoFormH1Hodge_involutive v] at h
  exact h

theorem twoFormRoughSolution_hodge (f : TwoFormL2 o) :
    twoFormRoughSolution (twoFormL2Hodge f) =
      twoFormH1Hodge (twoFormRoughSolution f) := by
  symm
  apply twoFormRoughSolution_unique
  intro v
  rw [twoFormH1Hodge_selfAdjoint, twoFormRoughSolution_weak,
    twoFormH1ToL2_hodge, ← twoFormL2Hodge_selfAdjoint]

theorem twoFormRoughResolvent_hodge (f : TwoFormL2 o) :
    twoFormRoughResolvent (twoFormL2Hodge f) =
      twoFormL2Hodge (twoFormRoughResolvent f) := by
  change twoFormH1ToL2 (twoFormRoughSolution (twoFormL2Hodge f)) = _
  rw [twoFormRoughSolution_hodge, twoFormH1ToL2_hodge]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Successive matrix heat amplitudes are actual radial integrals of the
preceding amplitude under the six-component differential operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

def fourHeatBundleCoefficient (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (C : FourSpace → HeatMat6) (U : FourSpace → ℝ) :
    ℕ → FourSpace → HeatMat6
  | 0 => fun x k l => U x * (if k = l then 1 else 0)
  | m + 1 => fun x k l => fourHeatWeightedRadialAverage m U
      (fun y => -fourHeatBundleOperator (a y) (b y) (B y) (C y)
        (fun z q => fourHeatBundleCoefficient a b B C U m z q l) y k) x

theorem fourHeatBundleCoefficient_contDiff (m : ℕ) : ∀ (n : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (C : FourSpace → HeatMat6) (U : FourSpace → ℝ),
    (∀ i j, ContDiff ℝ (n + 2 * m : ℕ) (fun x => a x i j)) →
    (∀ i, ContDiff ℝ (n + 2 * m : ℕ) (fun x => b x i)) →
    (∀ i k l, ContDiff ℝ (n + 2 * m : ℕ) (fun x => B x i k l)) →
    (∀ k l, ContDiff ℝ (n + 2 * m : ℕ) (fun x => C x k l)) →
    ContDiff ℝ (n + 2 * m : ℕ) U → (∀ x, U x ≠ 0) →
    ∀ k l, ContDiff ℝ n (fun x => fourHeatBundleCoefficient a b B C U m x k l) := by
  induction m with
  | zero =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    simpa only [fourHeatBundleCoefficient, mul_zero, add_zero] using hU.mul
      (contDiff_const (c := if k = l then (1 : ℝ) else 0))
  | succ m ih =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    have he : n + 2 * (m + 1) = (n + 2) + 2 * m := by omega
    have hreg := ih (n + 2) a b B C U (fun i j => he ▸ ha i j)
      (fun i => he ▸ hb i) (fun i k l => he ▸ hB i k l)
      (fun k l => he ▸ hC k l) (he ▸ hU) hU0
    have hle : (n : ℕ∞ω) ≤ (n + 2 * (m + 1) : ℕ) := by
      exact_mod_cast (show n ≤ n + 2 * (m + 1) by omega)
    apply fourHeatWeightedRadialAverage_preserves_contDiff n m U _ (hU.of_le hle) _ hU0
    exact (fourHeatBundleOperator_contDiff n a b B C _
      (fun i j => (ha i j).of_le hle) (fun i => (hb i).of_le hle)
      (fun i k l => (hB i k l).of_le hle) (fun k l => (hC k l).of_le hle)
      (fun q => hreg q l) k).neg

theorem fourHeatBundleCoefficient_transport (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (C : FourSpace → HeatMat6) (U : FourSpace → ℝ)
    (x : FourSpace) (hU : ContDiff ℝ 1 U) (hU0 : ∀ y, U y ≠ 0)
    (ha : ∀ i j, ContDiff ℝ 1 (fun y => a y i j))
    (hb : ∀ i, ContDiff ℝ 1 (fun y => b y i))
    (hB : ∀ i k l, ContDiff ℝ 1 (fun y => B y i k l))
    (hC : ∀ k l, ContDiff ℝ 1 (fun y => C y k l))
    (hm : ∀ k l, ContDiff ℝ 3 (fun y => fourHeatBundleCoefficient a b B C U m y k l))
    (hrow : ∀ i, ∑ j : Fin 4, a x i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a x i j * x i = x j)
    (hTU : fourHeatRadialTransport (a x) (b x) U x = 0) (k l : Fin 6) :
    fourHeatRadialTransport (a x) (b x)
        (fun y => fourHeatBundleCoefficient a b B C U (m + 1) y k l) x +
      (m + 1 : ℝ) * fourHeatBundleCoefficient a b B C U (m + 1) x k l =
    -fourHeatBundleOperator (a x) (b x) (B x) (C x)
      (fun y q => fourHeatBundleCoefficient a b B C U m y q l) x k := by
  apply fourHeatWeightedRadialAverage_transport m (a x) (b x) U _ x hU _ hU0
    hrow hcol hTU
  exact (fourHeatBundleOperator_contDiff 1 a b B C _ ha hb hB hC
    (fun q => hm q l) k).neg

theorem fourHeatBundleCoefficient_center (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (C : FourSpace → HeatMat6) (U : FourSpace → ℝ)
    (hU0 : U 0 ≠ 0) (k l : Fin 6) :
    (m + 1 : ℝ) * fourHeatBundleCoefficient a b B C U (m + 1) 0 k l =
      -fourHeatBundleOperator (a 0) (b 0) (B 0) (C 0)
        (fun y q => fourHeatBundleCoefficient a b B C U m y q l) 0 k := by
  simp only [fourHeatBundleCoefficient, fourHeatWeightedRadialAverage, fourHeatRadialAverage_zero]
  have hm : (m + 1 : ℝ) ≠ 0 := by positivity
  field_simp

end
end PositiveEinsteinFour.Geometry
end


section

/-! Linearity and finite time polynomials for the actual six-component
differential expression. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatBundleOperator_const_mul (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) (r : ℝ)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace) (k : Fin 6) :
    fourHeatBundleOperator a b B C (fun y l => r * u y l) x k =
      r * fourHeatBundleOperator a b B C u x k := by
  unfold fourHeatBundleOperator fourHeatBundleFirst fourHeatBundleZero
  simp only [fourHeatLocalOperator_const_mul, fourHeat_partial_const_mul]
  have hB : (∑ i : Fin 4, ∑ l : Fin 6,
      B i k l * (r * partialDeriv (fun y => u y l) i x)) =
      r * (∑ i : Fin 4, ∑ l : Fin 6, B i k l * partialDeriv (fun y => u y l) i x) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hC : (∑ l : Fin 6, C k l * (r * u x l)) =
      r * (∑ l : Fin 6, C k l * u x l) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro l _
    ring
  rw [hB, hC]
  ring

theorem fourHeatBundleOperator_add (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) (u v : FourSpace → Fin 6 → ℝ)
    (hu : ∀ l, ContDiff ℝ 2 (fun x => u x l))
    (hv : ∀ l, ContDiff ℝ 2 (fun x => v x l)) (x : FourSpace) (k : Fin 6) :
    fourHeatBundleOperator a b B C (fun y l => u y l + v y l) x k =
      fourHeatBundleOperator a b B C u x k + fourHeatBundleOperator a b B C v x k := by
  unfold fourHeatBundleOperator fourHeatBundleFirst fourHeatBundleZero
  rw [fourHeatLocalOperator_add a b 0 _ _ (hu k) (hv k)]
  have hp (i : Fin 4) (l : Fin 6) :
      partialDeriv (fun y => u y l + v y l) i x =
      partialDeriv (fun y => u y l) i x + partialDeriv (fun y => v y l) i x :=
    fourHeat_partial_add _ _ x ((hu l).differentiable (by norm_num)).differentiableAt
      ((hv l).differentiable (by norm_num)).differentiableAt i
  simp only [hp, mul_add, Finset.sum_add_distrib]
  ring

def fourHeatBundlePolynomial (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (t : ℝ) (x : FourSpace) (k : Fin 6) : ℝ :=
  fourHeatPolynomial (fun m y => u m y k) t x

theorem fourHeatBundlePolynomial_operator (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6)
    (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (hu : ∀ m k, ContDiff ℝ 2 (fun x => u m x k)) (t : ℝ) (x : FourSpace) (k : Fin 6) :
    fourHeatBundleOperator a b B C (fourHeatBundlePolynomial u t) x k =
      fourHeatBundleOperator a b B C (u 0) x k +
        t * fourHeatBundleOperator a b B C (u 1) x k +
        t ^ 2 * fourHeatBundleOperator a b B C (u 2) x k +
        t ^ 3 * fourHeatBundleOperator a b B C (u 3) x k := by
  have h0 := hu 0
  have h1 := hu 1
  have h2 := hu 2
  have h3 := hu 3
  unfold fourHeatBundlePolynomial fourHeatPolynomial
  rw [fourHeatBundleOperator_add a b B C _ _
      (fun l => ((h0 l).add (contDiff_const.mul (h1 l))).add (contDiff_const.mul (h2 l)))
      (fun l => contDiff_const.mul (h3 l)),
    fourHeatBundleOperator_add a b B C _ _
      (fun l => (h0 l).add (contDiff_const.mul (h1 l)))
      (fun l => contDiff_const.mul (h2 l)),
    fourHeatBundleOperator_add a b B C _ _ h0 (fun l => contDiff_const.mul (h1 l))]
  simp only [fourHeatBundleOperator_const_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! A bounded continuous time-dependent amplitude is sampled at the
origin by the actual Gaussian. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped _root_.Topology

noncomputable section

theorem fourHeatGaussian_family_limit (F : ℝ → FourSpace → ℝ)
    (hF : Continuous (fun z : ℝ × FourSpace => F z.1 z.2))
    (B T : ℝ) (hT : 0 < T) (hB : ∀ t ∈ Icc (0 : ℝ) T, ∀ x, ‖F t x‖ ≤ B) :
    Tendsto (fun t => ∫ x : FourSpace, fourHeatGaussian t x * F t x)
      (𝓝[>] 0) (𝓝 (F 0 0)) := by
  have hpoint (z : FourSpace) :
      Tendsto (fun t : ℝ => fourHeatGaussian 1 z * F t (Real.sqrt t • z))
        (𝓝[>] 0) (𝓝 (fourHeatGaussian 1 z * F 0 0)) := by
    have hs : Tendsto (fun t : ℝ => Real.sqrt t • z) (𝓝 0) (𝓝 (0 : FourSpace)) := by
      simpa only [Real.sqrt_zero, zero_smul] using
        ((Real.continuous_sqrt.tendsto 0).smul
          (tendsto_const_nhds : Tendsto (fun _ : ℝ => z) (𝓝 0) (𝓝 z)))
    have ha : Tendsto (fun t : ℝ => (t, Real.sqrt t • z)) (𝓝 0) (𝓝 (0, (0 : FourSpace))) :=
      tendsto_id.prodMk_nhds hs
    exact ((tendsto_const_nhds : Tendsto (fun _ : ℝ => fourHeatGaussian 1 z) (𝓝 0)
      (𝓝 (fourHeatGaussian 1 z))).mul ((hF.tendsto _).comp ha)).mono_left nhdsWithin_le_nhds
  have hsmall : ∀ᶠ t : ℝ in 𝓝[>] 0, t ∈ Icc (0 : ℝ) T := by
    filter_upwards [self_mem_nhdsWithin, (eventually_lt_nhds hT).filter_mono nhdsWithin_le_nhds]
      with t ht htT
    exact ⟨ht.le, htT.le⟩
  have hbound : ∀ᶠ t : ℝ in 𝓝[>] 0, ∀ᵐ z : FourSpace,
      ‖fourHeatGaussian 1 z * F t (Real.sqrt t • z)‖ ≤ fourHeatGaussian 1 z * B := by
    filter_upwards [hsmall] with t ht
    exact Eventually.of_forall fun z => by
      rw [norm_mul, Real.norm_eq_abs, abs_of_pos (fourHeatGaussian_pos 1 zero_lt_one z)]
      exact mul_le_mul_of_nonneg_left (hB t ht _) (fourHeatGaussian_pos 1 zero_lt_one z).le
  have hmeas (t : ℝ) : AEStronglyMeasurable
      (fun z : FourSpace => fourHeatGaussian 1 z * F t (Real.sqrt t • z)) volume := by
    apply Continuous.aestronglyMeasurable
    apply (fourHeatGaussian_continuous 1).mul
    exact hF.comp ((continuous_const : Continuous (fun _ : FourSpace => t)).prodMk
      ((continuous_const : Continuous (fun _ : FourSpace => Real.sqrt t)).smul continuous_id))
  have hlim := tendsto_integral_filter_of_dominated_convergence
    (μ := (volume : Measure FourSpace)) (l := 𝓝[>] (0 : ℝ))
    (F := fun t z => fourHeatGaussian 1 z * F t (Real.sqrt t • z))
    (f := fun z => fourHeatGaussian 1 z * F 0 0)
    (fun z => fourHeatGaussian 1 z * B) (Eventually.of_forall hmeas) hbound
    ((fourHeatGaussian_integrable 1 zero_lt_one).mul_const B) (Eventually.of_forall hpoint)
  simp only [integral_mul_const, fourHeatGaussian_mass 1 zero_lt_one, one_mul] at hlim
  apply hlim.congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  have h := fourHeatGaussian_integral_dilate t ht (fun x => F t (-x)) 0
  simpa only [zero_sub, neg_neg] using h.symm

theorem fourHeatGaussian_square_half (t : ℝ) (ht : 0 < t) (x : FourSpace) :
    t ^ 2 * fourHeatGaussian t x ^ 2 =
      (1 / (64 * Real.pi ^ 2)) * fourHeatGaussian (t / 2) x := by
  have he : 2 * (-(4 * t)⁻¹ * ‖x‖ ^ 2) = -(4 * (t / 2))⁻¹ * ‖x‖ ^ 2 := by
    field_simp
  unfold fourHeatGaussian
  rw [mul_pow, ← Real.exp_nat_mul, show (2 : ℕ) = 2 from rfl, Nat.cast_ofNat, he]
  field_simp [Real.pi_ne_zero]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Successive matrix heat amplitudes are actual radial integrals of the
preceding amplitude under the four-component differential operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

def fourHeatOneCoefficient (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → Mat4) (C : FourSpace → Mat4) (U : FourSpace → ℝ) :
    ℕ → FourSpace → Mat4
  | 0 => fun x k l => U x * (if k = l then 1 else 0)
  | m + 1 => fun x k l => fourHeatWeightedRadialAverage m U
      (fun y => -fourHeatOneOperator (a y) (b y) (B y) (C y)
        (fun z q => fourHeatOneCoefficient a b B C U m z q l) y k) x

theorem fourHeatOneCoefficient_contDiff (m : ℕ) : ∀ (n : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → Mat4) (C : FourSpace → Mat4) (U : FourSpace → ℝ),
    (∀ i j, ContDiff ℝ (n + 2 * m : ℕ) (fun x => a x i j)) →
    (∀ i, ContDiff ℝ (n + 2 * m : ℕ) (fun x => b x i)) →
    (∀ i k l, ContDiff ℝ (n + 2 * m : ℕ) (fun x => B x i k l)) →
    (∀ k l, ContDiff ℝ (n + 2 * m : ℕ) (fun x => C x k l)) →
    ContDiff ℝ (n + 2 * m : ℕ) U → (∀ x, U x ≠ 0) →
    ∀ k l, ContDiff ℝ n (fun x => fourHeatOneCoefficient a b B C U m x k l) := by
  induction m with
  | zero =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    simpa only [fourHeatOneCoefficient, mul_zero, add_zero] using hU.mul
      (contDiff_const (c := if k = l then (1 : ℝ) else 0))
  | succ m ih =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    have he : n + 2 * (m + 1) = (n + 2) + 2 * m := by omega
    have hreg := ih (n + 2) a b B C U (fun i j => he ▸ ha i j)
      (fun i => he ▸ hb i) (fun i k l => he ▸ hB i k l)
      (fun k l => he ▸ hC k l) (he ▸ hU) hU0
    have hle : (n : ℕ∞ω) ≤ (n + 2 * (m + 1) : ℕ) := by
      exact_mod_cast (show n ≤ n + 2 * (m + 1) by omega)
    apply fourHeatWeightedRadialAverage_preserves_contDiff n m U _ (hU.of_le hle) _ hU0
    exact (fourHeatOneOperator_contDiff n a b B C _
      (fun i j => (ha i j).of_le hle) (fun i => (hb i).of_le hle)
      (fun i k l => (hB i k l).of_le hle) (fun k l => (hC k l).of_le hle)
      (fun q => hreg q l) k).neg

theorem fourHeatOneCoefficient_transport (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → Mat4) (C : FourSpace → Mat4) (U : FourSpace → ℝ)
    (x : FourSpace) (hU : ContDiff ℝ 1 U) (hU0 : ∀ y, U y ≠ 0)
    (ha : ∀ i j, ContDiff ℝ 1 (fun y => a y i j))
    (hb : ∀ i, ContDiff ℝ 1 (fun y => b y i))
    (hB : ∀ i k l, ContDiff ℝ 1 (fun y => B y i k l))
    (hC : ∀ k l, ContDiff ℝ 1 (fun y => C y k l))
    (hm : ∀ k l, ContDiff ℝ 3 (fun y => fourHeatOneCoefficient a b B C U m y k l))
    (hrow : ∀ i, ∑ j : Fin 4, a x i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a x i j * x i = x j)
    (hTU : fourHeatRadialTransport (a x) (b x) U x = 0) (k l : Fin 4) :
    fourHeatRadialTransport (a x) (b x)
        (fun y => fourHeatOneCoefficient a b B C U (m + 1) y k l) x +
      (m + 1 : ℝ) * fourHeatOneCoefficient a b B C U (m + 1) x k l =
    -fourHeatOneOperator (a x) (b x) (B x) (C x)
      (fun y q => fourHeatOneCoefficient a b B C U m y q l) x k := by
  apply fourHeatWeightedRadialAverage_transport m (a x) (b x) U _ x hU _ hU0
    hrow hcol hTU
  exact (fourHeatOneOperator_contDiff 1 a b B C _ ha hb hB hC
    (fun q => hm q l) k).neg

theorem fourHeatOneCoefficient_center (m : ℕ)
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → Mat4) (C : FourSpace → Mat4) (U : FourSpace → ℝ)
    (hU0 : U 0 ≠ 0) (k l : Fin 4) :
    (m + 1 : ℝ) * fourHeatOneCoefficient a b B C U (m + 1) 0 k l =
      -fourHeatOneOperator (a 0) (b 0) (B 0) (C 0)
        (fun y q => fourHeatOneCoefficient a b B C U m y q l) 0 k := by
  simp only [fourHeatOneCoefficient, fourHeatWeightedRadialAverage, fourHeatRadialAverage_zero]
  have hm : (m + 1 : ℝ) ≠ 0 := by positivity
  field_simp

end
end PositiveEinsteinFour.Geometry
end


section

/-! Linearity and finite time polynomials for the actual four-component
differential expression. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatOneOperator_const_mul (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4) (r : ℝ)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace) (k : Fin 4) :
    fourHeatOneOperator a b B C (fun y l => r * u y l) x k =
      r * fourHeatOneOperator a b B C u x k := by
  unfold fourHeatOneOperator fourHeatOneFirst fourHeatOneZero
  simp only [fourHeatLocalOperator_const_mul, fourHeat_partial_const_mul]
  have hB : (∑ i : Fin 4, ∑ l : Fin 4,
      B i k l * (r * partialDeriv (fun y => u y l) i x)) =
      r * (∑ i : Fin 4, ∑ l : Fin 4, B i k l * partialDeriv (fun y => u y l) i x) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hC : (∑ l : Fin 4, C k l * (r * u x l)) =
      r * (∑ l : Fin 4, C k l * u x l) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro l _
    ring
  rw [hB, hC]
  ring

theorem fourHeatOneOperator_add (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4) (u v : FourSpace → Fin 4 → ℝ)
    (hu : ∀ l, ContDiff ℝ 2 (fun x => u x l))
    (hv : ∀ l, ContDiff ℝ 2 (fun x => v x l)) (x : FourSpace) (k : Fin 4) :
    fourHeatOneOperator a b B C (fun y l => u y l + v y l) x k =
      fourHeatOneOperator a b B C u x k + fourHeatOneOperator a b B C v x k := by
  unfold fourHeatOneOperator fourHeatOneFirst fourHeatOneZero
  rw [fourHeatLocalOperator_add a b 0 _ _ (hu k) (hv k)]
  have hp (i : Fin 4) (l : Fin 4) :
      partialDeriv (fun y => u y l + v y l) i x =
      partialDeriv (fun y => u y l) i x + partialDeriv (fun y => v y l) i x :=
    fourHeat_partial_add _ _ x ((hu l).differentiable (by norm_num)).differentiableAt
      ((hv l).differentiable (by norm_num)).differentiableAt i
  simp only [hp, mul_add, Finset.sum_add_distrib]
  ring

def fourHeatOnePolynomial (u : Fin 4 → FourSpace → Fin 4 → ℝ)
    (t : ℝ) (x : FourSpace) (k : Fin 4) : ℝ :=
  fourHeatPolynomial (fun m y => u m y k) t x

theorem fourHeatOnePolynomial_operator (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4)
    (u : Fin 4 → FourSpace → Fin 4 → ℝ)
    (hu : ∀ m k, ContDiff ℝ 2 (fun x => u m x k)) (t : ℝ) (x : FourSpace) (k : Fin 4) :
    fourHeatOneOperator a b B C (fourHeatOnePolynomial u t) x k =
      fourHeatOneOperator a b B C (u 0) x k +
        t * fourHeatOneOperator a b B C (u 1) x k +
        t ^ 2 * fourHeatOneOperator a b B C (u 2) x k +
        t ^ 3 * fourHeatOneOperator a b B C (u 3) x k := by
  have h0 := hu 0
  have h1 := hu 1
  have h2 := hu 2
  have h3 := hu 3
  unfold fourHeatOnePolynomial fourHeatPolynomial
  rw [fourHeatOneOperator_add a b B C _ _
      (fun l => ((h0 l).add (contDiff_const.mul (h1 l))).add (contDiff_const.mul (h2 l)))
      (fun l => contDiff_const.mul (h3 l)),
    fourHeatOneOperator_add a b B C _ _
      (fun l => (h0 l).add (contDiff_const.mul (h1 l)))
      (fun l => contDiff_const.mul (h2 l)),
    fourHeatOneOperator_add a b B C _ _ h0 (fun l => contDiff_const.mul (h1 l))]
  simp only [fourHeatOneOperator_const_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual time derivative of a Gaussian polynomial can be passed
through every continuous compactly supported scalar pairing. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter MeasureTheory
open scoped _root_.Topology

noncomputable section

def fourHeatPolynomialTime (u : Fin 4 → FourSpace → ℝ) (t : ℝ) (x : FourSpace) : ℝ :=
  u 1 x + 2 * t * u 2 x + 3 * t ^ 2 * u 3 x

def fourHeatGaussianPolynomialTime (u : Fin 4 → FourSpace → ℝ) (t : ℝ) (x : FourSpace) : ℝ :=
  (fourHeatGaussianTimeFactor t x * fourHeatGaussian t x) * fourHeatPolynomial u t x +
    fourHeatGaussian t x * fourHeatPolynomialTime u t x

theorem fourHeatGaussianPolynomial_hasDerivAt (u : Fin 4 → FourSpace → ℝ)
    (t : ℝ) (ht : 0 < t) (x : FourSpace) :
    HasDerivAt (fun s => fourHeatGaussian s x * fourHeatPolynomial u s x)
      (fourHeatGaussianPolynomialTime u t x) t :=
  (fourHeatGaussian_hasDerivAt_time t ht x).mul (fourHeatPolynomial_hasDerivAt u t x)

theorem fourHeatGaussianPolynomialTime_continuousOn (u : Fin 4 → FourSpace → ℝ)
    (hu : ∀ m, Continuous (u m)) :
    ContinuousOn (fun z : ℝ × FourSpace => fourHeatGaussianPolynomialTime u z.1 z.2)
      (Ioi 0 ×ˢ univ) := by
  have hQ : Continuous (fun z : ℝ × FourSpace => fourHeatPolynomialTime u z.1 z.2) := by
    exact (((hu 1).comp continuous_snd).add
      ((continuous_const.mul continuous_fst).mul ((hu 2).comp continuous_snd))).add
      ((continuous_const.mul (continuous_fst.pow 2)).mul ((hu 3).comp continuous_snd))
  exact ((fourHeatGaussianTimeFactor_joint_continuousOn.mul fourHeatGaussian_joint_continuousOn).mul
    (fourHeatPolynomial_joint_continuous u hu).continuousOn).add
    (fourHeatGaussian_joint_continuousOn.mul hQ.continuousOn)

theorem fourHeat_compact_polynomial_pairing_deriv
    (ψ : FourSpace → ℝ) (hψ : Continuous ψ) (hc : HasCompactSupport ψ)
    (u : Fin 4 → FourSpace → ℝ) (hu : ∀ m, Continuous (u m))
    (t : ℝ) (ht : 0 < t) :
    HasDerivAt (fun s => ∫ x, ψ x * (fourHeatGaussian s x * fourHeatPolynomial u s x))
      (∫ x, ψ x * fourHeatGaussianPolynomialTime u t x) t := by
  apply fourHeat_compact_time_integral
    (fun s x => ψ x * (fourHeatGaussian s x * fourHeatPolynomial u s x))
    (fun s x => ψ x * fourHeatGaussianPolynomialTime u s x) (tsupport ψ) hc
  · intro s _hs
    exact hψ.mul ((fourHeatGaussian_continuous s).mul
      ((fourHeatPolynomial_joint_continuous u hu).comp (continuous_const.prodMk continuous_id)))
  · exact (hψ.comp continuous_snd).continuousOn.mul (fourHeatGaussianPolynomialTime_continuousOn u hu)
  · intro s _hs x hx
    rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  · intro s _hs x hx
    rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]
  · intro s hs x
    exact (fourHeatGaussianPolynomial_hasDerivAt u s hs x).const_mul (ψ x)
  · exact ht

end
end PositiveEinsteinFour.Geometry
end


section

/-! The two center derivatives of the actual weighted radial solver.
These finite jets determine the second heat coefficient. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff

noncomputable section

theorem fourHeatWeightedRadialAverage_partial_zero (m : ℕ) (U F : FourSpace → ℝ)
    (hU : ContDiff ℝ 2 U) (hF : ContDiff ℝ 2 F) (hU0 : ∀ x, U x ≠ 0) (i : Fin 4) :
    partialDeriv (fourHeatWeightedRadialAverage m U F) i 0 =
      partialDeriv U i 0 * ((F 0 / U 0) / (m + 1 : ℝ)) +
      U 0 * (partialDeriv (fun x => F x / U x) i 0 / (m + 2 : ℝ)) := by
  have hQ : ContDiff ℝ 2 (fun y => F y / U y) := hF.div hU hU0
  have hR := fourHeatRadialAverage_preserves_contDiff 2 m _ hQ
  change partialDeriv (fun x => U x * fourHeatRadialAverage m (fun y => F y / U y) x) i 0 = _
  rw [scalar_partial_product U (fourHeatRadialAverage m (fun y => F y / U y)) 0 (hU.differentiable (by norm_num)).differentiableAt
    (hR.differentiable (by norm_num)).differentiableAt i,
    fourHeatRadialAverage_zero,
    fourHeatRadialAverage_partial_zero m _ (hQ.of_le (by norm_num))]

theorem fourHeatWeightedRadialAverage_second_zero (m : ℕ) (U F : FourSpace → ℝ)
    (hU : ContDiff ℝ 2 U) (hF : ContDiff ℝ 2 F) (hU0 : ∀ x, U x ≠ 0) (i j : Fin 4) :
    partialDeriv (partialDeriv (fourHeatWeightedRadialAverage m U F) i) j 0 =
      partialDeriv (partialDeriv U i) j 0 * ((F 0 / U 0) / (m + 1 : ℝ)) +
      partialDeriv U i 0 * (partialDeriv (fun x => F x / U x) j 0 / (m + 2 : ℝ)) +
      partialDeriv U j 0 * (partialDeriv (fun x => F x / U x) i 0 / (m + 2 : ℝ)) +
      U 0 * (partialDeriv (partialDeriv (fun x => F x / U x) i) j 0 / (m + 3 : ℝ)) := by
  have hQ : ContDiff ℝ 2 (fun y => F y / U y) := hF.div hU hU0
  have hR := fourHeatRadialAverage_preserves_contDiff 2 m _ hQ
  change partialDeriv (partialDeriv
    (fun x => U x * fourHeatRadialAverage m (fun y => F y / U y) x) i) j 0 = _
  rw [scalar_partial_second_product_at U (fourHeatRadialAverage m (fun y => F y / U y))
    0 hU.contDiffAt hR.contDiffAt i j,
    fourHeatRadialAverage_zero,
    fourHeatRadialAverage_partial_zero m _ (hQ.of_le (by norm_num)),
    fourHeatRadialAverage_partial_zero m _ (hQ.of_le (by norm_num)),
    fourHeatRadialAverage_second_zero m _ hQ]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Uniform control of compact chart tensors in the frame-bundle norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem twoTensorEuclidean_norm_le_sum (T : CovariantCoordinates 2) :
    ‖(WithLp.toLp 2 T : TwoTensorEuclidean)‖ ≤ ∑ a, |T a| := by
  have hs := Finset.sum_sq_le_sq_sum_of_nonneg (s := Finset.univ)
    (f := fun a => |T a|) (fun _ _ => abs_nonneg _)
  simp only [sq_abs] at hs
  apply (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg (fun _ _ => abs_nonneg _))).mp
  simpa only [PiLp.norm_sq_eq_of_L2, Real.norm_eq_abs, sq_abs] using hs

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M}

local instance heatChartTensorBoundCompact : CompactSpace (FrameBundle g) := actual_compactFrameBundle g

theorem heatChartTensor_bound (c : M) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (F : FourSpace → CovariantCoordinates 2)
      (hF : ContinuousOn F (chartAt FourSpace c).target) (hFs : tsupport F ⊆ K)
      (r : ℝ), 0 ≤ r → (∀ z a, |F z a| ≤ r) →
      ‖heatChartTensor g c F hF
        (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt)‖ ≤ B * r := by
  let L : Set (FrameBundle g) := (fun f => f.base) ⁻¹' ((chartAt FourSpace c).symm '' K)
  have hLc : IsCompact L :=
    ((hK.image_of_continuousOn ((chartAt FourSpace c).continuousOn_symm.mono hKt)).isClosed.preimage
      (continuous_frameBase g)).isCompact
  have hLs (f : FrameBundle g) (hf : f ∈ L) : f.base ∈ (chartAt FourSpace c).source := by
    obtain ⟨z, hz, he⟩ := hf
    change (chartAt FourSpace c).symm z = f.base at he
    rw [← he]
    exact (chartAt FourSpace c).map_target (hKt hz)
  have hcont : ContinuousOn (fun f : FrameBundle g => tensorTransportWeight 2 (frameChartMatrix g c f)) L := by
    intro f hf
    exact ((tensorTransportWeight_continuous 2).continuousAt.comp
      (continuousAt_pi.mpr (fun i => continuousAt_pi.mpr (fun j =>
        frameChartMatrix_continuousAt g c f (hLs f hf) i j)))).continuousWithinAt
  obtain ⟨b, hb⟩ := (hLc.image_of_continuousOn hcont).isBounded.exists_norm_le
  let B := (Fintype.card (Fin 2 → Fin 4) : ℝ) * max b 0
  refine ⟨B, mul_nonneg (Nat.cast_nonneg _) (le_max_right _ _), ?_⟩
  intro F hF hFs r hr hFr
  apply (ContinuousMap.norm_le _ (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (le_max_right _ _)) hr)).mpr
  intro f
  by_cases hf : f ∈ L
  · have hw : tensorTransportWeight 2 (frameChartMatrix g c f) ≤ max b 0 :=
      (le_abs_self _).trans ((hb _ ⟨f, hf, rfl⟩).trans (le_max_left _ _))
    change ‖(WithLp.toLp 2 (heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f) : TwoTensorEuclidean)‖ ≤ _
    rw [heatNormalFrameTensorLift, ite_eq_left (show f.base ∈ (chartAt FourSpace c).symm.target from hLs f hf)]
    refine (twoTensorEuclidean_norm_le_sum _).trans ?_
    calc
      _ ≤ ∑ _a : Fin 2 → Fin 4, tensorTransportWeight 2 (frameChartMatrix g c f) * r :=
        Finset.sum_le_sum (fun a _ => frameTensor_abs_le_weight _ _ r hr (hFr _) a)
      _ = (Fintype.card (Fin 2 → Fin 4) : ℝ) * tensorTransportWeight 2 (frameChartMatrix g c f) * r := by
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring
      _ ≤ B * r := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hw (Nat.cast_nonneg _)) hr
  · have hz : heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f = 0 := by
      apply not_ne_iff.mp
      intro hn
      obtain ⟨z, hz, he⟩ := heatNormalFrameTensorLift_support g c (chartAt FourSpace c).symm F hn
      exact hf ⟨z, hFs hz, he⟩
    change ‖(WithLp.toLp 2 (heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f) : TwoTensorEuclidean)‖ ≤ _
    rw [hz]
    simpa using mul_nonneg (mul_nonneg (Nat.cast_nonneg (Fintype.card (Fin 2 → Fin 4))) (le_max_right b 0)) hr

end
end PositiveEinsteinFour.Geometry
end


section

/-! The joint geometric coefficients have exactly the geometric normal germs,
including the derivatives in the drift and connection potential. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatFamilyNormal_germs {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hP : ContDiffAt ℝ 2 P (0, frameCoordinateState g c e))
    (hpoint : D.point = fun x => P (x, frameCoordinateState g c e)) :
    ((fun x => (heatFamilyMetric g c P (x, frameCoordinateState g c e))⁻¹)
      =ᶠ[𝓝 0] (fun x => (heatNormalMetric g o e x)⁻¹)) ∧
    ((fun x => heatFamilyDrift g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalDrift g o e) ∧
    ((fun x => heatFamilyFirst g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalBundleFirst D) ∧
    ((fun x => heatFamilyZero g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalBundleZero D) ∧
    ((fun x => heatFamilyLeading g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalLeadingAmplitude g o e) := by
  let q := frameCoordinateState g c e
  have hi : Tendsto (fun x : FourSpace => (x, q)) (𝓝 0) (𝓝 (0, q)) :=
    continuousAt_id.prodMk continuousAt_const
  have hexp : (fun x => (P (x, q)).1) =ᶠ[𝓝 0]
      (fun x => chartAt FourSpace c (frameExponential g o e x)) := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    simpa only [hpoint] using D.exponential x hx
  have hm := heatFamilyMetric_exponential_germ g o c e he P (hP.of_le (by norm_num)) hexp
  have ha : (fun x => (heatFamilyMetric g c P (x, q))⁻¹) =ᶠ[𝓝 0]
      (fun x => (heatNormalMetric g o e x)⁻¹) := hm.mono fun x hx => congrArg Inv.inv hx
  have hJ := heatFamilyDensity_exponential_germ g o c e he P (hP.of_le (by norm_num)) hexp
  have hU := heatFamilyLeading_exponential_germ g o c e he P (hP.of_le (by norm_num)) hexp
  have hr := hi.eventually (hP.eventually (by simp))
  have hc : ∀ᶠ x in 𝓝 (0 : FourSpace), (P (x, q)).1 ∈ (chartAt FourSpace c).target := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    simpa only [hpoint] using D.in_chart x hx
  have hf : ∀ᶠ x in 𝓝 (0 : FourSpace), (P (x, q)).2.det ≠ 0 := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    have hg := congrArg Matrix.det (D.orthonormal x hx)
    rw [hpoint] at hg
    simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hg
    change (P (x, q)).2.det * (metricInChart g c (P (x, q)).1).det *
      (P (x, q)).2.det = 1 at hg
    intro hz
    rw [hz] at hg
    norm_num at hg
  have hmp : ∀ᶠ x in 𝓝 (0 : FourSpace), 0 < (heatFamilyMetric g c P (x, q)).det := by
    have hzero : (heatNormalMetric g o e 0).det = 1 := by
      rw [heatNormalMetric_zero, Matrix.det_one]
    have hcont : ContinuousAt (heatNormalMetric g o e) 0 :=
      continuousAt_pi.mpr fun i => continuousAt_pi.mpr fun j =>
        (heatNormalMetric_smoothAt_zero g o e i j).continuousAt
    have hdet : ContinuousAt (fun x => (heatNormalMetric g o e x).det) 0 :=
      continuous_id.matrix_det.continuousAt.comp hcont
    have hn : ∀ᶠ x in 𝓝 (0 : FourSpace), 0 < (heatNormalMetric g o e x).det :=
      hdet.preimage_mem_nhds (isOpen_Ioi.mem_nhds (by rw [hzero]; norm_num))
    filter_upwards [hm, hn] with x hx hpos
    change heatFamilyMetric g c P (x, q) = heatNormalMetric g o e x at hx
    rw [hx]
    exact hpos
  have hb : (fun x => heatFamilyDrift g c P (x, q)) =ᶠ[𝓝 0] heatNormalDrift g o e := by
    filter_upwards [hr, hc, hmp, ha.eventuallyEq_nhds, hJ.eventuallyEq_nhds]
      with x hx hcx hmx hax hJx
    funext j
    rw [heatFamilyDrift_slice g c P (x, q) hx hcx hmx j]
    exact congrFun (fourHeatDensityDrift_germ hax hJx) j
  have hA (i : Fin 4) : (fun x => heatFamilyTwoFormConnection g c P i (x, q))
      =ᶠ[𝓝 0] heatTwoFormConnection g c D.point i := by
    filter_upwards [hr] with x hx
    rw [heatFamilyTwoFormConnection_slice g c P (x, q) (hx.differentiableAt (by norm_num)) i]
    rw [hpoint]
  have hAA : ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ i : Fin 4,
      (fun y => heatFamilyTwoFormConnection g c P i (y, q)) =ᶠ[𝓝 x]
        heatTwoFormConnection g c D.point i :=
    eventually_all.mpr (fun i => (hA i).eventuallyEq_nhds)
  refine ⟨ha, hb, ?_, ?_, hU⟩
  · filter_upwards [hr, ha, hAA] with x hx hax hAx
    rw [heatFamilyFirst_slice g c P (x, q) (hx.differentiableAt (by norm_num))]
    funext i
    change fourHeatConnectionFirst _ _ i = fourHeatConnectionFirst _ _ i
    rw [hax]
    congr 1
    funext j
    exact ((hAx j).self_of_nhds).symm.trans
      (heatFamilyTwoFormConnection_slice g c P (x, q) (hx.differentiableAt (by norm_num)) j)
      |>.symm
  · filter_upwards [hr, hc, hf, hmp, ha, hb, hAA] with x hx hcx hfx hmx hax hbx hAx
    rw [heatFamilyZero_slice g c P (x, q) hx hcx hfx hmx]
    have hb' : fourHeatDensityDrift (fun y => (heatFamilyMetric g c P (y, q))⁻¹)
        (fun y => heatFamilyDensity g c P (y, q)) x = heatNormalDrift g o e x := by
      funext j
      exact (heatFamilyDrift_slice g c P (x, q) hx hcx hmx j).symm.trans (congrFun hbx j)
    rw [hax, hb']
    have hAs (i : Fin 4) : heatTwoFormConnection g c (fun y => P (y, q)) i
        =ᶠ[𝓝 x] heatTwoFormConnection g c D.point i := by rw [hpoint]
    rw [fourHeatConnectionZero_germ _ _ _ hAs]
    simp only [heatNormalBundleZero, hpoint]
    rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual one-form coefficient agreement on the full common normal ball. -/
namespace PositiveEinsteinFour.Geometry
open EinsteinFour Matrix Set Filter Metric
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise
noncomputable section
variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatFamilyOneNormal_on_ball {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hpoint : D.point = fun x => P (x, frameCoordinateState g c e))
    (r : ℝ) (hrD : r ≤ D.radius)
    (hP : ∀ x ∈ ball (0 : FourSpace) r, ContDiffAt ℝ 2 P (x, frameCoordinateState g c e))
    (hsource : ∀ x ∈ ball (0 : FourSpace) r,
      frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hdet : ∀ x ∈ ball (0 : FourSpace) r,
      0 < (heatFamilyMetric g c P (x, frameCoordinateState g c e)).det) :
    ∀ x ∈ ball (0 : FourSpace) r,
      heatFamilyOneFirst g c P (x, frameCoordinateState g c e) = heatNormalOneFirst D x ∧
      heatFamilyOneZero g c P (x, frameCoordinateState g c e) = heatNormalOneZero D x := by
  let q := frameCoordinateState g c e
  have hraw := heatFamilyNormal_on_ball D P hpoint r hrD hP hsource hdet
  have hc (x : FourSpace) (hx : x ∈ ball 0 r) : (P (x, q)).1 ∈ (chartAt FourSpace c).target := by
    simpa only [hpoint] using D.in_chart x (ball_subset_ball hrD hx)
  have hA (i : Fin 4) (x : FourSpace) (hx : x ∈ ball 0 r) :
      heatFamilyConnection g c P i (x, q) = heatNormalFrameConnection g c D.point i x := by
    rw [heatFamilyConnection_slice g c P (x, q) ((hP x hx).differentiableAt (by norm_num)) i, hpoint]
  intro x hx
  constructor
  · unfold heatFamilyOneFirst heatNormalOneFirst
    rw [(hraw x hx).1]
    funext i
    congr 1
    funext j
    exact hA j x hx
  · have hframe : (P (x, q)).2.det ≠ 0 := by
      have hg := congrArg Matrix.det (D.orthonormal x (ball_subset_ball hrD hx))
      rw [hpoint] at hg
      simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hg
      change (P (x, q)).2.det * (metricInChart g c (P (x, q)).1).det * (P (x, q)).2.det = 1 at hg
      intro hz
      rw [hz] at hg
      norm_num at hg
    rw [heatFamilyOneZero_slice g c P (x, q) (hP x hx) (hc x hx) hframe (hdet x hx), (hraw x hx).1]
    have hb : fourHeatDensityDrift (fun y => (heatFamilyMetric g c P (y, q))⁻¹)
        (fun y => heatFamilyDensity g c P (y, q)) x = heatNormalDrift g o e x := by
      funext j
      exact (heatFamilyDrift_slice g c P (x, q) (hP x hx) (hc x hx) (hdet x hx) j).symm.trans
        (congrFun (hraw x hx).2.1 j)
    rw [hb]
    simp only [heatNormalOneZero, hpoint]
    rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! The global L2 amplitude has the expected scalar base integral against
every actual smooth test section. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter MeasureTheory
open scoped Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

local instance heatNormalAmplitudePairing_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem heatNormalAmplitudeL2_pairing_base (D : HeatNormalFrameData g o c e)
    (C : OpenPartialHomeomorph FourSpace M)
    (hE : EqOn C (frameExponential g o e) C.source)
    (hCt : C.target ⊆ (chartAt FourSpace c).source)
    (hP : ContDiffOn ℝ 2 D.point C.source) (hD : C.source ⊆ Metric.ball 0 D.radius)
    (a : FourSpace → TwoFormFour) (ha : ContDiff ℝ 2 a) (hc : HasCompactSupport a)
    (hs : tsupport a ⊆ C.source) (v : SmoothL2TwoForm o) :
    inner ℝ (heatNormalAmplitudeL2 D C hCt hP hD a ha hc hs) (smoothTwoFormToL2 v) =
      ∫ y, heatNormalScalarLift C
        (fun x => inner ℝ (a x) (heatNormalTwoFormValue o c D.point
          (v : smoothTwoForms o).val x)) y ∂normalizedVolume g := by
  let ψ := fun x => inner ℝ (a x) (heatNormalTwoFormValue o c D.point
    (v : smoothTwoForms o).val x)
  have hψs : tsupport ψ ⊆ tsupport a := by
    apply closure_mono
    intro x hx
    contrapose! hx
    have ha0 := Function.notMem_support.mp hx
    apply Function.notMem_support.mpr
    simp only [ψ, ha0, inner_zero_left]
  have hψc : HasCompactSupport ψ := hc.of_isClosed_subset (isClosed_tsupport _) hψs
  have hψ : ContinuousOn ψ C.source := by
    intro x hx
    have hv := heatNormalTwoFormValue_contDiffAt 2 (v : smoothTwoForms o).property c D.point x
      (hP.contDiffAt (C.open_source.mem_nhds hx)) (D.in_chart x (hD hx))
    exact (ha.continuous.continuousAt.inner hv.continuousAt).continuousWithinAt
  have hL := heatNormalScalarLift_continuous C ψ hψ hψc (hψs.trans hs)
  have hLi : Integrable (heatNormalScalarLift C ψ) (normalizedVolume g) :=
    hL.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  rw [heatNormalAmplitudeL2_pairing]
  have hp (f : FrameBundle g) :
      inner ℝ (heatNormalAmplitudeTensor D C hCt hP hD a ha hc hs f)
        (smoothTwoFormEuclideanValue (v : smoothTwoForms o) f) =
      2 * heatNormalScalarLift C ψ f.base :=
    heatNormalLift_pairing D C hE hCt hD a (v : smoothTwoForms o).val f
  simp_rw [hp]
  rw [integral_const_mul, canonicalFrameMeasure_integral_base g o _ hLi]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! At the center of the normal frame, the zeroth-order bundle coefficient
is precisely the intrinsic Weitzenböck potential. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.bundleFirst_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i : Fin 4) : heatNormalBundleFirst D 0 i = 0 := by
  simp [heatNormalBundleFirst, fourHeatConnectionFirst, D.twoForm_connection_zero]

theorem HeatNormalFrameData.bundleZero_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) :
    heatNormalBundleZero D 0 = heatNormalPotential g c D.point 0 := by
  ext k l
  simp [heatNormalBundleZero, fourHeatConnectionZero, heatNormalMetric_zero,
    D.twoForm_connection_zero, D.twoForm_connection_diagonal_zero, Matrix.one_apply]

theorem HeatNormalFrameData.frame_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    D.frame 0 (mem_ball_self D.radius_pos) = e := by
  unfold HeatNormalFrameData.frame
  simpa only [D.initial, frameCoordinateState] using chartFrameStateToBundle_fromFrame g c e he

theorem HeatNormalFrameData.curvature_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    heatNormalFrameCurvature g c D.point 0 = twoFormMetricCurvatureTensor g e := by
  rw [D.curvature_as_actual 0 (mem_ball_self D.radius_pos), D.frame_zero he]

theorem HeatNormalFrameData.bundleZero_intrinsic_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    heatNormalBundleZero D 0 = twoFormPotentialMatrix (twoFormMetricCurvatureTensor g e) := by
  rw [D.bundleZero_center, heatNormalPotential, D.curvature_center he]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first connection jet in radial gauge is alternating in the
radial and derivative indices. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter
open scoped BigOperators ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_partial_sum_four (F : Fin 4 → FourSpace → ℝ) (x : FourSpace)
    (hF : ∀ k, DifferentiableAt ℝ (F k) x) (i : Fin 4) :
    partialDeriv (fun y => ∑ k, F k y) i x = ∑ k, partialDeriv (F k) i x := by
  unfold partialDeriv
  rw [fderiv_fun_sum (u := Finset.univ) (A := F) (fun k _ => hF k), _root_.sum_apply]

theorem heat_partial_second_sum_four (F : Fin 4 → FourSpace → ℝ) (x : FourSpace)
    (hF : ∀ k, ContDiffAt ℝ 2 (F k) x) (i j : Fin 4) :
    partialDeriv (partialDeriv (fun y => ∑ k, F k y) i) j x =
      ∑ k, partialDeriv (partialDeriv (F k) i) j x := by
  have hn : ∀ᶠ y in 𝓝 x, ∀ k, DifferentiableAt ℝ (F k) y := by
    apply eventually_all.mpr
    intro k
    filter_upwards [(hF k).eventually (by norm_num)] with y hy
    exact hy.differentiableAt (by norm_num)
  have he : partialDeriv (fun y => ∑ k, F k y) i =ᶠ[𝓝 x]
      (fun y => ∑ k, partialDeriv (F k) i y) := by
    filter_upwards [hn] with y hy
    exact heat_partial_sum_four F y hy i
  rw [fourHeat_partial_germ he j]
  apply heat_partial_sum_four
  intro k
  exact (((hF k).fderiv_right (m := 1) (by norm_num)).clm_apply
    (contDiffAt_const (c := coordinateVector i))).differentiableAt one_ne_zero

theorem heat_partial_coordinate (k i : Fin 4) (x : FourSpace) :
    partialDeriv (fun y : FourSpace => y k) i x = if i = k then 1 else 0 := by
  change (fderiv ℝ (EuclideanSpace.proj k) x) (coordinateVector i) = _
  rw [(EuclideanSpace.proj k : FourSpace →L[ℝ] ℝ).hasFDerivAt.fderiv]
  simp [coordinateVector, PiLp.single_apply, eq_comm]

theorem heat_partial_second_coordinate (k i j : Fin 4) (x : FourSpace) :
    partialDeriv (partialDeriv (fun y : FourSpace => y k) i) j x = 0 := by
  have he : partialDeriv (fun y : FourSpace => y k) i = fun _ => if i = k then 1 else 0 :=
    funext (heat_partial_coordinate k i)
  rw [he]
  simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]

theorem heat_radial_first_jet_alternating (A : Fin 4 → FourSpace → ℝ)
    (hA : ∀ k, ContDiffAt ℝ 2 (A k) 0)
    (hR : (fun x : FourSpace => ∑ k, x k * A k x) =ᶠ[𝓝 0] fun _ => 0)
    (i j : Fin 4) :
    partialDeriv (A i) j 0 + partialDeriv (A j) i 0 = 0 := by
  let R := fun x : FourSpace => ∑ k, x k * A k x
  have he : partialDeriv R i =ᶠ[𝓝 0] fun _ => 0 := by
    filter_upwards [hR.eventuallyEq_nhds] with x hx
    rw [fourHeat_partial_germ hx i]
    simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]
  have hzero : partialDeriv (partialDeriv R i) j 0 = 0 := by
    rw [fourHeat_partial_germ he j]
    simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]
  have hf (k : Fin 4) : ContDiffAt ℝ 2 (fun y : FourSpace => y k * A k y) 0 :=
    (EuclideanSpace.proj k).contDiff.contDiffAt.mul (hA k)
  rw [heat_partial_second_sum_four _ 0 hf i j] at hzero
  have hprod (k : Fin 4) :
      partialDeriv (partialDeriv (fun y : FourSpace => y k * A k y) i) j 0 =
        (if i = k then 1 else 0) * partialDeriv (A k) j 0 +
        (if j = k then 1 else 0) * partialDeriv (A k) i 0 := by
    have hc : ContDiffAt ℝ 2 (fun y : FourSpace => y k) 0 :=
      (EuclideanSpace.proj k : FourSpace →L[ℝ] ℝ).contDiff.contDiffAt
    rw [scalar_partial_second_product_at (fun y : FourSpace => y k) (A k) 0
      hc (hA k) i j,
      heat_partial_coordinate, heat_partial_coordinate, heat_partial_second_coordinate]
    simp
  simp_rw [hprod] at hzero
  simpa only [Finset.sum_add_distrib, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
    Finset.mem_univ, ite_true] using hzero

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem HeatNormalFrameData.twoForm_connection_first_jet
    (D : HeatNormalFrameData g o c e) (i j : Fin 4) (k l : Fin 6) :
    partialDeriv (fun x => heatTwoFormConnection g c D.point i x k l) j 0 +
      partialDeriv (fun x => heatTwoFormConnection g c D.point j x k l) i 0 = 0 := by
  apply heat_radial_first_jet_alternating
    (fun a x => heatTwoFormConnection g c D.point a x k l) _ _ i j
  · intro a
    exact (D.twoForm_connection_regular a k l).of_le (by norm_num)
  · filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    have h := congrArg (fun B : HeatMat6 => B k l) (D.twoForm_connection_radial x hx)
    simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply] using h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Four C4 scalar transport amplitudes. Ten derivatives of the
extended normal coefficients give four derivatives of each amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {e : FrameBundle g}

def HeatNormalExtension.scalarAmplitude (E : HeatNormalExtension 10 g o e)
    (m : ℕ) : FourSpace → ℝ :=
  fourHeatCoefficient E.a E.b (fun _ => 0) E.U m

theorem HeatNormalExtension.scalarAmplitude_regular (E : HeatNormalExtension 10 g o e)
    (m : ℕ) (hm : m ≤ 3) : ContDiff ℝ 4 (E.scalarAmplitude m) := by
  have hle : ((4 + 2 * m : ℕ) : ℕ∞ω) ≤ 10 := by
    exact_mod_cast (show 4 + 2 * m ≤ 10 by omega)
  exact fourHeatCoefficient_contDiff_two m 4 E.a E.b (fun _ => 0) E.U
    (fun i j => (E.a_regular i j).of_le hle)
    (fun i => (E.b_regular i).of_le hle) contDiff_const (E.U_regular.of_le hle)
    (fun x => (E.U_pos x).ne')

theorem HeatNormalExtension.scalarAmplitude_zero (E : HeatNormalExtension 10 g o e) :
    E.scalarAmplitude 0 0 = 1 :=
  E.U_near.self_of_nhds.trans (heatNormalLeadingAmplitude_zero g o e)

theorem HeatNormalExtension.scalarAmplitude_transport (E : HeatNormalExtension 10 g o e)
    (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      fourHeatEikonalDefect (E.a x) x = 0 ∧
      fourHeatRadialTransport (E.a x) (E.b x) (E.scalarAmplitude 0) x = 0 ∧
      ∀ m ≤ 2, fourHeatRadialTransport (E.a x) (E.b x) (E.scalarAmplitude (m + 1)) x +
        (m + 1 : ℝ) * E.scalarAmplitude (m + 1) x =
        -fourHeatLocalOperator (E.a x) (E.b x) 0 (E.scalarAmplitude m) x := by
  obtain ⟨r, hr, hT⟩ := E.transport_neighborhood hRic he
  refine ⟨r, hr, ?_⟩
  intro x hx
  obtain ⟨hrow, hcol, hE, hU⟩ := hT x hx
  refine ⟨hE, hU, ?_⟩
  intro m hm
  exact fourHeatCoefficient_transport m E.a E.b (fun _ => 0) E.U x
    (E.U_regular.of_le (by norm_num)) (fun y => (E.U_pos y).ne')
    (fun i j => (E.a_regular i j).of_le (by norm_num))
    (fun i => (E.b_regular i).of_le (by norm_num)) contDiff_const
    ((E.scalarAmplitude_regular m (by omega)).of_le (by norm_num)) hrow hcol hU

def HeatNormalExtension.scalarParametrix (E : HeatNormalExtension 10 g o e)
    (t : ℝ) (x : FourSpace) : ℝ :=
  fourHeatGaussian t x * fourHeatPolynomial (fun m : Fin 4 => E.scalarAmplitude m) t x

theorem HeatNormalExtension.scalarParametrix_regular (E : HeatNormalExtension 10 g o e)
    (t : ℝ) : ContDiff ℝ 4 (E.scalarParametrix t) := by
  have hu (m : Fin 4) := E.scalarAmplitude_regular m (by omega)
  exact (fourHeatGaussian_smooth t).of_le (by simp) |>.mul
    ((((hu 0).add (contDiff_const.mul (hu 1))).add
      (contDiff_const.mul (hu 2))).add (contDiff_const.mul (hu 3)))

theorem HeatNormalExtension.scalarParametrix_residual (E : HeatNormalExtension 10 g o e)
    (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r, ∀ t > (0 : ℝ),
      deriv (fun s => E.scalarParametrix s x) t +
        fourHeatLocalOperator (E.a x) (E.b x) 0 (E.scalarParametrix t) x =
      fourHeatGaussian t x * t ^ 3 *
        fourHeatLocalOperator (E.a x) (E.b x) 0 (E.scalarAmplitude 3) x := by
  obtain ⟨r, hr, hT⟩ := E.scalarAmplitude_transport hRic he
  refine ⟨r, hr, ?_⟩
  intro x hx t ht
  obtain ⟨hE, h0, hnext⟩ := hT x hx
  apply fourHeatPolynomial_gaussian_residual _ _ _ _
    (fun m => (E.scalarAmplitude_regular m (by omega)).of_le (by norm_num)) t ht x hE h0
  · simpa using hnext 0 (by omega)
  · convert hnext 1 (by omega) using 1 <;> norm_num
  · convert hnext 2 (by omega) using 1 <;> norm_num

end
end PositiveEinsteinFour.Geometry
end


section

/-! The genuine scalar heat operator lifts boundedly to continuous functions
on the compact manifold. Closedness of its graph follows from the L2 identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o)) (t : ℝ≥0) (ht : 0 < t)

local instance scalarHeatContinuous_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarHeatContinuousValue (f : Lp ℝ 2 (normalizedVolume g)) : C(M, ℝ) :=
  ⟨(scalarBaseHeat_smooth_representative g o d t ht f).choose.val,
    (scalarBaseHeat_smooth_representative g o d t ht f).choose.property.continuous⟩

theorem scalarHeatContinuousValue_L2 (f : Lp ℝ 2 (normalizedVolume g)) :
    ContinuousMap.toLp 2 (normalizedVolume g) ℝ (scalarHeatContinuousValue g o d t ht f) =
      scalarBaseHeat g o d t f :=
  (scalarBaseHeat_smooth_representative g o d t ht f).choose_spec.symm

def scalarHeatContinuousLinear : Lp ℝ 2 (normalizedVolume g) →ₗ[ℝ] C(M, ℝ) where
  toFun := scalarHeatContinuousValue g o d t ht
  map_add' f h := by
    let := normalizedVolume_isOpenPosMeasure g
    apply ContinuousMap.toLp_injective (p := 2) (𝕜 := ℝ) (normalizedVolume g)
    rw [map_add, scalarHeatContinuousValue_L2, scalarHeatContinuousValue_L2,
      scalarHeatContinuousValue_L2, map_add]
  map_smul' c f := by
    let := normalizedVolume_isOpenPosMeasure g
    apply ContinuousMap.toLp_injective (p := 2) (𝕜 := ℝ) (normalizedVolume g)
    rw [map_smul, scalarHeatContinuousValue_L2, scalarHeatContinuousValue_L2, map_smul]
    rfl

theorem scalarHeatContinuous_graph_closed :
    IsClosed ((scalarHeatContinuousLinear g o d t ht).graph :
      Set (Lp ℝ 2 (normalizedVolume g) × C(M, ℝ))) := by
  have heq : ((scalarHeatContinuousLinear g o d t ht).graph :
      Set (Lp ℝ 2 (normalizedVolume g) × C(M, ℝ))) =
      {p | ContinuousMap.toLp 2 (normalizedVolume g) ℝ p.2 = scalarBaseHeat g o d t p.1} := by
    ext p
    change p.2 = scalarHeatContinuousValue g o d t ht p.1 ↔
      ContinuousMap.toLp 2 (normalizedVolume g) ℝ p.2 = scalarBaseHeat g o d t p.1
    constructor
    · intro hp
      rw [hp]
      exact scalarHeatContinuousValue_L2 g o d t ht p.1
    · intro h
      let := normalizedVolume_isOpenPosMeasure g
      apply ContinuousMap.toLp_injective (p := 2) (𝕜 := ℝ) (normalizedVolume g)
      exact h.trans (scalarHeatContinuousValue_L2 g o d t ht p.1).symm
  rw [heq]
  exact isClosed_eq ((ContinuousMap.toLp 2 (normalizedVolume g) ℝ).continuous.comp continuous_snd)
    ((scalarBaseHeat g o d t).continuous.comp continuous_fst)

def scalarHeatToContinuous : Lp ℝ 2 (normalizedVolume g) →L[ℝ] C(M, ℝ) :=
  ContinuousLinearMap.ofIsClosedGraph (scalarHeatContinuous_graph_closed g o d t ht)

theorem scalarHeatToContinuous_L2 (f : Lp ℝ 2 (normalizedVolume g)) :
    ContinuousMap.toLp 2 (normalizedVolume g) ℝ (scalarHeatToContinuous g o d t ht f) =
      scalarBaseHeat g o d t f := scalarHeatContinuousValue_L2 g o d t ht f

theorem scalarHeatToContinuous_bound (f : Lp ℝ 2 (normalizedVolume g)) (x : M) :
    |scalarHeatToContinuous g o d t ht f x| ≤ ‖scalarHeatToContinuous g o d t ht‖ * ‖f‖ := by
  have hc : |scalarHeatToContinuous g o d t ht f x| ≤
      ‖scalarHeatToContinuous g o d t ht f‖ :=
    ContinuousMap.norm_coe_le_norm (scalarHeatToContinuous g o d t ht f) x
  exact hc.trans ((scalarHeatToContinuous g o d t ht).le_opNorm f)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Removing the smooth positive density from the actual local H2 solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric Filter
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_weighted_H2_unweight (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ)
    (ht : ∀ y ∈ closedBall (0 : V) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (b : M → ℝ) (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : 𝓢(V, ℂ), HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ closedBall (0 : V) (1 / 2)) :
    ∃ v : Lp ℂ 2 (volume : Measure V), MemSobolev 2 2 (v : T) ∧
      (v : V → ℂ) =ᵐ[volume] fun y =>
        (χ y * b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y)) : ℝ) := by
  let ρ : V → ℝ := fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y)
  have hρ (y : V) (hy : y ∈ tsupport χ) : ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y := by
    have hyt : scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
      ht y (closedBall_subset_closedBall (by norm_num) (hs hy))
    apply ContDiffAt.inv
    · exact (chartVolumeDensity_contDiffAt g c _ hyt).comp y (by
        unfold scalarRescaledPoint
        fun_prop)
    · exact (chartVolumeDensity_pos g c _ hyt).ne'
  exact scalar_H2_density_division ρ
    (fun y => b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) w
    heq hreg χ hχ hc hs hρ (fun y hy =>
      (chartVolumeDensity_pos g c _
        (ht y (closedBall_subset_closedBall (by norm_num) (hs hy)))).ne')

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual local smooth Sobolev regularity for a positive continuous weak Euler solution.
All coefficients, density factors and localized nonlinear sources are constructed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance positiveEulerAllOrders_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_positive_Euler_local_all_orders (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (v : M → ℝ) (hv : Continuous v) (hpos : ∀ x, 0 < v x)
    (hurep : (scalarH1BaseValue g o d u : M → ℝ) =ᵐ[normalizedVolume g] v)
    (α β q : ℝ)
    (hf : (f : M → ℝ) =ᵐ[normalizedVolume g] fun x => α * v x + β * (v x) ^ q)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure V),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          v ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w ∧
        ∀ n : ℕ, ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
          MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := scalarRescaledSourceL2 g c f χ hχ hc ht z₀ r hr.ne'
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d f u hw c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c f χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  have htests (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ =
        ∫ y, φ y * ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F w a b
      (ball 0 1) hA hB hreal φ hφc hφs (scalar_real_L2_test_integrable F φ _)
  have hwbase : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarH1BaseValue g o d u
        ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
          volume.restrict (ball (0 : V) 1)] w := by
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ w₀
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w y = w₀ (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm

  let ρ : V → ℝ := fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y)
  let b₀ : V → ℝ := fun y => v ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))
  have hurep' := scalar_rescaled_ae_predicate g c z₀ r hr.ne'
    (fun x => scalarH1BaseValue g o d u x = v x) hurep
  have hwv : (fun y => ρ y * b₀ y) =ᵐ[volume.restrict (ball (0 : V) 1)] w := by
    filter_upwards [hwbase, ae_restrict_of_ae hurep',
      ae_restrict_mem isOpen_ball.measurableSet] with y hy huv hyB
    exact (congrArg (fun t : ℝ => ρ y * t) (huv (htarget y hyB))).symm.trans hy
  have hreg2 (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2)) :
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
    exact scalar_ball_L2_forcing_gain a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
      (scalarComplexL2 w : T) (fun y => ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ))
      (((Lp.memLp F).const_mul _).ofReal) hW htests
      (1 / 2) (by norm_num) (by norm_num) φ hφc hφs
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹
  let Ft := scalarComplexL2 (κ • F)
  have hpair (φ : S) : (Ft : T) φ = ∫ y, φ y * ((κ * F y : ℝ) : ℂ) := by
    rw [Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [scalarComplexL2_coe (κ • F), Lp.coeFn_smul κ F] with y hc hs
    rw [hc, hs]
    rfl
  have htests' (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ = (Ft : T) φ :=
    (htests φ hφc hφs).trans (hpair φ).symm
  have hρ (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) : ContDiffAt ℝ ∞ ρ y :=
    (chartVolumeDensity_contDiffAt g c _
      (htarget y (closedBall_subset_ball (by norm_num) hy))).comp y (by
        unfold scalarRescaledPoint
        fun_prop)
  have hρ0 (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) : ρ y ≠ 0 :=
    (chartVolumeDensity_pos g c _
      (htarget y (closedBall_subset_ball (by norm_num) hy))).ne'
  obtain ⟨L, U, hL, hU, hrange⟩ := scalar_positive_continuous_range v hv hpos
  have hf' := scalar_rescaled_ae_predicate g c z₀ r hr.ne'
    (fun x => f x = α * v x + β * (v x) ^ q) hf
  have hFt : (Ft : V → ℂ) =ᵐ[volume.restrict (ball (0 : V) (1 / 2))]
      fun y => (ρ y * ((κ * r ^ 2 * α) * b₀ y +
        (κ * r ^ 2 * β) * (b₀ y) ^ q) : ℝ) := by
    filter_upwards [ae_restrict_of_ae (scalarComplexL2_coe (κ • F)),
      ae_restrict_of_ae (Lp.coeFn_smul κ F),
      ae_restrict_of_ae (scalarRescaledSourceL2_coe g c f χ hχ hc ht z₀ r hr.ne'),
      ae_restrict_of_ae hf', ae_restrict_mem isOpen_ball.measurableSet]
      with y hC hmul hF hfY hy
    have hy1 : y ∈ closedBall (0 : V) 1 :=
      closedBall_subset_closedBall (by norm_num) (ball_subset_closedBall hy)
    change scalarComplexL2 (κ • F) y = _
    rw [hC, hmul]
    change ((κ * F y : ℝ) : ℂ) = _
    rw [hF, (hchart r hr₁ y hy1).2, hfY (htarget y
      (ball_subset_ball (by norm_num) hy))]
    congr 1
    dsimp only [ρ, b₀]
    ring
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, w, hwv, ?_⟩
  exact scalar_local_positive_Euler_all_orders a (scalarAdjointDrift a b)
    scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
    scalarEllipticSmallSize_small (-scalarAdjointPotential a b) w hW hreg2
    ρ b₀ hwv hρ hρ0 L U q (κ * r ^ 2 * α) (κ * r ^ 2 * β)
    hL hU (fun y _ => hrange _) Ft hFt
    (fun ψ hc hs => htests' ψ hc (hs.trans (ball_subset_ball (by norm_num))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The finite-dimensional weak solution space of the actual curvature
equation, and its positive and negative Hodge summands. Identifying this
space with de Rham harmonic forms uses the exterior differential identities. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormWeitzenbockKernel : Submodule ℝ (TwoFormH1 o) :=
  twoFormWeakPotentialKernel twoFormWeitzenbockPotential

instance twoFormWeitzenbockKernel_finite : FiniteDimensional ℝ (twoFormWeitzenbockKernel (o := o)) :=
  twoFormWeakPotentialKernel_finite _

theorem twoFormWeitzenbockKernel_hodge (hRic : RicciThree g) (u : TwoFormH1 o)
    (hu : u ∈ twoFormWeitzenbockKernel) : twoFormH1Hodge u ∈ twoFormWeitzenbockKernel := by
  have he := (mem_twoFormWeakPotentialKernel twoFormWeitzenbockPotential u).mp hu
  apply (mem_twoFormWeakPotentialKernel _ _).mpr
  calc
    _ = twoFormH1Hodge (twoFormRoughSolution (twoFormWeitzenbockPotential (twoFormH1ToL2 u))) :=
      congrArg twoFormH1Hodge he
    _ = twoFormRoughSolution (twoFormL2Hodge (twoFormWeitzenbockPotential (twoFormH1ToL2 u))) :=
      (twoFormRoughSolution_hodge _).symm
    _ = _ := by rw [twoFormH1ToL2_hodge, twoFormWeitzenbockPotential_hodge hRic]

def twoFormKernelHodge (hRic : RicciThree g) :
    twoFormWeitzenbockKernel (o := o) →ₗ[ℝ] twoFormWeitzenbockKernel (o := o) where
  toFun u := ⟨twoFormH1Hodge u.val, twoFormWeitzenbockKernel_hodge hRic u.val u.property⟩
  map_add' u v := Subtype.ext (map_add twoFormH1Hodge u.val v.val)
  map_smul' r u := Subtype.ext (map_smul twoFormH1Hodge r u.val)

theorem twoFormKernelHodge_involutive (hRic : RicciThree g) :
    Function.Involutive (twoFormKernelHodge (o := o) hRic) := by
  intro u
  apply Subtype.ext
  exact twoFormH1Hodge_involutive u.val

def twoFormPositiveWeakKernel (hRic : RicciThree g) :
    Submodule ℝ (twoFormWeitzenbockKernel (o := o)) :=
  Module.End.eigenspace (twoFormKernelHodge hRic) 1

def twoFormNegativeWeakKernel (hRic : RicciThree g) :
    Submodule ℝ (twoFormWeitzenbockKernel (o := o)) :=
  Module.End.eigenspace (twoFormKernelHodge hRic) (-1)

instance twoFormPositiveWeakKernel_finite (hRic : RicciThree g) :
    FiniteDimensional ℝ (twoFormPositiveWeakKernel (o := o) hRic) := inferInstance

instance twoFormNegativeWeakKernel_finite (hRic : RicciThree g) :
    FiniteDimensional ℝ (twoFormNegativeWeakKernel (o := o) hRic) := inferInstance

def twoFormKernelPlus (hRic : RicciThree g) (u : twoFormWeitzenbockKernel (o := o)) :
    twoFormPositiveWeakKernel (o := o) hRic :=
  ⟨(2 : ℝ)⁻¹ • (u + twoFormKernelHodge hRic u), by
    apply Module.End.mem_eigenspace_iff.mpr
    rw [map_smul, map_add, twoFormKernelHodge_involutive, one_smul]
    rw [add_comm]⟩

def twoFormKernelMinus (hRic : RicciThree g) (u : twoFormWeitzenbockKernel (o := o)) :
    twoFormNegativeWeakKernel (o := o) hRic :=
  ⟨(2 : ℝ)⁻¹ • (u - twoFormKernelHodge hRic u), by
    apply Module.End.mem_eigenspace_iff.mpr
    rw [map_smul, map_sub, twoFormKernelHodge_involutive, neg_one_smul]
    module⟩

theorem twoFormKernel_decomposition (hRic : RicciThree g)
    (u : twoFormWeitzenbockKernel (o := o)) :
    (twoFormKernelPlus hRic u).val + (twoFormKernelMinus hRic u).val = u := by
  change (2 : ℝ)⁻¹ • (u + twoFormKernelHodge hRic u) +
    (2 : ℝ)⁻¹ • (u - twoFormKernelHodge hRic u) = u
  module

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact cancellation of the first four matrix heat amplitudes. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatBundlePolynomial_gaussian_residual (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6)
    (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (hu : ∀ i k, ContDiff ℝ 2 (fun y => u i y k))
    (t : ℝ) (ht : 0 < t) (x : FourSpace)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0)
    (hE : fourHeatEikonalDefect a x = 0)
    (h0 : ∀ k, fourHeatRadialTransport a b (fun y => u 0 y k) x = 0)
    (h1 : ∀ k, fourHeatRadialTransport a b (fun y => u 1 y k) x + u 1 x k =
      -fourHeatBundleOperator a b B C (u 0) x k)
    (h2 : ∀ k, fourHeatRadialTransport a b (fun y => u 2 y k) x + 2 * u 2 x k =
      -fourHeatBundleOperator a b B C (u 1) x k)
    (h3 : ∀ k, fourHeatRadialTransport a b (fun y => u 3 y k) x + 3 * u 3 x k =
      -fourHeatBundleOperator a b B C (u 2) x k) (k : Fin 6) :
    deriv (fun s => fourHeatGaussian s x * fourHeatBundlePolynomial u s x k) t +
      fourHeatBundleOperator a b B C
        (fun y l => fourHeatGaussian t y * fourHeatBundlePolynomial u t y l) x k =
      fourHeatGaussian t x * t ^ 3 * fourHeatBundleOperator a b B C (u 3) x k := by
  have hP (l : Fin 6) : ContDiff ℝ 2 (fun y => fourHeatBundlePolynomial u t y l) :=
    fourHeatPolynomial_contDiff (fun m y => u m y l) (fun m => hu m l) t
  have hd := (fourHeatGaussian_hasDerivAt_time t ht x).mul
    (fourHeatPolynomial_hasDerivAt (fun m y => u m y k) t x)
  change HasDerivAt (fun s => fourHeatGaussian s x * fourHeatBundlePolynomial u s x k) _ t at hd
  have hr := fourHeatBundleOperator_transport_residual_at a b B C t ht
    (fourHeatBundlePolynomial u t) x (fun l => (hP l).contDiffAt) hB k
  rw [(fourHeatGaussian_amplitude_time t ht (fun y => fourHeatBundlePolynomial u t y k) x).deriv,
    hE, zero_div, zero_mul, add_zero] at hr
  rw [fourHeatBundlePolynomial_operator a b B C u hu t x k] at hr
  have hT := fourHeatPolynomial_transport a b (fun m y => u m y k) (fun m => hu m k) t x
  change fourHeatRadialTransport a b (fun y => fourHeatBundlePolynomial u t y k) x = _ at hT
  rw [hT, h0] at hr
  have h1' : fourHeatRadialTransport a b (fun y => u 1 y k) x =
      -fourHeatBundleOperator a b B C (u 0) x k - u 1 x k := by linarith only [h1 k]
  have h2' : fourHeatRadialTransport a b (fun y => u 2 y k) x =
      -fourHeatBundleOperator a b B C (u 1) x k - 2 * u 2 x k := by linarith only [h2 k]
  have h3' : fourHeatRadialTransport a b (fun y => u 3 y k) x =
      -fourHeatBundleOperator a b B C (u 2) x k - 3 * u 3 x k := by linarith only [h3 k]
  rw [h1', h2', h3'] at hr
  rw [hd.deriv]
  calc
    _ = fourHeatGaussian t x * (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) *
          fourHeatBundlePolynomial u t x k +
        fourHeatBundleOperator a b B C
          (fun y l => fourHeatGaussian t y * fourHeatBundlePolynomial u t y l) x k +
        fourHeatGaussian t x * (u 1 x k + 2 * t * u 2 x k + 3 * t ^ 2 * u 3 x k) := by
          dsimp only [fourHeatBundlePolynomial]
          ring
    _ = _ := by rw [hr]; field_simp [ht.ne']; ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The coordinate product rule for two successive covariant derivatives
of six-component fields. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatCovariantDerivative (A : Fin 4 → FourSpace → HeatMat6)
    (u : FourSpace → Fin 6 → ℝ) (i : Fin 4) (x : FourSpace) (k : Fin 6) : ℝ :=
  partialDeriv (fun y => u y k) i x + ∑ l : Fin 6, A i x k l * u x l

theorem fourHeat_partial_sum_six (f : Fin 6 → FourSpace → ℝ) (x : FourSpace)
    (hf : ∀ l, DifferentiableAt ℝ (f l) x) (i : Fin 4) :
    partialDeriv (fun y => ∑ l : Fin 6, f l y) i x =
      ∑ l : Fin 6, partialDeriv (f l) i x := by
  unfold partialDeriv
  rw [fderiv_fun_sum (u := Finset.univ) (A := f) (fun l _ => hf l), _root_.sum_apply]

theorem fourHeatCovariantDerivative_partial (A : Fin 4 → FourSpace → HeatMat6)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (i j : Fin 4) (k : Fin 6) :
    partialDeriv (fun y => fourHeatCovariantDerivative A u i y k) j x =
      partialDeriv (partialDeriv (fun y => u y k) i) j x +
        (∑ l : Fin 6, partialDeriv (fun y => A i y k l) j x * u x l) +
        ∑ l : Fin 6, A i x k l * partialDeriv (fun y => u y l) j x := by
  have hu0 (l : Fin 6) : DifferentiableAt ℝ (fun y => u y l) x :=
    (hu l).differentiableAt (by norm_num)
  have hdu : DifferentiableAt ℝ (partialDeriv (fun y => u y k) i) x :=
    (((hu k).fderiv_right (m := 1) (by norm_num)).clm_apply
      (contDiffAt_const (c := coordinateVector i))).differentiableAt one_ne_zero
  have hprod (l : Fin 6) : DifferentiableAt ℝ (fun y => A i y k l * u y l) x :=
    (hA i k l).mul (hu0 l)
  have hsum : DifferentiableAt ℝ (fun y => ∑ l : Fin 6, A i y k l * u y l) x :=
    DifferentiableAt.fun_sum (u := Finset.univ) (fun l _ => hprod l)
  unfold fourHeatCovariantDerivative
  rw [fourHeat_partial_add (partialDeriv (fun y => u y k) i)
    (fun y => ∑ l : Fin 6, A i y k l * u y l) x hdu hsum j,
    fourHeat_partial_sum_six (fun l y => A i y k l * u y l) x hprod j]
  simp only [scalar_partial_product _ _ x (hA i k _) (hu0 _) j, Finset.sum_add_distrib]
  ring

theorem fourHeatCovariantDerivative_second (A : Fin 4 → FourSpace → HeatMat6)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (i j : Fin 4) (k : Fin 6) :
    fourHeatCovariantDerivative A (fourHeatCovariantDerivative A u i) j x k =
      partialDeriv (partialDeriv (fun y => u y k) i) j x +
        (∑ l : Fin 6, A i x k l * partialDeriv (fun y => u y l) j x) +
        (∑ l : Fin 6, A j x k l * partialDeriv (fun y => u y l) i x) +
        ∑ l : Fin 6, (partialDeriv (fun y => A i y k l) j x +
          (A j x * A i x) k l) * u x l := by
  change partialDeriv (fun y => fourHeatCovariantDerivative A u i y k) j x +
    (∑ l : Fin 6, A j x k l * fourHeatCovariantDerivative A u i x l) = _
  rw [fourHeatCovariantDerivative_partial A u x hA hu]
  have hquad : (∑ l : Fin 6, A j x k l * ∑ q : Fin 6, A i x l q * u x q) =
      ∑ q : Fin 6, (A j x * A i x) k q * u x q := by
    simp only [Finset.mul_sum, Matrix.mul_apply, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro q _
    apply Finset.sum_congr rfl
    intro l _
    ring
  simp only [fourHeatCovariantDerivative, mul_add, Finset.sum_add_distrib]
  rw [hquad]
  simp only [add_mul, Finset.sum_add_distrib]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact second moments of the actual four-dimensional heat Gaussian.
The normalization is obtained by integration by parts against coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped BigOperators

noncomputable section

theorem fourHeatGaussian_quadratic_majorant_integrable (t : ℝ) (ht : 0 < t) :
    Integrable (fun x : FourSpace => (‖x‖ ^ 2 + 1) * fourHeatGaussian t x) := by
  convert (fourHeatGaussian_moment_integrable 1 t ht).add
    (fourHeatGaussian_integrable t ht) using 1
  funext x
  norm_num
  ring

theorem fourHeatGaussian_coordinate_integrable (t : ℝ) (ht : 0 < t) (i : Fin 4) :
    Integrable (fun x : FourSpace => x i * fourHeatGaussian t x) := by
  apply (fourHeatGaussian_quadratic_majorant_integrable t ht).mono'
  · exact ((EuclideanSpace.proj i : FourSpace →L[ℝ] ℝ).continuous.mul
      (fourHeatGaussian_continuous t)).aestronglyMeasurable
  · exact Filter.Eventually.of_forall fun x => by
      rw [norm_mul, Real.norm_of_nonneg (fourHeatGaussian_pos t ht x).le]
      apply mul_le_mul_of_nonneg_right _ (fourHeatGaussian_pos t ht x).le
      have h := PiLp.norm_apply_le x i
      nlinarith [norm_nonneg x, sq_nonneg (‖x‖ - 1)]

theorem fourHeatGaussian_coordinate_pair_integrable (t : ℝ) (ht : 0 < t) (i j : Fin 4) :
    Integrable (fun x : FourSpace => x i * x j * fourHeatGaussian t x) := by
  apply (fourHeatGaussian_quadratic_majorant_integrable t ht).mono'
  · exact (((EuclideanSpace.proj i : FourSpace →L[ℝ] ℝ).continuous.mul
      (EuclideanSpace.proj j : FourSpace →L[ℝ] ℝ).continuous).mul
      (fourHeatGaussian_continuous t)).aestronglyMeasurable
  · exact Filter.Eventually.of_forall fun x => by
      rw [norm_mul, norm_mul, Real.norm_of_nonneg (fourHeatGaussian_pos t ht x).le]
      apply mul_le_mul_of_nonneg_right _ (fourHeatGaussian_pos t ht x).le
      have h := mul_le_mul (PiLp.norm_apply_le x i) (PiLp.norm_apply_le x j)
        (norm_nonneg (x j)) (norm_nonneg x)
      nlinarith

theorem fourHeatGaussian_coordinate_covariance (t : ℝ) (ht : 0 < t) (i j : Fin 4) :
    (∫ x : FourSpace, x i * x j * fourHeatGaussian t x) =
      2 * t * (if i = j then 1 else 0) := by
  have hleft : Integrable (fun x : FourSpace =>
      partialDeriv (fun y : FourSpace => y j) i x * fourHeatGaussian t x) := by
    simpa only [heat_partial_coordinate] using
      (fourHeatGaussian_integrable t ht).const_mul (if i = j then (1 : ℝ) else 0)
  have hright : Integrable (fun x : FourSpace =>
      x j * partialDeriv (fourHeatGaussian t) i x) := by
    have hi := (fourHeatGaussian_coordinate_pair_integrable t ht i j).const_mul (-(2 * t)⁻¹)
    convert hi using 1
    funext x
    rw [fourHeatGaussian_partial t ht.ne' i x]
    ring
  have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
    (v := coordinateVector i) hleft hright (fourHeatGaussian_coordinate_integrable t ht j)
    (fun x _ => (fourHeatGaussian_coordinate_hasFDerivAt j x).differentiableAt)
    (fun x _ => (fourHeatGaussian_hasFDerivAt t x).differentiableAt)
  change (∫ x : FourSpace, x j * partialDeriv (fourHeatGaussian t) i x) =
    -(∫ x : FourSpace, partialDeriv (fun y : FourSpace => y j) i x * fourHeatGaussian t x) at h
  have heq : (fun x : FourSpace => x j * partialDeriv (fourHeatGaussian t) i x) =
      fun x => (-(2 * t)⁻¹) * (x i * x j * fourHeatGaussian t x) := by
    funext x
    rw [fourHeatGaussian_partial t ht.ne' i x]
    ring
  rw [heq, integral_const_mul] at h
  simp only [heat_partial_coordinate, integral_const_mul, fourHeatGaussian_mass t ht, mul_one] at h
  field_simp [ht.ne'] at h
  linarith

theorem fourHeatGaussian_hessian_integral (t : ℝ) (ht : 0 < t) (A : Mat4) :
    (∫ x : FourSpace, (∑ i, ∑ j, A i j * x i * x j) * fourHeatGaussian t x) =
      2 * t * A.trace := by
  have hi (i j : Fin 4) : Integrable (fun x : FourSpace =>
      A i j * (x i * x j * fourHeatGaussian t x)) :=
    (fourHeatGaussian_coordinate_pair_integrable t ht i j).const_mul _
  have heq : (fun x : FourSpace => (∑ i, ∑ j, A i j * x i * x j) * fourHeatGaussian t x) =
      fun x => ∑ i, ∑ j, A i j * (x i * x j * fourHeatGaussian t x) := by
    funext x
    simp only [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [heq, integral_finsetSum _ (fun i _ => integrable_finsetSum _ (fun j _ => hi i j))]
  simp_rw [integral_finsetSum _ (fun j _ => hi _ j), integral_const_mul,
    fourHeatGaussian_coordinate_covariance t ht]
  simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  simp only [Matrix.trace, Matrix.diag, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact rescaling and the leading limit for squared Gaussian integrals. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped _root_.Topology

noncomputable section

theorem fourHeatGaussian_square_weighted (F : FourSpace → ℝ) (t : ℝ) (ht : 0 < t) :
    t ^ 2 * (∫ x, fourHeatGaussian t x ^ 2 * F x) =
      (1 / (64 * Real.pi ^ 2)) * ∫ x, fourHeatGaussian (t / 2) x * F x := by
  rw [← integral_const_mul, ← integral_const_mul]
  apply integral_congr_ae
  exact Eventually.of_forall fun x => by
    change t ^ 2 * (fourHeatGaussian t x ^ 2 * F x) = _
    rw [← mul_assoc, fourHeatGaussian_square_half t ht]
    ring

theorem fourHeatGaussian_square_family_limit (F : ℝ → FourSpace → ℝ)
    (hF : Continuous (fun z : ℝ × FourSpace => F z.1 z.2))
    (B T : ℝ) (hT : 0 < T) (hB : ∀ t ∈ Icc (0 : ℝ) T, ∀ x, ‖F t x‖ ≤ B) :
    Tendsto (fun t => t ^ 2 * ∫ x, fourHeatGaussian t x ^ 2 * F t x)
      (𝓝[>] 0) (𝓝 ((1 / (64 * Real.pi ^ 2)) * F 0 0)) := by
  let H := fun s x => F (2 * s) x
  have hH : Continuous (fun z : ℝ × FourSpace => H z.1 z.2) :=
    hF.comp ((continuous_const.mul continuous_fst).prodMk continuous_snd)
  have hb : ∀ s ∈ Icc (0 : ℝ) (T / 2), ∀ x, ‖H s x‖ ≤ B := by
    intro s hs x
    exact hB (2 * s) ⟨by linarith [hs.1], by linarith [hs.2]⟩ x
  have hhalf : Tendsto (fun t : ℝ => t / 2) (𝓝[>] 0) (𝓝[>] 0) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have hi : Tendsto (fun t : ℝ => t) (𝓝[>] 0) (𝓝 0) :=
        tendsto_id.mono_left nhdsWithin_le_nhds
      simpa only [zero_div] using hi.div_const (2 : ℝ)
    · filter_upwards [self_mem_nhdsWithin] with t ht
      show (0 : ℝ) < t / 2
      exact half_pos ht
  have hlim := (fourHeatGaussian_family_limit H hH B (T / 2) (half_pos hT) hb).comp hhalf
  have hlim' : Tendsto (fun t => ∫ x, fourHeatGaussian (t / 2) x * F t x)
      (𝓝[>] 0) (𝓝 (F 0 0)) := by
    change Tendsto (fun t => ∫ x, fourHeatGaussian (t / 2) x * F (2 * (t / 2)) x)
      (𝓝[>] 0) (𝓝 (F (2 * 0) 0)) at hlim
    have he (t : ℝ) : 2 * (t / 2) = t := by ring
    simpa only [he, mul_zero] using hlim
  apply (tendsto_const_nhds.mul hlim').congr'
  filter_upwards [self_mem_nhdsWithin] with t ht
  exact (fourHeatGaussian_square_weighted (F t) t ht).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The coordinate product rule for two successive covariant derivatives
of four-component fields. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatOneCovariantDerivative (A : Fin 4 → FourSpace → Mat4)
    (u : FourSpace → Fin 4 → ℝ) (i : Fin 4) (x : FourSpace) (k : Fin 4) : ℝ :=
  partialDeriv (fun y => u y k) i x + ∑ l : Fin 4, A i x k l * u x l

theorem fourHeat_partial_sum_oneForm (f : Fin 4 → FourSpace → ℝ) (x : FourSpace)
    (hf : ∀ l, DifferentiableAt ℝ (f l) x) (i : Fin 4) :
    partialDeriv (fun y => ∑ l : Fin 4, f l y) i x =
      ∑ l : Fin 4, partialDeriv (f l) i x := by
  unfold partialDeriv
  rw [fderiv_fun_sum (u := Finset.univ) (A := f) (fun l _ => hf l), _root_.sum_apply]

theorem fourHeatOneCovariantDerivative_partial (A : Fin 4 → FourSpace → Mat4)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (i j : Fin 4) (k : Fin 4) :
    partialDeriv (fun y => fourHeatOneCovariantDerivative A u i y k) j x =
      partialDeriv (partialDeriv (fun y => u y k) i) j x +
        (∑ l : Fin 4, partialDeriv (fun y => A i y k l) j x * u x l) +
        ∑ l : Fin 4, A i x k l * partialDeriv (fun y => u y l) j x := by
  have hu0 (l : Fin 4) : DifferentiableAt ℝ (fun y => u y l) x :=
    (hu l).differentiableAt (by norm_num)
  have hdu : DifferentiableAt ℝ (partialDeriv (fun y => u y k) i) x :=
    (((hu k).fderiv_right (m := 1) (by norm_num)).clm_apply
      (contDiffAt_const (c := coordinateVector i))).differentiableAt one_ne_zero
  have hprod (l : Fin 4) : DifferentiableAt ℝ (fun y => A i y k l * u y l) x :=
    (hA i k l).mul (hu0 l)
  have hsum : DifferentiableAt ℝ (fun y => ∑ l : Fin 4, A i y k l * u y l) x :=
    DifferentiableAt.fun_sum (u := Finset.univ) (fun l _ => hprod l)
  unfold fourHeatOneCovariantDerivative
  rw [fourHeat_partial_add (partialDeriv (fun y => u y k) i)
    (fun y => ∑ l : Fin 4, A i y k l * u y l) x hdu hsum j,
    fourHeat_partial_sum_oneForm (fun l y => A i y k l * u y l) x hprod j]
  simp only [scalar_partial_product _ _ x (hA i k _) (hu0 _) j, Finset.sum_add_distrib]
  ring

theorem fourHeatOneCovariantDerivative_second (A : Fin 4 → FourSpace → Mat4)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (i j : Fin 4) (k : Fin 4) :
    fourHeatOneCovariantDerivative A (fourHeatOneCovariantDerivative A u i) j x k =
      partialDeriv (partialDeriv (fun y => u y k) i) j x +
        (∑ l : Fin 4, A i x k l * partialDeriv (fun y => u y l) j x) +
        (∑ l : Fin 4, A j x k l * partialDeriv (fun y => u y l) i x) +
        ∑ l : Fin 4, (partialDeriv (fun y => A i y k l) j x +
          (A j x * A i x) k l) * u x l := by
  change partialDeriv (fun y => fourHeatOneCovariantDerivative A u i y k) j x +
    (∑ l : Fin 4, A j x k l * fourHeatOneCovariantDerivative A u i x l) = _
  rw [fourHeatOneCovariantDerivative_partial A u x hA hu]
  have hquad : (∑ l : Fin 4, A j x k l * ∑ q : Fin 4, A i x l q * u x q) =
      ∑ q : Fin 4, (A j x * A i x) k q * u x q := by
    simp only [Finset.mul_sum, Matrix.mul_apply, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro q _
    apply Finset.sum_congr rfl
    intro l _
    ring
  simp only [fourHeatOneCovariantDerivative, mul_add, Finset.sum_add_distrib]
  rw [hquad]
  simp only [add_mul, Finset.sum_add_distrib]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Four-component cutoff commutator for the actual one-form heat operator. -/
namespace PositiveEinsteinFour.Geometry
open EinsteinFour Matrix Set Filter Metric
open scoped BigOperators ContDiff _root_.Topology
noncomputable section

theorem fourHeatOneOperator_cutoff (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4) (f : FourSpace → ℝ)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (ha : ∀ i j, a i j = a j i) (hf : ContDiffAt ℝ 2 f x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (k : Fin 4) :
    fourHeatOneOperator a b B C (fun y l => f y * u y l) x k =
      f x * fourHeatOneOperator a b B C u x k +
      fourHeatLocalOperator a b 0 f x * u x k -
      2 * (∑ i, ∑ j, a i j * partialDeriv f i x * partialDeriv (fun y => u y k) j x) +
      ∑ i, ∑ l, B i k l * partialDeriv f i x * u x l := by
  have hfirst : fourHeatOneFirst B (fun y l => f y * u y l) x k =
      f x * fourHeatOneFirst B u x k +
        ∑ i, ∑ l, B i k l * partialDeriv f i x * u x l := by
    unfold fourHeatOneFirst
    simp_rw [scalar_partial_product f (fun y => u y _) x
      (hf.differentiableAt (by norm_num)) ((hu _).differentiableAt (by norm_num))]
    have he (i : Fin 4) (l : Fin 4) :
        B i k l * (partialDeriv f i x * u x l + f x * partialDeriv (fun y => u y l) i x) =
        f x * (B i k l * partialDeriv (fun y => u y l) i x) +
          B i k l * partialDeriv f i x * u x l := by ring
    simp_rw [he, Finset.sum_add_distrib, ← Finset.mul_sum]
  have hzero : fourHeatOneZero C (fun y l => f y * u y l) x k =
      f x * fourHeatOneZero C u x k := by
    unfold fourHeatOneZero
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro l _
    ring
  unfold fourHeatOneOperator
  rw [fourHeatLocalOperator_cutoff a b f (fun y => u y k) x ha hf (hu k), hfirst, hzero]
  ring
end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact cancellation of the first four matrix heat amplitudes. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatOnePolynomial_gaussian_residual (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4)
    (u : Fin 4 → FourSpace → Fin 4 → ℝ)
    (hu : ∀ i k, ContDiff ℝ 2 (fun y => u i y k))
    (t : ℝ) (ht : 0 < t) (x : FourSpace)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0)
    (hE : fourHeatEikonalDefect a x = 0)
    (h0 : ∀ k, fourHeatRadialTransport a b (fun y => u 0 y k) x = 0)
    (h1 : ∀ k, fourHeatRadialTransport a b (fun y => u 1 y k) x + u 1 x k =
      -fourHeatOneOperator a b B C (u 0) x k)
    (h2 : ∀ k, fourHeatRadialTransport a b (fun y => u 2 y k) x + 2 * u 2 x k =
      -fourHeatOneOperator a b B C (u 1) x k)
    (h3 : ∀ k, fourHeatRadialTransport a b (fun y => u 3 y k) x + 3 * u 3 x k =
      -fourHeatOneOperator a b B C (u 2) x k) (k : Fin 4) :
    deriv (fun s => fourHeatGaussian s x * fourHeatOnePolynomial u s x k) t +
      fourHeatOneOperator a b B C
        (fun y l => fourHeatGaussian t y * fourHeatOnePolynomial u t y l) x k =
      fourHeatGaussian t x * t ^ 3 * fourHeatOneOperator a b B C (u 3) x k := by
  have hP (l : Fin 4) : ContDiff ℝ 2 (fun y => fourHeatOnePolynomial u t y l) :=
    fourHeatPolynomial_contDiff (fun m y => u m y l) (fun m => hu m l) t
  have hd := (fourHeatGaussian_hasDerivAt_time t ht x).mul
    (fourHeatPolynomial_hasDerivAt (fun m y => u m y k) t x)
  change HasDerivAt (fun s => fourHeatGaussian s x * fourHeatOnePolynomial u s x k) _ t at hd
  have hr := fourHeatOneOperator_transport_residual_at a b B C t ht
    (fourHeatOnePolynomial u t) x (fun l => (hP l).contDiffAt) hB k
  rw [(fourHeatGaussian_amplitude_time t ht (fun y => fourHeatOnePolynomial u t y k) x).deriv,
    hE, zero_div, zero_mul, add_zero] at hr
  rw [fourHeatOnePolynomial_operator a b B C u hu t x k] at hr
  have hT := fourHeatPolynomial_transport a b (fun m y => u m y k) (fun m => hu m k) t x
  change fourHeatRadialTransport a b (fun y => fourHeatOnePolynomial u t y k) x = _ at hT
  rw [hT, h0] at hr
  have h1' : fourHeatRadialTransport a b (fun y => u 1 y k) x =
      -fourHeatOneOperator a b B C (u 0) x k - u 1 x k := by linarith only [h1 k]
  have h2' : fourHeatRadialTransport a b (fun y => u 2 y k) x =
      -fourHeatOneOperator a b B C (u 1) x k - 2 * u 2 x k := by linarith only [h2 k]
  have h3' : fourHeatRadialTransport a b (fun y => u 3 y k) x =
      -fourHeatOneOperator a b B C (u 2) x k - 3 * u 3 x k := by linarith only [h3 k]
  rw [h1', h2', h3'] at hr
  rw [hd.deriv]
  calc
    _ = fourHeatGaussian t x * (‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) *
          fourHeatOnePolynomial u t x k +
        fourHeatOneOperator a b B C
          (fun y l => fourHeatGaussian t y * fourHeatOnePolynomial u t y l) x k +
        fourHeatGaussian t x * (u 1 x k + 2 * t * u 2 x k + 3 * t ^ 2 * u 3 x k) := by
          dsimp only [fourHeatOnePolynomial]
          ring
    _ = _ := by rw [hr]; field_simp [ht.ne']; ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Remove the single inverse-time factor from the cutoff commutator.
The resulting coefficient is continuous also at time zero. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatScaledCommutator (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (χ : FourSpace → ℝ)
    (u : Fin 4 → FourSpace → Fin 6 → ℝ) (t : ℝ) (x : FourSpace) (k : Fin 6) : ℝ :=
  t * fourHeatLocalOperator (a x) (b x) 0 χ x * fourHeatBundlePolynomial u t x k -
  2 * (∑ i, ∑ j, a x i j * partialDeriv χ i x *
    (t * partialDeriv (fun y => fourHeatBundlePolynomial u t y k) j x -
      x j / 2 * fourHeatBundlePolynomial u t x k)) +
  t * (∑ i, ∑ q, B x i k q * partialDeriv χ i x * fourHeatBundlePolynomial u t x q)

theorem fourHeatScaledCommutator_identity (a : FourSpace → Mat4)
    (b : FourSpace → Fin 4 → ℝ) (B : FourSpace → Fin 4 → HeatMat6)
    (χ : FourSpace → ℝ) (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (hu : ∀ m q, ContDiff ℝ 2 (fun y => u m y q)) (t : ℝ) (ht : 0 < t)
    (x : FourSpace) (k : Fin 6) :
    fourHeatLocalOperator (a x) (b x) 0 χ x *
        (fourHeatGaussian t x * fourHeatBundlePolynomial u t x k) -
      2 * (∑ i, ∑ j, a x i j * partialDeriv χ i x *
        partialDeriv (fun y => fourHeatGaussian t y * fourHeatBundlePolynomial u t y k) j x) +
      (∑ i, ∑ q, B x i k q * partialDeriv χ i x *
        (fourHeatGaussian t x * fourHeatBundlePolynomial u t x q)) =
      (fourHeatGaussian t x / t) * fourHeatScaledCommutator a b B χ u t x k := by
  have hP (q : Fin 6) : DifferentiableAt ℝ (fun y => fourHeatBundlePolynomial u t y q) x :=
    ((fourHeatPolynomial_contDiff (fun m y => u m y q) (fun m => hu m q) t).differentiable
      (by norm_num)).differentiableAt
  simp_rw [fourHeatGaussian_amplitude_partial_at t ht.ne' _ x (hP k)]
  unfold fourHeatScaledCommutator
  have hg : (∑ i, ∑ j, a x i j * partialDeriv χ i x *
      (fourHeatGaussian t x * (partialDeriv (fun y => fourHeatBundlePolynomial u t y k) j x -
        x j / (2 * t) * fourHeatBundlePolynomial u t x k))) =
      (fourHeatGaussian t x / t) * (∑ i, ∑ j, a x i j * partialDeriv χ i x *
        (t * partialDeriv (fun y => fourHeatBundlePolynomial u t y k) j x -
          x j / 2 * fourHeatBundlePolynomial u t x k)) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    field_simp
  have hB : (∑ i, ∑ q, B x i k q * partialDeriv χ i x *
      (fourHeatGaussian t x * fourHeatBundlePolynomial u t x q)) =
      fourHeatGaussian t x * (∑ i, ∑ q, B x i k q * partialDeriv χ i x *
        fourHeatBundlePolynomial u t x q) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro q _
    ring
  rw [hg, hB]
  field_simp

end
end PositiveEinsteinFour.Geometry
end


section

/-! Compact continuous alternating chart tensors are limits of actual
smooth two-form frame tensors in the uniform norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Function
open scoped BigOperators ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g}

local instance heatChartTensorApproxCompact : CompactSpace (FrameBundle g) := actual_compactFrameBundle g

omit [CompactSpace M] in
theorem heatChartTensor_sub (c : M) {K : Set FourSpace}
    (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (F H : FourSpace → CovariantCoordinates 2)
    (hF : ContinuousOn F (chartAt FourSpace c).target)
    (hH : ContinuousOn H (chartAt FourSpace c).target)
    (hFs : tsupport F ⊆ K) (hHs : tsupport H ⊆ K)
    (hDs : tsupport (H - F) ⊆ K) :
    heatChartTensor g c (H - F) (hH.sub hF)
      (hK.of_isClosed_subset (isClosed_tsupport _) hDs) (hDs.trans hKt) =
      heatChartTensor g c H hH (hK.of_isClosed_subset (isClosed_tsupport _) hHs) (hHs.trans hKt) -
      heatChartTensor g c F hF (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt) := by
  classical
  apply ContinuousMap.ext
  intro f
  apply WithLp.ofLp_injective 2
  change heatNormalFrameTensorLift g c (chartAt FourSpace c).symm (H - F) f =
    heatNormalFrameTensorLift g c (chartAt FourSpace c).symm H f -
      heatNormalFrameTensorLift g c (chartAt FourSpace c).symm F f
  by_cases hf : f.base ∈ (chartAt FourSpace c).symm.target
  · simp only [heatNormalFrameTensorLift, ite_eq_left hf, Pi.sub_apply]
    funext a
    exact frameTensor_sub _ _ _ a
  · simp only [heatNormalFrameTensorLift, ite_eq_right hf, sub_self]

theorem heatChartTensor_smooth_approx (c : M)
    (F : FourSpace → CovariantCoordinates 2) (hF : Continuous F)
    (ha : ∀ z i j, F z ![j,i] = -F z ![i,j])
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (hFs : tsupport F ⊆ K) (ε : ℝ) (hε : 0 < ε) :
    ∃ u : smoothTwoForms o,
      ‖smoothTwoFormEuclideanValue u - heatChartTensor g c F hF.continuousOn
        (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt)‖ < ε := by
  obtain ⟨B, hB, hbound⟩ := heatChartTensor_bound (g := g) c hK hKt
  let r := ε / (B + 1)
  have hr : 0 < r := div_pos hε (by positivity)
  obtain ⟨H, hH, hHa, hHsF, hdist⟩ := heat_alternating_smooth_approx F hF ha r hr
  have hHs : tsupport H ⊆ K := hHsF.trans hFs
  have hDs : tsupport (H - F) ⊆ K := by
    apply closure_minimal _ hK.isClosed
    intro z hz
    by_contra hzK
    have hH0 : H z = 0 := image_eq_zero_of_notMem_tsupport (fun h => hzK (hHs h))
    have hF0 : F z = 0 := image_eq_zero_of_notMem_tsupport (fun h => hzK (hFs h))
    exact hz (by simp only [Pi.sub_apply, hH0, hF0, sub_self])
  refine ⟨twoFormChartTest o c H hH.contDiffOn hHa hK hKt hHs, ?_⟩
  rw [← heatChartTensor_smooth c H hH.contDiffOn hHa hK hKt hHs,
    ← heatChartTensor_sub c hK hKt F H hF.continuousOn hH.continuous.continuousOn hFs hHs hDs]
  have hb := hbound (H - F) (hH.continuous.continuousOn.sub hF.continuousOn) hDs r hr.le
    (fun z a => (hdist z a).le)
  have hbr : B * r < ε := by
    have h := (mul_div_cancel₀ ε (show B + 1 ≠ 0 by positivity))
    change (B + 1) * r = ε at h
    nlinarith
  exact hb.trans_lt hbr

end
end PositiveEinsteinFour.Geometry
end


section

/-! The joint one-form geometry has the actual normal-frame coefficient germs. -/
namespace PositiveEinsteinFour.Geometry
open EinsteinFour Matrix Set Filter
open scoped ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise
noncomputable section
variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatFamilyOneNormal_germs {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (he : e.base ∈ (chartAt FourSpace c).source)
    (P : HeatRadialFrameSpace → CoordinateFrameSpace)
    (hP : ContDiffAt ℝ 2 P (0, frameCoordinateState g c e))
    (hpoint : D.point = fun x => P (x, frameCoordinateState g c e)) :
    ((fun x => heatFamilyOneFirst g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalOneFirst D) ∧
    ((fun x => heatFamilyOneZero g c P (x, frameCoordinateState g c e))
      =ᶠ[𝓝 0] heatNormalOneZero D) := by
  let q := frameCoordinateState g c e
  have hi : Tendsto (fun x : FourSpace => (x, q)) (𝓝 0) (𝓝 (0, q)) :=
    continuousAt_id.prodMk continuousAt_const
  have hG := heatFamilyNormal_germs D he P hP hpoint
  have hr := hi.eventually (hP.eventually (by simp))
  have hc : ∀ᶠ x in 𝓝 (0 : FourSpace), (P (x, q)).1 ∈ (chartAt FourSpace c).target := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    simpa only [hpoint] using D.in_chart x hx
  have hf : ∀ᶠ x in 𝓝 (0 : FourSpace), (P (x, q)).2.det ≠ 0 := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    have hg := congrArg Matrix.det (D.orthonormal x hx)
    rw [hpoint] at hg
    simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at hg
    change (P (x, q)).2.det * (metricInChart g c (P (x, q)).1).det *
      (P (x, q)).2.det = 1 at hg
    intro hz
    rw [hz] at hg
    norm_num at hg
  have hA (i : Fin 4) : (fun x => heatFamilyConnection g c P i (x, q))
      =ᶠ[𝓝 0] heatNormalFrameConnection g c D.point i := by
    filter_upwards [hr] with x hx
    rw [heatFamilyConnection_slice g c P (x, q) (hx.differentiableAt (by norm_num)) i, hpoint]
  have hAA := eventually_all.mpr (fun i => (hA i).eventuallyEq_nhds)
  constructor
  · filter_upwards [hG.1, eventually_all.mpr hA] with x ha hAx
    unfold heatFamilyOneFirst heatNormalOneFirst
    rw [ha]
    funext i
    congr 1
    funext j
    exact hAx j
  · filter_upwards [hr, hc, hf, hG.1, hG.2.1, hAA] with x hx hcx hfx hax hbx hAx
    have hp (i : Fin 4) (k l : Fin 4) :
        DifferentiableAt ℝ (fun z => heatFamilyConnection g c P i z k l) (x, q) :=
      (heatFamilyConnection_contDiffAt 1 g c P (x, q) hx hcx hfx i k l).differentiableAt one_ne_zero
    have hv (i : Fin 4) : heatFamilyConnection g c P i (x, q) =
        heatNormalFrameConnection g c D.point i x := (hAx i).self_of_nhds
    have hd (i j k l : Fin 4) :
        heatFamilyScalarPartial (fun z => heatFamilyConnection g c P i z k l) j (x, q) =
          partialDeriv (fun y => heatNormalFrameConnection g c D.point i y k l) j x := by
      rw [heatFamilyScalarPartial_slice _ (x, q) (hp i k l) j]
      exact fourHeat_partial_germ ((hAx i).mono fun y hy => congrArg (fun A : Mat4 => A k l) hy) j
    dsimp only [q] at hv hd
    simp only [heatFamilyOneZero, heatNormalOneZero, fourHeatOneConnectionZero,
      hax, hbx, hv, hd]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The six-component heat operator differentiates only normal vectors,
while retaining joint regularity in the center and frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators Matrix.Norms.Elementwise

noncomputable section

theorem heatFamilyScalarPartial_contDiff (n : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (hf : ContDiff ℝ (n + 1 : ℕ) f) (i : Fin 4) :
    ContDiff ℝ n (heatFamilyScalarPartial f i) := by
  rw [contDiff_iff_contDiffAt]
  exact fun z => heatFamilyScalarPartial_contDiffAt n f z hf.contDiffAt i

def heatFamilyBundleOperator (a : HeatRadialFrameSpace → Mat4)
    (b : HeatRadialFrameSpace → Fin 4 → ℝ) (B : HeatRadialFrameSpace → Fin 4 → HeatMat6)
    (C : HeatRadialFrameSpace → HeatMat6) (u : HeatRadialFrameSpace → Fin 6 → ℝ)
    (z : HeatRadialFrameSpace) (k : Fin 6) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a z i j *
      heatFamilyScalarPartial (heatFamilyScalarPartial (fun y => u y k) i) j z) +
    (∑ i : Fin 4, b z i * heatFamilyScalarPartial (fun y => u y k) i z) +
    (∑ i : Fin 4, ∑ l : Fin 6, B z i k l * heatFamilyScalarPartial (fun y => u y l) i z) +
    ∑ l : Fin 6, C z k l * u z l

theorem heatFamilyBundleOperator_contDiff (n : ℕ)
    (a : HeatRadialFrameSpace → Mat4) (b : HeatRadialFrameSpace → Fin 4 → ℝ)
    (B : HeatRadialFrameSpace → Fin 4 → HeatMat6) (C : HeatRadialFrameSpace → HeatMat6)
    (u : HeatRadialFrameSpace → Fin 6 → ℝ)
    (ha : ∀ i j, ContDiff ℝ n (fun z => a z i j))
    (hb : ∀ i, ContDiff ℝ n (fun z => b z i))
    (hB : ∀ i k l, ContDiff ℝ n (fun z => B z i k l))
    (hC : ∀ k l, ContDiff ℝ n (fun z => C z k l))
    (hu : ∀ l, ContDiff ℝ (n + 2 : ℕ) (fun z => u z l)) (k : Fin 6) :
    ContDiff ℝ n (fun z => heatFamilyBundleOperator a b B C u z k) := by
  have hp (i : Fin 4) (l : Fin 6) :
      ContDiff ℝ (n + 1 : ℕ) (heatFamilyScalarPartial (fun z => u z l) i) := by
    apply heatFamilyScalarPartial_contDiff
    simpa only [Nat.add_assoc] using hu l
  have hn : (n : ℕ∞ω) ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hpp (i j : Fin 4) : ContDiff ℝ n
      (heatFamilyScalarPartial (heatFamilyScalarPartial (fun z => u z k) i) j) :=
    heatFamilyScalarPartial_contDiff n _ (hp i k) j
  exact (((ContDiff.sum (fun i _ => ContDiff.sum (fun j _ =>
    (ha i j).mul (hpp i j)))).neg.add
      (ContDiff.sum (fun i _ => (hb i).mul ((hp i k).of_le hn)))).add
    (ContDiff.sum (fun i _ => ContDiff.sum (fun l _ =>
      (hB i k l).mul ((hp i l).of_le hn))))).add
    (ContDiff.sum (fun l _ => (hC k l).mul ((hu l).of_le
      (by exact_mod_cast (show n ≤ n + 2 by omega)))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact normal-coordinate pairings of the actual global L2 amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter MeasureTheory
open scoped Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem heatNormalAmplitudeL2_pairing_normal (D : HeatNormalFrameData g o c e)
    (C : OpenPartialHomeomorph FourSpace M)
    (hE : EqOn C (frameExponential g o e) C.source)
    (hCt : C.target ⊆ (chartAt FourSpace c).source)
    (hP : ContDiffOn ℝ 2 D.point C.source) (hD : C.source ⊆ Metric.ball 0 D.radius)
    (a : FourSpace → TwoFormFour) (ha : ContDiff ℝ 2 a) (hc : HasCompactSupport a)
    (hs : tsupport a ⊆ C.source) (v : SmoothL2TwoForm o) :
    inner ℝ (heatNormalAmplitudeL2 D C hCt hP hD a ha hc hs) (smoothTwoFormToL2 v) =
      (normalizedChartFactor g).toReal * ∫ x, frameExponentialJacobian g o e x *
        inner ℝ (a x) (heatNormalTwoFormValue o c D.point
          (v : smoothTwoForms o).val x) := by
  rw [heatNormalAmplitudeL2_pairing_base D C hE]
  apply heatNormalScalarLift_integral D C hE hCt hP hD
  apply subset_trans (closure_mono ?_) hs
  intro x hx
  contrapose! hx
  apply Function.notMem_support.mpr
  rw [Function.notMem_support.mp hx, inner_zero_left]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first four actual normal-frame matrix heat amplitudes and their
transport equations. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Metric
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def HeatNormalBundleExtension.amplitude {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) : ℕ → FourSpace → HeatMat6 :=
  fourHeatBundleCoefficient E.base.a E.base.b E.B E.C E.base.U

theorem HeatNormalBundleExtension.amplitude_regular {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (m : ℕ) (hm : m ≤ 3) (k l : Fin 6) :
    ContDiff ℝ 4 (fun x => E.amplitude m x k l) := by
  have hle : ((4 + 2 * m : ℕ) : ℕ∞ω) ≤ 10 := by
    exact_mod_cast (show 4 + 2 * m ≤ 10 by omega)
  exact fourHeatBundleCoefficient_contDiff m 4 E.base.a E.base.b E.B E.C E.base.U
    (fun i j => (E.base.a_regular i j).of_le hle)
    (fun i => (E.base.b_regular i).of_le hle)
    (fun i k l => (E.B_regular i k l).of_le hle)
    (fun k l => (E.C_regular k l).of_le hle) (E.base.U_regular.of_le hle)
    (fun x => (E.base.U_pos x).ne') k l

theorem HeatNormalBundleExtension.amplitude_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (x : FourSpace) :
    E.amplitude 0 x = E.base.U x • (1 : HeatMat6) := by
  ext k l
  simp only [HeatNormalBundleExtension.amplitude, fourHeatBundleCoefficient,
    Matrix.smul_apply, smul_eq_mul, Matrix.one_apply]

theorem HeatNormalBundleExtension.amplitude_transport {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      (∀ k l, (∑ i : Fin 4, x i * E.B x i k l) = 0) ∧
      fourHeatEikonalDefect (E.base.a x) x = 0 ∧
      (∀ m ≤ 2, ∀ k l,
        fourHeatRadialTransport (E.base.a x) (E.base.b x)
          (fun y => E.amplitude (m + 1) y k l) x +
          (m + 1 : ℝ) * E.amplitude (m + 1) x k l =
        -fourHeatBundleOperator (E.base.a x) (E.base.b x) (E.B x) (E.C x)
          (fun y q => E.amplitude m y q l) x k) := by
  obtain ⟨s, hs, hT⟩ := E.base.transport_neighborhood hRic he
  have hn := (E.radial_near hRic he).and (ball_mem_nhds (0 : FourSpace) hs)
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx
  obtain ⟨hrad, hxs⟩ := hball hx
  obtain ⟨hrow, hcol, hEik, hTU⟩ := hT x hxs
  refine ⟨hrad, hEik, ?_⟩
  intro m hm k l
  exact fourHeatBundleCoefficient_transport m E.base.a E.base.b E.B E.C E.base.U x
    (E.base.U_regular.of_le (by norm_num)) (fun y => (E.base.U_pos y).ne')
    (fun i j => (E.base.a_regular i j).of_le (by norm_num))
    (fun i => (E.base.b_regular i).of_le (by norm_num))
    (fun i k l => (E.B_regular i k l).of_le (by norm_num))
    (fun k l => (E.C_regular k l).of_le (by norm_num))
    (fun k l => (E.amplitude_regular m (by omega) k l).of_le (by norm_num))
    hrow hcol hTU k l

end
end PositiveEinsteinFour.Geometry
end


