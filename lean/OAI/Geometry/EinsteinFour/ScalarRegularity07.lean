section

/-! Real coordinate L² functions and their weak derivatives embed into
the complex tempered distributions used by the elliptic inverse. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal LineDeriv Manifold ContDiff

noncomputable section

def scalarComplexL2 (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    Lp ℂ 2 (volume : Measure FourSpace) := Complex.ofRealCLM.compLp f

theorem scalarComplexL2_coe (f : Lp ℝ 2 (volume : Measure FourSpace)) :
    scalarComplexL2 f =ᵐ[volume] (fun x => (f x : ℂ)) :=
  Complex.ofRealCLM.coeFn_compLp f

theorem scalarComplexL2_pairing_re (f : Lp ℝ 2 (volume : Measure FourSpace))
    (φ : 𝓢(FourSpace, ℂ)) :
    ((scalarComplexL2 f : 𝓢'(FourSpace, ℂ)) φ).re = ∫ x, f x * (φ x).re := by
  have hi := (φ.memLp 2 (volume : Measure FourSpace)).integrable_mul
    (Lp.memLp (scalarComplexL2 f))
  rw [Lp.toTemperedDistribution_apply]
  change (∫ x, φ x * scalarComplexL2 f x).re = _
  have he : (∫ x, φ x * scalarComplexL2 f x).re =
      ∫ x, (φ x * scalarComplexL2 f x).re := (integral_re hi).symm
  rw [he]
  apply integral_congr_ae
  filter_upwards [scalarComplexL2_coe f] with x hx
  rw [hx]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]
  ring

theorem scalarComplexL2_pairing_im (f : Lp ℝ 2 (volume : Measure FourSpace))
    (φ : 𝓢(FourSpace, ℂ)) :
    ((scalarComplexL2 f : 𝓢'(FourSpace, ℂ)) φ).im = ∫ x, f x * (φ x).im := by
  have hi := (φ.memLp 2 (volume : Measure FourSpace)).integrable_mul
    (Lp.memLp (scalarComplexL2 f))
  rw [Lp.toTemperedDistribution_apply]
  change (∫ x, φ x * scalarComplexL2 f x).im = _
  have he : (∫ x, φ x * scalarComplexL2 f x).im =
      ∫ x, (φ x * scalarComplexL2 f x).im := (integral_im hi).symm
  rw [he]
  apply integral_congr_ae
  filter_upwards [scalarComplexL2_coe f] with x hx
  rw [hx]
  simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
  ring

theorem scalarSchwartz_real_partial (L : ℂ →L[ℝ] ℝ) (φ : 𝓢(FourSpace, ℂ))
    (i : Fin 4) (x : FourSpace) :
    partialDeriv (fun y => L (φ y)) i x =
      L ((scalarSchwartzCoordinateDerivative i φ) x) := by
  change (fderiv ℝ (L ∘ φ) x) (coordinateVector i) =
    L ((fderiv ℝ φ x) (EuclideanSpace.basisFun (Fin 4) ℝ i))
  rw [_root_.fderiv_comp (f := (φ : FourSpace → ℂ)) (g := (L : ℂ → ℝ))
    x L.differentiableAt φ.differentiableAt, L.fderiv]
  simp only [ContinuousLinearMap.comp_apply, EuclideanSpace.basisFun_apply, coordinateVector]

theorem scalarComplexL2_weak_derivative
    (f g : Lp ℝ 2 (volume : Measure FourSpace)) (i : Fin 4)
    (hw : ∀ q : 𝓢(FourSpace, ℝ),
      (∫ x, f x * partialDeriv q i x) = -(∫ x, g x * q x)) :
    scalarCoordinateDerivative i (scalarComplexL2 f : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 g : 𝓢'(FourSpace, ℂ)) := by
  ext φ
  change (scalarComplexL2 f : 𝓢'(FourSpace, ℂ))
    (-scalarSchwartzCoordinateDerivative i φ) = _
  rw [map_neg]
  apply Complex.ext
  · rw [Complex.neg_re, scalarComplexL2_pairing_re, scalarComplexL2_pairing_re]
    have h := hw (φ.postcompCLM Complex.reCLM)
    have he (x : FourSpace) : partialDeriv (fun y => (φ y).re) i x =
        ((scalarSchwartzCoordinateDerivative i φ) x).re :=
      scalarSchwartz_real_partial Complex.reCLM φ i x
    change (∫ x, f x * partialDeriv (fun y => (φ y).re) i x) =
      -(∫ x, g x * (φ x).re) at h
    simp_rw [he] at h
    linarith

  · rw [Complex.neg_im, scalarComplexL2_pairing_im, scalarComplexL2_pairing_im]
    have h := hw (φ.postcompCLM Complex.imCLM)
    have he (x : FourSpace) : partialDeriv (fun y => (φ y).im) i x =
        ((scalarSchwartzCoordinateDerivative i φ) x).im :=
      scalarSchwartz_real_partial Complex.imCLM φ i x
    change (∫ x, f x * partialDeriv (fun y => (φ y).im) i x) =
      -(∫ x, g x * (φ x).im) at h
    simp_rw [he] at h
    linarith


def scalarLocalL2Gradient {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (f g : Lp ℝ 2 (volume.restrict K)) (i : Fin 4) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  scalarLocalL2Product hK χ hχ.continuous hc hs g +
    scalarLocalL2PartialProduct hK χ hχ hc hs f i

theorem scalarLocalL2Gradient_pairing {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (f g : Lp ℝ 2 (volume.restrict K)) (i : Fin 4)
    (q : 𝓢(FourSpace, ℝ)) :
    (∫ x, scalarLocalL2Gradient hK χ hχ hc hs f g i x * q x) =
      (∫ x, scalarLocalL2Product hK χ hχ.continuous hc hs g x * q x) +
        ∫ x, scalarLocalL2PartialProduct hK χ hχ hc hs f i x * q x := by
  have h₁ := (Lp.memLp (scalarLocalL2Product hK χ hχ.continuous hc hs g)).integrable_mul
    (q.memLp 2 (volume : Measure FourSpace))
  have h₂ := (Lp.memLp (scalarLocalL2PartialProduct hK χ hχ hc hs f i)).integrable_mul
    (q.memLp 2 (volume : Measure FourSpace))
  change Integrable (fun x => scalarLocalL2Product hK χ hχ.continuous hc hs g x * q x) volume at h₁
  change Integrable (fun x => scalarLocalL2PartialProduct hK χ hχ hc hs f i x * q x) volume at h₂
  rw [← integral_add h₁ h₂]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_add (scalarLocalL2Product hK χ hχ.continuous hc hs g)
    (scalarLocalL2PartialProduct hK χ hχ hc hs f i)] with x hx
  change (scalarLocalL2Product hK χ hχ.continuous hc hs g +
    scalarLocalL2PartialProduct hK χ hχ hc hs f i) x * q x = _
  rw [hx]
  simp only [Pi.add_apply, add_mul]

theorem scalarLocalL2_complex_derivative {K : Set FourSpace} (hK : MeasurableSet K)
    (f g : Lp ℝ 2 (volume.restrict K)) (i : Fin 4)
    (hw : ∀ (q : FourSpace → ℝ), ContDiff ℝ ∞ q → HasCompactSupport q →
      tsupport q ⊆ K → (∫ z in K, f z * partialDeriv q i z) =
        -(∫ z in K, g z * q z))
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    scalarCoordinateDerivative i
      (scalarComplexL2 (scalarLocalL2Product hK χ hχ.continuous hc hs f) :
        𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 (scalarLocalL2Gradient hK χ hχ hc hs f g i) :
        𝓢'(FourSpace, ℂ)) := by
  apply scalarComplexL2_weak_derivative
  intro q
  rw [scalarLocalL2Gradient_pairing]
  exact scalarLocalL2_weak_product hK f g i hw χ hχ hc hs q (q.smooth ⊤)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance complexCoordinates_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

theorem scalarH1Chart_cutoff_memSobolev_one (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (u : scalarH1 d) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hs : tsupport χ ⊆ K) :
    MemSobolev 1 2 (scalarComplexL2 (scalarLocalL2Product hK.measurableSet χ
      hχ.continuous hc hs (scalarH1ChartValue g o d c hK hKt u)) :
        𝓢'(FourSpace, ℂ)) := by
  rw [← zero_add (1 : ℝ)]
  apply (scalar_memSobolev_succ_iff 0 _).mpr
  constructor
  · exact memSobolev_zero_iff.mpr ⟨_, rfl⟩
  · intro i
    rw [scalarLocalL2_complex_derivative hK.measurableSet _
      (scalarH1ChartDerivative g o d c hK hKt i u) i
      (fun q hq hqc hqs => scalarH1Chart_weak_derivative_integral
        g o d c hK hKt u q hq hqc hqs i) χ hχ hc hs]
    exact memSobolev_zero_iff.mpr ⟨_, rfl⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Compact smooth extensions of the actual rescaled metric coefficients.
Their values and first two derivatives become uniformly small as the chart
scale tends to zero, including outside the cutoff support. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set Filter Metric
open scoped Manifold ContDiff _root_.Topology SchwartzMap

noncomputable section

theorem scalarCutoff_contDiff (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y) :
    ContDiff ℝ ∞ (fun y => χ y * f y) := by
  rw [contDiff_iff_contDiffAt]
  intro y
  by_cases hy : y ∈ tsupport χ
  · exact hχ.contDiffAt.mul (hf y hy)
  · have hz : (fun z => χ z * f z) =ᶠ[𝓝 y] (fun _ => 0) := by
      filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hy] with z hz
      simp only [hz, Pi.zero_apply, zero_mul]
    exact contDiffAt_const.congr_of_eventuallyEq hz

def scalarCutoffSchwartz (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y) :
    𝓢(FourSpace, ℂ) :=
  (hc.mul_right.comp_left (show Complex.ofReal 0 = 0 by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp (scalarCutoff_contDiff χ f hχ hf))

theorem scalarCutoffSchwartz_apply (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y)
    (y : FourSpace) : scalarCutoffSchwartz χ f hχ hc hf y = (χ y * f y : ℝ) := rfl

theorem scalarCutoffParameter_jets_uniform (F : ℝ → FourSpace → ℝ)
    {K : Set FourSpace} (hK : IsCompact K)
    (hF : ∀ y ∈ K, ContDiffAt ℝ ∞ (Function.uncurry F) (0, y))
    (hzero : ∀ y, F 0 y = 0) (hs : ∀ r, tsupport (F r) ⊆ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ η : ℝ, 0 < η ∧ ∀ r, |r| < η → ∀ y,
      |F r y| < ε ∧ (∀ i, |partialDeriv (F r) i y| < ε) ∧
      (∀ i j, |partialDeriv (fun z => partialDeriv (F r) j z) i y| < ε) := by
  obtain ⟨η, hη, hb⟩ := scalarParameter_jets_uniform F hK 0 hF hzero ε hε
  refine ⟨η, hη, ?_⟩
  intro r hr y
  by_cases hy : y ∈ K
  · simpa only [sub_zero] using hb r hr y hy
  · have hval : F r y = 0 := image_eq_zero_of_notMem_tsupport (fun ht => hy (hs r ht))
    have hder (i : Fin 4) : partialDeriv (F r) i y = 0 :=
      image_eq_zero_of_notMem_tsupport (fun ht => hy
        (hs r ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) ht)))
    have hsecond (i j : Fin 4) :
        partialDeriv (fun z => partialDeriv (F r) j z) i y = 0 :=
      image_eq_zero_of_notMem_tsupport (fun ht => hy
        (hs r ((tsupport_fderiv_apply_subset ℝ (coordinateVector j))
          ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) ht))))
    simp only [hval, hder, hsecond, abs_zero]
    exact ⟨hε, fun _ => hε, fun _ _ => hε⟩

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def scalarCutoffPrincipal (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c)
    (χ : FourSpace → ℝ) (r : ℝ) (i j : Fin 4) (y : FourSpace) : ℝ :=
  χ y * (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j)

def scalarCutoffDrift (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c)
    (χ : FourSpace → ℝ) (r : ℝ) (i : Fin 4) (y : FourSpace) : ℝ :=
  χ y * scalarRescaledDrift g c z₀ r y i

theorem scalarCutoffPrincipal_jets_uniform (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (i j : Fin 4) (ε : ℝ) (hε : 0 < ε) :
    ∃ η : ℝ, 0 < η ∧ ∀ r, |r| < η → ∀ y,
      |scalarCutoffPrincipal g c z₀ χ r i j y| < ε ∧
      (∀ k, |partialDeriv (scalarCutoffPrincipal g c z₀ χ r i j) k y| < ε) ∧
      (∀ k l, |partialDeriv
        (fun z => partialDeriv (scalarCutoffPrincipal g c z₀ χ r i j) l z) k y| < ε) := by
  apply scalarCutoffParameter_jets_uniform _ hc _ _ _ ε hε
  · intro y _
    apply (hχ.contDiffAt.comp (0, y) contDiffAt_snd).mul
    exact (scalarRescaled_function_contDiffAt g c z₀ _
      (frozenScalarPrincipal_contDiffAt g c z₀ z₀ z₀.property i j) y).sub contDiffAt_const
  · intro y
    simp only [scalarCutoffPrincipal, scalarRescaledPrincipal_zero, sub_self, mul_zero]
  · intro r
    exact tsupport_mul_subset_left

theorem scalarCutoffDrift_jets_uniform (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (i : Fin 4) (ε : ℝ) (hε : 0 < ε) :
    ∃ η : ℝ, 0 < η ∧ ∀ r, |r| < η → ∀ y,
      |scalarCutoffDrift g c z₀ χ r i y| < ε ∧
      (∀ k, |partialDeriv (scalarCutoffDrift g c z₀ χ r i) k y| < ε) ∧
      (∀ k l, |partialDeriv
        (fun z => partialDeriv (scalarCutoffDrift g c z₀ χ r i) l z) k y| < ε) := by
  apply scalarCutoffParameter_jets_uniform _ hc _ _ _ ε hε
  · intro y _
    apply (hχ.contDiffAt.comp (0, y) contDiffAt_snd).mul
    exact contDiffAt_fst.mul (scalarRescaled_function_contDiffAt g c z₀ _
      (scalarFrozenDrift_contDiffAt g c z₀ z₀ z₀.property i) y)
  · intro y
    simp only [scalarCutoffDrift, scalarRescaledDrift, zero_mul, mul_zero]
  · intro r
    exact tsupport_mul_subset_left

end
end PositiveEinsteinFour.Geometry
end


section

/-! Smooth H2 approximation with strong L4 convergence of first derivatives.
This is the convergence required by the quadratic terms in the nonlinear
Hessian chain rule in dimension four. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalarSchwartzBesselInverse_first (f : S) (i : Fin 4) :
    (D i (scalarSchwartzBesselInverse f)).toLp 2 volume =
      scalarBesselFirstL2 i (f.toLp 2 volume) := by
  apply scalarL2_distribution_injective
  dsimp only
  rw [scalarBesselFirstL2_distribution, ← scalarSchwartzBesselInverse_toLp,
    Lp.toTemperedDistribution_toLp_eq, Lp.toTemperedDistribution_toLp_eq]
  exact (lineDerivOp_toTemperedDistributionCLM_eq _ _).symm

theorem scalarSchwartzBesselInverse_second (f : S) (i j : Fin 4) :
    (D i (D j (scalarSchwartzBesselInverse f))).toLp 2 volume =
      scalarBesselSecondL2 i j (f.toLp 2 volume) := by
  apply scalarL2_distribution_injective
  dsimp only
  rw [scalarBesselSecondL2_distribution, ← scalarSchwartzBesselInverse_toLp,
    Lp.toTemperedDistribution_toLp_eq, Lp.toTemperedDistribution_toLp_eq]
  simp only [scalarCoordinateDerivative]
  rw [lineDerivOp_toTemperedDistributionCLM_eq, lineDerivOp_toTemperedDistributionCLM_eq]

theorem scalarSchwartzBesselInverse_first_four (f : S) (i : Fin 4) :
    (D i (scalarSchwartzBesselInverse f)).toLp 4 volume =
      scalarBesselFirstL4 i (f.toLp 2 volume) := by
  apply Lp.ext
  have h2 := (D i (scalarSchwartzBesselInverse f)).coeFn_toLp 2 volume
  rw [scalarSchwartzBesselInverse_first] at h2
  filter_upwards [(D i (scalarSchwartzBesselInverse f)).coeFn_toLp 4 volume,
    scalarBesselFirstL4_coe i (f.toLp 2 volume), h2] with x hx h4 h2
  exact hx.trans (h2.symm.trans h4.symm)

/-- Approximation of an H2 function controls values, first derivatives in
both L2 and L4, and second derivatives in L2 along the same sequence. -/
theorem scalar_H2_schwartz_approximation (u : L2) (hu : MemSobolev 2 2 (u : T)) :
    ∃ (v : L2) (f : ℕ → S),
      u = scalarBesselInverseL2 v ∧
      Tendsto (fun n => (f n).toLp 2 volume) atTop (𝓝 u) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 2 volume) atTop
        (𝓝 (scalarBesselFirstL2 i v))) ∧
      (∀ i, Tendsto (fun n => (D i (f n)).toLp 4 volume) atTop
        (𝓝 (scalarBesselFirstL4 i v))) ∧
      (∀ i j, Tendsto (fun n => (D i (D j (f n))).toLp 2 volume) atTop
        (𝓝 (scalarBesselSecondL2 i j v))) := by
  obtain ⟨v, hv⟩ := hu
  have hu' : u = scalarBesselInverseL2 v := by
    apply scalarL2_distribution_injective
    change (u : T) = (scalarBesselInverseL2 v : T)
    rw [scalarBesselInverseL2_distribution, ← hv, besselPotential_besselPotential_apply]
    norm_num
  have hdense := SchwartzMap.denseRange_toLpCLM (E := V) (F := ℂ)
    (μ := (volume : Measure V)) (p := 2) (by norm_num)
  obtain ⟨vs, hvs, ht⟩ := mem_closure_iff_seq_limit.mp (hdense v)
  choose fs hfs using hvs
  have ht' : Tendsto (fun n => (fs n).toLp 2 volume) atTop (𝓝 v) := by
    have he : (fun n => (fs n).toLp 2 volume) = vs := funext (fun n => hfs n)
    rwa [he]
  refine ⟨v, fun n => scalarSchwartzBesselInverse (fs n), hu', ?_, ?_, ?_, ?_⟩
  · simp only [scalarSchwartzBesselInverse_toLp, hu']
    exact (scalarBesselInverseL2.continuous.continuousAt.tendsto).comp ht'
  · intro i
    simp only [scalarSchwartzBesselInverse_first]
    exact ((scalarBesselFirstL2 i).continuous.continuousAt.tendsto).comp ht'
  · intro i
    simp only [scalarSchwartzBesselInverse_first_four]
    exact ((scalarBesselFirstL4 i).continuous.continuousAt.tendsto).comp ht'
  · intro i j
    simp only [scalarSchwartzBesselInverse_second]
    exact ((scalarBesselSecondL2 i j).continuous.continuousAt.tendsto).comp ht'

end
end PositiveEinsteinFour.Geometry
end


section

/-! Bounded cutoff multiplication from a chart L² space into Euclidean L².
These maps keep the actual local representatives used by the weak equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped ENNReal

noncomputable section

theorem scalarLocalL2Product_bound {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : Continuous χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f : Lp ℝ 2 (volume.restrict K),
      ‖scalarLocalL2Product hK χ hχ hc hs f‖ ≤ C * ‖f‖ := by
  obtain ⟨C, hC⟩ := (hc.isCompact_range hχ).isBounded.exists_norm_le
  refine ⟨max C 0, le_max_right _ _, fun f => ?_⟩
  have heq : K.indicator (fun z => χ z * f z) = (fun z => χ z * f z) := by
    apply indicator_eq_self.mpr
    intro z hz
    exact hs ((subset_tsupport χ) (left_ne_zero_of_mul hz))
  have hb : eLpNorm (fun z => χ z * f z) 2 volume ≤
      ENNReal.ofReal (max C 0) * eLpNorm f 2 (volume.restrict K) := by
    rw [← heq, eLpNorm_indicator_eq_eLpNorm_restrict hK]
    apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul
      (hχ.aestronglyMeasurable.mul (Lp.aestronglyMeasurable f))
    filter_upwards with z
    rw [Pi.mul_apply, norm_mul]
    exact mul_le_mul_of_nonneg_right
      ((hC (χ z) (mem_range_self z)).trans (le_max_left _ _)) (norm_nonneg _)
  have hr := ENNReal.toReal_mono
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (Lp.eLpNorm_ne_top f)) hb
  change ‖(scalarLocalL2_product_memLp hK χ hχ hc hs f).toLp _‖ ≤ _
  rw [Lp.norm_toLp, Lp.norm_def]
  simpa only [ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (le_max_right C 0)] using hr

theorem scalarLocalL2Product_ae_congr {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hs : tsupport χ ⊆ K) {f h : FourSpace → ℝ}
    (he : f =ᵐ[volume.restrict K] h) :
    (fun z => χ z * f z) =ᵐ[volume] (fun z => χ z * h z) := by
  have hl : (fun z => χ z * f z) =ᵐ[volume.restrict K] (fun z => χ z * h z) :=
    he.mono (fun z hz => congrArg (χ z * ·) hz)
  have hi := (ae_eq_restrict_iff_indicator_ae_eq hK).mp hl
  have hzero (q : FourSpace → ℝ) :
      K.indicator (fun z => χ z * q z) = (fun z => χ z * q z) := by
    apply indicator_eq_self.mpr
    intro z hz
    exact hs ((subset_tsupport χ) (left_ne_zero_of_mul hz))
  simpa only [hzero] using hi

def scalarLocalL2ProductLinear {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : Continuous χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    Lp ℝ 2 (volume.restrict K) →ₗ[ℝ] Lp ℝ 2 (volume : Measure FourSpace) where
  toFun := scalarLocalL2Product hK χ hχ hc hs
  map_add' f h := by
    apply Lp.ext
    have he := scalarLocalL2Product_ae_congr hK χ hs (Lp.coeFn_add f h)
    filter_upwards [scalarLocalL2Product_coe hK χ hχ hc hs (f + h),
      scalarLocalL2Product_coe hK χ hχ hc hs f,
      scalarLocalL2Product_coe hK χ hχ hc hs h,
      Lp.coeFn_add (scalarLocalL2Product hK χ hχ hc hs f)
        (scalarLocalL2Product hK χ hχ hc hs h), he] with z hsum hf hh hLp hz
    rw [hsum, hLp, Pi.add_apply, hf, hh]
    simpa only [Pi.add_apply, mul_add] using hz
  map_smul' r f := by
    apply Lp.ext
    have he := scalarLocalL2Product_ae_congr hK χ hs (Lp.coeFn_smul r f)
    filter_upwards [scalarLocalL2Product_coe hK χ hχ hc hs (r • f),
      scalarLocalL2Product_coe hK χ hχ hc hs f,
      Lp.coeFn_smul r (scalarLocalL2Product hK χ hχ hc hs f), he] with z hrf hf hLp hz
    simp only [RingHom.id_apply]
    rw [hrf, hLp, Pi.smul_apply, hf]
    simpa only [Pi.smul_apply, smul_eq_mul, mul_left_comm] using hz

def scalarLocalL2ProductCLM {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : Continuous χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) :
    Lp ℝ 2 (volume.restrict K) →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarLocalL2ProductLinear hK χ hχ hc hs).mkContinuousOfExistsBound (by
    obtain ⟨C, _, hC⟩ := scalarLocalL2Product_bound hK χ hχ hc hs
    exact ⟨C, hC⟩)

theorem scalarLocalL2ProductCLM_coe {K : Set FourSpace} (hK : MeasurableSet K)
    (χ : FourSpace → ℝ) (hχ : Continuous χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (f : Lp ℝ 2 (volume.restrict K)) :
    scalarLocalL2ProductCLM hK χ hχ hc hs f =ᵐ[volume] (fun z => χ z * f z) :=
  scalarLocalL2Product_coe hK χ hχ hc hs f

end
end PositiveEinsteinFour.Geometry
end


section

/-! Strong bounded-times-L2 products for the higher weak derivative limits. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped ENNReal _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "Linf" => Lp ℝ ∞ (volume : Measure V)

def scalarLinfL2Product : Linf →L[ℝ] L2 →L[ℝ] L2 :=
  (ContinuousLinearMap.mul ℝ ℝ).holderL volume ∞ 2 2

theorem scalarLinfL2Product_coe (f : Linf) (g : L2) :
    scalarLinfL2Product f g =ᵐ[volume] fun x => f x * g x :=
  (ContinuousLinearMap.mul ℝ ℝ).coeFn_holder f g

theorem scalarLinfL2Product_tendsto {f : ℕ → Linf} {g : ℕ → L2} {F : Linf} {G : L2}
    (hf : Tendsto f atTop (𝓝 F)) (hg : Tendsto g atTop (𝓝 G)) :
    Tendsto (fun k => scalarLinfL2Product (f k) (g k)) atTop
      (𝓝 (scalarLinfL2Product F G)) := by
  have hB : Continuous (fun z : Linf × L2 => scalarLinfL2Product z.1 z.2) :=
    scalarLinfL2Product.continuous₂
  simpa only [Function.comp_def] using (hB.tendsto (F, G)).comp (hf.prodMk_nhds hg)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Extracting the real compact-test identity from an equality of complex
L2 distributional derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ContDiff

noncomputable section

theorem scalarComplexL2_compact_weak_derivative
    (f D : Lp ℝ 2 (volume : Measure FourSpace)) (i : Fin 4)
    (hD : scalarCoordinateDerivative i (scalarComplexL2 f : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 D : 𝓢'(FourSpace, ℂ)))
    (ψ : FourSpace → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ) :
    (∫ z, f z * partialDeriv ψ i z) = -(∫ z, D z * ψ z) := by
  let φ : 𝓢(FourSpace, ℂ) := (hcψ.toSchwartzMap hψ).postcompCLM Complex.ofRealCLM
  have he := congrArg (fun T : 𝓢'(FourSpace, ℂ) => (T φ).re) hD
  change ((scalarComplexL2 f : 𝓢'(FourSpace, ℂ))
    (-scalarSchwartzCoordinateDerivative i φ)).re =
    ((scalarComplexL2 D : 𝓢'(FourSpace, ℂ)) φ).re at he
  rw [map_neg, Complex.neg_re, scalarComplexL2_pairing_re, scalarComplexL2_pairing_re] at he
  have hp (z : FourSpace) : ((scalarSchwartzCoordinateDerivative i φ) z).re =
      partialDeriv ψ i z := by
    exact (scalarSchwartz_real_partial Complex.reCLM φ i z).symm
  simp_rw [hp] at he
  change -(∫ z, f z * partialDeriv ψ i z) = ∫ z, D z * ψ z at he
  linarith only [he]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Real components of the actual complex distributional test pairing.
Only the compactly localized source must be smooth and integrable. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)

theorem scalarComplexL2_pairing_component (w : Lp ℝ 2 (volume : Measure V))
    (L : ℂ →L[ℝ] ℝ) (φ : S) :
    L ((scalarComplexL2 w : 𝓢'(V, ℂ)) φ) = ∫ x, w x * L (φ x) := by
  have hi := (φ.memLp 2 (volume : Measure V)).integrable_mul
    (Lp.memLp (scalarComplexL2 w))
  change Integrable (fun x => φ x * scalarComplexL2 w x) volume at hi
  rw [Lp.toTemperedDistribution_apply]
  change L (∫ x, φ x * scalarComplexL2 w x) = _
  rw [← L.integral_comp_comm hi]
  apply integral_congr_ae
  filter_upwards [scalarComplexL2_coe w] with x hx
  rw [hx, mul_comm (φ x), ← Complex.real_smul, L.map_smul]
  rfl

theorem scalarComplexSource_pairing_component (s : V → ℝ) (L : ℂ →L[ℝ] ℝ)
    (φ : S) (hc : HasCompactSupport (φ : V → ℂ))
    (hs : ∀ x ∈ tsupport (φ : V → ℂ), ContDiffAt ℝ (⊤ : ℕ∞) s x) (κ : ℝ) :
    L (∫ x, φ x * ((κ * s x : ℝ) : ℂ)) =
      κ * ∫ x, s x * L (φ x) := by
  let F := scalarLocalSourceSchwartz φ (fun x => ((κ * s x : ℝ) : ℂ)) hc
    (fun x hx => Complex.ofRealCLM.contDiff.contDiffAt.comp x
      (contDiffAt_const.mul (hs x hx)))
  have hi : Integrable (fun x => φ x * ((κ * s x : ℝ) : ℂ)) volume := F.integrable
  rw [← L.integral_comp_comm hi, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with x
  rw [mul_comm (φ x), ← Complex.real_smul, L.map_smul]
  change (κ * s x) * L (φ x) = κ * (s x * L (φ x))
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The real small-jet bounds for compact metric coefficients are exactly
the complex Schwartz derivative bounds used by the elliptic estimates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff SchwartzMap

noncomputable section

theorem scalarComplex_partial (f : FourSpace → ℝ) (x : FourSpace)
    (hf : DifferentiableAt ℝ f x) (i : Fin 4) :
    (fderiv ℝ (fun y => (f y : ℂ)) x) (EuclideanSpace.basisFun (Fin 4) ℝ i) =
      (partialDeriv f i x : ℂ) := by
  change (fderiv ℝ (Complex.ofRealCLM ∘ f) x)
    (EuclideanSpace.basisFun (Fin 4) ℝ i) = _
  rw [_root_.fderiv_comp (f := f) (g := (Complex.ofRealCLM : ℝ → ℂ))
    x Complex.ofRealCLM.differentiableAt hf, Complex.ofRealCLM.fderiv]
  simp only [ContinuousLinearMap.comp_apply, EuclideanSpace.basisFun_apply, partialDeriv, coordinateVector, Complex.ofRealCLM_apply]

theorem scalarCutoffSchwartz_first (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y)
    (i : Fin 4) (x : FourSpace) :
    scalarSchwartzCoordinateDerivative i (scalarCutoffSchwartz χ f hχ hc hf) x =
      (partialDeriv (fun y => χ y * f y) i x : ℂ) := by
  change (fderiv ℝ (fun y => ((χ y * f y : ℝ) : ℂ)) x)
    (EuclideanSpace.basisFun (Fin 4) ℝ i) = _
  exact scalarComplex_partial _ x
    ((scalarCutoff_contDiff χ f hχ hf).differentiable (by simp) x) i

theorem scalarCutoffSchwartz_second (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y)
    (i j : Fin 4) (x : FourSpace) :
    scalarSchwartzCoordinateDerivative i
      (scalarSchwartzCoordinateDerivative j (scalarCutoffSchwartz χ f hχ hc hf)) x =
      (partialDeriv (fun y => partialDeriv (fun z => χ z * f z) j y) i x : ℂ) := by
  have he : (fun y => scalarSchwartzCoordinateDerivative j
      (scalarCutoffSchwartz χ f hχ hc hf) y) =
        fun y => (partialDeriv (fun z => χ z * f z) j y : ℂ) :=
    funext (scalarCutoffSchwartz_first χ f hχ hc hf j)
  change (fderiv ℝ (fun y => scalarSchwartzCoordinateDerivative j
    (scalarCutoffSchwartz χ f hχ hc hf) y) x)
      (EuclideanSpace.basisFun (Fin 4) ℝ i) = _
  rw [he]
  apply scalarComplex_partial
  exact (((scalarCutoff_contDiff χ f hχ hf).fderiv_right (m := ∞) (by simp)).clm_apply
    (contDiff_const (c := coordinateVector j))).differentiable (by simp) x

theorem scalarCutoffSchwartz_jet_bounds (χ f : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hf : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ f y)
    (δ : ℝ)
    (h₀ : ∀ x, |χ x * f x| ≤ δ)
    (h₁ : ∀ i x, |partialDeriv (fun y => χ y * f y) i x| ≤ δ)
    (h₂ : ∀ i j x, |partialDeriv
      (fun y => partialDeriv (fun z => χ z * f z) j y) i x| ≤ δ) :
    (∀ x, ‖scalarCutoffSchwartz χ f hχ hc hf x‖ ≤ δ) ∧
      (∀ i x, ‖scalarSchwartzCoordinateDerivative i
        (scalarCutoffSchwartz χ f hχ hc hf) x‖ ≤ δ) ∧
      (∀ i j x, ‖scalarSchwartzCoordinateDerivative i
        (scalarSchwartzCoordinateDerivative j (scalarCutoffSchwartz χ f hχ hc hf)) x‖ ≤ δ) := by
  refine ⟨?_, ?_, ?_⟩
  · intro x
    simpa only [scalarCutoffSchwartz_apply, Complex.norm_real, Real.norm_eq_abs] using h₀ x
  · intro i x
    rw [scalarCutoffSchwartz_first, Complex.norm_real, Real.norm_eq_abs]
    exact h₁ i x
  · intro i j x
    rw [scalarCutoffSchwartz_second, Complex.norm_real, Real.norm_eq_abs]
    exact h₂ i j x

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local division by a smooth positive density at Sobolev order two. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric Filter
open scoped SchwartzMap ENNReal ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)
local notation "L2" => Lp ℂ 2 (volume : Measure V)

private def densityCutoffL2 (φ : S) (w : L2) : L2 :=
  scalarL2Multiply (φ.toLp ∞ volume) w

private theorem densityCutoffL2_distribution (φ : S) (w : L2) :
    (densityCutoffL2 φ w : T) = smulLeftCLM ℂ φ (w : T) := by
  unfold densityCutoffL2
  rw [SchwartzMap.toLp]
  exact scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp ∞ volume) w

private theorem densityCutoffL2_coe (φ : S) (w : L2) :
    (densityCutoffL2 φ w : V → ℂ) =ᵐ[volume] fun y => φ y * w y := by
  change (((φ.toLp ∞ volume) • w : L2) : V → ℂ) =ᵐ[volume] _
  filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) (φ.toLp ∞ volume) w,
    φ.coeFn_toLp ∞ volume] with y hy hφ
  simpa only [smul_eq_mul, Pi.mul_apply, hφ] using hy

private theorem densityCutoff_support (χ ρ : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (hρ : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y) :
    tsupport ((scalarCutoffSchwartz χ (fun y => (ρ y)⁻¹) hχ hc hρ) : V → ℂ) ⊆
      tsupport χ :=
  (tsupport_comp_subset (g := Complex.ofReal) (by simp)
    (fun y => χ y * (ρ y)⁻¹)).trans tsupport_mul_subset_left

theorem scalar_H2_density_division (ρ b : V → ℝ) (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ closedBall (0 : V) (1 / 2))
    (hρ : ∀ y ∈ tsupport χ, ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y)
    (hρ0 : ∀ y ∈ tsupport χ, ρ y ≠ 0) :
    ∃ v : L2, MemSobolev 2 2 (v : T) ∧
      (v : V → ℂ) =ᵐ[volume] fun y => (χ y * b y : ℝ) := by
  let φ := scalarCutoffSchwartz χ (fun y => (ρ y)⁻¹) hχ hc hρ
  have hφχ : tsupport (φ : V → ℂ) ⊆ tsupport χ := densityCutoff_support χ ρ hχ hc hρ
  have hφc : HasCompactSupport (φ : V → ℂ) :=
    hc.of_isClosed_subset (isClosed_tsupport _) hφχ
  have hφs : tsupport (φ : V → ℂ) ⊆ closedBall (0 : V) (1 / 2) :=
    hφχ.trans hs
  refine ⟨densityCutoffL2 φ (scalarComplexL2 w), ?_, ?_⟩
  · rw [densityCutoffL2_distribution]
    exact hreg φ hφc hφs
  have hglob := (ae_restrict_iff' isOpen_ball.measurableSet).mp heq
  filter_upwards [densityCutoffL2_coe φ (scalarComplexL2 w), scalarComplexL2_coe w,
    hglob] with y hv hw hy
  rw [hv, hw]
  change ((χ y * (ρ y)⁻¹ : ℝ) : ℂ) * (w y : ℂ) = _
  by_cases hz : χ y = 0
  · simp only [hz, zero_mul, Complex.ofReal_zero]
  · have ht : y ∈ tsupport χ := subset_tsupport χ hz
    have hin : y ∈ ball (0 : V) 1 := closedBall_subset_ball (by norm_num) (hs ht)
    rw [← hy hin, ← Complex.ofReal_mul]
    congr 1
    calc
      χ y * (ρ y)⁻¹ * (ρ y * b y) = χ y * ((ρ y)⁻¹ * ρ y) * b y := by ring
      _ = χ y * b y := by rw [inv_mul_cancel₀ (hρ0 y ht), mul_one]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Extract a smooth real representative from all local integer Sobolev orders. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

private def halfSmoothBump : ContDiffBump (0 : V) where
  rIn := 1 / 8
  rOut := 1 / 4
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

private def halfSmoothCutoff : S :=
  (halfSmoothBump.hasCompactSupport.comp_left
    (show Complex.ofReal (0 : ℝ) = 0 by rfl)).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp halfSmoothBump.contDiff)

private theorem halfSmoothCutoff_apply (x : V) : halfSmoothCutoff x = (halfSmoothBump x : ℂ) := rfl

private theorem halfSmoothCutoff_support :
    tsupport (halfSmoothCutoff : V → ℂ) ⊆ closedBall 0 (1 / 4) := by
  have hs : Function.support (halfSmoothCutoff : V → ℂ) =
      Function.support (halfSmoothBump : V → ℝ) := by
    ext x
    simp only [Function.mem_support, halfSmoothCutoff_apply, ne_eq, Complex.ofReal_eq_zero]
  rw [tsupport, hs]
  change tsupport (halfSmoothBump : V → ℝ) ⊆ _
  rw [halfSmoothBump.tsupport_eq]
  exact Subset.refl _

private theorem halfSmoothCutoff_one {x : V} (hx : x ∈ ball 0 (1 / 8)) :
    halfSmoothCutoff x = 1 := by
  change (halfSmoothBump x : ℂ) = 1
  rw [halfSmoothBump.one_of_mem_closedBall (ball_subset_closedBall hx), Complex.ofReal_one]

theorem scalar_half_smooth_real_representative (u : Lp ℝ 2 (volume : Measure V))
    (hreg : ∀ n : ℕ, ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 u : T))) :
    ∃ f : V → ℝ, ContDiff ℝ ∞ f ∧
      (u : V → ℝ) =ᵐ[volume.restrict (ball 0 (1 / 8))] f := by
  let φ := halfSmoothCutoff
  have hc : HasCompactSupport (φ : V → ℂ) :=
    (isCompact_closedBall (0 : V) (1 / 4)).of_isClosed_subset (isClosed_tsupport _) halfSmoothCutoff_support
  obtain ⟨f, hf, he⟩ := scalar_L2_cutoff_smooth_on (scalarComplexL2 u) φ
    (ball 0 (1 / 8)) isOpen_ball.measurableSet (fun _ hx => halfSmoothCutoff_one hx)
    (fun n => hreg n φ hc (halfSmoothCutoff_support.trans
      (closedBall_subset_ball (by norm_num))))
  refine ⟨fun x => (f x).re, Complex.reCLM.contDiff.comp hf, ?_⟩
  filter_upwards [he, ae_restrict_of_ae (scalarComplexL2_coe u)] with x hx hu
  have h := congrArg Complex.re hx
  simpa only [hu, Complex.ofReal_re] using h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Integer-order Bessel inverses on the actual Euclidean L2 space.
These supply the common smooth approximation for the higher nonlinear bootstrap. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution FourierTransform Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)

private def integerBesselSymbol (n : ℕ) (x : V) : ℂ :=
  ((1 + ‖x‖ ^ 2) ^ (-((n : ℝ) / 2)) : ℝ)

private theorem integerBesselSymbol_temperate (n : ℕ) :
    (integerBesselSymbol n).HasTemperateGrowth := by
  unfold integerBesselSymbol
  fun_prop

private theorem integerBesselSymbol_bound (n : ℕ) (x : V) :
    ‖integerBesselSymbol n x‖ ≤ 1 := by
  rw [integerBesselSymbol, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.rpow_pos_of_pos (by positivity) _)]
  exact Real.rpow_le_one_of_one_le_of_nonpos (by nlinarith [sq_nonneg ‖x‖])
    (neg_nonpos.mpr (div_nonneg (Nat.cast_nonneg _) (by norm_num)))

private theorem integerBesselSymbol_memLp (n : ℕ) :
    MemLp (integerBesselSymbol n) ∞ (volume : Measure V) :=
  memLp_top_of_bound (integerBesselSymbol_temperate n).1.continuous.aestronglyMeasurable
    1 (.of_forall (integerBesselSymbol_bound n))

def scalarIntegerBesselInverse (n : ℕ) : L2 →L[ℂ] L2 :=
  scalarL2FourierMultiplier ((integerBesselSymbol_memLp n).toLp _)

theorem scalarIntegerBesselInverse_distribution (n : ℕ) (f : L2) :
    (scalarIntegerBesselInverse n f : T) = besselPotential V ℂ (-(n : ℝ)) (f : T) := by
  rw [scalarIntegerBesselInverse, scalarL2FourierMultiplier_distribution _
    (integerBesselSymbol_temperate n) (integerBesselSymbol_memLp n), besselPotential]
  have hs : integerBesselSymbol n =
      fun x : V => (((1 + ‖x‖ ^ 2) ^ ((-(n : ℝ)) / 2) : ℝ) : ℂ) := by
    funext x
    simp only [integerBesselSymbol, neg_div]
  rw [hs]

theorem scalarIntegerBesselInverse_memSobolev (n : ℕ) (f : L2) :
    MemSobolev (n : ℝ) 2 (scalarIntegerBesselInverse n f : T) := by
  rw [scalarIntegerBesselInverse_distribution, memSobolev_besselPotential_iff, neg_add_cancel]
  exact memSobolev_zero_iff.mpr ⟨f, rfl⟩

def scalarSchwartzIntegerBesselInverse (n : ℕ) (φ : S) : S :=
  SchwartzMap.fourierMultiplierCLM ℂ (integerBesselSymbol n) φ

theorem scalarSchwartzIntegerBesselInverse_distribution (n : ℕ) (φ : S) :
    (scalarSchwartzIntegerBesselInverse n φ : T) = besselPotential V ℂ (-(n : ℝ)) (φ : T) := by
  rw [scalarSchwartzIntegerBesselInverse, besselPotential]
  have hs : integerBesselSymbol n =
      fun x : V => (((1 + ‖x‖ ^ 2) ^ ((-(n : ℝ)) / 2) : ℝ) : ℂ) := by
    funext x
    simp only [integerBesselSymbol, neg_div]
  rw [← hs]
  exact (fourierMultiplierCLM_toTemperedDistributionCLM_eq
    (integerBesselSymbol_temperate n) φ).symm

theorem scalarSchwartzIntegerBesselInverse_toLp (n : ℕ) (φ : S) :
    (scalarSchwartzIntegerBesselInverse n φ).toLp 2 volume =
      scalarIntegerBesselInverse n (φ.toLp 2 volume) := by
  apply scalarL2_distribution_injective
  change ((scalarSchwartzIntegerBesselInverse n φ).toLp 2 volume : T) =
    (scalarIntegerBesselInverse n (φ.toLp 2 volume) : T)
  rw [Lp.toTemperedDistribution_toLp_eq, scalarSchwartzIntegerBesselInverse_distribution,
    scalarIntegerBesselInverse_distribution, Lp.toTemperedDistribution_toLp_eq]

theorem scalar_integer_Hn_schwartz_approximation (n : ℕ) (u : L2)
    (hu : MemSobolev (n : ℝ) 2 (u : T)) :
    ∃ v : L2, ∃ φ : ℕ → S,
      u = scalarIntegerBesselInverse n v ∧
      Tendsto (fun k => (φ k).toLp 2 volume) atTop (𝓝 v) ∧
      Tendsto (fun k => (scalarSchwartzIntegerBesselInverse n (φ k)).toLp 2 volume)
        atTop (𝓝 u) := by
  obtain ⟨v, hv⟩ := hu
  have heq : u = scalarIntegerBesselInverse n v := by
    apply scalarL2_distribution_injective
    change (u : T) = (scalarIntegerBesselInverse n v : T)
    rw [scalarIntegerBesselInverse_distribution, ← hv, besselPotential_besselPotential_apply]
    simp
  obtain ⟨vs, hvs, ht⟩ := mem_closure_iff_seq_limit.mp
    (SchwartzMap.denseRange_toLpCLM (E := V) (F := ℂ)
      (μ := (volume : Measure V)) (p := 2) (by norm_num) v)
  choose φ hφ using hvs
  have hφv : Tendsto (fun k => (φ k).toLp 2 volume) atTop (𝓝 v) := by
    have he : (fun k => (φ k).toLp 2 volume) = vs := funext (fun k => hφ k)
    rwa [he]
  refine ⟨v, φ, heq, hφv, ?_⟩
  simp only [scalarSchwartzIntegerBesselInverse_toLp, heq]
  exact (scalarIntegerBesselInverse n).continuous.continuousAt.tendsto.comp hφv

end
end PositiveEinsteinFour.Geometry
end


section

/-! Extract a C1 representative on a fixed smaller ball from actual local
H4 regularity. The cutoff and its L2 realization are constructed here. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

private def localC1Bump : ContDiffBump (0 : V) where
  rIn := 1 / 4
  rOut := 1 / 2
  rIn_pos := by norm_num
  rIn_lt_rOut := by norm_num

private def localC1Cutoff : S :=
  (localC1Bump.hasCompactSupport.comp_left
    (show Complex.ofReal (0 : ℝ) = 0 by rfl)).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp localC1Bump.contDiff)

private theorem localC1Cutoff_apply (x : V) : localC1Cutoff x = (localC1Bump x : ℂ) := rfl

private theorem localC1Cutoff_support :
    tsupport (localC1Cutoff : V → ℂ) ⊆ closedBall 0 (1 / 2) := by
  have hs : Function.support (localC1Cutoff : V → ℂ) =
      Function.support (localC1Bump : V → ℝ) := by
    ext x
    simp only [Function.mem_support, localC1Cutoff_apply, ne_eq, Complex.ofReal_eq_zero]
  rw [tsupport, hs]
  change tsupport (localC1Bump : V → ℝ) ⊆ _
  rw [localC1Bump.tsupport_eq]
  exact Subset.refl _

private theorem localC1Cutoff_one {x : V} (hx : x ∈ ball 0 (1 / 4)) :
    localC1Cutoff x = 1 := by
  change (localC1Bump x : ℂ) = 1
  rw [localC1Bump.one_of_mem_closedBall (ball_subset_closedBall hx), Complex.ofReal_one]

theorem scalar_local_H4_C1_real_representative (u : Lp ℝ 2 (volume : Measure V))
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 4 2 (smulLeftCLM ℂ φ (scalarComplexL2 u : T))) :
    ∃ f : V → ℝ, ContDiff ℝ 1 f ∧
      (u : V → ℝ) =ᵐ[volume.restrict (ball 0 (1 / 4))] f := by
  let φ := localC1Cutoff
  have hc : HasCompactSupport (φ : V → ℂ) :=
    (isCompact_closedBall (0 : V) (1 / 2)).of_isClosed_subset (isClosed_tsupport _) localC1Cutoff_support
  let v := scalarL2Multiply (φ.toLp ∞ volume) (scalarComplexL2 u)
  have hv : (v : T) = smulLeftCLM ℂ φ (scalarComplexL2 u : T) := by
    dsimp [v]
    rw [SchwartzMap.toLp]
    exact scalarL2Multiply_distribution _ φ.hasTemperateGrowth (φ.memLp ∞ volume) _
  have hveq : v =ᵐ[volume] fun x => φ x * scalarComplexL2 u x := by
    change ((φ.toLp ∞ volume) • scalarComplexL2 u : Lp ℂ 2 volume) =ᵐ[volume] _
    filter_upwards [Lp.coeFn_lpSMul (r := (2 : ℝ≥0∞)) (φ.toLp ∞ volume) (scalarComplexL2 u),
      φ.coeFn_toLp ∞ volume] with x hx hφ
    simpa only [smul_eq_mul, Pi.mul_apply, hφ] using hx
  obtain ⟨f, hf, he⟩ := scalar_L2_H4_C1_real_representative v
    (by rw [hv]; exact hreg φ hc localC1Cutoff_support)
  refine ⟨f, hf, ?_⟩
  apply (ae_restrict_iff' isOpen_ball.measurableSet).mpr
  filter_upwards [he, hveq, scalarComplexL2_coe u] with x hx hvx hux
  intro hxB
  rw [hvx, localC1Cutoff_one hxB, one_mul, hux, Complex.ofReal_re] at hx
  exact hx

end
end PositiveEinsteinFour.Geometry
end


