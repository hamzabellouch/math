/-! Values and curvature potentials in the actual normal frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Metric
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem heat_framedValue_chart {g : SmoothMetric M} (o : FrameOrientation g)
    (u : M → TwoFormFour) (c : M) (e : FrameBundle g)
    (he : e.base ∈ (chartAt FourSpace c).source) :
    twoFormFramedValue o u e = frameTensor (frameChartMatrix g c e)
      (twoFormCoordinates o u c (chartAt FourSpace c e.base)) := by
  have hb := mem_chart_source FourSpace e.base
  have ht := twoFormCoordinates_transition o u e.base c
    (chartAt FourSpace e.base e.base) ((chartAt FourSpace e.base).map_source hb)
    (by simpa only [(chartAt FourSpace e.base).left_inv hb] using he)
  have hz : chartTransition e.base c (chartAt FourSpace e.base e.base) =
      chartAt FourSpace c e.base := by
    change chartAt FourSpace c ((chartAt FourSpace e.base).symm
      (chartAt FourSpace e.base e.base)) = _
    rw [(chartAt FourSpace e.base).left_inv hb]
  rw [hz] at ht
  rw [frameChartMatrix_eq, frameTensor_mul, ← ht]
  rfl

variable [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.value_as_actual {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (u : M → TwoFormFour) (x : FourSpace) (hx : x ∈ ball 0 D.radius) :
    heatNormalTwoFormValue o c D.point u x = twoFormFrameValue o u (D.frame x hx) := by
  apply twoFormTensor_injective
  rw [heatNormalTwoFormValue_tensor, ← twoFormFramedValue_eq]
  have h := heat_framedValue_chart o u c (D.frame x hx)
    ((chartAt FourSpace c).map_target (D.in_chart x hx))
  have hm : frameChartMatrix g c (D.frame x hx) = (D.point x).2 :=
    frameChartMatrix_chartFrameState g c
      ⟨D.point x, D.in_chart x hx, D.orthonormal x hx⟩
  have hb : chartAt FourSpace c (D.frame x hx).base = (D.point x).1 :=
    (chartAt FourSpace c).right_inv (D.in_chart x hx)
  rw [hm, hb] at h
  exact h.symm

theorem HeatNormalFrameData.potential_action_as_actual {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (u : M → TwoFormFour) (x : FourSpace) (hx : x ∈ ball 0 D.radius) :
    WithLp.toLp 2 (heatNormalPotential g c D.point x *ᵥ
      WithLp.ofLp (heatNormalTwoFormValue o c D.point u x)) =
      (6 : ℝ) • twoFormFrameValue o u (D.frame x hx) -
        (2 : ℝ) • twoFormFrameValue o (twoFormCurvatureField o u) (D.frame x hx) := by
  rw [D.potential_as_actual x hx, D.value_as_actual u x hx,
    twoFormCurvatureField_frame]
  apply twoFormPotentialMatrix_apply
  intro i j k l
  simp only [twoFormMetricCurvatureTensor, frameTensor_curvatureCoordinates]
  exact frame_algebraic_lastSkew (D.frame x hx).frame i j k l

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar local heat operator is the negative geometric Laplacian
in the actual normal chart. Both its inverse metric and drift are derived. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Metric
open scoped Manifold ContDiff _root_.Topology BigOperators Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem HeatNormalFrameData.scalar_operator_pullback (D : HeatNormalFrameData g o c e)
    (x : FourSpace) (hx : x ∈ ball 0 D.radius) (hP : ContDiffAt ℝ 2 D.point x)
    (hs : frameExponential g o e x ∈ (chartAt FourSpace c).source)
    (hd : 0 < (heatNormalMetric g o e x).det) (u : FourSpace → ℝ)
    (hu : ContDiffAt ℝ 2 u (D.point x).1) :
    fourHeatLocalOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x) 0
      (fun y => u (D.point y).1) x = -scalarChartOperator g c u (D.point x).1 := by
  let F := fun y => (D.point y).1
  let J := jacobianMatrix F x
  let A := (heatNormalMetric g o e x)⁻¹
  let H := (metricInChart g c (D.point x).1)⁻¹
  let Q : Mat4 := fun r s => partialDeriv (partialDeriv u r) s (F x)
  let S := fun r => partialDeriv u r (F x)
  have hA : J * A * Jᵀ = H := D.inverseMetric_transport x hx hs hd.ne'
  have hb := D.drift_transport_at x hx hP hs hd
  have h := heat_rough_trace_algebra J A H Q
    (fun i => matrixPartial (jacobianMatrix F) i x) (heatNormalDrift g o e x) S
    (fun r => ∑ p, ∑ q, H p q * christoffel g c (F x) r p q) hA
    (fun i j r => heatJacobian_partials_commute hP.fst r j i) hb
  have hf (i : Fin 4) : partialDeriv (fun y => u (D.point y).1) i x =
      ∑ r, J r i * S r :=
    partialDeriv_comp (hP.fst.differentiableAt (by norm_num))
      (hu.differentiableAt (by norm_num)) i
  have hsecond (i j : Fin 4) :
      partialDeriv (partialDeriv (fun y => u (D.point y).1) i) j x =
        (∑ r, matrixPartial (jacobianMatrix F) j x r i * S r) +
          ∑ r, ∑ s, J r i * J s j * Q r s :=
    heat_scalar_second_comp F u x hP.fst hu i j
  change -(∑ i, ∑ j, A i j *
    partialDeriv (partialDeriv (fun y => u (D.point y).1) i) j x) +
      (∑ i, heatNormalDrift g o e x i * partialDeriv (fun y => u (D.point y).1) i x) +
        0 * u (D.point x).1 = _
  simp only [zero_mul, add_zero, hf, hsecond]
  rw [h, heat_connection_trace_expand]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro r _
  apply Finset.sum_congr rfl
  intro s _
  have hH : H s r = H r s := by
    exact congrArg (fun B : Mat4 => B r s)
      (show Hᵀ = H by
        dsimp only [H]
        rw [Matrix.transpose_nonsing_inv]
        congr 1
        ext a b
        exact metricInChart_comm g c (D.point x).1 b a)
  rw [hH]
  change H r s * (partialDeriv (partialDeriv u s) r (F x) -
    ∑ k, christoffel g c (F x) k s r * partialDeriv u k (F x)) = _
  simp only [christoffel_comm g c (F x) _ s r]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local Sobolev representatives give the Sobolev regularity of every
compact smooth cutoff, by an actual finite smooth partition of unity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set TemperedDistribution
open scoped BigOperators Manifold ContDiff SchwartzMap

noncomputable section

theorem scalar_distribution_memSobolev_finset (n : ℕ) {ι : Type*} (s : Finset ι)
    (F : ι → 𝓢'(FourSpace, ℂ)) (hF : ∀ i ∈ s, MemSobolev (n : ℝ) 2 (F i)) :
    MemSobolev (n : ℝ) 2 (∑ i ∈ s, F i) := by
  induction s using Finset.cons_induction_on with
  | empty => simpa only [Finset.sum_empty] using memSobolev_fun_zero FourSpace ℂ (n : ℝ) 2
  | cons i s hi ih =>
      rw [Finset.sum_cons]
      exact (hF i (Finset.mem_cons_self i s)).add
        (ih (fun j hj => hF j (Finset.mem_cons_of_mem hj)))

theorem scalar_compact_sobolev_assembly (n : ℕ) (f : Lp ℝ 2 (volume : Measure FourSpace))
    (a : FourSpace → ℝ) (ha : ContDiff ℝ ∞ a) (hc : HasCompactSupport a)
    (hloc : ∀ x ∈ tsupport a, ∃ U : Set FourSpace, IsOpen U ∧ x ∈ U ∧
      ∃ v : Lp ℂ 2 (volume : Measure FourSpace), MemSobolev (n : ℝ) 2 (v : 𝓢'(FourSpace, ℂ)) ∧
        (v : FourSpace → ℂ) =ᵐ[volume.restrict U] fun z => (f z : ℂ)) :
    MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ (fun z => (a z : ℂ))
      (scalarComplexL2 f : 𝓢'(FourSpace, ℂ))) := by
  let X := {x : FourSpace // x ∈ tsupport a}
  have hx (x : X) := hloc x x.property
  choose U hU hxU v hv he using hx
  have hcover : tsupport a ⊆ ⋃ x : X, U x := by
    intro x hx
    exact mem_iUnion_of_mem ⟨x, hx⟩ (hxU ⟨x, hx⟩)
  obtain ⟨s, hs⟩ := hc.elim_finite_subcover U hU hcover
  let ι := {x : X // x ∈ s}
  let : Fintype ι := Finset.Subtype.fintype s
  have hfinite : tsupport a ⊆ ⋃ i : ι, U i.val := by
    intro x hx
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.mp (hs hx)
    exact mem_iUnion_of_mem ⟨i, hi⟩ hxi
  obtain ⟨ρ, hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate
    (I := I4) (M := FourSpace) hc.isClosed (fun i : ι => U i.val)
      (fun i => hU i.val) hfinite
  let b : ι → FourSpace → ℝ := fun i z => a z * ρ i z
  have hb (i : ι) : ContDiff ℝ ∞ (b i) := ha.mul (ρ i).contMDiff.contDiff
  have hbc (i : ι) : HasCompactSupport (b i) := hc.mul_right
  have hbs (i : ι) : tsupport (b i) ⊆ U i.val := tsupport_mul_subset_right.trans (hρ i)
  have hparts (i : ι) : MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ (fun z => (b i z : ℂ))
      (scalarComplexL2 f : 𝓢'(FourSpace, ℂ))) :=
    scalar_local_sobolev_transfer n f (v i.val) (hv i.val) (U i.val) (hU i.val).measurableSet
      (he i.val) (b i) (hb i) (hbc i) (hbs i)
  have hsum : (fun z => (a z : ℂ)) = fun z => ∑ i : ι, (b i z : ℂ) := by
    funext z
    by_cases hz : a z = 0
    · simp only [b, hz, zero_mul, Complex.ofReal_zero, Finset.sum_const_zero]
    · have hρz : (∑ i : ι, ρ i z) = 1 := by
        simpa only [finsum_eq_sum_of_fintype] using ρ.sum_eq_one (subset_tsupport a hz)
      have hreal : (∑ i : ι, b i z) = a z := by
        change (∑ i : ι, a z * ρ i z) = a z
        rw [← Finset.mul_sum, hρz, mul_one]
      exact (Complex.ofReal_sum _ _).symm.trans (congrArg Complex.ofReal hreal) |>.symm
  have htemp (i : ι) : (fun z => (b i z : ℂ)).HasTemperateGrowth :=
    (((hbc i).toSchwartzMap (hb i)).postcompCLM Complex.ofRealCLM).hasTemperateGrowth
  rw [hsum, TemperedDistribution.smulLeftCLM_sum
    (g := fun i : ι => fun z => (b i z : ℂ)) (s := Finset.univ) (fun i _ => htemp i)]
  rw [sum_apply]
  change MemSobolev (n : ℝ) 2 (∑ i : ι,
    smulLeftCLM ℂ (fun z => (b i z : ℂ)) (scalarComplexL2 f : 𝓢'(FourSpace, ℂ)))
  exact scalar_distribution_memSobolev_finset n Finset.univ _ (fun i _ => hparts i)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and the invertible affine rescaling
in the local smooth representative of the actual scalar heat output. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

local instance heatUnweighting_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarBaseHeat_local_chart_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (t : ℝ≥0) (ht : 0 < t) (input : Lp ℝ 2 (normalizedVolume g)) (c : M) (z₀ : ChartTarget c) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ F : FourSpace → ℝ, ContDiffOn ℝ (⊤ : ℕ∞) F U ∧
        (fun z => scalarBaseHeat g o d t input ((chartAt FourSpace c).symm z)) =ᵐ[
          volume.restrict U] F := by
  obtain ⟨r, hr, ht, w, hw, hreg⟩ := scalarBaseHeat_local_all_orders g o d t ht input c z₀
  obtain ⟨F, hF, hFw⟩ := scalar_half_smooth_real_representative w
    hreg
  have hwsmall : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      scalarBaseHeat g o d t input ((chartAt FourSpace c).symm
        (scalarRescaledPoint g c z₀ r y))) =ᵐ[
      volume.restrict (ball (0 : FourSpace) (1 / 8))] w :=
    ae_restrict_of_ae_restrict_of_subset
      (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1)) hw
  have heq := hwsmall.trans hFw
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) (1 / 8)}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    norm_num
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1) hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContDiffOn ℝ (⊤ : ℕ∞) H U := by
    intro z hz
    apply ContDiffAt.contDiffWithinAt
    exact ((hF.contDiffAt).comp z
      (A.symm.contDiff.contDiffAt.comp z (contDiffAt_id.sub contDiffAt_const))).div
      (chartVolumeDensity_contDiffAt g c z (hUt hz))
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! The positive Euler source gains integer regularity from the actual localized solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)
local notation "C2" => Lp ℂ 2 (volume : Measure V)

theorem scalar_local_integer_nonlinear_source (n : ℕ) (hn : 2 ≤ n) (ρ b : V → ℝ)
    (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ ball 0 (1 / 2) →
      MemSobolev ((n : ℝ) + 1) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (hρ : ∀ y ∈ closedBall (0 : V) (1 / 2), ContDiffAt ℝ ∞ ρ y)
    (hρ0 : ∀ y ∈ closedBall (0 : V) (1 / 2), ρ y ≠ 0)
    (a B q A C : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ x ∈ closedBall (0 : V) (1 / 2), b x ∈ Icc a B)
    (F : C2)
    (hF : (F : V → ℂ) =ᵐ[volume.restrict (ball (0 : V) (1 / 2))]
      fun y => (ρ y * (A * b y + C * (b y) ^ q) : ℝ))
    (ψ : S) (hc : HasCompactSupport (ψ : V → ℂ))
    (hs : tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2)) :
    MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ ψ (F : T)) := by
  obtain ⟨η, hη, hηc, hηs, hone⟩ := scalar_half_ball_cutoff_of_compact hc hs
  have hinv (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) :
      ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y := (hρ y hy).inv (hρ0 y hy)
  let ηS : 𝓢(V, ℝ) := hηc.toSchwartzMap hη
  have hηSs : tsupport (ηS : V → ℝ) ⊆ ball 0 (1 / 2) := hηs
  obtain ⟨v₁, hv₁, he₁⟩ := scalar_local_integer_power_source n hn ρ b w heq hreg hinv hρ0
    a B 1 ha hB hRange ηS hηc hηSs
  obtain ⟨vq, hvq, heq'⟩ := scalar_local_integer_power_source n hn ρ b w heq hreg hinv hρ0
    a B q ha hB hRange ηS hηc hηSs
  let z : C2 := (A : ℂ) • scalarComplexL2 v₁ + (C : ℂ) • scalarComplexL2 vq
  have hz : (z : T) = (A : ℂ) • (scalarComplexL2 v₁ : T) +
      (C : ℂ) • (scalarComplexL2 vq : T) := by
    change (Lp.toTemperedDistributionCLM ℂ volume 2) _ = _
    rw [map_add, map_smul, map_smul]
    rfl
  have hz2 : MemSobolev (n : ℝ) 2 (z : T) := by
    rw [hz]
    exact (hv₁.smul (A : ℂ)).add (hvq.smul (C : ℂ))
  let θ : S := scalarCutoffSchwartz η ρ hη hηc
    (fun y hy => hρ y (ball_subset_closedBall (hηs hy)))
  let Γ : S := SchwartzMap.smulLeftCLM ℂ θ ψ
  have hΓ (y : V) : Γ y = ((η y * ρ y : ℝ) : ℂ) * ψ y := by
    simp only [Γ, SchwartzMap.smulLeftCLM_apply θ.hasTemperateGrowth, smul_eq_mul]
    rfl
  have hzeq : (z : V → ℂ) =ᵐ[volume] fun y =>
      (A * (η y * b y) + C * (η y * (b y) ^ q) : ℝ) := by
    filter_upwards [Lp.coeFn_add ((A : ℂ) • scalarComplexL2 v₁)
        ((C : ℂ) • scalarComplexL2 vq),
      Lp.coeFn_smul (A : ℂ) (scalarComplexL2 v₁),
      Lp.coeFn_smul (C : ℂ) (scalarComplexL2 vq),
      scalarComplexL2_coe v₁, scalarComplexL2_coe vq, he₁, heq']
      with y hz ha hc h₁ hq hv₁ hvq
    change ((A : ℂ) • scalarComplexL2 v₁ + (C : ℂ) • scalarComplexL2 vq) y = _
    rw [hz]
    simp only [Pi.add_apply]
    rw [ha, hc]
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [h₁, hq, hv₁, hvq]
    simp only [ηS, Real.rpow_one, Complex.ofReal_add, Complex.ofReal_mul]
    rfl
  have hidentity : smulLeftCLM ℂ ψ (F : T) = smulLeftCLM ℂ Γ (z : T) := by
    ext φ
    simp only [smulLeftCLM_apply_apply, Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [(ae_restrict_iff' isOpen_ball.measurableSet).mp hF, hzeq]
      with y hf hz
    simp only [SchwartzMap.smulLeftCLM_apply ψ.hasTemperateGrowth,
      SchwartzMap.smulLeftCLM_apply Γ.hasTemperateGrowth, smul_eq_mul, hΓ, hz]
    by_cases hy : ψ y = 0
    · simp only [hy, mul_zero, zero_mul]
    · have hys := subset_tsupport (ψ : V → ℂ) hy
      rw [hf (hs hys), hone y hys]
      simp only [one_mul, Complex.ofReal_add, Complex.ofReal_mul]
      ring
  rw [hidentity]
  exact scalar_memSobolev_schwartz_multiplier n Γ (z : T) hz2

end
end PositiveEinsteinFour.Geometry
end


section

/-! Construction of the actual L2 source and weak Poisson equation from
the eighth-moment gain of the normalized subcritical minimizer. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance scalarMinimumSource_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarMinimumSource_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_minimum_L2_source_of_memLp_eight
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (h8 : MemLp (scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w : M → ℝ) 8 (normalizedVolume g)) :
    ∃ F : Lp ℝ 2 (normalizedVolume g),
      F =ᵐ[normalizedVolume g] (fun x =>
        |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^ (p - 2) *
          scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x) ∧
      ∀ v : scalarH1 d,
        (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (scalarWeightedH1ToH1 d w))
          (scalarH1Gradient d i v)) =
          -(inner ℝ ((2 : ℝ) • scalarH1Value d (scalarWeightedH1ToH1 d w) -
            (2 * ‖w‖ ^ 2) • scalarBasePullback g o F) (scalarH1Value d v)) := by
  let f := scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w
  have hF := scalar_nonlinear_memLp_two_of_eight h8 hp hp4
  let F := hF.toLp (fun x => |f x| ^ (p - 2) * f x)
  have hrep : F =ᵐ[normalizedVolume g] (fun x => |f x| ^ (p - 2) * f x) :=
    MemLp.coeFn_toLp hF
  refine ⟨F, hrep, ?_⟩
  intro v
  apply scalar_weighted_euler_to_weak_poisson g o d w (scalarBasePullback g o F) (‖w‖ ^ 2)
  intro z
  exact scalar_minimum_euler_all_H1_of_L2_source g o d hp hp4 w hw hmin F hrep z

/-- The actual normalized minimum has an L2 nonlinear source, with no
regularity premise on its representative. -/
theorem scalar_minimum_L2_source
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2) :
    ∃ F : Lp ℝ 2 (normalizedVolume g),
      F =ᵐ[normalizedVolume g] (fun x =>
        |scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x| ^ (p - 2) *
          scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w x) ∧
      ∀ v : scalarH1 d,
        (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (scalarWeightedH1ToH1 d w))
          (scalarH1Gradient d i v)) =
          -(inner ℝ ((2 : ℝ) • scalarH1Value d (scalarWeightedH1ToH1 d w) -
            (2 * ‖w‖ ^ 2) • scalarBasePullback g o F) (scalarH1Value d v)) := by
  apply scalar_minimum_L2_source_of_memLp_eight g o d hp hp4 w hw hmin
  exact (memLp_congr_ae (scalarWeightedBaseLp_coe g o d (ENNReal.ofReal p)
    (by exact_mod_cast hp4.le) w)).mpr
    (scalar_minimum_memLp_eight g o d hp hp4 w hw hm hmin)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first derivative of the subcritical nonlinearity is square
integrable once the actual H2 estimate supplies L4 weak derivatives. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory Filter
open scoped ENNReal NNReal

noncomputable section

theorem scalar_subcritical_derivative_memLp_four
    {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]
    {f : X → ℝ} (hf : MemLp f 8 μ) {p : ℝ} (hp : 2 < p) (hp4 : p < 4) :
    MemLp (fun x => (p - 1) * |f x| ^ (p - 2)) 4 μ := by
  have hs : MemLp (fun x => |f x| ^ (2 : ℕ)) 4 μ := by
    have hexp : (8 : ℝ≥0∞) / 2 = 4 := by
      rw [show (8 : ℝ≥0∞) = 4 * 2 by norm_num]
      exact ENNReal.mul_div_cancel_right (by norm_num) (by norm_num)
    simpa only [hexp, ENNReal.toReal_ofNat, Real.rpow_ofNat, Real.norm_eq_abs] using
      hf.norm_rpow_div 2
  have hd : MemLp (fun x => 1 + |f x| ^ (2 : ℕ)) 4 μ := (memLp_const (1 : ℝ)).add hs
  have hm : MemLp (fun x => |f x| ^ (p - 2)) 4 μ := by
    apply hd.mono'
      ((continuous_abs.rpow_const (fun _ => Or.inr (by linarith : 0 ≤ p - 2))).comp_aestronglyMeasurable hf.aestronglyMeasurable)
    filter_upwards [] with x
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
    by_cases hx : |f x| ≤ 1
    · exact (Real.rpow_le_one (abs_nonneg _) hx (by linarith)).trans
        (le_add_of_nonneg_right (sq_nonneg _))
    · have hr := Real.rpow_le_rpow_of_exponent_le (le_of_not_ge hx)
        (show p - 2 ≤ 2 by linarith)
      have hr2 : |f x| ^ (p - 2) ≤ |f x| ^ (2 : ℕ) := by
        simpa only [Real.rpow_ofNat] using hr
      exact hr2.trans (le_add_of_nonneg_left zero_le_one)
  exact hm.const_mul _

theorem scalar_subcritical_nonlinear_gradient_memLp_two
    {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]
    {f v : X → ℝ} (hf : MemLp f 8 μ) (hv : MemLp v 4 μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) :
    MemLp (fun x => (p - 1) * |f x| ^ (p - 2) * v x) 2 μ :=
  by
    have : ENNReal.HolderTriple (4 : ℝ≥0∞) 4 2 := by
      constructor
      change ((4 : ℝ≥0) : ℝ≥0∞)⁻¹ + ((4 : ℝ≥0) : ℝ≥0∞)⁻¹ = ((2 : ℝ≥0) : ℝ≥0∞)⁻¹
      rw [← ENNReal.coe_inv (by norm_num : (4 : ℝ≥0) ≠ 0),
        ← ENNReal.coe_inv (by norm_num : (2 : ℝ≥0) ≠ 0), ← ENNReal.coe_add]
      norm_num
    exact (scalar_subcritical_derivative_memLp_four hf hp hp4).mul hv

end
end PositiveEinsteinFour.Geometry
end


section

/-! The sharp subcritical scalar inequality from the actual normalized
minimum, once its positive smooth representative has been established. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff NNReal ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [PreconnectedSpace M]

local instance scalarSubcriticalBound_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance scalarSubcriticalBound_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_subcritical_bound_of_positive_representative
    (g : SmoothMetric M) (o : FrameOrientation g) (hRic : RicciThree g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : 0 < ‖w‖ ^ 2)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (a : SmoothScalar (M := M)) (hpos : ∀ x, 0 < a.val x)
    (hrep : scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) w =ᵐ[normalizedVolume g] a.val)
    (b : SmoothScalar (M := M)) :
    (∫ x, |b.val x| ^ p ∂normalizedVolume g) ^ (2 / p) ≤
      (∫ x, b.val x ^ 2 ∂normalizedVolume g) + smoothScalarDirichlet d b b / 2 := by
  have hmone := (scalar_subcritical_minimum_one_of_positive_representative
    g o hRic d hp hp4 w hw hm hmin a hpos hrep).1
  have h := hmin (smoothScalarToWeightedH1 d b)
  rw [hmone, one_mul, smoothScalarToWeightedH1_norm_sq o d b] at h
  have hnorm : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) (smoothScalarToWeightedH1 d b)‖ ^ 2 =
        (∫ x, |b.val x| ^ p ∂normalizedVolume g) ^ (2 / p) := by
    rw [scalarLp_norm_sq_eq_moment (by linarith : 0 < p)]
    congr 1
    apply integral_congr_ae
    filter_upwards [scalarWeightedBaseLp_smooth g o d (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) b] with x hx
    rw [hx]
  rwa [hnorm] at h

end
end PositiveEinsteinFour.Geometry
end


section

/-! The compact weak solution operator for one plus the rough two-form
Laplacian, defined by the actual H1 and L2 pairings. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem twoFormH1ToL2_dense : DenseRange (twoFormH1ToL2 (o := o)) := by
  refine Dense.mono ?_ (smoothTwoFormToL2_dense (o := o))
  rintro _ ⟨u, rfl⟩
  refine ⟨smoothTwoFormToH1 (show SmoothH1TwoForm o from u), ?_⟩
  exact twoFormH1ToL2_smooth _

def twoFormRoughSolution : TwoFormL2 o →L[ℝ] TwoFormH1 o :=
  (twoFormH1ToL2 (o := o)).adjoint

theorem twoFormRoughSolution_weak (f : TwoFormL2 o) (v : TwoFormH1 o) :
    inner ℝ (twoFormRoughSolution f) v = inner ℝ f (twoFormH1ToL2 v) :=
  ContinuousLinearMap.adjoint_inner_left twoFormH1ToL2 v f

theorem twoFormRoughSolution_unique (f : TwoFormL2 o) (u : TwoFormH1 o)
    (hu : ∀ v, inner ℝ u v = inner ℝ f (twoFormH1ToL2 v)) :
    u = twoFormRoughSolution f := by
  apply ext_inner_right ℝ
  intro v
  exact (hu v).trans (twoFormRoughSolution_weak f v).symm

def twoFormRoughResolvent : TwoFormL2 o →L[ℝ] TwoFormL2 o :=
  twoFormH1ToL2.comp twoFormRoughSolution

theorem twoFormRoughResolvent_compact : IsCompactOperator (twoFormRoughResolvent (o := o)) :=
  twoFormH1ToL2_compact.comp_clm twoFormRoughSolution

theorem twoFormRoughResolvent_inner (f h : TwoFormL2 o) :
    inner ℝ (twoFormRoughResolvent f) h =
      inner ℝ (twoFormRoughSolution f) (twoFormRoughSolution h) :=
  (ContinuousLinearMap.adjoint_inner_right twoFormH1ToL2 (twoFormRoughSolution f) h).symm

theorem twoFormRoughResolvent_selfAdjoint (f h : TwoFormL2 o) :
    inner ℝ (twoFormRoughResolvent f) h = inner ℝ f (twoFormRoughResolvent h) := by
  calc
    _ = inner ℝ (twoFormRoughSolution f) (twoFormRoughSolution h) := twoFormRoughResolvent_inner f h
    _ = inner ℝ (twoFormRoughSolution h) (twoFormRoughSolution f) := real_inner_comm _ _
    _ = inner ℝ (twoFormRoughResolvent h) f := (twoFormRoughResolvent_inner h f).symm
    _ = _ := real_inner_comm _ _

theorem twoFormRoughResolvent_nonneg (f : TwoFormL2 o) :
    0 ≤ inner ℝ (twoFormRoughResolvent f) f := by
  rw [twoFormRoughResolvent_inner]
  exact real_inner_self_nonneg

theorem twoFormRoughSolution_injective : Function.Injective (twoFormRoughSolution (o := o)) := by
  suffices hz : ∀ f : TwoFormL2 o, twoFormRoughSolution f = 0 → f = 0 by
    intro f h he
    apply sub_eq_zero.mp
    apply hz
    rw [map_sub, he, sub_self]
  intro f hf
  have hall : ∀ v : TwoFormH1 o, inner ℝ f (twoFormH1ToL2 v) = 0 := by
    intro v
    rw [← twoFormRoughSolution_weak, hf, inner_zero_left]
  have heq : (fun x : TwoFormL2 o => inner ℝ f x) = fun _ => 0 :=
    twoFormH1ToL2_dense.equalizer (continuous_const.inner continuous_id)
      continuous_const (funext hall)
  exact (inner_self_eq_zero (𝕜 := ℝ)).mp (congrFun heq f)

theorem twoFormRoughResolvent_injective : Function.Injective (twoFormRoughResolvent (o := o)) := by
  intro f h he
  apply twoFormRoughSolution_injective
  have he' : twoFormRoughResolvent (f - h) = 0 := by rw [map_sub, he, sub_self]
  have hz : ‖twoFormRoughSolution (f - h)‖ ^ 2 = 0 := by
    rw [← real_inner_self_eq_norm_sq, ← twoFormRoughResolvent_inner, he', inner_zero_left]
  have hs : twoFormRoughSolution (f - h) = 0 := norm_eq_zero.mp (sq_eq_zero_iff.mp hz)
  exact sub_eq_zero.mp (by simpa only [map_sub] using hs)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The separated scalar tests agree in L2 with the actual mass and
covariant-energy tests of a compact two-form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Matrix Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

variable (c : M) (S : Mat4) (hS : Sᵀ * S = 1) (χ ψ : FourSpace → ℝ)
  (hχ : ContDiff ℝ ∞ χ) (hcχ : HasCompactSupport χ)
  (hχs : tsupport χ ⊆ (chartAt FourSpace c).target)
  (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ)
  (hψs : tsupport ψ ⊆ (chartAt FourSpace c).target)
  (hon : ∀ z ∈ tsupport ψ, χ z = 1) (b : TwoFormFour)

include hon in
theorem twoFormMassTestL2_separated :
    twoFormMassTestL2 (g := g) c (fun z => ψ z • b) (hψ.smul contDiff_const).contDiffOn
      hcψ.smul_right ((tsupport_smul_subset_left _ _).trans hψs) =
      twoFormWeightedTestL2 (twoFormMassCoefficient (g := g) c χ b)
        (twoFormMassCoefficient_smooth c χ hχ hχs b).continuous hcχ.mul_right.smul_right
        ψ hψ.continuous := by
  apply Lp.ext
  filter_upwards [twoFormMassTestL2_coe (g := g) c (fun z => ψ z • b)
    (hψ.smul contDiff_const).contDiffOn hcψ.smul_right ((tsupport_smul_subset_left _ _).trans hψs),
    twoFormWeightedTestL2_coe (twoFormMassCoefficient (g := g) c χ b)
      (twoFormMassCoefficient_smooth c χ hχ hχs b).continuous hcχ.mul_right.smul_right ψ hψ.continuous]
    with z hleft hright
  rw [hleft, hright]
  exact twoFormMassTest_separated c χ ψ hon b z

include hon in
theorem twoFormEnergyTestL2_separated (i : Fin 4) :
    twoFormEnergyTestL2 (g := g) c S hS (fun z => ψ z • b) (hψ.smul contDiff_const).contDiffOn
      hcψ.smul_right ((tsupport_smul_subset_left _ _).trans hψs) i =
      (∑ j : Fin 4, twoFormWeightedTestL2 (twoFormFluxCoefficient (g := g) c χ b i j)
        (twoFormFluxCoefficient_smooth c χ hχ hχs b i j).continuous hcχ.mul_right.smul_right
        (fun z => partialDeriv ψ j z) (twoFormCutoffPartial_smooth ψ hψ j).continuous) +
      twoFormWeightedTestL2 (fun z => χ z • twoFormWeightedConnection (g := g) c S b i z)
        (twoFormCutoffWeightedConnection_smooth c S hS b i χ hχ hχs).continuous hcχ.smul_right
        ψ hψ.continuous := by
  let P := fun j : Fin 4 => twoFormWeightedTestL2 (twoFormFluxCoefficient (g := g) c χ b i j)
    (twoFormFluxCoefficient_smooth c χ hχ hχs b i j).continuous hcχ.mul_right.smul_right
    (fun z => partialDeriv ψ j z) (twoFormCutoffPartial_smooth ψ hψ j).continuous
  let Q := twoFormWeightedTestL2 (fun z => χ z • twoFormWeightedConnection (g := g) c S b i z)
    (twoFormCutoffWeightedConnection_smooth c S hS b i χ hχ hχs).continuous hcχ.smul_right
    ψ hψ.continuous
  have hP : ∀ᵐ z ∂(volume : Measure FourSpace), ∀ j : Fin 4,
      P j z = partialDeriv ψ j z • twoFormFluxCoefficient (g := g) c χ b i j z :=
    Filter.eventually_all.mpr (fun j => twoFormWeightedTestL2_coe _ _ _ _ _)
  have hQ := twoFormWeightedTestL2_coe (fun z => χ z • twoFormWeightedConnection (g := g) c S b i z)
    (twoFormCutoffWeightedConnection_smooth c S hS b i χ hχ hχs).continuous hcχ.smul_right
    ψ hψ.continuous
  apply Lp.ext
  filter_upwards [twoFormEnergyTestL2_coe (g := g) c S hS (fun z => ψ z • b)
    (hψ.smul contDiff_const).contDiffOn hcψ.smul_right ((tsupport_smul_subset_left _ _).trans hψs) i,
    Lp.coeFn_add (∑ j, P j) Q, Lp.coeFn_finsetSum Finset.univ P, hP, hQ]
      with z hleft hsum hpsum hp hq
  rw [hsum, Pi.add_apply, hpsum, Finset.sum_apply]
  simp_rw [hp]
  rw [hq, hleft]
  exact twoFormEnergyTest_separated c S χ ψ hψ hon b i z

end
end PositiveEinsteinFour.Geometry
end


