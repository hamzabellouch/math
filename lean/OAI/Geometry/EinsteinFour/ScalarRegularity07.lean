section

/-! The positive power nonlinearity has local H2 regularity. Only the
range on the support of the localization matters; the original global
cutoff representative may vanish elsewhere. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal ContDiff NNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

theorem scalar_localized_H2_positive_power (u : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) (χ : S)
    (hc : HasCompactSupport (χ : V → ℝ)) (a B q : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ᵐ x ∂(volume : Measure V), χ x ≠ 0 → u x ∈ Set.Icc a B) :
    ∃ v : L2, MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] fun x => χ x * (u x) ^ q := by
  obtain ⟨φ, hφ, hφc, hzero, ⟨D, hD⟩, hext⟩ := scalar_positive_power_extension a B q ha hB
  have hφ' : ContDiff ℝ ∞ (deriv φ) := (contDiff_infty_iff_deriv.mp hφ).2
  obtain ⟨E, hE⟩ := (hφ'.continuous_deriv (by simp)).bounded_above_of_compact_support hφc.deriv.deriv
  have h₂ (s : ℝ) : |deriv (deriv φ) s| ≤ E := by
    simpa only [Real.norm_eq_abs] using hE s
  have hLip : LipschitzWith D φ := lipschitzWith_of_nnnorm_deriv_le
    (hφ.differentiable (by simp)) (fun s => by
      exact_mod_cast (show ‖deriv φ s‖ ≤ (D : ℝ) by simpa only [Real.norm_eq_abs] using hD s))
  obtain ⟨v, hv, heq⟩ := scalar_localized_H2_composition u hu χ hc φ hφ hLip hzero hD h₂
  refine ⟨v, hv, ?_⟩
  filter_upwards [heq, hRange] with x hx hr
  rw [hx]
  by_cases hχ : χ x = 0
  · simp only [hχ, zero_mul]
  · rw [(hext _ (hr hχ)).1]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Fourth-power integrability transfers through compact chart reconstruction
and the closed coordinate-to-frame domination inequality. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter Function
open scoped Manifold ContDiff ENNReal BigOperators

noncomputable section

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

theorem scalarL2_memLp_four_of_domination (a : Lp ℝ 2 μ)
    (b : Fin 4 → Lp ℝ 2 μ) (C : ℝ)
    (h : |a| ≤ C • ∑ j, |b j|) (hb : ∀ j, MemLp (b j : X → ℝ) 4 μ) :
    MemLp (a : X → ℝ) 4 μ := by
  have hm : MemLp (fun x => C * ∑ j, |b j x|) 4 μ := by
    have hs : MemLp (fun x => ∑ j : Fin 4, |b j x|) 4 μ := by
      simpa only [Finset.sum_apply, Pi.abs_apply] using
        (memLp_finsetSum Finset.univ (fun j _ => (hb j).abs))
    exact hs.const_mul C
  apply hm.mono' (Lp.aestronglyMeasurable a)
  have hh := (Lp.coeFn_le _ _).mpr h
  have hall : ∀ᵐ x ∂μ, ∀ j : Fin 4, |b j| x = |b j x| :=
    eventually_all.mpr (fun j => Lp.coeFn_abs (b j))
  filter_upwards [hh, Lp.coeFn_abs a, Lp.coeFn_smul C (∑ j, |b j|),
    Lp.coeFn_finsetSum Finset.univ (fun j => |b j|), hall] with x hx ha hc hs hbs
  rw [ha, hc] at hx
  simp only [Pi.smul_apply, smul_eq_mul] at hx
  rw [hs] at hx
  simp only [Finset.sum_apply] at hx
  simpa only [Real.norm_eq_abs, hbs] using hx

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

theorem scalarChartReconstruction_memLp_four (g : SmoothMetric M) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (f : Lp ℝ 2 (volume : Measure FourSpace)) (hf : MemLp (f : FourSpace → ℝ) 4 volume) :
    MemLp (scalarChartReconstruction g c hK hKt f : M → ℝ) 4 (normalizedVolume g) := by
  obtain ⟨D, hD, hb⟩ := scalarChart_reverse_eLpNorm_bound g c hK hKt
  have hs : support (scalarChartReconstructionFun c K f) ⊆
      (chartAt FourSpace c).symm '' K := by
    intro x hx
    by_contra hn
    exact hx (indicator_of_notMem hn _)
  have he : (fun z => scalarChartReconstructionFun c K f ((chartAt FourSpace c).symm z)) =ᵐ[
      volume.restrict K] f := by
    filter_upwards [ae_restrict_mem hK.isClosed.measurableSet] with z hz
    exact scalarChartReconstructionFun_chart c hKt f hz
  have hfin : MemLp (scalarChartReconstructionFun c K f) 4 (normalizedVolume g) := by
    apply lt_of_le_of_lt (hb 4 _ hs)
    rw [eLpNorm_congr_ae he]
    exact ENNReal.mul_lt_top
      (lt_top_iff_ne_top.mpr (ENNReal.rpow_ne_top_of_nonneg (by positivity) hD))
      ((eLpNorm_mono_measure f Measure.restrict_le_self).trans_lt hf)
  exact (memLp_congr_ae (scalarChartReconstruction_coe g c hK hKt f).symm).mp hfin

theorem scalarBasePullback_memLp_four (g : SmoothMetric M) (o : FrameOrientation g)
    (f : Lp ℝ 2 (normalizedVolume g)) (hf : MemLp (f : M → ℝ) 4 (normalizedVolume g)) :
    MemLp (scalarBasePullback g o f : FrameBundle g → ℝ) 4 (canonicalFrameMeasure g o) := by
  have hc := hf.comp_measurePreserving (canonicalFrameMeasure_base g o)
  exact (memLp_congr_ae (Lp.coeFn_compMeasurePreserving f (canonicalFrameMeasure_base g o)).symm).mp hc

local instance l4Transfer_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1LocalizedFrame_memLp_four (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source)
    {B : ℝ} (hB : ∀ x, |ρ.val x| ≤ B) (u : scalarH1 d)
    (hD : ∀ j, MemLp (scalarH1LocalizedCoordinate g o d c ρ hs j u : M → ℝ)
      4 (normalizedVolume g)) (i : Fin 4) :
    MemLp (scalarH1LocalizedFrame g o d ρ hB i u : FrameBundle g → ℝ)
      4 (canonicalFrameMeasure g o) := by
  obtain ⟨C, hC, hE⟩ := scalar_chart_gram_bounded g c
    (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs)
  exact scalarL2_memLp_four_of_domination _ _ (4 * C)
    (scalarH1_local_frame_control g o d c ρ hs hB C hC hE u i)
    (fun j => scalarBasePullback_memLp_four g o _ (hD j))

end
end PositiveEinsteinFour.Geometry
end


