    Matrix.smul_apply, smul_eq_mul, Matrix.one_apply]

theorem HeatNormalOneExtension.amplitude_transport {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalOneExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r,
      (∀ k l, (∑ i : Fin 4, x i * E.B x i k l) = 0) ∧
      fourHeatEikonalDefect (E.base.a x) x = 0 ∧
      (∀ m ≤ 2, ∀ k l,
        fourHeatRadialTransport (E.base.a x) (E.base.b x)
          (fun y => E.amplitude (m + 1) y k l) x +
          (m + 1 : ℝ) * E.amplitude (m + 1) x k l =
        -fourHeatOneOperator (E.base.a x) (E.base.b x) (E.B x) (E.C x)
          (fun y q => E.amplitude m y q l) x k) := by
  obtain ⟨s, hs, hT⟩ := E.base.transport_neighborhood hRic he
  have hn := (E.radial_near hRic he).and (ball_mem_nhds (0 : FourSpace) hs)
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx
  obtain ⟨hrad, hxs⟩ := hball hx
  obtain ⟨hrow, hcol, hEik, hTU⟩ := hT x hxs
  refine ⟨hrad, hEik, ?_⟩
  intro m hm k l
  exact fourHeatOneCoefficient_transport m E.base.a E.base.b E.B E.C E.base.U x
    (E.base.U_regular.of_le (by norm_num)) (fun y => (E.base.U_pos y).ne')
    (fun i j => (E.base.a_regular i j).of_le (by norm_num))
    (fun i => (E.base.b_regular i).of_le (by norm_num))
    (fun i k l => (E.B_regular i k l).of_le (by norm_num))
    (fun k l => (E.C_regular k l).of_le (by norm_num))
    (fun k l => (E.amplitude_regular m (by omega) k l).of_le (by norm_num))
    hrow hcol hTU k l

end
end PositiveEinsteinFour.Geometry
end


section

/-! At the center the first radial connection jet is one half of the
actual curvature endomorphism, with the derivative order explicit. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem HeatNormalFrameData.frame_connection_zero (D : HeatNormalFrameData g o c e)
    (i : Fin 4) : heatNormalFrameConnection g c D.point i 0 = 0 := by
  ext k l
  have hR : ∀ᶠ x in 𝓝 (0 : FourSpace),
      (∑ j, x j • heatNormalFrameConnection g c D.point j x) = 0 := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    exact D.radial_connection x hx
  have ht : Tendsto (fun t : ℝ => t • coordinateVector i) (𝓝 0) (𝓝 (0 : FourSpace)) := by
    have hc : ContinuousAt (fun t : ℝ => t • coordinateVector i) 0 :=
      (continuous_id.smul continuous_const).continuousAt
    simpa only [zero_smul] using hc.tendsto
  have ha := heat_radial_axis_zero
    (fun x => heatNormalFrameConnection g c D.point i x k l) i
    (D.connection_regular i k l).continuousAt (by
      filter_upwards [ht.eventually hR] with t h
      have hh := congrArg (fun B : Mat4 => B k l) h
      simpa [coordinateVector, PiLp.single_apply, PiLp.smul_apply] using hh)
  simpa only [zero_smul, Matrix.zero_apply] using ha.self_of_nhds

theorem HeatNormalFrameData.frame_connection_first_jet
    (D : HeatNormalFrameData g o c e) (i j k l : Fin 4) :
    partialDeriv (fun x => heatNormalFrameConnection g c D.point i x k l) j 0 +
      partialDeriv (fun x => heatNormalFrameConnection g c D.point j x k l) i 0 = 0 := by
  apply heat_radial_first_jet_alternating
    (fun a x => heatNormalFrameConnection g c D.point a x k l) _ _ i j
  · intro a
    exact (D.connection_regular a k l).of_le (by norm_num)
  · filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    have h := congrArg (fun B : Mat4 => B k l) (D.radial_connection x hx)
    simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply] using h

theorem HeatNormalFrameData.frame_connection_curvature_center
    (D : HeatNormalFrameData g o c e) (i j : Fin 4) :
    matrixPartial (heatNormalFrameConnection g c D.point j) i 0 -
        matrixPartial (heatNormalFrameConnection g c D.point i) j 0 =
      (D.point 0).2⁻¹ *
        (∑ a, ∑ b, (jacobianMatrix (fun z => (D.point z).1) 0 a i *
          jacobianMatrix (fun z => (D.point z).1) 0 b j) •
            coordinateCurvatureMatrix g c a b (D.point 0).1) * (D.point 0).2 := by
  have hdet : IsUnit (D.point 0).2.det := by
    apply isUnit_iff_ne_zero.mpr
    intro hz
    have hh := congrArg Matrix.det (D.orthonormal 0 (Metric.mem_ball_self D.radius_pos))
    simp only [Matrix.det_mul, Matrix.det_transpose, hz, zero_mul, Matrix.det_one] at hh
    norm_num at hh
  have h := congrArg (fun A : Mat4 => (D.point 0).2⁻¹ * A)
    (D.connection_curvature_intertwining i j)
  simpa only [D.frame_connection_zero, zero_mul, add_zero, sub_zero,
    Matrix.nonsing_inv_mul_cancel_left _ _ hdet, Matrix.mul_assoc] using h

theorem HeatNormalFrameData.base_jacobian_center
    {f : OrthonormalFrame g c} (D : HeatNormalFrameData g o c ⟨c, f⟩) :
    jacobianMatrix (fun z => (D.point z).1) 0 = f.matrix := by
  have heq : (fun z => (D.point z).1) =ᶠ[𝓝 (0 : FourSpace)]
      (fun z => chartAt FourSpace c (frameExponential g o ⟨c, f⟩ z)) := by
    filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with z hz
    exact D.exponential z hz
  have h := (frameExponential_chart_strictDerivative_zero g o c ⟨c, f⟩
    (mem_chart_source FourSpace c)).hasFDerivAt.fderiv
  rw [chartForwardOperator_center, ContinuousLinearMap.id_comp] at h
  ext r i
  change (fderiv ℝ (fun z => (D.point z).1) 0 (coordinateVector i)) r = _
  rw [heq.fderiv_eq, h]
  change (f.map (coordinateVector i)) r = f.matrix r i
  simp [OrthonormalFrame.map, coordinateVector]

theorem HeatNormalFrameData.frame_connection_curvature_intrinsic
    {f : OrthonormalFrame g c} (D : HeatNormalFrameData g o c ⟨c, f⟩)
    (i j : Fin 4) :
    matrixPartial (heatNormalFrameConnection g c D.point j) i 0 -
        matrixPartial (heatNormalFrameConnection g c D.point i) j 0 =
      curvatureEndomorphism (frameCurvature g c f) i j := by
  rw [D.frame_connection_curvature_center, D.base_jacobian_center, D.initial]
  have hf : frameChartMatrix g c (⟨c, f⟩ : FrameBundle g) = f.matrix := by
    ext a b
    rw [frameChartMatrix_apply g c ⟨c, f⟩ (mem_chart_source FourSpace c)]
    change (chartForwardOperator c c (f.vector b)) a = f.matrix a b
    rw [chartForwardOperator_center]
    rfl
  simpa only [frameCoordinateState, hf, pulledCurvatureEndomorphism] using
    frame_curvatureEndomorphism f i j

theorem HeatNormalFrameData.frame_connection_half_curvature
    {f : OrthonormalFrame g c} (D : HeatNormalFrameData g o c ⟨c, f⟩)
    (i j k l : Fin 4) :
    partialDeriv (fun x => heatNormalFrameConnection g c D.point j x k l) i 0 =
      (1 / 2 : ℝ) * curvatureEndomorphism (frameCurvature g c f) i j k l := by
  have hs := D.frame_connection_first_jet i j k l
  have hc := congrArg (fun A : Mat4 => A k l) (D.frame_connection_curvature_intrinsic i j)
  change partialDeriv (fun x => heatNormalFrameConnection g c D.point j x k l) i 0 -
    partialDeriv (fun x => heatNormalFrameConnection g c D.point i x k l) j 0 = _ at hc
  linarith

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual unweighted H2 representatives in the original manifold chart. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric Filter
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_chart_H2_realization (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : 0 < r)
    (ht : ∀ y ∈ closedBall (0 : V) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (b : M → ℝ) (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : 𝓢(V, ℂ), HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (scalarRescaledPoint g c z₀ r) '' closedBall 0 (1 / 2)) :
    ∃ v : Lp ℂ 2 (volume : Measure V), MemSobolev 2 2 (v : T) ∧
      (v : V → ℂ) =ᵐ[volume] fun z => (χ z * b ((chartAt FourSpace c).symm z) : ℝ) := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let P : V ≃ₜ V := A.toHomeomorph.trans (Homeomorph.addRight z₀.val)
  have hP (y : V) : P y = scalarRescaledPoint g c z₀ r y :=
    scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
  let σ : V → ℝ := χ ∘ P
  have hσ : ContDiff ℝ ∞ σ := hχ.comp (by
    change ContDiff ℝ ∞ (fun y : V => A y + z₀.val)
    fun_prop)
  have hσc : HasCompactSupport σ := hc.comp_homeomorph P
  have hσs : tsupport σ ⊆ closedBall (0 : V) (1 / 2) := by
    intro y hy
    have hp : P y ∈ tsupport χ := tsupport_comp_subset_preimage χ P.continuous hy
    obtain ⟨z, hz, hzy⟩ := hs hp
    have hyz : y = z := P.injective (by simpa only [hP] using hzy.symm)
    exact hyz ▸ hz
  obtain ⟨v, hv2, hv⟩ := scalar_weighted_H2_unweight g c z₀ r ht b w heq hreg σ hσ hσc hσs
  have hva : (v : V → ℂ) =ᵐ[volume]
      fun y => (σ y * b ((chartAt FourSpace c).symm (A y + z₀.val)) : ℝ) := by
    simpa only [A, scalarRescalingLinearEquiv_apply] using hv
  obtain ⟨v', hv'2, hv'⟩ := scalar_H2_unscale A z₀.val
    (fun z => b ((chartAt FourSpace c).symm z)) σ v hv2 hva
  refine ⟨v', hv'2, hv'.trans ?_⟩
  filter_upwards [] with z
  have hinv : P (A.symm (z - z₀.val)) = z := by
    change A (A.symm (z - z₀.val)) + z₀.val = z
    rw [A.apply_symm_apply, sub_add_cancel]
  change (((χ (P (A.symm (z - z₀.val))) * _) : ℝ) : ℂ) = _
  rw [hinv]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Riesz representatives of scalar heat evaluation. The columns are
actual L2 functions, with a uniform bound over the compact manifold. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff NNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o)) (t : ℝ≥0) (ht : 0 < t)

local instance scalarColumn_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarHeatEvaluation (x : M) : Lp ℝ 2 (normalizedVolume g) →L[ℝ] ℝ :=
  (ContinuousMap.evalCLM ℝ x).comp (scalarHeatToContinuous g o d t ht)

def scalarHeatColumn (x : M) : Lp ℝ 2 (normalizedVolume g) :=
  (InnerProductSpace.toDual ℝ (Lp ℝ 2 (normalizedVolume g))).symm
    (scalarHeatEvaluation g o d t ht x)

theorem scalarHeatColumn_pairing (x : M) (f : Lp ℝ 2 (normalizedVolume g)) :
    inner ℝ (scalarHeatColumn g o d t ht x) f = scalarHeatToContinuous g o d t ht f x :=
  InnerProductSpace.toDual_symm_apply

theorem scalarHeatColumn_norm (x : M) :
    ‖scalarHeatColumn g o d t ht x‖ ≤ ‖scalarHeatToContinuous g o d t ht‖ := by
  rw [scalarHeatColumn, LinearIsometryEquiv.norm_map]
  apply ContinuousLinearMap.opNorm_le_bound (scalarHeatEvaluation g o d t ht x)
    (norm_nonneg (scalarHeatToContinuous g o d t ht))
  intro f
  exact scalarHeatToContinuous_bound g o d t ht f x

theorem scalarHeatContinuous_eigen (i : ScalarBaseEigenIndex g o d) :
    scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) =
      scalarBaseHeatWeight g o d t i •
        (⟨(scalarBaseEigenfunction g o d i).val,
          (scalarBaseEigenfunction g o d i).property.continuous⟩ : C(M, ℝ)) := by
  let := normalizedVolume_isOpenPosMeasure g
  apply ContinuousMap.toLp_injective (p := 2) (𝕜 := ℝ) (normalizedVolume g)
  rw [scalarHeatToContinuous_L2, map_smul, scalarBaseHeat_eigenvector]
  congr 1
  exact scalarBaseEigenfunction_L2 g o d i

theorem scalarHeatColumn_eigen (x : M) (i : ScalarBaseEigenIndex g o d) :
    inner ℝ (scalarHeatColumn g o d t ht x) (scalarBaseEigenvector g o d i) =
      scalarBaseHeatWeight g o d t i * (scalarBaseEigenfunction g o d i).val x := by
  rw [scalarHeatColumn_pairing, scalarHeatContinuous_eigen]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Positive continuous weak Euler solutions have actual smooth representatives.
Local regularity of all orders, Fourier embedding and chart unweighting
give the representatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance positiveEulerSmooth_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_positive_Euler_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (v : M → ℝ) (hv : Continuous v) (hpos : ∀ x, 0 < v x)
    (hurep : (scalarH1BaseValue g o d u : M → ℝ) =ᵐ[normalizedVolume g] v)
    (α β q : ℝ)
    (hf : (f : M → ℝ) =ᵐ[normalizedVolume g] fun x => α * v x + β * (v x) ^ q)
    (hw : ∀ a : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i a)) =
        -(inner ℝ (scalarBasePullback g o f) (scalarH1Value d a))) :
    ContMDiff I4 𝓘(ℝ, ℝ) ∞ v := by
  let b := scalarH1BaseValue g o d u
  have hlocal (x : M) : ∃ U : Set M, ∃ F : M → ℝ,
      IsOpen U ∧ x ∈ U ∧ ContMDiffOn I4 𝓘(ℝ, ℝ) ∞ F U ∧
        (b : M → ℝ) =ᵐ[(normalizedVolume g).restrict U] F := by
    let z₀ : ChartTarget x := ⟨chartAt FourSpace x x,
      (chartAt FourSpace x).map_source (mem_chart_source FourSpace x)⟩
    obtain ⟨r, hr, ht, w, he, hreg⟩ :=
      scalar_positive_Euler_local_all_orders g o d f u v hv hpos hurep α β q hf hw x z₀
    obtain ⟨G, hG, hwG⟩ := scalar_half_smooth_real_representative w hreg
    have hbr := scalar_rescaled_ae_predicate g x z₀ r hr.ne'
      (fun y => b y = v y) hurep
    have he' : (fun y => chartVolumeDensity g x (scalarRescaledPoint g x z₀ r y) *
        b ((chartAt FourSpace x).symm (scalarRescaledPoint g x z₀ r y))) =ᵐ[
          volume.restrict (ball (0 : FourSpace) (1 / 8))] G := by
      have he₁ := ae_restrict_of_ae_restrict_of_subset
        (ball_subset_ball (by norm_num : (1 / 8 : ℝ) ≤ 1)) he
      filter_upwards [he₁, hwG, ae_restrict_of_ae hbr,
        ae_restrict_mem isOpen_ball.measurableSet] with y hvw hwg hrep hy
      rw [hrep (ht y (ball_subset_closedBall (ball_subset_ball (by norm_num) hy)))]
      exact hvw.trans hwg
    obtain ⟨U, hU, hxU, _, H, hH, heH⟩ := scalar_chart_smooth_unweight g x z₀ r hr
      (by norm_num : (0 : ℝ) < 1 / 8) (by norm_num) b ht G hG he'
    let W := (chartAt FourSpace x).source ∩ (chartAt FourSpace x) ⁻¹' U
    refine ⟨W, fun y => H (chartAt FourSpace x y),
      (chartAt FourSpace x).isOpen_inter_preimage hU, ⟨mem_chart_source FourSpace x, hxU⟩,
      ?_, scalar_chart_representative_ae g x U hU b H heH⟩
    intro y hy
    have hHC : ContDiffAt ℝ ∞ H (chartAt FourSpace x y) :=
      (hH _ hy.2).contDiffAt (hU.mem_nhds hy.2)
    exact (hHC.contMDiffAt.comp y
      (contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x) hy.1)).contMDiffWithinAt
  obtain ⟨F, hFb⟩ := scalar_smooth_representative_of_local g b hlocal
  let := normalizedVolume_isOpenPosMeasure g
  have hFv : F.val = v := Measure.eq_of_ae_eq (hFb.trans hurep) F.property.continuous hv
  have hFs : ContMDiff I4 𝓘(ℝ, ℝ) ∞ F.val := F.property
  rwa [hFv] at hFs

end
end PositiveEinsteinFour.Geometry
end


section

/-! The closed nonnegative Hodge form on the actual H1 completion. Its
zero-energy space is the finite weak harmonic kernel. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormHodgeForm (u v : TwoFormH1 o) : ℝ :=
  inner ℝ u v - inner ℝ (twoFormWeitzenbockPotential (twoFormH1ToL2 u)) (twoFormH1ToL2 v)

theorem twoFormWeitzenbockPotential_symmetric (u v : TwoFormL2 o) :
    inner ℝ (twoFormWeitzenbockPotential u) v =
      inner ℝ (twoFormWeitzenbockPotential v) u := by
  simp only [twoFormWeitzenbockPotential, sub_apply,
    smul_apply, ContinuousLinearMap.id_apply, inner_sub_left,
    real_inner_smul_left]
  rw [twoFormL2Curvature_selfAdjoint, real_inner_comm u (twoFormL2Curvature v),
    real_inner_comm u v]

theorem twoFormHodgeForm_comm (u v : TwoFormH1 o) :
    twoFormHodgeForm u v = twoFormHodgeForm v u := by
  unfold twoFormHodgeForm
  rw [twoFormWeitzenbockPotential_symmetric, real_inner_comm u v]

theorem twoFormHodgeForm_add_left (u v w : TwoFormH1 o) :
    twoFormHodgeForm (u + v) w = twoFormHodgeForm u w + twoFormHodgeForm v w := by
  simp only [twoFormHodgeForm, map_add, inner_add_left]
  ring

theorem twoFormHodgeForm_smul_left (r : ℝ) (u v : TwoFormH1 o) :
    twoFormHodgeForm (r • u) v = r * twoFormHodgeForm u v := by
  simp only [twoFormHodgeForm, map_smul, real_inner_smul_left]
  ring

theorem twoFormHodgeForm_add_right (u v w : TwoFormH1 o) :
    twoFormHodgeForm u (v + w) = twoFormHodgeForm u v + twoFormHodgeForm u w := by
  rw [twoFormHodgeForm_comm, twoFormHodgeForm_add_left,
    twoFormHodgeForm_comm v u, twoFormHodgeForm_comm w u]

theorem twoFormHodgeForm_smul_right (r : ℝ) (u v : TwoFormH1 o) :
    twoFormHodgeForm u (r • v) = r * twoFormHodgeForm u v := by
  rw [twoFormHodgeForm_comm, twoFormHodgeForm_smul_left, twoFormHodgeForm_comm v u]

theorem twoFormHodgeForm_smooth (hRic : RicciThree g) (u : SmoothH1TwoForm o) :
    twoFormHodgeForm (smoothTwoFormToH1 u) (smoothTwoFormToH1 u) =
      smoothTwoFormDeRhamEnergy (u : smoothTwoForms o) := by
  unfold twoFormHodgeForm
  rw [twoFormH1ToL2_smooth, smoothTwoFormToH1.inner_map_map]
  simp only [twoFormWeitzenbockPotential, sub_apply,
    smul_apply, ContinuousLinearMap.id_apply, inner_sub_left,
    real_inner_smul_left]
  rw [twoFormL2Curvature_smooth, smoothTwoFormToL2.inner_map_map,
    smoothTwoFormToL2.inner_map_map]
  have hw := smoothTwoForm_Weitzenbock hRic (u : smoothTwoForms o)
  change (smoothTwoFormL2Inner (u : smoothTwoForms o) (u : smoothTwoForms o) +
      smoothTwoFormCovariantEnergy (u : smoothTwoForms o) (u : smoothTwoForms o)) -
    (2 * smoothTwoFormL2Inner (smoothTwoFormCurvature (u : smoothTwoForms o)) (u : smoothTwoForms o) -
      5 * smoothTwoFormL2Inner (u : smoothTwoForms o) (u : smoothTwoForms o)) =
    smoothTwoFormDeRhamEnergy (u : smoothTwoForms o)
  linarith only [hw]

theorem twoFormHodgeForm_nonneg (hRic : RicciThree g) (u : TwoFormH1 o) :
    0 ≤ twoFormHodgeForm u u := by
  have hc : Continuous (fun v : TwoFormH1 o => twoFormHodgeForm v v) :=
    (continuous_id.inner continuous_id).sub
      ((twoFormWeitzenbockPotential.continuous.comp twoFormH1ToL2.continuous).inner
        twoFormH1ToL2.continuous)
  refine UniformSpace.Completion.induction_on u (isClosed_le continuous_const hc) ?_
  intro v
  change 0 ≤ twoFormHodgeForm (smoothTwoFormToH1 v) (smoothTwoFormToH1 v)
  rw [twoFormHodgeForm_smooth hRic]
  exact smoothTwoFormDeRhamEnergy_nonneg _

private theorem linear_term_zero {a b : ℝ}
    (hb : 0 ≤ b) (h : ∀ t : ℝ, 0 ≤ 2 * t * a + t ^ 2 * b) : a = 0 := by
  by_cases hzero : b = 0
  · have ht := h (-a)
    rw [hzero] at ht
    nlinarith [sq_nonneg a]
  · have hp : 0 < b := lt_of_le_of_ne hb (Ne.symm hzero)
    have he : 2 * (-a / b) * a + (-a / b) ^ 2 * b = -(a ^ 2 / b) := by
      field_simp
      ring
    have ht := h (-a / b)
    rw [he] at ht
    have hs : a ^ 2 ≤ 0 := by
      simpa using (div_le_iff₀ hp).mp (show a ^ 2 / b ≤ 0 by linarith)
    nlinarith [sq_nonneg a]

theorem twoFormHodgeForm_zero_left (hRic : RicciThree g) (u : TwoFormH1 o)
    (hu : twoFormHodgeForm u u = 0) (v : TwoFormH1 o) : twoFormHodgeForm u v = 0 := by
  apply linear_term_zero (twoFormHodgeForm_nonneg hRic v)
  intro t
  have h := twoFormHodgeForm_nonneg hRic (u + t • v)
  simp only [twoFormHodgeForm_add_left, twoFormHodgeForm_add_right,
    twoFormHodgeForm_smul_left, twoFormHodgeForm_smul_right, hu,
    twoFormHodgeForm_comm v u] at h
  nlinarith only [h]

theorem mem_twoFormWeitzenbockKernel_iff_energy_zero (hRic : RicciThree g) (u : TwoFormH1 o) :
    u ∈ twoFormWeitzenbockKernel ↔ twoFormHodgeForm u u = 0 := by
  rw [twoFormWeitzenbockKernel, twoFormWeakPotentialKernel_weak]
  constructor
  · intro h
    exact sub_eq_zero.mpr (h u)
  · intro hu v
    exact sub_eq_zero.mp (twoFormHodgeForm_zero_left hRic u hu v)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Compact support and the vanishing near the center turn the exact
cutoff commutator into a uniform small-time error. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter Metric
open scoped BigOperators ContDiff _root_.Topology

noncomputable section

theorem fourHeatScaledCommutator_continuous (a : FourSpace → Mat4)
    (b : FourSpace → Fin 4 → ℝ) (B : FourSpace → Fin 4 → HeatMat6)
    (χ : FourSpace → ℝ) (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (ha : ∀ i j, Continuous (fun x => a x i j))
    (hb : ∀ i, Continuous (fun x => b x i))
    (hB : ∀ i k q, Continuous (fun x => B x i k q))
    (hχ : ContDiff ℝ 2 χ) (hu : ∀ m q, ContDiff ℝ 2 (fun x => u m x q)) (k : Fin 6) :
    Continuous (fun z : ℝ × FourSpace => fourHeatScaledCommutator a b B χ u z.1 z.2 k) := by
  have hL : Continuous (fun x => fourHeatLocalOperator (a x) (b x) 0 χ x) :=
    (fourHeatLocalOperator_contDiff 0 a b (fun _ => 0) χ
      (fun i j => contDiff_zero.mpr (ha i j)) (fun i => contDiff_zero.mpr (hb i))
      contDiff_const hχ).continuous
  have hP (q : Fin 6) : Continuous (fun z : ℝ × FourSpace =>
      fourHeatBundlePolynomial u z.1 z.2 q) :=
    fourHeatPolynomial_joint_continuous _ (fun m => (hu m q).continuous)
  have hD (q : Fin 6) (j : Fin 4) : Continuous (fun z : ℝ × FourSpace =>
      partialDeriv (fun y => fourHeatBundlePolynomial u z.1 y q) j z.2) :=
    fourHeatPolynomial_partial_joint_continuous _
      (fun m => (hu m q).of_le (by norm_num)) j
  have hχi (i : Fin 4) : Continuous (fun z : ℝ × FourSpace => partialDeriv χ i z.2) :=
    ((fourHeat_partial_contDiff 1 χ hχ i).continuous).comp continuous_snd
  have hA (i j : Fin 4) : Continuous (fun z : ℝ × FourSpace => a z.2 i j) :=
    (ha i j).comp continuous_snd
  have hBB (i : Fin 4) (q : Fin 6) : Continuous (fun z : ℝ × FourSpace => B z.2 i k q) :=
    (hB i k q).comp continuous_snd
  have hx (j : Fin 4) : Continuous (fun z : ℝ × FourSpace => z.2 j) :=
    (EuclideanSpace.proj j).continuous.comp continuous_snd
  exact ((continuous_fst.mul (hL.comp continuous_snd)).mul (hP k)).sub
    (continuous_const.mul (continuous_finsetSum _ (fun i _ => continuous_finsetSum _
      (fun j _ => ((hA i j).mul (hχi i)).mul
        ((continuous_fst.mul (hD k j)).sub (((hx j).div_const 2).mul (hP k))))))) |>.add
    (continuous_fst.mul (continuous_finsetSum _ (fun i _ => continuous_finsetSum _
      (fun q _ => ((hBB i q).mul (hχi i)).mul (hP q)))))

theorem fourHeatScaledCommutator_zero_of_locally_const (a : FourSpace → Mat4)
    (b : FourSpace → Fin 4 → ℝ) (B : FourSpace → Fin 4 → HeatMat6)
    (χ : FourSpace → ℝ) (u : Fin 4 → FourSpace → Fin 6 → ℝ)
    (t : ℝ) (x : FourSpace) (c : ℝ) (hc : χ =ᶠ[𝓝 x] fun _ => c) (k : Fin 6) :
    fourHeatScaledCommutator a b B χ u t x k = 0 := by
  have hp (i : Fin 4) : partialDeriv χ i =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
    filter_upwards [hc.eventuallyEq_nhds] with y hy
    rw [fourHeat_partial_germ hy]
    simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]
  have hpp (i j : Fin 4) : partialDeriv (partialDeriv χ i) j x = 0 := by
    rw [fourHeat_partial_germ (hp i)]
    simp only [partialDeriv, fderiv_const_apply, _root_.zero_apply]
  simp only [fourHeatScaledCommutator, fourHeatLocalOperator, hpp,
    fun i => (hp i).self_of_nhds, mul_zero, zero_mul, Finset.sum_const_zero,
    neg_zero, add_zero, sub_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Expansion of the connection Laplacian into the exact coefficient
operator used in the bundle heat construction. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatCovariantOperator (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → HeatMat6) (V : HeatMat6)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace) (k : Fin 6) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a i j *
      fourHeatCovariantDerivative A (fourHeatCovariantDerivative A u i) j x k) +
    (∑ i : Fin 4, b i * fourHeatCovariantDerivative A u i x k) +
    ∑ l : Fin 6, V k l * u x l

theorem fourHeatCovariantOperator_eq (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → HeatMat6) (V : HeatMat6)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (hs : ∀ i j, a i j = a j i)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (k : Fin 6) :
    fourHeatCovariantOperator a b A V u x k =
      fourHeatBundleOperator a b (fourHeatConnectionFirst a (fun i => A i x))
        (fourHeatConnectionZero a b A V x) u x k := by
  let Q := ∑ i : Fin 4, ∑ j : Fin 4, a i j *
    (∑ l : Fin 6, A j x k l * partialDeriv (fun y => u y l) i x)
  let Z := ∑ i : Fin 4, ∑ j : Fin 4, a i j *
    (∑ l : Fin 6, (partialDeriv (fun y => A i y k l) j x +
      (A j x * A i x) k l) * u x l)
  let Y := ∑ i : Fin 4, b i * (∑ l : Fin 6, A i x k l * u x l)
  have hswap : (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      (∑ l : Fin 6, A i x k l * partialDeriv (fun y => u y l) j x)) = Q := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hs]
  have hsecond : (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      fourHeatCovariantDerivative A (fourHeatCovariantDerivative A u i) j x k) =
      (∑ i : Fin 4, ∑ j : Fin 4, a i j *
        partialDeriv (partialDeriv (fun y => u y k) i) j x) + 2 * Q + Z := by
    simp_rw [fourHeatCovariantDerivative_second A u x hA hu]
    simp only [mul_add, Finset.sum_add_distrib]
    rw [hswap]
    dsimp only [Q, Z]
    ring
  have hfirst : fourHeatBundleFirst (fourHeatConnectionFirst a (fun i => A i x)) u x k = -2 * Q := by
    change (∑ i : Fin 4, ∑ l : Fin 6,
      (-2 * ∑ j : Fin 4, a i j * A j x k l) * partialDeriv (fun y => u y l) i x) = _
    dsimp only [Q]
    simp only [Finset.mul_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hY : (∑ l : Fin 6, (∑ i : Fin 4, b i * A i x k l) * u x l) = Y := by
    dsimp only [Y]
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hZ : (∑ l : Fin 6, (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      (partialDeriv (fun y => A i y k l) j x + (A j x * A i x) k l)) * u x l) = Z := by
    dsimp only [Z]
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hzero : fourHeatBundleZero (fourHeatConnectionZero a b A V x) u x k =
      (∑ l : Fin 6, V k l * u x l) + Y - Z := by
    change (∑ l : Fin 6, (V k l + (∑ i : Fin 4, b i * A i x k l) -
      (∑ i : Fin 4, ∑ j : Fin 4, a i j *
        (partialDeriv (fun y => A i y k l) j x + (A j x * A i x) k l))) * u x l) = _
    simp only [sub_mul, add_mul, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    rw [hY, hZ]
  unfold fourHeatCovariantOperator fourHeatBundleOperator
  rw [hsecond, hfirst, hzero]
  simp only [fourHeatCovariantDerivative, mul_add, Finset.sum_add_distrib]
  dsimp only [Y]
  unfold fourHeatLocalOperator
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The metric product rule for the six-component skew connection. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeat_skew_pairing (A : HeatMat6) (hA : Aᵀ = -A)
    (p q : Fin 6 → ℝ) :
    (∑ k, (∑ l, A k l * p l) * q k) =
      -(∑ k, p k * ∑ l, A k l * q l) := by
  simp only [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  have hs (k l : Fin 6) : A l k = -A k l := congrFun (congrFun hA k) l
  simp only [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro k _
  apply Finset.sum_congr rfl
  intro l _
  rw [hs k l]
  ring

theorem fourHeatCovariantDerivative_pairing
    (A : Fin 4 → FourSpace → HeatMat6) (u v : FourSpace → Fin 6 → ℝ)
    (x : FourSpace) (i : Fin 4) (hA : (A i x)ᵀ = -A i x)
    (hu : ∀ k, DifferentiableAt ℝ (fun y => u y k) x)
    (hv : ∀ k, DifferentiableAt ℝ (fun y => v y k) x) :
    partialDeriv (fun y => ∑ k, u y k * v y k) i x =
      (∑ k, fourHeatCovariantDerivative A u i x k * v x k) +
        ∑ k, u x k * fourHeatCovariantDerivative A v i x k := by
  rw [fourHeat_partial_sum_six (fun k y => u y k * v y k) x
    (fun k => (hu k).mul (hv k)) i]
  change (∑ k, partialDeriv (fun y => u y k * v y k) i x) =
    (∑ k, (partialDeriv (fun y => u y k) i x + ∑ l, A i x k l * u x l) * v x k) +
      ∑ k, u x k * (partialDeriv (fun y => v y k) i x + ∑ l, A i x k l * v x l)
  have hd (k : Fin 6) := scalar_partial_product (fun y => u y k) (fun y => v y k)
    x (hu k) (hv k) i
  simp_rw [hd]
  simp only [Finset.sum_add_distrib, add_mul, mul_add]
  have hs := fourHeat_skew_pairing (A i x) hA (u x) (v x)
  linarith only [hs]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar product rule and the weighted divergence coefficient of
the six-component connection Laplacian. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatCovariantDerivative_scalar
    (A : Fin 4 → FourSpace → HeatMat6) (u : FourSpace → Fin 6 → ℝ)
    (f : FourSpace → ℝ) (x : FourSpace) (i : Fin 4) (k : Fin 6)
    (hf : DifferentiableAt ℝ f x) (hu : DifferentiableAt ℝ (fun y => u y k) x) :
    fourHeatCovariantDerivative A (fun y l => f y * u y l) i x k =
      partialDeriv f i x * u x k + f x * fourHeatCovariantDerivative A u i x k := by
  change partialDeriv (fun y => f y * u y k) i x +
    (∑ l, A i x k l * (f x * u x l)) = _
  rw [scalar_partial_product f (fun y => u y k) x hf hu i]
  have he : (∑ l, A i x k l * (f x * u x l)) =
      f x * ∑ l, A i x k l * u x l := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro l _
    ring
  rw [he]
  change _ = partialDeriv f i x * u x k +
    f x * (partialDeriv (fun y => u y k) i x + ∑ l, A i x k l * u x l)
  ring

theorem fourHeatDensityDrift_weighted (a : FourSpace → Mat4) (ρ : FourSpace → ℝ)
    (x : FourSpace) (j : Fin 4) (hρ : DifferentiableAt ℝ ρ x) (hρ0 : ρ x ≠ 0)
    (ha : ∀ i, DifferentiableAt ℝ (fun y => a y i j) x) :
    ρ x * fourHeatDensityDrift a ρ x j =
      -(∑ i, partialDeriv (fun y => ρ y * a y i j) i x) := by
  have hp (i : Fin 4) := scalar_partial_product ρ (fun y => a y i j) x hρ (ha i) i
  change ρ x * -((∑ i, partialDeriv (fun y => a y i j) i x) +
    (ρ x)⁻¹ * ∑ i, a x i j * partialDeriv ρ i x) = _
  simp_rw [hp]
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
  have hs : (∑ i, partialDeriv ρ i x * a x i j) =
      ∑ i, a x i j * partialDeriv ρ i x := by
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hs]
  field_simp
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Expansion of the connection Laplacian into the exact coefficient
operator used in the bundle heat construction. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatOneCovariantOperator (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → Mat4) (V : Mat4)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace) (k : Fin 4) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a i j *
      fourHeatOneCovariantDerivative A (fourHeatOneCovariantDerivative A u i) j x k) +
    (∑ i : Fin 4, b i * fourHeatOneCovariantDerivative A u i x k) +
    ∑ l : Fin 4, V k l * u x l

theorem fourHeatOneCovariantOperator_eq (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → Mat4) (V : Mat4)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (hs : ∀ i j, a i j = a j i)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun y => A i y k l) x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (k : Fin 4) :
    fourHeatOneCovariantOperator a b A V u x k =
      fourHeatOneOperator a b (fourHeatOneConnectionFirst a (fun i => A i x))
        (fourHeatOneConnectionZero a b A V x) u x k := by
  let Q := ∑ i : Fin 4, ∑ j : Fin 4, a i j *
    (∑ l : Fin 4, A j x k l * partialDeriv (fun y => u y l) i x)
  let Z := ∑ i : Fin 4, ∑ j : Fin 4, a i j *
    (∑ l : Fin 4, (partialDeriv (fun y => A i y k l) j x +
      (A j x * A i x) k l) * u x l)
  let Y := ∑ i : Fin 4, b i * (∑ l : Fin 4, A i x k l * u x l)
  have hswap : (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      (∑ l : Fin 4, A i x k l * partialDeriv (fun y => u y l) j x)) = Q := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [hs]
  have hsecond : (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      fourHeatOneCovariantDerivative A (fourHeatOneCovariantDerivative A u i) j x k) =
      (∑ i : Fin 4, ∑ j : Fin 4, a i j *
        partialDeriv (partialDeriv (fun y => u y k) i) j x) + 2 * Q + Z := by
    simp_rw [fourHeatOneCovariantDerivative_second A u x hA hu]
    simp only [mul_add, Finset.sum_add_distrib]
    rw [hswap]
    dsimp only [Q, Z]
    ring
  have hfirst : fourHeatOneFirst (fourHeatOneConnectionFirst a (fun i => A i x)) u x k = -2 * Q := by
    change (∑ i : Fin 4, ∑ l : Fin 4,
      (-2 * ∑ j : Fin 4, a i j * A j x k l) * partialDeriv (fun y => u y l) i x) = _
    dsimp only [Q]
    simp only [Finset.mul_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hY : (∑ l : Fin 4, (∑ i : Fin 4, b i * A i x k l) * u x l) = Y := by
    dsimp only [Y]
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hZ : (∑ l : Fin 4, (∑ i : Fin 4, ∑ j : Fin 4, a i j *
      (partialDeriv (fun y => A i y k l) j x + (A j x * A i x) k l)) * u x l) = Z := by
    dsimp only [Z]
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro l _
    ring
  have hzero : fourHeatOneZero (fourHeatOneConnectionZero a b A V x) u x k =
      (∑ l : Fin 4, V k l * u x l) + Y - Z := by
    change (∑ l : Fin 4, (V k l + (∑ i : Fin 4, b i * A i x k l) -
      (∑ i : Fin 4, ∑ j : Fin 4, a i j *
        (partialDeriv (fun y => A i y k l) j x + (A j x * A i x) k l))) * u x l) = _
    simp only [sub_mul, add_mul, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    rw [hY, hZ]
  unfold fourHeatOneCovariantOperator fourHeatOneOperator
  rw [hsecond, hfirst, hzero]
  simp only [fourHeatOneCovariantDerivative, mul_add, Finset.sum_add_distrib]
  dsimp only [Y]
  unfold fourHeatLocalOperator
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The second order remainder needed for the signed Gaussian coefficient. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter Asymptotics Set
open scoped _root_.Topology

noncomputable section

theorem fourHeat_quadratic_hasFDerivAt
    (B : FourSpace →L[ℝ] FourSpace →L[ℝ] ℝ)
    (hB : ∀ x y, B x y = B y x) (x : FourSpace) :
    HasFDerivAt (fun y => (1 / 2 : ℝ) * B y y) (B x) x := by
  have h := (B.hasFDerivAt_of_bilinear (hasFDerivAt_id x)
    (hasFDerivAt_id x)).const_mul (1 / 2 : ℝ)
  apply h.congr_fderiv
  ext y
  change (1 / 2 : ℝ) * (B x y + B y x) = B x y
  rw [hB y x]
  ring

theorem fourHeat_second_order_remainder (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 2 f) :
    (fun x => f x - f 0 - fderiv ℝ f 0 x -
      (1 / 2 : ℝ) * fderiv ℝ (fderiv ℝ f) 0 x x)
      =o[𝓝 0] (fun x : FourSpace => ‖x‖ ^ 2) := by
  let B := fderiv ℝ (fderiv ℝ f) 0
  have hB : ∀ x y, B x y = B y x :=
    hf.contDiffAt.isSymmSndFDerivAt (by norm_num)
  let R := fun x => f x - f 0 - fderiv ℝ f 0 x - (1 / 2 : ℝ) * B x x
  let D := fun x => fderiv ℝ f x - fderiv ℝ f 0 - B x
  have hD : D =o[𝓝 0] (fun x : FourSpace => ‖x‖) := by
    have hh := ((hf.fderiv_right (m := 1) (by norm_num)).differentiable
      one_ne_zero 0).hasFDerivAt.isLittleO.norm_right
    simpa only [sub_zero] using hh
  have hR (x : FourSpace) : HasFDerivAt R (D x) x := by
    exact (((hf.differentiable two_ne_zero x).hasFDerivAt.sub_const (f 0)).sub
      (fderiv ℝ f 0).hasFDerivAt).sub (fourHeat_quadratic_hasFDerivAt B hB x)
  have hh := convex_univ.isLittleO_pow_succ (f := R) (f' := D)
    (x₀ := (0 : FourSpace)) (n := 1) (mem_univ 0)
    (fun x _ => (hR x).hasFDerivWithinAt) (by simpa using hD)
  simpa [R, B] using hh


theorem fourHeat_second_order_remainder_at (f : FourSpace → ℝ)
    (hf : ContDiffAt ℝ 2 f 0) :
    (fun x => f x - f 0 - fderiv ℝ f 0 x -
      (1 / 2 : ℝ) * fderiv ℝ (fderiv ℝ f) 0 x x)
      =o[𝓝 0] (fun x : FourSpace => ‖x‖ ^ 2) := by
  obtain ⟨F, hF, _, he⟩ := heatScalar_extension 2 f hf
  have hd : fderiv ℝ F =ᶠ[𝓝 0] fderiv ℝ f :=
    he.eventuallyEq_nhds.mono (fun _ h => h.fderiv_eq)
  apply (fourHeat_second_order_remainder F hF).congr' _ Filter.EventuallyEq.rfl
  filter_upwards [he] with x hx
  rw [hx, he.self_of_nhds, he.fderiv_eq, hd.fderiv_eq]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact realization and norm of compact continuous alternating chart
tensors in the actual two-form L2 completion. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Set MeasureTheory
open scoped BigOperators ContDiff Manifold _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

local instance heatChartTensorL2Compact : CompactSpace (FrameBundle g) := actual_compactFrameBundle g

theorem heatChartTensor_L2_realization (c : M)
    (F : FourSpace → CovariantCoordinates 2) (hF : Continuous F)
    (ha : ∀ z i j, F z ![j,i] = -F z ![i,j])
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (hFs : tsupport F ⊆ K) :
    twoFormTensorL2 (twoFormFromContinuousTensor (o := o)
      (heatChartTensor g c F hF.continuousOn
        (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt))) =
    ContinuousMap.toLp 2 (canonicalFrameMeasure g o) ℝ
      (heatChartTensor g c F hF.continuousOn
        (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt)) := by
  let A := (twoFormTensorL2 (o := o)).comp (twoFormFromContinuousTensor (o := o))
  let B := ContinuousMap.toLp 2 (canonicalFrameMeasure g o) ℝ (E := TwoTensorEuclidean)
  have hclosed : IsClosed {T | A T = B T} := isClosed_eq A.continuous B.continuous
  apply hclosed.closure_subset
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨u, hu⟩ := heatChartTensor_smooth_approx (o := o) c F hF ha hK hKt hFs ε hε
  refine ⟨smoothTwoFormEuclideanValue u, ?_, ?_⟩
  · change twoFormTensorL2 (twoFormFromContinuousTensor (smoothTwoFormEuclideanValue u)) = _
    rw [twoFormFromContinuousTensor_smooth (show SmoothL2TwoForm o from u),
      twoFormTensorL2_smooth]
    rfl
  · simpa only [dist_eq_norm, norm_sub_rev] using hu

theorem heatChartTensor_L2_norm (c : M)
    (F : FourSpace → CovariantCoordinates 2) (hF : Continuous F)
    (ha : ∀ z i j, F z ![j,i] = -F z ![i,j])
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (hFs : tsupport F ⊆ K) :
    2 * ‖twoFormFromContinuousTensor (o := o)
      (heatChartTensor g c F hF.continuousOn
        (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt))‖ ^ 2 =
    ∫ f, ‖heatChartTensor g c F hF.continuousOn
      (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt) f‖ ^ 2
        ∂canonicalFrameMeasure g o := by
  rw [← twoFormTensorL2_norm_sq, heatChartTensor_L2_realization c F hF ha hK hKt hFs,
    ← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (canonicalFrameMeasure g o)
    (heatChartTensor g c F hF.continuousOn
      (hK.of_isClosed_subset (isClosed_tsupport _) hFs) (hFs.trans hKt))] with f hf
  rw [hf, real_inner_self_eq_norm_sq]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first four transport amplitudes form a jointly finite-smooth
family. The recursive integral keeps the center and frame fixed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators Matrix.Norms.Elementwise

noncomputable section

def heatFamilyWeightedAverage (m : ℕ) (U f : HeatRadialFrameSpace → ℝ)
    (z : HeatRadialFrameSpace) : ℝ :=
  U z * heatFamilyRadialAverage m (fun y => f y / U y) z

theorem heatFamilyWeightedAverage_contDiff (n m : ℕ) (U f : HeatRadialFrameSpace → ℝ)
    (hU : ContDiff ℝ n U) (hf : ContDiff ℝ n f) (hU0 : ∀ z, U z ≠ 0) :
    ContDiff ℝ n (heatFamilyWeightedAverage m U f) :=
  hU.mul (heatFamilyRadialAverage_preserves_contDiff n m _ (hf.div hU hU0))

def heatFamilyCoefficientSequence (a : HeatRadialFrameSpace → Mat4)
    (b : HeatRadialFrameSpace → Fin 4 → ℝ) (B : HeatRadialFrameSpace → Fin 4 → HeatMat6)
    (C : HeatRadialFrameSpace → HeatMat6) (U : HeatRadialFrameSpace → ℝ) :
    ℕ → HeatRadialFrameSpace → HeatMat6
  | 0 => fun z k l => U z * (if k = l then 1 else 0)
  | m + 1 => fun z k l => heatFamilyWeightedAverage m U
      (fun y => -heatFamilyBundleOperator a b B C
        (fun w q => heatFamilyCoefficientSequence a b B C U m w q l) y k) z

theorem heatFamilyCoefficientSequence_contDiff (m : ℕ) : ∀ (n : ℕ)
    (a : HeatRadialFrameSpace → Mat4) (b : HeatRadialFrameSpace → Fin 4 → ℝ)
    (B : HeatRadialFrameSpace → Fin 4 → HeatMat6) (C : HeatRadialFrameSpace → HeatMat6)
    (U : HeatRadialFrameSpace → ℝ),
    (∀ i j, ContDiff ℝ (n + 2 * m : ℕ) (fun z => a z i j)) →
    (∀ i, ContDiff ℝ (n + 2 * m : ℕ) (fun z => b z i)) →
    (∀ i k l, ContDiff ℝ (n + 2 * m : ℕ) (fun z => B z i k l)) →
    (∀ k l, ContDiff ℝ (n + 2 * m : ℕ) (fun z => C z k l)) →
    ContDiff ℝ (n + 2 * m : ℕ) U → (∀ z, U z ≠ 0) →
    ∀ k l, ContDiff ℝ n (fun z => heatFamilyCoefficientSequence a b B C U m z k l) := by
  induction m with
  | zero =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    simpa only [heatFamilyCoefficientSequence, mul_zero, add_zero] using hU.mul
      (contDiff_const (c := if k = l then (1 : ℝ) else 0))
  | succ m ih =>
    intro n a b B C U ha hb hB hC hU hU0 k l
    have he : n + 2 * (m + 1) = (n + 2) + 2 * m := by omega
    have hreg := ih (n + 2) a b B C U (fun i j => he ▸ ha i j)
      (fun i => he ▸ hb i) (fun i k l => he ▸ hB i k l)
      (fun k l => he ▸ hC k l) (he ▸ hU) hU0
    have hle : (n : ℕ∞ω) ≤ (n + 2 * (m + 1) : ℕ) := by
      exact_mod_cast (show n ≤ n + 2 * (m + 1) by omega)
    apply heatFamilyWeightedAverage_contDiff n m U _ (hU.of_le hle) _ hU0
    exact (heatFamilyBundleOperator_contDiff n a b B C _
      (fun i j => (ha i j).of_le hle) (fun i => (hb i).of_le hle)
      (fun i k l => (hB i k l).of_le hle) (fun k l => (hC k l).of_le hle)
      (fun q => hreg q l) k).neg

def HeatFamilySmoothCoefficients.amplitude (E : HeatFamilySmoothCoefficients) :
    ℕ → HeatRadialFrameSpace → HeatMat6 :=
  heatFamilyCoefficientSequence E.a E.b E.B E.C E.U

theorem HeatFamilySmoothCoefficients.amplitude_regular (E : HeatFamilySmoothCoefficients)
    (m : ℕ) (hm : m ≤ 3) (k l : Fin 6) :
    ContDiff ℝ 4 (fun z => E.amplitude m z k l) := by
  have hle : ((4 + 2 * m : ℕ) : ℕ∞ω) ≤ 10 := by
    exact_mod_cast (show 4 + 2 * m ≤ 10 by omega)
  exact heatFamilyCoefficientSequence_contDiff m 4 E.a E.b E.B E.C E.U
    (fun i j => (E.a_regular i j).of_le hle) (fun i => (E.b_regular i).of_le hle)
    (fun i k l => (E.B_regular i k l).of_le hle) (fun k l => (E.C_regular k l).of_le hle)
    (E.U_regular.of_le hle) (fun z => (E.U_pos z).ne') k l

end
end PositiveEinsteinFour.Geometry
end


section

/-! The one-form heat operator differentiates only normal vectors,
while retaining joint regularity in the center and frame. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators Matrix.Norms.Elementwise

noncomputable section

def heatFamilyOneOperator (a : HeatRadialFrameSpace → Mat4)
    (b : HeatRadialFrameSpace → Fin 4 → ℝ) (B : HeatRadialFrameSpace → Fin 4 → Mat4)
    (C : HeatRadialFrameSpace → Mat4) (u : HeatRadialFrameSpace → Fin 4 → ℝ)
    (z : HeatRadialFrameSpace) (k : Fin 4) : ℝ :=
  -(∑ i : Fin 4, ∑ j : Fin 4, a z i j *
      heatFamilyScalarPartial (heatFamilyScalarPartial (fun y => u y k) i) j z) +
    (∑ i : Fin 4, b z i * heatFamilyScalarPartial (fun y => u y k) i z) +
    (∑ i : Fin 4, ∑ l : Fin 4, B z i k l * heatFamilyScalarPartial (fun y => u y l) i z) +
    ∑ l : Fin 4, C z k l * u z l

theorem heatFamilyOneOperator_contDiff (n : ℕ)
    (a : HeatRadialFrameSpace → Mat4) (b : HeatRadialFrameSpace → Fin 4 → ℝ)
    (B : HeatRadialFrameSpace → Fin 4 → Mat4) (C : HeatRadialFrameSpace → Mat4)
    (u : HeatRadialFrameSpace → Fin 4 → ℝ)
    (ha : ∀ i j, ContDiff ℝ n (fun z => a z i j))
    (hb : ∀ i, ContDiff ℝ n (fun z => b z i))
    (hB : ∀ i k l, ContDiff ℝ n (fun z => B z i k l))
    (hC : ∀ k l, ContDiff ℝ n (fun z => C z k l))
    (hu : ∀ l, ContDiff ℝ (n + 2 : ℕ) (fun z => u z l)) (k : Fin 4) :
    ContDiff ℝ n (fun z => heatFamilyOneOperator a b B C u z k) := by
  have hp (i : Fin 4) (l : Fin 4) :
      ContDiff ℝ (n + 1 : ℕ) (heatFamilyScalarPartial (fun z => u z l) i) := by
    apply heatFamilyScalarPartial_contDiff
    simpa only [Nat.add_assoc] using hu l
  have hn : (n : ℕ∞ω) ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hpp (i j : Fin 4) : ContDiff ℝ n
      (heatFamilyScalarPartial (heatFamilyScalarPartial (fun z => u z k) i) j) :=
    heatFamilyScalarPartial_contDiff n _ (hp i k) j
  exact (((ContDiff.sum (fun i _ => ContDiff.sum (fun j _ =>
    (ha i j).mul (hpp i j)))).neg.add
      (ContDiff.sum (fun i _ => (hb i).mul ((hp i k).of_le hn)))).add
    (ContDiff.sum (fun i _ => ContDiff.sum (fun l _ =>
      (hB i k l).mul ((hp i l).of_le hn))))).add
    (ContDiff.sum (fun l _ => (hC k l).mul ((hu l).of_le
      (by exact_mod_cast (show n ≤ n + 2 by omega)))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Slicing the family operator gives exactly the corresponding six-component
operator, including its second spatial derivatives. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

theorem heatFamilyBundleOperator_slice
    (a : HeatRadialFrameSpace → Mat4) (b : HeatRadialFrameSpace → Fin 4 → ℝ)
    (B : HeatRadialFrameSpace → Fin 4 → HeatMat6) (C : HeatRadialFrameSpace → HeatMat6)
    (u : HeatRadialFrameSpace → Fin 6 → ℝ)
    (hu : ∀ l, ContDiff ℝ 2 (fun z => u z l))
    (z : HeatRadialFrameSpace) (k : Fin 6) :
    heatFamilyBundleOperator a b B C u z k =
      fourHeatBundleOperator (a z) (b z) (B z) (C z) (fun x l => u (x, z.2) l) z.1 k := by
  have hp (i : Fin 4) (l : Fin 6) :
      ContDiff ℝ 1 (heatFamilyScalarPartial (fun z => u z l) i) :=
    heatFamilyScalarPartial_contDiff 1 _ (hu l) i
  have he (i : Fin 4) (l : Fin 6) :
      (fun x => heatFamilyScalarPartial (fun z => u z l) i (x, z.2)) =
        partialDeriv (fun x => u (x, z.2) l) i := by
    funext x
    exact heatFamilyScalarPartial_slice _ (x, z.2)
      ((hu l).differentiable (by norm_num) _) i
  have hfirst (i : Fin 4) (l : Fin 6) :
      heatFamilyScalarPartial (fun y => u y l) i z =
        partialDeriv (fun x => u (x, z.2) l) i z.1 :=
    heatFamilyScalarPartial_slice _ z ((hu l).differentiable (by norm_num) z) i
  have hsecond (i j : Fin 4) :
      heatFamilyScalarPartial (heatFamilyScalarPartial (fun y => u y k) i) j z =
        partialDeriv (partialDeriv (fun x => u (x, z.2) k) i) j z.1 := by
    rw [heatFamilyScalarPartial_slice _ z ((hp i k).differentiable one_ne_zero z) j]
    rw [he i k]
  unfold heatFamilyBundleOperator fourHeatBundleOperator fourHeatLocalOperator
    fourHeatBundleFirst fourHeatBundleZero
  simp only [hfirst, hsecond, zero_mul, add_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normal-frame bundle parametrix through order three. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Metric
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def heatNormalBundleParametrix {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (t : ℝ) (x : FourSpace) : HeatMat6 :=
  fun k l => fourHeatGaussian t x *
    fourHeatBundlePolynomial (fun m y q => E.amplitude m y q l) t x k

theorem heatNormalBundleParametrix_residual {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r, ∀ t > (0 : ℝ), ∀ k l : Fin 6,
      deriv (fun s => heatNormalBundleParametrix E s x k l) t +
        fourHeatBundleOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
          (heatNormalBundleFirst D x) (heatNormalBundleZero D x)
          (fun y q => heatNormalBundleParametrix E t y q l) x k =
      fourHeatGaussian t x * t ^ 3 *
        fourHeatBundleOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
          (heatNormalBundleFirst D x) (heatNormalBundleZero D x)
          (fun y q => E.amplitude 3 y q l) x k := by
  obtain ⟨s, hs, htrans⟩ := E.amplitude_transport hRic he
  obtain ⟨s', hs', hbase⟩ := E.base.transport_neighborhood hRic he
  have hn : ∀ᶠ x in 𝓝 (0 : FourSpace),
      E.base.a x = (heatNormalMetric g o e x)⁻¹ ∧ E.base.b x = heatNormalDrift g o e x ∧
      E.B x = heatNormalBundleFirst D x ∧ E.C x = heatNormalBundleZero D x ∧
      x ∈ ball 0 s ∧ x ∈ ball 0 s' := by
    filter_upwards [E.base.a_near, E.base.b_near, E.B_near, E.C_near,
      ball_mem_nhds (0 : FourSpace) hs, ball_mem_nhds (0 : FourSpace) hs']
      with x ha hb hB hC hx hx'
    exact ⟨ha, hb, hB, hC, hx, hx'⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx t ht k l
  obtain ⟨ha, hb, hB, hC, hxs, hxs'⟩ := hball hx
  obtain ⟨hrad, hEik, hnext⟩ := htrans x hxs
  have hTU := (hbase x hxs').2.2.2
  have hreg (m : Fin 4) (q : Fin 6) : ContDiff ℝ 2 (fun y => E.amplitude m y q l) :=
    (E.amplitude_regular m (by omega) q l).of_le (by norm_num)
  have hzero (q : Fin 6) : fourHeatRadialTransport (E.base.a x) (E.base.b x)
      (fun y => E.amplitude 0 y q l) x = 0 := by
    by_cases hql : q = l
    · subst q
      simpa [HeatNormalBundleExtension.amplitude, fourHeatBundleCoefficient] using hTU
    · have hz : (fun y => E.amplitude 0 y q l) = fun _ => (0 : ℝ) := by
        funext y
        simp [HeatNormalBundleExtension.amplitude, fourHeatBundleCoefficient, hql]
      rw [hz]
      have hc := fourHeatRadialTransport_const_mul (E.base.a x) (E.base.b x) 0 E.base.U x
      simpa only [zero_mul] using hc
  have h := fourHeatBundlePolynomial_gaussian_residual (E.base.a x) (E.base.b x)
    (E.B x) (E.C x) (fun m y q => E.amplitude m y q l) hreg t ht x hrad hEik hzero
    (by intro q; simpa using hnext 0 (by omega) q l)
    (by intro q; convert hnext 1 (by omega) q l using 1 <;> norm_num)
    (by intro q; convert hnext 2 (by omega) q l using 1 <;> norm_num) k
  rw [ha, hb, hB, hC] at h
  exact h

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first diagonal bundle amplitude is its scalar contribution minus
the actual Weitzenböck potential. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem fourHeatBundleOperator_initial (a : Mat4) (b : Fin 4 → ℝ)
    (C : HeatMat6) (U : FourSpace → ℝ) (x : FourSpace) (k l : Fin 6) :
    fourHeatBundleOperator a b (fun _ => 0) C
      (fun y q => U y * (if q = l then 1 else 0)) x k =
    (if k = l then 1 else 0) * fourHeatLocalOperator a b 0 U x + U x * C k l := by
  have hf : (fun y => U y * (if k = l then 1 else 0)) =
      (fun y => (if k = l then 1 else 0) * U y) := by funext y; ring
  unfold fourHeatBundleOperator fourHeatBundleFirst fourHeatBundleZero
  rw [hf, fourHeatLocalOperator_const_mul]
  simp only [Matrix.zero_apply, zero_mul, Finset.sum_const_zero, add_zero]
  congr 1
  simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  ring

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalBundleExtension.first_amplitude_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) :
    E.amplitude 1 0 =
      (-fourHeatLocalOperator (E.base.a 0) (E.base.b 0) 0 E.base.U 0) • (1 : HeatMat6) -
        heatNormalPotential g c D.point 0 := by
  have hU : E.base.U 0 = 1 :=
    E.base.U_near.self_of_nhds.trans (heatNormalLeadingAmplitude_zero g o e)
  have hB : E.B 0 = fun _ => 0 := by
    funext i
    exact congrFun E.B_near.self_of_nhds i |>.trans (D.bundleFirst_zero i)
  have hC : E.C 0 = heatNormalPotential g c D.point 0 :=
    E.C_near.self_of_nhds.trans D.bundleZero_center
  ext k l
  have hrec := fourHeatBundleCoefficient_center 0 E.base.a E.base.b E.B E.C E.base.U
    (by rw [hU]; exact one_ne_zero) k l
  have hrec' : E.amplitude 1 0 k l =
    -fourHeatBundleOperator (E.base.a 0) (E.base.b 0) (E.B 0) (E.C 0)
      (fun y q => E.base.U y * (if q = l then 1 else 0)) 0 k := by
    simpa only [Nat.cast_zero, zero_add, one_mul] using! hrec
  rw [hB, hC, fourHeatBundleOperator_initial, hU] at hrec'
  change E.amplitude 1 0 k l =
    -fourHeatLocalOperator (E.base.a 0) (E.base.b 0) 0 E.base.U 0 *
      (if k = l then 1 else 0) - heatNormalPotential g c D.point 0 k l
  linarith only [hrec']

theorem HeatNormalBundleExtension.first_amplitude_intrinsic_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalBundleExtension D) (he : e.base ∈ (chartAt FourSpace c).source) :
    E.amplitude 1 0 =
      (-fourHeatLocalOperator (E.base.a 0) (E.base.b 0) 0 E.base.U 0) • (1 : HeatMat6) -
        twoFormPotentialMatrix (twoFormMetricCurvatureTensor g e) := by
  rw [E.first_amplitude_center, ← D.bundleZero_center, D.bundleZero_intrinsic_center he]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Scalar components of the actual normal-frame covariant derivative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_twoForm_partial_component (a : FourSpace → TwoFormFour) (x : FourSpace)
    (ha : DifferentiableAt ℝ a x) (i : Fin 4) (k : Fin 6) :
    partialDeriv (fun y => a y k) i x = (fderiv ℝ a x (coordinateVector i)) k := by
  let π : TwoFormFour →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 6 => ℝ) k
  have h := (π.hasFDerivAt.comp x ha.hasFDerivAt).fderiv
  exact congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector i)) h

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M}

theorem heatNormalTwoFormNabla_component {o : FrameOrientation g} {u : M → TwoFormFour}
    (hu : TwoFormSmooth o u) (c : M) (P : FourSpace → CoordinateFrameSpace) (x : FourSpace)
    (hP : ContDiffAt ℝ 1 P x) (hx : (P x).1 ∈ (chartAt FourSpace c).target)
    (i : Fin 4) (k : Fin 6) :
    heatNormalTwoFormNabla o c P u i x k =
      fourHeatCovariantDerivative (heatTwoFormConnection g c P)
        (fun y q => heatNormalTwoFormValue o c P u y q) i x k := by
  have ha := (heatNormalTwoFormValue_contDiffAt 1 hu c P x hP hx).differentiableAt one_ne_zero
  have h := congrFun (heatTwoFormConnectionMatrix_action
    (heatNormalFrameConnection g c P i x) (heatNormalTwoFormValue o c P u x)) k
  change (fderiv ℝ (heatNormalTwoFormValue o c P u) x (coordinateVector i)) k +
    twoFormSkewAction (twoFormExtract (heatNormalFrameConnection g c P i x))
      (heatNormalTwoFormValue o c P u x) k = _
  rw [← heat_twoForm_partial_component _ x ha i k]
  change partialDeriv (fun y => heatNormalTwoFormValue o c P u y k) i x + _ =
    partialDeriv (fun y => heatNormalTwoFormValue o c P u y k) i x + _
  exact congrArg (_ + ·) h.symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The first actual one-form amplitude contains the Ricci potential 3 Id. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem fourHeatOneOperator_initial (a : Mat4) (b : Fin 4 → ℝ)
    (C : Mat4) (U : FourSpace → ℝ) (x : FourSpace) (k l : Fin 4) :
    fourHeatOneOperator a b (fun _ => 0) C
      (fun y q => U y * (if q = l then 1 else 0)) x k =
    (if k = l then 1 else 0) * fourHeatLocalOperator a b 0 U x + U x * C k l := by
  have hf : (fun y => U y * (if k = l then 1 else 0)) =
      (fun y => (if k = l then 1 else 0) * U y) := by funext y; ring
  unfold fourHeatOneOperator fourHeatOneFirst fourHeatOneZero
  rw [hf, fourHeatLocalOperator_const_mul]
  simp only [Matrix.zero_apply, zero_mul, Finset.sum_const_zero, add_zero]
  congr 1
  simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  ring

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.oneFirst_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i : Fin 4) : heatNormalOneFirst D 0 i = 0 := by
  simp [heatNormalOneFirst, fourHeatOneConnectionFirst, D.frame_connection_zero]

theorem HeatNormalFrameData.oneConnection_diagonal_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i k l : Fin 4) :
    partialDeriv (fun x => heatNormalFrameConnection g c D.point i x k l) i 0 = 0 := by
  have h := D.frame_connection_first_jet i i k l
  linarith only [h]

theorem HeatNormalFrameData.oneZero_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) :
    heatNormalOneZero D 0 = (3 : ℝ) • (1 : Mat4) := by
  ext k l
  simp [heatNormalOneZero, fourHeatOneConnectionZero, heatNormalMetric_zero,
    D.frame_connection_zero, D.oneConnection_diagonal_zero, Matrix.one_apply]

theorem HeatNormalOneExtension.first_amplitude_center {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalOneExtension D) :
    E.amplitude 1 0 =
      (-fourHeatLocalOperator (E.base.a 0) (E.base.b 0) 0 E.base.U 0) • (1 : Mat4) -
        ((3 : ℝ) • (1 : Mat4)) := by
  have hU : E.base.U 0 = 1 :=
    E.base.U_near.self_of_nhds.trans (heatNormalLeadingAmplitude_zero g o e)
  have hB : E.B 0 = fun _ => 0 := by
    funext i
    exact congrFun E.B_near.self_of_nhds i |>.trans (D.oneFirst_zero i)
  have hC : E.C 0 = ((3 : ℝ) • (1 : Mat4)) :=
    E.C_near.self_of_nhds.trans D.oneZero_center
  ext k l
  have hrec := fourHeatOneCoefficient_center 0 E.base.a E.base.b E.B E.C E.base.U
    (by rw [hU]; exact one_ne_zero) k l
  have hrec' : E.amplitude 1 0 k l =
    -fourHeatOneOperator (E.base.a 0) (E.base.b 0) (E.B 0) (E.C 0)
      (fun y q => E.base.U y * (if q = l then 1 else 0)) 0 k := by
    simpa only [Nat.cast_zero, zero_add, one_mul] using! hrec
  rw [hB, hC, fourHeatOneOperator_initial, hU] at hrec'
  change E.amplitude 1 0 k l =
    -fourHeatLocalOperator (E.base.a 0) (E.base.b 0) 0 E.base.U 0 *
      (if k = l then 1 else 0) - ((3 : ℝ) • (1 : Mat4)) k l
  linarith only [hrec']

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normal-frame bundle parametrix through order three. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Metric
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

def heatNormalOneParametrix {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalOneExtension D) (t : ℝ) (x : FourSpace) : Mat4 :=
  fun k l => fourHeatGaussian t x *
    fourHeatOnePolynomial (fun m y q => E.amplitude m y q l) t x k

theorem heatNormalOneParametrix_residual {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalOneExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ x ∈ ball 0 r, ∀ t > (0 : ℝ), ∀ k l : Fin 4,
      deriv (fun s => heatNormalOneParametrix E s x k l) t +
        fourHeatOneOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
          (heatNormalOneFirst D x) (heatNormalOneZero D x)
          (fun y q => heatNormalOneParametrix E t y q l) x k =
      fourHeatGaussian t x * t ^ 3 *
        fourHeatOneOperator (heatNormalMetric g o e x)⁻¹ (heatNormalDrift g o e x)
          (heatNormalOneFirst D x) (heatNormalOneZero D x)
          (fun y q => E.amplitude 3 y q l) x k := by
  obtain ⟨s, hs, htrans⟩ := E.amplitude_transport hRic he
  obtain ⟨s', hs', hbase⟩ := E.base.transport_neighborhood hRic he
  have hn : ∀ᶠ x in 𝓝 (0 : FourSpace),
      E.base.a x = (heatNormalMetric g o e x)⁻¹ ∧ E.base.b x = heatNormalDrift g o e x ∧
      E.B x = heatNormalOneFirst D x ∧ E.C x = heatNormalOneZero D x ∧
      x ∈ ball 0 s ∧ x ∈ ball 0 s' := by
    filter_upwards [E.base.a_near, E.base.b_near, E.B_near, E.C_near,
      ball_mem_nhds (0 : FourSpace) hs, ball_mem_nhds (0 : FourSpace) hs']
      with x ha hb hB hC hx hx'
    exact ⟨ha, hb, hB, hC, hx, hx'⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hn
  refine ⟨r, hr, ?_⟩
  intro x hx t ht k l
  obtain ⟨ha, hb, hB, hC, hxs, hxs'⟩ := hball hx
  obtain ⟨hrad, hEik, hnext⟩ := htrans x hxs
  have hTU := (hbase x hxs').2.2.2
  have hreg (m : Fin 4) (q : Fin 4) : ContDiff ℝ 2 (fun y => E.amplitude m y q l) :=
    (E.amplitude_regular m (by omega) q l).of_le (by norm_num)
  have hzero (q : Fin 4) : fourHeatRadialTransport (E.base.a x) (E.base.b x)
      (fun y => E.amplitude 0 y q l) x = 0 := by
    by_cases hql : q = l
    · subst q
      simpa [HeatNormalOneExtension.amplitude, fourHeatOneCoefficient] using hTU
    · have hz : (fun y => E.amplitude 0 y q l) = fun _ => (0 : ℝ) := by
        funext y
        simp [HeatNormalOneExtension.amplitude, fourHeatOneCoefficient, hql]
      rw [hz]
      have hc := fourHeatRadialTransport_const_mul (E.base.a x) (E.base.b x) 0 E.base.U x
      simpa only [zero_mul] using hc
  have h := fourHeatOnePolynomial_gaussian_residual (E.base.a x) (E.base.b x)
    (E.B x) (E.C x) (fun m y q => E.amplitude m y q l) hreg t ht x hrad hEik hzero
    (by intro q; simpa using hnext 0 (by omega) q l)
    (by intro q; convert hnext 1 (by omega) q l using 1 <;> norm_num)
    (by intro q; convert hnext 2 (by omega) q l using 1 <;> norm_num) k
  rw [ha, hb, hB, hC] at h
  exact h

end
end PositiveEinsteinFour.Geometry
end


section

/-! The radial first jet on two-forms is the actual curvature action,
including the sign imposed by covariant tensor slots. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

def heatConnectionMatrixLinear : Mat4 →ₗ[ℝ] HeatMat6 where
  toFun := heatTwoFormConnectionMatrix
  map_add' A B := by
    ext k l
    simpa only [heatConnectionActionLinear_apply, WithLp.ofLp_add, Pi.add_apply,
      heatTwoFormConnectionMatrix, Matrix.add_apply] using congrArg (fun a : TwoFormFour => a k)
      ((heatConnectionActionLinear (EuclideanSpace.basisFun (Fin 6) ℝ l)).map_add A B)
  map_smul' r A := by
    ext k l
    simpa only [heatConnectionActionLinear_apply, PiLp.smul_apply, smul_eq_mul,
      heatTwoFormConnectionMatrix, Matrix.smul_apply, RingHom.id_apply] using
      congrArg (fun a : TwoFormFour => a k)
      ((heatConnectionActionLinear (EuclideanSpace.basisFun (Fin 6) ℝ l)).map_smul r A)

theorem heat_matrixPartial_eq_fderiv (B : FourSpace → Mat4) (x : FourSpace)
    (hB : ∀ r s, DifferentiableAt ℝ (fun z => B z r s) x) (i : Fin 4) :
    matrixPartial B i x = fderiv ℝ B x (coordinateVector i) := by
  have hd : DifferentiableAt ℝ B x :=
    differentiableAt_pi.mpr (fun r => differentiableAt_pi.mpr (hB r))
  ext r s
  let L₁ : Mat4 →L[ℝ] (Fin 4 → ℝ) := ContinuousLinearMap.proj r
  let L₂ : (Fin 4 → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj s
  let L := L₂.comp L₁
  exact congrArg (fun K : FourSpace →L[ℝ] ℝ => K (coordinateVector i))
    (L.hasFDerivAt.comp x hd.hasFDerivAt).fderiv

theorem heatTwoFormConnectionMatrix_partial (B : FourSpace → Mat4) (x : FourSpace)
    (hB : ∀ r s, DifferentiableAt ℝ (fun z => B z r s) x) (i : Fin 4) (k l : Fin 6) :
    partialDeriv (fun z => heatTwoFormConnectionMatrix (B z) k l) i x =
      heatTwoFormConnectionMatrix (matrixPartial B i x) k l := by
  have hd : DifferentiableAt ℝ B x :=
    differentiableAt_pi.mpr (fun r => differentiableAt_pi.mpr (hB r))
  let L : Mat4 →L[ℝ] ℝ := (ContinuousLinearMap.proj l).comp
    ((ContinuousLinearMap.proj k).comp heatConnectionMatrixLinear.toContinuousLinearMap)
  rw [heat_matrixPartial_eq_fderiv B x hB i]
  exact congrArg (fun K : FourSpace →L[ℝ] ℝ => K (coordinateVector i))
    (L.hasFDerivAt.comp x hd.hasFDerivAt).fderiv

theorem heatTwoFormConnectionMatrix_infinitesimal (B : Mat4) :
    heatTwoFormConnectionMatrix B = twoFormInfinitesimalMatrix (twoFormExtract B) := by
  ext k l
  fin_cases k <;> fin_cases l <;>
    simp [heatTwoFormConnectionMatrix, twoFormInfinitesimalMatrix, twoFormSkewAction,
      EuclideanSpace.basisFun_apply]

theorem heatTwoFormConnectionMatrix_curvature (R : CovariantCoordinates 4)
    (hl : ∀ i j k l, R ![i,j,l,k] = -R ![i,j,k,l]) (i j : Fin 4) :
    heatTwoFormConnectionMatrix (curvatureEndomorphism (fun a b c d => R ![a,b,c,d]) i j) =
      twoFormConnectionCurvatureMatrix R i j := by
  have hm : curvatureEndomorphism (fun a b c d => R ![a,b,c,d]) i j =
      -(fun k l => R ![i,j,k,l]) := by
    ext k l
    exact hl i j k l
  rw [hm]
  have hn : heatTwoFormConnectionMatrix (-(fun k l => R ![i,j,k,l] : Mat4)) =
      -heatTwoFormConnectionMatrix (fun k l => R ![i,j,k,l]) :=
    heatConnectionMatrixLinear.map_neg _
  rw [hn]
  exact congrArg (fun A : HeatMat6 => -A)
    (heatTwoFormConnectionMatrix_infinitesimal (fun k l => R ![i,j,k,l]))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M}

theorem HeatNormalFrameData.twoForm_connection_half_curvature
    {f : OrthonormalFrame g c} (D : HeatNormalFrameData g o c ⟨c, f⟩)
    (i j : Fin 4) (k l : Fin 6) :
    partialDeriv (fun x => heatTwoFormConnection g c D.point j x k l) i 0 =
      (1 / 2 : ℝ) * twoFormConnectionCurvatureMatrix
        (twoFormMetricCurvatureTensor g (⟨c, f⟩ : FrameBundle g)) i j k l := by
  change partialDeriv (fun x => heatTwoFormConnectionMatrix
    (heatNormalFrameConnection g c D.point j x) k l) i 0 = _
  rw [heatTwoFormConnectionMatrix_partial _ 0
    (fun r s => (D.connection_regular j r s).differentiableAt (by norm_num))]
  have hm : matrixPartial (heatNormalFrameConnection g c D.point j) i 0 =
      (1 / 2 : ℝ) • curvatureEndomorphism (frameCurvature g c f) i j := by
    ext r s
    exact D.frame_connection_half_curvature i j r s
  rw [hm]
  change heatConnectionMatrixLinear ((1 / 2 : ℝ) • _) k l = _
  rw [map_smul]
  change (1 / 2 : ℝ) * heatTwoFormConnectionMatrix
    (curvatureEndomorphism (frameCurvature g c f) i j) k l = _
  have hR : (fun a b d h =>
      twoFormMetricCurvatureTensor g (⟨c, f⟩ : FrameBundle g) ![a,b,d,h]) =
      frameCurvature g c f := by
    funext a b d h
    simp only [twoFormMetricCurvatureTensor, frameTensor_curvatureCoordinates]
  rw [← hR, heatTwoFormConnectionMatrix_curvature]
  intro a b d h
  simp only [twoFormMetricCurvatureTensor, frameTensor_curvatureCoordinates]
  exact frame_algebraic_lastSkew f a b d h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Trace summability follows from the actual bounded scalar heat evaluation
map and integration of Bessel's inequality over normalized volume. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff NNReal BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M] [SecondCountableTopology M]

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

local instance scalarTrace_probability : IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalarHeat_eigen_integral (t : ℝ≥0) (ht : 0 < t) (i : ScalarBaseEigenIndex g o d) :
    (∫ x, (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) x) ^ 2
      ∂normalizedVolume g) = scalarBaseHeatWeight g o d t i ^ 2 := by
  have h := ContinuousMap.inner_toLp (normalizedVolume g)
    (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i))
    (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i))
  rw [scalarHeatToContinuous_L2] at h
  calc
    _ = inner ℝ (scalarBaseHeat g o d t (scalarBaseEigenvector g o d i))
        (scalarBaseHeat g o d t (scalarBaseEigenvector g o d i)) := by
      simpa only [conj_trivial, pow_two] using h.symm
    _ = _ := by
      rw [real_inner_self_eq_norm_sq, scalarBaseHeat_eigenvector, norm_smul,
        Real.norm_eq_abs, (scalarBaseEigenvector_orthonormal g o d).1 i, mul_one, sq_abs]

theorem scalarHeat_diagonal_bound (t : ℝ≥0) (ht : 0 < t)
    (s : Finset (ScalarBaseEigenIndex g o d)) (x : M) :
    (∑ i ∈ s, (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) x) ^ 2) ≤
      ‖scalarHeatToContinuous g o d t ht‖ ^ 2 := by
  have hb := (scalarBaseEigenvector_orthonormal g o d).sum_inner_products_le
    (scalarHeatColumn g o d t ht x) (s := s)
  have he (i : ScalarBaseEigenIndex g o d) :
      inner ℝ (scalarBaseEigenvector g o d i) (scalarHeatColumn g o d t ht x) =
        scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) x :=
    (real_inner_comm _ _).trans (scalarHeatColumn_pairing g o d t ht x _)
  simp_rw [he, Real.norm_eq_abs, sq_abs] at hb
  have hn := scalarHeatColumn_norm g o d t ht x
  have hsq : ‖scalarHeatColumn g o d t ht x‖ ^ 2 ≤
      ‖scalarHeatToContinuous g o d t ht‖ ^ 2 :=
    (sq_le_sq₀ (norm_nonneg (scalarHeatColumn g o d t ht x))
      (norm_nonneg (scalarHeatToContinuous g o d t ht))).mpr hn
  exact hb.trans hsq

theorem scalarHeat_weight_square_summable (t : ℝ≥0) (ht : 0 < t) :
    Summable (fun i : ScalarBaseEigenIndex g o d => scalarBaseHeatWeight g o d t i ^ 2) := by
  apply summable_of_sum_le (fun _ => sq_nonneg _) (c := ‖scalarHeatToContinuous g o d t ht‖ ^ 2)
  intro s
  have hi (i : ScalarBaseEigenIndex g o d) : Integrable
      (fun x => (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) x) ^ 2)
      (normalizedVolume g) :=
    ((scalarHeatToContinuous g o d t ht _).continuous.pow 2).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  calc
    _ = ∫ x, ∑ i ∈ s, (scalarHeatToContinuous g o d t ht (scalarBaseEigenvector g o d i) x) ^ 2
        ∂normalizedVolume g := by
      rw [integral_finsetSum s (fun i _ => hi i)]
      exact Finset.sum_congr rfl (fun i _ => (scalarHeat_eigen_integral g o d t ht i).symm)
    _ ≤ ∫ _x, ‖scalarHeatToContinuous g o d t ht‖ ^ 2 ∂normalizedVolume g :=
      integral_mono (integrable_finsetSum s (fun i _ => hi i)) (integrable_const _)
        (scalarHeat_diagonal_bound g o d t ht s)
    _ = _ := by simp

theorem scalarHeat_weight_summable (t : ℝ≥0) (ht : 0 < t) :
    Summable (fun i : ScalarBaseEigenIndex g o d => scalarBaseHeatWeight g o d t i) := by
  have hs := scalarHeat_weight_square_summable g o d (t / 2) (half_pos ht)
  apply hs.congr
  intro i
  simp only [scalarBaseHeatWeight, pow_two, ← Real.exp_add, NNReal.coe_div, NNReal.coe_ofNat]
  congr 1
  ring

instance scalarBaseEigenIndex_countable : Countable (ScalarBaseEigenIndex g o d) := by
  apply Set.countable_univ_iff.mp
  have h := (scalarHeat_weight_summable g o d 1 zero_lt_one).countable_support
  convert h using 1
  ext i
  simp only [Set.mem_univ, Function.mem_support, scalarBaseHeatWeight, ne_eq, Real.exp_ne_zero,
    not_false_eq_true]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual minimizing scalar has fourth-power integrable weak gradients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance minimumGradientL4_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_subcritical_minimum_gradient_memLp_four
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (w : scalarWeightedH1 d)
    (hw : ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) w‖ = 1)
    (hm : ‖w‖ ^ 2 ≤ 1)
    (hmin : ∀ v : scalarWeightedH1 d, ‖w‖ ^ 2 *
      ‖scalarWeightedBaseLp g o d (ENNReal.ofReal p) (by exact_mod_cast hp4.le) v‖ ^ 2 ≤ ‖v‖ ^ 2)
    (i : Fin 4) :
    MemLp (scalarH1Gradient d i (scalarWeightedH1ToH1 d w) : FrameBundle g → ℝ)
      4 (canonicalFrameMeasure g o) := by
  let u := scalarWeightedH1ToH1 d w
  have hlocal (c : M) : ∃ U : Set M, IsOpen U ∧ c ∈ U ∧
      ∃ hU : U ⊆ (chartAt FourSpace c).source,
      ∀ (ρ : SmoothScalar (M := M)) (hρ : tsupport ρ.val ⊆ U),
      MemSobolev 2 2 (scalarComplexL2 (scalarH1CutoffValueL2 g o d c
        (scalarChartSupport_compact c ρ (hρ.trans hU))
        (scalarChartSupport_subset c ρ (hρ.trans hU))
        (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ (hρ.trans hU))
        (scalarChartCutoff_compact c ρ (hρ.trans hU))
        (scalarChartCutoff_support c ρ (hρ.trans hU)) u) : 𝓢'(FourSpace, ℂ)) := by
    let z₀ : ChartTarget c := ⟨chartAt FourSpace c c,
      (chartAt FourSpace c).map_source (mem_chart_source FourSpace c)⟩
    obtain ⟨r, hr, ht, v, hv, hreg⟩ :=
      scalar_subcritical_minimum_local_H2 g o d hp hp4 w hw hm hmin c z₀
    obtain ⟨U, hU, hcU, hUc, hcut⟩ := scalar_elliptic_cutoff_neighborhood g c z₀ r hr
    have hcU' : c ∈ U := by
      simpa only [z₀, (chartAt FourSpace c).left_inv (mem_chart_source FourSpace c)] using hcU
    refine ⟨U, hU, hcU', hUc, ?_⟩
    intro ρ hρ
    obtain ⟨v', hv'2, hv'⟩ := scalar_chart_H2_realization g c z₀ r hr ht
      (scalarH1BaseValue g o d u) v hv hreg (scalarChartCutoff c ρ)
      (scalarChartCutoff_smooth c ρ (hρ.trans hUc))
      (scalarChartCutoff_compact c ρ (hρ.trans hUc)) (hcut ρ hρ)
    exact scalarH1CutoffValue_H2_of_rep g o d c
      (scalarChartSupport_compact c ρ (hρ.trans hUc))
      (scalarChartSupport_subset c ρ (hρ.trans hUc))
      (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ (hρ.trans hUc))
      (scalarChartCutoff_compact c ρ (hρ.trans hUc))
      (scalarChartCutoff_support c ρ (hρ.trans hUc)) u v' hv'2 hv'
  choose U hU hx hchart hH2 using hlocal
  obtain ⟨P, hP⟩ := scalarPartition_subordinate_neighborhoods U hU hx hchart
  apply scalarH1Gradient_memLp_four_of_partition g o d P u i
  intro j
  apply scalarH1LocalizedFrame_memLp_four g o d (P.center j) (scalarPartitionFunction P j)
    (scalarPartitionFunction_support P j) (scalarPartitionFunction_abs_le_one P j) u
  intro k
  exact scalarH1LocalizedCoordinate_memLp_four_of_H2 g o d (P.center j)
    (scalarPartitionFunction P j) (scalarPartitionFunction_support P j) u
    (hH2 (P.center j) (scalarPartitionFunction P j) (hP j)) k

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual weak Hodge operator becomes invertible after adding its
finite harmonic projection. This is the needed Fredholm step. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormHodgeCompact : TwoFormH1 o →L[ℝ] TwoFormH1 o :=
  twoFormRoughSolution.comp (twoFormWeitzenbockPotential.comp twoFormH1ToL2)

theorem twoFormHodgeCompact_compact : IsCompactOperator (twoFormHodgeCompact (o := o)) :=
  (twoFormH1ToL2_compact.clm_comp twoFormWeitzenbockPotential).clm_comp twoFormRoughSolution

def twoFormHodgeOperator : TwoFormH1 o →L[ℝ] TwoFormH1 o :=
  ContinuousLinearMap.id ℝ (TwoFormH1 o) - twoFormHodgeCompact

theorem twoFormHodgeOperator_inner (u v : TwoFormH1 o) :
    inner ℝ (twoFormHodgeOperator u) v = twoFormHodgeForm u v := by
  change inner ℝ (u - twoFormRoughSolution (twoFormWeitzenbockPotential (twoFormH1ToL2 u))) v = _
  rw [inner_sub_left, twoFormRoughSolution_weak]
  rfl

theorem twoFormHodgeOperator_ker :
    (twoFormHodgeOperator (o := o)).ker = twoFormWeitzenbockKernel := rfl

def twoFormHarmonicProjection : TwoFormH1 o →L[ℝ] TwoFormH1 o :=
  (twoFormWeitzenbockKernel (o := o)).starProjection

theorem twoFormHarmonicProjection_compact :
    IsCompactOperator (twoFormHarmonicProjection (o := o)) :=
  (isCompactOperator_of_locallyCompactSpace_rng
    (twoFormWeitzenbockKernel (o := o)).subtypeL).comp_clm
      (twoFormWeitzenbockKernel (o := o)).orthogonalProjectionOnto

theorem twoFormHarmonicProjection_inner (u : TwoFormH1 o) :
    inner ℝ (twoFormHarmonicProjection u) u =
      inner ℝ (twoFormHarmonicProjection u) (twoFormHarmonicProjection u) := by
  have h := Submodule.starProjection_inner_eq_zero (K := twoFormWeitzenbockKernel (o := o))
    u (twoFormHarmonicProjection u)
      (Submodule.starProjection_apply_mem _ u)
  rw [inner_sub_left] at h
  change inner ℝ u (twoFormHarmonicProjection u) -
    inner ℝ (twoFormHarmonicProjection u) (twoFormHarmonicProjection u) = 0 at h
  rw [real_inner_comm (twoFormHarmonicProjection u) u] at h
  exact sub_eq_zero.mp h

def twoFormRegularizedHodge : TwoFormH1 o →L[ℝ] TwoFormH1 o :=
  twoFormHodgeOperator + twoFormHarmonicProjection

theorem twoFormRegularizedHodge_eq_zero (hRic : RicciThree g) (u : TwoFormH1 o)
    (hu : twoFormRegularizedHodge u = 0) : u = 0 := by
  have hinner := congrArg (fun v : TwoFormH1 o => inner ℝ v u) hu
  change inner ℝ (twoFormHodgeOperator u + twoFormHarmonicProjection u) u = inner ℝ 0 u at hinner
  rw [inner_add_left, twoFormHodgeOperator_inner, twoFormHarmonicProjection_inner,
    inner_zero_left] at hinner
  have h0 := twoFormHodgeForm_nonneg hRic u
  have hP := real_inner_self_nonneg (x := twoFormHarmonicProjection u)
  have hE : twoFormHodgeForm u u = 0 := by linarith
  have hK := (mem_twoFormWeitzenbockKernel_iff_energy_zero hRic u).mpr hE
  have hPr : twoFormHarmonicProjection u = u :=
    Submodule.starProjection_eq_self_iff.mpr hK
  have hL : twoFormHodgeOperator u = 0 := hK
  change twoFormHodgeOperator u + twoFormHarmonicProjection u = 0 at hu
  simpa only [hL, hPr, zero_add] using hu

theorem twoFormRegularizedHodge_injective (hRic : RicciThree g) :
    Function.Injective (twoFormRegularizedHodge (o := o)) := by
  intro u v huv
  apply sub_eq_zero.mp
  apply twoFormRegularizedHodge_eq_zero hRic
  rw [map_sub, huv, sub_self]

theorem twoFormRegularizedHodge_surjective (hRic : RicciThree g) :
    Function.Surjective (twoFormRegularizedHodge (o := o)) := by
  let T : TwoFormH1 o →L[ℝ] TwoFormH1 o := twoFormHodgeCompact - twoFormHarmonicProjection
  have hc : IsCompactOperator T := twoFormHodgeCompact_compact.sub twoFormHarmonicProjection_compact
  have he : (1 : TwoFormH1 o →L[ℝ] TwoFormH1 o) - T = twoFormRegularizedHodge := by
    apply ContinuousLinearMap.ext
    intro u
    change u - (twoFormHodgeCompact u - twoFormHarmonicProjection u) =
      (u - twoFormHodgeCompact u) + twoFormHarmonicProjection u
    module
  rcases hc.hasEigenvalue_or_mem_resolventSet (one_ne_zero : (1 : ℝ) ≠ 0) with hv | hr
  · obtain ⟨u, hu⟩ := hv.exists_hasEigenvector
    have hf := (Module.End.mem_eigenspace_iff.mp hu.1)
    change T u = (1 : ℝ) • u at hf
    rw [one_smul] at hf
    have hzero : twoFormRegularizedHodge u = 0 := by
      rw [← he]
      change u - T u = 0
      rw [hf, sub_self]
    exact (hu.2 (twoFormRegularizedHodge_eq_zero hRic u hzero)).elim
  · have hi := spectrum.mem_resolventSet_iff.mp hr
    simp only [map_one] at hi
    rw [he] at hi
    exact (ContinuousLinearMap.isUnit_iff_bijective.mp hi).2

end
end PositiveEinsteinFour.Geometry
