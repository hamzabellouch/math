/-! Actual local H3 regularity of intrinsic weak solutions with H1 forcing.
The metric coefficients, source, scaling and cutoffs are all constructed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance localH1Regularity_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_local_weighted_H3 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : scalarH1 d) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarH1Value d f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure V),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d u
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w ∧
        ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
          MemSobolev 3 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := scalarRescaledSourceL2 g c (scalarH1BaseValue g o d f) χ hχ hc ht z₀ r hr.ne'
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d (scalarH1BaseValue g o d f) u
      (by simpa only [scalarH1BaseValue_spec] using hw) c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c (scalarH1BaseValue g o d f) χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹
  let Ft := scalarComplexL2 (κ • F)
  have hFt : MemSobolev 1 2 (Ft : T) := by
    rw [show (Ft : T) = (κ : ℂ) • (scalarComplexL2 F : T) from
      scalarComplexL2_real_smul_distribution κ F]
    exact (scalarRescaledSourceL2_memSobolev_one g o d c f χ hχ hc ht z₀ r hr.ne').smul (κ : ℂ)
  have hpair (φ : S) : (Ft : T) φ = ∫ y, φ y * ((κ * F y : ℝ) : ℂ) := by
    rw [Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [scalarComplexL2_coe (κ • F), Lp.coeFn_smul κ F] with y hc hs
    rw [hc, hs]
    rfl
  have htests (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ =
        (Ft : T) φ := by
    rw [scalarFormalAdjointOperator_remainder]
    exact (scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F w a b
      (ball 0 1) hA hB hreal φ hφc hφs (scalar_real_L2_test_integrable F φ _)).trans
      (hpair φ).symm
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, w, ?_, ?_⟩
  ·
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ w₀
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w y = w₀ (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm
  · intro φ hφc hφs
    exact scalar_ball_H1_forcing_gain a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
      (scalarComplexL2 w : T) (Ft : T) hFt hW htests
      (1 / 2) (by norm_num) (by norm_num) φ hφc hφs

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local smoothness of the actual intrinsic weak Poisson solution.
All coefficients, cutoffs, affine maps and right-hand sides are constructed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance localPoisson_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_local_weighted_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : SmoothScalar (M := M)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ F : V → ℝ, ContDiff ℝ (⊤ : ℕ∞) F ∧
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d u
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) (1 / 4))] F := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) =
        ∫ y, scalarRescaledSource g c z₀ r f y * ψ y := by
    exact scalarRescaled_test_equation g o d f u hw c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc
      (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)
  obtain ⟨F, hF, heq⟩ := scalar_rescaled_solution_smooth g c z₀ r f w hW
    a b htarget hA hB ha₀ ha₁ ha₂ hb₀ hb₁ hreal
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, F, hF, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
  have hwr := scalarAffinePullbackL2_coe A z₀ w₀
  filter_upwards [heq, ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
    ae_restrict_mem isOpen_ball.measurableSet] with y hFq hbq hwq hy
  have hy₁ : y ∈ closedBall (0 : V) 1 := by
    apply ball_subset_closedBall
    exact ball_subset_ball (by norm_num : (1 / 4 : ℝ) ≤ 1) hy
  have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
  dsimp only [Function.comp_apply] at hbq
  change w₀ (A y + z₀) = _ at hbq
  rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
  change w y = w₀ (A y + z₀) at hwq
  rw [hp] at hwq
  exact (hwq.trans hbq).symm.trans hFq

end
end PositiveEinsteinFour.Geometry
end


section

/-! Real smooth approximations carrying the same higher-order derivative
limits as their complex Fourier construction. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter LineDeriv
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "L4" => Lp ℝ 4 (volume : Measure V)
local notation "Linf" => Lp ℝ ∞ (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

def scalarRealSchwartzJet : List (Fin 4) → S →L[ℝ] S
  | [] => ContinuousLinearMap.id ℝ S
  | i :: is => (lineDerivOpCLM ℝ S (EuclideanSpace.basisFun (Fin 4) ℝ i)).comp
      (scalarRealSchwartzJet is)

theorem scalarRealSchwartzJet_re (is : List (Fin 4)) (f : 𝓢(V, ℂ)) :
    scalarRealSchwartzJet is (f.postcompCLM Complex.reCLM) =
      (scalarSchwartzCoordinateJet is f).postcompCLM Complex.reCLM := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    change (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i}
      (scalarRealSchwartzJet is (f.postcompCLM Complex.reCLM)) : S) = _
    rw [ih]
    exact scalarSchwartz_re_derivative (scalarSchwartzCoordinateJet is f) i

/-- One real sequence controls all finite jets, with L4 and uniform control
at the Sobolev orders used in products. -/
theorem scalar_real_integer_approximation (n : ℕ) (u : L2)
    (hu : MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T)) :
    ∃ (fs : ℕ → S) (G : List (Fin 4) → L2)
      (G4 : List (Fin 4) → L4) (Gtop : List (Fin 4) → Linf),
      (∀ᵐ x ∂(volume : Measure V), Tendsto (fun k => fs k x) atTop (𝓝 (u x))) ∧
      Tendsto (fun k => (fs k).toLp 2 volume) atTop (𝓝 u) ∧
      (∀ is, is.length ≤ n → Tendsto (fun k => (scalarRealSchwartzJet is (fs k)).toLp 2 volume)
        atTop (𝓝 (G is))) ∧
      (∀ is, is.length + 1 ≤ n → Tendsto (fun k => (scalarRealSchwartzJet is (fs k)).toLp 4 volume)
        atTop (𝓝 (G4 is))) ∧
      (∀ is, is.length + 3 ≤ n → Tendsto (fun k => (scalarRealSchwartzJet is (fs k)).toLp ∞ volume)
        atTop (𝓝 (Gtop is))) ∧
      (∀ is, is.length + 1 ≤ n → (G is : V → ℝ) =ᵐ[volume] G4 is) ∧
      (∀ is, is.length + 3 ≤ n → (G is : V → ℝ) =ᵐ[volume] Gtop is) := by
  obtain ⟨v, fs, _, hae, hf, hG, hG4, hGtop⟩ := scalar_integer_smooth_approximation n (scalarComplexL2 u) hu
  let R2 := Complex.reCLM.compLpL 2 (volume : Measure V)
  let R4 := Complex.reCLM.compLpL 4 (volume : Measure V)
  let Rt := Complex.reCLM.compLpL ∞ (volume : Measure V)
  let G : List (Fin 4) → L2 := fun is =>
    if h : is.length ≤ n then R2 (scalarBesselJetL2 n is h v) else 0
  let G4 : List (Fin 4) → L4 := fun is =>
    if h : is.length + 1 ≤ n then R4 (scalarBesselJetL4 n is h v) else 0
  let Gtop : List (Fin 4) → Linf := fun is =>
    if h : is.length + 3 ≤ n then Rt (scalarBesselJetUniform n is h v) else 0
  have hRu : R2 (scalarComplexL2 u) = u := by
    apply Lp.ext
    filter_upwards [Complex.reCLM.coeFn_compLp (scalarComplexL2 u), scalarComplexL2_coe u] with x hr hu
    change Complex.reCLM.compLp (scalarComplexL2 u) x = u x
    rw [hr, hu]
    rfl
  refine ⟨fun k => (fs k).postcompCLM Complex.reCLM, G, G4, Gtop, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · filter_upwards [hae, scalarComplexL2_coe u] with x hx he
    have h := Complex.continuous_re.continuousAt.tendsto.comp hx
    change Tendsto (fun k => (fs k x).re) atTop (𝓝 (u x))
    simpa only [he, Complex.ofReal_re, Function.comp_def] using h
  · simp only [scalarSchwartz_re_toLp]
    have ht := R2.continuous.continuousAt.tendsto.comp hf
    simpa only [Function.comp_def, hRu] using! ht
  · intro is hs
    simp only [scalarRealSchwartzJet_re, scalarSchwartz_re_toLp, G, dite_eq_left hs]
    exact R2.continuous.continuousAt.tendsto.comp (hG is hs)
  · intro is hs
    simp only [scalarRealSchwartzJet_re, scalarSchwartz_re_toLp, G4, dite_eq_left hs]
    exact R4.continuous.continuousAt.tendsto.comp (hG4 is hs)
  · intro is hs
    simp only [scalarRealSchwartzJet_re, scalarSchwartz_re_toLp, Gtop, dite_eq_left hs]
    exact Rt.continuous.continuousAt.tendsto.comp (hGtop is hs)
  · intro is hs
    have hs0 : is.length ≤ n := by omega
    simp only [G, G4, dite_eq_left hs, dite_eq_left hs0]
    filter_upwards [Complex.reCLM.coeFn_compLp (scalarBesselJetL2 n is hs0 v),
      Complex.reCLM.coeFn_compLp (scalarBesselJetL4 n is hs v), scalarBesselJetL4_coe n is hs v]
      with x h2 h4 he
    change Complex.reCLM.compLp (scalarBesselJetL2 n is hs0 v) x =
      Complex.reCLM.compLp (scalarBesselJetL4 n is hs v) x
    rw [h2, h4, he]
  · intro is hs
    have hs0 : is.length ≤ n := by omega
    simp only [G, Gtop, dite_eq_left hs, dite_eq_left hs0]
    have heq : (scalarBesselJetUniform n is hs v : V → ℂ) =ᵐ[volume]
        scalarBesselJetL2 n is hs0 v := scalarBesselJetUniform_coe n is hs v
    filter_upwards [Complex.reCLM.coeFn_compLp (scalarBesselJetL2 n is hs0 v),
      Complex.reCLM.coeFn_compLp (scalarBesselJetUniform n is hs v), heq]
      with x h2 ht he
    change Complex.reCLM.compLp (scalarBesselJetL2 n is hs0 v) x =
      Complex.reCLM.compLp (scalarBesselJetUniform n is hs v) x
    rw [h2, ht, he]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Strong subcritical convergence for bounded intrinsic H¹ sequences,
using the actual manifold L² compactness and the L²/L⁴ interpolation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

theorem scalar_subcritical_cauchy_of_L2 {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsProbabilityMeasure μ] {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (f : ℕ → Lp ℝ 4 μ) {B : ℝ} (hB : ∀ n, ‖f n‖ ≤ B)
    (h2 : CauchySeq (fun n => scalarL4ToLp μ 2 (by norm_num) (f n))) :
    CauchySeq (fun n => scalarL4ToLp μ (ENNReal.ofReal p)
      (by exact_mod_cast hp4.le) (f n)) := by
  let F : ℕ × ℕ → X → ℝ := fun nm x => f nm.1 x - f nm.2 x
  have hF (nm : ℕ × ℕ) : AEStronglyMeasurable (F nm) μ :=
    (Lp.aestronglyMeasurable (f nm.1)).sub (Lp.aestronglyMeasurable (f nm.2))
  have hfour (nm : ℕ × ℕ) : eLpNorm (F nm) 4 μ ≤ ENNReal.ofReal (2 * B) := by
    change eLpNorm ((f nm.1 : X → ℝ) - (f nm.2 : X → ℝ)) 4 μ ≤ _
    rw [← eLpNorm_congr_ae (Lp.coeFn_sub (f nm.1) (f nm.2)),
      ← Lp.enorm_def, ← ofReal_norm]
    apply ENNReal.ofReal_le_ofReal
    exact (norm_sub_le _ _).trans (by linarith [hB nm.1, hB nm.2])
  have htwo : Tendsto (fun nm => eLpNorm (F nm) 2 μ) atTop (𝓝 0) := by
    have h := ENNReal.continuous_ofReal.continuousAt.tendsto.comp
      (cauchySeq_iff_tendsto_dist_atTop_0.mp h2)
    simpa only [Function.comp_def, ENNReal.ofReal_zero, ← edist_dist,
      Lp.edist_def, scalarL4ToLp_coe, F, Pi.sub_def] using h
  have hnorm := scalar_subcritical_eLpNorm_tendsto_zero F hF hp hp4
    ENNReal.ofReal_ne_top hfour htwo
  have hreal := (ENNReal.continuousAt_toReal
    (by simp : (0 : ℝ≥0∞) ≠ (∞ : ℝ≥0∞))).tendsto.comp hnorm
  rw [ENNReal.toReal_zero] at hreal
  apply cauchySeq_iff_tendsto_dist_atTop_0.mpr
  convert hreal using 1
  funext nm
  rw [dist_eq_norm, Lp.norm_def,
    eLpNorm_congr_ae (Lp.coeFn_sub _ _)]
  rfl

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance subcriticalCompactness_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance subcriticalCompactness_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

/-- Every bounded intrinsic H¹ sequence has a strongly convergent actual
base Lp subsequence for 2 < p < 4. -/
theorem scalarH1_subcritical_subsequence (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (u : ℕ → scalarH1 d) {R : ℝ} (hu : ∀ n, ‖u n‖ ≤ R) :
    ∃ v : Lp ℝ (ENNReal.ofReal p) (normalizedVolume g),
      ∃ φ : ℕ → ℕ, StrictMono φ ∧
        Tendsto (fun n => scalarH1BaseLp g o d (ENNReal.ofReal p)
          (by exact_mod_cast hp4.le) (u (φ n))) atTop (𝓝 v) := by
  have hK := (scalarH1BaseValue_compact g o d).isCompact_closure_image_of_isVonNBounded
    (NormedSpace.isVonNBounded_closedBall ℝ (scalarH1 d) R)
  obtain ⟨v2, _, φ, hφ, hlim⟩ := hK.tendsto_subseq (fun n =>
    subset_closure ⟨u n, by simpa only [Metric.mem_closedBall, dist_zero_right] using hu n, rfl⟩)
  let f : ℕ → Lp ℝ 4 (normalizedVolume g) :=
    fun n => scalarH1BaseL4 g o d (u (φ n))
  have hf : ∀ n, ‖f n‖ ≤ ‖scalarH1BaseL4 g o d‖ * R := fun n =>
    ((scalarH1BaseL4 g o d).le_opNorm _).trans
      (mul_le_mul_of_nonneg_left (hu (φ n)) (norm_nonneg (scalarH1BaseL4 g o d)))
  have he (n : ℕ) : scalarL4ToLp (normalizedVolume g) 2 (by norm_num) (f n) =
      scalarH1BaseValue g o d (u (φ n)) := by
    apply Lp.ext
    exact scalarH1BaseL4_coe g o d (u (φ n))
  have h2 : CauchySeq (fun n => scalarL4ToLp (normalizedVolume g) 2 (by norm_num) (f n)) := by
    simp_rw [he]
    exact hlim.cauchySeq
  obtain ⟨v, hv⟩ := cauchySeq_tendsto_of_complete
    (scalar_subcritical_cauchy_of_L2 (normalizedVolume g) hp hp4 f hf h2)
  exact ⟨v, φ, hφ, hv⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Ordinary derivatives of local frame coefficients and their exact
relation to the actual covariant derivative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem TwoFormSmooth.gramTensor_contDiffAt {u : M → TwoFormFour} (hu : TwoFormSmooth o u)
    (c : M) (S : Mat4) (z : FourSpace) (hz : z ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (fun w => frameTensor (chartGramMatrix g c S w)
      (twoFormCoordinates o u c w)) z := by
  apply contDiffAt_pi.mpr
  intro a
  unfold frameTensor
  exact ContDiffAt.sum (fun b _ =>
    (contDiffAt_prod (fun k _ => chartGramMatrix_contDiffAt g c S z hz (b k) (a k))).mul
      (hu.coordinates_contDiffAt c z hz b))

theorem TwoFormSmooth.chartValue_contDiffAt {u : M → TwoFormFour} (hu : TwoFormSmooth o u)
    (c : M) (S : Mat4) (hS : Sᵀ * S = 1) (z : FourSpace)
    (hz : z ∈ (chartAt FourSpace c).target) :
    ContDiffAt ℝ ∞ (twoFormChartValue o u c S hS) z := by
  let L : CovariantCoordinates 2 →L[ℝ] TwoFormFour :=
    (twoFormExtractLinear.comp twoTensorMatrixLinear).toContinuousLinearMap
  have h := L.contDiff.comp_contDiffAt z (hu.gramTensor_contDiffAt c S z hz)
  apply h.congr_of_eventuallyEq
  filter_upwards [(chartAt FourSpace c).open_target.mem_nhds hz] with w hw
  exact twoFormChartValue_extract u c S hS w hw

theorem TwoFormSmooth.gramCovariantDirection {u : M → TwoFormFour} (hu : TwoFormSmooth o u)
    (c : M) (S : Mat4) (hS : Sᵀ * S = 1) (z : FourSpace)
    (hz : z ∈ (chartAt FourSpace c).target) (i : Fin 4) :
    frameTensor (chartGramMatrix g c S z)
      (tensorCovariantDirection (connectionMatrix g c) (twoFormCoordinates o u c) i z) =
      tensorPartial (fun w => frameTensor (chartGramMatrix g c S w)
        (twoFormCoordinates o u c w)) i z -
      tensorSlotAction (chartTwoFormConnection (g := g) c S i z)
        (frameTensor (chartGramMatrix g c S z) (twoFormCoordinates o u c z)) := by
  let G := chartGramMatrix g c S
  let T := twoFormCoordinates o u c
  have hG (r s : Fin 4) : DifferentiableAt ℝ (fun w => G w r s) z :=
    (chartGramMatrix_contDiffAt g c S z hz r s).differentiableAt (by simp)
  have hT (a : Fin 2 → Fin 4) : DifferentiableAt ℝ (fun w => T w a) z :=
    (hu.coordinates_contDiffAt c z hz a).differentiableAt (by simp)
  have hd := tensorPartial_frameTensor G T z hG hT i
  have hc := frameVariation_connection (G z) (matrixPartial G i z) (connectionMatrix g c i z)
    (chartTwoFormConnection (g := g) c S i z)
    (chartTwoFormConnection_equation c S hS i z hz) (T z)
  funext a
  have hda := congrFun hd a
  have hca := congrFun hc a
  change frameTensor (G z) (tensorPartial T i z - tensorSlotAction (connectionMatrix g c i z) (T z)) a =
    tensorPartial (fun w => frameTensor (G w) (T w)) i z a -
      tensorSlotAction (chartTwoFormConnection (g := g) c S i z) (frameTensor (G z) (T z)) a
  simp only [frameTensor_sub, Pi.add_apply] at hda hca ⊢
  linarith only [hda, hca]

theorem twoFormGramCutoffC1_partial (c : M) (S : Mat4) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) (u : SmoothH1TwoForm o)
    (i : Fin 4) (z : FourSpace) :
    partialDeriv (twoFormGramCutoffC1 c S hKt χ hχ hc hs a u).val i z =
      partialDeriv χ i z * frameTensor (chartGramMatrix g c S z)
        (twoFormCoordinates o (u : smoothTwoForms o).val c z) a +
      χ z * tensorPartial (fun w => frameTensor (chartGramMatrix g c S w)
        (twoFormCoordinates o (u : smoothTwoForms o).val c w)) i z a := by
  by_cases hz : z ∈ K
  · have hT := (u : smoothTwoForms o).property.gramTensor_contDiffAt c S z (hKt hz)
    have ha := (contDiffAt_pi.mp hT a).differentiableAt (by simp)
    have he : (twoFormGramCutoffC1 c S hKt χ hχ hc hs a u).val = fun w =>
        χ w * frameTensor (chartGramMatrix g c S w) (twoFormCoordinates o (u : smoothTwoForms o).val c w) a :=
      funext (twoFormGramCutoffC1_apply c S hKt χ hχ hc hs a u)
    rw [he]
    exact scalar_partial_product χ _ z (hχ.differentiable (by simp) z) ha i
  · have ht : z ∉ tsupport χ := fun h => hz (hs h)
    have hzero : χ z = 0 := image_eq_zero_of_notMem_tsupport ht
    have hder : partialDeriv χ i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => ht ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h))
    have hp : partialDeriv (twoFormGramCutoffC1 c S hKt χ hχ hc hs a u).val i z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hz
        (twoFormGramCutoffC1_support c S hKt χ hχ hc hs a u
          ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)) h)))
    rw [hp, hzero, hder, zero_mul, zero_mul, zero_add]

theorem twoFormGramCutoff_covariant (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    {K : Set FourSpace} (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) (u : SmoothH1TwoForm o)
    (i : Fin 4) (z : FourSpace) (hz : z ∈ (chartAt FourSpace c).target) :
    χ z * frameTensor (chartGramMatrix g c S z)
      (tensorCovariantDirection (connectionMatrix g c)
        (twoFormCoordinates o (u : smoothTwoForms o).val c) i z) a =
      partialDeriv (twoFormGramCutoffC1 c S hKt χ hχ hc hs a u).val i z -
      partialDeriv χ i z * frameTensor (chartGramMatrix g c S z)
        (twoFormCoordinates o (u : smoothTwoForms o).val c z) a -
      χ z * tensorSlotAction (chartTwoFormConnection (g := g) c S i z)
        (frameTensor (chartGramMatrix g c S z) (twoFormCoordinates o (u : smoothTwoForms o).val c z)) a := by
  have hD := twoFormGramCutoffC1_partial c S hKt χ hχ hc hs a u i z
  have hC := congrFun ((u : smoothTwoForms o).property.gramCovariantDirection c S hS z hz i) a
  simp only [Pi.sub_apply] at hC
  have hm := congrArg (fun r : ℝ => χ z * r) hC
  rw [mul_sub] at hm
  linarith only [hD, hm]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Orthonormal-frame coefficients of the actual H1 completion have
compact Euclidean H1 localizations. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped BigOperators Manifold ContDiff

noncomputable section

local instance : MeasurableSpace FourSpace := borel FourSpace
local instance : BorelSpace FourSpace := ⟨rfl⟩
local instance : MeasureSpace FourSpace := measureSpaceOfInnerProductSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormGramCutoffJet (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) :
    TwoFormH1 o →L[ℝ] Euclidean.H1Target (μ := (volume : Measure FourSpace)) :=
  ∑ b : Fin 2 → Fin 4,
    twoFormCutoffJet c hK hKt (twoFormGramCutoffWeight g c S χ v b)
      (twoFormGramCutoffWeight_smooth g c S hKt χ hχ hs v b)
      (twoFormGramCutoffWeight_compact g c S χ hc v b)
      ((twoFormGramCutoffWeight_support g c S χ v b).trans hs) b

theorem twoFormGramCutoffJet_smooth (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) :
    twoFormGramCutoffJet c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u) =
      Euclidean.graph (μ := (volume : Measure FourSpace))
        (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u) := by
  simp only [twoFormGramCutoffJet, sum_apply, twoFormCutoffJet_smooth,
    twoFormGramCutoffC1, LinearMap.sum_apply, map_sum]

theorem twoFormGramCutoffJet_mem (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : TwoFormH1 o) :
    twoFormGramCutoffJet c S hK hKt χ hχ hc hs v u ∈
      Euclidean.h1 (μ := (volume : Measure FourSpace)) := by
  change (∑ b : Fin 2 → Fin 4, twoFormCutoffJet c hK hKt
    (twoFormGramCutoffWeight g c S χ v b)
    (twoFormGramCutoffWeight_smooth g c S hKt χ hχ hs v b)
    (twoFormGramCutoffWeight_compact g c S χ hc v b)
    ((twoFormGramCutoffWeight_support g c S χ v b).trans hs) b u) ∈ _
  exact Submodule.sum_mem _ (fun b _ => twoFormCutoffJet_mem c hK hKt _ _ _ _ b u)

def twoFormGramCutoffH1 (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) :
    TwoFormH1 o →L[ℝ] ↥(Euclidean.h1 (μ := (volume : Measure FourSpace))) :=
  (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v).codRestrict _
    (twoFormGramCutoffJet_mem c S hK hKt χ hχ hc hs v)

theorem twoFormGramCutoffH1_supported (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : TwoFormH1 o) :
    twoFormGramCutoffH1 c S hK hKt χ hχ hc hs v u ∈
      Euclidean.h1On K hK.isClosed.measurableSet := by
  refine UniformSpace.Completion.induction_on u
    ((Euclidean.isClosed_range_extendByZero K hK.isClosed.measurableSet).preimage
      ((Euclidean.h1ToL2 (μ := (volume : Measure FourSpace))).comp
        (twoFormGramCutoffH1 c S hK hKt χ hχ hc hs v)).continuous) ?_
  intro w
  change (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 w)).1 ∈
    LinearMap.range ((Lp.extendByZeroₗᵢ (μ := (volume : Measure FourSpace))
      (E := ℝ) (p := 2) (s := K) hK.isClosed.measurableSet).toLinearMap)
  rw [twoFormGramCutoffJet_smooth]
  exact Euclidean.mem_range_extendByZeroₗᵢ_toLp_of_tsupport_subset
    (μ := (volume : Measure FourSpace)) hK.isClosed.measurableSet _
    (Euclidean.memLp_of_mem_C1c (μ := (volume : Measure FourSpace))
      (twoFormGramCutoffC1 c S hKt χ hχ hc hs v w).property)
    (twoFormGramCutoffC1_support c S hKt χ hχ hc hs v w)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Lower-order coefficients contributed by the normal-frame connection. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

def fourHeatConnectionFirst (a : Mat4) (A : Fin 4 → HeatMat6) (i : Fin 4) : HeatMat6 :=
  (-2 : ℝ) • ∑ j : Fin 4, a i j • A j

def fourHeatConnectionZero (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → HeatMat6) (V : HeatMat6) (x : FourSpace) : HeatMat6 :=
  V + (∑ i : Fin 4, b i • A i x) -
    ∑ i : Fin 4, ∑ j : Fin 4, a i j •
      ((Matrix.of fun k l => partialDeriv (fun y => A i y k l) j x) + A j x * A i x)

theorem fourHeatConnectionFirst_radial (a : Mat4) (A : Fin 4 → HeatMat6)
    (x : FourSpace) (ha : ∀ j, (∑ i : Fin 4, a i j * x i) = x j)
    (hA : (∑ i : Fin 4, x i • A i) = 0) :
    (∑ i : Fin 4, x i • fourHeatConnectionFirst a A i) = 0 := by
  ext k l
  have hAl : (∑ j : Fin 4, x j * A j k l) = 0 := by
    simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply]
      using congrArg (fun T : HeatMat6 => T k l) hA
  change (∑ i : Fin 4, x i * ((-2 : ℝ) * ∑ j : Fin 4, a i j * A j k l)) = 0
  calc
    _ = (-2 : ℝ) * ∑ j : Fin 4, (∑ i : Fin 4, a i j * x i) * A j k l := by
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = 0 := by simp_rw [ha]; rw [hAl]; ring

theorem fourHeatConnectionFirst_contDiffAt (n : ℕ) (a : FourSpace → Mat4)
    (A : Fin 4 → FourSpace → HeatMat6) (x : FourSpace)
    (ha : ∀ i j, ContDiffAt ℝ n (fun y => a y i j) x)
    (hA : ∀ i k l, ContDiffAt ℝ n (fun y => A i y k l) x)
    (i : Fin 4) (k l : Fin 6) :
    ContDiffAt ℝ n (fun y => fourHeatConnectionFirst (a y) (fun j => A j y) i k l) x := by
  change ContDiffAt ℝ n (fun y => (-2 : ℝ) * ∑ j : Fin 4, a y i j * A j y k l) x
  exact contDiffAt_const.mul (ContDiffAt.sum (fun j _ => (ha i j).mul (hA j k l)))

theorem fourHeatConnectionZero_contDiffAt (n : ℕ) (a : FourSpace → Mat4)
    (b : FourSpace → Fin 4 → ℝ) (A : Fin 4 → FourSpace → HeatMat6)
    (V : FourSpace → HeatMat6) (x : FourSpace)
    (ha : ∀ i j, ContDiffAt ℝ n (fun y => a y i j) x)
    (hb : ∀ i, ContDiffAt ℝ n (fun y => b y i) x)
    (hA : ∀ i k l, ContDiffAt ℝ (n + 1) (fun y => A i y k l) x)
    (hV : ∀ k l, ContDiffAt ℝ n (fun y => V y k l) x) (k l : Fin 6) :
    ContDiffAt ℝ n (fun y => fourHeatConnectionZero (a y) (b y) A (V y) y k l) x := by
  have hA0 (i : Fin 4) (k l : Fin 6) : ContDiffAt ℝ n (fun y => A i y k l) x :=
    (hA i k l).of_le (by exact_mod_cast Nat.le_succ n)
  have hD (i j : Fin 4) (k l : Fin 6) :
      ContDiffAt ℝ n (partialDeriv (fun y => A i y k l) j) x :=
    ((hA i k l).fderiv_right (m := n) (by norm_num [Nat.cast_add])).clm_apply contDiffAt_const
  change ContDiffAt ℝ n (fun y => V y k l +
    (∑ i : Fin 4, b y i * A i y k l) - ∑ i : Fin 4, ∑ j : Fin 4,
      a y i j * (partialDeriv (fun z => A i z k l) j y +
        ∑ q : Fin 6, A j y k q * A i y q l)) x
  apply ((hV k l).add (ContDiffAt.sum (fun i _ => (hb i).mul (hA0 i k l)))).sub
  apply ContDiffAt.sum
  intro i _
  apply ContDiffAt.sum
  intro j _
  exact (ha i j).mul ((hD i j k l).add
    (ContDiffAt.sum (fun q _ => (hA0 j k q).mul (hA0 i q l))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar cutoff commutator for the local heat operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatLocalOperator_cutoff (a : Mat4) (b : Fin 4 → ℝ)
    (f u : FourSpace → ℝ) (x : FourSpace)
    (ha : ∀ i j, a i j = a j i) (hf : ContDiffAt ℝ 2 f x) (hu : ContDiffAt ℝ 2 u x) :
    fourHeatLocalOperator a b 0 (fun y => f y * u y) x =
      f x * fourHeatLocalOperator a b 0 u x +
      fourHeatLocalOperator a b 0 f x * u x -
      2 * ∑ i, ∑ j, a i j * partialDeriv f i x * partialDeriv u j x := by
  have hswap : (∑ i, ∑ j, a i j * partialDeriv f j x * partialDeriv u i x) =
      ∑ i, ∑ j, a i j * partialDeriv f i x * partialDeriv u j x := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [ha j i]
  have hsecond : (∑ i, ∑ j, a i j *
      partialDeriv (partialDeriv (fun y => f y * u y) i) j x) =
      u x * (∑ i, ∑ j, a i j * partialDeriv (partialDeriv f i) j x) +
      2 * (∑ i, ∑ j, a i j * partialDeriv f i x * partialDeriv u j x) +
      f x * (∑ i, ∑ j, a i j * partialDeriv (partialDeriv u i) j x) := by
    simp_rw [scalar_partial_second_product_at f u x hf hu]
    have he (i j : Fin 4) : a i j *
        (partialDeriv (partialDeriv f i) j x * u x +
          partialDeriv f i x * partialDeriv u j x + partialDeriv f j x * partialDeriv u i x +
          f x * partialDeriv (partialDeriv u i) j x) =
        u x * (a i j * partialDeriv (partialDeriv f i) j x) +
          a i j * partialDeriv f i x * partialDeriv u j x +
          a i j * partialDeriv f j x * partialDeriv u i x +
          f x * (a i j * partialDeriv (partialDeriv u i) j x) := by ring
    simp_rw [he, Finset.sum_add_distrib, ← Finset.mul_sum]
    rw [hswap]
    ring
  have hfirst : (∑ i, b i * partialDeriv (fun y => f y * u y) i x) =
      u x * (∑ i, b i * partialDeriv f i x) + f x * (∑ i, b i * partialDeriv u i x) := by
    simp_rw [scalar_partial_product f u x (hf.differentiableAt (by norm_num))
      (hu.differentiableAt (by norm_num))]
    have he (i : Fin 4) : b i * (partialDeriv f i x * u x + f x * partialDeriv u i x) =
        u x * (b i * partialDeriv f i x) + f x * (b i * partialDeriv u i x) := by ring
    simp_rw [he, Finset.sum_add_distrib, ← Finset.mul_sum]
  unfold fourHeatLocalOperator
  rw [hsecond, hfirst]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Joint continuity of the actual coefficient operator applied to a C2 family. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter
open scoped ContDiff BigOperators

noncomputable section

theorem fourHeatBundleOperator_joint_continuousAt
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → HeatMat6) (C : FourSpace → HeatMat6)
    (F : ℝ × FourSpace → Fin 6 → ℝ) (z : ℝ × FourSpace)
    (ha : ∀ i j, ContinuousAt (fun x => a x i j) z.2)
    (hb : ∀ i, ContinuousAt (fun x => b x i) z.2)
    (hB : ∀ i k l, ContinuousAt (fun x => B x i k l) z.2)
    (hC : ∀ k l, ContinuousAt (fun x => C x k l) z.2)
    (hF : ∀ k, ContDiffAt ℝ 2 (fun w => F w k) z) (k : Fin 6) :
    ContinuousAt (fun w : ℝ × FourSpace =>
      fourHeatBundleOperator (a w.2) (b w.2) (B w.2) (C w.2)
        (fun x => F (w.1, x)) w.2 k) z := by
  have h1 (i : Fin 4) (l : Fin 6) :=
    (fourHeat_slice_partial_contDiffAt (fun w => F w l) z (hF l) i).continuousAt
  have h2 (i j : Fin 4) (l : Fin 6) :=
    fourHeat_slice_second_continuousAt (fun w => F w l) z (hF l) i j
  have hA (i j : Fin 4) : ContinuousAt (fun w : ℝ × FourSpace => a w.2 i j) z :=
    (ha i j).comp continuousAt_snd
  have hbb (i : Fin 4) : ContinuousAt (fun w : ℝ × FourSpace => b w.2 i) z :=
    (hb i).comp continuousAt_snd
  have hBB (i : Fin 4) (l : Fin 6) :
      ContinuousAt (fun w : ℝ × FourSpace => B w.2 i k l) z :=
    (hB i k l).comp continuousAt_snd
  have hCC (l : Fin 6) : ContinuousAt (fun w : ℝ × FourSpace => C w.2 k l) z :=
    (hC k l).comp continuousAt_snd
  have hS : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4, ∑ j : Fin 4,
      a w.2 i j * partialDeriv (partialDeriv (fun x => F (w.1, x) k) i) j w.2) z :=
    tendsto_finsetSum _ (fun i _ => tendsto_finsetSum _ (fun j _ => (hA i j).mul (h2 i j k)))
  have hT : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4,
      b w.2 i * partialDeriv (fun x => F (w.1, x) k) i w.2) z :=
    tendsto_finsetSum _ (fun i _ => (hbb i).mul (h1 i k))
  have hU : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4, ∑ l : Fin 6,
      B w.2 i k l * partialDeriv (fun x => F (w.1, x) l) i w.2) z :=
    tendsto_finsetSum _ (fun i _ => tendsto_finsetSum _ (fun l _ => (hBB i l).mul (h1 i l)))
  have hV : ContinuousAt (fun w : ℝ × FourSpace => ∑ l : Fin 6,
      C w.2 k l * F w l) z :=
    tendsto_finsetSum _ (fun l _ => (hCC l).mul (hF l).continuousAt)
  exact (((hS.neg.add hT).add (continuousAt_const.mul (hF k).continuousAt)).add hU).add hV

end
end PositiveEinsteinFour.Geometry
end


section

/-! Lower-order coefficients contributed by the normal-frame connection. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

def fourHeatOneConnectionFirst (a : Mat4) (A : Fin 4 → Mat4) (i : Fin 4) : Mat4 :=
  (-2 : ℝ) • ∑ j : Fin 4, a i j • A j

def fourHeatOneConnectionZero (a : Mat4) (b : Fin 4 → ℝ)
    (A : Fin 4 → FourSpace → Mat4) (V : Mat4) (x : FourSpace) : Mat4 :=
  V + (∑ i : Fin 4, b i • A i x) -
    ∑ i : Fin 4, ∑ j : Fin 4, a i j •
      ((Matrix.of fun k l => partialDeriv (fun y => A i y k l) j x) + A j x * A i x)

theorem fourHeatOneConnectionFirst_radial (a : Mat4) (A : Fin 4 → Mat4)
    (x : FourSpace) (ha : ∀ j, (∑ i : Fin 4, a i j * x i) = x j)
    (hA : (∑ i : Fin 4, x i • A i) = 0) :
    (∑ i : Fin 4, x i • fourHeatOneConnectionFirst a A i) = 0 := by
  ext k l
  have hAl : (∑ j : Fin 4, x j * A j k l) = 0 := by
    simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply]
      using congrArg (fun T : Mat4 => T k l) hA
  change (∑ i : Fin 4, x i * ((-2 : ℝ) * ∑ j : Fin 4, a i j * A j k l)) = 0
  calc
    _ = (-2 : ℝ) * ∑ j : Fin 4, (∑ i : Fin 4, a i j * x i) * A j k l := by
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = 0 := by simp_rw [ha]; rw [hAl]; ring

theorem fourHeatOneConnectionFirst_contDiffAt (n : ℕ) (a : FourSpace → Mat4)
    (A : Fin 4 → FourSpace → Mat4) (x : FourSpace)
    (ha : ∀ i j, ContDiffAt ℝ n (fun y => a y i j) x)
    (hA : ∀ i k l, ContDiffAt ℝ n (fun y => A i y k l) x)
    (i : Fin 4) (k l : Fin 4) :
    ContDiffAt ℝ n (fun y => fourHeatOneConnectionFirst (a y) (fun j => A j y) i k l) x := by
  change ContDiffAt ℝ n (fun y => (-2 : ℝ) * ∑ j : Fin 4, a y i j * A j y k l) x
  exact contDiffAt_const.mul (ContDiffAt.sum (fun j _ => (ha i j).mul (hA j k l)))

theorem fourHeatOneConnectionZero_contDiffAt (n : ℕ) (a : FourSpace → Mat4)
    (b : FourSpace → Fin 4 → ℝ) (A : Fin 4 → FourSpace → Mat4)
    (V : FourSpace → Mat4) (x : FourSpace)
    (ha : ∀ i j, ContDiffAt ℝ n (fun y => a y i j) x)
    (hb : ∀ i, ContDiffAt ℝ n (fun y => b y i) x)
    (hA : ∀ i k l, ContDiffAt ℝ (n + 1) (fun y => A i y k l) x)
    (hV : ∀ k l, ContDiffAt ℝ n (fun y => V y k l) x) (k l : Fin 4) :
    ContDiffAt ℝ n (fun y => fourHeatOneConnectionZero (a y) (b y) A (V y) y k l) x := by
  have hA0 (i : Fin 4) (k l : Fin 4) : ContDiffAt ℝ n (fun y => A i y k l) x :=
    (hA i k l).of_le (by exact_mod_cast Nat.le_succ n)
  have hD (i j : Fin 4) (k l : Fin 4) :
      ContDiffAt ℝ n (partialDeriv (fun y => A i y k l) j) x :=
    ((hA i k l).fderiv_right (m := n) (by norm_num [Nat.cast_add])).clm_apply contDiffAt_const
  change ContDiffAt ℝ n (fun y => V y k l +
    (∑ i : Fin 4, b y i * A i y k l) - ∑ i : Fin 4, ∑ j : Fin 4,
      a y i j * (partialDeriv (fun z => A i z k l) j y +
        ∑ q : Fin 4, A j y k q * A i y q l)) x
  apply ((hV k l).add (ContDiffAt.sum (fun i _ => (hb i).mul (hA0 i k l)))).sub
  apply ContDiffAt.sum
  intro i _
  apply ContDiffAt.sum
  intro j _
  exact (ha i j).mul ((hD i j k l).add
    (ContDiffAt.sum (fun q _ => (hA0 j k q).mul (hA0 i q l))))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Joint continuity of the actual coefficient operator applied to a C2 family. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Filter
open scoped ContDiff BigOperators

noncomputable section

theorem fourHeatOneOperator_joint_continuousAt
    (a : FourSpace → Mat4) (b : FourSpace → Fin 4 → ℝ)
    (B : FourSpace → Fin 4 → Mat4) (C : FourSpace → Mat4)
    (F : ℝ × FourSpace → Fin 4 → ℝ) (z : ℝ × FourSpace)
    (ha : ∀ i j, ContinuousAt (fun x => a x i j) z.2)
    (hb : ∀ i, ContinuousAt (fun x => b x i) z.2)
    (hB : ∀ i k l, ContinuousAt (fun x => B x i k l) z.2)
    (hC : ∀ k l, ContinuousAt (fun x => C x k l) z.2)
    (hF : ∀ k, ContDiffAt ℝ 2 (fun w => F w k) z) (k : Fin 4) :
    ContinuousAt (fun w : ℝ × FourSpace =>
      fourHeatOneOperator (a w.2) (b w.2) (B w.2) (C w.2)
        (fun x => F (w.1, x)) w.2 k) z := by
  have h1 (i : Fin 4) (l : Fin 4) :=
    (fourHeat_slice_partial_contDiffAt (fun w => F w l) z (hF l) i).continuousAt
  have h2 (i j : Fin 4) (l : Fin 4) :=
    fourHeat_slice_second_continuousAt (fun w => F w l) z (hF l) i j
  have hA (i j : Fin 4) : ContinuousAt (fun w : ℝ × FourSpace => a w.2 i j) z :=
    (ha i j).comp continuousAt_snd
  have hbb (i : Fin 4) : ContinuousAt (fun w : ℝ × FourSpace => b w.2 i) z :=
    (hb i).comp continuousAt_snd
  have hBB (i : Fin 4) (l : Fin 4) :
      ContinuousAt (fun w : ℝ × FourSpace => B w.2 i k l) z :=
    (hB i k l).comp continuousAt_snd
  have hCC (l : Fin 4) : ContinuousAt (fun w : ℝ × FourSpace => C w.2 k l) z :=
    (hC k l).comp continuousAt_snd
  have hS : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4, ∑ j : Fin 4,
      a w.2 i j * partialDeriv (partialDeriv (fun x => F (w.1, x) k) i) j w.2) z :=
    tendsto_finsetSum _ (fun i _ => tendsto_finsetSum _ (fun j _ => (hA i j).mul (h2 i j k)))
  have hT : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4,
      b w.2 i * partialDeriv (fun x => F (w.1, x) k) i w.2) z :=
    tendsto_finsetSum _ (fun i _ => (hbb i).mul (h1 i k))
  have hU : ContinuousAt (fun w : ℝ × FourSpace => ∑ i : Fin 4, ∑ l : Fin 4,
      B w.2 i k l * partialDeriv (fun x => F (w.1, x) l) i w.2) z :=
    tendsto_finsetSum _ (fun i _ => tendsto_finsetSum _ (fun l _ => (hBB i l).mul (h1 i l)))
  have hV : ContinuousAt (fun w : ℝ × FourSpace => ∑ l : Fin 4,
      C w.2 k l * F w l) z :=
    tendsto_finsetSum _ (fun l _ => (hCC l).mul (hF l).continuousAt)
  apply (((hS.neg.add hT).add hU).add hV).congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun w => by
    rcases w with ⟨s, x⟩
    simp only [fourHeatOneOperator, fourHeatLocalOperator, fourHeatOneFirst, fourHeatOneZero,
      zero_mul, add_zero, Pi.add_apply, Pi.neg_apply]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Regularity of the radial transport solver, obtained by differentiating
its actual integral and reconstructing the derivative from four coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped ContDiff BigOperators Interval

noncomputable section

private theorem fourLinearForm_expansion (L : FourSpace →L[ℝ] ℝ) :
    L = ∑ i : Fin 4, L (coordinateVector i) • PiLp.proj 2 (fun _ : Fin 4 => ℝ) i := by
  apply ContinuousLinearMap.ext
  intro v
  have hv : v = ∑ i : Fin 4, v i • coordinateVector i := by
    simpa only [WithLp.toLp_ofLp] using (sum_coordinateVector (WithLp.ofLp v)).symm
  have hLv := congrArg L hv
  rw [map_sum] at hLv
  simp only [map_smul, smul_eq_mul] at hLv
  rw [hLv]
  simp only [_root_.sum_apply, _root_.smul_apply, PiLp.proj_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  ring

theorem fourHeatRadialAverage_partial (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (x : FourSpace) (i : Fin 4) :
    partialDeriv (fourHeatRadialAverage m f) i x =
      fourHeatRadialAverage (m + 1) (partialDeriv f i) x := by
  have hD : Continuous (fourHeatRadialAverageDerivative m f x) :=
    (fourHeatRadialAverageDerivative_continuous m f hf).comp
      (continuous_const.prodMk continuous_id)
  rw [partialDeriv, (fourHeatRadialAverage_hasFDerivAt m f hf x).fderiv,
    ContinuousLinearMap.intervalIntegral_apply (hD.intervalIntegrable 0 1)]
  simp only [fourHeatRadialAverageDerivative, _root_.smul_apply, smul_eq_mul,
    fourHeatRadialAverage, partialDeriv]

theorem fourHeatRadialAverage_fderiv (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (x : FourSpace) :
    fderiv ℝ (fourHeatRadialAverage m f) x =
      ∑ i : Fin 4, fourHeatRadialAverage (m + 1) (partialDeriv f i) x •
        PiLp.proj 2 (fun _ : Fin 4 => ℝ) i := by
  conv_lhs => rw [fourLinearForm_expansion (fderiv ℝ (fourHeatRadialAverage m f) x)]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  exact fourHeatRadialAverage_partial m f hf x i

theorem fourHeatRadialAverage_contDiff (n : ℕ) :
    ∀ (m : ℕ) (f : FourSpace → ℝ), ContDiff ℝ (n + 1 : ℕ) f →
      ContDiff ℝ n (fourHeatRadialAverage m f) := by
  induction n with
  | zero =>
    intro m f hf
    apply contDiff_zero.mpr
    have hd : Differentiable ℝ (fourHeatRadialAverage m f) :=
      fun x => (fourHeatRadialAverage_hasFDerivAt m f hf x).differentiableAt
    exact hd.continuous
  | succ n ih =>
    intro m f hf
    have hf1 : ContDiff ℝ 1 f := hf.of_le (by exact_mod_cast Nat.le_add_left 1 (n + 1))
    have hpartial (i : Fin 4) : ContDiff ℝ (n + 1 : ℕ) (partialDeriv f i) :=
      (hf.fderiv_right (m := (n + 1 : ℕ)) (by norm_num [Nat.cast_add, add_assoc])).clm_apply
        (contDiff_const (c := coordinateVector i))
    let D : FourSpace → FourSpace →L[ℝ] ℝ := fun x =>
      ∑ i : Fin 4, fourHeatRadialAverage (m + 1) (partialDeriv f i) x •
        PiLp.proj 2 (fun _ : Fin 4 => ℝ) i
    have hD : ContDiff ℝ n D := by
      apply ContDiff.sum
      intro i _
      exact (ih (m + 1) (partialDeriv f i) (hpartial i)).smul contDiff_const
    apply contDiff_succ_iff_hasFDerivAt.mpr
    refine ⟨D, hD, ?_⟩
    intro x
    have h := (fourHeatRadialAverage_hasFDerivAt m f hf1 x).differentiableAt.hasFDerivAt
    rwa [fourHeatRadialAverage_fderiv m f hf1 x] at h

theorem fourHeatRadialAverage_smooth (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ ∞ f) : ContDiff ℝ ∞ (fourHeatRadialAverage m f) :=
  contDiff_infty.mpr (fun n => fourHeatRadialAverage_contDiff n m f (hf.of_le (by simp)))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The regular radial average solves the successive transport equation,
with its coefficient at the origin fixed by the source. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped ContDiff Interval

noncomputable section

theorem fourHeatRadialAverage_zero (m : ℕ) (f : FourSpace → ℝ) :
    fourHeatRadialAverage m f 0 = f 0 / (m + 1 : ℝ) := by
  unfold fourHeatRadialAverage
  simp only [smul_zero]
  rw [intervalIntegral.integral_mul_const, integral_pow]
  simp only [one_pow, zero_pow (Nat.succ_ne_zero m), sub_zero]
  ring

theorem fourHeatRadialAverage_transport (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (x : FourSpace) :
    fderiv ℝ (fourHeatRadialAverage m f) x x +
      (m + 1 : ℝ) * fourHeatRadialAverage m f x = f x := by
  let P : ℝ → ℝ := fun s => s ^ (m + 1) * f (s • x)
  have hpath : ContDiff ℝ 1 P :=
    (contDiff_id.pow (m + 1)).mul
      (hf.comp (contDiff_id.smul (contDiff_const (c := x))))
  have hderiv (s : ℝ) : deriv P s =
      (m + 1 : ℝ) * (s ^ m * f (s • x)) +
        fourHeatRadialAverageDerivative m f x s x := by
    have hs : HasDerivAt (fun t : ℝ => t • x) x s := by
      have h := (ContinuousLinearMap.toSpanSingleton ℝ x).hasFDerivAt.comp_hasDerivAt
        s (hasDerivAt_id s)
      simpa only [ContinuousLinearMap.toSpanSingleton_apply, one_smul, Function.comp_def,
        id_eq] using! h
    have hc := ((hf.differentiable one_ne_zero).differentiableAt.hasFDerivAt).comp_hasDerivAt s hs
    have hd := ((hasDerivAt_pow (m + 1) s).mul hc).deriv
    change deriv P s = _ at hd
    rw [hd]
    simp only [fourHeatRadialAverageDerivative, _root_.smul_apply, smul_eq_mul,
      Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one, Function.comp_def]
    ring
  have hD : Continuous (fourHeatRadialAverageDerivative m f x) :=
    (fourHeatRadialAverageDerivative_continuous m f hf).comp
      (continuous_const.prodMk continuous_id)
  have hF : Continuous (fun s : ℝ => s ^ m * f (s • x)) :=
    (continuous_id.pow m).mul (hf.continuous.comp (continuous_id.smul continuous_const))
  have hI := intervalIntegral.integral_deriv_of_contDiffOn_Icc hpath.contDiffOn
    (by norm_num : (0 : ℝ) ≤ 1)
  simp_rw [hderiv] at hI
  rw [intervalIntegral.integral_add
    ((hF.const_mul _).intervalIntegrable 0 1)
    ((hD.clm_apply continuous_const).intervalIntegrable 0 1),
    intervalIntegral.integral_const_mul,
    ← ContinuousLinearMap.intervalIntegral_apply (hD.intervalIntegrable 0 1) x] at hI
  have hP1 : P 1 = f x := by simp [P]
  have hP0 : P 0 = 0 := by simp [P]
  rw [hP1, hP0, sub_zero] at hI
  rw [(fourHeatRadialAverage_hasFDerivAt m f hf x).fderiv]
  exact (add_comm _ _).trans hI

end
end PositiveEinsteinFour.Geometry
end


section

/-! The density divergence coefficient is the contracted torsion-free
metric connection, with no coordinate or curvature assumption. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff Matrix.Norms.Elementwise

noncomputable section

theorem heatCompatibleDrift_algebra (H : Mat4) (C : Fin 4 → Mat4) (ρ : ℝ)
    (hρ : ρ ≠ 0) (hC : ∀ i j r, C i r j = C j r i) (j : Fin 4) :
    -((∑ i, (-(∑ k, C i i k * H k j) - ∑ k, H i k * C i j k)) +
      ρ⁻¹ * ∑ i, H i j * ((C i).trace * ρ)) =
      ∑ i, ∑ k, H i k * C i j k := by
  have ht : (∑ i, H i j * (C i).trace) = ∑ i, ∑ k, C i i k * H k j := by
    simp only [Matrix.trace, Matrix.diag_apply, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro k _
    rw [hC k i i]
    ring
  have hp : ρ⁻¹ * (∑ i, H i j * ((C i).trace * ρ)) =
      ∑ i, ∑ k, C i i k * H k j := by
    calc
      _ = ρ⁻¹ * ((∑ i, H i j * (C i).trace) * ρ) := by
        simp only [Finset.sum_mul, mul_assoc]
      _ = ∑ i, H i j * (C i).trace := by field_simp
      _ = _ := ht
  rw [hp]
  simp only [Finset.sum_sub_distrib, Finset.sum_neg_distrib]
  ring

theorem heatCompatibleMetric_drift (G : FourSpace → Mat4) (x : FourSpace)
    (hG : ∀ p q, ContDiffAt ℝ 1 (fun y => G y p q) x)
    (hpos : 0 < (G x).det) (C : Fin 4 → Mat4)
    (hcompat : ∀ i, matrixPartial G i x = (C i)ᵀ * G x + G x * C i)
    (htorsion : ∀ i j r, C i r j = C j r i) (j : Fin 4) :
    fourHeatDensityDrift (fun y => (G y)⁻¹) (fun y => Real.sqrt (G y).det) x j =
      ∑ i, ∑ k, (G x)⁻¹ i k * C i j k := by
  have hInv (i : Fin 4) : partialDeriv (fun y => (G y)⁻¹ i j) i x =
      -(∑ k, C i i k * (G x)⁻¹ k j) - ∑ k, (G x)⁻¹ i k * C i j k := by
    have h := congrArg (fun A : Mat4 => A i j)
      (heatCompatibleMetric_inverse G x hG hpos.ne' (C i) i (hcompat i))
    simpa only [matrixPartial, Matrix.sub_apply, Matrix.neg_apply,
      Matrix.mul_apply, Matrix.transpose_apply] using h
  have hρ (i : Fin 4) := heatCompatibleMetric_density G x hG hpos (C i) i (hcompat i)
  simp only [fourHeatDensityDrift, hInv, hρ]
  exact heatCompatibleDrift_algebra _ C _ (Real.sqrt_pos.mpr hpos).ne' htorsion j

end
end PositiveEinsteinFour.Geometry
end


section

/-! Radial transport with the center and initial frame as parameters.
Only the normal vector is scaled inside the transport integral. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter Metric
open scoped ContDiff _root_.Topology Interval Matrix.Norms.Elementwise

noncomputable section

local instance heatFamilyRadialDualNormedGroup :
    NormedAddCommGroup (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup

local instance heatFamilyRadialDualNormedSpace :
    NormedSpace ℝ (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedSpace

local instance heatFamilyRadialDualPseudoMetrizable :
    TopologicalSpace.PseudoMetrizableSpace (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  PseudoEMetricSpace.pseudoMetrizableSpace

local instance heatFamilyRadialDualCountableEither :
    SecondCountableTopologyEither ℝ (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  ⟨Or.inl inferInstance⟩

def heatFamilyScaleLinear (s : ℝ) : HeatRadialFrameSpace →L[ℝ] HeatRadialFrameSpace :=
  (s • ContinuousLinearMap.id ℝ FourSpace).prodMap
    (ContinuousLinearMap.id ℝ CoordinateFrameSpace)

theorem heatFamilyScaleLinear_apply (s : ℝ) (z : HeatRadialFrameSpace) :
    heatFamilyScaleLinear s z = (s • z.1, z.2) := rfl

theorem heatFamilyScaleLinear_continuous : Continuous heatFamilyScaleLinear := by
  exact Continuous.prod_mapL ℝ
    (continuous_id.smul (continuous_const (y := ContinuousLinearMap.id ℝ FourSpace)))
    (continuous_const (y := ContinuousLinearMap.id ℝ CoordinateFrameSpace))

def heatFamilyRadialAverage (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (z : HeatRadialFrameSpace) : ℝ :=
  ∫ s : ℝ in 0..1, s ^ m * f (heatFamilyScaleLinear s z)

theorem heatFamilyRadialAverage_slice (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (z : HeatRadialFrameSpace) :
    heatFamilyRadialAverage m f z = fourHeatRadialAverage m (fun x => f (x, z.2)) z.1 := rfl

theorem heatFamilyRadialAverage_continuous (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (hf : Continuous f) : Continuous (heatFamilyRadialAverage m f) := by
  have hc : Continuous (Function.uncurry (fun z : HeatRadialFrameSpace => fun s : ℝ =>
      s ^ m * f (heatFamilyScaleLinear s z))) :=
    (continuous_snd.pow m).mul (hf.comp
      ((heatFamilyScaleLinear_continuous.comp continuous_snd).clm_apply continuous_fst))
  exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hc 0 1

def heatFamilyRadialDerivative (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (z : HeatRadialFrameSpace) (s : ℝ) : HeatRadialFrameSpace →L[ℝ] ℝ :=
  s ^ m • (fderiv ℝ f (heatFamilyScaleLinear s z)).comp (heatFamilyScaleLinear s)

theorem heatFamilyRadialDerivative_continuous (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (hf : ContDiff ℝ 1 f) :
    Continuous (fun p : ℝ × HeatRadialFrameSpace => heatFamilyRadialDerivative m f p.2 p.1) := by
  have hs := heatFamilyScaleLinear_continuous.comp (continuous_fst : Continuous
    (Prod.fst : ℝ × HeatRadialFrameSpace → ℝ))
  exact (continuous_fst.pow m).smul
    (((hf.continuous_fderiv one_ne_zero).comp (hs.clm_apply continuous_snd)).clm_comp hs)

theorem heatFamilyRadialAverage_hasFDerivAt (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (z : HeatRadialFrameSpace) :
    HasFDerivAt (heatFamilyRadialAverage m f)
      (∫ s : ℝ in 0..1, heatFamilyRadialDerivative m f z s) z := by
  have hD := heatFamilyRadialDerivative_continuous m f hf
  obtain ⟨C, hC⟩ := ((isCompact_Icc : IsCompact (Icc (0 : ℝ) 1)).prod
    (isCompact_closedBall z 1)).exists_bound_of_continuousOn
    hD.continuousOn
  have hF (y : HeatRadialFrameSpace) : Continuous
      (fun s : ℝ => s ^ m * f (heatFamilyScaleLinear s y)) :=
    (continuous_id.pow m).mul (hf.continuous.comp
      (heatFamilyScaleLinear_continuous.clm_apply continuous_const))
  have hDy : Continuous (heatFamilyRadialDerivative m f z) :=
    hD.comp (continuous_id.prodMk continuous_const)
  apply intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F := fun y s => s ^ m * f (heatFamilyScaleLinear s y))
    (F' := heatFamilyRadialDerivative m f) (bound := fun _ => C)
    (ball_mem_nhds z one_pos)
    (Eventually.of_forall fun y => (hF y).aestronglyMeasurable)
    ((hF z).intervalIntegrable 0 1) hDy.aestronglyMeasurable
    (Eventually.of_forall fun s hs y hy => ?_)
    (continuous_const.intervalIntegrable 0 1)
    (Eventually.of_forall fun s _ y _ => ?_)
  · apply hC (s, y)
    rw [uIoc_of_le zero_le_one] at hs
    exact ⟨⟨hs.1.le, hs.2⟩, ball_subset_closedBall hy⟩
  · exact ((hf.differentiable one_ne_zero (heatFamilyScaleLinear s y)).hasFDerivAt.comp y
      (heatFamilyScaleLinear s).hasFDerivAt).const_mul (s ^ m)

theorem heatFamilyRadialAverage_fderiv_apply (m : ℕ) (f : HeatRadialFrameSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (z w : HeatRadialFrameSpace) :
    fderiv ℝ (heatFamilyRadialAverage m f) z w =
      heatFamilyRadialAverage (m + 1) (fun y => fderiv ℝ f y (w.1, 0)) z +
      heatFamilyRadialAverage m (fun y => fderiv ℝ f y (0, w.2)) z := by
  have hD : Continuous (heatFamilyRadialDerivative m f z) :=
    (heatFamilyRadialDerivative_continuous m f hf).comp
    (continuous_id.prodMk (continuous_const (y := z)))
  have hG (v : HeatRadialFrameSpace) (n : ℕ) : Continuous (fun s : ℝ =>
      s ^ n * fderiv ℝ f (heatFamilyScaleLinear s z) v) :=
    (continuous_id.pow n).mul (((hf.continuous_fderiv one_ne_zero).comp
      (heatFamilyScaleLinear_continuous.clm_apply continuous_const)).clm_apply continuous_const)
  have heval : (∫ s : ℝ in 0..1, heatFamilyRadialDerivative m f z s) w =
      ∫ s : ℝ in 0..1, heatFamilyRadialDerivative m f z s w :=
    ContinuousLinearMap.intervalIntegral_apply (hD.intervalIntegrable 0 1) w
  rw [(heatFamilyRadialAverage_hasFDerivAt m f hf z).fderiv, heval]
  unfold heatFamilyRadialAverage
  rw [← intervalIntegral.integral_add ((hG (w.1, 0) (m + 1)).intervalIntegrable 0 1)
    ((hG (0, w.2) m).intervalIntegrable 0 1)]
  apply intervalIntegral.integral_congr
  intro s _
  have hw : heatFamilyScaleLinear s w = s • (w.1, (0 : CoordinateFrameSpace)) + (0, w.2) := by
    ext <;> simp [heatFamilyScaleLinear_apply]
  change s ^ m * fderiv ℝ f (heatFamilyScaleLinear s z) (heatFamilyScaleLinear s w) = _
  rw [hw, map_add, map_smul]
  simp only [smul_eq_mul, pow_succ]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual normal-coordinate density and its leading scalar heat
amplitude. Their normalization is obtained from the differential of the
geometric exponential at zero. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Set Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

attribute [local instance] normedAddCommGroupTangentSpaceVectorSpace
  normedSpaceTangentSpaceVectorSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalMetric_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) : heatNormalMetric g o e 0 = 1 := by
  have hd := frameExponential_chart_strictDerivative_zero g o e.base e
    (mem_chart_source FourSpace e.base)
  have hzero : fderiv ℝ (fun v : FourSpace => chartAt FourSpace e.base
      (frameExponential g o e v)) 0 = e.frame.map.toContinuousLinearMap := by
    simpa only [chartForwardOperator_center, ContinuousLinearMap.id_comp] using hd.hasFDerivAt.fderiv
  have hc := frameExponential_center_fderiv g o e 0
  rw [frameExponential_zero] at hc
  have hD : (show FourSpace →L[ℝ] FourSpace from
      mfderiv I4 I4 (frameExponential g o e) 0) = e.frame.map.toContinuousLinearMap :=
    hc.symm.trans hzero
  ext i j
  change g.inner (frameExponential g o e 0)
    ((show FourSpace →L[ℝ] FourSpace from mfderiv I4 I4 (frameExponential g o e) 0)
      (coordinateVector i))
    ((show FourSpace →L[ℝ] FourSpace from mfderiv I4 I4 (frameExponential g o e) 0)
      (coordinateVector j)) = (1 : Mat4) i j
  rw [hD, frameExponential_zero]
  change g.inner e.base (WithLp.toLp 2 (e.frame.matrix *ᵥ Pi.single i 1))
    (WithLp.toLp 2 (e.frame.matrix *ᵥ Pi.single j 1)) = _
  rw [← chartMetric_pairing, dotProduct_comm,
    ← Matrix.dotProduct_transpose_mulVec, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
    e.frame.orthonormal, Matrix.one_mulVec]
  simp [Matrix.one_apply, Pi.single_apply, eq_comm]

theorem frameExponentialJacobian_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) : frameExponentialJacobian g o e 0 = 1 := by
  change Real.sqrt (heatNormalMetric g o e 0).det = 1
  rw [heatNormalMetric_zero, Matrix.det_one, Real.sqrt_one]

theorem frameExponentialJacobian_eventually_pos (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) :
    ∀ᶠ v in 𝓝 (0 : FourSpace), 0 < frameExponentialJacobian g o e v := by
  apply (frameExponentialJacobian_continuous g o e).continuousAt.preimage_mem_nhds
  apply isOpen_Ioi.mem_nhds
  rw [mem_Ioi, frameExponentialJacobian_zero]
  norm_num

def heatNormalLeadingAmplitude (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v : FourSpace) : ℝ :=
  (Real.sqrt (frameExponentialJacobian g o e v))⁻¹

theorem heatNormalLeadingAmplitude_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) : heatNormalLeadingAmplitude g o e 0 = 1 := by
  simp [heatNormalLeadingAmplitude, frameExponentialJacobian_zero]

theorem heatNormalLeadingAmplitude_continuousAt (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) (v : FourSpace)
    (hv : 0 < frameExponentialJacobian g o e v) :
    ContinuousAt (heatNormalLeadingAmplitude g o e) v :=
  ((frameExponentialJacobian_continuous g o e).continuousAt.sqrt).inv₀
    (Real.sqrt_pos.2 hv).ne'

theorem heatNormalLeadingAmplitude_normalization (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) (v : FourSpace)
    (hv : 0 < frameExponentialJacobian g o e v) :
    heatNormalLeadingAmplitude g o e v ^ 2 * frameExponentialJacobian g o e v = 1 := by
  unfold heatNormalLeadingAmplitude
  rw [inv_pow, Real.sq_sqrt hv.le, inv_mul_cancel₀ hv.ne']

theorem heatNormalLeadingAmplitude_neighborhood (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) :
    ∃ r > (0 : ℝ), ContinuousOn (heatNormalLeadingAmplitude g o e) (ball 0 r) ∧
      ∀ v ∈ ball 0 r, 0 < frameExponentialJacobian g o e v ∧
        heatNormalLeadingAmplitude g o e v ^ 2 * frameExponentialJacobian g o e v = 1 := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp
    (frameExponentialJacobian_eventually_pos g o e)
  refine ⟨r, hr, fun v hv =>
    (heatNormalLeadingAmplitude_continuousAt g o e v (hball hv)).continuousWithinAt, ?_⟩
  exact fun v hv => ⟨hball hv, heatNormalLeadingAmplitude_normalization g o e v (hball hv)⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Spectral bounds for the actual scalar shifted Laplacian and the
corresponding intrinsic weak eigenvalue equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance baseSpectrum_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

theorem scalarH1_inner_base (u v : scalarH1 d) :
    inner ℝ u v = inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v) +
      ∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v) := by
  rw [scalarH1_inner]
  have h := (scalarBasePullback g o).inner_map_map (scalarH1BaseValue g o d u)
    (scalarH1BaseValue g o d v)
  rw [scalarH1BaseValue_spec, scalarH1BaseValue_spec] at h
  rw [h]

theorem scalarBaseResolvent_norm_le (f : Lp ℝ 2 (normalizedVolume g)) :
    ‖scalarBaseResolvent g o d f‖ ≤ ‖f‖ := by
  let u := scalarBaseShiftedSolution g o d f
  have he := scalarBaseShiftedSolution_weak g o d f u
  rw [scalarH1_inner_base, real_inner_self_eq_norm_sq] at he
  have hQ : 0 ≤ ∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i u) :=
    Finset.sum_nonneg (fun i _ => real_inner_self_nonneg)
  have hC := real_inner_le_norm f (scalarH1BaseValue g o d u)
  change ‖scalarH1BaseValue g o d u‖ ≤ ‖f‖
  nlinarith only [he, hQ, hC, norm_nonneg f, norm_nonneg (scalarH1BaseValue g o d u)]

variable [SecondCountableTopology M]

theorem scalarBaseResolvent_eigenvalue {μ : ℝ}
    (hμ : Module.End.HasEigenvalue (scalarBaseResolvent g o d).toLinearMap μ) :
    0 < μ ∧ μ ≤ 1 := by
  obtain ⟨f, hf⟩ := hμ.exists_hasEigenvector
  have he := Module.End.mem_eigenspace_iff.mp hf.1
  change scalarBaseResolvent g o d f = μ • f at he
  have hp := scalarBaseResolvent_pos g o d f hf.2
  rw [he, real_inner_smul_right] at hp
  have hμpos : 0 < μ := by nlinarith only [hp, real_inner_self_nonneg (x := f)]
  have hn := scalarBaseResolvent_norm_le g o d f
  rw [he, norm_smul, Real.norm_eq_abs, abs_of_pos hμpos] at hn
  have hfpos : 0 < ‖f‖ := norm_pos_iff.mpr hf.2
  exact ⟨hμpos, by nlinarith only [hn, hfpos]⟩

theorem scalarBaseResolvent_eigenvector_weak {μ : ℝ} {f : Lp ℝ 2 (normalizedVolume g)}
    (hf : Module.End.HasEigenvector (scalarBaseResolvent g o d).toLinearMap μ f) :
    ∃ u : scalarH1 d, scalarH1BaseValue g o d u = f ∧
      ∀ v : scalarH1 d, (∑ i : Fin 4,
        inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
          (μ⁻¹ - 1) * inner ℝ f (scalarH1BaseValue g o d v) := by
  have hm : μ ≠ 0 := (scalarBaseResolvent_eigenvalue g o d
    (Module.End.hasEigenvalue_of_hasEigenvector hf)).1.ne'
  have he := Module.End.mem_eigenspace_iff.mp hf.1
  change scalarBaseResolvent g o d f = μ • f at he
  let u := μ⁻¹ • scalarBaseShiftedSolution g o d f
  have hu : scalarH1BaseValue g o d u = f := by
    rw [map_smul]
    change μ⁻¹ • scalarBaseResolvent g o d f = f
    rw [he, smul_smul, inv_mul_cancel₀ hm, one_smul]
  refine ⟨u, hu, fun v => ?_⟩
  have hw := scalarBaseShiftedSolution_weak g o d f v
  rw [scalarH1_inner_base] at hw
  change inner ℝ (scalarBaseResolvent g o d f) (scalarH1BaseValue g o d v) + _ = _ at hw
  rw [he, real_inner_smul_left] at hw
  have hscale : (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
      μ⁻¹ * ∑ i : Fin 4, inner ℝ (scalarH1Gradient d i (scalarBaseShiftedSolution g o d f))
        (scalarH1Gradient d i v) := by
    simp only [u, map_smul, real_inner_smul_left, Finset.mul_sum]
  rw [hscale]
  calc
    _ = μ⁻¹ * ((1 - μ) * inner ℝ f (scalarH1BaseValue g o d v)) := by
      congr 1
      linarith only [hw]
    _ = _ := by field_simp [hm]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local H2 yields fourth-power integrability of the actual frame gradient,
including the lower-order correction from differentiating the cutoff. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter TemperedDistribution
open scoped Manifold ContDiff ENNReal SchwartzMap

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance chartGradientL4_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1_cutoff_coordinate_memLp_four (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    {K : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (u : scalarH1 d)
    (hH2 : MemSobolev 2 2
      (scalarComplexL2 (scalarH1CutoffValueL2 g o d c hK hKt χ hχ hc hs u) :
        𝓢'(FourSpace, ℂ))) (i : Fin 4) :
    MemLp ((scalarLocalL2ProductCLM hK.isClosed.measurableSet χ hχ.continuous hc hs
      (scalarH1ChartDerivative g o d c hK hKt i u)) : FourSpace → ℝ) 4 volume := by
  let v := scalarH1ChartValue g o d c hK hKt u
  let D := scalarLocalL2ProductCLM hK.isClosed.measurableSet χ hχ.continuous hc hs
    (scalarH1ChartDerivative g o d c hK hKt i u)
  let P := scalarLocalL2PartialProduct hK.isClosed.measurableSet χ hχ hc hs v i
  have hP : MemLp (P : FourSpace → ℝ) 4 volume :=
    scalarLocalL2Product_memLp_four hK.isClosed.measurableSet (partialDeriv χ i)
      (((hχ.fderiv_right (m := ∞) (by simp)).clm_apply
        (contDiff_const (c := coordinateVector i))).continuous)
      (hc.fderiv_apply ℝ (coordinateVector i))
      ((tsupport_fderiv_apply_subset ℝ (coordinateVector i)).trans hs) v
      (scalarH1ChartValue_memLp_four g o d c hK hKt u)
  have hsum : scalarH1CutoffDerivative g o d c hK hKt χ hχ hc hs i u = D + P := rfl
  have hfull := scalarH1CutoffDerivative_memLp_four g o d c hK hKt χ hχ hc hs u hH2 i
  rw [hsum] at hfull
  have hd : MemLp (fun x => (D + P) x - P x) 4 volume := hfull.sub hP
  apply (memLp_congr_ae ?_).mp hd
  filter_upwards [Lp.coeFn_add D P] with x hx
  simp only [hx, Pi.add_apply, add_sub_cancel_right, D]

theorem scalarH1LocalizedCoordinate_memLp_four_of_H2
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source)
    (u : scalarH1 d)
    (hH2 : MemSobolev 2 2
      (scalarComplexL2 (scalarH1CutoffValueL2 g o d c
        (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs)
        (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ hs)
        (scalarChartCutoff_compact c ρ hs) (scalarChartCutoff_support c ρ hs) u) :
          𝓢'(FourSpace, ℂ))) (i : Fin 4) :
    MemLp (scalarH1LocalizedCoordinate g o d c ρ hs i u : M → ℝ)
      4 (normalizedVolume g) := by
  apply scalarChartReconstruction_memLp_four g c
    (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs)
  exact scalarH1_cutoff_coordinate_memLp_four g o d c
    (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs)
    (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ hs)
    (scalarChartCutoff_compact c ρ hs) (scalarChartCutoff_support c ρ hs) u hH2 i

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact complex distributional form of the linear rescaled scalar source. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

theorem scalarComplexL2_scaled_pairing (w : Lp ℝ 2 (volume : Measure V)) (s : ℝ) (φ : S) :
    ∫ y, φ y * ((s * w y : ℝ) : ℂ) = (s : ℂ) * (scalarComplexL2 w : T) φ := by
  rw [Lp.toTemperedDistribution_apply, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [scalarComplexL2_coe w] with y hy
  rw [hy, Complex.ofReal_mul]
  ring

def scalarEigenCutoff (κ : ℝ) : S :=
  scalarCutoffSchwartz scalarCoefficientBump (fun _ => κ)
    scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport (fun _ _ => contDiffAt_const)

theorem scalarEigenCutoff_on_ball (κ : ℝ) (x : V) (hx : x ∈ ball 0 1) :
    scalarEigenCutoff κ x = (κ : ℂ) := by
  change ((scalarCoefficientBump x * κ : ℝ) : ℂ) = _
  rw [scalarCoefficientBump_one (ball_subset_closedBall hx), one_mul]

theorem scalar_eigen_source_pairing (w F : Lp ℝ 2 (volume : Measure V)) (s k : ℝ)
    (hF : F = k • w) (φ : S) :
    ∫ y, φ y * ((s * F y : ℝ) : ℂ) = ((s * k : ℝ) : ℂ) * (scalarComplexL2 w : T) φ := by
  rw [scalarComplexL2_scaled_pairing, hF]
  have he := scalarComplexL2_real_smul_distribution k w
  rw [he]
  simp only [smul_apply, smul_eq_mul, Complex.ofReal_mul]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! A finite smooth partition assembles local fourth-power weak gradient bounds. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

omit [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] in
theorem scalarPartitionFunction_abs_le_one (P : ScalarPartition M) (j : P.ι) :
    ∀ x, |(scalarPartitionFunction P j).val x| ≤ (1 : ℝ) := by
  intro x
  change |P.ρ j x| ≤ 1
  rw [abs_of_nonneg (P.ρ.nonneg j x)]
  exact P.ρ.le_one j x

variable [Nonempty M] [MeasurableSpace M] [BorelSpace M]

local instance gradientAssembly_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1Gradient_memLp_four_of_partition
    (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (P : ScalarPartition M)
    (u : scalarH1 d) (i : Fin 4)
    (hpieces : ∀ j : P.ι, MemLp
      (scalarH1LocalizedFrame g o d (scalarPartitionFunction P j)
        (scalarPartitionFunction_abs_le_one P j) i u : FrameBundle g → ℝ)
      4 (canonicalFrameMeasure g o)) :
    MemLp (scalarH1Gradient d i u : FrameBundle g → ℝ) 4 (canonicalFrameMeasure g o) := by
  let A := fun j : P.ι => scalarH1LocalizedFrame g o d (scalarPartitionFunction P j)
    (scalarPartitionFunction_abs_le_one P j) i u
  have hs : MemLp (fun e => ∑ j : P.ι, A j e) 4 (canonicalFrameMeasure g o) := by
    simpa only [Finset.sum_apply] using
      (memLp_finsetSum Finset.univ (fun j _ => hpieces j))
  apply (memLp_congr_ae ?_).mp hs
  have hA : ∀ᵐ e ∂canonicalFrameMeasure g o, ∀ j : P.ι,
      A j e = (scalarPartitionFunction P j).val e.base * scalarH1Gradient d i u e := by
    apply eventually_all.mpr
    intro j
    exact scalarL2BoundedMultiplier_coe
      (fun e : FrameBundle g => (scalarPartitionFunction P j).val e.base)
      ((scalarPartitionFunction P j).property.continuous.comp
        (continuous_frameBase g)).aestronglyMeasurable
      (fun e => scalarPartitionFunction_abs_le_one P j e.base) (scalarH1Gradient d i u)
  filter_upwards [hA] with e he
  simp_rw [he]
  rw [← Finset.sum_mul]
  have hsum : (∑ j : P.ι, (scalarPartitionFunction P j).val e.base) = 1 := by
    simpa only [scalarPartitionFunction, finsum_eq_sum_of_fintype] using
      P.ρ.sum_eq_one (mem_univ e.base)
  rw [hsum, one_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The dimension-four product needed by the first higher nonlinear gain:
an H2 scalar multiplied by an H3 scalar remains H2. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (f : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} f

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

/-- No pointwise differentiability of either factor is assumed. -/
theorem scalar_real_H2_H3_product (u v : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T))
    (hv : MemSobolev 3 2 (scalarComplexL2 v : T)) :
    ∃ w : L2, MemSobolev 2 2 (scalarComplexL2 w : T) ∧
      (w : V → ℝ) =ᵐ[volume] fun x => u x * v x := by
  obtain ⟨fs, F, F4, _, _, hf, hF, hF4, _, hFco, _⟩ :=
    scalar_real_integer_approximation 2 u hu
  obtain ⟨gs, G, G4, Gtop, _, hg, hG, hG4, hGt, hGco, hGtco⟩ :=
    scalar_real_integer_approximation 3 v hv
  let w : L2 := scalarL4Product (F4 []) (G4 [])
  let Dw : Fin 4 → L2 := fun i =>
    scalarL4Product (F4 [i]) (G4 []) + scalarL4Product (F4 []) (G4 [i])
  let DDw : Fin 4 → Fin 4 → L2 := fun i j =>
    scalarLinfL2Product (Gtop []) (F [i,j]) +
    scalarL4Product (F4 [j]) (G4 [i]) +
    scalarL4Product (F4 [i]) (G4 [j]) +
    scalarL4Product (F4 []) (G4 [i,j])
  have hfs4 := hF4 [] (by simp)
  have hgs4 := hG4 [] (by simp)
  refine ⟨w, ?_, ?_⟩
  · apply scalar_real_H2_of_strong_jets (fun k => scalarRealSchwartzProduct (fs k) (gs k)) w Dw DDw
    · simp only [scalarRealSchwartzProduct_L2_four]
      exact scalarL4Product_tendsto hfs4 hgs4
    · intro i
      simp only [scalarRealSchwartzProduct_first_L2]
      exact (scalarL4Product_tendsto (hF4 [i] (by simp)) hgs4).add
        (scalarL4Product_tendsto hfs4 (hG4 [i] (by simp)))
    · intro i j
      simp only [scalarRealSchwartzProduct_second_L2]
      have h₀ := scalarLinfL2Product_tendsto (hGt [] (by simp)) (hF [i,j] (by simp))
      have h₁ := scalarL4Product_tendsto (hF4 [j] (by simp)) (hG4 [i] (by simp))
      have h₂ := scalarL4Product_tendsto (hF4 [i] (by simp)) (hG4 [j] (by simp))
      have h₃ := scalarL4Product_tendsto hfs4 (hG4 [i,j] (by simp))
      exact ((h₀.add h₁).add h₂).add h₃
  · have hFu : F [] = u := tendsto_nhds_unique (hF [] (by simp)) hf
    have hGv : G [] = v := tendsto_nhds_unique (hG [] (by simp)) hg
    filter_upwards [scalarL4Product_coe (F4 []) (G4 []), hFco [] (by simp), hGco [] (by simp)]
      with x hw hfx hgx
    change scalarL4Product (F4 []) (G4 []) x = _
    rw [hw, ← hfx, ← hgx, hFu, hGv]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local H2 regularity of the actual Euler nonlinearity on a positive
range, with the same absolute-value convention as the weak equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open scoped SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

theorem scalar_localized_H2_subcritical_source (u : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T)) (χ : S)
    (hc : HasCompactSupport (χ : V → ℝ)) (a B p : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ᵐ x ∂(volume : Measure V), χ x ≠ 0 → u x ∈ Set.Icc a B) :
    ∃ v : L2, MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] fun x => χ x * (|u x| ^ (p - 2) * u x) := by
  obtain ⟨v, hv, heq⟩ := scalar_localized_H2_positive_power u hu χ hc a B (p - 1) ha hB hRange
  refine ⟨v, hv, ?_⟩
  filter_upwards [heq, hRange] with x hx hr
  rw [hx]
  by_cases hχ : χ x = 0
  · simp only [hχ, zero_mul]
  · have hp : 0 < u x := ha.trans_le (hr hχ).1
    congr 1
    rw [abs_of_pos hp]
    calc
      (u x) ^ (p - 1) = (u x) ^ ((p - 2) + 1) := by congr 1; ring
      _ = (u x) ^ (p - 2) * u x := by rw [Real.rpow_add hp, Real.rpow_one]

end
end PositiveEinsteinFour.Geometry
end


section

/-! The local Euler power is H2 after positivity. The density-weighted
weak solution is first divided by its actual smooth positive density. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff NNReal

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

theorem scalar_half_ball_cutoff_of_compact {K : Set V} (hK : IsCompact K)
    (hKs : K ⊆ ball 0 (1 / 2)) :
    ∃ χ : V → ℝ, ContDiff ℝ ∞ χ ∧ HasCompactSupport χ ∧
      tsupport χ ⊆ ball 0 (1 / 2) ∧ ∀ x ∈ K, χ x = 1 := by
  obtain ⟨t, ht, hbound⟩ := hK.exists_forall_le'
    continuous_norm.neg.continuousOn (a := -(1 / 2 : ℝ)) (by
      intro x hx
      have h : ‖x‖ < (1 / 2 : ℝ) := by
        simpa only [mem_ball, dist_zero_right] using hKs hx
      change -(1 / 2 : ℝ) < -‖x‖
      linarith)
  let r : ℝ := max (-t) (1 / 4)
  have hr : 0 < r := lt_of_lt_of_le (by norm_num) (le_max_right _ _)
  have hrh : r < 1 / 2 := max_lt (by linarith) (by norm_num)
  let χ : ContDiffBump (0 : V) :=
    { rIn := r
      rOut := (r + 1 / 2) / 2
      rIn_pos := hr
      rIn_lt_rOut := by linarith }
  refine ⟨χ, χ.contDiff, χ.hasCompactSupport, ?_, ?_⟩
  · rw [χ.tsupport_eq]
    apply closedBall_subset_ball
    change (r + 1 / 2) / 2 < 1 / 2
    linarith
  · intro x hx
    apply χ.one_of_mem_closedBall
    have hb : ‖x‖ ≤ -t := by
      have hb := hbound x hx
      change t ≤ -‖x‖ at hb
      linarith
    simpa only [mem_closedBall, dist_zero_right] using hb.trans (le_max_left (-t) (1 / 4))

theorem scalar_local_H2_power_source (ρ b : V → ℝ)
    (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : 𝓢(V, ℂ), HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (hρ : ∀ y ∈ closedBall (0 : V) (1 / 2), ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y)
    (hρ0 : ∀ y ∈ closedBall (0 : V) (1 / 2), ρ y ≠ 0)
    (a B q : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ x ∈ closedBall (0 : V) (1 / 2), b x ∈ Icc a B)
    (ψ : S) (hc : HasCompactSupport (ψ : V → ℝ))
    (hs : tsupport (ψ : V → ℝ) ⊆ ball 0 (1 / 2)) :
    ∃ v : Lp ℝ 2 (volume : Measure V), MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] fun y => ψ y * (b y) ^ q := by
  obtain ⟨χ, hχ, hχc, hχs, hone⟩ := scalar_half_ball_cutoff_of_compact hc hs
  obtain ⟨z, hz2, hz⟩ := scalar_H2_density_division ρ b w heq hreg χ hχ hχc
    (fun y hy => ball_subset_closedBall (hχs hy))
    (fun y hy => hρ y (ball_subset_closedBall (hχs hy)))
    (fun y hy => hρ0 y (ball_subset_closedBall (hχs hy)))
  obtain ⟨u, hu2, hu⟩ := scalar_real_H2_realization z hz2 (fun y => χ y * b y) hz
  have hru : ∀ᵐ x ∂(volume : Measure V), ψ x ≠ 0 → u x ∈ Icc a B := by
    filter_upwards [hu] with x hx hψ
    have hxs := subset_tsupport (ψ : V → ℝ) hψ
    rw [hx, hone x hxs, one_mul]
    exact hRange x (ball_subset_closedBall (hs hxs))
  obtain ⟨v, hv2, hv⟩ := scalar_localized_H2_positive_power u hu2 ψ hc a B q ha hB hru
  refine ⟨v, hv2, ?_⟩
  filter_upwards [hv, hu] with x hx hu
  rw [hx]
  by_cases hψ : ψ x = 0
  · simp only [hψ, zero_mul]
  · rw [hu, hone x (subset_tsupport (ψ : V → ℝ) hψ), one_mul]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and the invertible affine rescaling
in the local smooth representative of the actual Poisson solution. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance unweighting_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_local_chart_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : SmoothScalar (M := M)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ F : FourSpace → ℝ, ContDiffOn ℝ (⊤ : ℕ∞) F U ∧
        (fun z => scalarH1BaseValue g o d u ((chartAt FourSpace c).symm z)) =ᵐ[
          volume.restrict U] F := by
  obtain ⟨r, hr, ht, F, hF, heq⟩ := scalar_local_weighted_smooth g o d f u hw c z₀
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) (1 / 4)}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    norm_num
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball (by norm_num : (1 / 4 : ℝ) ≤ 1) hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContDiffOn ℝ (⊤ : ℕ∞) H U := by
    intro z hz
    apply ContDiffAt.contDiffWithinAt
    exact ((hF.contDiffAt).comp z
      (A.symm.contDiff.contDiffAt.comp z (contDiffAt_id.sub contDiffAt_const))).div
      (chartVolumeDensity_contDiffAt g c z (hUt hz))
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! Closedness of all finite real weak jets in the distributional Sobolev space. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℝ)

theorem scalarRealSchwartzJet_ofReal (is : List (Fin 4)) (f : S) :
    scalarSchwartzCoordinateJet is (f.postcompCLM Complex.ofRealCLM) =
      (scalarRealSchwartzJet is f).postcompCLM Complex.ofRealCLM := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    change (∂_{EuclideanSpace.basisFun (Fin 4) ℝ i}
      (scalarSchwartzCoordinateJet is (f.postcompCLM Complex.ofRealCLM)) : 𝓢(V, ℂ)) = _
    rw [ih]
    exact scalarSchwartz_ofReal_derivative (scalarRealSchwartzJet is f) i

theorem scalarRealSchwartzJet_weak (is : List (Fin 4)) (f : S) :
    scalarCoordinateJet is (scalarComplexL2 (f.toLp 2 volume) : T) =
      (scalarComplexL2 ((scalarRealSchwartzJet is f).toLp 2 volume) : T) := by
  rw [← scalarSchwartz_ofReal_toLp, Lp.toTemperedDistribution_toLp_eq,
    ← scalarSchwartzCoordinateJet_distribution, scalarRealSchwartzJet_ofReal,
    ← scalarSchwartz_ofReal_toLp, Lp.toTemperedDistribution_toLp_eq]

theorem scalar_real_jet_limit (is : List (Fin 4)) (fs : ℕ → S) (u v : L2)
    (hu : Tendsto (fun k => (fs k).toLp 2 volume) atTop (𝓝 u))
    (hv : Tendsto (fun k => (scalarRealSchwartzJet is (fs k)).toLp 2 volume)
      atTop (𝓝 v)) :
    scalarCoordinateJet is (scalarComplexL2 u : T) = (scalarComplexL2 v : T) := by
  let C := Complex.ofRealCLM.compLpL 2 (volume : Measure V)
  have hC (a : L2) : C a = scalarComplexL2 a := rfl
  have hleft := (scalarCoordinateJet is).continuous.continuousAt.tendsto.comp
    ((Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp
      (C.continuous.continuousAt.tendsto.comp hu))
  have hright := (Lp.toTemperedDistributionCLM ℂ volume 2).continuous.continuousAt.tendsto.comp
    (C.continuous.continuousAt.tendsto.comp hv)
  have hl : Tendsto (fun k => (scalarComplexL2
      ((scalarRealSchwartzJet is (fs k)).toLp 2 volume) : T)) atTop
      (𝓝 (scalarCoordinateJet is (scalarComplexL2 u : T))) := by
    simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply, hC,
      scalarRealSchwartzJet_weak] using hleft
  have hr : Tendsto (fun k => (scalarComplexL2
      ((scalarRealSchwartzJet is (fs k)).toLp 2 volume) : T)) atTop
      (𝓝 (scalarComplexL2 v : T)) := by
    simpa only [Function.comp_def, Lp.toTemperedDistributionCLM_apply, hC] using hright
  exact tendsto_nhds_unique hl hr

theorem scalar_real_derivative_sobolev (n : ℕ) (u : L2)
    (hu : MemSobolev ((n : ℝ) + 1) 2 (scalarComplexL2 u : T)) (i : Fin 4) :
    ∃ v : L2, scalarCoordinateDerivative i (scalarComplexL2 u : T) =
      (scalarComplexL2 v : T) ∧ MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) := by
  obtain ⟨fs, G, _, _, _, hf, hG, _, _, _, _⟩ :=
    scalar_real_integer_approximation (n + 1) u (by simpa only [Nat.cast_add, Nat.cast_one] using hu)
  have he := scalar_real_jet_limit [i] fs u (G [i]) hf (hG [i] (by simp))
  have he' : scalarCoordinateDerivative i (scalarComplexL2 u : T) =
      (scalarComplexL2 (G [i]) : T) := he
  refine ⟨G [i], he', ?_⟩
  rw [← he']
  simpa only [scalarCoordinateDerivative, add_sub_cancel_right] using
    hu.lineDerivOp (m := EuclideanSpace.basisFun (Fin 4) ℝ i)

theorem scalar_real_integer_jets_closed (n : ℕ) (fs : ℕ → S) (u : L2)
    (G : List (Fin 4) → L2)
    (hf : Tendsto (fun k => (fs k).toLp 2 volume) atTop (𝓝 u))
    (hG : ∀ is, is.length ≤ n →
      Tendsto (fun k => (scalarRealSchwartzJet is (fs k)).toLp 2 volume) atTop (𝓝 (G is))) :
    MemSobolev (n : ℝ) 2 (scalarComplexL2 u : T) := by
  let C := Complex.ofRealCLM.compLpL 2 (volume : Measure V)
  apply scalar_integer_jets_closed n (scalarComplexL2 u)
    (fun k => scalarComplexL2 ((fs k).toLp 2 volume))
    (fun is => scalarComplexL2 (G is))
    (fun is k => scalarComplexL2 ((scalarRealSchwartzJet is (fs k)).toLp 2 volume))
  · exact C.continuous.continuousAt.tendsto.comp hf
  · intro is hs
    exact C.continuous.continuousAt.tendsto.comp (hG is hs)
  · intro is _ k
    exact scalarRealSchwartzJet_weak is (fs k)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The subcritical Sobolev operator on the Hilbert space whose squared
norm is the exact normalized energy in the manuscript. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter Set
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance sobolevExtremal_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance sobolevExtremal_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarWeightedBaseLp (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    scalarWeightedH1 d →L[ℝ] Lp ℝ p (normalizedVolume g) :=
  (scalarH1BaseLp g o d p hp).comp (scalarWeightedH1ToH1 d)

theorem scalarWeightedBaseLp_coe (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) (u : scalarWeightedH1 d) :
    scalarWeightedBaseLp g o d p hp u =ᵐ[normalizedVolume g]
      scalarH1BaseValue g o d (scalarWeightedH1ToH1 d u) :=
  scalarH1BaseLp_coe g o d p hp _

theorem scalarWeighted_subcritical_subsequence (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (hp : 2 < p) (hp4 : p < 4)
    (u : ℕ → scalarWeightedH1 d) {R : ℝ} (hu : ∀ n, ‖u n‖ ≤ R) :
    ∃ v : Lp ℝ (ENNReal.ofReal p) (normalizedVolume g),
      ∃ φ : ℕ → ℕ, StrictMono φ ∧
        Tendsto (fun n => scalarWeightedBaseLp g o d (ENNReal.ofReal p)
          (by exact_mod_cast hp4.le) (u (φ n))) atTop (𝓝 v) := by
  have hbound : ∀ n, ‖scalarWeightedH1ToH1 d (u n)‖ ≤ ‖scalarWeightedH1ToH1 d‖ * R :=
    fun n => ((scalarWeightedH1ToH1 d).le_opNorm (u n)).trans
      (mul_le_mul_of_nonneg_left (hu n) (norm_nonneg (scalarWeightedH1ToH1 d)))
  exact scalarH1_subcritical_subsequence g o d hp hp4
    (fun n => scalarWeightedH1ToH1 d (u n)) hbound

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual localized orthonormal-frame components and their first
derivatives define complex H1 distributions for elliptic regularity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped SchwartzMap ENNReal LineDeriv Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) (S : Mat4) {K : Set FourSpace} (hK : IsCompact K)
  (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4)

def twoFormGramValueL2 : TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarBorelLpEquiv ℝ 2).symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((ContinuousLinearMap.fst ℝ (scalarBorelLp ℝ 2) (scalarBorelLp FourSpace 2)).comp
      (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v))

def twoFormGramGradientL2 : TwoFormH1 o →L[ℝ] Lp FourSpace 2 (volume : Measure FourSpace) :=
  (scalarBorelLpEquiv FourSpace 2).symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((ContinuousLinearMap.snd ℝ (scalarBorelLp ℝ 2) (scalarBorelLp FourSpace 2)).comp
      (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v))

def twoFormGramPartialL2 (i : Fin 4) :
    TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarGradientCoordinateL2 i).comp (twoFormGramGradientL2 c S hK hKt χ hχ hc hs v)

theorem twoFormGramValueL2_smooth (u : SmoothH1TwoForm o) :
    twoFormGramValueL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u) =
      ScalarEuclideanSobolev.valueL2 (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u) := by
  change (scalarBorelLpEquiv ℝ 2).symm
    (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u)).1 = _
  rw [twoFormGramCutoffJet_smooth]
  change (scalarBorelLpEquiv ℝ 2).symm
    (Euclidean.toL2 (μ := _) (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u)) = _
  rw [← scalarBorel_valueL2]
  exact (scalarBorelLpEquiv ℝ 2).symm_apply_apply _

theorem twoFormGramGradientL2_smooth (u : SmoothH1TwoForm o) :
    twoFormGramGradientL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u) =
      ScalarEuclideanSobolev.gradientL2 (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u) := by
  change (scalarBorelLpEquiv FourSpace 2).symm
    (twoFormGramCutoffJet c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u)).2 = _
  rw [twoFormGramCutoffJet_smooth]
  change (scalarBorelLpEquiv FourSpace 2).symm
    (Euclidean.toL2Grad (μ := _) (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u)) = _
  rw [← scalarBorel_gradientL2]
  exact (scalarBorelLpEquiv FourSpace 2).symm_apply_apply _

theorem twoFormGramPartialL2_smooth (u : SmoothH1TwoForm o) (i : Fin 4) :
    twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i (smoothTwoFormToH1 u) =
      ScalarEuclideanSobolev.partialL2 (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u) i := by
  change scalarGradientCoordinateL2 i
    (twoFormGramGradientL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 u)) = _
  rw [twoFormGramGradientL2_smooth, scalarGradientCoordinateL2_smooth]

theorem twoFormGram_complex_derivative (u : TwoFormH1 o) (i : Fin 4) :
    scalarCoordinateDerivative i (scalarComplexL2
      (twoFormGramValueL2 c S hK hKt χ hχ hc hs v u) : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 (twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i u) :
        𝓢'(FourSpace, ℂ)) := by
  have hC : Continuous (fun f : Lp ℝ 2 (volume : Measure FourSpace) =>
      (scalarComplexL2 f : 𝓢'(FourSpace, ℂ))) :=
    (Lp.toTemperedDistributionCLM ℂ volume 2).continuous.comp
      (Complex.ofRealCLM.compLpL 2 volume).continuous
  have hL : Continuous (fun w : TwoFormH1 o => scalarCoordinateDerivative i
      (scalarComplexL2 (twoFormGramValueL2 c S hK hKt χ hχ hc hs v w) :
        𝓢'(FourSpace, ℂ))) :=
    (LineDeriv.continuous_lineDerivOp (EuclideanSpace.basisFun (Fin 4) ℝ i)).comp
      (hC.comp (twoFormGramValueL2 c S hK hKt χ hχ hc hs v).continuous)
  have hR : Continuous (fun w : TwoFormH1 o =>
      (scalarComplexL2 (twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i w) :
        𝓢'(FourSpace, ℂ))) :=
    hC.comp (twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i).continuous
  refine UniformSpace.Completion.induction_on u (isClosed_eq hL hR) ?_
  intro w
  change scalarCoordinateDerivative i (scalarComplexL2
    (twoFormGramValueL2 c S hK hKt χ hχ hc hs v (smoothTwoFormToH1 w)) : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 (twoFormGramPartialL2 c S hK hKt χ hχ hc hs v i (smoothTwoFormToH1 w)) :
        𝓢'(FourSpace, ℂ))
  rw [twoFormGramValueL2_smooth, twoFormGramPartialL2_smooth]
  exact scalarC1_complex_derivative _ i

theorem twoFormGram_memSobolev_one (u : TwoFormH1 o) :
    MemSobolev 1 2 (scalarComplexL2
      (twoFormGramValueL2 c S hK hKt χ hχ hc hs v u) : 𝓢'(FourSpace, ℂ)) := by
  rw [← zero_add (1 : ℝ)]
  apply (scalar_memSobolev_succ_iff 0 _).mpr
  constructor
  · exact memSobolev_zero_iff.mpr ⟨_, rfl⟩
  · intro i
    rw [twoFormGram_complex_derivative c S hK hKt χ hχ hc hs v u i]
    exact memSobolev_zero_iff.mpr ⟨_, rfl⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Every smooth two-form supported in one chart is exactly the compact
orthonormal-frame test constructed from its own coefficients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

omit [MeasurableSpace M] [BorelSpace M] [Nonempty M] in
theorem twoForm_supported_gramTest (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    {K Z : Set FourSpace} (hK : IsCompact K) (hKt : K ⊆ (chartAt FourSpace c).target)
    (hZK : Z ⊆ K) (w : smoothTwoForms o)
    (hs : tsupport w.val ⊆ (chartAt FourSpace c).symm '' Z) :
    ∃ (a : FourSpace → TwoFormFour) (ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target)
      (has : tsupport a ⊆ Z), twoFormGramTest o c S a ha hK hKt (has.trans hZK) = w := by
  let a := twoFormChartValue o w.val c S hS
  have ha : ContDiffOn ℝ ∞ a (chartAt FourSpace c).target :=
    fun z hz => (w.property.chartValue_contDiffAt c S hS z hz).contDiffWithinAt
  have hsource : tsupport w.val ⊆ (chartAt FourSpace c).source := by
    rintro x hx
    obtain ⟨z, hz, rfl⟩ := hs hx
    exact (chartAt FourSpace c).map_target (hKt (hZK hz))
  let L := (chartAt FourSpace c) '' tsupport w.val
  have hL : IsCompact L :=
    (isCompact_univ.of_isClosed_subset (isClosed_tsupport w.val) (subset_univ _)).image_of_continuousOn
      ((chartAt FourSpace c).continuousOn.mono hsource)
  have hLZ : L ⊆ Z := by
    rintro z ⟨x, hx, rfl⟩
    obtain ⟨y, hy, he⟩ := hs hx
    rw [← he, (chartAt FourSpace c).right_inv (hKt (hZK hy))]
    exact hy
  have hasL : tsupport a ⊆ L := by
    apply closure_minimal _ hL.isClosed
    intro z hz
    have hzt : z ∈ (chartAt FourSpace c).target := by
      by_contra hn
      apply hz
      exact dite_eq_right hn
    have hw : w.val ((chartAt FourSpace c).symm z) ≠ 0 := by
      intro hw
      have hn := twoFormChartValue_norm o w.val c S hS z hzt
      rw [hw, norm_zero] at hn
      exact hz (norm_eq_zero.mp hn)
    exact ⟨(chartAt FourSpace c).symm z, subset_tsupport w.val hw,
      (chartAt FourSpace c).right_inv hzt⟩
  let has := hasL.trans hLZ
  let v := twoFormGramTest o c S a ha hK hKt (has.trans hZK)
  refine ⟨a, ha, has, ?_⟩
  apply Subtype.ext
  funext x
  by_cases hx : x ∈ (chartAt FourSpace c).source
  · let z := chartAt FourSpace c x
    have hz : z ∈ (chartAt FourSpace c).target := (chartAt FourSpace c).map_source hx
    have he := twoFormGramTest_value (o := o) c S hS a ha hK hKt (has.trans hZK) z hz
    change twoFormChartValue o v.val c S hS z = twoFormChartValue o w.val c S hS z at he
    let e := chartGramSection g c S hS ⟨z, hz⟩
    have hf : twoFormFrameValue o v.val e = twoFormFrameValue o w.val e := by
      simpa only [twoFormChartValue, dite_eq_left hz] using he
    have hi := (twoFormFrameIsometry ((o.frame e.base).changeMatrix e.frame)
      ((o.frame e.base).changeMatrix_orthogonal e.frame)).injective hf
    change v.val ((chartAt FourSpace c).symm z) = w.val ((chartAt FourSpace c).symm z) at hi
    simpa only [z, (chartAt FourSpace c).left_inv hx] using hi
  · have hw : w.val x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hx (hsource h))
    have hv : v.val x = 0 := twoFormChartTest_zero_off c _ _ _ hK hKt _ x (by
      rintro ⟨z, hz, rfl⟩
      exact hx ((chartAt FourSpace c).map_target (hKt hz)))
    exact hv.trans hw.symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact cutoff commutator for the six-component parametrix operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

theorem fourHeatBundleOperator_cutoff (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) (f : FourSpace → ℝ)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (ha : ∀ i j, a i j = a j i) (hf : ContDiffAt ℝ 2 f x)
    (hu : ∀ k, ContDiffAt ℝ 2 (fun y => u y k) x) (k : Fin 6) :
    fourHeatBundleOperator a b B C (fun y l => f y * u y l) x k =
      f x * fourHeatBundleOperator a b B C u x k +
      fourHeatLocalOperator a b 0 f x * u x k -
      2 * (∑ i, ∑ j, a i j * partialDeriv f i x * partialDeriv (fun y => u y k) j x) +
      ∑ i, ∑ l, B i k l * partialDeriv f i x * u x l := by
  have hfirst : fourHeatBundleFirst B (fun y l => f y * u y l) x k =
      f x * fourHeatBundleFirst B u x k +
        ∑ i, ∑ l, B i k l * partialDeriv f i x * u x l := by
    unfold fourHeatBundleFirst
    simp_rw [scalar_partial_product f (fun y => u y _) x
      (hf.differentiableAt (by norm_num)) ((hu _).differentiableAt (by norm_num))]
    have he (i : Fin 4) (l : Fin 6) :
        B i k l * (partialDeriv f i x * u x l + f x * partialDeriv (fun y => u y l) i x) =
        f x * (B i k l * partialDeriv (fun y => u y l) i x) +
          B i k l * partialDeriv f i x * u x l := by ring
    simp_rw [he, Finset.sum_add_distrib, ← Finset.mul_sum]
  have hzero : fourHeatBundleZero C (fun y l => f y * u y l) x k =
      f x * fourHeatBundleZero C u x k := by
    unfold fourHeatBundleZero
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro l _
    ring
  unfold fourHeatBundleOperator
  rw [fourHeatLocalOperator_cutoff a b f (fun y => u y k) x ha hf (hu k), hfirst, hzero]
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Solving the inhomogeneous radial transport equation by the actual
integral with a nonvanishing leading amplitude. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped ContDiff

noncomputable section

def fourHeatWeightedRadialAverage (m : ℕ) (U F : FourSpace → ℝ) (x : FourSpace) : ℝ :=
  U x * fourHeatRadialAverage m (fun y => F y / U y) x

theorem fourHeatWeightedRadialAverage_contDiff (n m : ℕ) (U F : FourSpace → ℝ)
    (hU : ContDiff ℝ (n + 1 : ℕ) U) (hF : ContDiff ℝ (n + 1 : ℕ) F)
    (hU0 : ∀ y, U y ≠ 0) : ContDiff ℝ n (fourHeatWeightedRadialAverage m U F) := by
  exact (hU.of_le (by exact_mod_cast Nat.le_succ n)).mul
    (fourHeatRadialAverage_contDiff n m _ (hF.div hU hU0))

theorem fourHeatRadialTransport_product (a : Mat4) (b : Fin 4 → ℝ)
    (U V : FourSpace → ℝ) (x : FourSpace)
    (hrow : ∀ i, ∑ j : Fin 4, a i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a i j * x i = x j)
    (hU : DifferentiableAt ℝ U x) (hV : DifferentiableAt ℝ V x) :
    fourHeatRadialTransport a b (fun y => U y * V y) x =
      U x * fderiv ℝ V x x + V x * fourHeatRadialTransport a b U x := by
  rw [fourHeatRadialTransport_of_radial a b _ x hrow hcol,
    fourHeatRadialTransport_of_radial a b U x hrow hcol,
    fderiv_fun_mul hU hV]
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
  ring

theorem fourHeatWeightedRadialAverage_transport (m : ℕ) (a : Mat4) (b : Fin 4 → ℝ)
    (U F : FourSpace → ℝ) (x : FourSpace)
    (hU : ContDiff ℝ 1 U) (hF : ContDiff ℝ 1 F) (hU0 : ∀ y, U y ≠ 0)
    (hrow : ∀ i, ∑ j : Fin 4, a i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a i j * x i = x j)
    (hTU : fourHeatRadialTransport a b U x = 0) :
    fourHeatRadialTransport a b (fourHeatWeightedRadialAverage m U F) x +
      (m + 1 : ℝ) * fourHeatWeightedRadialAverage m U F x = F x := by
  let Q := fun y => F y / U y
  have hQ : ContDiff ℝ 1 Q := hF.div hU hU0
  have hV : DifferentiableAt ℝ (fourHeatRadialAverage m Q) x :=
    (fourHeatRadialAverage_hasFDerivAt m Q hQ x).differentiableAt
  change fourHeatRadialTransport a b (fun y => U y * fourHeatRadialAverage m Q y) x +
    (m + 1 : ℝ) * (U x * fourHeatRadialAverage m Q x) = F x
  rw [fourHeatRadialTransport_product a b U _ x hrow hcol
    ((hU.differentiable one_ne_zero).differentiableAt) hV, hTU, mul_zero, add_zero]
  calc
    _ = U x * (fderiv ℝ (fourHeatRadialAverage m Q) x x +
        (m + 1 : ℝ) * fourHeatRadialAverage m Q x) := by ring
    _ = U x * Q x := by rw [fourHeatRadialAverage_transport m Q hQ x]
    _ = F x := by exact mul_div_cancel₀ (F x) (hU0 x)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Radial transport preserves finite joint regularity, including the
center and frame parameters. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators Matrix.Norms.Elementwise

noncomputable section

local instance heatFamilyRadialRegularityDualNormedGroup :
    NormedAddCommGroup (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup

local instance heatFamilyRadialRegularityDualNormedSpace :
    NormedSpace ℝ (HeatRadialFrameSpace →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedSpace

abbrev heatFamilyBasis := Module.finBasis ℝ HeatRadialFrameSpace

theorem heatFamilyLinearForm_expansion (L : HeatRadialFrameSpace →L[ℝ] ℝ) :
    L = ∑ i, L (heatFamilyBasis i) • (heatFamilyBasis.coord i).toContinuousLinearMap := by
  apply ContinuousLinearMap.ext
  intro z
  have hz := congrArg L (heatFamilyBasis.sum_repr z)
  rw [map_sum] at hz
  simp only [map_smul, smul_eq_mul] at hz
  rw [← hz]
  simp only [_root_.sum_apply, _root_.smul_apply, Module.Basis.coord_apply,
    LinearMap.coe_toContinuousLinearMap', smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  ring

theorem heatFamilyRadialAverage_preserves_contDiff (n : ℕ) :
    ∀ (m : ℕ) (f : HeatRadialFrameSpace → ℝ), ContDiff ℝ n f →
      ContDiff ℝ n (heatFamilyRadialAverage m f) := by
  induction n with
  | zero =>
    intro m f hf
    exact contDiff_zero.mpr (heatFamilyRadialAverage_continuous m f hf.continuous)
  | succ n ih =>
    intro m f hf
    have hf1 : ContDiff ℝ 1 f := hf.of_le (by exact_mod_cast Nat.le_add_left 1 n)
    have hp (v : HeatRadialFrameSpace) : ContDiff ℝ n (fun y => fderiv ℝ f y v) :=
      (hf.fderiv_right (m := n) (by norm_num [Nat.cast_add])).clm_apply contDiff_const
    let D : HeatRadialFrameSpace → HeatRadialFrameSpace →L[ℝ] ℝ := fun z =>
      ∑ i, (heatFamilyRadialAverage (m + 1)
        (fun y => fderiv ℝ f y ((heatFamilyBasis i).1, 0)) z +
        heatFamilyRadialAverage m
          (fun y => fderiv ℝ f y (0, (heatFamilyBasis i).2)) z) •
        (heatFamilyBasis.coord i).toContinuousLinearMap
    have hD : ContDiff ℝ n D := by
      apply ContDiff.sum
      intro i _
      exact (ContinuousLinearMap.toSpanSingleton ℝ
        (heatFamilyBasis.coord i).toContinuousLinearMap).contDiff.comp
          ((ih (m + 1) _ (hp _)).add (ih m _ (hp _)))
    apply contDiff_succ_iff_hasFDerivAt.mpr
    refine ⟨D, hD, ?_⟩
    intro z
    have he : fderiv ℝ (heatFamilyRadialAverage m f) z = D z := by
      rw [heatFamilyLinearForm_expansion (fderiv ℝ (heatFamilyRadialAverage m f) z)]
      apply Finset.sum_congr rfl
      intro i _
      rw [heatFamilyRadialAverage_fderiv_apply m f hf1 z]
    exact he ▸ (heatFamilyRadialAverage_hasFDerivAt m f hf1 z).differentiableAt.hasFDerivAt

end
end PositiveEinsteinFour.Geometry
end


section

/-! Regularity of the actual normal metric, volume density and leading heat
amplitude. All are derived from the exponential and the smooth metric. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

attribute [local instance] normedAddCommGroupTangentSpaceVectorSpace
  normedSpaceTangentSpaceVectorSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalMetric_chart_pairing (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (c : M) (v : FourSpace)
    (hv : frameExponential g o e v ∈ (chartAt FourSpace c).source) (i j : Fin 4) :
    heatNormalMetric g o e v i j =
      WithLp.ofLp (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
        (coordinateVector i)) ⬝ᵥ
      (metricInChart g c (chartAt FourSpace c (frameExponential g o e v)) *ᵥ
        WithLp.ofLp (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
          (coordinateVector j))) := by
  have h := metricInChart_pairing g c
    (chartAt FourSpace c (frameExponential g o e v))
    (WithLp.ofLp (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
      (coordinateVector i)))
    (WithLp.ofLp (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
      (coordinateVector j)))
  simp only [WithLp.toLp_ofLp] at h
  change _ = g.inner ((chartAt FourSpace c).symm
      (chartAt FourSpace c (frameExponential g o e v)))
    (chartBackwardOperator c (chartAt FourSpace c (frameExponential g o e v))
      (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
        (coordinateVector i)))
    (chartBackwardOperator c (chartAt FourSpace c (frameExponential g o e v))
      (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v
        (coordinateVector j))) at h
  rw [frameExponential_chart_backward g o e c v (coordinateVector i) hv,
    frameExponential_chart_backward g o e c v (coordinateVector j) hv,
    (chartAt FourSpace c).left_inv hv] at h
  exact h.symm

theorem heatNormalMetric_smoothAt_zero (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (i j : Fin 4) :
    ContDiffAt ℝ ∞ (fun v => heatNormalMetric g o e v i j) 0 := by
  let c := e.base
  let F := fun v : FourSpace => chartAt FourSpace c (frameExponential g o e v)
  have hF : ContDiffAt ℝ ∞ F 0 := frameExponential_chart_smoothAt_zero g o c e
    (mem_chart_source FourSpace c)
  have hFD : ContDiffAt ℝ ∞ (fderiv ℝ F) 0 := hF.fderiv_right (by simp)
  have hcoord (k l : Fin 4) : ContDiffAt ℝ ∞
      (fun v => (fderiv ℝ F v (coordinateVector k)) l) 0 := by
    let π : FourSpace →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 4 => ℝ) l
    have hd : ContDiffAt ℝ ∞ (fun v => fderiv ℝ F v (coordinateVector k)) 0 :=
      hFD.clm_apply contDiffAt_const
    exact π.contDiff.contDiffAt.comp 0 hd
  have htarget : F 0 ∈ (chartAt FourSpace c).target := by
    dsimp [F]
    rw [frameExponential_zero]
    exact (chartAt FourSpace c).map_source (mem_chart_source FourSpace c)
  have hmetric (k l : Fin 4) : ContDiffAt ℝ ∞
      (fun v => metricInChart g c (F v) k l) 0 :=
    (metricInChart_contDiffAt g c (F 0) htarget k l).comp 0 hF
  have hright : ContDiffAt ℝ ∞ (fun v =>
      WithLp.ofLp (fderiv ℝ F v (coordinateVector i)) ⬝ᵥ
        (metricInChart g c (F v) *ᵥ WithLp.ofLp (fderiv ℝ F v (coordinateVector j)))) 0 := by
    simp only [dotProduct, Matrix.mulVec]
    apply ContDiffAt.sum
    intro k _
    apply (hcoord i k).mul
    apply ContDiffAt.sum
    intro l _
    exact (hmetric k l).mul (hcoord j l)
  apply hright.congr_of_eventuallyEq
  have hn : ∀ᶠ v in 𝓝 (0 : FourSpace), frameExponential g o e v ∈
      (chartAt FourSpace c).source :=
    (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
      ((chartAt FourSpace c).open_source.mem_nhds (by
        rw [frameExponential_zero]
        exact mem_chart_source FourSpace c))
  filter_upwards [hn] with v hv
  exact heatNormalMetric_chart_pairing g o e c v hv i j

theorem frameExponentialJacobian_smoothAt_zero (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) :
    ContDiffAt ℝ ∞ (frameExponentialJacobian g o e) 0 := by
  have hd : ContDiffAt ℝ ∞ (fun v => (heatNormalMetric g o e v).det) 0 := by
    simp only [Matrix.det_apply']
    apply ContDiffAt.sum
    intro σ _
    exact contDiffAt_const.mul
      (contDiffAt_prod fun i _ => heatNormalMetric_smoothAt_zero g o e (σ i) i)
  exact hd.sqrt (by rw [heatNormalMetric_zero, Matrix.det_one]; norm_num)

theorem heatNormalLeadingAmplitude_smoothAt_zero (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) :
    ContDiffAt ℝ ∞ (heatNormalLeadingAmplitude g o e) 0 := by
  have hJ : frameExponentialJacobian g o e 0 ≠ 0 := by
    rw [frameExponentialJacobian_zero]
    norm_num
  exact ((frameExponentialJacobian_smoothAt_zero g o e).sqrt hJ).inv
    (by rw [frameExponentialJacobian_zero]; norm_num)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual pulled-back metric and torsion-free coordinate connection.
Only two derivatives of the base map are needed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

def heatPullbackMetric (g : SmoothMetric M) (c : M) (F : FourSpace → FourSpace)
    (x : FourSpace) : Mat4 :=
  (jacobianMatrix F x)ᵀ * metricInChart g c (F x) * jacobianMatrix F x

def heatPullbackConnection (g : SmoothMetric M) (c : M) (F : FourSpace → FourSpace)
    (i : Fin 4) (x : FourSpace) : Mat4 :=
  pulledConnection (jacobianMatrix F x) (matrixPartial (jacobianMatrix F) i x)
    (weightedConnection (jacobianMatrix F x) (fun r => connectionMatrix g c r (F x)) i)

theorem heatPullbackConnection_torsion (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace) (hF : ContDiffAt ℝ 2 F x)
    (i j r : Fin 4) :
    heatPullbackConnection g c F i x r j = heatPullbackConnection g c F j x r i := by
  unfold heatPullbackConnection
  apply pulledConnection_torsion (jacobianMatrix F x)
    (fun k => matrixPartial (jacobianMatrix F) k x)
    (fun k => connectionMatrix g c k (F x))
  · intro a b k
    exact heatJacobian_partials_commute hF k a b
  · intro a b k
    exact christoffel_comm g c (F x) k a b

theorem heatPullbackMetric_regular (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace) (hF : ContDiffAt ℝ 2 F x)
    (hx : F x ∈ (chartAt FourSpace c).target) (i j : Fin 4) :
    ContDiffAt ℝ 1 (fun y => heatPullbackMetric g c F y i j) x := by
  simp only [heatPullbackMetric, Matrix.mul_apply, Matrix.transpose_apply]
  apply ContDiffAt.sum
  intro r _
  apply ContDiffAt.mul
  · apply ContDiffAt.sum
    intro s _
    exact (heatJacobian_entry_regular 1 hF s i).mul
      (((metricInChart_contDiffAt g c (F x) hx s r).of_le (by simp)).comp x
        (hF.of_le (by norm_num)))
  · exact heatJacobian_entry_regular 1 hF r j

theorem heatPullbackConnection_compatible (g : SmoothMetric M) (c : M)
    (F : FourSpace → FourSpace) (x : FourSpace) (hF : ContDiffAt ℝ 2 F x)
    (hx : F x ∈ (chartAt FourSpace c).target)
    (hJ : IsUnit (jacobianMatrix F x).det) (i : Fin 4) :
    matrixPartial (heatPullbackMetric g c F) i x =
      (heatPullbackConnection g c F i x)ᵀ * heatPullbackMetric g c F x +
        heatPullbackMetric g c F x * heatPullbackConnection g c F i x := by
  let J := jacobianMatrix F
  let H := fun y => metricInChart g c (F y)
  have hdF := hF.differentiableAt (by norm_num)
  have hdJ (r s : Fin 4) : DifferentiableAt ℝ (fun y => J y r s) x :=
    (heatJacobian_entry_regular 1 hF r s).differentiableAt one_ne_zero
  have hdH (r s : Fin 4) : DifferentiableAt ℝ (fun y => H y r s) x :=
    ((metricInChart_contDiffAt g c (F x) hx r s).differentiableAt (by simp)).comp x hdF
  have hrate : matrixPartial H i x =
      (weightedConnection (J x) (fun r => connectionMatrix g c r (F x)) i)ᵀ * H x +
        H x * weightedConnection (J x) (fun r => connectionMatrix g c r (F x)) i := by
    rw [matrixPartial_comp hdF (fun r s =>
      (metricInChart_contDiffAt g c (F x) hx r s).differentiableAt (by simp))]
    exact parallelFrame_metric_rate g c (F x) hx (fun r => J x r i)
  have hcongr : heatPullbackMetric g c F = fun y => (J y)ᵀ * (H y * J y) := by
    funext y
    exact Matrix.mul_assoc _ _ _
  rw [hcongr, matrixPartial_congruence J H x hdJ hdH i, hrate]
  simpa only [heatPullbackConnection, J, H, Matrix.mul_assoc] using
    (pulledConnection_metric_compatibility (H x) (J x)
    (matrixPartial J i x)
    (weightedConnection (J x) (fun r => connectionMatrix g c r (F x)) i) hJ).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! The scalar part of the Hodge complex has a genuine complete Hilbert
basis of shifted-Laplacian eigenvectors. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M] [SecondCountableTopology M]

local instance baseEigenbasis_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

abbrev ScalarBaseSpectralValue := Module.End.Eigenvalues (scalarBaseResolvent g o d).toLinearMap

abbrev ScalarBaseSpectralSpace (μ : ScalarBaseSpectralValue g o d) :=
  Module.End.eigenspace (scalarBaseResolvent g o d).toLinearMap μ.val

instance scalarBaseSpectralSpaceFinite (μ : ScalarBaseSpectralValue g o d) :
    FiniteDimensional ℝ (ScalarBaseSpectralSpace g o d μ) :=
  ContinuousLinearMap.finite_dimensional_eigenspace (scalarBaseResolvent_compact g o d) μ.val
    (scalarBaseResolvent_eigenvalue g o d μ.property).1.ne'

omit [SecondCountableTopology M] in
theorem scalarBaseSpectral_total :
    (⨆ μ : ScalarBaseSpectralValue g o d, ScalarBaseSpectralSpace g o d μ).topologicalClosure = ⊤ := by
  apply Submodule.orthogonal_eq_bot_iff.mp
  rw [Submodule.orthogonal_closure]
  change (⨆ μ : {μ // Module.End.eigenspace (scalarBaseResolvent g o d).toLinearMap μ ≠ ⊥},
    Module.End.eigenspace (scalarBaseResolvent g o d).toLinearMap μ.val)ᗮ = ⊥
  rw [iSup_ne_bot_subtype]
  exact ContinuousLinearMap.orthogonalComplement_iSup_eigenspaces_eq_bot
    (scalarBaseResolvent_compact g o d) (scalarBaseResolvent_symmetric g o d)

abbrev ScalarBaseEigenIndex :=
  Σ μ : ScalarBaseSpectralValue g o d, Fin (Module.finrank ℝ (ScalarBaseSpectralSpace g o d μ))

def scalarBaseEigenvector (i : ScalarBaseEigenIndex g o d) : Lp ℝ 2 (normalizedVolume g) :=
  (stdOrthonormalBasis ℝ (ScalarBaseSpectralSpace g o d i.1) i.2).val

theorem scalarBaseEigenvector_orthonormal : Orthonormal ℝ (scalarBaseEigenvector g o d) :=
  scalar_spectral_family_orthonormal (scalarBaseResolvent g o d)
    (scalarBaseResolvent_symmetric g o d)

theorem scalarBaseEigenvector_span :
    Submodule.span ℝ (Set.range (scalarBaseEigenvector g o d)) =
      ⨆ μ : ScalarBaseSpectralValue g o d, ScalarBaseSpectralSpace g o d μ := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact (le_iSup (fun μ => ScalarBaseSpectralSpace g o d μ) i.1)
      (stdOrthonormalBasis ℝ (ScalarBaseSpectralSpace g o d i.1) i.2).property
  · apply iSup_le
    intro μ x hx
    let b := stdOrthonormalBasis ℝ (ScalarBaseSpectralSpace g o d μ)
    have he := congrArg (ScalarBaseSpectralSpace g o d μ).subtype
      (b.sum_repr (⟨x, hx⟩ : ScalarBaseSpectralSpace g o d μ))
    simp only [map_sum, map_smul] at he
    change (∑ j, (b.repr ⟨x, hx⟩) j • (b j : Lp ℝ 2 (normalizedVolume g))) = x at he
    rw [← he]
    apply Submodule.sum_mem
    intro j _
    apply Submodule.smul_mem
    exact Submodule.subset_span ⟨⟨μ, j⟩, rfl⟩

def scalarBaseEigenbasis : HilbertBasis (ScalarBaseEigenIndex g o d) ℝ
    (Lp ℝ 2 (normalizedVolume g)) :=
  HilbertBasis.mk (scalarBaseEigenvector_orthonormal g o d) (by
    rw [scalarBaseEigenvector_span, scalarBaseSpectral_total])

theorem scalarBaseEigenvector_hasEigenvector (i : ScalarBaseEigenIndex g o d) :
    Module.End.HasEigenvector (scalarBaseResolvent g o d).toLinearMap i.1.val
      (scalarBaseEigenvector g o d i) := by
  refine ⟨(stdOrthonormalBasis ℝ (ScalarBaseSpectralSpace g o d i.1) i.2).property, ?_⟩
  have hn := (scalarBaseEigenvector_orthonormal g o d).1 i
  intro h
  rw [h, norm_zero] at hn
  exact zero_ne_one hn

end
end PositiveEinsteinFour.Geometry
end


section

/-! Exact subtraction identities for localized sources in the scalar
resolvent chain. Density weighting and affine pullback preserve the equation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set TemperedDistribution
open scoped Manifold ContDiff SchwartzMap

noncomputable section

theorem scalarAffinePullbackL2_sub (A : FourSpace ≃L[ℝ] FourSpace) (q : FourSpace)
    (u v : Lp ℝ 2 (volume : Measure FourSpace)) :
    scalarAffinePullbackL2 A q (u - v) =
      scalarAffinePullbackL2 A q u - scalarAffinePullbackL2 A q v := by
  have hq : Measure.QuasiMeasurePreserving (fun y : FourSpace => A y + q) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  apply Lp.ext
  filter_upwards [scalarAffinePullbackL2_coe A q (u - v),
    scalarAffinePullbackL2_coe A q u, scalarAffinePullbackL2_coe A q v,
    hq.ae_eq_comp (Lp.coeFn_sub u v),
    Lp.coeFn_sub (scalarAffinePullbackL2 A q u) (scalarAffinePullbackL2 A q v)]
    with x hsub hu hv he hp
  exact hsub.trans (he.trans ((congrArg₂ (· - ·) hu hv).symm.trans hp.symm))

theorem scalarComplexL2_sub_distribution (u v : Lp ℝ 2 (volume : Measure FourSpace)) :
    (scalarComplexL2 (u - v) : 𝓢'(FourSpace, ℂ)) =
      (scalarComplexL2 u : 𝓢'(FourSpace, ℂ)) - (scalarComplexL2 v : 𝓢'(FourSpace, ℂ)) := by
  have he : scalarComplexL2 (u - v) = scalarComplexL2 u - scalarComplexL2 v :=
    (Complex.ofRealCLM.compLpₗ (p := 2) (μ := volume)).map_sub u v
  rw [he]
  exact (Lp.toTemperedDistributionCLM ℂ volume 2).map_sub _ _

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance iteratedSource_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (ht : tsupport χ ⊆ (chartAt FourSpace c).target)

theorem scalarWeightedChartL2_sub (u v : scalarH1 d) :
    scalarWeightedChartL2 g o d c hc ht (u - v) χ hχ hc (Subset.refl _) =
      scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _) -
        scalarWeightedChartL2 g o d c hc ht v χ hχ hc (Subset.refl _) := by
  let P := scalarLocalL2ProductCLM hc.measurableSet
    (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ ht).continuous hc.mul_right
    (tsupport_mul_subset_left.trans (Subset.refl _))
  change P (scalarH1ChartValue g o d c hc ht (u - v)) =
    P (scalarH1ChartValue g o d c hc ht u) - P (scalarH1ChartValue g o d c hc ht v)
  rw [map_sub, map_sub]

theorem scalarRescaledDifferenceSource (u v : scalarH1 d)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) :
    scalarRescaledSourceL2 g c (scalarH1BaseValue g o d (u - v)) χ hχ hc ht z₀ r hr =
      r ^ 2 • (scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
        (scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)) -
      scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
        (scalarWeightedChartL2 g o d c hc ht v χ hχ hc (Subset.refl _))) := by
  rw [scalarRescaledSourceL2, scalarChartSourceL2_baseValue,
    scalarWeightedChartL2_sub, scalarAffinePullbackL2_sub]

end
end PositiveEinsteinFour.Geometry
end


section

/-! All integer local regularity for actual scalar weak eigenfunctions.
The eigenvalue becomes a compact zeroth-order coefficient; no regularity premise is added. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance localEigenRegularity_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_eigen_local_all_orders (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (u : scalarH1 d) (κ : ℝ)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        κ * inner ℝ (scalarH1BaseValue g o d u) (scalarH1BaseValue g o d v)) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure V),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d u
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w ∧
        ∀ (n : ℕ) (φ : S), HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
          MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
  let f := scalarH1BaseValue g o d (-κ • u)
  have hwp : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f) (scalarH1Value d v)) := by
    intro v
    dsimp only [f]
    rw [scalarH1BaseValue_spec, map_smul, real_inner_smul_left]
    have hi := (scalarBasePullback g o).inner_map_map (scalarH1BaseValue g o d u)
      (scalarH1BaseValue g o d v)
    rw [scalarH1BaseValue_spec, scalarH1BaseValue_spec] at hi
    rw [hi]
    simpa only [neg_mul, neg_neg] using hw v
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := scalarRescaledSourceL2 g c f χ hχ hc ht z₀ r hr.ne'
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d f u hwp c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c f χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  have htests (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ =
        ∫ y, φ y * ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F w a b
      (ball 0 1) hA hB hreal φ hφc hφs (scalar_real_L2_test_integrable F φ _)
  have hFeq : F = (r ^ 2 * (-κ)) • w :=
    scalarRescaledEigenSource g o d c χ hχ hc ht (-κ) u z₀ r hr.ne'
  let k : ℝ := -((2 * Real.pi) ^ 2)⁻¹ * (r ^ 2 * (-κ))
  have htestEigen (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ = (k : ℂ) * (scalarComplexL2 w : T) φ :=
    (htests φ hφc hφs).trans (scalar_eigen_source_pairing w F
      (-((2 * Real.pi) ^ 2)⁻¹) (r ^ 2 * (-κ)) hFeq φ)
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, w, ?_, ?_⟩
  ·
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ w₀
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w y = w₀ (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm
  · intro n φ hφc hφs
    exact scalar_eigen_all_integer_orders a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b) (scalarEigenCutoff k)
      (k : ℂ) (scalarEigenCutoff_on_ball k) (scalarComplexL2 w : T) hW htestEigen
      (1 / 2) (by norm_num) (by norm_num) n φ hφc hφs

end
end PositiveEinsteinFour.Geometry
end


section

/-! The positive Euler source, including its density and linear term,
has the local H2 regularity required by the elliptic gain. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped SchwartzMap ENNReal ContDiff

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)
local notation "C2" => Lp ℂ 2 (volume : Measure V)

theorem scalar_local_H2_nonlinear_source (ρ b : V → ℝ)
    (w : Lp ℝ 2 (volume : Measure V))
    (heq : (fun y => ρ y * b y) =ᵐ[volume.restrict (ball (0 : V) 1)] w)
    (hreg : ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
      tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
      MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)))
    (hρ : ∀ y ∈ closedBall (0 : V) (1 / 2), ContDiffAt ℝ ∞ ρ y)
    (hρ0 : ∀ y ∈ closedBall (0 : V) (1 / 2), ρ y ≠ 0)
    (a B q A C : ℝ) (ha : 0 < a) (hB : 0 ≤ B)
    (hRange : ∀ x ∈ closedBall (0 : V) (1 / 2), b x ∈ Icc a B)
    (F : C2)
    (hF : (F : V → ℂ) =ᵐ[volume.restrict (ball (0 : V) (1 / 2))]
      fun y => (ρ y * (A * b y + C * (b y) ^ q) : ℝ))
    (ψ : S) (hc : HasCompactSupport (ψ : V → ℂ))
    (hs : tsupport (ψ : V → ℂ) ⊆ ball 0 (1 / 2)) :
    MemSobolev 2 2 (smulLeftCLM ℂ ψ (F : T)) := by
  obtain ⟨η, hη, hηc, hηs, hone⟩ := scalar_half_ball_cutoff_of_compact hc hs
  have hinv (y : V) (hy : y ∈ closedBall (0 : V) (1 / 2)) :
      ContDiffAt ℝ ∞ (fun y => (ρ y)⁻¹) y := (hρ y hy).inv (hρ0 y hy)
  let ηS : 𝓢(V, ℝ) := hηc.toSchwartzMap hη
  have hηSs : tsupport (ηS : V → ℝ) ⊆ ball 0 (1 / 2) := hηs
  obtain ⟨v₁, hv₁, he₁⟩ := scalar_local_H2_power_source ρ b w heq hreg hinv hρ0
    a B 1 ha hB hRange ηS hηc hηSs
  obtain ⟨vq, hvq, heq'⟩ := scalar_local_H2_power_source ρ b w heq hreg hinv hρ0
    a B q ha hB hRange ηS hηc hηSs
  let z : C2 := (A : ℂ) • scalarComplexL2 v₁ + (C : ℂ) • scalarComplexL2 vq
  have hz : (z : T) = (A : ℂ) • (scalarComplexL2 v₁ : T) +
      (C : ℂ) • (scalarComplexL2 vq : T) := by
    change (Lp.toTemperedDistributionCLM ℂ volume 2) _ = _
    rw [map_add, map_smul, map_smul]
    rfl
  have hz2 : MemSobolev 2 2 (z : T) := by
    rw [hz]
    exact (hv₁.smul (A : ℂ)).add (hvq.smul (C : ℂ))
  let θ : S := scalarCutoffSchwartz η ρ hη hηc
    (fun y hy => hρ y (ball_subset_closedBall (hηs hy)))
  let Γ : S := SchwartzMap.smulLeftCLM ℂ θ ψ
  have hΓ (y : V) : Γ y = ((η y * ρ y : ℝ) : ℂ) * ψ y := by
    simp only [Γ, SchwartzMap.smulLeftCLM_apply θ.hasTemperateGrowth, smul_eq_mul]
    rfl
  have hzeq : (z : V → ℂ) =ᵐ[volume] fun y =>
      (A * (η y * b y) + C * (η y * (b y) ^ q) : ℝ) := by
    filter_upwards [Lp.coeFn_add ((A : ℂ) • scalarComplexL2 v₁)
        ((C : ℂ) • scalarComplexL2 vq),
      Lp.coeFn_smul (A : ℂ) (scalarComplexL2 v₁),
      Lp.coeFn_smul (C : ℂ) (scalarComplexL2 vq),
      scalarComplexL2_coe v₁, scalarComplexL2_coe vq, he₁, heq']
      with y hz ha hc h₁ hq hv₁ hvq
    change ((A : ℂ) • scalarComplexL2 v₁ + (C : ℂ) • scalarComplexL2 vq) y = _
    rw [hz]
    simp only [Pi.add_apply]
    rw [ha, hc]
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [h₁, hq, hv₁, hvq]
    simp only [ηS, Real.rpow_one, Complex.ofReal_add, Complex.ofReal_mul]
    rfl
  have hidentity : smulLeftCLM ℂ ψ (F : T) = smulLeftCLM ℂ Γ (z : T) := by
    ext φ
    simp only [smulLeftCLM_apply_apply, Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [(ae_restrict_iff' isOpen_ball.measurableSet).mp hF, hzeq]
      with y hf hz
    simp only [SchwartzMap.smulLeftCLM_apply ψ.hasTemperateGrowth,
      SchwartzMap.smulLeftCLM_apply Γ.hasTemperateGrowth, smul_eq_mul, hΓ, hz]
    by_cases hy : ψ y = 0
    · simp only [hy, mul_zero, zero_mul]
    · have hys := subset_tsupport (ψ : V → ℂ) hy
      rw [hf (hs hys), hone y hys]
      simp only [one_mul, Complex.ofReal_add, Complex.ofReal_mul]
      ring
  rw [hidentity]
  simpa only [Nat.cast_ofNat] using scalar_memSobolev_schwartz_multiplier 2 Γ (z : T)
    (by simpa only [Nat.cast_ofNat] using hz2)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Global smooth representatives of the actual intrinsic weak Poisson
solutions, obtained from the proved local coordinate regularity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance poissonRegularity_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance poissonRegularity_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

theorem scalar_weak_poisson_smooth_representative (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : SmoothScalar (M := M)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (smoothScalarValueL2 g (canonicalFrameMeasure g o) f)
          (scalarH1Value d v))) :
    ∃ F : SmoothScalar (M := M), scalarH1Value d u =
      smoothScalarValueL2 g (canonicalFrameMeasure g o) F := by
  let b := scalarH1BaseValue g o d u
  have hlocal (x : M) : ∃ U : Set M, ∃ F : M → ℝ,
      IsOpen U ∧ x ∈ U ∧ ContMDiffOn I4 𝓘(ℝ, ℝ) ∞ F U ∧
        (b : M → ℝ) =ᵐ[(normalizedVolume g).restrict U] F := by
    let z₀ : ChartTarget x := ⟨chartAt FourSpace x x,
      (chartAt FourSpace x).map_source (mem_chart_source FourSpace x)⟩
    obtain ⟨U, hU, hxU, _, F, hF, he⟩ := scalar_local_chart_smooth g o d f u hw x z₀
    let W := (chartAt FourSpace x).source ∩ (chartAt FourSpace x) ⁻¹' U
    refine ⟨W, fun y => F (chartAt FourSpace x y),
      (chartAt FourSpace x).isOpen_inter_preimage hU, ⟨mem_chart_source FourSpace x, hxU⟩,
      ?_, scalar_chart_representative_ae g x U hU b F he⟩
    intro y hy
    have hFC : ContDiffAt ℝ (⊤ : ℕ∞) F (chartAt FourSpace x y) :=
      (hF _ hy.2).contDiffAt (hU.mem_nhds hy.2)
    exact (hFC.contMDiffAt.comp y
      (contMDiffAt_of_mem_maximalAtlas (IsManifold.chart_mem_maximalAtlas x) hy.1)).contMDiffWithinAt
  obtain ⟨F, hF⟩ := scalar_smooth_representative_of_local g b hlocal
  have hb : smoothScalarBaseL2 g F = b := by
    apply Lp.ext
    have hcoe := ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) (normalizedVolume g)
      (⟨F.val, F.property.continuous⟩ : C(M, ℝ))
    filter_upwards [hcoe, hF] with x hx hFx
    exact hx.trans hFx
  refine ⟨F, ?_⟩
  rw [← scalarH1BaseValue_spec g o d u]
  change scalarBasePullback g o b = _
  rw [← hb, scalarBasePullback_smooth]

theorem actual_petersen_poisson [SecondCountableTopology M] [PreconnectedSpace M]
    (g : SmoothMetric M) (o : FrameOrientation g) (hRic : RicciThree g) :
    PetersenPoissonInput g (canonicalFrameMeasure g o) := by
  intro a ha
  let a₀ : SmoothScalar (M := M) := ⟨a, ha⟩
  let d := canonicalParallelMetricData g o hRic
  obtain ⟨u, _, hw⟩ := actual_scalar_weak_poisson g o hRic a₀
  obtain ⟨F, hF⟩ := scalar_weak_poisson_smooth_representative g o d
    (smoothScalarSubtractMean (μ := canonicalFrameMeasure g o) a₀) u.val hw
  refine ⟨F.val, F.property, ?_⟩
  exact scalar_poisson_pointwise_of_smooth_representative g o hRic a₀ F u.val hF hw

end
end PositiveEinsteinFour.Geometry
end


section

/-! Real parts and real representatives preserve the finite integer Sobolev
orders used in the localized Euler bootstrap. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "C2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)

theorem scalar_realPart_memSobolev_integer (n : ℕ) (u : C2)
    (hu : MemSobolev (n : ℝ) 2 (u : T)) :
    MemSobolev (n : ℝ) 2 (scalarComplexL2 (Complex.reCLM.compLp u) : T) := by
  obtain ⟨v, fs, _, _, hf, hG, _, _⟩ := scalar_integer_smooth_approximation n u hu
  let R := Complex.reCLM.compLpL 2 (volume : Measure V)
  let G := fun is : List (Fin 4) => if h : is.length ≤ n then R (scalarBesselJetL2 n is h v) else 0
  apply scalar_real_integer_jets_closed n (fun k => (fs k).postcompCLM Complex.reCLM) (R u) G
  · simp only [scalarSchwartz_re_toLp]
    exact R.continuous.continuousAt.tendsto.comp hf
  · intro is hs
    simp only [scalarRealSchwartzJet_re, scalarSchwartz_re_toLp, G, dite_eq_left hs]
    exact R.continuous.continuousAt.tendsto.comp (hG is hs)

theorem scalar_real_integer_realization (n : ℕ) (u : C2)
    (hu : MemSobolev (n : ℝ) 2 (u : T)) (b : V → ℝ)
    (hb : (u : V → ℂ) =ᵐ[volume] fun x => (b x : ℂ)) :
    ∃ v : Lp ℝ 2 (volume : Measure V), MemSobolev (n : ℝ) 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] b := by
  refine ⟨Complex.reCLM.compLp u, scalar_realPart_memSobolev_integer n u hu, ?_⟩
  filter_upwards [Complex.reCLM.coeFn_compLp u, hb] with x hr hx
  rw [hr, hx]
  rfl

end
end PositiveEinsteinFour.Geometry
