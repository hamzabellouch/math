section

/-! The lifted tensor's pairing is the intrinsic normal-frame pairing
at the base point. No choice of reference-frame regularity is needed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_euclideanTensor_inner (T U : CovariantCoordinates 2) :
    inner ℝ (WithLp.toLp 2 T : TwoTensorEuclidean) (WithLp.toLp 2 U) =
      frameTensorPairing T U := by
  change (∑ a, inner ℝ (T a) (U a)) = _
  simp only [RCLike.inner_apply, conj_trivial, frameTensorPairing, mul_comm]

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]
  {g : SmoothMetric M} {o : FrameOrientation g} {c : M} {e : FrameBundle g}

theorem heatNormalLift_pairing (D : HeatNormalFrameData g o c e)
    (C : OpenPartialHomeomorph FourSpace M)
    (hE : EqOn C (frameExponential g o e) C.source)
    (hCt : C.target ⊆ (chartAt FourSpace c).source)
    (hD : C.source ⊆ Metric.ball 0 D.radius)
    (a : FourSpace → TwoFormFour) (v : M → TwoFormFour) (f : FrameBundle g) :
    inner ℝ (WithLp.toLp 2
      (heatNormalFrameTensorLift g c C (heatNormalCoordinateTensor D a) f) : TwoTensorEuclidean)
      (WithLp.toLp 2 (twoFormFramedValue o v f)) =
    2 * heatNormalScalarLift C
      (fun x => inner ℝ (a x) (heatNormalTwoFormValue o c D.point v x)) f.base := by
  classical
  rw [heat_euclideanTensor_inner]
  by_cases hf : f.base ∈ C.target
  · let x := C.symm f.base
    have hx : x ∈ C.source := C.map_target hf
    have hxb := hD hx
    have hbase : (D.point x).1 = chartAt FourSpace c f.base := by
      rw [D.exponential x hxb, ← hE hx, C.right_inv hf]
    have hF := frameChartMatrix_normalizes g c f (hCt hf)
    rw [← hbase] at hF
    rw [heatNormalFrameTensorLift, ite_eq_left hf, heatNormalScalarLift_on_target C _ hf,
      heatNormalCoordinateTensor, heat_framedValue_chart o v c f (hCt hf)]
    change frameTensorPairing
      (frameTensor (frameChartMatrix g c f) (frameTensor (D.point x).2⁻¹ (twoFormTensor (a x))))
      (frameTensor (frameChartMatrix g c f) (twoFormCoordinates o v c (chartAt FourSpace c f.base))) = _
    rw [← hbase, heat_normal_frame_pairing _ _ _ (D.orthonormal x hxb) hF,
      ← heatNormalTwoFormValue_tensor, twoFormTensor_pairing]
  · rw [heatNormalFrameTensorLift, ite_eq_right hf, heatNormalScalarLift]
    rw [ite_eq_right hf]
    simp only [frameTensorPairing, Pi.zero_apply, zero_mul, Finset.sum_const_zero, mul_zero]

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite smooth extensions of the actual normal-frame bundle coefficients. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

structure HeatNormalOneExtension {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) where
  base : HeatNormalExtension 10 g o e
  B : FourSpace → Fin 4 → Mat4
  C : FourSpace → Mat4
  B_regular : ∀ i k l, ContDiff ℝ 10 (fun x => B x i k l)
  C_regular : ∀ k l, ContDiff ℝ 10 (fun x => C x k l)
  B_near : B =ᶠ[𝓝 0] heatNormalOneFirst D
  C_near : C =ᶠ[𝓝 0] heatNormalOneZero D

theorem exists_heatNormalOneExtension {g : SmoothMetric M} {o : FrameOrientation g}
    {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e) :
    Nonempty (HeatNormalOneExtension D) := by
  obtain ⟨base⟩ := exists_heatNormalExtension 10 g o e
  choose B hB hBc hBe using fun i k l => heatScalar_extension 10
    (fun x => heatNormalOneFirst D x i k l)
    ((D.oneFirst_regular i k l).of_le (by norm_num))
  choose C hC hCc hCe using fun k l => heatScalar_extension 10
    (fun x => heatNormalOneZero D x k l) (D.oneZero_regular k l)
  refine ⟨{
    base := base
    B := fun x i k l => B i k l x
    C := fun x k l => C k l x
    B_regular := hB
    C_regular := hC
    B_near := ?_
    C_near := ?_ }⟩
  · have h := eventually_all.mpr (fun i => eventually_all.mpr
      (fun k => eventually_all.mpr (fun l => hBe i k l)))
    filter_upwards [h] with x hx
    funext i k l
    exact hx i k l
  · have h := eventually_all.mpr (fun k => eventually_all.mpr (fun l => hCe k l))
    filter_upwards [h] with x hx
    funext k l
    exact hx k l

theorem HeatNormalOneExtension.radial_near {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} {D : HeatNormalFrameData g o c e}
    (E : HeatNormalOneExtension D) (hRic : RicciThree g) (he : e ∈ o.positive) :
    ∀ᶠ x in 𝓝 (0 : FourSpace), ∀ k l : Fin 4,
      (∑ i : Fin 4, x i * E.B x i k l) = 0 := by
  filter_upwards [E.B_near, D.oneFirst_radial_near hRic he] with x hx hrad
  simpa only [hx] using hrad

end
end PositiveEinsteinFour.Geometry
end


section

/-! The radial gauge forces the connection and its diagonal derivatives
to vanish at the center. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped BigOperators Manifold ContDiff _root_.Topology Matrix.Norms.Elementwise

noncomputable section

theorem heat_radial_axis_zero (f : FourSpace → ℝ) (i : Fin 4)
    (hf : ContinuousAt f 0)
    (h : ∀ᶠ t : ℝ in 𝓝 0, t * f (t • coordinateVector i) = 0) :
    (fun t : ℝ => f (t • coordinateVector i)) =ᶠ[𝓝 0] fun _ => 0 := by
  have hc : ContinuousAt (fun t : ℝ => f (t • coordinateVector i)) 0 := by
    have hc : ContinuousAt (fun t : ℝ => t • coordinateVector i) 0 :=
      (continuous_id.smul continuous_const).continuousAt
    have ht : Tendsto (fun t : ℝ => t • coordinateVector i) (𝓝 0) (𝓝 (0 : FourSpace)) := by
      simpa only [zero_smul] using hc.tendsto
    change Tendsto (fun t : ℝ => f (t • coordinateVector i)) (𝓝 0)
      (𝓝 (f ((0 : ℝ) • coordinateVector i)))
    simpa only [Function.comp_def, zero_smul] using hf.tendsto.comp ht
  have hne : (fun t : ℝ => f (t • coordinateVector i)) =ᶠ[𝓝[≠] 0] fun _ => 0 := by
    filter_upwards [h.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht hn
    exact (mul_eq_zero.mp ht).resolve_left hn
  have hlim : Tendsto (fun t : ℝ => f (t • coordinateVector i)) (𝓝[≠] 0) (𝓝 (f 0)) := by
    simpa only [zero_smul] using hc.tendsto.mono_left nhdsWithin_le_nhds
  have hz : f 0 = 0 := tendsto_nhds_unique hlim (tendsto_const_nhds.congr' hne.symm)
  filter_upwards [h] with t ht
  by_cases htz : t = 0
  · simpa only [htz, zero_smul] using hz
  · exact (mul_eq_zero.mp ht).resolve_left htz

theorem heat_radial_connection_axis (A : Fin 4 → FourSpace → HeatMat6)
    (hA : ∀ i k l, ContinuousAt (fun x => A i x k l) 0)
    (h : ∀ᶠ x in 𝓝 (0 : FourSpace), (∑ i : Fin 4, x i • A i x) = 0)
    (i : Fin 4) (k l : Fin 6) :
    (fun t : ℝ => A i (t • coordinateVector i) k l) =ᶠ[𝓝 0] fun _ => 0 := by
  apply heat_radial_axis_zero _ i (hA i k l)
  have hc : ContinuousAt (fun t : ℝ => t • coordinateVector i) 0 :=
    (continuous_id.smul continuous_const).continuousAt
  have hct : Tendsto (fun t : ℝ => t • coordinateVector i) (𝓝 0) (𝓝 (0 : FourSpace)) := by
    simpa only [zero_smul] using hc.tendsto
  have hp : ∀ᶠ t : ℝ in 𝓝 0,
      (∑ j : Fin 4, (t • coordinateVector i) j • A j (t • coordinateVector i)) = 0 := by
    exact hct.eventually h
  filter_upwards [hp] with t ht
  have he := congrArg (fun B : HeatMat6 => B k l) ht
  have hes : (∑ j : Fin 4, (t • coordinateVector i) j * A j (t • coordinateVector i) k l) = 0 := by
    simpa only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply] using he
  simpa [coordinateVector, PiLp.single_apply, PiLp.smul_apply] using hes

theorem heat_radial_connection_center (A : Fin 4 → FourSpace → HeatMat6)
    (hA : ∀ i k l, ContinuousAt (fun x => A i x k l) 0)
    (h : ∀ᶠ x in 𝓝 (0 : FourSpace), (∑ i : Fin 4, x i • A i x) = 0) (i : Fin 4) :
    A i 0 = 0 := by
  ext k l
  change A i 0 k l = 0
  simpa only [zero_smul] using (heat_radial_connection_axis A hA h i k l).self_of_nhds

theorem heat_radial_connection_diagonal (A : Fin 4 → FourSpace → HeatMat6)
    (hA : ∀ i k l, DifferentiableAt ℝ (fun x => A i x k l) 0)
    (h : ∀ᶠ x in 𝓝 (0 : FourSpace), (∑ i : Fin 4, x i • A i x) = 0)
    (i : Fin 4) (k l : Fin 6) : partialDeriv (fun x => A i x k l) i 0 = 0 := by
  have hx := heat_radial_connection_axis A (fun i k l => (hA i k l).continuousAt) h i k l
  have hcurve : HasDerivAt (fun t : ℝ => t • coordinateVector i) (coordinateVector i) 0 := by
    have hc := (ContinuousLinearMap.toSpanSingleton ℝ (coordinateVector i)).hasFDerivAt.comp_hasDerivAt
      0 (hasDerivAt_id (0 : ℝ))
    simpa only [ContinuousLinearMap.toSpanSingleton_apply, one_smul, Function.comp_def, id_eq] using! hc
  have hf : HasDerivAt (fun t : ℝ => A i (t • coordinateVector i) k l)
      (partialDeriv (fun x => A i x k l) i 0) 0 := by
    have hf' : HasFDerivAt (fun x => A i x k l) (fderiv ℝ (fun x => A i x k l) 0)
        ((0 : ℝ) • coordinateVector i) := by simpa only [zero_smul] using (hA i k l).hasFDerivAt
    simpa only [partialDeriv] using! hf'.comp_hasDerivAt 0 hcurve
  have hd : deriv (fun t : ℝ => A i (t • coordinateVector i) k l) 0 = 0 := by
    rw [hx.deriv_eq]
    exact deriv_const _ _
  rwa [hf.deriv] at hd

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem HeatNormalFrameData.twoForm_connection_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i : Fin 4) : heatTwoFormConnection g c D.point i 0 = 0 := by
  apply heat_radial_connection_center
  · intro i k l
    exact (D.twoForm_connection_regular i k l).continuousAt
  · filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    exact D.twoForm_connection_radial x hx

theorem HeatNormalFrameData.twoForm_connection_diagonal_zero {g : SmoothMetric M}
    {o : FrameOrientation g} {c : M} {e : FrameBundle g} (D : HeatNormalFrameData g o c e)
    (i : Fin 4) (k l : Fin 6) :
    partialDeriv (fun x => heatTwoFormConnection g c D.point i x k l) i 0 = 0 := by
  apply heat_radial_connection_diagonal
  · intro i k l
    exact (D.twoForm_connection_regular i k l).differentiableAt (by norm_num)
  · filter_upwards [Metric.ball_mem_nhds (0 : FourSpace) D.radius_pos] with x hx
    exact D.twoForm_connection_radial x hx

end
end PositiveEinsteinFour.Geometry
end


