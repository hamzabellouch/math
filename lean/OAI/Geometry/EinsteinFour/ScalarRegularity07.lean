section

/-! Local coordinate derivatives control the intrinsic weak frame derivatives.
Both sides are continuous L2 maps, so the smooth estimate passes to H1. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance frameLocalization_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

/-- The localized weak coordinate derivative, reconstructed in the base volume. -/
def scalarH1LocalizedCoordinate (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source)
    (i : Fin 4) : scalarH1 d →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
      (scalarChartSupport_subset c ρ hs)).comp
    ((scalarLocalL2ProductCLM (scalarChartSupport_compact c ρ hs).isClosed.measurableSet
      (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ hs).continuous
      (scalarChartCutoff_compact c ρ hs) (scalarChartCutoff_support c ρ hs)).comp
      (scalarH1ChartDerivative g o d c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs) i))

theorem scalarH1LocalizedCoordinate_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source)
    (i : Fin 4) (a : SmoothScalar (M := M)) :
    scalarH1LocalizedCoordinate g o d c ρ hs i (smoothScalarToH1 d a) =ᵐ[normalizedVolume g]
      fun x => ρ.val x * partialDeriv (fun z => a.val ((chartAt FourSpace c).symm z)) i
        (chartAt FourSpace c x) := by
  let K := scalarChartSupport c ρ
  let χ := scalarChartCutoff c ρ
  let D := scalarLocalL2ProductCLM (scalarChartSupport_compact c ρ hs).isClosed.measurableSet
    χ (scalarChartCutoff_smooth c ρ hs).continuous (scalarChartCutoff_compact c ρ hs)
    (scalarChartCutoff_support c ρ hs)
  have he : D (scalarH1ChartDerivative g o d c (scalarChartSupport_compact c ρ hs)
      (scalarChartSupport_subset c ρ hs) i (smoothScalarToH1 d a)) =ᵐ[volume]
      (fun z => χ z * partialDeriv (fun y => a.val ((chartAt FourSpace c).symm y)) i z) := by
    rw [scalarH1ChartDerivative_smooth]
    exact (scalarLocalL2ProductCLM_coe ..).trans
      (scalarLocalL2Product_ae_congr (scalarChartSupport_compact c ρ hs).isClosed.measurableSet
        χ (scalarChartCutoff_support c ρ hs)
        (MemLp.coeFn_toLp (scalarCoordinate_gradient_memLp g c
          (scalarChartSupport_compact c ρ hs) (scalarChartSupport_subset c ρ hs) a i)))
  have hr := scalarChartReconstructionFun_ae g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs) he
  have hc := scalarChartReconstruction_coe g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs)
    (D (scalarH1ChartDerivative g o d c (scalarChartSupport_compact c ρ hs)
      (scalarChartSupport_subset c ρ hs) i (smoothScalarToH1 d a)))
  filter_upwards [hc, hr] with x hx hx'
  rw [show scalarH1LocalizedCoordinate g o d c ρ hs i (smoothScalarToH1 d a) x =
    scalarChartReconstructionFun c K
      (fun z => χ z * partialDeriv (fun y => a.val ((chartAt FourSpace c).symm y)) i z) x
    from hx.trans hx']
  by_cases hxK : x ∈ (chartAt FourSpace c).symm '' K
  · obtain ⟨z, hz, rfl⟩ := hxK
    rw [scalarChartReconstructionFun_chart c (scalarChartSupport_subset c ρ hs) _ hz,
      (chartAt FourSpace c).right_inv (scalarChartSupport_subset c ρ hs hz)]
    congr 1
    exact indicator_of_mem (scalarChartSupport_subset c ρ hs hz) _
  · have hρ : ρ.val x = 0 := by
      by_contra hn
      have hxt := hs (subset_tsupport ρ.val hn)
      apply hxK
      exact ⟨chartAt FourSpace c x, ⟨x, subset_tsupport ρ.val hn, rfl⟩,
        (chartAt FourSpace c).left_inv hxt⟩
    simp only [scalarChartReconstructionFun, indicator_of_notMem hxK, hρ, zero_mul]

/-- Actual frame gradient multiplied by a smooth base cutoff. -/
def scalarH1LocalizedFrame (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (ρ : SmoothScalar (M := M)) {B : ℝ} (hB : ∀ x, |ρ.val x| ≤ B) (i : Fin 4) :
    scalarH1 d →L[ℝ] ScalarL2 g (canonicalFrameMeasure g o) :=
  (scalarL2BoundedMultiplier (fun e : FrameBundle g => ρ.val e.base)
    (ρ.property.continuous.comp (continuous_frameBase g)).aestronglyMeasurable
    (fun e => hB e.base)).comp (scalarH1Gradient d i)

theorem scalarH1LocalizedFrame_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (ρ : SmoothScalar (M := M)) {B : ℝ} (hB : ∀ x, |ρ.val x| ≤ B) (i : Fin 4)
    (a : SmoothScalar (M := M)) :
    scalarH1LocalizedFrame g o d ρ hB i (smoothScalarToH1 d a) =ᵐ[canonicalFrameMeasure g o]
      fun e => ρ.val e.base * scalarGradient g a.val e i := by
  have hc := scalarL2BoundedMultiplier_coe (fun e : FrameBundle g => ρ.val e.base)
    (ρ.property.continuous.comp (continuous_frameBase g)).aestronglyMeasurable
    (fun e => hB e.base) (scalarH1Gradient d i (smoothScalarToH1 d a))
  have hg : scalarH1Gradient d i (smoothScalarToH1 d a) =ᵐ[canonicalFrameMeasure g o]
      fun e => scalarGradient g a.val e i := by
    rw [scalarH1Gradient_smooth]
    exact ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℝ) _ (smoothScalarGradient d i a)
  exact hc.trans (hg.mono (fun e he => congrArg (ρ.val e.base * ·) he))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The explicit localized Hessian formula in L2. Every product on the
right is an actual bounded multiplier or an L4-times-L4 product. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory
open scoped SchwartzMap ENNReal ContDiff LineDeriv NNReal

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalarRealSchwartzSecond_apply (f : S) (i j : Fin 4) (x : V) :
    D i (D j f) x = partialDeriv (fun y => partialDeriv f j y) i x := by
  rw [scalarRealSchwartzDerivative_apply]
  rw [show ((D j f : S) : V → ℝ) = (fun y => partialDeriv f j y) by
    funext y
    exact scalarRealSchwartzDerivative_apply f j y]

theorem scalarLocalizedCompose_second_L2 (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) {C : ℝ≥0} (hLip : LipschitzWith C φ)
    (hzero : φ 0 = 0) {B₁ B₂ : ℝ} (h₁ : ∀ s, |deriv φ s| ≤ B₁)
    (h₂ : ∀ s, |deriv (deriv φ) s| ≤ B₂) (f : S) (i j : Fin 4) :
    (D i (D j (scalarLocalizedCompose χ hc φ hφ f))).toLp 2 volume =
      scalarRealSchwartzMultiply (D i (D j χ)) (hLip.compLp hzero (f.toLp 2 volume)) +
      scalarRealSchwartzMultiply (D j χ)
        (scalarDerivativeMultiplier φ hφ h₁ f f.continuous.aestronglyMeasurable
          ((D i f).toLp 2 volume)) +
      scalarRealSchwartzMultiply (D i χ)
        (scalarDerivativeMultiplier φ hφ h₁ f f.continuous.aestronglyMeasurable
          ((D j f).toLp 2 volume)) +
      scalarRealSchwartzMultiply χ
        (scalarCompositionHessian φ hφ h₁ h₂ f f.continuous.aestronglyMeasurable
          ((D i f).toLp 4 volume) ((D j f).toLp 4 volume) ((D i (D j f)).toLp 2 volume)) := by
  let v := hLip.compLp hzero (f.toLp 2 volume)
  let t₁ := scalarDerivativeMultiplier φ hφ h₁ f f.continuous.aestronglyMeasurable
    ((D i f).toLp 2 volume)
  let t₂ := scalarDerivativeMultiplier φ hφ h₁ f f.continuous.aestronglyMeasurable
    ((D j f).toLp 2 volume)
  let q := scalarCompositionHessian φ hφ h₁ h₂ f f.continuous.aestronglyMeasurable
    ((D i f).toLp 4 volume) ((D j f).toLp 4 volume) ((D i (D j f)).toLp 2 volume)
  let A := scalarRealSchwartzMultiply (D i (D j χ)) v
  let B := scalarRealSchwartzMultiply (D j χ) t₁
  let C := scalarRealSchwartzMultiply (D i χ) t₂
  let E := scalarRealSchwartzMultiply χ q
  apply Lp.ext
  filter_upwards [(D i (D j (scalarLocalizedCompose χ hc φ hφ f))).coeFn_toLp 2 volume,
    Lp.coeFn_add (A + B + C) E, Lp.coeFn_add (A + B) C, Lp.coeFn_add A B,
    scalarRealSchwartzMultiply_coe (D i (D j χ)) v,
    scalarRealSchwartzMultiply_coe (D j χ) t₁,
    scalarRealSchwartzMultiply_coe (D i χ) t₂,
    scalarRealSchwartzMultiply_coe χ q,
    scalarDerivativeMultiplier_coe φ hφ h₁ f f.continuous.aestronglyMeasurable
      ((D i f).toLp 2 volume),
    scalarDerivativeMultiplier_coe φ hφ h₁ f f.continuous.aestronglyMeasurable
      ((D j f).toLp 2 volume),
    scalarCompositionHessian_coe φ hφ h₁ h₂ f f.continuous.aestronglyMeasurable
      ((D i f).toLp 4 volume) ((D j f).toLp 4 volume) ((D i (D j f)).toLp 2 volume),
    hLip.coeFn_compLp hzero (f.toLp 2 volume), f.coeFn_toLp 2 volume,
    (D i f).coeFn_toLp 2 volume, (D j f).coeFn_toLp 2 volume,
    (D i f).coeFn_toLp 4 volume, (D j f).coeFn_toLp 4 volume,
    (D i (D j f)).coeFn_toLp 2 volume] with x hL hs₃ hs₂ hs₁ hA hB hC hE ht₁ ht₂ hq hv hf hgi hgj hgi₄ hgj₄ hh
  simp only [Pi.add_apply] at hs₁ hs₂ hs₃
  change _ = (A + B + C + E) x
  rw [hL, hs₃, hs₂, hs₁, hA, hB, hC, hE, ht₁, ht₂, hq, hv,
    Function.comp_apply, hf, hgi, hgj, hgi₄, hgj₄, hh]
  simp only [scalarRealSchwartzSecond_apply]
  simp only [scalarRealSchwartzDerivative_apply]
  exact scalar_partial_local_composition_second χ f φ χ.smooth' f.smooth' hφ x i j

end
end PositiveEinsteinFour.Geometry
end


section

/-! Identification of the actual real rescaled equation with the complex
formal-adjoint equation used by the local regularity theorem. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalar_normalized_adjoint_test_equation (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (f : SmoothScalar (M := M))
    (w : Lp ℝ 2 (volume : Measure V)) (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S)
    (U : Set V)
    (hU : ∀ x ∈ U, scalarRescaledPoint g c z₀ r x ∈ (chartAt FourSpace c).target)
    (ha : ∀ x ∈ U, ∀ i j, a i j x =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r x i j - (1 : Mat4) i j) : ℝ) : ℂ))
    (hb : ∀ x ∈ U, ∀ i, b i x =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r x i : ℝ) : ℂ))
    (hw : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      (∫ x, w x * scalarRescaledOperator g c z₀ r ψ x) =
        ∫ x, scalarRescaledSource g c z₀ r f x * ψ x)
    (φ : S) (hc : HasCompactSupport (φ : V → ℂ))
    (hs : tsupport (φ : V → ℂ) ⊆ U) :
    (scalarFormalAdjointOperator a b (scalarComplexL2 w : T) - (scalarComplexL2 w : T)) φ =
      ∫ x, φ x * ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledSource g c z₀ r f x : ℝ) : ℂ) := by
  have hsupport (L : ℂ →L[ℝ] ℝ) : tsupport (L ∘ φ) ⊆ tsupport (φ : V → ℂ) :=
    tsupport_comp_subset L.map_zero φ
  have hcoordinate (L : ℂ →L[ℝ] ℝ) (x : V) :
      L (scalarSchwartzDirectOperator a b φ x - φ x) =
        -((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledOperator g c z₀ r (L ∘ φ) x := by
    by_cases hx : x ∈ tsupport (φ : V → ℂ)
    · exact scalarSchwartzDirectOperator_real_coordinate L
        (scalarRescaledPrincipal g c z₀ r x) (scalarRescaledDrift g c z₀ r x)
        a b φ x (ha x (hs hx)) (hb x (hs hx))
    · rw [scalarSchwartzDirectOperator_zero_off_tsupport a b φ x hx, L.map_zero,
        scalarRescaledOperator_eq_zero_off_tsupport g c z₀ r (L ∘ φ)
          (fun h => hx (hsupport L h)), mul_zero]
  have hcomponent (L : ℂ →L[ℝ] ℝ) :
      L ((scalarFormalAdjointOperator a b (scalarComplexL2 w : T) -
        (scalarComplexL2 w : T)) φ) =
        -((2 * Real.pi) ^ 2)⁻¹ * ∫ x, scalarRescaledSource g c z₀ r f x * L (φ x) := by
    rw [sub_apply, scalarFormalAdjointOperator_pairing, ← map_sub,
      scalarComplexL2_pairing_component]
    change (∫ x, w x * L (scalarSchwartzDirectOperator a b φ x - φ x)) = _
    simp_rw [hcoordinate]
    have hm : (∫ x, w x *
        (-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledOperator g c z₀ r (L ∘ φ) x)) =
        -((2 * Real.pi) ^ 2)⁻¹ *
          ∫ x, w x * scalarRescaledOperator g c z₀ r (L ∘ φ) x := by
      rw [← integral_const_mul]
      congr 1
      funext x
      ring
    rw [hm, hw (L ∘ φ) (L.contDiff.comp (φ.smooth _))
      (hc.comp_left L.map_zero) ((hsupport L).trans hs)]
    rfl
  have hsource (L : ℂ →L[ℝ] ℝ) := scalarComplexSource_pairing_component
    (scalarRescaledSource g c z₀ r f) L φ hc
      (fun x hx => scalarRescaledSource_contDiffAt g c z₀ r f x (hU x (hs hx)))
        (-((2 * Real.pi) ^ 2)⁻¹)
  apply Complex.ext
  · exact (hcomponent Complex.reCLM).trans (hsource Complex.reCLM).symm
  · exact (hcomponent Complex.imCLM).trans (hsource Complex.imCLM).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! Identification of the actual real rescaled equation with the complex
formal-adjoint equation used by the local regularity theorem. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalar_real_L2_test_integrable (f : Lp ℝ 2 (volume : Measure V))
    (φ : S) (κ : ℝ) :
    Integrable (fun x => φ x * ((κ * f x : ℝ) : ℂ)) :=
  (φ.memLp 2 (volume : Measure V)).integrable_mul ((Lp.memLp f).const_mul κ).ofReal

theorem scalar_normalized_adjoint_test_equation_of_integrable (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (f : V → ℝ)
    (w : Lp ℝ 2 (volume : Measure V)) (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S)
    (U : Set V)
    (ha : ∀ x ∈ U, ∀ i j, a i j x =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r x i j - (1 : Mat4) i j) : ℝ) : ℂ))
    (hb : ∀ x ∈ U, ∀ i, b i x =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r x i : ℝ) : ℂ))
    (hw : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      (∫ x, w x * scalarRescaledOperator g c z₀ r ψ x) =
        ∫ x, f x * ψ x)
    (φ : S) (hc : HasCompactSupport (φ : V → ℂ))
    (hs : tsupport (φ : V → ℂ) ⊆ U)
    (hi : Integrable (fun x => φ x * ((-((2 * Real.pi) ^ 2)⁻¹ * f x : ℝ) : ℂ))) :
    (scalarFormalAdjointOperator a b (scalarComplexL2 w : T) - (scalarComplexL2 w : T)) φ =
      ∫ x, φ x * ((-((2 * Real.pi) ^ 2)⁻¹ * f x : ℝ) : ℂ) := by
  have hsupport (L : ℂ →L[ℝ] ℝ) : tsupport (L ∘ φ) ⊆ tsupport (φ : V → ℂ) :=
    tsupport_comp_subset L.map_zero φ
  have hcoordinate (L : ℂ →L[ℝ] ℝ) (x : V) :
      L (scalarSchwartzDirectOperator a b φ x - φ x) =
        -((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledOperator g c z₀ r (L ∘ φ) x := by
    by_cases hx : x ∈ tsupport (φ : V → ℂ)
    · exact scalarSchwartzDirectOperator_real_coordinate L
        (scalarRescaledPrincipal g c z₀ r x) (scalarRescaledDrift g c z₀ r x)
        a b φ x (ha x (hs hx)) (hb x (hs hx))
    · rw [scalarSchwartzDirectOperator_zero_off_tsupport a b φ x hx, L.map_zero,
        scalarRescaledOperator_eq_zero_off_tsupport g c z₀ r (L ∘ φ)
          (fun h => hx (hsupport L h)), mul_zero]
  have hcomponent (L : ℂ →L[ℝ] ℝ) :
      L ((scalarFormalAdjointOperator a b (scalarComplexL2 w : T) -
        (scalarComplexL2 w : T)) φ) =
        -((2 * Real.pi) ^ 2)⁻¹ * ∫ x, f x * L (φ x) := by
    rw [sub_apply, scalarFormalAdjointOperator_pairing, ← map_sub,
      scalarComplexL2_pairing_component]
    change (∫ x, w x * L (scalarSchwartzDirectOperator a b φ x - φ x)) = _
    simp_rw [hcoordinate]
    have hm : (∫ x, w x *
        (-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledOperator g c z₀ r (L ∘ φ) x)) =
        -((2 * Real.pi) ^ 2)⁻¹ *
          ∫ x, w x * scalarRescaledOperator g c z₀ r (L ∘ φ) x := by
      rw [← integral_const_mul]
      congr 1
      funext x
      ring
    rw [hm, hw (L ∘ φ) (L.contDiff.comp (φ.smooth _))
      (hc.comp_left L.map_zero) ((hsupport L).trans hs)]
    rfl
  have hsource (L : ℂ →L[ℝ] ℝ) :
      L (∫ x, φ x * ((-((2 * Real.pi) ^ 2)⁻¹ * f x : ℝ) : ℂ)) =
        -((2 * Real.pi) ^ 2)⁻¹ * ∫ x, f x * L (φ x) := by
    rw [← L.integral_comp_comm hi, ← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with x
    rw [mul_comm (φ x), ← Complex.real_smul, L.map_smul]
    change (-((2 * Real.pi) ^ 2)⁻¹ * f x) * L (φ x) =
      -((2 * Real.pi) ^ 2)⁻¹ * (f x * L (φ x))
    ring
  apply Complex.ext
  · exact (hcomponent Complex.reCLM).trans (hsource Complex.reCLM).symm
  · exact (hcomponent Complex.imCLM).trans (hsource Complex.imCLM).symm

end
end PositiveEinsteinFour.Geometry
end


section

/-! Rellich compactness for the actual scalar H¹ space on the compact
manifold, assembled from the finite smooth partition of unity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance rellichCompactness_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance rellichCompactness_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarH1ReconstructedPiece (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    scalarH1 d →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs)).comp
      (scalarH1CutoffValueL2 g o d c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
        (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
        (scalarChartCutoff_support c ρ hs))

theorem scalarH1ReconstructedPiece_smooth (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ a : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    scalarH1ReconstructedPiece g o d c ρ hs (smoothScalarToH1 d a) =
      smoothScalarBaseL2 g (smoothScalarProduct ρ a) := by
  unfold scalarH1ReconstructedPiece
  rw [ContinuousLinearMap.comp_apply, scalarH1CutoffValueL2_smooth]
  exact scalarChartReconstruction_chartCutoff g c ρ a hs

theorem scalarH1ReconstructedPiece_compact (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) :
    IsCompactOperator (scalarH1ReconstructedPiece g o d c ρ hs) :=
  (scalarH1CutoffValueL2_compact g o d c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
    (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
    (scalarChartCutoff_support c ρ hs)).clm_comp
      (scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs))

private def smoothScalarBaseL2Linear (g : SmoothMetric M) :
    SmoothScalar (M := M) →ₗ[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (ContinuousMap.toLp 2 (normalizedVolume g) ℝ).toLinearMap.comp smoothScalarContinuous

theorem scalarH1BaseValue_partition (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (P : ScalarPartition M) :
    scalarH1BaseValue g o d = ∑ i : P.ι, scalarH1ReconstructedPiece g o d (P.center i)
      (scalarPartitionFunction P i) (scalarPartitionFunction_support P i) := by
  apply DFunLike.ext'
  apply (scalarH1BaseValue g o d).continuous.ext_on (smoothScalarH1Map_dense o d)
    (map_continuous _)
  rintro _ ⟨a, rfl⟩
  change scalarH1BaseValue g o d (smoothScalarToH1 d a) =
    (∑ i : P.ι, scalarH1ReconstructedPiece g o d (P.center i)
      (scalarPartitionFunction P i) (scalarPartitionFunction_support P i)) (smoothScalarToH1 d a)
  simp only [scalarH1BaseValue_smooth, sum_apply, scalarH1ReconstructedPiece_smooth]
  change smoothScalarBaseL2Linear g a =
    ∑ i : P.ι, smoothScalarBaseL2Linear g
      (smoothScalarProduct (scalarPartitionFunction P i) a)
  rw [← map_sum, smoothScalar_partition]

/-- The actual inclusion of scalar H¹ into base L² is compact. -/
theorem scalarH1BaseValue_compact (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) :
    IsCompactOperator (scalarH1BaseValue g o d) := by
  obtain ⟨P⟩ := scalarPartition_exists (M := M)
  rw [scalarH1BaseValue_partition g o d P]
  exact (compactOperator (RingHom.id ℝ) (scalarH1 d)
    (Lp ℝ 2 (normalizedVolume g))).sum_mem
    (fun i _ => scalarH1ReconstructedPiece_compact g o d (P.center i)
      (scalarPartitionFunction P i) (scalarPartitionFunction_support P i))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual L2 forcing term in density-weighted, rescaled coordinates.
Its cutoff is one on the region where the transformed equation is tested. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

def scalarChartSourceL2 (g : SmoothMetric M) (c : M)
    (f : Lp ℝ 2 (normalizedVolume g)) (χ : FourSpace → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarChartL2_cutoff g c f (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ hs).continuous hc.mul_right
    (tsupport_mul_subset_left.trans hs)).toLp _

theorem scalarChartSourceL2_coe (g : SmoothMetric M) (c : M)
    (f : Lp ℝ 2 (normalizedVolume g)) (χ : FourSpace → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target) :
    scalarChartSourceL2 g c f χ hχ hc hs =ᵐ[volume]
      fun z => χ z * chartVolumeDensity g c z * f ((chartAt FourSpace c).symm z) :=
  MemLp.coeFn_toLp _

def scalarRescaledSourceL2 (g : SmoothMetric M) (c : M)
    (f : Lp ℝ 2 (normalizedVolume g)) (χ : FourSpace → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) :
    Lp ℝ 2 (volume : Measure FourSpace) :=
  r ^ 2 • scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
    (scalarChartSourceL2 g c f χ hχ hc hs)

theorem scalarRescaledSourceL2_coe (g : SmoothMetric M) (c : M)
    (f : Lp ℝ 2 (normalizedVolume g)) (χ : FourSpace → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) :
    scalarRescaledSourceL2 g c f χ hχ hc hs z₀ r hr =ᵐ[volume]
      fun y => r ^ 2 * (χ (scalarRescaledPoint g c z₀ r y) *
        chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
        f ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr
  have hq : Measure.QuasiMeasurePreserving (fun y : FourSpace => A y + z₀) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hsource := hq.ae_eq_comp (scalarChartSourceL2_coe g c f χ hχ hc hs)
  filter_upwards [Lp.coeFn_smul (r ^ 2)
      (scalarAffinePullbackL2 A z₀ (scalarChartSourceL2 g c f χ hχ hc hs)),
    scalarAffinePullbackL2_coe A z₀ (scalarChartSourceL2 g c f χ hχ hc hs), hsource]
    with y hmul ha hf
  change (r ^ 2 • scalarAffinePullbackL2 A z₀
    (scalarChartSourceL2 g c f χ hχ hc hs)) y = _
  rw [hmul]
  change r ^ 2 * scalarAffinePullbackL2 A z₀ (scalarChartSourceL2 g c f χ hχ hc hs) y = _
  dsimp only [Function.comp_apply] at hf
  rw [ha, hf, scalarRescalingLinearEquiv_apply]

theorem scalarRescaledSourceL2_pairing (g : SmoothMetric M) (c : M)
    (f : Lp ℝ 2 (normalizedVolume g)) (χ : FourSpace → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ (chartAt FourSpace c).target)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) (ψ : FourSpace → ℝ)
    (hone : ∀ y ∈ tsupport ψ, χ (scalarRescaledPoint g c z₀ r y) = 1) :
    (∫ y, scalarRescaledSourceL2 g c f χ hχ hc hs z₀ r hr y * ψ y) =
      ∫ y, r ^ 2 * chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
        f ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y)) * ψ y := by
  apply integral_congr_ae
  filter_upwards [scalarRescaledSourceL2_coe g c f χ hχ hc hs z₀ r hr] with y hy
  rw [hy]
  by_cases hp : y ∈ tsupport ψ
  · rw [hone y hp]
    ring
  · rw [image_eq_zero_of_notMem_tsupport hp]
    ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! Undo the positive chart density and affine rescaling for a smooth
local representative of an actual base L2 scalar. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Metric Filter
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M]
  [MeasurableSpace M] [BorelSpace M]

theorem scalar_chart_smooth_unweight (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (hr : 0 < r) {R : ℝ} (hR : 0 < R) (hR1 : R ≤ 1)
    (b : Lp ℝ 2 (normalizedVolume g))
    (ht : ∀ y ∈ closedBall (0 : FourSpace) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (F : FourSpace → ℝ) (hF : ContDiff ℝ ∞ F)
    (heq : (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
      b ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
        volume.restrict (ball (0 : FourSpace) R)] F) :
    ∃ U : Set FourSpace, IsOpen U ∧ z₀.val ∈ U ∧ U ⊆ (chartAt FourSpace c).target ∧
      ∃ H : FourSpace → ℝ, ContDiffOn ℝ ∞ H U ∧
        (fun z => b ((chartAt FourSpace c).symm z)) =ᵐ[volume.restrict U] H := by
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let U : Set FourSpace := {z | A.symm (z - z₀) ∈ ball (0 : FourSpace) R}
  have hU : IsOpen U := isOpen_ball.preimage (by fun_prop)
  have hz₀ : z₀.val ∈ U := by
    simp only [U, mem_ofPred_eq, sub_self, map_zero, mem_ball, dist_self]
    exact hR
  have hinv (z : FourSpace) : scalarRescaledPoint g c z₀ r (A.symm (z - z₀)) = z := by
    rw [← scalarRescalingLinearEquiv_apply g c z₀ r hr.ne']
    change A (A.symm (z - z₀)) + z₀ = z
    rw [A.apply_symm_apply, sub_add_cancel]
  have hUt : U ⊆ (chartAt FourSpace c).target := by
    intro z hz
    have hy : A.symm (z - z₀) ∈ closedBall (0 : FourSpace) 1 :=
      ball_subset_closedBall (ball_subset_ball hR1 hz)
    have h := ht _ hy
    rwa [hinv] at h
  let H : FourSpace → ℝ := fun z => F (A.symm (z - z₀)) / chartVolumeDensity g c z
  have hH : ContDiffOn ℝ ∞ H U := by
    intro z hz
    apply ContDiffAt.contDiffWithinAt
    exact (hF.contDiffAt.comp z
      (A.symm.contDiff.contDiffAt.comp z (contDiffAt_id.sub contDiffAt_const))).div
      ((chartVolumeDensity_contDiffAt g c z (hUt hz)).of_le (by simp))
      (chartVolumeDensity_pos g c z (hUt hz)).ne'
  refine ⟨U, hU, hz₀, hUt, H, hH, ?_⟩
  have hmp : Measure.QuasiMeasurePreserving
      (fun z : FourSpace => A.symm (z - z₀)) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    have hfun : (fun z : FourSpace => A.symm (z - z₀)) =
        (fun z => A.symm z + (-A.symm z₀)) := by
      funext z
      rw [map_sub, sub_eq_add_neg]
    rw [hfun, scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  have hglob := hmp.ae ((ae_restrict_iff' isOpen_ball.measurableSet).mp heq)
  apply (ae_restrict_iff' hU.measurableSet).mpr
  filter_upwards [hglob] with z hz
  intro hzU
  have he := hz hzU
  rw [hinv] at he
  apply (eq_div_iff (chartVolumeDensity_pos g c z (hUt hzU)).ne').mpr
  simpa only [mul_comm] using he

end
end PositiveEinsteinFour.Geometry
end


section

/-! The interpolation estimate between scalar L² and L⁴, in the exact
subcritical range used for the Sobolev minimizer. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory Filter
open scoped ENNReal _root_.Topology

noncomputable section

theorem scalar_subcritical_moment_le {X : Type*} [MeasurableSpace X]
    {μ : Measure X} (f : X → ℝ) (hf : AEStronglyMeasurable f μ)
    {p : ℝ} (hp : 2 ≤ p) (hp4 : p ≤ 4) :
    (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ≤
      (∫⁻ x, ‖f x‖ₑ ^ (2 : ℝ) ∂μ) ^ ((4 - p) / 2) *
        (∫⁻ x, ‖f x‖ₑ ^ (4 : ℝ) ∂μ) ^ ((p - 2) / 2) := by
  have ha : 0 ≤ (4 - p) / 2 := by linarith
  have hb : 0 ≤ (p - 2) / 2 := by linarith
  have hsum : (4 - p) / 2 + (p - 2) / 2 = 1 := by ring
  have h := ENNReal.lintegral_mul_norm_pow_le
    (hf.enorm.pow_const (2 : ℝ))
    (hf.enorm.pow_const (4 : ℝ)) ha hb hsum
  have he (x : X) : (‖f x‖ₑ ^ (2 : ℝ)) ^ ((4 - p) / 2) *
      (‖f x‖ₑ ^ (4 : ℝ)) ^ ((p - 2) / 2) = ‖f x‖ₑ ^ p := by
    rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_add_of_nonneg _ _ (mul_nonneg (by norm_num) ha)
        (mul_nonneg (by norm_num) hb)]
    congr 1
    ring
  simpa only [he] using h

theorem scalar_subcritical_moment_tendsto_zero {X : Type*} [MeasurableSpace X]
    {μ : Measure X} (f : ℕ → X → ℝ) (hf : ∀ n, AEStronglyMeasurable (f n) μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) {B : ℝ≥0∞} (hB : B ≠ ∞)
    (hfour : ∀ n, (∫⁻ x, ‖f n x‖ₑ ^ (4 : ℝ) ∂μ) ≤ B)
    (htwo : Tendsto (fun n => ∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) atTop (𝓝 0)) :
    Tendsto (fun n => ∫⁻ x, ‖f n x‖ₑ ^ p ∂μ) atTop (𝓝 0) := by
  have ha : 0 < (4 - p) / 2 := by linarith
  have hb : 0 ≤ (p - 2) / 2 := by linarith
  have hlimit : Tendsto
      (fun n => (∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) ^ ((4 - p) / 2)) atTop (𝓝 0) := by
    have h := (ENNReal.continuous_rpow_const (y := (4 - p) / 2)).tendsto (0 : ℝ≥0∞)
    rw [ENNReal.zero_rpow_of_pos ha] at h
    exact h.comp htwo
  have hbound : B ^ ((p - 2) / 2) ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_nonneg hb hB
  have hproduct := ENNReal.Tendsto.mul_const hlimit (Or.inr hbound)
  rw [zero_mul] at hproduct
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hproduct
    (fun n => (show (0 : ℝ≥0∞) ≤ (∫⁻ x, ‖f n x‖ₑ ^ p ∂μ) from bot_le))
  intro n
  exact (scalar_subcritical_moment_le (f n) (hf n) hp.le hp4.le).trans
    (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hfour n) hb))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual two-form H1 completion localizes into the closed Euclidean
first-jet graph. Each supported coordinate value is a compact operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped Manifold ContDiff

noncomputable section

local instance : MeasurableSpace FourSpace := borel FourSpace
local instance : BorelSpace FourSpace := ⟨rfl⟩
local instance : MeasureSpace FourSpace := measureSpaceOfInnerProductSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

variable (c : M) {K : Set FourSpace} (hK : IsCompact K)
  (hKt : K ⊆ (chartAt FourSpace c).target)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4)

def smoothTwoFormCutoffJet : SmoothH1TwoForm o →ₗ[ℝ]
    Euclidean.H1Target (μ := (volume : Measure FourSpace)) :=
  (Euclidean.graph (μ := (volume : Measure FourSpace))).comp
    (twoFormCutoffC1 c hKt χ hχ hc hs a)

include hK in
theorem smoothTwoFormCutoffJet_bound : ∃ C : ℝ, ∀ u : SmoothH1TwoForm o,
    ‖smoothTwoFormCutoffJet c hKt χ hχ hc hs a u‖ ≤ C * ‖u‖ := by
  obtain ⟨C, _, hC⟩ := twoFormCutoff_jet_bound (o := o) c hK hKt χ hχ hc hs
  refine ⟨C, fun u => ?_⟩
  let f := twoFormCutoffC1 c hKt χ hχ hc hs a u
  change ‖(Euclidean.toL2 (μ := (volume : Measure FourSpace)) f,
    Euclidean.toL2Grad (μ := (volume : Measure FourSpace)) f)‖ ≤ _
  rw [Prod.norm_def]
  apply max_le
  · rw [← scalarBorel_valueL2 f, (scalarBorelLpEquiv ℝ 2).norm_map]
    exact (hC u a).1
  · rw [← scalarBorel_gradientL2 f, (scalarBorelLpEquiv FourSpace 2).norm_map]
    exact (hC u a).2

def smoothTwoFormCutoffJetCLM : SmoothH1TwoForm o →L[ℝ]
    Euclidean.H1Target (μ := (volume : Measure FourSpace)) :=
  (smoothTwoFormCutoffJet c hKt χ hχ hc hs a).mkContinuousOfExistsBound
    (smoothTwoFormCutoffJet_bound c hK hKt χ hχ hc hs a)

def twoFormCutoffJet : TwoFormH1 o →L[ℝ]
    Euclidean.H1Target (μ := (volume : Measure FourSpace)) :=
  (smoothTwoFormCutoffJetCLM c hK hKt χ hχ hc hs a).fromCompletion

theorem twoFormCutoffJet_smooth (u : SmoothH1TwoForm o) :
    twoFormCutoffJet c hK hKt χ hχ hc hs a (smoothTwoFormToH1 u) =
      Euclidean.graph (μ := (volume : Measure FourSpace))
        (twoFormCutoffC1 c hKt χ hχ hc hs a u) :=
  ContinuousLinearMap.fromCompletion_apply_coe _ u

theorem twoFormCutoffJet_mem (u : TwoFormH1 o) :
    twoFormCutoffJet c hK hKt χ hχ hc hs a u ∈
      Euclidean.h1 (μ := (volume : Measure FourSpace)) := by
  refine UniformSpace.Completion.induction_on u
    ((Euclidean.isClosed_h1 (μ := (volume : Measure FourSpace))).preimage
      (twoFormCutoffJet c hK hKt χ hχ hc hs a).continuous) ?_
  intro v
  change twoFormCutoffJet c hK hKt χ hχ hc hs a (smoothTwoFormToH1 v) ∈ _
  rw [twoFormCutoffJet_smooth]
  exact Submodule.le_topologicalClosure _ ⟨_, rfl⟩

def twoFormCutoffEuclideanH1 : TwoFormH1 o →L[ℝ]
    ↥(Euclidean.h1 (μ := (volume : Measure FourSpace))) :=
  (twoFormCutoffJet c hK hKt χ hχ hc hs a).codRestrict _
    (twoFormCutoffJet_mem c hK hKt χ hχ hc hs a)

theorem twoFormCutoffEuclideanH1_supported (u : TwoFormH1 o) :
    twoFormCutoffEuclideanH1 c hK hKt χ hχ hc hs a u ∈
      Euclidean.h1On K hK.isClosed.measurableSet := by
  refine UniformSpace.Completion.induction_on u
    ((Euclidean.isClosed_range_extendByZero K hK.isClosed.measurableSet).preimage
      ((Euclidean.h1ToL2 (μ := (volume : Measure FourSpace))).comp
        (twoFormCutoffEuclideanH1 c hK hKt χ hχ hc hs a)).continuous) ?_
  intro v
  change (twoFormCutoffJet c hK hKt χ hχ hc hs a (smoothTwoFormToH1 v)).1 ∈
    LinearMap.range ((Lp.extendByZeroₗᵢ (μ := (volume : Measure FourSpace))
      (E := ℝ) (p := 2) (s := K) hK.isClosed.measurableSet).toLinearMap)
  rw [twoFormCutoffJet_smooth]
  exact Euclidean.mem_range_extendByZeroₗᵢ_toLp_of_tsupport_subset
    (μ := (volume : Measure FourSpace)) hK.isClosed.measurableSet _
    (Euclidean.memLp_of_mem_C1c (μ := (volume : Measure FourSpace))
      (twoFormCutoffC1 c hKt χ hχ hc hs a v).property)
    (twoFormCutoffC1_support c hKt χ hχ hc hs a v)

def twoFormCutoffSupportedH1 : TwoFormH1 o →L[ℝ]
    ↥(Euclidean.h1On K hK.isClosed.measurableSet) :=
  (twoFormCutoffEuclideanH1 c hK hKt χ hχ hc hs a).codRestrict _
    (twoFormCutoffEuclideanH1_supported c hK hKt χ hχ hc hs a)

def twoFormCutoffValueL2 : TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (Euclidean.h1OnToL2 K hK.isClosed.measurableSet).comp
    (twoFormCutoffSupportedH1 c hK hKt χ hχ hc hs a)

theorem twoFormCutoffValueL2_compact :
    IsCompactOperator (twoFormCutoffValueL2 (o := o) c hK hKt χ hχ hc hs a) :=
  (Euclidean.isCompactOperator_h1OnToL2 hK hK.isClosed.measurableSet).comp_clm
    (twoFormCutoffSupportedH1 c hK hKt χ hχ hc hs a)

theorem twoFormCutoffValueL2_smooth (u : SmoothH1TwoForm o) :
    twoFormCutoffValueL2 c hK hKt χ hχ hc hs a (smoothTwoFormToH1 u) =
      Euclidean.toL2 (μ := (volume : Measure FourSpace))
        (twoFormCutoffC1 c hKt χ hχ hc hs a u) := by
  change (twoFormCutoffJet c hK hKt χ hχ hc hs a (smoothTwoFormToH1 u)).1 = _
  rw [twoFormCutoffJet_smooth]
  rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! Finite smooth partitions and the self-adjoint scalar multiplication
identity in the actual two-form L2 completion. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped BigOperators Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

theorem smoothTwoForm_product_inner (ρ : SmoothScalar (M := M)) (u v : smoothTwoForms o) :
    inner ℝ (smoothTwoFormToL2 (smoothTwoFormProduct ρ u : SmoothL2TwoForm o))
      (smoothTwoFormToL2 (v : SmoothL2TwoForm o)) =
    inner ℝ (smoothTwoFormToL2 (u : SmoothL2TwoForm o))
      (smoothTwoFormToL2 (smoothTwoFormProduct ρ v : SmoothL2TwoForm o)) := by
  have he : @inner ℝ (SmoothL2TwoForm o) _ (smoothTwoFormProduct ρ u) v =
      @inner ℝ (SmoothL2TwoForm o) _ u (smoothTwoFormProduct ρ v) := by
    change smoothTwoFormL2Inner (smoothTwoFormProduct ρ u) v =
      smoothTwoFormL2Inner u (smoothTwoFormProduct ρ v)
    unfold smoothTwoFormL2Inner
    apply integral_congr_ae
    filter_upwards [] with x
    change inner ℝ (ρ.val x • u.val x) (v.val x) = inner ℝ (u.val x) (ρ.val x • v.val x)
    rw [real_inner_smul_left, real_inner_smul_right]
  exact (smoothTwoFormToL2.inner_map_map _ _).trans
    (he.trans (smoothTwoFormToL2.inner_map_map _ _).symm)

omit [T3Space M] [MeasurableSpace M] [BorelSpace M] [CompactSpace M] [Nonempty M] in
theorem smoothTwoForm_partition_weights {ι : Type*} [Fintype ι]
    (ρ : ι → SmoothScalar (M := M)) (hρ : ∀ x, ∑ i : ι, (ρ i).val x = 1)
    (u : smoothTwoForms o) : (∑ i : ι, smoothTwoFormProduct (ρ i) u) = u := by
  apply Subtype.ext
  funext x
  simp only [Submodule.coe_sum, Finset.sum_apply, smoothTwoFormProduct]
  rw [← Finset.sum_smul, hρ, one_smul]

theorem twoFormL2_eq_of_smooth_pairings (u v : TwoFormL2 o)
    (h : ∀ w : SmoothL2TwoForm o,
      inner ℝ u (smoothTwoFormToL2 w) = inner ℝ v (smoothTwoFormToL2 w)) : u = v := by
  apply ext_inner_right ℝ
  have he : (fun w : TwoFormL2 o => inner ℝ u w) = fun w => inner ℝ v w :=
    (smoothTwoFormToL2_dense (o := o)).equalizer
      (continuous_const.inner continuous_id) (continuous_const.inner continuous_id) (funext h)
  exact congrFun he

end
end PositiveEinsteinFour.Geometry
end


section

/-! The Gaussian ansatz identities with precisely the local regularity
needed at the point of evaluation. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour
open scoped ContDiff BigOperators

noncomputable section

theorem fourHeatGaussian_amplitude_partial_at (t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (x : FourSpace) (hu : DifferentiableAt ℝ u x) (i : Fin 4) :
    partialDeriv (fun y => fourHeatGaussian t y * u y) i x =
      fourHeatGaussian t x * (partialDeriv u i x - x i / (2 * t) * u x) := by
  rw [scalar_partial_product _ _ x
    ((fourHeatGaussian_smooth t).differentiable (by simp)).differentiableAt hu i,
    fourHeatGaussian_partial t ht]
  ring

theorem fourHeatGaussian_amplitude_second_at (t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (x : FourSpace) (hu : ContDiffAt ℝ 2 u x) (i j : Fin 4) :
    partialDeriv (partialDeriv (fun y => fourHeatGaussian t y * u y) i) j x =
      fourHeatGaussian t x *
        (partialDeriv (partialDeriv u i) j x -
          (x i * partialDeriv u j x + x j * partialDeriv u i x) / (2 * t) +
          (x i * x j / (4 * t ^ 2) - (if i = j then 1 else 0) / (2 * t)) * u x) := by
  rw [scalar_partial_second_product_at (fourHeatGaussian t) u x
    ((fourHeatGaussian_smooth t).contDiffAt.of_le (by simp)) hu i j,
    fourHeatGaussian_partial_partial t ht,
    fourHeatGaussian_partial t ht, fourHeatGaussian_partial t ht]
  ring

theorem fourHeatLocalOperator_gaussian_at (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (ht : t ≠ 0)
    (u : FourSpace → ℝ) (x : FourSpace) (hu : ContDiffAt ℝ 2 u x) :
    fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * u y) x =
      fourHeatGaussian t x * fourHeatConjugatedOperator a b c t u x := by
  unfold fourHeatLocalOperator fourHeatConjugatedOperator
  simp_rw [fourHeatGaussian_amplitude_second_at t ht u x hu,
    fourHeatGaussian_amplitude_partial_at t ht u x (hu.differentiableAt (by norm_num))]
  let K := fourHeatGaussian t x
  let Q := fun i j : Fin 4 => partialDeriv (partialDeriv u i) j x -
    (x i * partialDeriv u j x + x j * partialDeriv u i x) / (2 * t) +
    (x i * x j / (4 * t ^ 2) - (if i = j then 1 else 0) / (2 * t)) * u x
  let P := fun i : Fin 4 => partialDeriv u i x - x i / (2 * t) * u x
  change -(∑ i, ∑ j, a i j * (K * Q i j)) + (∑ i, b i * (K * P i)) + c * (K * u x) =
    K * (-(∑ i, ∑ j, a i j * Q i j) + (∑ i, b i * P i) + c * u x)
  have hQ : (∑ i, ∑ j, a i j * (K * Q i j)) = K * ∑ i, ∑ j, a i j * Q i j := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hP : (∑ i, b i * (K * P i)) = K * ∑ i, b i * P i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hQ, hP]
  ring

theorem fourHeatLocalOperator_transport_residual_at (a : Matrix (Fin 4) (Fin 4) ℝ)
    (b : Fin 4 → ℝ) (c t : ℝ) (ht : 0 < t)
    (u : FourSpace → ℝ) (x : FourSpace) (hu : ContDiffAt ℝ 2 u x) :
    deriv (fun s => fourHeatGaussian s x * u x) t +
      fourHeatLocalOperator a b c (fun y => fourHeatGaussian t y * u y) x =
      fourHeatGaussian t x *
        (fourHeatLocalOperator a b c u x + fourHeatRadialTransport a b u x / t +
          fourHeatEikonalDefect a x / t ^ 2 * u x) := by
  rw [(fourHeatGaussian_amplitude_time t ht u x).deriv,
    fourHeatLocalOperator_gaussian_at a b c t ht.ne' u x hu]
  have h := fourHeatConjugatedOperator_decomposition a b c t u x
  calc
    _ = fourHeatGaussian t x * ((‖x‖ ^ 2 / (4 * t ^ 2) - 2 / t) * u x +
        fourHeatConjugatedOperator a b c t u x) := by ring
    _ = _ := congrArg (fourHeatGaussian t x * ·) h

end
end PositiveEinsteinFour.Geometry
end


section

/-! Consequences of the radial metric identity for the actual coordinate
derivatives in a divergence-form heat operator. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped _root_.Topology BigOperators

noncomputable section

theorem fourHeat_radial_derivative (f : FourSpace → ℝ) (x : FourSpace) :
    fderiv ℝ f x x = ∑ i : Fin 4, x i * partialDeriv f i x := by
  have hx : x = ∑ i : Fin 4, x i • coordinateVector i := by
    simpa only [WithLp.toLp_ofLp] using (sum_coordinateVector (WithLp.ofLp x)).symm
  let D : FourSpace →L[ℝ] ℝ := fderiv ℝ f x
  change D x = _
  rw [congrArg D hx]
  rw [map_sum]
  simp only [map_smul, smul_eq_mul, partialDeriv]
  rfl

theorem fourHeatRadialTransport_of_radial (a : Mat4) (b : Fin 4 → ℝ)
    (u : FourSpace → ℝ) (x : FourSpace)
    (hrow : ∀ i, ∑ j : Fin 4, a i j * x j = x i)
    (hcol : ∀ j, ∑ i : Fin 4, a i j * x i = x j) :
    fourHeatRadialTransport a b u x =
      fderiv ℝ u x x + ((∑ i : Fin 4, a i i) - 4 - ∑ i : Fin 4, b i * x i) / 2 * u x := by
  have hsum : (∑ i : Fin 4, ∑ j : Fin 4,
      a i j * (x i * partialDeriv u j x + x j * partialDeriv u i x)) =
      (∑ j : Fin 4, (∑ i : Fin 4, a i j * x i) * partialDeriv u j x) +
        ∑ i : Fin 4, (∑ j : Fin 4, a i j * x j) * partialDeriv u i x := by
    norm_num [Fin.sum_univ_four]
    ring
  rw [fourHeatRadialTransport, hsum]
  simp_rw [hrow, hcol]
  rw [fourHeat_radial_derivative]
  ring

theorem fourHeat_radial_divergence (a : FourSpace → Mat4) (x : FourSpace)
    (ha : ∀ i j, DifferentiableAt ℝ (fun y => a y i j) x)
    (hrad : ∀ᶠ y in 𝓝 x, ∀ i, ∑ j : Fin 4, a y i j * y j = y i) :
    (∑ i : Fin 4, ∑ j : Fin 4, partialDeriv (fun y => a y i j) i x * x j) +
      (∑ i : Fin 4, a x i i) = 4 := by
  have hrow (i : Fin 4) :
      (∑ j : Fin 4, partialDeriv (fun y => a y i j) i x * x j) + a x i i = 1 := by
    let π : Fin 4 → FourSpace →L[ℝ] ℝ := fun j => PiLp.proj 2 (fun _ : Fin 4 => ℝ) j
    have hd := HasFDerivAt.fun_sum (u := Finset.univ)
      (fun j _ => (ha i j).hasFDerivAt.mul ((π j).hasFDerivAt (x := x)))
    have heq : (fun y : FourSpace => y i) =ᶠ[𝓝 x]
        (fun y => ∑ j : Fin 4, a y i j * y j) := by
      filter_upwards [hrad] with y hy
      exact (hy i).symm
    have hD := (hd.congr_of_eventuallyEq heq).unique ((π i).hasFDerivAt (x := x))
    have h := congrArg (fun L : FourSpace →L[ℝ] ℝ => L (coordinateVector i)) hD
    simp only [_root_.sum_apply, _root_.add_apply, _root_.smul_apply, smul_eq_mul,
      π, PiLp.proj_apply] at h
    have hcoord (j : Fin 4) : (coordinateVector i) j = if j = i then 1 else 0 := by
      simp [coordinateVector, eq_comm]
    simp only [hcoord, mul_ite, mul_one, mul_zero, Finset.sum_add_distrib,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true] at h
    simpa only [mul_comm, add_comm, partialDeriv] using h
  calc
    _ = ∑ i : Fin 4,
        ((∑ j : Fin 4, partialDeriv (fun y => a y i j) i x * x j) + a x i i) :=
      (Finset.sum_add_distrib).symm
    _ = ∑ _i : Fin 4, (1 : ℝ) := Finset.sum_congr rfl (fun i _ => hrow i)
    _ = 4 := by norm_num

end
end PositiveEinsteinFour.Geometry
end


section

/-! The radial identity for the actual exponential pullback metric,
and the resulting cancellation of the Gaussian eikonal defect. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Angular Matrix
open scoped Manifold ContDiff _root_.Topology InnerProductSpace BigOperators

noncomputable section

attribute [local instance] normedAddCommGroupTangentSpaceVectorSpace
  normedSpaceTangentSpaceVectorSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

abbrev heatNormalMetric (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v : FourSpace) : Mat4 :=
  frameExponentialGram g o e v

theorem heatNormalMetric_symm (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v : FourSpace) : (heatNormalMetric g o e v)ᵀ = heatNormalMetric g o e v := by
  ext i j
  exact g.symm _ _ _

theorem heatNormalMetric_row (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v w : FourSpace) (i : Fin 4) :
    (heatNormalMetric g o e v *ᵥ WithLp.ofLp w) i =
      g.inner (frameExponential g o e v)
        (mfderiv I4 I4 (frameExponential g o e) v (coordinateVector i))
        (mfderiv I4 I4 (frameExponential g o e) v w) := by
  let D : FourSpace →L[ℝ] FourSpace := mfderiv I4 I4 (frameExponential g o e) v
  let B : FourSpace →L[ℝ] FourSpace →L[ℝ] ℝ := g.inner (frameExponential g o e v)
  have hw : w = ∑ j : Fin 4, w j • coordinateVector j := by
    simpa only [WithLp.toLp_ofLp] using (sum_coordinateVector (WithLp.ofLp w)).symm
  change (∑ j : Fin 4, B (D (coordinateVector i)) (D (coordinateVector j)) * w j) =
    B (D (coordinateVector i)) (D w)
  conv_rhs => rw [hw, map_sum]
  simp only [map_smul, map_sum, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem heatNormalMetric_gauss_vector (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive)
    (v w : FourSpace) (hv : v ≠ 0) :
    g.inner (frameExponential g o e v)
      (mfderiv I4 I4 (frameExponential g o e) v v)
      (mfderiv I4 I4 (frameExponential g o e) v w) = inner ℝ v w := by
  let q : Directions := ⟨‖v‖⁻¹ • v, by
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_nonneg (norm_nonneg v),
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr hv)]⟩
  have hr : 0 < ‖v‖ := norm_pos_iff.mpr hv
  have hvq : ‖v‖ • q.val = v := by
    change ‖v‖ • (‖v‖⁻¹ • v) = v
    rw [smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
  have hg := frameExponential_gauss g o hRic e he q ‖v‖ hr w
  rw [hvq] at hg
  let D : FourSpace →L[ℝ] FourSpace := mfderiv I4 I4 (frameExponential g o e) v
  let B : FourSpace →L[ℝ] FourSpace →L[ℝ] ℝ := g.inner (frameExponential g o e v)
  have hD : D v = ‖v‖ • D q.val := by
    calc
      D v = D (‖v‖ • q.val) := congrArg D hvq.symm
      _ = _ := D.map_smul _ _
  change B (D q.val) (D w) = inner ℝ q.val w at hg
  change B (D v) (D w) = inner ℝ v w
  rw [hD, map_smul, _root_.smul_apply, smul_eq_mul, hg]
  rw [← real_inner_smul_left, hvq]

theorem heatNormalMetric_radial (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) (v : FourSpace) :
    heatNormalMetric g o e v *ᵥ WithLp.ofLp v = WithLp.ofLp v := by
  by_cases hv : v = 0
  · subst v
    simp
  ext i
  rw [heatNormalMetric_row, g.symm,
    heatNormalMetric_gauss_vector g o hRic e he v (coordinateVector i) hv]
  have hb : coordinateVector i = (EuclideanSpace.basisFun (Fin 4) ℝ) i := by
    simp [coordinateVector, EuclideanSpace.basisFun_apply]
  rw [hb, EuclideanSpace.inner_basisFun_real]

theorem heatNormalMetric_inverse_radial (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) (v : FourSpace)
    (hdet : (heatNormalMetric g o e v).det ≠ 0) :
    (heatNormalMetric g o e v)⁻¹ *ᵥ WithLp.ofLp v = WithLp.ofLp v := by
  calc
    _ = (heatNormalMetric g o e v)⁻¹ *ᵥ
        (heatNormalMetric g o e v *ᵥ WithLp.ofLp v) := by
      rw [heatNormalMetric_radial g o hRic e he]
    _ = ((heatNormalMetric g o e v)⁻¹ * heatNormalMetric g o e v) *ᵥ WithLp.ofLp v :=
      mulVec_mulVec _ _ _
    _ = _ := by rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mulVec]

theorem heatNormalMetric_eikonal (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) (v : FourSpace)
    (hdet : (heatNormalMetric g o e v).det ≠ 0) :
    fourHeatEikonalDefect (heatNormalMetric g o e v)⁻¹ v = 0 := by
  apply fourHeatEikonalDefect_zero
  intro i
  exact congrFun (heatNormalMetric_inverse_radial g o hRic e he v hdet) i

end
end PositiveEinsteinFour.Geometry
end


section

/-! Density of actual smooth scalar functions in the base L2 space,
needed for the scalar part of the Hodge heat complex. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff _root_.Topology ENNReal

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

omit [MeasurableSpace M] [BorelSpace M] [Nonempty M] in
theorem smoothScalarContinuous_dense : DenseRange (smoothScalarContinuous (M := M)) := by
  apply Metric.denseRange_iff.mpr
  intro f ε hε
  obtain ⟨a, ha, _⟩ := f.continuous.exists_contMDiff_approx I4 (⊤ : ℕ∞)
    (continuous_const : Continuous (fun _ : M => ε / 2)) (fun _ => half_pos hε)
  refine ⟨⟨a, a.contMDiff⟩, ?_⟩
  apply lt_of_le_of_lt _ (half_lt_self hε)
  apply (ContinuousMap.dist_le (half_pos hε).le).mpr
  intro x
  change dist (f x) (a x) ≤ ε / 2
  rw [dist_comm]
  exact (ha x).le

variable [SecondCountableTopology M]

theorem smoothScalarBaseL2_dense (g : SmoothMetric M) :
    DenseRange (smoothScalarBaseL2 g) := by
  let := normalizedVolume_isProbability (actual_finitePositiveVolume g)
  have hd := (ContinuousMap.toLp_denseRange ℝ (normalizedVolume g) ℝ (p := 2)
    (by norm_num : (2 : ℝ≥0∞) ≠ (⊤ : ℝ≥0∞))).comp smoothScalarContinuous_dense
      (ContinuousMap.toLp 2 (normalizedVolume g) ℝ).continuous
  exact hd

local instance scalarBaseSmooth_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

theorem scalarH1BaseValue_dense (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) :
    DenseRange (scalarH1BaseValue g o d) := by
  apply (smoothScalarBaseL2_dense g).mono
  rintro _ ⟨a, rfl⟩
  exact ⟨smoothScalarToH1 d a, scalarH1BaseValue_smooth g o d a⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! Passing the smooth coordinate-to-frame gradient estimate to actual H1. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter
open scoped Manifold ContDiff BigOperators

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance frameControl_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarH1_local_frame_control (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (ρ : SmoothScalar (M := M)) (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source)
    {B : ℝ} (hB : ∀ x, |ρ.val x| ≤ B) (C : ℝ) (hC : 0 ≤ C)
    (hE : ∀ z ∈ scalarChartSupport c ρ, ∀ j k, |chartGramMatrix g c 1 z j k| ≤ C)
    (u : scalarH1 d) (i : Fin 4) :
    |scalarH1LocalizedFrame g o d ρ hB i u| ≤
      (4 * C) • ∑ j : Fin 4, |scalarBasePullback g o
        (scalarH1LocalizedCoordinate g o d c ρ hs j u)| := by
  let A := scalarH1LocalizedFrame g o d ρ hB i
  let D := fun j => (scalarBasePullback g o).toContinuousLinearMap.comp
    (scalarH1LocalizedCoordinate g o d c ρ hs j)
  apply scalarL2_closed_domination A D (4 * C) (smoothScalarH1Map o d)
    (smoothScalarH1Map_dense o d) _ u
  intro a
  apply (Lp.coeFn_le _ _).mp
  have hD (j : Fin 4) : D j (smoothScalarToH1 d a) =ᵐ[canonicalFrameMeasure g o]
      fun e => ρ.val e.base * partialDeriv (fun z => a.val ((chartAt FourSpace c).symm z)) j
        (chartAt FourSpace c e.base) := by
    have ht := (canonicalFrameMeasure_base g o).quasiMeasurePreserving.ae
      (scalarH1LocalizedCoordinate_smooth g o d c ρ hs j a)
    exact (Lp.coeFn_compMeasurePreserving
      (scalarH1LocalizedCoordinate g o d c ρ hs j (smoothScalarToH1 d a))
      (canonicalFrameMeasure_base g o)).trans ht
  have hDa : ∀ᵐ e ∂canonicalFrameMeasure g o, ∀ j : Fin 4,
      |D j (smoothScalarToH1 d a)| e =
        |ρ.val e.base * partialDeriv (fun z => a.val ((chartAt FourSpace c).symm z)) j
          (chartAt FourSpace c e.base)| := by
    apply eventually_all.mpr
    intro j
    exact (Lp.coeFn_abs _).trans ((hD j).mono fun e he => congrArg abs he)
  filter_upwards [scalarH1LocalizedFrame_smooth g o d ρ hB i a,
    Lp.coeFn_abs (A (smoothScalarToH1 d a)), hDa,
    Lp.coeFn_smul (4 * C) (∑ j : Fin 4, |D j (smoothScalarToH1 d a)|),
    Lp.coeFn_finsetSum Finset.univ (fun j : Fin 4 => |D j (smoothScalarToH1 d a)|)]
      with e hA habs hDall hsm hsum
  change |A (smoothScalarToH1 d a)| e ≤
    ((4 * C) • ∑ j : Fin 4, |D j (smoothScalarToH1 d a)|) e
  rw [habs, hA, hsm]
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [hsum]
  change |ρ.val e.base * scalarGradient g a.val e i| ≤
    4 * C * ∑ j, |D j (smoothScalarToH1 d a)| e
  simp_rw [hDall]
  by_cases hρ : ρ.val e.base = 0
  · simp only [hρ, zero_mul, abs_zero, Finset.sum_const_zero, mul_zero, le_refl]
  · have hxs := hs (subset_tsupport ρ.val hρ)
    have hzK : chartAt FourSpace c e.base ∈ scalarChartSupport c ρ :=
      ⟨e.base, subset_tsupport ρ.val hρ, rfl⟩
    let z : ChartTarget c := ⟨chartAt FourSpace c e.base, (chartAt FourSpace c).map_source hxs⟩
    have he : e.base = (chartAt FourSpace c).symm z :=
      ((chartAt FourSpace c).left_inv hxs).symm
    have hb := scalar_frame_gradient_abs_le_chart g a c z e he C hC (hE _ hzK) i
    calc
      _ = |ρ.val e.base| * |scalarGradient g a.val e i| := abs_mul _ _
      _ ≤ |ρ.val e.base| * (4 * C * ∑ j,
          |partialDeriv (fun y => a.val ((chartAt FourSpace c).symm y)) j z|) :=
        mul_le_mul_of_nonneg_left hb (abs_nonneg _)
      _ = _ := by
        simp_rw [abs_mul]
        rw [← Finset.mul_sum]
        ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The actual rescaled forcing is H1 whenever its intrinsic source is H1. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set
open scoped Manifold ContDiff SchwartzMap ENNReal

noncomputable section

local notation "V" => FourSpace
local notation "T" => 𝓢'(V, ℂ)

theorem scalarComplexL2_real_smul (c : ℝ) (f : Lp ℝ 2 (volume : Measure V)) :
    scalarComplexL2 (c • f) = (c : ℂ) • scalarComplexL2 f := by
  apply Lp.ext
  filter_upwards [scalarComplexL2_coe (c • f), scalarComplexL2_coe f,
    Lp.coeFn_smul c f, Lp.coeFn_smul (c : ℂ) (scalarComplexL2 f)] with x hc hf hs ht
  rw [hc, ht, hs]
  simp only [Pi.smul_apply, smul_eq_mul, hf, Complex.ofReal_mul]

theorem scalarComplexL2_real_smul_distribution (c : ℝ) (f : Lp ℝ 2 (volume : Measure V)) :
    (scalarComplexL2 (c • f) : T) = (c : ℂ) • (scalarComplexL2 f : T) := by
  rw [scalarComplexL2_real_smul]
  exact (Lp.toTemperedDistributionCLM ℂ volume 2).map_smul (c : ℂ) _

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance h1Source_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalarChartSourceL2_memSobolev_one (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (f : scalarH1 d) (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (ht : tsupport χ ⊆ (chartAt FourSpace c).target) :
    MemSobolev 1 2 (scalarComplexL2
      (scalarChartSourceL2 g c (scalarH1BaseValue g o d f) χ hχ hc ht) : T) := by
  have heq : scalarChartSourceL2 g c (scalarH1BaseValue g o d f) χ hχ hc ht =
      scalarWeightedChartL2 g o d c hc ht f χ hχ hc (Subset.refl _) := by
    apply Lp.ext
    exact (scalarChartSourceL2_coe g c (scalarH1BaseValue g o d f) χ hχ hc ht).trans
      (scalarWeightedChartL2_coe g o d c hc ht f χ hχ hc (Subset.refl _)).symm
  rw [heq]
  exact scalarWeightedChartL2_memSobolev_one g o d c hc ht f χ hχ hc (Subset.refl _)

theorem scalarRescaledSourceL2_memSobolev_one (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
    (f : scalarH1 d) (χ : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hc : HasCompactSupport χ) (ht : tsupport χ ⊆ (chartAt FourSpace c).target)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) :
    MemSobolev 1 2 (scalarComplexL2
      (scalarRescaledSourceL2 g c (scalarH1BaseValue g o d f) χ hχ hc ht z₀ r hr) : T) := by
  rw [scalarRescaledSourceL2, scalarComplexL2_real_smul_distribution]
  have h := scalarAffinePullbackL2_memSobolev_one
    (scalarRescalingLinearEquiv g c z₀ r hr) z₀
    (scalarChartSourceL2 g c (scalarH1BaseValue g o d f) χ hχ hc ht)
    (scalarChartSourceL2_memSobolev_one g o d c f χ hχ hc ht)
  exact h.smul ((r ^ 2 : ℝ) : ℂ)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual local H2 composition. Smooth approximation, bounded coefficient
convergence, L4 multiplication and the closed weak jet prove the chain rule;
no differentiability is assumed of the original L2 representative. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal ContDiff LineDeriv NNReal _root_.Topology

noncomputable section

local notation "V" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V)
local notation "S" => 𝓢(V, ℝ)
local notation "T" => 𝓢'(V, ℂ)
local notation "D" => fun (i : Fin 4) (φ : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} φ

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalar_localized_H2_composition (u : L2)
    (hu : MemSobolev 2 2 (scalarComplexL2 u : T))
    (χ : S) (hc : HasCompactSupport (χ : V → ℝ))
    (φ : ℝ → ℝ) (hφ : ContDiff ℝ ∞ φ) {C : ℝ≥0} (hLip : LipschitzWith C φ)
    (hzero : φ 0 = 0) {B₁ B₂ : ℝ} (h₁ : ∀ s, |deriv φ s| ≤ B₁)
    (h₂ : ∀ s, |deriv (deriv φ) s| ≤ B₂) :
    ∃ v : L2, MemSobolev 2 2 (scalarComplexL2 v : T) ∧
      (v : V → ℝ) =ᵐ[volume] fun x => χ x * φ (u x) := by
  obtain ⟨fn, G, G4, H, hpoint, hf', hG, hG4, hH⟩ := scalar_real_H2_approximation_ae u hu
  let V₀ : L2 := hLip.compLp hzero u
  let Vn : ℕ → L2 := fun n => hLip.compLp hzero ((fn n).toLp 2 volume)
  have hV : Tendsto Vn atTop (𝓝 V₀) :=
    (hLip.continuous_compLp hzero).continuousAt.tendsto.comp hf'
  let T₀ : Fin 4 → L2 := fun i => scalarDerivativeMultiplier φ hφ h₁ u
    (Lp.aestronglyMeasurable u) (G i)
  have hT (i : Fin 4) := scalarDerivativeMultiplier_tendsto φ hφ h₁ (fun n x => fn n x) u
    (fun n => (fn n).continuous.aestronglyMeasurable) (Lp.aestronglyMeasurable u)
    hpoint (fun n => (D i (fn n)).toLp 2 volume) (G i) (hG i)
  let Q₀ : Fin 4 → Fin 4 → L2 := fun i j => scalarCompositionHessian φ hφ h₁ h₂
    u (Lp.aestronglyMeasurable u) (G4 i) (G4 j) (H i j)
  have hQ (i j : Fin 4) := scalarCompositionHessian_tendsto φ hφ h₁ h₂ (fun n x => fn n x) u
    (fun n => (fn n).continuous.aestronglyMeasurable) (Lp.aestronglyMeasurable u) hpoint
    (fun n => (D i (fn n)).toLp 4 volume) (fun n => (D j (fn n)).toLp 4 volume)
    (fun n => (D i (D j (fn n))).toLp 2 volume) (G4 i) (G4 j) (H i j)
    (hG4 i) (hG4 j) (hH i j)
  let v : L2 := scalarRealSchwartzMultiply χ V₀
  let g : Fin 4 → L2 := fun i => scalarRealSchwartzMultiply (D i χ) V₀ +
    scalarRealSchwartzMultiply χ (T₀ i)
  let h : Fin 4 → Fin 4 → L2 := fun i j =>
    scalarRealSchwartzMultiply (D i (D j χ)) V₀ +
    scalarRealSchwartzMultiply (D j χ) (T₀ i) +
    scalarRealSchwartzMultiply (D i χ) (T₀ j) +
    scalarRealSchwartzMultiply χ (Q₀ i j)
  refine ⟨v, ?_, ?_⟩
  · apply scalar_real_H2_of_strong_jets (fun n => scalarLocalizedCompose χ hc φ hφ (fn n)) v g h
    · simp only [scalarLocalizedCompose_valueLp χ hc φ hφ hLip hzero]
      exact (scalarRealSchwartzMultiply χ).continuous.continuousAt.tendsto.comp hV
    · intro i
      simp only [scalarLocalizedCompose_first_L2 χ hc φ hφ hLip hzero h₁]
      exact ((scalarRealSchwartzMultiply (D i χ)).continuous.continuousAt.tendsto.comp hV).add
        ((scalarRealSchwartzMultiply χ).continuous.continuousAt.tendsto.comp (hT i))
    · intro i j
      simp only [scalarLocalizedCompose_second_L2 χ hc φ hφ hLip hzero h₁ h₂]
      have h₀ := (scalarRealSchwartzMultiply (D i (D j χ))).continuous.continuousAt.tendsto.comp hV
      have h₁ := (scalarRealSchwartzMultiply (D j χ)).continuous.continuousAt.tendsto.comp (hT i)
      have h₂ := (scalarRealSchwartzMultiply (D i χ)).continuous.continuousAt.tendsto.comp (hT j)
      have h₃ := (scalarRealSchwartzMultiply χ).continuous.continuousAt.tendsto.comp (hQ i j)
      exact ((h₀.add h₁).add h₂).add h₃
  · filter_upwards [scalarRealSchwartzMultiply_coe χ V₀, hLip.coeFn_compLp hzero u] with x hv hφu
    rw [hv, hφu]
    rfl

end
end PositiveEinsteinFour.Geometry
end


section

/-! A single smooth approximation controls all the finite jets used in the
nonlinear bootstrap, in L2, L4 and L-infinity at their required orders. -/

namespace PositiveEinsteinFour.Geometry

open MeasureTheory TemperedDistribution Filter
open scoped SchwartzMap ENNReal _root_.Topology

noncomputable section

local notation "V" => EuclideanSpace ℝ (Fin 4)
local notation "L2" => Lp ℂ 2 (volume : Measure V)
local notation "T" => 𝓢'(V, ℂ)
local notation "S" => 𝓢(V, ℂ)

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

theorem scalarSchwartzBesselJet_toLp_four (n : ℕ) (is : List (Fin 4))
    (h1 : is.length + 1 ≤ n) (φ : S) :
    (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).toLp 4 volume =
      scalarBesselJetL4 n is h1 (φ.toLp 2 volume) := by
  apply Lp.ext
  have h2 := (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).coeFn_toLp 2 volume
  rw [scalarSchwartzBesselJet_toLp n is (by omega)] at h2
  filter_upwards [(scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).coeFn_toLp 4 volume,
    scalarBesselJetL4_coe n is h1 (φ.toLp 2 volume), h2] with x hx h4 h2
  exact hx.trans (h2.symm.trans h4.symm)

theorem scalarSchwartzBesselJet_toLp_top (n : ℕ) (is : List (Fin 4))
    (h3 : is.length + 3 ≤ n) (φ : S) :
    (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).toLp ∞ volume =
      scalarBesselJetUniform n is h3 (φ.toLp 2 volume) := by
  apply Lp.ext
  have h2 := (scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).coeFn_toLp 2 volume
  rw [scalarSchwartzBesselJet_toLp n is (by omega)] at h2
  have htop : (scalarBesselJetUniform n is h3 (φ.toLp 2 volume) : V → ℂ) =ᵐ[volume]
      scalarBesselJetL2 n is (by omega) (φ.toLp 2 volume) :=
    scalarBesselJetUniform_coe n is h3 (φ.toLp 2 volume)
  filter_upwards [(scalarSchwartzCoordinateJet is (scalarSchwartzIntegerBesselInverse n φ)).coeFn_toLp ∞ volume,
    htop, h2] with x hx htop h2
  exact hx.trans (h2.symm.trans htop.symm)

/-- Density holds simultaneously for every required derivative of the same
smooth sequence, including almost-everywhere convergence of its values. -/
theorem scalar_integer_smooth_approximation (n : ℕ) (u : L2)
    (hu : MemSobolev (n : ℝ) 2 (u : T)) :
    ∃ (v : L2) (fs : ℕ → S), u = scalarIntegerBesselInverse n v ∧
      (∀ᵐ x ∂(volume : Measure V), Tendsto (fun k => fs k x) atTop (𝓝 (u x))) ∧
      Tendsto (fun k => (fs k).toLp 2 volume) atTop (𝓝 u) ∧
      (∀ is hle, Tendsto (fun k => (scalarSchwartzCoordinateJet is (fs k)).toLp 2 volume)
        atTop (𝓝 (scalarBesselJetL2 n is hle v))) ∧
      (∀ is h1, Tendsto (fun k => (scalarSchwartzCoordinateJet is (fs k)).toLp 4 volume)
        atTop (𝓝 (scalarBesselJetL4 n is h1 v))) ∧
      (∀ is h3, Tendsto (fun k => (scalarSchwartzCoordinateJet is (fs k)).toLp ∞ volume)
        atTop (𝓝 (scalarBesselJetUniform n is h3 v))) := by
  obtain ⟨v, φ, heq, hφ, hf⟩ := scalar_integer_Hn_schwartz_approximation n u hu
  let fs : ℕ → S := fun k => scalarSchwartzIntegerBesselInverse n (φ k)
  obtain ⟨ks, hks, hae⟩ := (tendstoInMeasure_of_tendsto_Lp hf).exists_seq_tendsto_ae
  refine ⟨v, fun k => fs (ks k), heq, ?_, hf.comp hks.tendsto_atTop, ?_, ?_, ?_⟩
  · have hco : ∀ᵐ x ∂(volume : Measure V), ∀ k, (fs (ks k)).toLp 2 volume x = fs (ks k) x :=
      ae_all_iff.mpr (fun k => (fs (ks k)).coeFn_toLp 2 volume)
    filter_upwards [hae, hco] with x hx he
    simpa only [fs, he] using hx
  · intro is hle
    simp only [fs, scalarSchwartzBesselJet_toLp n is hle]
    exact (scalarBesselJetL2 n is hle).continuous.continuousAt.tendsto.comp
      (hφ.comp hks.tendsto_atTop)
  · intro is h1
    simp only [fs, scalarSchwartzBesselJet_toLp_four n is h1]
    exact (scalarBesselJetL4 n is h1).continuous.continuousAt.tendsto.comp
      (hφ.comp hks.tendsto_atTop)
  · intro is h3
    simp only [fs, scalarSchwartzBesselJet_toLp_top n is h3]
    exact (scalarBesselJetUniform n is h3).continuous.continuousAt.tendsto.comp
      (hφ.comp hks.tendsto_atTop)

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual local H2 regularity of intrinsic weak solutions with L2 forcing.
The metric coefficients, source, scaling and cutoffs are all constructed. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance localL2Regularity_frameCompact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

theorem scalar_local_weighted_H2 (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (f : Lp ℝ 2 (normalizedVolume g)) (u : scalarH1 d)
    (hw : ∀ v : scalarH1 d,
      (∑ i : Fin 4, inner ℝ (scalarH1Gradient d i u) (scalarH1Gradient d i v)) =
        -(inner ℝ (scalarBasePullback g o f)
          (scalarH1Value d v))) (c : M) (z₀ : ChartTarget c) :
    ∃ r : ℝ, 0 < r ∧
      (∀ y ∈ closedBall (0 : V) 1,
        scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target) ∧
      ∃ w : Lp ℝ 2 (volume : Measure V),
        (fun y => chartVolumeDensity g c (scalarRescaledPoint g c z₀ r y) *
          scalarH1BaseValue g o d u
            ((chartAt FourSpace c).symm (scalarRescaledPoint g c z₀ r y))) =ᵐ[
              volume.restrict (ball (0 : V) 1)] w ∧
        ∀ φ : S, HasCompactSupport (φ : V → ℂ) →
          tsupport (φ : V → ℂ) ⊆ closedBall 0 (1 / 2) →
          MemSobolev 2 2 (smulLeftCLM ℂ φ (scalarComplexL2 w : T)) := by
  obtain ⟨χ, hχ, hc, ht, η₁, hη₁, hchart⟩ := exists_scalar_chart_cutoff g c z₀
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w₀ := scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)
  let w := scalarAffinePullbackL2 A z₀ w₀
  have hW : MemSobolev 1 2 (scalarComplexL2 w : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w₀
      (scalarWeightedChartL2_memSobolev_one g o d c hc ht u χ hχ hc (Subset.refl _))
  have htarget (y : V) (hy : y ∈ ball (0 : V) 1) :
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target :=
    (hchart r hr₁ y (ball_subset_closedBall hy)).1
  have hA (y : V) (hy : y ∈ ball (0 : V) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V) (hy : y ∈ ball (0 : V) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  let F := scalarRescaledSourceL2 g c f χ hχ hc ht z₀ r hr.ne'
  have hreal (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
      (hψs : tsupport ψ ⊆ ball (0 : V) 1) :
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F y * ψ y := by
    rw [scalarRescaled_L2_test_equation g o d f u hw c hc ht χ hχ hc (Subset.refl _)
      z₀ r hr.ne' ψ hψ hψc (fun y hy => htarget y (hψs hy))
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)]
    exact (scalarRescaledSourceL2_pairing g c f χ hχ hc ht z₀ r hr.ne' ψ
      (fun y hy => (hchart r hr₁ y (ball_subset_closedBall (hψs hy))).2)).symm
  have htests (φ : S) (hφc : HasCompactSupport (φ : V → ℂ))
      (hφs : tsupport (φ : V → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w : T)) φ =
        ∫ y, φ y * ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F w a b
      (ball 0 1) hA hB hreal φ hφc hφs (scalar_real_L2_test_integrable F φ _)
  refine ⟨r, hr, fun y hy => (hchart r hr₁ y hy).1, w, ?_, ?_⟩
  ·
    have hmp : Measure.QuasiMeasurePreserving (fun y : V => A y + z₀) volume volume := by
      refine ⟨by fun_prop, ?_⟩
      rw [scalarAffine_map_volume]
      exact Measure.smul_absolutelyContinuous
    have hbase := hmp.ae_eq_comp (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _))
    have hwr := scalarAffinePullbackL2_coe A z₀ w₀
    filter_upwards [ae_restrict_of_ae hbase, ae_restrict_of_ae hwr,
      ae_restrict_mem isOpen_ball.measurableSet] with y hbq hwq hy
    have hy₁ : y ∈ closedBall (0 : V) 1 := ball_subset_closedBall hy
    have hp := scalarRescalingLinearEquiv_apply g c z₀ r hr.ne' y
    dsimp only [Function.comp_apply] at hbq
    change w₀ (A y + z₀) = _ at hbq
    rw [hp, (hchart r hr₁ y hy₁).2, one_mul] at hbq
    change w y = w₀ (A y + z₀) at hwq
    rw [hp] at hwq
    exact (hwq.trans hbq).symm
  · intro φ hφc hφs
    exact scalar_ball_L2_forcing_gain a (scalarAdjointDrift a b)
      scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
      scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
      (scalarComplexL2 w : T) (fun y => ((-((2 * Real.pi) ^ 2)⁻¹ * F y : ℝ) : ℂ))
      (((Lp.memLp F).const_mul _).ofReal) hW htests
      (1 / 2) (by norm_num) (by norm_num) φ hφc hφs

end
end PositiveEinsteinFour.Geometry
end


section

/-! Quantitative local elliptic regularity for a real solution in rescaled
chart coordinates. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℂ)
local notation "T" => 𝓢'(V, ℂ)
local notation "D" => scalarSchwartzCoordinateDerivative

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

theorem scalar_rescaled_solution_smooth (g : SmoothMetric M) (c : M)
    (z₀ : ChartTarget c) (r : ℝ) (f : SmoothScalar (M := M))
    (w : Lp ℝ 2 (volume : Measure V)) (hW : MemSobolev 1 2 (scalarComplexL2 w : T))
    (a : Fin 4 → Fin 4 → S) (b : Fin 4 → S)
    (htarget : ∀ y ∈ ball (0 : V) 1,
      scalarRescaledPoint g c z₀ r y ∈ (chartAt FourSpace c).target)
    (hA : ∀ y ∈ ball (0 : V) 1, ∀ i j, a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ))
    (hB : ∀ y ∈ ball (0 : V) 1, ∀ i, b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ))
    (ha₀ : ∀ i j y, ‖a i j y‖ ≤ scalarEllipticSmallSize)
    (ha₁ : ∀ i j k y, ‖D k (a i j) y‖ ≤ scalarEllipticSmallSize)
    (ha₂ : ∀ i j k l y, ‖D k (D l (a i j)) y‖ ≤ scalarEllipticSmallSize)
    (hb₀ : ∀ j y, ‖scalarAdjointDrift a b j y‖ ≤ scalarEllipticSmallSize)
    (hb₁ : ∀ j k y, ‖D k (scalarAdjointDrift a b j) y‖ ≤ scalarEllipticSmallSize)
    (hreal : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
      tsupport ψ ⊆ ball (0 : V) 1 →
      (∫ y, w y * scalarRescaledOperator g c z₀ r ψ y) =
        ∫ y, scalarRescaledSource g c z₀ r f y * ψ y) :
    ∃ F : V → ℝ, ContDiff ℝ (⊤ : ℕ∞) F ∧
      (w : V → ℝ) =ᵐ[volume.restrict (ball (0 : V) (1 / 4))] F := by
  have htests := scalar_normalized_adjoint_test_equation g c z₀ r f w a b
    (ball (0 : V) 1) htarget hA hB hreal
  have hforce (n : ℕ) (ψ : S) (hψc : HasCompactSupport (ψ : V → ℂ))
      (hψs : tsupport (ψ : V → ℂ) ⊆ ball (0 : V) 1) :
      MemSobolev (n : ℝ) 2 (smulLeftCLM ℂ ψ
        (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w : T) -
          (scalarComplexL2 w : T) -
            smulLeftCLM ℂ (-scalarAdjointPotential a b : S) (scalarComplexL2 w : T))) := by
    rw [scalarFormalAdjointOperator_remainder]
    exact scalar_localize_smooth_source_memSobolev (ball (0 : V) 1) _ _
      (fun y hy => scalarRescaledSource_complex_contDiffAt g c z₀ r f y (htarget y hy))
      htests ψ hψc hψs n
  have hlocal (ψ : S) (_hc : HasCompactSupport (ψ : V → ℂ))
      (_hs : tsupport (ψ : V → ℂ) ⊆ ball (0 : V) 1) :
      MemSobolev 1 2 (smulLeftCLM ℂ ψ (scalarComplexL2 w : T)) := by
    simpa only [Nat.cast_one] using
      scalar_memSobolev_schwartz_multiplier 1 ψ (scalarComplexL2 w : T)
        (by simpa only [Nat.cast_one] using hW)
  obtain ⟨F, hF, heq⟩ := scalar_small_elliptic_potential_local_real_representative
    a (scalarAdjointDrift a b) scalarEllipticSmallSize scalarEllipticSmallSize_pos.le
    ha₀ ha₁ ha₂ hb₀ hb₁ scalarEllipticSmallSize_small
    (-scalarAdjointPotential a b) (scalarComplexL2 w) hlocal hforce
  refine ⟨F, hF, ?_⟩
  filter_upwards [heq, ae_restrict_of_ae (scalarComplexL2_coe w)] with y hy hw
  rwa [hw, Complex.ofReal_re] at hy

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual products of smooth approximants and their first two jets. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory LineDeriv
open scoped SchwartzMap ENNReal LineDeriv

noncomputable section

local notation "V" => FourSpace
local notation "S" => 𝓢(V, ℝ)
local notation "D" => fun (i : Fin 4) (f : S) => ∂_{EuclideanSpace.basisFun (Fin 4) ℝ i} f

local instance : Fact (1 ≤ (4 : ℝ≥0∞)) := ⟨by norm_num⟩

def scalarRealSchwartzProduct (f g : S) : S := SchwartzMap.smulLeftCLM ℝ f g

theorem scalarRealSchwartzProduct_apply (f g : S) (x : V) :
    scalarRealSchwartzProduct f g x = f x * g x := by
  exact SchwartzMap.smulLeftCLM_apply_apply f.hasTemperateGrowth g x

theorem scalarRealSchwartzProduct_first (f g : S) (i : Fin 4) :
    D i (scalarRealSchwartzProduct f g) =
      scalarRealSchwartzProduct (D i f) g + scalarRealSchwartzProduct f (D i g) := by
  ext x
  simp only [add_apply, scalarRealSchwartzDerivative_apply,
    scalarRealSchwartzProduct_apply]
  have he : (scalarRealSchwartzProduct f g : V → ℝ) = fun y => f y * g y :=
    funext (scalarRealSchwartzProduct_apply f g)
  rw [he]
  exact scalar_partial_product f g x f.differentiableAt g.differentiableAt i

theorem scalarRealSchwartzProduct_second (f g : S) (i j : Fin 4) :
    D i (D j (scalarRealSchwartzProduct f g)) =
      scalarRealSchwartzProduct (D i (D j f)) g +
      scalarRealSchwartzProduct (D j f) (D i g) +
      scalarRealSchwartzProduct (D i f) (D j g) +
      scalarRealSchwartzProduct f (D i (D j g)) := by
  calc
    D i (D j (scalarRealSchwartzProduct f g)) =
        D i (scalarRealSchwartzProduct (D j f) g + scalarRealSchwartzProduct f (D j g)) :=
      congrArg (fun h : S => D i h) (scalarRealSchwartzProduct_first f g j)
    _ = D i (scalarRealSchwartzProduct (D j f) g) +
        D i (scalarRealSchwartzProduct f (D j g)) :=
      (lineDerivOpCLM ℝ S (EuclideanSpace.basisFun (Fin 4) ℝ i)).map_add _ _
    _ = (scalarRealSchwartzProduct (D i (D j f)) g +
        scalarRealSchwartzProduct (D j f) (D i g)) +
        (scalarRealSchwartzProduct (D i f) (D j g) +
        scalarRealSchwartzProduct f (D i (D j g))) :=
      congrArg₂ (fun a b : S => a + b) (scalarRealSchwartzProduct_first (D j f) g i)
        (scalarRealSchwartzProduct_first f (D j g) i)
    _ = _ := by abel

private theorem realSchwartz_toLp_add (f g : S) :
    (f + g).toLp 2 volume = f.toLp 2 volume + g.toLp 2 volume :=
  (SchwartzMap.toLpCLM ℝ ℝ 2 volume).map_add f g

theorem scalarRealSchwartzProduct_L2_top (f g : S) :
    (scalarRealSchwartzProduct f g).toLp 2 volume =
      scalarLinfL2Product (g.toLp ∞ volume) (f.toLp 2 volume) := by
  apply Lp.ext
  filter_upwards [(scalarRealSchwartzProduct f g).coeFn_toLp 2 volume,
    scalarLinfL2Product_coe (g.toLp ∞ volume) (f.toLp 2 volume),
    f.coeFn_toLp 2 volume, g.coeFn_toLp ∞ volume] with x hfg hmul hf hg
  rw [hfg, hmul, hf, hg, scalarRealSchwartzProduct_apply, mul_comm]

theorem scalarRealSchwartzProduct_L2_four (f g : S) :
    (scalarRealSchwartzProduct f g).toLp 2 volume =
      scalarL4Product (f.toLp 4 volume) (g.toLp 4 volume) := by
  apply Lp.ext
  filter_upwards [(scalarRealSchwartzProduct f g).coeFn_toLp 2 volume,
    scalarL4Product_coe (f.toLp 4 volume) (g.toLp 4 volume),
    f.coeFn_toLp 4 volume, g.coeFn_toLp 4 volume] with x hfg hmul hf hg
  rw [hfg, hmul, hf, hg, scalarRealSchwartzProduct_apply]

theorem scalarRealSchwartzProduct_first_L2 (f g : S) (i : Fin 4) :
    (D i (scalarRealSchwartzProduct f g)).toLp 2 volume =
      scalarL4Product ((D i f).toLp 4 volume) (g.toLp 4 volume) +
      scalarL4Product (f.toLp 4 volume) ((D i g).toLp 4 volume) := by
  calc
    _ = (scalarRealSchwartzProduct (D i f) g + scalarRealSchwartzProduct f (D i g)).toLp 2 volume :=
      congrArg (fun h : S => h.toLp 2 volume) (scalarRealSchwartzProduct_first f g i)
    _ = (scalarRealSchwartzProduct (D i f) g).toLp 2 volume +
        (scalarRealSchwartzProduct f (D i g)).toLp 2 volume := realSchwartz_toLp_add _ _
    _ = _ := congrArg₂ (fun a b : Lp ℝ 2 (volume : Measure V) => a + b)
      (scalarRealSchwartzProduct_L2_four (D i f) g)
      (scalarRealSchwartzProduct_L2_four f (D i g))

private theorem realSchwartz_toLp_four_add (a b c d : S) :
    (a + b + c + d).toLp 2 volume =
      a.toLp 2 volume + b.toLp 2 volume + c.toLp 2 volume + d.toLp 2 volume := by
  rw [realSchwartz_toLp_add, realSchwartz_toLp_add, realSchwartz_toLp_add]

theorem scalarRealSchwartzProduct_second_L2 (f g : S) (i j : Fin 4) :
    (D i (D j (scalarRealSchwartzProduct f g))).toLp 2 volume =
      scalarLinfL2Product (g.toLp ∞ volume) ((D i (D j f)).toLp 2 volume) +
      scalarL4Product ((D j f).toLp 4 volume) ((D i g).toLp 4 volume) +
      scalarL4Product ((D i f).toLp 4 volume) ((D j g).toLp 4 volume) +
      scalarL4Product (f.toLp 4 volume) ((D i (D j g)).toLp 4 volume) := by
  calc
    _ = (scalarRealSchwartzProduct (D i (D j f)) g +
        scalarRealSchwartzProduct (D j f) (D i g) +
        scalarRealSchwartzProduct (D i f) (D j g) +
        scalarRealSchwartzProduct f (D i (D j g))).toLp 2 volume :=
      congrArg (fun h : S => h.toLp 2 volume) (scalarRealSchwartzProduct_second f g i j)
    _ = (scalarRealSchwartzProduct (D i (D j f)) g).toLp 2 volume +
        (scalarRealSchwartzProduct (D j f) (D i g)).toLp 2 volume +
        (scalarRealSchwartzProduct (D i f) (D j g)).toLp 2 volume +
        (scalarRealSchwartzProduct f (D i (D j g))).toLp 2 volume :=
      realSchwartz_toLp_four_add _ _ _ _
    _ = _ := congrArg₂ (fun a b : Lp ℝ 2 (volume : Measure V) => a + b)
      (congrArg₂ (fun a b : Lp ℝ 2 (volume : Measure V) => a + b)
        (congrArg₂ (fun a b : Lp ℝ 2 (volume : Measure V) => a + b)
          (scalarRealSchwartzProduct_L2_top (D i (D j f)) g)
          (scalarRealSchwartzProduct_L2_four (D j f) (D i g)))
        (scalarRealSchwartzProduct_L2_four (D i f) (D j g)))
      (scalarRealSchwartzProduct_L2_four f (D i (D j g)))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Actual Lp representatives and convergence in the subcritical range.
The inclusion uses the same almost-everywhere function; the convergence
statement combines small L² norm with a bounded L⁴ norm. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Filter
open scoped Manifold ContDiff NNReal ENNReal _root_.Topology

noncomputable section

local instance : Fact ((1 : ℝ≥0∞) ≤ 4) := ⟨by norm_num⟩

def scalarL4ToLpLinear {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    Lp ℝ 4 μ →ₗ[ℝ] Lp ℝ p μ where
  toFun f := ⟨f.val, Lp.antitone hp f.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem scalarL4ToLpLinear_coe {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4)
    (f : Lp ℝ 4 μ) : (scalarL4ToLpLinear μ p hp f : X → ℝ) = f := rfl

theorem scalarL4ToLpLinear_bound {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4)
    (f : Lp ℝ 4 μ) : ‖scalarL4ToLpLinear μ p hp f‖ ≤ ‖f‖ := by
  exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top f)
    (eLpNorm_le_eLpNorm_of_exponent_le hp)

def scalarL4ToLp {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    Lp ℝ 4 μ →L[ℝ] Lp ℝ p μ :=
  (scalarL4ToLpLinear μ p hp).mkContinuous 1
    (fun f => by simpa only [one_mul] using scalarL4ToLpLinear_bound μ p hp f)

theorem scalarL4ToLp_coe {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsProbabilityMeasure μ] (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4)
    (f : Lp ℝ 4 μ) : (scalarL4ToLp μ p hp f : X → ℝ) = f := rfl

theorem scalar_subcritical_moment_filter_tendsto_zero {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {ι : Type*} {l : Filter ι}
    (f : ι → X → ℝ) (hf : ∀ n, AEStronglyMeasurable (f n) μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) {B : ℝ≥0∞} (hB : B ≠ (∞ : ℝ≥0∞))
    (hfour : ∀ n, (∫⁻ x, ‖f n x‖ₑ ^ (4 : ℝ) ∂μ) ≤ B)
    (htwo : Tendsto (fun n => ∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) l (𝓝 0)) :
    Tendsto (fun n => ∫⁻ x, ‖f n x‖ₑ ^ p ∂μ) l (𝓝 0) := by
  have ha : 0 < (4 - p) / 2 := by linarith
  have hb : 0 ≤ (p - 2) / 2 := by linarith
  have hlimit : Tendsto
      (fun n => (∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) ^ ((4 - p) / 2)) l (𝓝 0) := by
    have h := (ENNReal.continuous_rpow_const (y := (4 - p) / 2)).tendsto (0 : ℝ≥0∞)
    rw [ENNReal.zero_rpow_of_pos ha] at h
    exact h.comp htwo
  have hbound : B ^ ((p - 2) / 2) ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_nonneg hb hB
  have hproduct := ENNReal.Tendsto.mul_const hlimit (Or.inr hbound)
  rw [zero_mul] at hproduct
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hproduct
    (fun n => (show (0 : ℝ≥0∞) ≤ (∫⁻ x, ‖f n x‖ₑ ^ p ∂μ) from bot_le))
  intro n
  exact (scalar_subcritical_moment_le (f n) (hf n) hp.le hp4.le).trans
    (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hfour n) hb))

theorem scalar_subcritical_eLpNorm_tendsto_zero {X : Type*} [MeasurableSpace X]
    {μ : Measure X} {ι : Type*} {l : Filter ι}
    (f : ι → X → ℝ) (hf : ∀ n, AEStronglyMeasurable (f n) μ)
    {p : ℝ} (hp : 2 < p) (hp4 : p < 4) {B : ℝ≥0∞} (hB : B ≠ (∞ : ℝ≥0∞))
    (hfour : ∀ n, eLpNorm (f n) 4 μ ≤ B)
    (htwo : Tendsto (fun n => eLpNorm (f n) 2 μ) l (𝓝 0)) :
    Tendsto (fun n => eLpNorm (f n) (ENNReal.ofReal p) μ) l (𝓝 0) := by
  have hm2 (n : ι) : (∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) =
      eLpNorm (f n) 2 μ ^ (2 : ℝ) :=
    (eLpNorm_nnreal_pow_eq_lintegral (p := (2 : ℝ≥0)) (by norm_num) (hf n)).symm
  have hm4 (n : ι) : (∫⁻ x, ‖f n x‖ₑ ^ (4 : ℝ) ∂μ) =
      eLpNorm (f n) 4 μ ^ (4 : ℝ) :=
    (eLpNorm_nnreal_pow_eq_lintegral (p := (4 : ℝ≥0)) (by norm_num) (hf n)).symm
  have ht : Tendsto (fun n => ∫⁻ x, ‖f n x‖ₑ ^ (2 : ℝ) ∂μ) l (𝓝 0) := by
    simpa only [Function.comp_def, hm2,
      ENNReal.zero_rpow_of_pos (by norm_num : (0 : ℝ) < 2)] using
      ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto 0).comp htwo
  have hb4 : B ^ (4 : ℝ) ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_nonneg (by norm_num) hB
  have hmoment := scalar_subcritical_moment_filter_tendsto_zero f hf hp hp4 hb4
    (fun n => by rw [hm4]; exact ENNReal.rpow_le_rpow (hfour n) (by norm_num)) ht
  have hp0 : 0 < p := lt_trans (by norm_num) hp
  have hpow := ((ENNReal.continuous_rpow_const (y := 1 / p)).tendsto 0).comp hmoment
  rw [ENNReal.zero_rpow_of_pos (one_div_pos.mpr hp0)] at hpow
  convert hpow using 1
  funext n
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ne_of_gt (ENNReal.ofReal_pos.mpr hp0)) ENNReal.ofReal_ne_top (hf n),
    ENNReal.toReal_ofReal hp0.le]
  rfl

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M]

local instance subcriticalEmbedding_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

local instance subcriticalEmbedding_probability (g : SmoothMetric M) :
    IsProbabilityMeasure (normalizedVolume g) :=
  normalizedVolume_isProbability (actual_finitePositiveVolume g)

def scalarH1BaseLp (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) :
    scalarH1 d →L[ℝ] Lp ℝ p (normalizedVolume g) :=
  (scalarL4ToLp (normalizedVolume g) p hp).comp (scalarH1BaseL4 g o d)

theorem scalarH1BaseLp_coe (g : SmoothMetric M) (o : FrameOrientation g)
    (d : ParallelMetricData g (canonicalFrameMeasure g o))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≤ 4) (u : scalarH1 d) :
    scalarH1BaseLp g o d p hp u =ᵐ[normalizedVolume g] scalarH1BaseValue g o d u :=
  scalarH1BaseL4_coe g o d u

end
end PositiveEinsteinFour.Geometry
end


section

/-! Compact scalar components of an actual two-form in an orthonormal
chart frame, expressed by finitely many coordinate cutoffs. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Set
open RellichKondrachov.Analysis.FunctionalSpaces.Sobolev
open scoped BigOperators Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormGramCutoffWeight (g : SmoothMetric M) (c : M) (S : Mat4)
    (χ : FourSpace → ℝ) (v b : Fin 2 → Fin 4) (z : FourSpace) : ℝ :=
  χ z * ∏ k, chartGramMatrix g c S z (b k) (v k)

theorem twoFormGramCutoffWeight_smooth (g : SmoothMetric M) (c : M) (S : Mat4)
    {K : Set FourSpace} (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hs : tsupport χ ⊆ K)
    (v b : Fin 2 → Fin 4) : ContDiff ℝ ∞ (twoFormGramCutoffWeight g c S χ v b) := by
  apply scalarCutoff_contDiff χ _ hχ
  intro z hz
  exact contDiffAt_prod (fun k _ => chartGramMatrix_contDiffAt g c S z (hKt (hs hz)) (b k) (v k))

theorem twoFormGramCutoffWeight_support (g : SmoothMetric M) (c : M) (S : Mat4)
    (χ : FourSpace → ℝ) (v b : Fin 2 → Fin 4) :
    tsupport (twoFormGramCutoffWeight g c S χ v b) ⊆ tsupport χ :=
  tsupport_mul_subset_left

theorem twoFormGramCutoffWeight_compact (g : SmoothMetric M) (c : M) (S : Mat4)
    (χ : FourSpace → ℝ) (hc : HasCompactSupport χ) (v b : Fin 2 → Fin 4) :
    HasCompactSupport (twoFormGramCutoffWeight g c S χ v b) := hc.mul_right

def twoFormGramCutoffC1 (c : M) (S : Mat4) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) :
    SmoothH1TwoForm o →ₗ[ℝ] ↥(Euclidean.C1c (E := FourSpace)) :=
  ∑ b : Fin 2 → Fin 4,
    twoFormCutoffC1 c hKt (twoFormGramCutoffWeight g c S χ v b)
      (twoFormGramCutoffWeight_smooth g c S hKt χ hχ hs v b)
      (twoFormGramCutoffWeight_compact g c S χ hc v b)
      ((twoFormGramCutoffWeight_support g c S χ v b).trans hs) b

theorem twoFormGramCutoffC1_apply (c : M) (S : Mat4) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) (z : FourSpace) :
    (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val z =
      χ z * frameTensor (chartGramMatrix g c S z) (twoFormCoordinates o (u : smoothTwoForms o).val c z) v := by
  simp only [twoFormGramCutoffC1, LinearMap.sum_apply, Submodule.coe_sum, Finset.sum_apply]
  change (∑ b : Fin 2 → Fin 4, twoFormGramCutoffWeight g c S χ v b z *
    twoFormCoordinates o (u : smoothTwoForms o).val c z b) = _
  simp only [twoFormGramCutoffWeight, frameTensor, Finset.mul_sum, mul_assoc]

theorem twoFormGramCutoffC1_value (c : M) (S : Mat4) (hS : Sᵀ * S = 1)
    {K : Set FourSpace} (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) (z : FourSpace) :
    (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val z =
      χ z * twoFormTensor (twoFormChartValue o (u : smoothTwoForms o).val c S hS z) v := by
  rw [twoFormGramCutoffC1_apply]
  by_cases hz : z ∈ (chartAt FourSpace c).target
  · rw [twoFormChartValue_tensor o _ c S hS z hz]
  · have ht : z ∉ tsupport χ := fun h => hz (hKt (hs h))
    rw [image_eq_zero_of_notMem_tsupport ht, zero_mul, zero_mul]

theorem twoFormGramCutoffC1_support (c : M) (S : Mat4) {K : Set FourSpace}
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (v : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) :
    tsupport (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val ⊆ K := by
  rw [show (twoFormGramCutoffC1 c S hKt χ hχ hc hs v u).val =
    (fun z => χ z * frameTensor (chartGramMatrix g c S z)
      (twoFormCoordinates o (u : smoothTwoForms o).val c z) v) from
        funext (twoFormGramCutoffC1_apply c S hKt χ hχ hc hs v u)]
  exact tsupport_mul_subset_left.trans hs

end
end PositiveEinsteinFour.Geometry
end


section

/-! Local two-form components in the original Lebesgue measurable space,
and their bounded reconstruction in the actual normalized base measure. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [MeasurableSpace M] [BorelSpace M]
  [CompactSpace M] [Nonempty M] {g : SmoothMetric M} {o : FrameOrientation g}

def twoFormLocalValueL2 (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) :
    TwoFormH1 o →L[ℝ] Lp ℝ 2 (volume : Measure FourSpace) :=
  (scalarBorelLpEquiv ℝ 2).symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    (twoFormCutoffValueL2 c hK hKt χ hχ hc hs a)

theorem twoFormLocalValueL2_compact (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) :
    IsCompactOperator (twoFormLocalValueL2 (o := o) c hK hKt χ hχ hc hs a) :=
  (twoFormCutoffValueL2_compact c hK hKt χ hχ hc hs a).clm_comp
    (scalarBorelLpEquiv ℝ 2).symm.toContinuousLinearEquiv.toContinuousLinearMap

theorem twoFormLocalValueL2_smooth (c : M) {K : Set FourSpace} (hK : IsCompact K)
    (hKt : K ⊆ (chartAt FourSpace c).target)
    (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
    (hs : tsupport χ ⊆ K) (a : Fin 2 → Fin 4) (u : SmoothH1TwoForm o) :
    twoFormLocalValueL2 c hK hKt χ hχ hc hs a (smoothTwoFormToH1 u) =
      ScalarEuclideanSobolev.valueL2 (twoFormCutoffC1 c hKt χ hχ hc hs a u) := by
  change (scalarBorelLpEquiv ℝ 2).symm
    (twoFormCutoffValueL2 c hK hKt χ hχ hc hs a (smoothTwoFormToH1 u)) = _
  rw [twoFormCutoffValueL2_smooth, ← scalarBorel_valueL2]
  exact (scalarBorelLpEquiv ℝ 2).symm_apply_apply _

def twoFormReconstructedValue (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) (a : Fin 2 → Fin 4) :
    TwoFormH1 o →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs)).comp
      (twoFormLocalValueL2 c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
        (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
        (scalarChartCutoff_support c ρ hs) a)

theorem twoFormReconstructedValue_compact (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) (a : Fin 2 → Fin 4) :
    IsCompactOperator (twoFormReconstructedValue (o := o) c ρ hs a) :=
  (twoFormLocalValueL2_compact c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
    (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
    (scalarChartCutoff_support c ρ hs) a).clm_comp
      (scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs))

theorem twoFormReconstructedValue_smooth_coe (c : M) (ρ : SmoothScalar (M := M))
    (hs : tsupport ρ.val ⊆ (chartAt FourSpace c).source) (a : Fin 2 → Fin 4)
    (u : SmoothH1TwoForm o) :
    twoFormReconstructedValue c ρ hs a (smoothTwoFormToH1 u) =ᵐ[normalizedVolume g]
      fun x => ρ.val x * twoFormCoordinates o (u : smoothTwoForms o).val c (chartAt FourSpace c x) a := by
  let K := scalarChartSupport c ρ
  let f := twoFormCutoffC1 c (scalarChartSupport_subset c ρ hs)
    (scalarChartCutoff c ρ) (scalarChartCutoff_smooth c ρ hs)
    (scalarChartCutoff_compact c ρ hs) (scalarChartCutoff_support c ρ hs) a u
  have hpoint : scalarChartReconstructionFun c K f.val =
      fun x => ρ.val x * twoFormCoordinates o (u : smoothTwoForms o).val c (chartAt FourSpace c x) a := by
    funext x
    by_cases hx : x ∈ (chartAt FourSpace c).symm '' K
    · have hxs : x ∈ (chartAt FourSpace c).source := by
        obtain ⟨z, hz, rfl⟩ := hx
        exact (chartAt FourSpace c).map_target (scalarChartSupport_subset c ρ hs hz)
      change ((chartAt FourSpace c).symm '' K).indicator _ x = _
      rw [indicator_of_mem hx]
      change scalarChartCutoff c ρ (chartAt FourSpace c x) * _ = _
      rw [scalarChartCutoff_apply c ρ hxs]
    · have hρ : ρ.val x = 0 := by
        by_contra hn
        have ht := subset_tsupport ρ.val hn
        exact hx ⟨chartAt FourSpace c x, ⟨x, ht, rfl⟩, (chartAt FourSpace c).left_inv (hs ht)⟩
      change ((chartAt FourSpace c).symm '' K).indicator _ x = _
      rw [indicator_of_notMem hx, hρ, zero_mul]
  change scalarChartReconstruction g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs)
    (twoFormLocalValueL2 c (scalarChartSupport_compact c ρ hs)
      (scalarChartSupport_subset c ρ hs) (scalarChartCutoff c ρ)
      (scalarChartCutoff_smooth c ρ hs) (scalarChartCutoff_compact c ρ hs)
      (scalarChartCutoff_support c ρ hs) a (smoothTwoFormToH1 u)) =ᵐ[_] _
  rw [twoFormLocalValueL2_smooth]
  exact (scalarChartReconstruction_coe g c (scalarChartSupport_compact c ρ hs)
    (scalarChartSupport_subset c ρ hs) (ScalarEuclideanSobolev.valueL2 f)).trans
      ((scalarChartReconstructionFun_ae g c (scalarChartSupport_compact c ρ hs)
        (scalarChartSupport_subset c ρ hs) (ScalarEuclideanSobolev.valueL2_coe f)).trans
        (Filter.Eventually.of_forall (congrFun hpoint)))

end
end PositiveEinsteinFour.Geometry
end


section

/-! The local six-component heat operator in a radial frame. The additional
first-order Gaussian term vanishes by the radial connection identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

abbrev HeatMat6 := Matrix (Fin 6) (Fin 6) ℝ

def fourHeatBundleFirst (B : Fin 4 → HeatMat6) (u : FourSpace → Fin 6 → ℝ)
    (x : FourSpace) (k : Fin 6) : ℝ :=
  ∑ i : Fin 4, ∑ l : Fin 6, B i k l * partialDeriv (fun y => u y l) i x

def fourHeatBundleZero (C : HeatMat6) (u : FourSpace → Fin 6 → ℝ)
    (x : FourSpace) (k : Fin 6) : ℝ := ∑ l : Fin 6, C k l * u x l

def fourHeatBundleOperator (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) (u : FourSpace → Fin 6 → ℝ)
    (x : FourSpace) (k : Fin 6) : ℝ :=
  fourHeatLocalOperator a b 0 (fun y => u y k) x +
    fourHeatBundleFirst B u x k + fourHeatBundleZero C u x k

theorem fourHeatBundleFirst_gaussian (B : Fin 4 → HeatMat6)
    (t : ℝ) (ht : t ≠ 0) (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (hu : ∀ l, DifferentiableAt ℝ (fun y => u y l) x)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0) (k : Fin 6) :
    fourHeatBundleFirst B (fun y l => fourHeatGaussian t y * u y l) x k =
      fourHeatGaussian t x * fourHeatBundleFirst B u x k := by
  have hz : (∑ i : Fin 4, ∑ l : Fin 6, x i * B i k l * u x l) = 0 := by
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_mul, hB]
    simp
  unfold fourHeatBundleFirst
  simp_rw [fourHeatGaussian_amplitude_partial_at t ht _ x (hu _)]
  have he (i : Fin 4) (l : Fin 6) :
      B i k l * (fourHeatGaussian t x *
        (partialDeriv (fun y => u y l) i x - x i / (2 * t) * u x l)) =
      fourHeatGaussian t x * (B i k l * partialDeriv (fun y => u y l) i x) -
        (fourHeatGaussian t x / (2 * t)) * (x i * B i k l * u x l) := by ring
  simp_rw [he, Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [hz]
  ring

theorem fourHeatBundleZero_gaussian (C : HeatMat6) (t : ℝ)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace) (k : Fin 6) :
    fourHeatBundleZero C (fun y l => fourHeatGaussian t y * u y l) x k =
      fourHeatGaussian t x * fourHeatBundleZero C u x k := by
  unfold fourHeatBundleZero
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l _
  ring

theorem fourHeatBundleOperator_transport_residual_at (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → HeatMat6) (C : HeatMat6) (t : ℝ) (ht : 0 < t)
    (u : FourSpace → Fin 6 → ℝ) (x : FourSpace)
    (hu : ∀ l, ContDiffAt ℝ 2 (fun y => u y l) x)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0) (k : Fin 6) :
    deriv (fun s => fourHeatGaussian s x * u x k) t +
      fourHeatBundleOperator a b B C (fun y l => fourHeatGaussian t y * u y l) x k =
    fourHeatGaussian t x *
      (fourHeatBundleOperator a b B C u x k +
        fourHeatRadialTransport a b (fun y => u y k) x / t +
        fourHeatEikonalDefect a x / t ^ 2 * u x k) := by
  unfold fourHeatBundleOperator
  rw [fourHeatBundleFirst_gaussian B t ht.ne' u x
      (fun l => (hu l).differentiableAt (by norm_num)) hB,
    fourHeatBundleZero_gaussian]
  have hs := fourHeatLocalOperator_transport_residual_at a b 0 t ht
    (fun y => u y k) x (hu k)
  linarith

end
end PositiveEinsteinFour.Geometry
end


section

/-! The leading scalar heat transport equation in density divergence form. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter
open scoped _root_.Topology BigOperators

noncomputable section

def fourHeatDensityDrift (a : FourSpace → Mat4) (J : FourSpace → ℝ)
    (x : FourSpace) (j : Fin 4) : ℝ :=
  -((∑ i : Fin 4, partialDeriv (fun y => a y i j) i x) +
    (J x)⁻¹ * ∑ i : Fin 4, a x i j * partialDeriv J i x)

theorem fourHeatDensityDrift_radial (a : FourSpace → Mat4) (J : FourSpace → ℝ)
    (x : FourSpace) (ha : ∀ i j, DifferentiableAt ℝ (fun y => a y i j) x)
    (hrad : ∀ᶠ y in 𝓝 x, ∀ i, ∑ j : Fin 4, a y i j * y j = y i) :
    (∑ j : Fin 4, fourHeatDensityDrift a J x j * x j) =
      (∑ i : Fin 4, a x i i) - 4 - fderiv ℝ J x x / J x := by
  have hdiv := fourHeat_radial_divergence a x ha hrad
  have hcontract : (∑ j : Fin 4, (∑ i : Fin 4, a x i j * partialDeriv J i x) * x j) =
      fderiv ℝ J x x := by
    rw [fourHeat_radial_derivative]
    calc
      _ = ∑ i : Fin 4, (∑ j : Fin 4, a x i j * x j) * partialDeriv J i x := by
        norm_num [Fin.sum_univ_four]
        ring
      _ = _ := by simp_rw [hrad.self_of_nhds]
  have hb : (∑ j : Fin 4, fourHeatDensityDrift a J x j * x j) =
      -(∑ i : Fin 4, ∑ j : Fin 4, partialDeriv (fun y => a y i j) i x * x j) -
        (J x)⁻¹ * (∑ j : Fin 4, (∑ i : Fin 4, a x i j * partialDeriv J i x) * x j) := by
    norm_num [fourHeatDensityDrift, Fin.sum_univ_four]
    ring
  rw [hb, hcontract, div_eq_mul_inv]
  nlinarith only [hdiv]

theorem fourHeat_normalized_amplitude_radial (J u : FourSpace → ℝ) (x : FourSpace)
    (hJ : DifferentiableAt ℝ J x) (hu : DifferentiableAt ℝ u x)
    (hnorm : ∀ᶠ y in 𝓝 x, u y ^ 2 * J y = 1) :
    fderiv ℝ u x x + (fderiv ℝ J x x / (2 * J x)) * u x = 0 := by
  have hn := hnorm.self_of_nhds
  have hu0 : u x ≠ 0 := by intro h; simp [h] at hn
  have hJ0 : J x ≠ 0 := by intro h; simp [h] at hn
  have hd := (hu.hasFDerivAt.pow 2).mul hJ.hasFDerivAt
  have heq : (fun _ : FourSpace => (1 : ℝ)) =ᶠ[𝓝 x] (fun y => u y ^ 2 * J y) := by
    filter_upwards [hnorm] with y hy
    exact hy.symm
  have hL := (hd.congr_of_eventuallyEq heq).unique
    (hasFDerivAt_const (1 : ℝ) x)
  have hv := congrArg (fun L : FourSpace →L[ℝ] ℝ => L x) hL
  simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul,
    _root_.zero_apply] at hv
  norm_num [smul_eq_mul] at hv
  have hcancel : u x * (2 * J x * fderiv ℝ u x x + u x * fderiv ℝ J x x) = 0 := by
    nlinarith only [hv]
  have hc := (mul_eq_zero.mp hcancel).resolve_left hu0
  field_simp [hJ0]
  nlinarith only [hc]

theorem fourHeatDensity_leading_transport (a : FourSpace → Mat4) (J u : FourSpace → ℝ)
    (x : FourSpace) (ha : ∀ i j, DifferentiableAt ℝ (fun y => a y i j) x)
    (hJ : DifferentiableAt ℝ J x) (hu : DifferentiableAt ℝ u x)
    (hrad : ∀ᶠ y in 𝓝 x, ∀ i, ∑ j : Fin 4, a y i j * y j = y i)
    (hcol : ∀ j, ∑ i : Fin 4, a x i j * x i = x j)
    (hnorm : ∀ᶠ y in 𝓝 x, u y ^ 2 * J y = 1) :
    fourHeatRadialTransport (a x) (fourHeatDensityDrift a J x) u x = 0 := by
  rw [fourHeatRadialTransport_of_radial (a x) _ u x hrad.self_of_nhds hcol,
    fourHeatDensityDrift_radial a J x ha hrad]
  have hn := fourHeat_normalized_amplitude_radial J u x hJ hu hnorm
  convert hn using 1
  ring

end
end PositiveEinsteinFour.Geometry
end


section

/-! The local four-component heat operator in a radial frame. The additional
first-order Gaussian term vanishes by the radial connection identity. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix
open scoped BigOperators ContDiff

noncomputable section

def fourHeatOneFirst (B : Fin 4 → Mat4) (u : FourSpace → Fin 4 → ℝ)
    (x : FourSpace) (k : Fin 4) : ℝ :=
  ∑ i : Fin 4, ∑ l : Fin 4, B i k l * partialDeriv (fun y => u y l) i x

def fourHeatOneZero (C : Mat4) (u : FourSpace → Fin 4 → ℝ)
    (x : FourSpace) (k : Fin 4) : ℝ := ∑ l : Fin 4, C k l * u x l

def fourHeatOneOperator (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4) (u : FourSpace → Fin 4 → ℝ)
    (x : FourSpace) (k : Fin 4) : ℝ :=
  fourHeatLocalOperator a b 0 (fun y => u y k) x +
    fourHeatOneFirst B u x k + fourHeatOneZero C u x k

theorem fourHeatOneFirst_gaussian (B : Fin 4 → Mat4)
    (t : ℝ) (ht : t ≠ 0) (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (hu : ∀ l, DifferentiableAt ℝ (fun y => u y l) x)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0) (k : Fin 4) :
    fourHeatOneFirst B (fun y l => fourHeatGaussian t y * u y l) x k =
      fourHeatGaussian t x * fourHeatOneFirst B u x k := by
  have hz : (∑ i : Fin 4, ∑ l : Fin 4, x i * B i k l * u x l) = 0 := by
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_mul, hB]
    simp
  unfold fourHeatOneFirst
  simp_rw [fourHeatGaussian_amplitude_partial_at t ht _ x (hu _)]
  have he (i : Fin 4) (l : Fin 4) :
      B i k l * (fourHeatGaussian t x *
        (partialDeriv (fun y => u y l) i x - x i / (2 * t) * u x l)) =
      fourHeatGaussian t x * (B i k l * partialDeriv (fun y => u y l) i x) -
        (fourHeatGaussian t x / (2 * t)) * (x i * B i k l * u x l) := by ring
  simp_rw [he, Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [hz]
  ring

theorem fourHeatOneZero_gaussian (C : Mat4) (t : ℝ)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace) (k : Fin 4) :
    fourHeatOneZero C (fun y l => fourHeatGaussian t y * u y l) x k =
      fourHeatGaussian t x * fourHeatOneZero C u x k := by
  unfold fourHeatOneZero
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l _
  ring

theorem fourHeatOneOperator_transport_residual_at (a : Mat4) (b : Fin 4 → ℝ)
    (B : Fin 4 → Mat4) (C : Mat4) (t : ℝ) (ht : 0 < t)
    (u : FourSpace → Fin 4 → ℝ) (x : FourSpace)
    (hu : ∀ l, ContDiffAt ℝ 2 (fun y => u y l) x)
    (hB : ∀ k l, (∑ i : Fin 4, x i * B i k l) = 0) (k : Fin 4) :
    deriv (fun s => fourHeatGaussian s x * u x k) t +
      fourHeatOneOperator a b B C (fun y l => fourHeatGaussian t y * u y l) x k =
    fourHeatGaussian t x *
      (fourHeatOneOperator a b B C u x k +
        fourHeatRadialTransport a b (fun y => u y k) x / t +
        fourHeatEikonalDefect a x / t ^ 2 * u x k) := by
  unfold fourHeatOneOperator
  rw [fourHeatOneFirst_gaussian B t ht.ne' u x
      (fun l => (hu l).differentiableAt (by norm_num)) hB,
    fourHeatOneZero_gaussian]
  have hs := fourHeatLocalOperator_transport_residual_at a b 0 t ht
    (fun y => u y k) x (hu k)
  linarith

end
end PositiveEinsteinFour.Geometry
end


section

/-! The regular radial integral used to construct successive heat
coefficients, including at the origin. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set Filter Metric
open scoped ContDiff _root_.Topology Interval

noncomputable section

def fourHeatRadialAverage (m : ℕ) (f : FourSpace → ℝ) (x : FourSpace) : ℝ :=
  ∫ s : ℝ in 0..1, s ^ m * f (s • x)

def fourHeatRadialAverageDerivative (m : ℕ) (f : FourSpace → ℝ)
    (x : FourSpace) (s : ℝ) : FourSpace →L[ℝ] ℝ :=
  s ^ (m + 1) • fderiv ℝ f (s • x)

theorem fourHeatRadialAverage_integrand_derivative (m : ℕ) (f : FourSpace → ℝ)
    (x : FourSpace) (s : ℝ) (hf : DifferentiableAt ℝ f (s • x)) :
    HasFDerivAt (fun y => s ^ m * f (s • y))
      (fourHeatRadialAverageDerivative m f x s) x := by
  have hd := (hf.hasFDerivAt.comp x
    (s • ContinuousLinearMap.id ℝ FourSpace).hasFDerivAt).const_mul (s ^ m)
  convert hd using 1
  · rfl
  · apply ContinuousLinearMap.ext
    intro v
    simp only [fourHeatRadialAverageDerivative, _root_.smul_apply,
      ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply, map_smul,
      smul_eq_mul, pow_succ]
    ring

theorem fourHeatRadialAverageDerivative_continuous (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) :
    Continuous (fun p : FourSpace × ℝ => fourHeatRadialAverageDerivative m f p.1 p.2) := by
  have hs : Continuous (fun p : FourSpace × ℝ => p.2 • p.1) :=
    continuous_snd.smul continuous_fst
  exact (continuous_snd.pow (m + 1)).smul ((hf.continuous_fderiv one_ne_zero).comp hs)

theorem fourHeatRadialAverageDerivative_bound (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (x : FourSpace) :
    ∃ C ≥ (0 : ℝ), ∀ s ∈ Icc (0 : ℝ) 1, ∀ y ∈ ball x 1,
      ‖fourHeatRadialAverageDerivative m f y s‖ ≤ C := by
  have hD := (hf.continuous_fderiv one_ne_zero).norm
  obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : FourSpace) (‖x‖ + 1)).bddAbove_image
    hD.continuousOn
  refine ⟨max C 0, le_max_right _ _, ?_⟩
  intro s hs y hy
  have hys : s • y ∈ closedBall (0 : FourSpace) (‖x‖ + 1) := by
    rw [mem_closedBall, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_nonneg hs.1]
    calc
      s * ‖y‖ ≤ ‖y‖ := mul_le_of_le_one_left (norm_nonneg _) hs.2
      _ ≤ ‖y - x‖ + ‖x‖ := norm_le_norm_sub_add y x
      _ ≤ ‖x‖ + 1 := by
        have hxy : ‖y - x‖ < 1 := by simpa only [mem_ball, dist_eq_norm] using hy
        linarith
  have hpow : s ^ (m + 1) ≤ 1 := pow_le_one₀ hs.1 hs.2
  calc
    _ = s ^ (m + 1) * ‖fderiv ℝ f (s • y)‖ := by
      rw [fourHeatRadialAverageDerivative, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hs.1 _)]
    _ ≤ ‖fderiv ℝ f (s • y)‖ := mul_le_of_le_one_left (norm_nonneg _) hpow
    _ ≤ C := hC (mem_image_of_mem _ hys)
    _ ≤ max C 0 := le_max_left _ _

theorem fourHeatRadialAverage_hasFDerivAt (m : ℕ) (f : FourSpace → ℝ)
    (hf : ContDiff ℝ 1 f) (x : FourSpace) :
    HasFDerivAt (fourHeatRadialAverage m f)
      (∫ s : ℝ in 0..1, fourHeatRadialAverageDerivative m f x s) x := by
  obtain ⟨C, _, hC⟩ := fourHeatRadialAverageDerivative_bound m f hf x
  have hF (y : FourSpace) : Continuous (fun s : ℝ => s ^ m * f (s • y)) :=
    (continuous_id.pow m).mul (hf.continuous.comp (continuous_id.smul continuous_const))
  have hD (y : FourSpace) : Continuous (fourHeatRadialAverageDerivative m f y) :=
    (fourHeatRadialAverageDerivative_continuous m f hf).comp
      (continuous_const.prodMk continuous_id)
  exact intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F := fun y s => s ^ m * f (s • y))
    (F' := fourHeatRadialAverageDerivative m f) (bound := fun _ => C)
    (ball_mem_nhds x one_pos)
    (Eventually.of_forall fun y => (hF y).aestronglyMeasurable)
    ((hF x).intervalIntegrable 0 1) (hD x).aestronglyMeasurable
    (Eventually.of_forall fun s hs => hC s (by
      rw [uIoc_of_le zero_le_one] at hs
      exact ⟨hs.1.le, hs.2⟩))
    (continuous_const.intervalIntegrable 0 1)
    (Eventually.of_forall fun s _ y _ =>
      fourHeatRadialAverage_integrand_derivative m f y s
        ((hf.differentiable one_ne_zero).differentiableAt))

end
end PositiveEinsteinFour.Geometry
end


section

/-! Nondegeneracy and eikonal cancellation on an actual neighborhood of
the origin in the exponential coordinates. No invertibility premise remains
in the neighborhood theorem. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour Matrix Filter Set Metric
open scoped Manifold ContDiff _root_.Topology

noncomputable section

attribute [local instance] normedAddCommGroupTangentSpaceVectorSpace
  normedSpaceTangentSpaceVectorSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M]

theorem heatNormalMetric_pairing (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v : FourSpace) (a b : Fin 4 → ℝ) :
    a ⬝ᵥ (heatNormalMetric g o e v *ᵥ b) =
      g.inner (frameExponential g o e v)
        (mfderiv I4 I4 (frameExponential g o e) v (WithLp.toLp 2 a))
        (mfderiv I4 I4 (frameExponential g o e) v (WithLp.toLp 2 b)) := by
  let D : FourSpace →L[ℝ] FourSpace := mfderiv I4 I4 (frameExponential g o e) v
  let B : FourSpace →L[ℝ] FourSpace →L[ℝ] ℝ := g.inner (frameExponential g o e v)
  change (∑ i, a i * (heatNormalMetric g o e v *ᵥ b) i) = B (D _) (D _)
  conv_rhs => rw [← sum_coordinateVector a, map_sum, map_sum]
  simp only [map_smul, _root_.sum_apply, _root_.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  rw [heatNormalMetric_row g o e v (WithLp.toLp 2 b) i]
  rfl

theorem heatNormalMetric_posDef (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (v : FourSpace)
    (hinj : Function.Injective (mfderiv I4 I4 (frameExponential g o e) v)) :
    (heatNormalMetric g o e v).PosDef := by
  apply Matrix.PosDef.of_dotProduct_mulVec_pos
  · exact Matrix.isHermitian_iff_isSymm.mpr (heatNormalMetric_symm g o e v)
  · intro a ha
    simp only [star_trivial]
    rw [heatNormalMetric_pairing]
    apply g.pos
    intro hz
    apply ha
    apply WithLp.toLp_injective 2
    apply hinj
    let D : FourSpace →L[ℝ] FourSpace := mfderiv I4 I4 (frameExponential g o e) v
    change D (WithLp.toLp 2 a) = D 0
    rw [map_zero]
    exact hz

theorem heatNormalMetric_det_of_chart_unit (g : SmoothMetric M) (o : FrameOrientation g)
    (e : FrameBundle g) (c : M) (v : FourSpace)
    (hc : frameExponential g o e v ∈ (chartAt FourSpace c).source)
    (hunit : IsUnit (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v)) :
    (heatNormalMetric g o e v).det ≠ 0 := by
  have hcomp := mfderiv_comp v
    ((mdifferentiable_chart (I := I4) c).mdifferentiableAt hc)
    ((frameExponential_contMDiff g o e).mdifferentiable one_ne_zero v)
  rw [mfderiv_eq_fderiv] at hcomp
  change fderiv ℝ (fun z : FourSpace => chartAt FourSpace c (frameExponential g o e z)) v =
    (show FourSpace →L[ℝ] FourSpace from
      mfderiv I4 I4 (chartAt FourSpace c) (frameExponential g o e v)).comp
        (show FourSpace →L[ℝ] FourSpace from mfderiv I4 I4 (frameExponential g o e) v) at hcomp
  have hF : Function.Injective
      (fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v) := by
    have hL : (ContinuousLinearEquiv.ofUnit hunit.unit : FourSpace →L[ℝ] FourSpace) =
        fderiv ℝ (fun z => chartAt FourSpace c (frameExponential g o e z)) v := hunit.unit_spec
    rw [← hL]
    exact (ContinuousLinearEquiv.ofUnit hunit.unit).injective
  have hD : Function.Injective (mfderiv I4 I4 (frameExponential g o e) v) := by
    intro a b hab
    apply hF
    change (fderiv ℝ (fun z : FourSpace => chartAt FourSpace c (frameExponential g o e z)) v)
      (show FourSpace from a) =
      (fderiv ℝ (fun z : FourSpace => chartAt FourSpace c (frameExponential g o e z)) v)
        (show FourSpace from b)
    rw [hcomp]
    exact congrArg (mfderiv I4 I4 (chartAt FourSpace c) (frameExponential g o e v)) hab
  exact (heatNormalMetric_posDef g o e v hD).det_pos.ne'

theorem heatNormalMetric_eventually_nondegenerate (g : SmoothMetric M)
    (o : FrameOrientation g) (e : FrameBundle g) :
    ∀ᶠ v in 𝓝 (0 : FourSpace), (heatNormalMetric g o e v).det ≠ 0 := by
  let F := fun v : FourSpace => chartAt FourSpace e.base (frameExponential g o e v)
  have hF : ContDiffAt ℝ 1 F 0 := frameExponential_chart_contDiffAt_zero g o e.base e
    (mem_chart_source FourSpace e.base)
  have hu : IsUnit (fderiv ℝ F 0) := by
    have h := frameExponential_chart_strictDerivative_zero g o e.base e
      (mem_chart_source FourSpace e.base)
    rw [h.hasFDerivAt.fderiv]
    simpa only [chartForwardOperator_center, ContinuousLinearMap.id_comp] using frameMap_isUnit g e
  have hnear : ∀ᶠ v in 𝓝 (0 : FourSpace),
      fderiv ℝ F v ∈ range ((↑) : (FourSpace ≃L[ℝ] FourSpace) → FourSpace →L[ℝ] FourSpace) :=
    (hF.continuousAt_fderiv one_ne_zero).preimage_mem_nhds
      (ContinuousLinearEquiv.isOpen.mem_nhds
        ⟨ContinuousLinearEquiv.ofUnit hu.unit, hu.unit_spec⟩)
  have hc : ∀ᶠ v in 𝓝 (0 : FourSpace),
      frameExponential g o e v ∈ (chartAt FourSpace e.base).source := by
    apply (frameExponential_continuous g o e).continuousAt.preimage_mem_nhds
    rw [frameExponential_zero]
    exact (chartAt FourSpace e.base).open_source.mem_nhds (mem_chart_source FourSpace e.base)
  filter_upwards [hnear, hc] with v hv hvc
  obtain ⟨L, hL⟩ := hv
  apply heatNormalMetric_det_of_chart_unit g o e e.base v hvc
  exact hL ▸ L.toUnit.isUnit

theorem heatNormalMetric_eikonal_neighborhood (g : SmoothMetric M) (o : FrameOrientation g)
    (hRic : RicciThree g) (e : FrameBundle g) (he : e ∈ o.positive) :
    ∃ r > (0 : ℝ), ∀ v ∈ ball 0 r,
      fourHeatEikonalDefect (heatNormalMetric g o e v)⁻¹ v = 0 := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp (heatNormalMetric_eventually_nondegenerate g o e)
  exact ⟨r, hr, fun v hv => heatNormalMetric_eikonal g o hRic e he v (hball hv)⟩

end
end PositiveEinsteinFour.Geometry
end


section

/-! The compact positive resolvent of the actual scalar Laplacian on base L2.
It is constructed from the proved H1 inclusion and its Hilbert adjoint. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [MeasurableSpace M]
  [BorelSpace M] [Nonempty M]

local instance baseResolvent_frameCompact (g : SmoothMetric M) :
    CompactSpace (FrameBundle g) := actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o))

def scalarBaseShiftedSolution : Lp ℝ 2 (normalizedVolume g) →L[ℝ] scalarH1 d :=
  (scalarH1BaseValue g o d).adjoint

def scalarBaseResolvent : Lp ℝ 2 (normalizedVolume g) →L[ℝ] Lp ℝ 2 (normalizedVolume g) :=
  (scalarH1BaseValue g o d).comp (scalarBaseShiftedSolution g o d)

theorem scalarBaseShiftedSolution_weak (f : Lp ℝ 2 (normalizedVolume g)) (v : scalarH1 d) :
    inner ℝ (scalarBaseShiftedSolution g o d f) v = inner ℝ f (scalarH1BaseValue g o d v) :=
  (scalarH1BaseValue g o d).adjoint_inner_left v f

theorem scalarBaseResolvent_compact : IsCompactOperator (scalarBaseResolvent g o d) :=
  (scalarH1BaseValue_compact g o d).comp_clm (scalarBaseShiftedSolution g o d)

theorem scalarBaseResolvent_symmetric : (scalarBaseResolvent g o d).IsSymmetric := by
  intro f h
  change inner ℝ (scalarH1BaseValue g o d ((scalarH1BaseValue g o d).adjoint f)) h =
    inner ℝ f (scalarH1BaseValue g o d ((scalarH1BaseValue g o d).adjoint h))
  rw [← (scalarH1BaseValue g o d).adjoint_inner_right,
    (scalarH1BaseValue g o d).adjoint_inner_left]

theorem scalarBaseResolvent_energy (f : Lp ℝ 2 (normalizedVolume g)) :
    inner ℝ f (scalarBaseResolvent g o d f) = ‖scalarBaseShiftedSolution g o d f‖ ^ 2 := by
  rw [← real_inner_self_eq_norm_sq]
  exact (scalarBaseShiftedSolution_weak g o d f _).symm

variable [SecondCountableTopology M]

theorem scalarBaseShiftedSolution_injective : Function.Injective (scalarBaseShiftedSolution g o d) := by
  intro f h hfh
  have hp (v : scalarH1 d) : inner ℝ (f - h) (scalarH1BaseValue g o d v) = 0 := by
    rw [← scalarBaseShiftedSolution_weak, map_sub, hfh, sub_self, inner_zero_left]
  have hz : (fun x : Lp ℝ 2 (normalizedVolume g) => inner ℝ (f - h) x) = fun _ => 0 := by
    apply (continuous_const.inner continuous_id).ext_on (scalarH1BaseValue_dense g o d) continuous_const
    rintro _ ⟨v, rfl⟩
    exact hp v
  exact sub_eq_zero.mp (inner_self_eq_zero.mp (congrFun hz (f - h)))

theorem scalarBaseResolvent_injective : Function.Injective (scalarBaseResolvent g o d) := by
  intro f h he
  apply scalarBaseShiftedSolution_injective g o d
  apply scalarH1Value_injective d
  have hv := congrArg (scalarBasePullback g o) he
  simpa only [scalarBaseResolvent, ContinuousLinearMap.comp_apply, scalarH1BaseValue_spec] using hv

theorem scalarBaseResolvent_pos (f : Lp ℝ 2 (normalizedVolume g)) (hf : f ≠ 0) :
    0 < inner ℝ f (scalarBaseResolvent g o d f) := by
  rw [scalarBaseResolvent_energy, sq_pos_iff, norm_ne_zero_iff]
  intro hz
  exact hf (scalarBaseShiftedSolution_injective g o d (hz.trans (map_zero _).symm))

end
end PositiveEinsteinFour.Geometry
end


section

/-! A linear scalar eigenfunction source remains exactly a multiple of the
weighted chart unknown after localization and affine normalization. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory Set
open scoped Manifold ContDiff

noncomputable section

theorem scalarAffinePullbackL2_smul (A : FourSpace ≃L[ℝ] FourSpace) (q : FourSpace)
    (κ : ℝ) (w : Lp ℝ 2 (volume : Measure FourSpace)) :
    scalarAffinePullbackL2 A q (κ • w) = κ • scalarAffinePullbackL2 A q w := by
  have hq : Measure.QuasiMeasurePreserving (fun y : FourSpace => A y + q) volume volume := by
    refine ⟨by fun_prop, ?_⟩
    rw [scalarAffine_map_volume]
    exact Measure.smul_absolutelyContinuous
  apply Lp.ext
  filter_upwards [scalarAffinePullbackL2_coe A q (κ • w),
    scalarAffinePullbackL2_coe A q w, hq.ae_eq_comp (Lp.coeFn_smul κ w),
    Lp.coeFn_smul κ (scalarAffinePullbackL2 A q w)] with x h₁ h₂ h₃ h₄
  exact h₁.trans (h₃.trans ((congrArg (κ • ·) h₂).symm.trans h₄.symm))

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M] [T3Space M] [CompactSpace M] [Nonempty M]
  [MeasurableSpace M] [BorelSpace M]

local instance eigenSource_compact (g : SmoothMetric M) : CompactSpace (FrameBundle g) :=
  actual_compactFrameBundle g

variable (g : SmoothMetric M) (o : FrameOrientation g)
  (d : ParallelMetricData g (canonicalFrameMeasure g o)) (c : M)
  (χ : FourSpace → ℝ) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)
  (ht : tsupport χ ⊆ (chartAt FourSpace c).target)

theorem scalarChartSourceL2_baseValue (u : scalarH1 d) :
    scalarChartSourceL2 g c (scalarH1BaseValue g o d u) χ hχ hc ht =
      scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _) := by
  apply Lp.ext
  exact (scalarChartSourceL2_coe g c (scalarH1BaseValue g o d u) χ hχ hc ht).trans
    (scalarWeightedChartL2_coe g o d c hc ht u χ hχ hc (Subset.refl _)).symm

theorem scalarWeightedChartL2_smul (κ : ℝ) (u : scalarH1 d) :
    scalarWeightedChartL2 g o d c hc ht (κ • u) χ hχ hc (Subset.refl _) =
      κ • scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _) := by
  let P := scalarLocalL2ProductCLM hc.measurableSet
    (fun z => χ z * chartVolumeDensity g c z)
    (scalarDensityCutoff_smooth g c χ hχ ht).continuous hc.mul_right
    (tsupport_mul_subset_left.trans (Subset.refl _))
  change P (scalarH1ChartValue g o d c hc ht (κ • u)) =
    κ • P (scalarH1ChartValue g o d c hc ht u)
  rw [map_smul, map_smul]

theorem scalarRescaledEigenSource (κ : ℝ) (u : scalarH1 d)
    (z₀ : ChartTarget c) (r : ℝ) (hr : r ≠ 0) :
    scalarRescaledSourceL2 g c (scalarH1BaseValue g o d (κ • u)) χ hχ hc ht z₀ r hr =
      (r ^ 2 * κ) • scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr) z₀
        (scalarWeightedChartL2 g o d c hc ht u χ hχ hc (Subset.refl _)) := by
  rw [scalarRescaledSourceL2, scalarChartSourceL2_baseValue,
    scalarWeightedChartL2_smul]
  exact (congrArg (r ^ 2 • ·) (scalarAffinePullbackL2_smul _ _ κ _)).trans
    (smul_smul (r ^ 2) κ _)

end
end PositiveEinsteinFour.Geometry
end


section

/-! The existing scalar elliptic estimate applied directly to a genuine
H1 chart component with actual Euclidean H1 forcing. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

local notation "V4" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V4)
local notation "S" => 𝓢(V4, ℂ)
local notation "T" => 𝓢'(V4, ℂ)

theorem scalarEuclidean_local_H3 (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c)
    (V : Set V4) (hV : V ∈ 𝓝 z₀.val) (w F : L2)
    (hw : MemSobolev 1 2 (scalarComplexL2 w : T))
    (hF : MemSobolev 1 2 (scalarComplexL2 F : T))
    (heq : ∀ (ψ : V4 → ℝ), ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ V →
      (∫ z, w z * scalarChartOperator g c ψ z) = ∫ z, F z * ψ z) :
    ∃ (r : ℝ) (hr : 0 < r),
      (∀ y ∈ closedBall (0 : V4) 1, scalarRescaledPoint g c z₀ r y ∈ V) ∧
      ∀ φ : S, HasCompactSupport (φ : V4 → ℂ) → tsupport (φ : V4 → ℂ) ⊆ closedBall 0 (1 / 2) →
        MemSobolev 3 2 (smulLeftCLM ℂ φ (scalarComplexL2
          (scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr.ne') z₀ w) : T)) := by
  obtain ⟨η₁, hη₁, hnear⟩ := Metric.mem_nhds_iff.mp
    (scalarRescaledPoint_compact_eventually g c z₀ (isCompact_closedBall 0 1) V hV)
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  have hpoint (y : V4) (hy : y ∈ closedBall (0 : V4) 1) :
      scalarRescaledPoint g c z₀ r y ∈ V :=
    hnear (by simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr₁) y hy
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w' := scalarAffinePullbackL2 A z₀ w
  let F' : L2 := r ^ 2 • scalarAffinePullbackL2 A z₀ F
  have hw' : MemSobolev 1 2 (scalarComplexL2 w' : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w hw
  have hA (y : V4) (hy : y ∈ ball (0 : V4) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V4) (hy : y ∈ ball (0 : V4) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hreal (ψ : V4 → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ)
      (hsψ : tsupport ψ ⊆ ball (0 : V4) 1) :
      (∫ y, w' y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F' y * ψ y :=
    scalarEuclidean_rescaled_equation g c w F V heq z₀ r hr.ne' ψ hψ hcψ
      (fun y hy => hpoint y (ball_subset_closedBall (hsψ hy)))
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹
  let Ft := scalarComplexL2 (κ • F')
  have hF' : MemSobolev 1 2 (scalarComplexL2 F' : T) := by
    rw [show (scalarComplexL2 F' : T) = ((r ^ 2 : ℝ) : ℂ) •
      (scalarComplexL2 (scalarAffinePullbackL2 A z₀ F) : T) from
        scalarComplexL2_real_smul_distribution (r ^ 2) _]
    exact (scalarAffinePullbackL2_memSobolev_one A z₀ F hF).smul _
  have hFt : MemSobolev 1 2 (Ft : T) := by
    rw [show (Ft : T) = (κ : ℂ) • (scalarComplexL2 F' : T) from
      scalarComplexL2_real_smul_distribution κ F']
    exact hF'.smul _
  have hpair (φ : S) : (Ft : T) φ = ∫ y, φ y * ((κ * F' y : ℝ) : ℂ) := by
    rw [Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [scalarComplexL2_coe (κ • F'), Lp.coeFn_smul κ F'] with y hc hs
    rw [hc, hs]
    rfl
  have htests (φ : S) (hcφ : HasCompactSupport (φ : V4 → ℂ))
      (hsφ : tsupport (φ : V4 → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w' : T) -
          (scalarComplexL2 w' : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w' : T)) φ = (Ft : T) φ := by
    rw [scalarFormalAdjointOperator_remainder]
    exact (scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F' w' a b
      (ball 0 1) hA hB hreal φ hcφ hsφ (scalar_real_L2_test_integrable F' φ _)).trans
        (hpair φ).symm
  refine ⟨r, hr, hpoint, ?_⟩
  intro φ hcφ hsφ
  exact scalar_ball_H1_forcing_gain a (scalarAdjointDrift a b)
    scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
    scalarEllipticSmallSize_small (-scalarAdjointPotential a b)
    (scalarComplexL2 w' : T) (Ft : T) hFt hw' htests
    (1 / 2) (by norm_num) (by norm_num) φ hcφ hsφ

end
end PositiveEinsteinFour.Geometry
end


section

/-! The existing scalar elliptic estimate applied directly to a genuine
H1 chart component with actual Euclidean integer-order forcing. -/

namespace PositiveEinsteinFour.Geometry

open EinsteinFour MeasureTheory TemperedDistribution Set Metric
open scoped Manifold ContDiff SchwartzMap _root_.Topology

noncomputable section

variable {M : Type*} [TopologicalSpace M] [ChartedSpace FourSpace M]
  [IsManifold I4 ∞ M]

local notation "V4" => FourSpace
local notation "L2" => Lp ℝ 2 (volume : Measure V4)
local notation "S" => 𝓢(V4, ℂ)
local notation "T" => 𝓢'(V4, ℂ)

theorem scalarEuclidean_local_integer (n : ℕ) (g : SmoothMetric M) (c : M) (z₀ : ChartTarget c)
    (V : Set V4) (hV : V ∈ 𝓝 z₀.val) (w F : L2)
    (hw : MemSobolev 1 2 (scalarComplexL2 w : T))
    (hF : MemSobolev (n : ℝ) 2 (scalarComplexL2 F : T))
    (heq : ∀ (ψ : V4 → ℝ), ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ V →
      (∫ z, w z * scalarChartOperator g c ψ z) = ∫ z, F z * ψ z) :
    ∃ (r : ℝ) (hr : 0 < r),
      (∀ y ∈ closedBall (0 : V4) 1, scalarRescaledPoint g c z₀ r y ∈ V) ∧
      ∀ φ : S, HasCompactSupport (φ : V4 → ℂ) → tsupport (φ : V4 → ℂ) ⊆ closedBall 0 (1 / 2) →
        MemSobolev ((n + 2 : ℕ) : ℝ) 2 (smulLeftCLM ℂ φ (scalarComplexL2
          (scalarAffinePullbackL2 (scalarRescalingLinearEquiv g c z₀ r hr.ne') z₀ w) : T)) := by
  obtain ⟨η₁, hη₁, hnear⟩ := Metric.mem_nhds_iff.mp
    (scalarRescaledPoint_compact_eventually g c z₀ (isCompact_closedBall 0 1) V hV)
  obtain ⟨η₂, hη₂, hcoeff⟩ := scalarRescaledAdjointSchwartz_small g c z₀
    scalarCoefficientBump scalarCoefficientBump.contDiff scalarCoefficientBump.hasCompactSupport
  let r := min η₁ η₂ / 2
  have hr : 0 < r := half_pos (lt_min hη₁ hη₂)
  have hr₁ : |r| < η₁ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_left _ _)
  have hr₂ : |r| < η₂ := by
    rw [abs_of_pos hr]
    exact (half_lt_self (lt_min hη₁ hη₂)).trans_le (min_le_right _ _)
  have hpoint (y : V4) (hy : y ∈ closedBall (0 : V4) 1) :
      scalarRescaledPoint g c z₀ r y ∈ V :=
    hnear (by simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs] using hr₁) y hy
  obtain ⟨a, b, ha, hb, ha₀, ha₁, ha₂, hb₀, hb₁⟩ := hcoeff r hr₂
  let A := scalarRescalingLinearEquiv g c z₀ r hr.ne'
  let w' := scalarAffinePullbackL2 A z₀ w
  let F' : L2 := r ^ 2 • scalarAffinePullbackL2 A z₀ F
  have hw' : MemSobolev 1 2 (scalarComplexL2 w' : T) :=
    scalarAffinePullbackL2_memSobolev_one A z₀ w hw
  have hA (y : V4) (hy : y ∈ ball (0 : V4) 1) (i j : Fin 4) : a i j y =
      ((-((2 * Real.pi) ^ 2)⁻¹ *
        (scalarRescaledPrincipal g c z₀ r y i j - (1 : Mat4) i j) : ℝ) : ℂ) := by
    have h := ha i j y
    simpa only [scalarCutoffPrincipal, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hB (y : V4) (hy : y ∈ ball (0 : V4) 1) (i : Fin 4) : b i y =
      ((-((2 * Real.pi) ^ 2)⁻¹ * scalarRescaledDrift g c z₀ r y i : ℝ) : ℂ) := by
    have h := hb i y
    simpa only [scalarCutoffDrift, scalarCoefficientBump_one (ball_subset_closedBall hy),
      one_mul, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg] using h
  have hreal (ψ : V4 → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ)
      (hsψ : tsupport ψ ⊆ ball (0 : V4) 1) :
      (∫ y, w' y * scalarRescaledOperator g c z₀ r ψ y) = ∫ y, F' y * ψ y :=
    scalarEuclidean_rescaled_equation g c w F V heq z₀ r hr.ne' ψ hψ hcψ
      (fun y hy => hpoint y (ball_subset_closedBall (hsψ hy)))
  let κ : ℝ := -((2 * Real.pi) ^ 2)⁻¹
  let Ft := scalarComplexL2 (κ • F')
  have hF' : MemSobolev (n : ℝ) 2 (scalarComplexL2 F' : T) := by
    rw [show (scalarComplexL2 F' : T) = ((r ^ 2 : ℝ) : ℂ) •
      (scalarComplexL2 (scalarAffinePullbackL2 A z₀ F) : T) from
        scalarComplexL2_real_smul_distribution (r ^ 2) _]
    exact (scalarAffinePullbackL2_memSobolev_integer n A z₀ F hF).smul _
  have hFt : MemSobolev (n : ℝ) 2 (Ft : T) := by
    rw [show (Ft : T) = (κ : ℂ) • (scalarComplexL2 F' : T) from
      scalarComplexL2_real_smul_distribution κ F']
    exact hF'.smul _
  have hpair (φ : S) : (Ft : T) φ = ∫ y, φ y * ((κ * F' y : ℝ) : ℂ) := by
    rw [Lp.toTemperedDistribution_apply]
    apply integral_congr_ae
    filter_upwards [scalarComplexL2_coe (κ • F'), Lp.coeFn_smul κ F'] with y hc hs
    rw [hc, hs]
    rfl
  have htests (φ : S) (hcφ : HasCompactSupport (φ : V4 → ℂ))
      (hsφ : tsupport (φ : V4 → ℂ) ⊆ ball 0 1) :
      (scalarPerturbedOperator a (scalarAdjointDrift a b) (scalarComplexL2 w' : T) -
          (scalarComplexL2 w' : T) - smulLeftCLM ℂ (-scalarAdjointPotential a b : S)
            (scalarComplexL2 w' : T)) φ = (Ft : T) φ := by
    rw [scalarFormalAdjointOperator_remainder]
    exact (scalar_normalized_adjoint_test_equation_of_integrable g c z₀ r F' w' a b
      (ball 0 1) hA hB hreal φ hcφ hsφ (scalar_real_L2_test_integrable F' φ _)).trans
        (hpair φ).symm
  refine ⟨r, hr, hpoint, ?_⟩
  intro φ hcφ hsφ
  exact scalar_ball_integer_forcing_gain a (scalarAdjointDrift a b)
    scalarEllipticSmallSize scalarEllipticSmallSize_pos.le ha₀ ha₁ ha₂ hb₀ hb₁
    scalarEllipticSmallSize_small n (-scalarAdjointPotential a b)
    (scalarComplexL2 w' : T) (Ft : T) hFt hw' htests
    (1 / 2) (by norm_num) (by norm_num) φ hcφ hsφ

end
end PositiveEinsteinFour.Geometry
end


