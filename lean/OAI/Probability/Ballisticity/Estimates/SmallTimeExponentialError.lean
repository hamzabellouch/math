lemma small_time_exponential_error {m t : ℝ} (hm1 : 1 ≤ m) (ht : 0<t)
    (htmax : t≤1/1000000) :
    8*(2:ℝ)^((3:ℝ)/2)*Real.exp (-m/(9*t)) < t/(128*m) := by
  have hm : 0 < m := zero_lt_one.trans_le hm1
  have hx : 0 < m/(9*t) := div_pos hm (by positivity)
  have he := Real.pow_div_factorial_le_exp (m/(9*t)) hx.le 2
  norm_num only [Nat.factorial_succ,Nat.factorial_zero,Nat.cast_mul,Nat.cast_one,Nat.cast_ofNat] at he
  have hi := inv_anti₀ (by positivity : (0:ℝ)<(m/(9*t))^2/2) he
  have he' : Real.exp (-m/(9*t))≤162*t^2/m^2 := by
    calc
      Real.exp (-m/(9*t)) = (Real.exp (m/(9*t)))⁻¹ := by rw [neg_div,Real.exp_neg]
      _ ≤ ((m/(9*t))^2/2)⁻¹ := hi
      _ = 162*t^2/m^2 := by field_simp; ring
  have hM : (2:ℝ)^((3:ℝ)/2)≤4 := by
    have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ)≤2)
      (by norm_num : (3:ℝ)/2≤2)
    norm_num only [Real.rpow_two] at h
    exact h
  have hb : 5184*t/m<1/128 := by
    apply (div_lt_iff₀ hm).mpr
    linarith
  calc
    8*(2:ℝ)^((3:ℝ)/2)*Real.exp (-m/(9*t)) ≤ 32*Real.exp (-m/(9*t)) := by
      exact mul_le_mul_of_nonneg_right (by linarith) (Real.exp_nonneg _)
    _ ≤ 32*(162*t^2/m^2) := mul_le_mul_of_nonneg_left he' (by norm_num)
    _ = 5184*t^2/m^2 := by ring
    _ = (t/m)*(5184*t/m) := by ring
    _ < (t/m)*(1/128) := mul_lt_mul_of_pos_left hb (div_pos ht hm)
    _ = t/(128*m) := by ring

theorem shared_observed_clipped_drift_small_time {d : ℕ} (ν : Measure (Row d))
    [IsProbabilityMeasure ν] (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1≠f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e)))
    (r : ℕ → ℝ) (hrpos : ∀ i, 0<r i)
    (hr : IsGaussianSequence (independentConditionedPairLaw ν (realPosition (step e)))
      (commonIncrementProcess (realPosition (step e)) f 0) r)
    (x y : ℕ → Lattice d) (hxy : ∀ i, signedHeight e (x i)=signedHeight e (y i))
    (hgap : ∀ i, |signedCoordinate f (x i-y i)|=r i)
    {t : ℝ} (ht : 0<t) (htmax : t≤1/1000000) :
    let ℓ := realPosition (step e)
    let n := fun i => fluctuationScale (independentConditionedPairLaw ν ℓ)
      (commonIncrementProcess ℓ f 0) (r i)
    let H := fun i => ⌊t*n i⌋₊
    ∀ᶠ i in atTop,
      1+t/(128*commonMeanWidth ν ℓ) ≤
        ∫ P, min (|physicalFirstHitGap ℓ f (x i) (y i)
          (H i+commonOffset ℓ (signedHeight e) (signedHeight e (x i)+H i) P) P/r i|^((3:ℝ)/2))
          ((2:ℝ)^((3:ℝ)/2)) ∂sharedConditionedPairLaw ν ℓ (x i) (y i) := by
  have hm := commonMeanWidth_ge_one ν (realPosition (step e)) htrans (signedHeight e)
    (signedHeight_projection e) (signedHeight_step_le e)
  exact shared_observed_clipped_drift_gaussian ν hue e f hef htrans r hrpos hr x y hxy hgap ht
    (by linarith) (small_time_exponential_error hm ht htmax)

end DirectionalTransience

