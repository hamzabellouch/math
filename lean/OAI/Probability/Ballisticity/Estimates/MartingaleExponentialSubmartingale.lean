lemma martingale_exponential_submartingale {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (F : Filtration ℕ ‹MeasurableSpace Ω›)
    (X : ℕ → Ω → ℝ) (hX : Martingale X F μ)
    (hi : ∀ n, Integrable (fun ω => Real.exp (X n ω)) μ) :
    Submartingale (fun n ω => Real.exp (X n ω)) F μ := by
  refine ⟨fun n => Real.continuous_exp.comp_stronglyMeasurable (hX.stronglyMeasurable n), ?_, hi⟩
  intro i j hij
  have h := ConvexOn.map_condExp_le_univ (F.le i) convexOn_exp
    Real.continuous_exp.lowerSemicontinuous (hX.integrable j) (hi j)
  filter_upwards [h,hX.condExp_ae_eq hij] with ω hω he
  simpa only [Function.comp_def,he] using hω

lemma martingale_exponential_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (F : Filtration ℕ ‹MeasurableSpace Ω›)
    (X : ℕ → Ω → ℝ) (hX : Martingale X F μ)
    (hi : ∀ n, Integrable (fun ω => Real.exp (X n ω)) μ) (n : ℕ) (a : ℝ) :
    μ.real {ω | ∃ k≤n, a≤X k ω} ≤
      Real.exp (-a)*(∫ ω, Real.exp (X n ω) ∂μ) := by
  let Y := fun n ω => Real.exp (X n ω)
  have hY : Submartingale Y F μ := martingale_exponential_submartingale μ F X hX hi
  let ε : ℝ≥0 := ⟨Real.exp a,(Real.exp_pos a).le⟩
  have h := maximal_ineq hY (fun _ _ => (Real.exp_pos _).le) (ε:=ε) n
  have hset : {ω | (ε:ℝ) ≤ (Finset.range (n+1)).sup' Finset.nonempty_range_add_one (fun k => Y k ω)} =
      {ω | ∃ k≤n, a≤X k ω} := by
    ext ω
    simp only [Set.mem_ofPred_eq,Finset.le_sup'_iff,Finset.mem_range,Nat.lt_succ_iff]
    exact exists_congr fun k => and_congr_right fun _ => Real.exp_le_exp
  rw [hset] at h
  have hr := ENNReal.toReal_mono ENNReal.ofReal_ne_top h
  simp only [ENNReal.toReal_mul,ENNReal.coe_toReal] at hr
  rw [ENNReal.toReal_ofReal (show 0 ≤ ∫ ω in {ω | ∃ k≤n, a≤X k ω}, Y n ω ∂μ from
    integral_nonneg (fun ω => (Real.exp_pos (X n ω)).le))] at hr
  change Real.exp a * μ.real {ω | ∃ k≤n, a≤X k ω} ≤
    ∫ ω in {ω | ∃ k≤n, a≤X k ω}, Real.exp (X n ω) ∂μ at hr
  have hb := hr.trans (setIntegral_le_integral (hi n) (Eventually.of_forall fun _ => (Real.exp_pos _).le))
  have hb' : μ.real {ω | ∃ k≤n, a≤X k ω} ≤ (∫ ω,Real.exp (X n ω) ∂μ)/Real.exp a :=
    (le_div_iff₀ (Real.exp_pos a)).2 (by simpa only [mul_comm] using hb)
  simpa only [div_eq_mul_inv,← Real.exp_neg,mul_comm] using hb'

end DirectionalTransience

