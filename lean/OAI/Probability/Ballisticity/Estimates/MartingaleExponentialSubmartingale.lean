lemma independent_centered_sum_martingale {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (X : ℕ → Ω → ℝ)
    (hXm : ∀ n, Measurable (X n)) (hi : ∀ n, Integrable (X n) μ)
    (hind : iIndepFun X μ) (hmean : ∀ n, ∫ ω, X n ω ∂μ = 0) :
    Martingale (fun n ω => ∑ j ∈ Finset.range (n+1), X j ω)
      (Filtration.natural X (fun n => (hXm n).stronglyMeasurable)) μ := by
  let F := Filtration.natural X (fun n => (hXm n).stronglyMeasurable)
  have hA : StronglyAdapted F X := Filtration.stronglyAdapted_natural _
  have hsum (n : ℕ) : StronglyMeasurable[F n] (fun ω => ∑ j ∈ Finset.range (n+1), X j ω) := by
    have he : (fun ω => ∑ j ∈ Finset.range (n+1), X j ω) =
        ∑ j ∈ Finset.range (n+1), X j := by funext ω; simp
    rw [he]
    exact Finset.stronglyMeasurable_sum (Finset.range (n+1))
      (fun j hj => (hA j).mono (F.mono (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj))))
  have hsi (n : ℕ) : Integrable (fun ω => ∑ j ∈ Finset.range (n+1), X j ω) μ :=
    integrable_finsetSum _ (fun j _ => hi j)
  apply martingale_nat hsum hsi
  intro n
  have he : (fun ω => ∑ j ∈ Finset.range (n+1+1), X j ω) =
      (fun ω => ∑ j ∈ Finset.range (n+1), X j ω) + X (n+1) := by
    funext ω
    simp only [Finset.sum_range_succ,Pi.add_apply]
  rw [he]
  have hh := condExp_add (hsi n) (hi (n+1)) (F n)
  have hx := hind.condExp_natural_ae_eq_of_lt (fun n => (hXm n).stronglyMeasurable)
    (Nat.lt_succ_self n)
  have hs := condExp_of_stronglyMeasurable (F.le n) (hsum n) (hsi n)
  filter_upwards [hh,hx] with ω hω hxω
  rw [hω,hs]
  simpa only [Pi.add_apply,hmean,add_zero] using (congrArg
    (fun z => (∑ j ∈ Finset.range (n+1), X j ω)+z) hxω).symm

end DirectionalTransience

