namespace DirectionalTransience

lemma shared_wordCylinder_lower {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (κ : ℝ≥0) (hκ : ∀ᵐ ω ∂environmentLaw ν, ∀ x e, κ ≤ (ω x).1 e)
    (x y : Lattice d) (w v : List (Direction d)) :
    (κ:ℝ≥0∞)^(w.length+v.length) ≤ sharedPairLaw ν x y (wordCylinder x w ×ˢ wordCylinder y v) := by
  rw [sharedPairLaw_rectangle ν x y _ _ (measurableSet_wordCylinder _ _) (measurableSet_wordCylinder _ _)]
  simp_rw [quenched_wordCylinder]
  have hconst : (κ:ℝ≥0∞)^(w.length+v.length) =
      ∫⁻ _ : Environment d, (κ:ℝ≥0∞)^(w.length+v.length) ∂environmentLaw ν := by simp
  rw [hconst]
  apply lintegral_mono_ae
  filter_upwards [hκ] with ω hω
  have hw := ENNReal.ofReal_le_ofReal (wordWeight_lower ω hω x w)
  have hv := ENNReal.ofReal_le_ofReal (wordWeight_lower ω hω y v)
  simp only [ENNReal.ofReal_pow κ.coe_nonneg,ENNReal.ofReal_coe_nnreal] at hw hv
  rw [pow_add]
  exact mul_le_mul' hw hv

lemma signedHeight_add_step_other {d : ℕ} (e f : Direction d) (hef : e.1 ≠ f.1) (x : Lattice d) :
    signedHeight e (x+step f)=signedHeight e x := by
  simp [signedHeight,Pi.add_apply,step,hef]

lemma transverse_two_step_hit {d : ℕ} (e f : Direction d) (hef : e.1 ≠ f.1)
    (x : Lattice d) (X : Path d) (hX : X ∈ wordCylinder x [f,e]) :
    X ∈ FirstLayerHit (signedHeight e) (signedHeight e x+1) 2 ∧
    X ∈ StayUntil {z | dot (realPosition x) (realPosition (step e)) ≤
      dot (realPosition z) (realPosition (step e))} 2 ∧ X 2=x+step f+step e := by
  have h0 : X 0=x := by simpa only [wordPath_zero] using hX 0 (by simp)
  have h1 : X 1=x+step f := by simpa only [wordPath] using hX 1 (by simp)
  have h2 : X 2=x+step f+step e := by simpa only [wordPath] using hX 2 (by simp)
  have hheight1 : signedHeight e (X 1)=signedHeight e x := by rw [h1,signedHeight_add_step_other e f hef]
  have hheight2 : signedHeight e (X 2)=signedHeight e x+1 := by
    rw [h2,signedHeight_add_step_self,signedHeight_add_step_other e f hef]
  refine ⟨⟨hheight2,?_⟩,?_,h2⟩
  · intro j hj
    have hj' : j=0 ∨ j=1 := by omega
    rcases hj' with rfl | rfl <;> simp only [h0,hheight1] <;> omega
  · intro j hj
    change dot (realPosition x) (realPosition (step e)) ≤ dot (realPosition (X j)) (realPosition (step e))
    rw [signedHeight_projection,signedHeight_projection]
    have hj' : j=0 ∨ j=1 ∨ j=2 := by omega
    rcases hj' with rfl | rfl | rfl
    all_goals simp only [h0,hheight1,hheight2]
    all_goals norm_cast
    all_goals omega

lemma direction_one_step_hit {d : ℕ} (e : Direction d) (x : Lattice d) (X : Path d)
    (hX : X ∈ wordCylinder x [e]) :
    X ∈ FirstLayerHit (signedHeight e) (signedHeight e x+1) 1 ∧
    X ∈ StayUntil {z | dot (realPosition x) (realPosition (step e)) ≤
      dot (realPosition z) (realPosition (step e))} 1 ∧ X 1=x+step e := by
  have h0 : X 0=x := by simpa only [wordPath_zero] using hX 0 (by simp)
  have h1 : X 1=x+step e := by simpa only [wordPath] using hX 1 (by simp)
  have hheight1 : signedHeight e (X 1)=signedHeight e x+1 := by rw [h1,signedHeight_add_step_self]
  refine ⟨⟨hheight1,?_⟩,?_,h1⟩
  · intro j hj
    have hj' : j=0 := by omega
    subst j; rw [h0]; omega
  · intro j hj
    change dot (realPosition x) (realPosition (step e)) ≤ dot (realPosition (X j)) (realPosition (step e))
    rw [signedHeight_projection,signedHeight_projection]
    have hj' : j=0 ∨ j=1 := by omega
    rcases hj' with rfl | rfl
    all_goals simp only [h0,hheight1]
    all_goals norm_cast
    all_goals omega

lemma elliptic_raw_gap_growth {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1 ≠ f.1) :
    ∃ q : ℝ≥0∞, 0 < q ∧ ∀ x y : Lattice d, signedHeight e x=signedHeight e y →
      q ≤ sharedPairLaw ν x y (layerPairEvent (realPosition (step e)) (signedHeight e) x y
        (signedHeight e x+1) {uv | |signedCoordinate f x-signedCoordinate f y|+1/2 <
          |signedCoordinate f uv.1-signedCoordinate f uv.2|}) := by
  obtain ⟨κ,hκ,hrows⟩ := environment_uniform_elliptic ν hue
  refine ⟨(κ:ℝ≥0∞)^3,ENNReal.pow_pos (by exact_mod_cast hκ) _,?_⟩
  intro x y hxy
  by_cases horder : signedCoordinate f y ≤ signedCoordinate f x
  · have hh := shared_wordCylinder_lower ν κ hrows x y [f,e] [e]
    simp only [List.length_cons,List.length_nil] at hh
    apply hh.trans (measure_mono _)
    intro P hP
    have h1 := transverse_two_step_hit e f hef x P.1 hP.1
    have h2 := direction_one_step_hit e y P.2 hP.2
    refine Set.mem_iUnion.mpr ⟨(1,0),⟨⟨⟨h1.1,by simpa only [hxy] using h2.1⟩,?_⟩,h1.2.1,h2.2.1⟩⟩
    change |signedCoordinate f x-signedCoordinate f y|+1/2 < |signedCoordinate f (P.1 2)-signedCoordinate f (P.2 1)|
    rw [h1.2.2,h2.2.2]
    simp only [signedCoordinate_add,signedCoordinate_step_self,signedCoordinate_step_other f e (Ne.symm hef),add_zero]
    rw [abs_of_nonneg (sub_nonneg.mpr horder),abs_of_nonneg (by linarith)]
    linarith
  · have hyx : signedCoordinate f x ≤ signedCoordinate f y := le_of_not_ge horder
    have hh := shared_wordCylinder_lower ν κ hrows x y [e] [f,e]
    simp only [List.length_cons,List.length_nil] at hh
    apply hh.trans (measure_mono _)
    intro P hP
    have h1 := direction_one_step_hit e x P.1 hP.1
    have h2 := transverse_two_step_hit e f hef y P.2 hP.2
    refine Set.mem_iUnion.mpr ⟨(0,1),⟨⟨⟨h1.1,by simpa only [hxy] using h2.1⟩,?_⟩,h1.2.1,h2.2.1⟩⟩
    change |signedCoordinate f x-signedCoordinate f y|+1/2 < |signedCoordinate f (P.1 1)-signedCoordinate f (P.2 2)|
    rw [h1.2.2,h2.2.2]
    simp only [signedCoordinate_add,signedCoordinate_step_self,signedCoordinate_step_other f e (Ne.symm hef),add_zero]
    rw [abs_of_nonpos (sub_nonpos.mpr hyx),abs_of_nonpos (by linarith)]
    linarith

end DirectionalTransience

