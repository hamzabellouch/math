theorem independent_firstHit_endpoint_limit {d : ℕ} (ν : Measure (Row d))
    [IsProbabilityMeasure ν] (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1 ≠ f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e)))
    (r : ℕ → ℝ) (hrpos : ∀ i, 0 < r i)
    (hr : IsGaussianSequence (independentConditionedPairLaw ν (realPosition (step e)))
      (commonIncrementProcess (realPosition (step e)) f 0) r)
    {t : ℝ} (ht : 0 < t) :
    let ℓ := realPosition (step e)
    let μ := independentConditionedPairLaw ν ℓ
    let n := fun i => fluctuationScale μ (commonIncrementProcess ℓ f 0) (r i)
    letI : IsProbabilityMeasure μ := independentConditionedPairLaw_probability ν ℓ
      (ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans))
    TendstoInDistribution (fun i P => firstHitPairGap ℓ f ⌊t*n i⌋₊ P/r i)
      atTop id (fun _ => μ) (gaussianReal 0 (Real.toNNReal (t/commonMeanWidth ν ℓ))) := by
  let ℓ := realPosition (step e)
  let μ := independentConditionedPairLaw ν ℓ
  let n := fun i => fluctuationScale μ (commonIncrementProcess ℓ f 0) (r i)
  let : IsProbabilityMeasure μ := independentConditionedPairLaw_probability ν ℓ
    (ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans))
  let : IsProbabilityMeasure (conditionedLaw ν ℓ) := conditionedLaw_probability ν ℓ
    (ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans))
  obtain ⟨W,hW,hWf⟩ := transverse_firstHit_path_limit ν hue e f hef htrans r hr ht.le
  have h0 : ∀ᵐ P ∂μ, firstHitPairGap ℓ f 0 P = 0 := by
    have hx := (conditionedLaw_absolutelyContinuous ν ℓ).ae_le (annealed_initial ν)
    filter_upwards [Measure.quasiMeasurePreserving_fst.ae hx,
      Measure.quasiMeasurePreserving_snd.ae hx] with P hP1 hP2
    simp [firstHitPairGap,recordIndexPosition,recordIndexTime_zero,hP1,hP2]
  have he (i : ℕ) : (fun P => scaledPolygon (heightIncrement
      (fun h => firstHitPairGap ℓ f h P)) (r i) (n i) t) =ᵐ[μ]
      (fun P => heightPolygon (fun h => firstHitPairGap ℓ f h P) (r i) (n i) t) := by
    filter_upwards [h0] with P hP
    simp [heightPolygon,hP]
  have hW' := TendstoInDistribution.congr he (ae_eq_refl id) hW
  have hnpos : ∀ i, 0 < n i := fun i => recordFluctuationScale_pos ν hue e f hef htrans (hrpos i)
  have hn := recordFluctuationScale_tendsto ν hue e f hef htrans r hr.1
  have hf : ∀ I : Finset unitInterval, (W : Measure C(unitInterval,ℝ)).map
      (fun g : C(unitInterval,ℝ) => I.restrict g) =
        gaussianPathFiniteLaw (t*(1/commonMeanWidth ν ℓ)) I := by
    intro I
    simpa only [div_eq_mul_inv,one_mul] using hWf I
  have hh := height_path_gaussian_eval μ (firstHitPairGap ℓ f)
    (measurable_firstHitPairGap ℓ f) r n hnpos t ht (1/commonMeanWidth ν ℓ) W hW' hf
    (fun i => ⌊t*n i⌋₊) (fun i => Nat.floor_le (mul_pos ht (hnpos i)).le)
    ((tendsto_nat_floor_mul_div_atTop ht.le).comp hn)
  simpa only [div_eq_mul_inv,one_mul,mul_comm (commonMeanWidth ν ℓ)⁻¹] using hh

noncomputable def clippedThreeHalves : ℝ →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfBound
    ⟨fun x => min (|1+x|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2)),clipped_three_halves_continuous⟩
    (2*((2:ℝ)^((3:ℝ)/2))) (by
      intro x y
      have hn (x : ℝ) : 0 ≤ min (|1+x|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2)) :=
        le_min (Real.rpow_nonneg (abs_nonneg _) _) (Real.rpow_nonneg (by norm_num) _)
      change |min (|1+x|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2))-
        min (|1+y|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2))| ≤ _
      have hx := min_le_right (|1+x|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2))
      have hy := min_le_right (|1+y|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2))
      exact abs_le.mpr ⟨by linarith [hn x,hn y],by linarith [hn x,hn y]⟩)

lemma weak_clipped_three_halves_integral {Ω : Type*} [MeasurableSpace Ω]
    (μ : ℕ → Measure Ω) [∀ i, IsProbabilityMeasure (μ i)] (X : ℕ → Ω → ℝ)
    (v : ℝ≥0) (hX : TendstoInDistribution X atTop id μ (gaussianReal 0 v)) :
    Tendsto (fun i => ∫ ω, clippedThreeHalves (X i ω) ∂μ i) atTop
      (𝓝 (∫ x, clippedThreeHalves x ∂gaussianReal 0 v)) := by
  have h := ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hX.tendsto clippedThreeHalves
  have he (i : ℕ) : (∫ x, clippedThreeHalves x ∂(μ i).map (X i)) =
      ∫ ω, clippedThreeHalves (X i ω) ∂μ i :=
    integral_map (hX.forall_aemeasurable i) clippedThreeHalves.continuous.aestronglyMeasurable
  simpa only [ProbabilityMeasure.coe_mk,he,Measure.map_id] using h

theorem independent_firstHit_clipped_drift {d : ℕ} (ν : Measure (Row d))
    [IsProbabilityMeasure ν] (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1 ≠ f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e)))
    (r : ℕ → ℝ) (hrpos : ∀ i, 0 < r i)
    (hr : IsGaussianSequence (independentConditionedPairLaw ν (realPosition (step e)))
      (commonIncrementProcess (realPosition (step e)) f 0) r)
    {t : ℝ} (ht : 0 < t) (htmax : t ≤ 1/1536) :
    let ℓ := realPosition (step e)
    let μ := independentConditionedPairLaw ν ℓ
    let n := fun i => fluctuationScale μ (commonIncrementProcess ℓ f 0) (r i)
    ∀ᶠ i in atTop, 1+t/(32*commonMeanWidth ν ℓ) ≤
      ∫ P, min (|1+firstHitPairGap ℓ f ⌊t*n i⌋₊ P/r i|^((3:ℝ)/2))
        ((2:ℝ)^((3:ℝ)/2)) ∂μ := by
  let ℓ := realPosition (step e)
  let μ := independentConditionedPairLaw ν ℓ
  let n := fun i => fluctuationScale μ (commonIncrementProcess ℓ f 0) (r i)
  let m := commonMeanWidth ν ℓ
  let : IsProbabilityMeasure μ := independentConditionedPairLaw_probability ν ℓ
    (ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans))
  have hm1 : 1 ≤ m := commonMeanWidth_ge_one ν ℓ htrans (signedHeight e)
    (signedHeight_projection e) (signedHeight_step_le e)
  have hm : 0 < m := zero_lt_one.trans_le hm1
  have hv : 0 < t/m := div_pos ht hm
  have he : ((Real.toNNReal (t/m)):ℝ) = t/m := Real.coe_toNNReal (t/m) hv.le
  have hb : ((Real.toNNReal (t/m)):ℝ) ≤ 1/1536 := by
    rw [he]
    exact (div_le_self ht.le hm1).trans htmax
  have hx := independent_firstHit_endpoint_limit ν hue e f hef htrans r hrpos hr ht
  have hlim := weak_clipped_three_halves_integral (fun _ => μ)
    (fun i P => firstHitPairGap ℓ f ⌊t*n i⌋₊ P/r i) (Real.toNNReal (t/m)) hx
  have hd := gaussian_clipped_drift (Real.toNNReal (t/m)) hb
  rw [he] at hd
  have hlt : 1+t/(32*m) < ∫ x, clippedThreeHalves x ∂gaussianReal 0 (Real.toNNReal (t/m)) := by
    change _ < ∫ x, min (|1+x|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2)) ∂gaussianReal 0 (Real.toNNReal (t/m))
    have heq : t/(32*m) = (t/m)/32 := by ring
    rw [heq]
    linarith
  exact (hlim.eventually (eventually_gt_nhds hlt)).mono (fun _ h => h.le)

end DirectionalTransience

