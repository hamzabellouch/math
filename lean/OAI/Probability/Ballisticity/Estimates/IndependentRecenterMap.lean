lemma independent_recenter_map {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (ℓ : Vector d) (htrans : DirectionallyTransient ν ℓ) (x y : Lattice d) :
    ((conditionedFrom ν ℓ x).prod (conditionedFrom ν ℓ y)).map
      (fun P : Path d × Path d => ((fun n => P.1 n-x),(fun n => P.2 n-y))) =
      independentConditionedPairLaw ν ℓ := by
  have hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
  let : IsProbabilityMeasure (conditionedFrom ν ℓ x) := conditionedFrom_probability ν ℓ x hp
  let : IsProbabilityMeasure (conditionedFrom ν ℓ y) := conditionedFrom_probability ν ℓ y hp
  have hm (z : Lattice d) : Measurable (fun X : Path d => fun n => X n-z) := by fun_prop
  have he (z : Lattice d) : (conditionedFrom ν ℓ z).map (fun X : Path d => fun n => X n-z)=conditionedLaw ν ℓ := by
    ext A hA
    rw [Measure.map_apply (hm z) hA]
    exact conditionedFrom_recenter ν ℓ z A hA
  rw [show (fun P : Path d × Path d => ((fun n => P.1 n-x),(fun n => P.2 n-y))) =
      Prod.map (fun X : Path d => fun n => X n-x) (fun X : Path d => fun n => X n-y) from rfl,
    ← Measure.map_prod_map _ _ (hm x) (hm y),he x,he y]
  rfl

lemma independent_physicalGap_integral {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (ℓ : Vector d) (htrans : DirectionallyTransient ν ℓ) (f : Direction d)
    (x y : Lattice d) (H : ℕ) (r : ℝ) :
    (∫ P, clippedAbsThreeHalves (physicalFirstHitGap ℓ f x y H P/r)
      ∂(conditionedFrom ν ℓ x).prod (conditionedFrom ν ℓ y)) =
    ∫ P, clippedAbsThreeHalves ((signedCoordinate f (x-y)+firstHitPairGap ℓ f H P)/r)
      ∂independentConditionedPairLaw ν ℓ := by
  rw [← independent_recenter_map ν ℓ htrans x y]
  rw [integral_map (by fun_prop : Measurable (fun P : Path d × Path d =>
    ((fun n => P.1 n-x),(fun n => P.2 n-y)))).aemeasurable]
  rfl
  exact (clippedAbsThreeHalves.continuous.measurable.comp
    ((measurable_const.add (measurable_firstHitPairGap ℓ f H)).div_const r)).aestronglyMeasurable

lemma clippedAbsThreeHalves_neg (z : ℝ) : clippedAbsThreeHalves (-z)=clippedAbsThreeHalves z := by
  simp only [clippedAbsThreeHalves_apply,abs_neg]

lemma independent_physicalGap_clipped {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (ℓ : Vector d) (htrans : DirectionallyTransient ν ℓ) (f : Direction d)
    (x y : Lattice d) (H : ℕ) {r : ℝ} (hr : 0<r)
    (hgap : |signedCoordinate f (x-y)|=r) :
    (∫ P, clippedAbsThreeHalves (physicalFirstHitGap ℓ f x y H P/r)
      ∂(conditionedFrom ν ℓ x).prod (conditionedFrom ν ℓ y)) =
    ∫ P, clippedThreeHalves (firstHitPairGap ℓ f H P/r) ∂independentConditionedPairLaw ν ℓ := by
  rw [independent_physicalGap_integral ν ℓ htrans f x y H r]
  have htest (z : ℝ) : clippedAbsThreeHalves ((r+z)/r)=clippedThreeHalves (z/r) := by
    change min (|1+((r+z)/r-1)|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2)) =
      min (|1+z/r|^((3:ℝ)/2)) ((2:ℝ)^((3:ℝ)/2))
    rw [add_div,div_self hr.ne']
    congr 3
    ring
  rcases abs_cases (signedCoordinate f (x-y)) with hsign | hsign
  · have he : signedCoordinate f (x-y)=r := hsign.1.symm.trans hgap
    simp only [he,htest]
  · have he : signedCoordinate f (x-y)=-r := by linarith [hsign.1]
    have hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
    let : IsProbabilityMeasure (conditionedLaw ν ℓ) := conditionedLaw_probability ν ℓ hp
    have hswap := integral_prod_swap
      (f := fun P : Path d × Path d => clippedAbsThreeHalves
        ((-r+firstHitPairGap ℓ f H P)/r))
      (μ := conditionedLaw ν ℓ) (ν := conditionedLaw ν ℓ)
    rw [he]
    change (∫ P, clippedAbsThreeHalves ((-r+firstHitPairGap ℓ f H P)/r)
      ∂(conditionedLaw ν ℓ).prod (conditionedLaw ν ℓ)) = _
    rw [← hswap]
    apply integral_congr_ae
    exact Eventually.of_forall fun P => by
      have hg : firstHitPairGap ℓ f H P.swap= -firstHitPairGap ℓ f H P := by
        unfold firstHitPairGap
        dsimp only [Prod.swap]
        ring
      dsimp only
      rw [hg,show (-r+-firstHitPairGap ℓ f H P)/r =
        -((r+firstHitPairGap ℓ f H P)/r) by ring,clippedAbsThreeHalves_neg,htest]

end DirectionalTransience

