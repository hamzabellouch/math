lemma prefixVariation_le_one {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (hue : UniformElliptic ν) (ℓ : Vector d) (hℓ : dot ℓ ℓ=1)
    (htrans : DirectionallyTransient ν ℓ) (x y : Lattice d) (H : ℝ) :
    prefixVariation ν ℓ x y H≤1 := by
  have hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
  let μ := sharedConditionedPairLaw ν ℓ x y
  let η := (conditionedFrom ν ℓ x).prod (conditionedFrom ν ℓ y)
  let : IsProbabilityMeasure μ := sharedConditionedPairLaw_probability ν ℓ x y
    (ne_of_gt (sharedNoDropMass_positive ν hue ℓ hℓ htrans x y))
  let : IsProbabilityMeasure (conditionedFrom ν ℓ x) := conditionedFrom_probability ν ℓ x hp
  let : IsProbabilityMeasure (conditionedFrom ν ℓ y) := conditionedFrom_probability ν ℓ y hp
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨E,rfl⟩
  have h1 : 0≤μ.real (hitWordsEvent x y (Strip ℓ x H) (Upper ℓ x H) E) := measureReal_nonneg
  have h2 : μ.real (hitWordsEvent x y (Strip ℓ x H) (Upper ℓ x H) E)≤1 := measureReal_le_one
  have h3 : 0≤η.real (hitWordsEvent x y (Strip ℓ x H) (Upper ℓ x H) E) := measureReal_nonneg
  have h4 : η.real (hitWordsEvent x y (Strip ℓ x H) (Upper ℓ x H) E)≤1 := measureReal_le_one
  exact abs_sub_le_iff.mpr ⟨by linarith,by linarith⟩

theorem shared_observed_clipped_drift_gaussian {d : ℕ} (ν : Measure (Row d))
    [IsProbabilityMeasure ν] (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1≠f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e)))
    (r : ℕ → ℝ) (hrpos : ∀ i, 0<r i)
    (hr : IsGaussianSequence (independentConditionedPairLaw ν (realPosition (step e)))
      (commonIncrementProcess (realPosition (step e)) f 0) r)
    (x y : ℕ → Lattice d) (hxy : ∀ i, signedHeight e (x i)=signedHeight e (y i))
    (hgap : ∀ i, |signedCoordinate f (x i-y i)|=r i)
    {t : ℝ} (ht : 0<t) (htmax : t≤1/1536)
    (hsmall : 8*(2:ℝ)^((3:ℝ)/2)*Real.exp (-commonMeanWidth ν (realPosition (step e))/(9*t)) <
      t/(128*commonMeanWidth ν (realPosition (step e)))) :
    let ℓ := realPosition (step e)
    let n := fun i => fluctuationScale (independentConditionedPairLaw ν ℓ)
      (commonIncrementProcess ℓ f 0) (r i)
    let H := fun i => ⌊t*n i⌋₊
    ∀ᶠ i in atTop,
      1+t/(128*commonMeanWidth ν ℓ) ≤
        ∫ P, min (|physicalFirstHitGap ℓ f (x i) (y i)
          (H i+commonOffset ℓ (signedHeight e) (signedHeight e (x i)+H i) P) P/r i|^((3:ℝ)/2))
          ((2:ℝ)^((3:ℝ)/2)) ∂sharedConditionedPairLaw ν ℓ (x i) (y i) := by
  let ℓ := realPosition (step e)
  let m := commonMeanWidth ν ℓ
  let μ := independentConditionedPairLaw ν ℓ
  let n := fun i => fluctuationScale μ (commonIncrementProcess ℓ f 0) (r i)
  let H := fun i => ⌊t*n i⌋₊
  let M := (2:ℝ)^((3:ℝ)/2)
  let q := t/(128*m)
  let v := fun i => prefixVariation ν ℓ (x i) (y i) (H i)
  have hm : 0 < m := zero_lt_one.trans_le (commonMeanWidth_ge_one ν ℓ htrans (signedHeight e)
    (signedHeight_projection e) (signedHeight_step_le e))
  have hM : 0<M := by dsimp [M]; positivity
  have hq : 0<q := by dsimp [q]; positivity
  have hn := recordFluctuationScale_tendsto ν hue e f hef htrans r hr.1
  have hH : Tendsto H atTop atTop := tendsto_nat_floor_atTop.comp (hn.const_mul_atTop ht)
  have hsep (i : ℕ) : 1*r i ≤ |signedCoordinate f (y i-x i)| := by
    rw [signedCoordinate_sub,abs_sub_comm,← signedCoordinate_sub,hgap i,one_mul]
  have hv := off_diagonal_comparison ν hue e f hef htrans r hrpos hr x y hxy
    (by norm_num : (0:ℝ)<1) ht hsep
  have hvb : IsBoundedUnder (· ≤ ·) atTop v := by
    refine ⟨1,?_⟩
    change ∀ᶠ i in atTop, v i≤1
    exact Eventually.of_forall fun i => prefixVariation_le_one ν hue ℓ (signed_direction_unit e) htrans (x i) (y i) (H i)
  have hlim : limsup v atTop < q/M := by
    have hv' : limsup v atTop ≤ 8*Real.exp (-m/(9*t)) := by simpa only [one_pow,mul_one] using hv
    apply hv'.trans_lt
    apply (lt_div_iff₀ hM).mpr
    change 8*Real.exp (-m/(9*t))*M<q
    convert hsmall using 1
    dsimp only [M,q,m,ℓ]
    ring
  have hevent := eventually_lt_of_limsup_lt hlim hvb
  have hind := independent_firstHit_clipped_drift ν hue e f hef htrans r hrpos hr ht htmax
  have hobs := shared_clipped_observation_transfer ν hue ℓ (signed_direction_unit e) f htrans
    (signedHeight e) (signedHeight_projection e) (signedHeight_step_le e) x y hxy H r hr.1
  have hobs' := hobs.eventually_const_lt (show -q<(0:ℝ) by linarith)
  filter_upwards [hevent,hind,hobs',hH.eventually_gt_atTop 0] with i hvi hi hoi hHi
  have hcmp := clipped_firstHit_comparison ν hue e f htrans (x i) (y i) (hxy i) hHi (r i)
  rw [independent_physicalGap_clipped ν ℓ htrans f (x i) (y i) (H i) (hrpos i) (hgap i)] at hcmp
  have herr : M*v i<q := by
    have hh := (lt_div_iff₀ hM).mp hvi
    nlinarith
  simp only [clippedAbsThreeHalves_apply] at hcmp
  change |(∫ P, min (|physicalFirstHitGap ℓ f (x i) (y i) (H i) P/r i|^((3:ℝ)/2)) M
    ∂sharedConditionedPairLaw ν ℓ (x i) (y i))-
    (∫ P, min (|1+firstHitPairGap ℓ f (H i) P/r i|^((3:ℝ)/2)) M ∂μ)|≤M*v i at hcmp
  have hh := (abs_sub_le_iff.mp hcmp).2
  have heq : t/(32*m)=4*q := by dsimp [q]; ring
  change 1+t/(32*m)≤_ at hi
  rw [heq] at hi
  change -q< _ at hoi
  change 1+q≤_
  dsimp only [M] at hh hi
  linarith

end DirectionalTransience

