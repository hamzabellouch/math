lemma preBrownian_countable_abs_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (T : ℝ≥0) (hT : 0<(T:ℝ)) (t : ℕ → ℝ≥0) (ht : ∀ k, t k≤T)
    (a : ℝ) (ha : 0<a) :
    μ.real {ω | ∃ k, a≤|B (t k) ω|} ≤ 2*Real.exp (-a^2/(2*T)) := by
  let E := fun n => {ω | ∃ k∈Finset.range n, a≤|B (t k) ω|}
  have hm : Monotone E := by
    intro i j hij ω
    rintro ⟨k,hk,hka⟩
    exact ⟨k,Finset.mem_range.mpr ((Finset.mem_range.mp hk).trans_le hij),hka⟩
  have hu : {ω | ∃ k, a≤|B (t k) ω|} = ⋃ n, E n := by
    ext ω
    simp only [Set.mem_ofPred_eq,Set.mem_iUnion,E]
    constructor
    · rintro ⟨k,hk⟩; exact ⟨k+1,k,Finset.mem_range.mpr (Nat.lt_succ_self k),hk⟩
    · rintro ⟨n,k,_,hk⟩; exact ⟨k,hk⟩
  have hb n : μ (E n) ≤ ENNReal.ofReal (2*Real.exp (-a^2/(2*T))) := by
    have hh := preBrownian_finite_abs_maximal μ B hB hBm T hT
      ((Finset.range n).image t) (fun z hz => by
        rcases Finset.mem_image.mp hz with ⟨k,_,rfl⟩; exact ht k) a ha
    have he : {ω | ∃ z∈(Finset.range n).image t, a≤|B z ω|} = E n := by
      ext ω
      simp only [Set.mem_ofPred_eq,Finset.mem_image,E]
      aesop
    rw [he] at hh
    rw [← ofReal_measureReal]
    exact ENNReal.ofReal_le_ofReal hh
  have hbound : μ {ω | ∃ k, a≤|B (t k) ω|} ≤
      ENNReal.ofReal (2*Real.exp (-a^2/(2*T))) := by
    rw [hu,hm.measure_iUnion]
    exact iSup_le hb
  have hh := ENNReal.toReal_mono ENNReal.ofReal_ne_top hbound
  simpa only [measureReal_def,ENNReal.toReal_ofReal (by positivity : 0 ≤ 2*Real.exp (-a^2/(2*T)))] using hh

end DirectionalTransience

