lemma preBrownian_finite_abs_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (T : ℝ≥0) (hT : 0<(T:ℝ)) (I : Finset ℝ≥0) (hI : ∀ z∈I, z≤T)
    (a : ℝ) (ha : 0<a) :
    μ.real {ω | ∃ z∈I, a≤|B z ω|} ≤ 2*Real.exp (-a^2/(2*T)) := by
  let t : ℕ → ℝ≥0 := fun k => if hk : k<I.card then I.orderEmbOfFin rfl ⟨k,hk⟩ else T
  have ht : Monotone t := by
    intro i j hij
    dsimp [t]
    split_ifs with hi hj
    · exact (I.orderEmbOfFin rfl).monotone hij
    · exact hI _ (I.orderEmbOfFin_mem rfl _)
    · omega
    · rfl
  have he : t I.card = T := by simp [t]
  have hh := preBrownian_grid_abs_maximal μ B hB hBm t ht I.card (by simpa [he] using hT) a ha
  rw [he] at hh
  apply le_trans (measureReal_mono (show {ω | ∃ z∈I, a≤|B z ω|} ⊆
    {ω | ∃ k≤I.card, a≤|B (t k) ω|} from ?_)) hh
  rintro ω ⟨z,hz,hza⟩
  let j := (I.orderIsoOfFin rfl).symm ⟨z,hz⟩
  refine ⟨j,j.isLt.le,?_⟩
  have hj : t j = z := by
    simp only [t,dite_eq_left j.isLt,Finset.orderEmbOfFin]
    exact congrArg Subtype.val ((I.orderIsoOfFin rfl).apply_symm_apply ⟨z,hz⟩)
  simpa only [hj] using hza

end DirectionalTransience

