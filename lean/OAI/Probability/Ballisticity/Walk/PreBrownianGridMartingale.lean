lemma preBrownian_grid_martingale {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (t : ℕ → ℝ≥0) (ht : Monotone t) :
    Martingale (fun n => B (t n))
      (Filtration.natural (fun n => B (t n)) (fun n => (hBm (t n)).stronglyMeasurable)) μ := by
  let X := fun n => B (t n)
  let F := Filtration.natural X (fun n => (hBm (t n)).stronglyMeasurable)
  apply martingale_of_condExp_sub_eq_zero_nat (Filtration.stronglyAdapted_natural _)
    (fun i => hB.integrable_eval (t i))
  intro n
  have hn : t n≤t (n+1) := ht (Nat.le_succ n)
  have hind := (hB.indepFun_shift (t n)).comp
    (show Measurable (fun z : ℝ≥0 → ℝ => z (t (n+1)-t n)) by fun_prop)
    (show Measurable (fun z : Set.Iic (t n) → ℝ =>
      fun j : Set.Iic n => z ⟨t j,ht j.2⟩) by fun_prop)
  have he : t n+(t (n+1)-t n) = t (n+1) := add_tsub_cancel_of_le hn
  simp only [Function.comp_def, he] at hind
  have hD : Measurable (B (t (n+1))-B (t n)) := (hBm _).sub (hBm _)
  have hind' : Indep (MeasurableSpace.comap (X (n+1)-X n) inferInstance) (F n) μ := by
    rw [Filtration.natural_eq_comap]
    exact hind
  have hx := condExp_indep_eq hD.comap_le (F.le n)
    (comap_measurable (X (n+1)-X n)).stronglyMeasurable hind'
  have hzero : (∫ ω, (X (n+1)-X n) ω ∂μ) = 0 := by
    change (∫ ω, B (t (n+1)) ω - B (t n) ω ∂μ) = 0
    rw [integral_sub (hB.integrable_eval _) (hB.integrable_eval _), hB.integral_eval,hB.integral_eval,sub_self]
  simpa only [hzero, Pi.zero_def] using hx

lemma preBrownian_grid_abs_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (t : ℕ → ℝ≥0) (ht : Monotone t) (n : ℕ) (hn : 0<(t n:ℝ)) (a : ℝ) (ha : 0<a) :
    μ.real {ω | ∃ k≤n, a≤|B (t k) ω|} ≤ 2*Real.exp (-a^2/(2*t n)) := by
  exact gaussian_martingale_abs_maximal μ _ _
    (preBrownian_grid_martingale μ B hB hBm t ht) t (fun n => (hB.hasLaw_eval (t n)).map_eq) n hn a ha

end DirectionalTransience

