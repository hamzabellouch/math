lemma preBrownian_continuous_abs_gt_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (hBc : ∀ ω, Continuous (fun t => B t ω)) (T : ℝ≥0) (hT : 0<(T:ℝ))
    (a : ℝ) (ha : 0<a) :
    μ.real {ω | ∃ t≤T, a < |B t ω|} ≤ 2*Real.exp (-a^2/(2*T)) := by
  let : Nonempty (Set.Iic T) := ⟨⟨0,by change (0:ℝ≥0) ≤ T; exact zero_le⟩⟩
  let u := TopologicalSpace.denseSeq (Set.Iic T)
  have hu : DenseRange u := TopologicalSpace.denseRange_denseSeq _
  have hh := preBrownian_countable_abs_maximal μ B hB hBm T hT
    (fun n => (u n:ℝ≥0)) (fun n => (u n).2) a ha
  refine (measureReal_mono (show {ω | ∃ t≤T, a < |B t ω|} ⊆
      {ω | ∃ k, a≤|B (u k) ω|} from ?_)).trans hh
  rintro ω ⟨t,ht,hat⟩
  have hc : Continuous (fun z : Set.Iic T => |B z ω|) :=
    (hBc ω).abs.comp continuous_subtype_val
  obtain ⟨k,hk⟩ := hu.exists_mem_open (isOpen_lt continuous_const hc) ⟨⟨t,ht⟩,hat⟩
  exact ⟨k,hk.le⟩

lemma preBrownian_continuous_abs_maximal {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (B : ℝ≥0 → Ω → ℝ)
    (hB : IsPreBrownianReal B μ) (hBm : ∀ t, Measurable (B t))
    (hBc : ∀ ω, Continuous (fun t => B t ω)) (T : ℝ≥0) (hT : 0<(T:ℝ))
    (a : ℝ) (ha : 0<a) :
    μ.real {ω | ∃ t≤T, a≤|B t ω|} ≤ 2*Real.exp (-a^2/(2*T)) := by
  let b : ℕ → ℝ := fun n => a-a/((n:ℝ)+2)
  have hbpos n : 0<b n := by
    have hd : a/((n:ℝ)+2) < a := (div_lt_iff₀ (by positivity)).2 (by nlinarith [Nat.cast_nonneg (α:=ℝ) n])
    dsimp [b]; linarith
  have hblt n : b n<a := by dsimp [b]; exact sub_lt_self a (div_pos ha (by positivity))
  have hb : Tendsto b atTop (𝓝 a) := by
    have hd := (tendsto_const_div_atTop_nhds_zero_nat a).comp (tendsto_add_atTop_nat 2)
    simpa only [Function.comp_def,Nat.cast_add,Nat.cast_ofNat,sub_zero] using tendsto_const_nhds.sub hd
  have hlim : Tendsto (fun n => 2*Real.exp (-(b n)^2/(2*T))) atTop
      (𝓝 (2*Real.exp (-a^2/(2*T)))) := by
    exact tendsto_const_nhds.mul (Real.continuous_exp.tendsto _ |>.comp ((hb.pow 2).neg.div_const (2*T)))
  apply ge_of_tendsto hlim
  filter_upwards [] with n
  have hh := preBrownian_continuous_abs_gt_maximal μ B hB hBm hBc T hT (b n) (hbpos n)
  refine (measureReal_mono (show {ω | ∃ t≤T, a≤|B t ω|} ⊆
    {ω | ∃ t≤T, b n < |B t ω|} from ?_)).trans hh
  rintro ω ⟨t,ht,hat⟩
  exact ⟨t,ht,(hblt n).trans_le hat⟩

end DirectionalTransience

