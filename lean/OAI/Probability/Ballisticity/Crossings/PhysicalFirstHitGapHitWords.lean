namespace DirectionalTransience

lemma physicalFirstHitGap_on_hitWords {d : ℕ} (e f : Direction d) (x y : Lattice d)
    (hxy : signedHeight e x=signedHeight e y) {H : ℕ} (hH : 0<H)
    (w : HitWord x (Strip (realPosition (step e)) x H) (Upper (realPosition (step e)) x H) ×
      HitWord y (Strip (realPosition (step e)) x H) (Upper (realPosition (step e)) x H))
    (P : Path d × Path d) (hx : P.1 ∈ RegularPath (realPosition (step e)) x)
    (hy : P.2 ∈ RegularPath (realPosition (step e)) y)
    (hw : P ∈ wordCylinder x w.1.val ×ˢ wordCylinder y w.2.val) :
    physicalFirstHitGap (realPosition (step e)) f x y H P =
      signedCoordinate f (wordPath x w.1.val w.1.val.length-wordPath y w.2.val w.2.val.length) := by
  let ℓ := realPosition (step e)
  have hhxy : dot (realPosition x) ℓ=dot (realPosition y) ℓ := by
    simp only [ℓ,signedHeight_projection,hxy]
  have hs : Strip ℓ x (H:ℝ)=Strip ℓ y (H:ℝ) := by unfold Strip; rw [hhxy]
  have ht : Upper ℓ x (H:ℝ)=Upper ℓ y (H:ℝ) := by unfold Upper; rw [hhxy]
  have h1 := hitWord_prefix x (Strip ℓ x H) (Upper ℓ x H) w.1 hw.1
  have h2 := hitWord_prefix y (Strip ℓ x H) (Upper ℓ x H) w.2 hw.2
  have h2' : P.2 ∈ HitAt (Strip ℓ y H) (Upper ℓ y H) w.2.val.length := by
    simpa only [hs,ht] using h2
  have hrec1 := coordinate_hitAt_record e x P.1 hx.1 hx.2.1 hH h1
  have hrec2 := coordinate_hitAt_record e y P.2 hy.1 hy.2.1 hH h2'
  simp only [physicalFirstHitGap,firstHitPairGap,hrec1,hrec2,
    hw.1 _ le_rfl,hw.2 _ le_rfl,signedCoordinate_sub]
  ring

theorem clipped_firstHit_comparison {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (hue : UniformElliptic ν) (e f : Direction d)
    (htrans : DirectionallyTransient ν (realPosition (step e))) (x y : Lattice d)
    (hxy : signedHeight e x=signedHeight e y) {H : ℕ} (hH : 0<H) (r : ℝ) :
    |(∫ P, clippedAbsThreeHalves (physicalFirstHitGap (realPosition (step e)) f x y H P/r)
        ∂sharedConditionedPairLaw ν (realPosition (step e)) x y)-
      (∫ P, clippedAbsThreeHalves (physicalFirstHitGap (realPosition (step e)) f x y H P/r)
        ∂(conditionedFrom ν (realPosition (step e)) x).prod
          (conditionedFrom ν (realPosition (step e)) y))|≤
      (2:ℝ)^((3:ℝ)/2)*prefixVariation ν (realPosition (step e)) x y H := by
  let ℓ := realPosition (step e)
  apply prefixVariation_integral_bound ν hue ℓ (signed_direction_unit e) htrans x y
    (by simp only [ℓ,signedHeight_projection,hxy]) H
    (fun P => clippedAbsThreeHalves (physicalFirstHitGap ℓ f x y H P/r))
    (clippedAbsThreeHalves.continuous.measurable.comp
      ((measurable_physicalFirstHitGap ℓ f x y H).div_const r)) (by positivity)
    (fun P => by rw [clippedAbsThreeHalves_apply]; exact le_min (Real.rpow_nonneg (abs_nonneg _) _) (by positivity))
    (fun P => by rw [clippedAbsThreeHalves_apply]; exact min_le_right _ _)
    (fun w => clippedAbsThreeHalves
      (signedCoordinate f (wordPath x w.1.val w.1.val.length-wordPath y w.2.val w.2.val.length)/r))
  intro w P hx hy hw
  rw [physicalFirstHitGap_on_hitWords e f x y hxy hH w P hx hy hw]

end DirectionalTransience

