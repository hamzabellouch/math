namespace DirectionalTransience

theorem raw_median_tube_single_site {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1 ≠ f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e)))
    {w : ℝ} (hw : 0 < w) (hw1 : w ≤ 10) :
    ∃ C : ℝ, 0 < C ∧ ∀ t : ℝ, 0 < t → ∃ δ : ℝ, 0 < δ ∧ δ < 1/4 ∧
      ∃ R : ℝ, 0 < R ∧ ∀ r : ℝ, R ≤ r →
      ∀ H : ℕ, (H:ℝ) ≤ t*fluctuationScale (independentConditionedPairLaw ν (realPosition (step e)))
        (commonIncrementProcess (realPosition (step e)) f 0) r →
      let ℓ := realPosition (step e)
      let hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
      let A := MedianTubeFailure ℓ f (fun j => (recordMedian ν ℓ hp f j:ℝ)) H (w*r)
      (environmentLaw ν).real {ω | (quenchedKernel (ω,0)).real (Aᶜ ∩ NoDrop ℓ 0) < 2*δ} ≤ C*t := by
  let ℓ := realPosition (step e)
  have hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
  obtain ⟨C,hC,hbound⟩ := quenched_median_tube_short_uniform ν hue e f hef htrans hw hw1
  refine ⟨1+2*C,by positivity,?_⟩
  intro t ht
  have hpos : ∀ᵐ ω ∂environmentLaw ν, 0 < (noDropQuenched ℓ 0 ω).toReal := by
    filter_upwards [quenched_noDrop_positive_of_directionallyTransient ν hue ℓ (signed_direction_unit e) htrans] with ω hq
    exact ENNReal.toReal_pos (ne_of_gt (hq 0)) (measure_ne_top _ _)
  obtain ⟨δ,hδ,hδ1,hquant⟩ := positive_lower_quantile (environmentLaw ν)
    (fun ω => (noDropQuenched ℓ 0 ω).toReal) (measurable_noDropQuenched ℓ 0).ennreal_toReal hpos ht
  obtain ⟨R,hR,hRbound⟩ := hbound t ht
  refine ⟨δ,hδ,hδ1,R,hR,?_⟩
  intro r hr H hH
  let A := MedianTubeFailure ℓ f (fun j => (recordMedian ν ℓ hp f j:ℝ)) H (w*r)
  have hb := quenched_good_mass_bad_probability ν hue ℓ (signed_direction_unit e) htrans A
    (measurableSet_medianTubeFailure ℓ f _ H _) hδ
  have htu := hRbound r hr H hH
  change (quenchedConditionedAverage ν ℓ).real A ≤ C*t at htu
  change (environmentLaw ν).real {ω | (quenchedKernel (ω,0)).real (Aᶜ ∩ NoDrop ℓ 0) < 2*δ} ≤ (1+2*C)*t
  linarith

end DirectionalTransience

