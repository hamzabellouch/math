namespace OAI

/-! A dense mass generated by the normalized fresh trace is present in the
original stopped trace at the corresponding physical radius level. -/

noncomputable section
open Set Filter Metric MeasureTheory
open scoped Topology NNReal ENNReal

namespace SLEExactGauge
open FrontSuccessMeasurability

lemma segmentSausageCharge_clock_le
    (κ : ℝ) (γ η : C(ℝ≥0, ℂ)) (T c σ : ℝ≥0)
    (hpath : ∀ t, η t = γ (T + c * t)) (v : ℝ) (D : Set ℂ) :
    segmentSausageCharge κ η 0 σ v D ≤ segmentSausageCharge κ γ 0 (T + c * σ) v D := by
  apply mul_le_mul' le_rfl
  apply measure_mono
  rintro z ⟨hz, t, ht, hdist⟩
  refine ⟨hz, T + c * t, ⟨bot_le,
    add_le_add le_rfl (mul_le_mul_of_nonneg_left ht.2 (show 0 ≤ c from bot_le))⟩, ?_⟩
  simpa only [hpath t] using hdist

lemma stoppedWholeSausageCharge_clock_le
    (κ : ℝ) (γ η : C(ℝ≥0, ℂ)) (T c σ : ℝ≥0) (ρ : WithTop ℝ≥0)
    (hpath : ∀ t, η t = γ (T + c * t))
    (hstop : ((T + c * σ : ℝ≥0) : WithTop ℝ≥0) ≤ ρ) (v : ℝ) (D : Set ℂ) :
    stoppedWholeSausageCharge κ η (σ : WithTop ℝ≥0) v D ≤
      stoppedWholeSausageCharge κ γ ρ v D := by
  rw [stoppedWholeSausageCharge_finite]
  exact (segmentSausageCharge_clock_le κ γ η T c σ hpath v D).trans
    (segmentSausageCharge_le_stoppedWhole κ γ _ ρ hstop v D)

lemma IsCapacityTwoWitness.normalized_restart_level_of_live_source
    {U : ℝ≥0 → ℝ} {γ β : ℝ≥0 → ℂ} {G F G' F' : ℝ≥0 → ℂ → ℂ}
    (hw : IsCapacityTwoWitness U γ G F) (hU : Continuous U) (T a : ℝ≥0) (ha : 0 < a)
    (hb : IsCapacityTwoWitness (normalizedRestartDriver U T a) β G' F')
    (w : ℂ) (u v : ℝ)
    (hbase : fullRadius G T (F T ((a : ℂ) * w + (U T : ℂ))) =
      (2 * (F T ((a : ℂ) * w + (U T : ℂ))).im) * Real.exp (-u))
    (t : ℝ≥0) (ht : w ∈ survivingDomain β t)
    (hR : fullRadius G' t w = (2 * w.im) * Real.exp (-v)) :
    fullRadius G (T + a ^ 2 * t) (F T ((a : ℂ) * w + (U T : ℂ))) =
        (2 * (F T ((a : ℂ) * w + (U T : ℂ))).im) * Real.exp (-(u + v)) ∧
      radiusLevelTime γ G (F T ((a : ℂ) * w + (U T : ℂ))) (u + v) =
        (T + a ^ 2 * t : ℝ≥0) := by
  have hbup := normalized_restart_witness T a ha hb
  have haC : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
  have htu : (a : ℂ) * w ∈ survivingDomain (sourceScaleTrace a β) (a ^ 2 * t) := by
    rw [source_scale_domain_iff a _ ha β, source_scale_time_mul_sq a t ha,
      mul_div_cancel_left₀ w haC]
    exact ht
  have hRu : fullRadius (sourceScaleChart a G') (a ^ 2 * t) ((a : ℂ) * w) =
      (2 * ((a : ℂ) * w).im) * Real.exp (-v) := by
    rw [hb.scaled_radius a ha t w ht, hR]
    simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
    ring
  exact hw.restart_level_of_live_source hU T hbup ((a : ℂ) * w) u v hbase (a ^ 2 * t) htu hRu

/-- At every finite source radius level, the stopped fresh physical mass
is contained in the stopped original mass at the corresponding actual level. -/
theorem IsCapacityTwoWitness.normalized_restart_stopped_mass_le
    {U : ℝ≥0 → ℝ} {γ β : ℝ≥0 → ℂ} {G F G' F' : ℝ≥0 → ℂ → ℂ}
    (hw : IsCapacityTwoWitness U γ G F) (hU : Continuous U) (T a : ℝ≥0) (ha : 0 < a)
    (hb : IsCapacityTwoWitness (normalizedRestartDriver U T a) β G' F')
    (w : ℂ) (u q : ℝ)
    (hbase : fullRadius G T (F T ((a : ℂ) * w + (U T : ℂ))) =
      (2 * (F T ((a : ℂ) * w + (U T : ℂ))).im) * Real.exp (-u))
    (η : C(ℝ≥0, ℂ)) (hpath : ∀ t, η t = γ (T + a ^ 2 * t))
    (hfinite : radiusLevelTime β G' w q < ∞) (κ v : ℝ) (D : Set ℂ) :
    stoppedWholeSausageCharge κ η (radiusLevelTime β G' w q) v D ≤
      stoppedWholeSausageCharge κ ⟨γ, hw.1⟩
        (radiusLevelTime γ G (F T ((a : ℂ) * w + (U T : ℂ))) (u + q)) v D := by
  have hV : Continuous (normalizedRestartDriver U T a) := by
    unfold normalizedRestartDriver
    fun_prop
  obtain ⟨t, ht, hR⟩ := exists_live_level_of_radiusLevelTime_lt_top β G' w q hfinite
  have hs := radiusLevelTime_eq_of_live_level hV hb w q t ht hR
  have hp := (hw.normalized_restart_level_of_live_source hU T a ha hb w u q hbase t ht hR).2
  have hs' : (radiusLevelTime β G' w q : WithTop ℝ≥0) = (t : WithTop ℝ≥0) := by exact_mod_cast hs
  have hp' : (radiusLevelTime γ G (F T ((a : ℂ) * w + (U T : ℂ))) (u + q) : WithTop ℝ≥0) =
      ((T + a ^ 2 * t : ℝ≥0) : WithTop ℝ≥0) := by exact_mod_cast hp
  rw [hs', hp']
  exact stoppedWholeSausageCharge_clock_le κ ⟨γ, hw.1⟩ η T (a ^ 2) t _ hpath le_rfl v D

end SLEExactGauge

end

