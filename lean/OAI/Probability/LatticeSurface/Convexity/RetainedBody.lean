namespace SparseBlocks

lemma compact_body (V : Finset Vertex) : IsCompact (body V) := by
  obtain ⟨B,hVB,hcollar,hc,hp⟩ := exists_ambient V
  let e := Homeomorph.piCongrLeft (Y:=fun _ : ExtremalEdges.Free (fixed B V) => ℝ) (indexEquiv B V hVB)
  have he : body V=e.symm '' ExtremalEdges.conditionalBody (finiteGraph B) (fixed B V) (fun _ => 0) := by
    rw [← body_coordinates B V hVB hcollar]
    ext x
    constructor
    · intro hx;exact ⟨e x,hx,e.symm_apply_apply x⟩
    · rintro ⟨y,hy,rfl⟩
      change e (e.symm y)∈ExtremalEdges.conditionalBody (finiteGraph B) (fixed B V) (fun _ => 0)
      simpa using hy
  rw [he]
  exact (ExtremalEdges.compact_zeroBody _ hc _ hp).image e.symm.continuous

lemma height_add (V : Finset Vertex) (h k : V → ℝ) (x : Vertex) : height V (h+k) x=height V h x+height V k x := by
  classical
  by_cases hx : x∈V <;> simp [height,hx]

lemma height_smul (V : Finset Vertex) (c : ℝ) (h : V → ℝ) (x : Vertex) : height V (c • h) x=c*height V h x := by
  classical
  by_cases hx : x∈V <;> simp [height,hx]

lemma convex_body (V : Finset Vertex) : Convex ℝ (body V) := by
  intro h hh k hk a b ha hb hab x y hxy
  simp only [height_add,height_smul]
  calc
    |a*height V h x+b*height V k x-(a*height V h y+b*height V k y)|=
      |a*(height V h x-height V h y)+b*(height V k x-height V k y)| := by ring_nf
    _ ≤ |a*(height V h x-height V h y)|+|b*(height V k x-height V k y)| := abs_add_le _ _
    _ ≤ a*1+b*1 := by rw [abs_mul,abs_mul,abs_of_nonneg ha,abs_of_nonneg hb];gcongr <;> [exact hh x y hxy;exact hk x y hxy]
    _ = 1 := by linarith

lemma body_neg_iff (V : Finset Vertex) (h : V → ℝ) : h∈body V ↔ -h∈body V := by
  have he (k : V → ℝ) : k∈body V → -k∈body V := by
    intro hk x y hxy
    have hn (z : Vertex) : height V (-k) z= -height V k z := by
      classical
      by_cases hz : z∈V <;> simp [height,hz]
    simpa only [hn,neg_sub_neg,abs_sub_comm] using hk x y hxy
  exact ⟨he h,fun hh => by simpa using he (-h) hh⟩

end SparseBlocks

namespace RetainedShell

open TriangularLipschitz

attribute [local instance] Classical.propDecidable

noncomputable def splitLinear {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) :
    (V → ℝ) ≃ₗ[ℝ] ((retained L V J → ℝ) × (J → Filling L)) where
  toEquiv := (split hL V J hf).toEquiv
  map_add' h k := by
    apply Prod.ext
    · ext x
      change (split hL V J hf (h+k)).1 x=(split hL V J hf h).1 x+(split hL V J hf k).1 x
      simp only [split_fst,Pi.add_apply]
    · ext z x
      change (split hL V J hf (h+k)).2 z x=(split hL V J hf h).2 z x+(split hL V J hf k).2 z x
      simp only [split_snd,Pi.add_apply]
  map_smul' c h := by
    apply Prod.ext
    · ext x
      change (split hL V J hf (c • h)).1 x=c • (split hL V J hf h).1 x
      simp only [split_fst,Pi.smul_apply]
    · ext z x
      change (split hL V J hf (c • h)).2 z x=c • (split hL V J hf h).2 z x
      simp only [split_snd,Pi.smul_apply]

def retainedBody {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) := (split hL V J hf).symm ⁻¹' SparseBlocks.body V

lemma retainedBody_eq {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) :
    retainedBody hL V J hf=(split hL V J hf) '' SparseBlocks.body V := by
  ext x;change (split hL V J hf).symm x∈SparseBlocks.body V ↔ x∈(split hL V J hf) '' SparseBlocks.body V
  constructor
  · intro hx;exact ⟨_,hx,(split hL V J hf).apply_symm_apply x⟩
  · rintro ⟨y,hy,rfl⟩;simpa using hy

lemma compact_retainedBody {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : IsCompact (retainedBody hL V J hf) := by
  rw [retainedBody_eq]
  exact (SparseBlocks.compact_body V).image (continuous_split hL V J hf)

lemma convex_retainedBody {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : Convex ℝ (retainedBody hL V J hf) := by
  rw [retainedBody_eq]
  exact (SparseBlocks.convex_body V).linear_image (splitLinear hL V J hf).toLinearMap

lemma neg_retainedBody {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V)
    (x : (retained L V J → ℝ) × (J → Filling L)) :
    x∈retainedBody hL V J hf ↔ -x∈retainedBody hL V J hf := by
  change (splitLinear hL V J hf).symm x∈SparseBlocks.body V ↔
    (splitLinear hL V J hf).symm (-x)∈SparseBlocks.body V
  rw [map_neg]
  exact SparseBlocks.body_neg_iff _ _

end RetainedShell

