namespace RetainedShell

open TriangularLipschitz

attribute [local instance] Classical.propDecidable

abbrev Indices (L : ℕ) (V J : Finset Vertex) := (retained L V J) ⊕ (Σ _ : J,interior L)

def indexMap (L : ℕ) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : Indices L V J → V
  | .inl x => ⟨x,(Finset.mem_sdiff.mp x.2).1⟩
  | .inr ⟨z,x⟩ => ⟨base L z+x,hf z z.2 x (interior_subset_box L x.2)⟩

lemma indexMap_bijective {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : Function.Bijective (indexMap L V J hf) := by
  constructor
  · intro i j hij
    cases i with
    | inl x =>
      cases j with
      | inl y => exact congrArg Sum.inl (Subtype.ext (congrArg (fun v : V => (v:Vertex)) hij))
      | inr y =>
        have he : x.val=base L y.1+y.2 := congrArg Subtype.val hij
        have hm : x.val∈bulk L J := mem_bulk.mpr ⟨y.1,y.1.2,by rw [he];simp⟩
        exact False.elim ((Finset.mem_sdiff.mp x.2).2 hm)
    | inr x =>
      cases j with
      | inl y =>
        have he : y.val=base L x.1+x.2 := (congrArg Subtype.val hij).symm
        have hm : y.val∈bulk L J := mem_bulk.mpr ⟨x.1,x.1.2,by rw [he];simp⟩
        exact False.elim ((Finset.mem_sdiff.mp y.2).2 hm)
      | inr y =>
        have he : base L x.1+x.2=base L y.1+y.2 := congrArg Subtype.val hij
        have hz : x.1=y.1 := Subtype.ext (block_unique hL
          (show base L x.1+x.2-base L x.1∈interior L by simp)
          (show base L x.1+x.2-base L y.1∈box L by rw [he];simpa using interior_subset_box L y.2.2))
        cases x with | mk z x =>
          cases y with | mk w y =>
            dsimp at hz;subst w
            have hxy : x=y := Subtype.ext (add_left_cancel he)
            subst y;rfl
  · intro x
    by_cases hb : x.val∈bulk L J
    · obtain ⟨z,hz,hx⟩ := mem_bulk.mp hb
      refine ⟨.inr ⟨⟨z,hz⟩,⟨x-base L z,hx⟩⟩,?_⟩
      apply Subtype.ext
      simp [indexMap]
    · refine ⟨.inl ⟨x,Finset.mem_sdiff.mpr ⟨x.2,hb⟩⟩,rfl⟩

noncomputable def indexEquiv {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : Indices L V J ≃ V :=
  Equiv.ofBijective (indexMap L V J hf) (indexMap_bijective hL V J hf)

noncomputable def split {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) :
    (V → ℝ) ≃ᵐ ((retained L V J → ℝ) × (J → Filling L)) :=
  ((MeasurableEquiv.piCongrLeft (fun _ : Indices L V J => ℝ) (indexEquiv hL V J hf).symm).trans
    (MeasurableEquiv.sumPiEquivProdPi (fun _ => ℝ))).trans
    ((MeasurableEquiv.refl _).prodCongr (ProductVolume.curry (J:=fun _ : J => interior L)))

lemma preserving_split {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : MeasurePreserving (split hL V J hf) := by
  exact ((MeasurePreserving.id volume).prod ProductVolume.curry_volume).comp
    ((volume_measurePreserving_sumPiEquivProdPi (fun _ => ℝ)).comp
      (volume_measurePreserving_piCongrLeft _ (indexEquiv hL V J hf).symm))

@[simp] lemma split_fst {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) (h : V → ℝ) (x : retained L V J) :
    (split hL V J hf h).1 x=h ⟨x,(Finset.mem_sdiff.mp x.2).1⟩ := by
  simp [split,MeasurableEquiv.piCongrLeft,Equiv.piCongrLeft_apply_eq_cast,
    MeasurableEquiv.sumPiEquivProdPi,Equiv.sumPiEquivProdPi,indexEquiv,indexMap,MeasurableEquiv.prodCongr,MeasurableEquiv.refl]

@[simp] lemma split_snd {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) (h : V → ℝ) (z : J) (x : interior L) :
    (split hL V J hf h).2 z x=h ⟨base L z+x,hf z z.2 x (interior_subset_box L x.2)⟩ := by
  simp [split,MeasurableEquiv.piCongrLeft,Equiv.piCongrLeft_apply_eq_cast,
    MeasurableEquiv.sumPiEquivProdPi,Equiv.sumPiEquivProdPi,indexEquiv,indexMap,ProductVolume.curry,
    MeasurableEquiv.piCurry,MeasurableEquiv.prodCongr,MeasurableEquiv.refl,Sigma.curry]

lemma continuous_split {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) : Continuous (split hL V J hf) := by
  have hfst : Continuous (fun h:V→ℝ => (split hL V J hf h).1) := by
    apply continuous_pi;intro x
    change Continuous (fun h:V→ℝ => (split hL V J hf h).1 x)
    simp only [split_fst]
    exact continuous_apply _
  have hsnd : Continuous (fun h:V→ℝ => (split hL V J hf h).2) := by
    apply continuous_pi;intro z;apply continuous_pi;intro x
    change Continuous (fun h:V→ℝ => (split hL V J hf h).2 z x)
    simp only [split_snd]
    exact continuous_apply _
  exact hfst.prodMk hsnd

lemma split_assembled {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) (s : retained L V J → ℝ) (a : J → Filling L) :
    split hL V J hf (fun x:V => assembled L V J s a x)=(s,a) := by
  apply Prod.ext
  · ext x
    rw [split_fst,assembled_remaining L V J s a (Finset.mem_sdiff.mp x.2).2]
    simp [retainedHeight,x.2]
  · ext z x
    rw [split_snd,assembled_interior hL V J s a z (by simp)]
    congr 1
    apply Subtype.ext;simp

lemma inverse_height {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) (s : retained L V J → ℝ) (a : J → Filling L) :
    SparseBlocks.height V ((split hL V J hf).symm (s,a))=assembled L V J s a := by
  have hi : (split hL V J hf).symm (s,a)=(fun x:V => assembled L V J s a x) := by
    apply (split hL V J hf).injective
    rw [MeasurableEquiv.apply_symm_apply,split_assembled]
  rw [hi]
  ext x
  by_cases hx : x∈V
  · simp [SparseBlocks.height,hx]
  · rw [SparseBlocks.height,dite_eq_right hx]
    exact (assembled_zero_exterior L V J hf s a hx).symm

lemma body_fiber {L : ℕ} (hL : 0<L) (V J : Finset Vertex)
    (hf : ∀ z∈J,∀ x∈box L,base L z+x∈V) (s : retained L V J → ℝ) (a : J → Filling L) :
    (split hL V J hf).symm (s,a)∈SparseBlocks.body V ↔ a∈fiber L V J s := by
  simp only [SparseBlocks.body,Set.mem_ofPred_eq,inverse_height hL V J hf s a,fiber]
  rfl

