theorem fin_ite {n : ℕ} (i j : Fin n) (a b : ℤ) :
    @ite ℤ (i = j) (Classical.propDecidable _) a b =
      @ite ℤ (i = j) (instDecidableEqFin n i j) a b := by
  by_cases h : i = j <;> simp [h]

local instance : DecidableEq (Fin 103) := Classical.decEq _
local instance : DecidableEq (Fin 372) := Classical.decEq _
local instance : DecidableEq (Fin 270) := Classical.decEq _

noncomputable def d₁ := FiniteIntegralContraction.rowsMap d1Row
noncomputable def d₂ := FiniteIntegralContraction.rowsMap d2Row
noncomputable def h₀ := FiniteIntegralContraction.matrixMap h0Coeff
noncomputable def h₁ := FiniteIntegralContraction.matrixMap h1Coeff
noncomputable def h₁' := FiniteIntegralContraction.corrected d₁ h₀ h₁

theorem d₁_single (e : Fin 372) :
    d₁ (Pi.single e 1) = Pi.single (edge e).2 1 - Pi.single (edge e).1 1 :=
by
  apply FiniteIntegralContraction.rows_single_one edge d1Row
  intro i e
  simpa only [rowEval,FiniteIntegralContraction.rowEval,fin_ite] using d1_basis_cert i e

theorem d₂_single (t : Fin 270) :
    d₂ (Pi.single t 1) = Pi.single (triangleEdges t).1 1 -
      Pi.single (triangleEdges t).2.1 1 + Pi.single (triangleEdges t).2.2 1 :=
by
  apply FiniteIntegralContraction.rows_single_two triangleEdges d2Row
  intro e t
  simpa only [rowEval,FiniteIntegralContraction.rowEval,fin_ite] using d2_basis_cert e t

theorem bottom_identity (v : Fin 103) : d₁ (h₀ (Pi.single v 1)) = Pi.single v 1 - Pi.single 0 1 :=
by
  apply FiniteIntegralContraction.certificate_bottom d1Row h0Coeff 0
  intro i v
  simpa only [rowEval,FiniteIntegralContraction.rowEval,fin_ite] using d1_h0_cert i v

theorem left_identity (t : Fin 270) : h₁ (d₂ (Pi.single t 1)) = Pi.single t 1 :=
by
  apply FiniteIntegralContraction.certificate_left triangleEdges d2Row h1Coeff d₂_single
  intro t j
  simpa only [fin_ite] using h1_boundary_cert t j

theorem d₁_d₂_single (t : Fin 270) : d₁ (d₂ (Pi.single t 1)) = 0 := by
  rw [d₂_single,map_add,map_sub,d₁_single,d₁_single,d₁_single]
  obtain ⟨h₁,h₂,h₃⟩ := triangle_edges_valid t
  rw [h₁,h₂,h₃]
  dsimp
  abel

theorem corrected_identities :
    (∀ t, h₁' (d₂ (Pi.single t 1)) = Pi.single t 1) ∧
    (∀ e, d₂ (h₁' (Pi.single e 1)) + h₀ (d₁ (Pi.single e 1)) = Pi.single e 1) :=
  FiniteIntegralContraction.middle_of_rank (by simp only [Fintype.card_fin]) 0 d₁ d₂ h₀ h₁
    d₁_d₂_single bottom_identity left_identity

theorem fin_single {n : ℕ} (d : DecidableEq (Fin n)) (i : Fin n) (a : ℤ) :
    @Pi.single (Fin n) (fun _ => ℤ) (fun _ => inferInstance) d i a =
    @Pi.single (Fin n) (fun _ => ℤ) (fun _ => inferInstance) (instDecidableEqFin n) i a := by
  ext j
  simp only [Pi.single_apply]
  split_ifs <;> rfl

/-- An augmented integral chain contraction of the actual103-vertex source
cell-order complex, not an assumed homology property of the seed. -/
noncomputable def contraction : SimplicialChains.Contraction graph :=
  indices.contraction 0 h₀ h₁' d₁ d₂
    (by simpa only [indices,fin_single] using d₁_single)
    (by simpa only [indices,fin_single] using d₂_single)
    (by simpa only [fin_single] using bottom_identity)
    (by simpa only [fin_single] using corrected_identities.1)
    (by simpa only [fin_single] using corrected_identities.2)

end EilenbergGanea.SeedChainCertificate


