import Mathlib

namespace OAI

section

namespace NuclearUltrapower.SOS
variable {α A : Type*} [DecidableEq α]

/-- Sparse integral polynomials, before combining repeated labels. -/
abbrev Poly (α : Type*) := List (α × ℤ)

def addHead (p : α × ℤ) : Poly α → Poly α
  | [] => [p]
  | q::qs => if p.1 = q.1 then (p.1, p.2 + q.2)::qs else p::q::qs

def compress : Poly α → Poly α
  | [] => []
  | p::ps => addHead p (compress ps)

def normalize (le : α → α → Bool) (ps : Poly α) : Poly α :=
  compress (ps.insertionSort (fun p q => le p.1 q.1 = true))

section Evaluation
variable [AddCommGroup A]

def eval (f : α → A) (ps : Poly α) : A :=
  (ps.map (fun p => p.2 • f p.1)).sum

omit [DecidableEq α] in
@[simp] theorem eval_nil (f : α → A) : eval f [] = 0 := rfl
omit [DecidableEq α] in
@[simp] theorem eval_cons (f : α → A) (p : α × ℤ) (ps : Poly α) :
    eval f (p::ps) = p.2 • f p.1 + eval f ps := rfl

theorem eval_addHead (f : α → A) (p : α × ℤ) (ps : Poly α) :
    eval f (addHead p ps) = p.2 • f p.1 + eval f ps := by
  cases ps with
  | nil => simp [addHead]
  | cons q qs =>
    simp only [addHead]
    split_ifs with h
    · simp only [eval_cons, ← h, add_zsmul, add_assoc]
    · rfl

theorem eval_compress (f : α → A) (ps : Poly α) : eval f (compress ps) = eval f ps := by
  induction ps with
  | nil => rfl
  | cons p ps ih => simp only [compress, eval_addHead, ih, eval_cons]

/-- Sorting and collecting is a sound reflection procedure in any abelian group. -/
theorem eval_normalize (f : α → A) (le : α → α → Bool) (ps : Poly α) :
    eval f (normalize le ps) = eval f ps := by
  rw [normalize, eval_compress]
  exact List.Perm.sum_eq ((List.perm_insertionSort _ ps).map _)

end Evaluation

theorem support_addHead (p : α × ℤ) (ps : Poly α) {g : α} :
    g ∈ (addHead p ps).map Prod.fst → g = p.1 ∨ g ∈ ps.map Prod.fst := by
  cases ps with
  | nil => simp [addHead]
  | cons q qs =>
    simp only [addHead]
    split_ifs with h <;> simp_all

theorem support_compress (ps : Poly α) {g : α} :
    g ∈ (compress ps).map Prod.fst → g ∈ ps.map Prod.fst := by
  induction ps with
  | nil => simp [compress]
  | cons p ps ih =>
    intro h
    rcases support_addHead p (compress ps) h with h | h
    · simp [h]
    · simp [ih h]

/-- Collection never introduces a new group element. -/
theorem support_normalize (le : α → α → Bool) (ps : Poly α) {g : α} :
    g ∈ (normalize le ps).map Prod.fst → g ∈ ps.map Prod.fst := by
  intro h
  have hm := support_compress (ps.insertionSort _) h
  exact ((List.perm_insertionSort _ ps).map Prod.fst).mem_iff.mp hm

/-- Flat 3-by-3 integer matrices, used only as kernel-computable labels. -/
abbrev Mat3 := List ℤ

def entry (a : Mat3) (i j : Nat) : ℤ := a.getD (3*i+j) 0

def matMul (a b : Mat3) : Mat3 :=
  (List.range 3).flatMap fun i => (List.range 3).map fun j =>
    entry a i 0 * entry b 0 j + entry a i 1 * entry b 1 j + entry a i 2 * entry b 2 j

def matInv (a : Mat3) : Mat3 :=
  (List.range 3).flatMap fun i => (List.range 3).map fun j =>
    entry a ((j+1)%3) ((i+1)%3) * entry a ((j+2)%3) ((i+2)%3) -
      entry a ((j+1)%3) ((i+2)%3) * entry a ((j+2)%3) ((i+1)%3)

def matOne : Mat3 := [1,0,0,0,1,0,0,0,1]

def matLe : Mat3 → Mat3 → Bool
  | [], _ => true
  | _::_, [] => false
  | a::as, b::bs => if a = b then matLe as bs else decide (a ≤ b)

def intL1 (p : Poly α) : ℤ := (p.map (fun p => |p.2|)).sum

end NuclearUltrapower.SOS

