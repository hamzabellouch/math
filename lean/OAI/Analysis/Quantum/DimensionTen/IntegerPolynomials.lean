def F : ℤ[X] := FP X

lemma map_FP {R S : Type*} [Ring R] [Ring S] (φ : R →+* S) (z : R) :
    φ (FP z) = FP (φ z) := by
  simp only [FP, map_add, map_mul, map_intCast, map_one]

lemma F_map {R : Type*} [CommRing R] : F.map (Int.castRingHom R) = FP X := by
  exact (map_FP (mapRingHom (Int.castRingHom R)) X).trans (congrArg FP (map_X _))

lemma horner_int_monic {R : Type*} [CommRing R] [Nontrivial R] {p : R[X]} {n : ℕ}
    (hp : p.IsMonicOfDegree n) (a : ℤ) :
    ((a : R[X]) + X * p).IsMonicOfDegree (n+1) := by
  rw [← C_eq_intCast]
  exact Mod131.horner_monic_degree hp _

lemma FP_degree {R : Type*} [CommRing R] [Nontrivial R] :
    (FP (X : R[X])).IsMonicOfDegree 20 := by
  unfold FP
  repeat' apply horner_int_monic
  exact ⟨natDegree_one, monic_one⟩

lemma F_monic : F.Monic := FP_degree.monic
lemma F_degree : F.natDegree = 20 := FP_degree.natDegree_eq

