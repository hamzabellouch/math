lemma FP_B0 : FP B0 = 0 := by
  have h (j : Fin 20) : (FP B0) *ᵥ Pi.single j 1 = 0 := by
    fin_cases j
    · exact annihilate_0
    · exact annihilate_1
    · exact annihilate_2
    · exact annihilate_3
    · exact annihilate_4
    · exact annihilate_5
    · exact annihilate_6
    · exact annihilate_7
    · exact annihilate_8
    · exact annihilate_9
    · exact annihilate_10
    · exact annihilate_11
    · exact annihilate_12
    · exact annihilate_13
    · exact annihilate_14
    · exact annihilate_15
    · exact annihilate_16
    · exact annihilate_17
    · exact annihilate_18
    · exact annihilate_19

  ext i j
  have hh := congrFun (h j) i
  simpa [Matrix.mulVec_single] using hh

