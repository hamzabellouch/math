namespace ModularSupport
variable {K : Type*} [Field K] {n : ℕ}

def polyVec (c : Fin n → K) : K[X] := ∑ i : Fin n, monomial (i : ℕ) (c i)
lemma polyVec_coeff (c : Fin n → K) (i : Fin n) : (polyVec c).coeff i = c i := by
  classical
  simp [polyVec, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Fin.val_inj]
lemma polyVec_degree (c : Fin n → K) : (polyVec c).degree < n := by
  classical
  apply (Polynomial.degree_lt_iff_coeff_zero _ _).mpr
  intro k hk
  simp only [polyVec, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
  apply Finset.sum_eq_zero
  intro i _
  rw [ite_eq_right (by omega : ¬ (i : ℕ) = k)]
lemma polyVec_natDegree (c : Fin n → K) (hn : 0 < n) : (polyVec c).natDegree < n := by
  by_cases h : polyVec c = 0
  · simpa [h] using hn
  · exact (Polynomial.natDegree_lt_iff_degree_lt h).mpr (polyVec_degree c)
lemma monic_of_vec (c : Fin n → K) : (X ^ n + polyVec c).Monic := by
  exact (Polynomial.monic_X_pow n).add_of_left (by simpa using polyVec_degree c)
lemma natDegree_of_vec (c : Fin n → K) (hn : 0 < n) : (X ^ n + polyVec c).natDegree = n := by
  rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt (by simpa using polyVec_natDegree c hn)]
  simp

lemma powers_of_chain (A : Matrix (Fin n) (Fin n) K)
    (V : Matrix (Fin n) (Fin (n+1)) K) (v : Fin n → K)
    (hv : ∀ i, V i 0 = v i)
    (hstep : ∀ j : Fin n, A.mulVec (fun i => V i j.castSucc) = fun i => V i j.succ) :
    ∀ j : Fin (n+1), (fun i => V i j) = (A ^ (j : ℕ)).mulVec v := by
  intro j
  induction j using Fin.induction with
  | zero => simpa using funext hv
  | succ j ih =>
    rw [← hstep j, ih]
    simp only [Fin.val_succ, Fin.val_castSucc, pow_succ', Matrix.mulVec_mulVec]

lemma aeval_vec (A : Matrix (Fin n) (Fin n) K) (v : Fin n → K) (c : Fin n → K) :
    (aeval A (polyVec c)).mulVec v =
      (∑ j : Fin n, c j • ((A ^ (j : ℕ)).mulVec v)) := by
  simp only [polyVec, map_sum, Polynomial.aeval_monomial, Matrix.sum_mulVec, Algebra.algebraMap_eq_smul_one,
    Matrix.smul_mul, one_mul, Matrix.smul_mulVec]

lemma charpoly_of_chain (A V B : Matrix (Fin n) (Fin n) K)
    (U : Matrix (Fin n) (Fin (n+1)) K) (v : Fin n → K) (c : Fin n → K)
    (hn : 0 < n) (hv : ∀ i, U i 0 = v i)
    (hstep : ∀ j : Fin n, A.mulVec (fun i => U i j.castSucc) = fun i => U i j.succ)
    (hUV : U.submatrix id Fin.castSucc = V) (hB : B * V = 1)
    (hfinal : (fun i => U i (Fin.last n)) + V.mulVec c = 0) :
    A.charpoly = X ^ n + polyVec c := by
  have hp := powers_of_chain A U v hv hstep
  have hV : V = Matrix.of (fun (i j : Fin n) => ((A ^ (j : ℕ)).mulVec v) i) := by
    rw [← hUV]
    ext i j
    exact congrFun (hp j.castSucc) i
  have hcyclic (q : K[X]) (hq : q.natDegree < n)
      (he : (aeval A q).mulVec v = 0) : q = 0 := by
    have heq : (aeval A q).mulVec v = V.mulVec (fun i => q.coeff i) := by
      rw [Polynomial.aeval_eq_sum_range' hq, hV]
      simp only [Matrix.sum_mulVec, Matrix.smul_mulVec]
      ext i
      simp only [Finset.sum_apply, Matrix.mulVec, dotProduct, Matrix.of_apply]
      rw [← Fin.sum_univ_eq_sum_range]
      apply Finset.sum_congr rfl
      intro j _
      simp [Matrix.mulVec, dotProduct, mul_comm]
    have hh := congrArg (Matrix.mulVec B) he
    rw [heq, Matrix.mulVec_mulVec, hB, Matrix.one_mulVec, Matrix.mulVec_zero] at hh
    ext k
    by_cases hk : k < n
    · exact congrFun hh ⟨k,hk⟩
    · exact (Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)).trans (Polynomial.coeff_zero _).symm
  have he : (aeval A (X ^ n + polyVec c)).mulVec v = 0 := by
    have hlast : (fun i => U i (Fin.last n)) = (A ^ n).mulVec v := hp (Fin.last n)
    rw [map_add, map_pow, Polynomial.aeval_X, Matrix.add_mulVec, ← hlast, aeval_vec]
    have hsum : (∑ j : Fin n, c j • ((A ^ (j : ℕ)).mulVec v)) = V.mulVec c := by
      ext i
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct]
      apply Finset.sum_congr rfl
      intro j _
      rw [hV]
      simp [Matrix.mulVec, dotProduct, mul_comm]
    rw [hsum]
    exact hfinal
  have hdeg : (A.charpoly - (X ^ n + polyVec c)).natDegree < n :=
    Polynomial.IsMonicOfDegree.natDegree_sub_lt hn.ne'
      ⟨by simp, Matrix.charpoly_monic A⟩ ⟨natDegree_of_vec c hn, monic_of_vec c⟩
  apply sub_eq_zero.mp
  apply hcyclic _ hdeg
  rw [map_sub, Matrix.aeval_self_charpoly, zero_sub, Matrix.neg_mulVec, he, neg_zero]
end ModularSupport

open Polynomial
namespace PolynomialCertificate
attribute [local instance] Classical.propDecidable
variable {R : Type*} [CommRing R]

def poly : List R → R[X]
  | [] => 0
  | a :: l => C a + X * poly l

def add : List R → List R → List R
  | [], b => b
  | a, [] => a
  | a :: as, b :: bs => (a + b) :: add as bs

def neg (a : List R) : List R := a.map Neg.neg

def mul : List R → List R → List R
  | [], _ => []
  | a :: as, b => add (b.map (a * ·)) (0 :: mul as b)

lemma poly_map_mul (a : R) (b : List R) : poly (b.map (a * ·)) = C a * poly b := by
  induction b with
  | nil => simp [poly]
  | cons x xs ih => simp only [List.map_cons, poly, ih, map_mul]; ring

lemma poly_add (a b : List R) : poly (add a b) = poly a + poly b := by
  induction a generalizing b with
  | nil => simp [add, poly]
  | cons x xs ih =>
    cases b with
    | nil => simp [add, poly]
    | cons y ys => simp only [add, poly, ih, map_add]; ring

lemma poly_neg (a : List R) : poly (neg a) = -poly a := by
  induction a with
  | nil => simp [neg, poly]
  | cons x xs ih => simp only [neg, List.map_cons, poly] at *; rw [ih, map_neg]; ring

lemma poly_mul (a b : List R) : poly (mul a b) = poly a * poly b := by
  induction a with
  | nil => simp [mul, poly]
  | cons x xs ih => rw [mul, poly_add, poly_map_mul, poly, ih, poly]; simp only [map_zero]; ring

lemma poly_eq_zero (a : List R) (h : ∀ c ∈ a, c = 0) : poly a = 0 := by
  induction a with
  | nil => rfl
  | cons x xs ih =>
    rw [poly, h x (by simp), ih (fun c hc => h c (by simp [hc]))]
    simp

lemma verify_mul (a b r f q : List R)
    (h : ∀ c ∈ add (mul a b) (neg (add r (mul f q))), c = 0) :
    poly a * poly b = poly r + poly f * poly q := by
  have hh := poly_eq_zero _ h
  rw [poly_add, poly_neg, poly_add, poly_mul, poly_mul] at hh
  exact eq_of_sub_eq_zero (by simpa only [sub_eq_add_neg] using hh)

lemma verify_add_mul (a b c d r : List R)
    (h : ∀ x ∈ add (add (mul a b) (mul c d)) (neg r), x = 0) :
    poly a * poly b + poly c * poly d = poly r := by
  have hh := poly_eq_zero _ h
  rw [poly_add, poly_neg, poly_add, poly_mul, poly_mul] at hh
  exact eq_of_sub_eq_zero (by simpa only [sub_eq_add_neg] using hh)

lemma poly_coeff (a : List R) (n : ℕ) : (poly a).coeff n = a[n]?.getD 0 := by
  induction a generalizing n with
  | nil => simp [poly]
  | cons c cs ih =>
    cases n with
    | zero => simp [poly]
    | succ n => simp [poly, Polynomial.coeff_X_mul, ih]

lemma poly_natDegree_le (a : List R) : (poly a).natDegree ≤ a.length - 1 := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [poly_coeff]
  simp [List.getElem?_eq_none (by omega : a.length ≤ k)]

lemma poly_natDegree_eq (a : List R) (n : ℕ) (hlen : a.length = n+1)
    (h : a[n]?.getD 0 ≠ 0) : (poly a).natDegree = n := by
  apply le_antisymm
  · simpa [hlen] using poly_natDegree_le a
  · apply Polynomial.le_natDegree_of_ne_zero
    rwa [poly_coeff]

lemma verify_sub (a b c : List R)
    (h : ∀ x ∈ add (add a (neg b)) (neg c), x = 0) : poly a - poly b = poly c := by
  have hh := poly_eq_zero _ h
  rw [poly_add, poly_add, poly_neg, poly_neg] at hh
  exact sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using hh)

lemma verify_eq_mul (a b r : List R)
    (h : ∀ c ∈ add (mul a b) (neg r), c = 0) : poly a * poly b = poly r := by
  have hh := poly_eq_zero _ h
  rw [poly_add, poly_neg, poly_mul] at hh
  exact eq_of_sub_eq_zero (by simpa only [sub_eq_add_neg] using hh)

lemma verify_mod (a b r f q : List R)
    (h : ∀ c ∈ add (mul a b) (neg (add r (mul f q))), c = 0) :
    poly f ∣ poly a * poly b - poly r := by
  refine ⟨poly q, ?_⟩
  rw [verify_mul a b r f q h]
  ring

lemma mod_trans {f a b c : R[X]} (h : f ∣ a-b) (h' : f ∣ b-c) : f ∣ a-c := by
  convert dvd_add h h' using 1; ring
lemma mod_mul {f a b c d : R[X]} (h : f ∣ a-b) (h' : f ∣ c-d) :
    f ∣ a*c-b*d := by
  convert dvd_add (dvd_mul_of_dvd_left h c) (dvd_mul_of_dvd_right h' b) using 1; ring

lemma power_mod_mul {f a b c : R[X]} {m n : ℕ}
    (hm : f ∣ X^m-a) (hn : f ∣ X^n-b) (hs : f ∣ a*b-c) :
    f ∣ X^(m+n)-c := by
  exact mod_trans (by simpa only [pow_add] using mod_mul hm hn) hs

lemma power_mod_mul_eq {f a b c : R[X]} {m n e : ℕ}
    (he : m + n = e) (hm : f ∣ X^m-a) (hn : f ∣ X^n-b) (hs : f ∣ a*b-c) :
    f ∣ X^e-c := by
  subst e
  exact power_mod_mul hm hn hs

variable {F : Type*} [Field F] [DecidableEq F]
lemma gcd_degree_of_mod {f r g : F[X]} {n : ℕ}
    (hf : f ≠ 0) (hg : g ≠ 0) (hr : f ∣ X ^ n - r)
    (hgf : g ∣ f) (hgr : g ∣ r-X)
    (bezout : ∃ a b, a*f+b*(r-X)=g) :
    (EuclideanDomain.gcd f (X ^ n-X)).natDegree = g.natDegree := by
  classical
  let d := EuclideanDomain.gcd f (X ^ n-X)
  have hdf : d ∣ f := EuclideanDomain.gcd_dvd_left _ _
  have hdX : d ∣ X ^ n-X := EuclideanDomain.gcd_dvd_right _ _
  have hdr : d ∣ r-X := by
    convert dvd_sub hdX (dvd_trans hdf hr) using 1; ring
  obtain ⟨a,b,hab⟩ := bezout
  have hdg : d ∣ g := hab ▸ dvd_add (dvd_mul_of_dvd_right hdf a) (dvd_mul_of_dvd_right hdr b)
  have hgd : g ∣ d := by
    apply EuclideanDomain.dvd_gcd hgf
    convert dvd_add (dvd_trans hgf hr) hgr using 1; ring
  have hd : d ≠ 0 := ne_zero_of_dvd_ne_zero hf hdf
  exact (Polynomial.natDegree_le_of_dvd hdg hg).antisymm
    (Polynomial.natDegree_le_of_dvd hgd hd)

end PolynomialCertificate

