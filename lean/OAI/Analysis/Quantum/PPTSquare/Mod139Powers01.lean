def powerCert (e : ℕ) (a : List (ZMod 139)) : Prop := f ∣ X ^ e - poly a
lemma powerStep (e m n : ℕ) (a b c : List (ZMod 139))
    (he : m+n=e) (ha : powerCert m a) (hb : powerCert n b) (hs : f ∣ poly a*poly b-poly c) :
    powerCert e c := by
  exact PolynomialCertificate.power_mod_mul_eq he ha hb hs
def degreeCert (e n : ℕ) : Prop := by
  classical
  exact (EuclideanDomain.gcd f (X ^ e-X)).natDegree = n
lemma degreeStep (e n : ℕ) (r g : List (ZMod 139))
    (hpow : powerCert e r) (hg : poly g ≠ 0) (hgf : poly g ∣ f) (hgr : poly g ∣ poly r-X)
    (hb : ∃ a b, a*f+b*(poly r-X)=poly g) (hdeg : (poly g).natDegree = n) : degreeCert e n := by
  unfold degreeCert
  exact (gcd_degree_of_mod (charpoly_A ▸ Matrix.charpoly_monic A).ne_zero hg hpow hgf hgr hb).trans hdeg
