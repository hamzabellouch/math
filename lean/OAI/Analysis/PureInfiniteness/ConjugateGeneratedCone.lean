import OAI.Analysis.Nuclearity.PositiveConeNullIdeal

namespace OAI

/-! The concrete closed positive cone generated by a family of functionals
and their coefficient conjugates, as used in KR02 Lemma 7.18. -/

noncomputable section
open scoped Topology ComplexOrder

namespace WeakPureInfiniteness

variable {D I : Type*} [NonUnitalCStarAlgebra D] [PartialOrder D] [StarOrderedRing D]

def positiveFunctionalReal (φ : D →ₚ[ℂ] ℂ) : WeakDual ℝ (selfAdjoint D) :=
  StrongDual.toWeakDual
    { toFun := fun a => (φ (a : D)).re
      map_add' := by
        intro a b
        change (φ ((a : D) + (b : D))).re = _
        simp only [map_add, Complex.add_re]
      map_smul' := by
        intro c a
        change (φ.toLinearMap (c • (a : D))).re = _
        rw [φ.toLinearMap.map_smul_of_tower]
        simp
      cont := Complex.continuous_re.comp ((map_continuous φ).comp continuous_subtype_val) }

lemma positiveFunctionalReal_apply (φ : D →ₚ[ℂ] ℂ) (a : selfAdjoint D) :
    positiveFunctionalReal φ a = (φ (a : D)).re := rfl

lemma positiveFunctionalReal_nonneg (φ : D →ₚ[ℂ] ℂ) (a : selfAdjoint D) (ha : 0 ≤ (a : D)) :
    0 ≤ positiveFunctionalReal φ a := (map_nonneg φ ha).1

def weakConjugation (d : D) :
    WeakDual ℝ (selfAdjoint D) →L[ℝ] WeakDual ℝ (selfAdjoint D) where
  toFun := fun φ => conjugateRealFunctional φ d
  map_add' := by intro φ ψ; apply DFunLike.ext; intro a; rfl
  map_smul' := by intro t φ; apply DFunLike.ext; intro a; rfl
  cont := by
    apply WeakBilin.continuous_of_continuous_eval
    intro a
    exact WeakDual.eval_continuous (selfAdjointConjugation d a)

omit [PartialOrder D] [StarOrderedRing D] in
lemma conjugateRealFunctional_comp (φ : WeakDual ℝ (selfAdjoint D)) (d e : D) :
    conjugateRealFunctional (conjugateRealFunctional φ d) e =
      conjugateRealFunctional φ (e * d) := by
  apply DFunLike.ext
  intro a
  change φ (selfAdjointConjugation d (selfAdjointConjugation e a)) =
    φ (selfAdjointConjugation (e * d) a)
  congr 1
  apply Subtype.ext
  simp only [selfAdjointConjugation_apply, star_mul, mul_assoc]

def positiveRealDualCone : ConvexCone ℝ (WeakDual ℝ (selfAdjoint D)) where
  carrier := {φ | ∀ a : selfAdjoint D, 0 ≤ (a : D) → 0 ≤ φ a}
  smul_mem' := by
    intro t ht φ hφ a ha
    exact mul_nonneg ht.le (hφ a ha)
  add_mem' := by
    intro φ hφ ψ hψ a ha
    exact add_nonneg (hφ a ha) (hψ a ha)

omit [StarOrderedRing D] in
lemma positiveRealDualCone_closed : IsClosed (positiveRealDualCone (D := D) : Set (WeakDual ℝ (selfAdjoint D))) := by
  have he : (positiveRealDualCone (D := D) : Set (WeakDual ℝ (selfAdjoint D))) =
      ⋂ (a : selfAdjoint D) (_h : 0 ≤ (a : D)), {φ | (0 : ℝ) ≤ φ a} := by
    ext φ
    change (∀ a : selfAdjoint D, 0 ≤ (a : D) → 0 ≤ φ a) ↔ _
    simp only [Set.mem_ofPred_eq, Set.mem_iInter]
  rw [he]
  exact isClosed_iInter fun a => isClosed_iInter fun _ =>
    isClosed_le continuous_const (WeakDual.eval_continuous a)

def conjugateGenerators (φ : I → D →ₚ[ℂ] ℂ) : Set (WeakDual ℝ (selfAdjoint D)) :=
  {ψ | ψ = 0 ∨ ∃ i, ψ = positiveFunctionalReal (φ i) ∨
    ∃ d : D, ψ = conjugateRealFunctional (positiveFunctionalReal (φ i)) d}

def conjugateGeneratedCone (φ : I → D →ₚ[ℂ] ℂ) : ConvexCone ℝ (WeakDual ℝ (selfAdjoint D)) :=
  (ConvexCone.hull ℝ (conjugateGenerators φ)).closure

lemma conjugateGenerators_nonneg (φ : I → D →ₚ[ℂ] ℂ) :
    conjugateGenerators φ ⊆ (positiveRealDualCone (D := D) : Set (WeakDual ℝ (selfAdjoint D))) := by
  rintro ψ (rfl | ⟨i, rfl | ⟨d, rfl⟩⟩) a ha
  · exact le_refl 0
  · exact positiveFunctionalReal_nonneg _ a ha
  · exact positiveFunctionalReal_nonneg _ _ (star_left_conjugate_nonneg ha d)

lemma conjugateGeneratedCone_nonneg (φ : I → D →ₚ[ℂ] ℂ) :
    (conjugateGeneratedCone φ : Set _) ⊆ (positiveRealDualCone (D := D) : Set (WeakDual ℝ (selfAdjoint D))) :=
  closure_minimal (ConvexCone.hull_min (conjugateGenerators_nonneg φ))
    positiveRealDualCone_closed

lemma conjugateGeneratedCone_zero (φ : I → D →ₚ[ℂ] ℂ) :
    (0 : WeakDual ℝ (selfAdjoint D)) ∈ conjugateGeneratedCone φ :=
  subset_closure (ConvexCone.subset_hull (Or.inl rfl))

lemma conjugateGeneratedCone_base (φ : I → D →ₚ[ℂ] ℂ) (i : I) :
    positiveFunctionalReal (φ i) ∈ conjugateGeneratedCone φ :=
  subset_closure (ConvexCone.subset_hull (Or.inr ⟨i, Or.inl rfl⟩))

lemma conjugateGeneratedCone_conjugate (φ : I → D →ₚ[ℂ] ℂ) (d : D) :
    ∀ ψ ∈ conjugateGeneratedCone φ, conjugateRealFunctional ψ d ∈ conjugateGeneratedCone φ := by
  let K := ConvexCone.hull ℝ (conjugateGenerators φ)
  have hgen : conjugateGenerators φ ⊆ K.comap (weakConjugation d).toLinearMap := by
    rintro ψ (rfl | ⟨i, rfl | ⟨e, rfl⟩⟩)
    · change conjugateRealFunctional 0 d ∈ K
      have hz : conjugateRealFunctional (0 : WeakDual ℝ (selfAdjoint D)) d = 0 := by apply DFunLike.ext; intro a; rfl
      rw [hz]
      exact ConvexCone.subset_hull (Or.inl rfl)
    · exact ConvexCone.subset_hull (Or.inr ⟨i, Or.inr ⟨d, rfl⟩⟩)
    · change conjugateRealFunctional (conjugateRealFunctional (positiveFunctionalReal (φ i)) e) d ∈ K
      rw [conjugateRealFunctional_comp]
      exact ConvexCone.subset_hull (Or.inr ⟨i, Or.inr ⟨d * e, rfl⟩⟩)
  have hK : K ≤ K.comap (weakConjugation d).toLinearMap := ConvexCone.hull_min hgen
  intro ψ hψ
  change weakConjugation d ψ ∈ closure (K : Set _)
  exact map_mem_closure (weakConjugation d).continuous hψ (fun _ h => hK h)

end WeakPureInfiniteness

end

end OAI
