import OAI.Analysis.PureInfiniteness.SpectralCharacters

namespace OAI

/-! The commutative unital algebra generated by a finite commuting family in
its unitization. The augmentation character records membership in the original
nonunital algebra. -/

noncomputable section
open scoped IsMulCommutative ComplexOrder

namespace WeakPureInfiniteness

variable {A I : Type*} [NonUnitalCStarAlgebra A]

def jointSpectralAlgebra (a : I → A) : StarSubalgebra ℂ (Unitization ℂ A) :=
  (StarAlgebra.adjoin ℂ (Set.range fun i => (a i : Unitization ℂ A))).topologicalClosure

instance jointSpectralAlgebra_closed (a : I → A) :
    IsClosed (jointSpectralAlgebra a : Set (Unitization ℂ A)) :=
  StarSubalgebra.isClosed_topologicalClosure _

def jointSpectralGenerator (a : I → A) (i : I) : jointSpectralAlgebra a :=
  ⟨(a i : Unitization ℂ A), StarSubalgebra.le_topologicalClosure _
    (StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩)⟩

lemma jointSpectralGenerator_selfAdjoint (a : I → A) (ha : ∀ i, IsSelfAdjoint (a i))
    (i : I) : IsSelfAdjoint (jointSpectralGenerator a i) := by
  apply IsSelfAdjoint.of_map (jointSpectralAlgebra a).subtype Subtype.val_injective
  exact (ha i).map (Unitization.inrNonUnitalStarAlgHom ℂ A)

lemma jointSpectralAlgebra_commutative (a : I → A) (ha : ∀ i, IsSelfAdjoint (a i))
    (hc : ∀ i j, Commute (a i) (a j)) : IsMulCommutative (jointSpectralAlgebra a) := by
  have hbase : IsMulCommutative
      (StarAlgebra.adjoin ℂ (Set.range fun i => (a i : Unitization ℂ A))) := by
    apply StarAlgebra.isMulCommutative_adjoin
    · rintro _ ⟨i, rfl⟩
      exact ((ha i).map (Unitization.inrNonUnitalStarAlgHom ℂ A)).isStarNormal
    · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
      exact (hc i j).map (Unitization.inrNonUnitalStarAlgHom ℂ A)
    · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
      change Commute (a i : Unitization ℂ A) (star (a j : Unitization ℂ A))
      have hj : IsSelfAdjoint (a j : Unitization ℂ A) :=
        (ha j).map (Unitization.inrNonUnitalStarAlgHom ℂ A)
      rw [hj.star_eq]
      exact (hc i j).map (Unitization.inrNonUnitalStarAlgHom ℂ A)
  let := hbase
  exact StarSubalgebra.isMulCommutative_topologicalClosure _

def unitizationAugmentation : Unitization ℂ A →⋆ₐ[ℂ] ℂ :=
  { Unitization.fstHom ℂ A with map_star' := Unitization.fst_star }

def jointSpectralAugmentation (a : I → A) : jointSpectralAlgebra a →⋆ₐ[ℂ] ℂ :=
  unitizationAugmentation.comp (jointSpectralAlgebra a).subtype

@[simp] lemma jointSpectralAugmentation_generator (a : I → A) (i : I) :
    jointSpectralAugmentation a (jointSpectralGenerator a i) = 0 := rfl

lemma jointSpectralAugmentation_zero_iff (a : I → A) (x : jointSpectralAlgebra a) :
    jointSpectralAugmentation a x = 0 ↔ ∃ b : A, (x : Unitization ℂ A) = b := by
  constructor
  · intro h
    refine ⟨(x : Unitization ℂ A).snd, ?_⟩
    apply Unitization.ext
    · exact h
    · rfl
  · rintro ⟨b, hb⟩
    change (x : Unitization ℂ A).fst = 0
    rw [hb]
    rfl

/-- The original-algebra coordinate; the augmentation-zero hypothesis below
is what makes its inclusion equal to the original element. -/
def jointOriginalElement (a : I → A) (x : jointSpectralAlgebra a) : A :=
  (x : Unitization ℂ A).snd

lemma jointOriginalElement_inr (a : I → A) (x : jointSpectralAlgebra a)
    (hx : jointSpectralAugmentation a x = 0) :
    (jointOriginalElement (A := A) a x : Unitization ℂ A) = (x : Unitization ℂ A) := by
  apply Unitization.ext
  · exact hx.symm
  · rfl

lemma jointOriginalElement_norm (a : I → A) (x : jointSpectralAlgebra a)
    (hx : jointSpectralAugmentation a x = 0) : ‖jointOriginalElement (A := A) a x‖ = ‖x‖ := by
  calc
    _ = ‖(jointOriginalElement (A := A) a x : Unitization ℂ A)‖ := (Unitization.norm_inr (𝕜 := ℂ) (a := jointOriginalElement (A := A) a x)).symm
    _ = ‖(x : Unitization ℂ A)‖ := congrArg norm (jointOriginalElement_inr a x hx)
    _ = _ := rfl

section Order
variable [PartialOrder A] [StarOrderedRing A]

lemma jointSpectralGenerator_nonneg (a : I → A) (ha : ∀ i, 0 ≤ a i) (i : I) :
    0 ≤ jointSpectralGenerator a i := by
  change 0 ≤ (a i : Unitization ℂ A)
  exact Unitization.inr_nonneg_iff.mpr (ha i)

lemma jointOriginalElement_nonneg (a : I → A) (x : jointSpectralAlgebra a)
    (hx : jointSpectralAugmentation a x = 0) (hxp : 0 ≤ x) :
    0 ≤ jointOriginalElement (A := A) a x := by
  apply Unitization.inr_nonneg_iff.mp
  rw [jointOriginalElement_inr a x hx]
  exact hxp

end Order
end WeakPureInfiniteness

end

end OAI
