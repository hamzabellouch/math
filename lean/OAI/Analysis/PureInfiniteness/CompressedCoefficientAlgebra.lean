import OAI.Analysis.PureInfiniteness.CommutativeCoefficientAlgebra
import OAI.Analysis.Nuclearity.FourPositiveParts

namespace OAI

/-! A compressed coefficient belongs to the algebra generated by the four
compressed positive parts. This keeps the commutative algebra in the original
nonunital ambient algebra. -/

noncomputable section

namespace WeakPureInfiniteness

variable {D I : Type*} [NonUnitalCStarAlgebra D] [PartialOrder D] [StarOrderedRing D]

def compressedParts (x : I → D) (z : D) (p : I × Fin 4) : D :=
  star z * fourPositiveParts (x p.1) p.2 * z

lemma compressedParts_nonneg (x : I → D) (z : D) (p : I × Fin 4) :
    0 ≤ compressedParts x z p := star_left_conjugate_nonneg (fourPositiveParts_nonneg _ _) z

omit [PartialOrder D] [StarOrderedRing D] in
lemma compression_mem_of_parts (S : NonUnitalStarSubalgebra ℂ D) (x z : D)
    (hp : ∀ j : Fin 4, star z * fourPositiveParts x j * z ∈ S) : star z * x * z ∈ S := by
  rw [fourPositiveParts_decomposition x]
  simp only [mul_add, add_mul, mul_sub, sub_mul, mul_smul_comm, smul_mul_assoc]
  exact S.add_mem (S.sub_mem (hp 0) (hp 1)) (S.smul_mem _ (S.sub_mem (hp 2) (hp 3)))

omit [PartialOrder D] [StarOrderedRing D] in
lemma compression_mem_coefficientAlgebra (x : I → D) (z : D) (i : I) :
    star z * x i * z ∈ coefficientAlgebra (compressedParts x z) := by
  apply compression_mem_of_parts
  intro j
  exact (coefficientGenerator (compressedParts x z) (i, j)).property

lemma compressedParts_algebra_commutative (x : I → D) (z : D)
    (hc : ∀ p q, Commute (compressedParts x z p) (compressedParts x z q)) :
    IsMulCommutative (coefficientAlgebra (compressedParts x z)) := by
  apply coefficientAlgebra_commutative
  · intro p
    exact (compressedParts_nonneg x z p).isSelfAdjoint.isStarNormal
  · exact hc
  · intro p q
    rw [(compressedParts_nonneg x z q).isSelfAdjoint.star_eq]
    exact hc p q

end WeakPureInfiniteness

end

end OAI
