import OAI.Analysis.PureInfiniteness.SpectralProductGrid
import OAI.Analysis.PureInfiniteness.SpectralGridCFC

namespace OAI

/-! Product spectral partitions in a commutative C*-algebra. They will be
mapped into the ambient algebra generated by the finite commuting family. -/

noncomputable section
open scoped BigOperators

namespace WeakPureInfiniteness

variable {D I : Type*} [CommCStarAlgebra D] [PartialOrder D] [StarOrderedRing D]
  [Fintype I] [DecidableEq I]

omit [Fintype I] in
lemma commutative_prod_nonneg (s : Finset I) (u : I → D) (hu : ∀ i ∈ s, 0 ≤ u i) :
    0 ≤ ∏ i ∈ s, u i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi]
    exact Commute.mul_nonneg (hu i (Finset.mem_insert_self _ _))
      (ih (fun j hj => hu j (Finset.mem_insert_of_mem hj))) (by exact mul_comm _ _)

def productGridHatElement (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (k : SpectralGridCell s) : D := ∏ i, gridHatElement (a i) r (k i)

def productGridPlateauElement (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (k : SpectralGridCell s) : D := ∏ i, gridPlateauElement (a i) r (k i)

lemma productGridHatElement_nonneg (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (k : SpectralGridCell s) : 0 ≤ productGridHatElement a r s k :=
  commutative_prod_nonneg _ _ fun i _ => gridHatElement_nonneg (a i) r (k i)

lemma productGridPlateauElement_nonneg (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (k : SpectralGridCell s) : 0 ≤ productGridPlateauElement a r s k :=
  commutative_prod_nonneg _ _ fun i _ => gridPlateauElement_nonneg (a i) r (k i)

omit [PartialOrder D] [StarOrderedRing D] [DecidableEq I] in
lemma productGridPlateauElement_mul_hat (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (k : SpectralGridCell s) : productGridPlateauElement a r s k *
      productGridHatElement a r s k = productGridHatElement a r s k := by
  unfold productGridPlateauElement productGridHatElement
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun i _ => gridPlateauElement_mul_gridHatElement (a i) r (k i)

omit [PartialOrder D] [StarOrderedRing D] in
lemma sum_productGridHatElement_eq_one (a : I → D) (r : ℝ) (s : I → Finset ℤ)
    (hs : ∀ i, ∑ k ∈ s i, gridHatElement (a i) r k = 1) :
    ∑ k : SpectralGridCell s, productGridHatElement a r s k = 1 := by
  unfold productGridHatElement
  rw [← Fintype.prod_sum (fun i (j : ↥(s i)) => gridHatElement (a i) r j)]
  have hsum (i : I) : ∑ k : ↥(s i), gridHatElement (a i) r k = 1 := by
    exact (Finset.sum_coe_sort (s i) (fun k => gridHatElement (a i) r k)).trans (hs i)
  simp only [hsum, Finset.prod_const_one]

omit [PartialOrder D] [StarOrderedRing D] in
lemma norm_sum_productGridPlateauElement_le (a : I → D) (r : ℝ) (s : I → Finset ℤ) :
    ‖∑ k : SpectralGridCell s, productGridPlateauElement a r s k‖ ≤
      (5 : ℝ) ^ Fintype.card I := by
  classical
  rcases subsingleton_or_nontrivial D with hD | hD
  · have hz : (∑ k : SpectralGridCell s, productGridPlateauElement a r s k) = 0 :=
      hD.elim _ _
    rw [hz, norm_zero]
    positivity
  let := hD
  unfold productGridPlateauElement
  rw [← Fintype.prod_sum (fun i (j : ↥(s i)) => gridPlateauElement (a i) r j)]
  calc
    _ ≤ ∏ i : I, ‖∑ k : ↥(s i), gridPlateauElement (a i) r k‖ := Finset.norm_prod_le _ _
    _ ≤ ∏ _i : I, (5 : ℝ) := by
      apply Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
      intro i _
      rw [Finset.sum_coe_sort (s i) (fun k => gridPlateauElement (a i) r k)]
      exact norm_sum_gridPlateauElement_le (a i) r (s i)
    _ = _ := by simp

end WeakPureInfiniteness

end

end OAI
