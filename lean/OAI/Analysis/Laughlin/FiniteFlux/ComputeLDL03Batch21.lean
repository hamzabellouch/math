theorem computeLDL_21_3_0 : MatrixCompute.compressed 21 candidateY_21 candidateZ_21 3 0 =
    (lower_21 * Matrix.diagonal pivots_21 * lower_21.transpose) 3 0 := by
  rw [MatrixCompute.compressed_apply, MatrixCompute.ldl_apply]
  decide +kernel

