import OAI.Analysis.BoundedHochschild.CountableDiagonalOperators

namespace OAI

/-! The diagonal corner of the von Neumann algebra generated by a countable
matrix system is abelian. The proof uses diagonal operators and weak-star
closed commutation relations. -/

noncomputable section

open Topology

namespace BoundedHochschild.KadisonRingrose

open HochschildComparison

universe u
variable {M X : Type u} [CStarAlgebra M] [PartialOrder M] [StarOrderedRing M]
  [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]

omit [PartialOrder M] [StarOrderedRing M] in
lemma countableMatrixClosure_commute (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    (c : ℕ → PartialIso M) {D : M}
    (hD : ∀ i j, Commute ((c i : M) * star (c j : M)) D)
    {x : M} (hx : x ∈ countableMatrixClosure e c) : Commute x D := by
  have hA : countableMatrixAlgebra c ≤ StarSubalgebra.centralizer ℂ ({D} : Set M) := by
    apply StarAlgebra.adjoin_le
    rintro a ⟨⟨i, j⟩, rfl⟩
    apply (StarSubalgebra.mem_centralizer_iff ℂ).mpr
    intro g hg
    have hgD : g = D := Set.mem_singleton_iff.mp hg
    subst g
    refine ⟨(hD i j).eq.symm, ?_⟩
    simpa only [star_mul, star_star] using congrArg star (hD j i).eq
  have hclosed : IsClosed {F : WeakDual ℂ X |
      (WeakAlgebra.weakEquiv e).symm (WeakAlgebra.weakEquiv e F * D) =
      (WeakAlgebra.weakEquiv e).symm (D * WeakAlgebra.weakEquiv e F)} :=
    isClosed_eq
      (WeakAlgebra.normal_continuous e _ ((HochschildSakai.abstract_multiplication_normal e).2 D))
      (WeakAlgebra.normal_continuous e _ ((HochschildSakai.abstract_multiplication_normal e).1 D))
  have hclosure : (WeakAlgebra.linearClosure e (countableMatrixAlgebra c) : Set (WeakDual ℂ X)) ⊆
      {F | (WeakAlgebra.weakEquiv e).symm (WeakAlgebra.weakEquiv e F * D) =
      (WeakAlgebra.weakEquiv e).symm (D * WeakAlgebra.weakEquiv e F)} := by
    apply closure_minimal _ hclosed
    rintro F ⟨a, ha, rfl⟩
    have hcomm := ((StarSubalgebra.mem_centralizer_iff ℂ).mp (hA ha) D (Set.mem_singleton D)).1
    change (WeakAlgebra.weakEquiv e).symm
        (WeakAlgebra.weakEquiv e ((WeakAlgebra.weakEquiv e).symm a) * D) =
      (WeakAlgebra.weakEquiv e).symm
        (D * WeakAlgebra.weakEquiv e ((WeakAlgebra.weakEquiv e).symm a))
    simpa only [LinearEquiv.apply_symm_apply] using congrArg (WeakAlgebra.weakEquiv e).symm hcomm.symm
  have h := (WeakAlgebra.weakEquiv e).symm.injective (hclosure hx)
  change x * D = D * x
  simpa only [LinearEquiv.apply_symm_apply] using h

lemma countableMatrixClosure_coefficient_central (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    (c : ℕ → PartialIso M) (hi : ∀ i, (c i).initial = 1)
    (ho : ∀ i j, i ≠ j → (c i).final * (c j).final = 0)
    {x : M} (hx : x ∈ countableMatrixClosure e c) (i : ℕ) (a : M) :
    Commute (star (c i : M) * x * (c i : M)) a := by
  obtain ⟨D, _, hDc, hcD⟩ := exists_countable_diagonal_operator e c hi ho a
  have hD (j k : ℕ) : Commute ((c j : M) * star (c k : M)) D := by
    change ((c j : M) * star (c k : M)) * D = D * ((c j : M) * star (c k : M))
    calc
      _ = (c j : M) * (a * star (c k : M)) := by rw [mul_assoc, hcD k]
      _ = ((c j : M) * a) * star (c k : M) := by rw [mul_assoc]
      _ = _ := by rw [← hDc j, mul_assoc]
  have hxD := countableMatrixClosure_commute e c hD hx
  change (star (c i : M) * x * (c i : M)) * a = a * (star (c i : M) * x * (c i : M))
  calc
    _ = star (c i : M) * x * ((c i : M) * a) := by simp only [mul_assoc]
    _ = star (c i : M) * x * (D * (c i : M)) := by rw [hDc i]
    _ = star (c i : M) * (x * D) * (c i : M) := by simp only [mul_assoc]
    _ = star (c i : M) * (D * x) * (c i : M) := by rw [hxD.eq]
    _ = (star (c i : M) * D) * x * (c i : M) := by simp only [mul_assoc]
    _ = (a * star (c i : M)) * x * (c i : M) := by rw [hcD i]
    _ = _ := by simp only [mul_assoc]

theorem countableMatrixClosure_diagonal_abelian (e : StrongDual ℂ X ≃ₗᵢ⋆[ℂ] M)
    (c : ℕ → PartialIso M) (hi : ∀ i, (c i).initial = 1)
    (ho : ∀ i j, i ≠ j → (c i).final * (c j).final = 0) (i : ℕ) :
    FinitePathMain.AbelianProjection
      (⟨(c i).final, countableMatrixClosure_transition e c i i⟩ : countableMatrixClosure e c) := by
  let p : countableMatrixClosure e c :=
    ⟨(c i).final, countableMatrixClosure_transition e c i i⟩
  have hp : IsStarProjection p :=
    ⟨Subtype.ext (c i).final_proj.isIdempotentElem.eq,
      Subtype.ext (c i).final_proj.isSelfAdjoint.star_eq⟩
  refine ⟨hp, fun x y => ?_⟩
  have hm (a b : M) : ((c i).final * a * (c i).final) * ((c i).final * b * (c i).final) =
      (c i : M) * ((star (c i : M) * a * (c i : M)) *
        (star (c i : M) * b * (c i : M))) * star (c i : M) := by
    change (((c i : M) * star (c i : M)) * a * ((c i : M) * star (c i : M))) *
      (((c i : M) * star (c i : M)) * b * ((c i : M) * star (c i : M))) = _
    calc
      _ = (c i : M) * (star (c i : M) * a * (c i : M)) *
          (star (c i : M) * (c i : M)) *
          (star (c i : M) * b * (c i : M)) * star (c i : M) := by simp only [mul_assoc]
      _ = _ := by
        rw [show star (c i : M) * (c i : M) = 1 from hi i, mul_one]
        simp only [mul_assoc]
  apply Subtype.ext
  change ((c i).final * (x : M) * (c i).final) * ((c i).final * (y : M) * (c i).final) =
    ((c i).final * (y : M) * (c i).final) * ((c i).final * (x : M) * (c i).final)
  rw [hm, hm, (countableMatrixClosure_coefficient_central e c hi ho x.property i
    (star (c i : M) * (y : M) * (c i : M))).eq]

end BoundedHochschild.KadisonRingrose

end

end OAI
