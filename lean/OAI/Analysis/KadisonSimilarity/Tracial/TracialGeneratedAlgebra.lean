import OAI.Analysis.KadisonSimilarity.FreeProduct.GeneratedCompression
import OAI.Analysis.KadisonSimilarity.Tracial.TracialSubalgebraTransfer

namespace OAI

/-! Passing to the algebra normally generated by two free factors gives
the intrinsic reduced-product generation hypothesis. Only ordinary L²
density of the generating algebra is used; no word decomposition or
operator estimate is assumed here. -/

noncomputable section
namespace KadisonSimilarity
open TracialCornerGeometry

variable {P H : Type*} [CStarAlgebra P]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem factorAlgebra_map_subtype (A D L : StarSubalgebra ℂ P)
    [IsClosed (L : Set P)]
    (hA : A ≤ L) (hD : D ≤ L) :
    (factorAlgebra (A.comap L.subtype) (D.comap L.subtype)).map L.subtype =
      factorAlgebra A D := by
  have himage (B : StarSubalgebra ℂ P) (hB : B ≤ L) :
      L.subtype '' (B.comap L.subtype : Set L) = (B : Set P) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩; exact hy
    · intro hx; exact ⟨⟨x, hB hx⟩, hx, rfl⟩
  simp only [factorAlgebra, StarAlgHom.map_adjoin, Set.image_union,
    himage A hA, himage D hD]

namespace TracialCornerGeometry

variable (G : TracialCornerGeometry P H) (A D L : StarSubalgebra ℂ P)
  [IsClosed (L : Set P)]

/-- Ordinary ambient L² generation yields the exact intrinsic generation
hypothesis for the closed generated algebra's tracial geometry. -/
theorem factorsTraciallyGenerate_of_L2_generation
    (hA : A ≤ L) (hD : D ≤ L)
    (hdense : ∀ a : L, G.vector (a : P) ∈
      closure (Set.range (G.vector.comp (factorAlgebra A D).subtype.toLinearMap))) :
    (G.baseGeometry L).FactorsTraciallyGenerate (A.comap L.subtype) (D.comap L.subtype) := by
  let S := factorAlgebra (A.comap L.subtype) (D.comap L.subtype)
  have hm : S.map L.subtype = factorAlgebra A D := factorAlgebra_map_subtype A D L hA hD
  have hr : Set.range (fun a : S => (G.baseVector L (a : L) : H)) =
      Set.range (G.vector.comp (factorAlgebra A D).subtype.toLinearMap) := by
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      have ha : ((a : L) : P) ∈ factorAlgebra A D := by
        rw [← hm]
        exact ⟨a, a.property, rfl⟩
      exact ⟨⟨((a : L) : P), ha⟩, rfl⟩
    · rintro ⟨a, rfl⟩
      have ha : (a : P) ∈ S.map L.subtype := by rw [hm]; exact a.property
      obtain ⟨b, hb, hab⟩ := ha
      refine ⟨⟨b, hb⟩, ?_⟩
      change G.vector (b : P) = G.vector (a : P)
      exact congrArg G.vector hab
  change Dense (Set.range ((G.baseVector L).comp S.subtype.toLinearMap))
  rw [Subtype.dense_iff, ← Set.range_comp]
  change (G.baseSpace L : Set H) ⊆
    closure (Set.range (fun a : S => (G.baseVector L (a : L) : H)))
  rw [hr]
  change closure (Set.range (G.baseAlgebraVectors L)) ⊆ _
  apply closure_minimal _ isClosed_closure
  rintro _ ⟨a, rfl⟩
  exact hdense a

end TracialCornerGeometry
end KadisonSimilarity

end

end OAI
