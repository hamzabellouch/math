import OAI.Analysis.KadisonSimilarity.Tracial.TracialMatrixSymmetrization
import OAI.Analysis.KadisonSimilarity.Tracial.UltrapowerCommutators

namespace OAI

/-! Restriction to the closed algebra generated by the free factors
preserves both commutation and the small-corner estimate. -/

noncomputable section
namespace KadisonSimilarity

variable {P H : Type*} [CStarAlgebra P]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

namespace TracialCornerGeometry
variable (G : TracialCornerGeometry P H) (L : StarSubalgebra ℂ P)

/-- Compression to the actual base Hilbert subspace preserves any
commutator bound against an element of the base algebra. -/
theorem baseOperator_commutator_norm_le (T : H →L[ℂ] H) (a : L)
    {c : ℝ} (hc : ‖commutator T (G.left (a : P))‖ ≤ c) :
    ‖commutator (G.baseOperator L T) (G.baseRepresentation L a)‖ ≤ c := by
  apply norm_reducing_compression_commutator_le (G.baseInclusion L)
    T (G.left (a : P)) (G.baseRepresentation L a)
    (G.baseInclusion_intertwines L a) ?_ hc
  simpa only [map_star, ContinuousLinearMap.star_eq_adjoint,
    StarMemClass.coe_star] using G.baseInclusion_intertwines L (star a)

variable [IsClosed (L : Set P)]

/-- A corner element of a subalgebra is the same ambient corner element,
with exactly the same norm. -/
def cornerInclusion (e : L) (he : IsStarProjection e)
    (x : CStarCorner e he) : CStarCorner (e : P) (he.map L.subtype) :=
  ⟨((x : L) : P), ⟨congrArg (fun y : L => (y : P)) x.property.1,
    congrArg (fun y : L => (y : P)) x.property.2⟩⟩

/-- The small-corner hypothesis survives restriction to the closed
generated algebra, without invariance of the operator being compressed. -/
theorem baseGeometry_traceCornerBound (D : StarSubalgebra ℂ P)
    (T : H →L[ℂ] H) {t ε : ℝ} (hbound : G.TraceCornerBound D T t ε) :
    (G.baseGeometry L).TraceCornerBound (D.comap L.subtype) (G.baseOperator L T) t ε := by
  intro e he heD hte x
  have h := hbound (e : P) (he.map L.subtype) heD hte (cornerInclusion L e he x)
  exact G.baseOperator_commutator_norm_le L T (x : L) h

/-- Commutation with the other factor also survives the same compression. -/
theorem baseGeometry_commutes (D : StarSubalgebra ℂ P)
    (T : H →L[ℂ] H)
    (hcomm : ∀ a : D, T.comp (G.left (a : P)) = (G.left (a : P)).comp T) :
    ∀ a : D.comap L.subtype,
      (G.baseOperator L T).comp ((G.baseGeometry L).left (a : L)) =
        ((G.baseGeometry L).left (a : L)).comp (G.baseOperator L T) := by
  intro a
  have hzero : commutator T (G.left ((a : L) : P)) = 0 := by
    apply sub_eq_zero.mpr
    exact hcomm ⟨((a : L) : P), a.property⟩
  have hbase : commutator (G.baseOperator L T)
      (G.baseRepresentation L (a : L)) = 0 := by
    rw [← G.baseOperator_commutator_subalgebra L T (a : L), hzero]
    simp only [baseOperator, ContinuousLinearMap.zero_comp, ContinuousLinearMap.comp_zero]
  exact sub_eq_zero.mp hbase

end TracialCornerGeometry
end KadisonSimilarity

end

end OAI
