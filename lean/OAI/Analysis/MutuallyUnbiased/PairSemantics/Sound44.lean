  have hc := injectiveMoment_first_row_contraction (by decide : 4 < 6) hH pivotMatrix2816 2 0 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix2816 (0 : Fin 4)) =
      Sparse.eval value1120 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2816 (0 : Fin 4) = raw6684 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2816 raw6684; decide +kernel
    rw [heq]
    exact (canonical6684 hH).trans (sound1120 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix2816 (1 : Fin 4)) =
      Sparse.eval value1320 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2816 (1 : Fin 4) = raw8372 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2816 raw8372; decide +kernel
    rw [heq]
    exact (canonical8372 hH).trans (sound1320 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix2816 (2 : Fin 4)) =
      Sparse.eval value1317 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2816 (2 : Fin 4) = raw8490 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2816 raw8490; decide +kernel
    rw [heq]
    exact (canonical8490 hH).trans (sound1317 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix2816 (3 : Fin 4)) =
      Sparse.eval value169 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2816 (3 : Fin 4) = raw8498 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2816 raw8498; decide +kernel
    rw [heq]
    exact (canonical8498 hH).trans (sound169 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (2 : ℝ) * injectiveMoment H node2816 + (injectiveMoment H (mergeFirst pivotMatrix2816 (0 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2816 (1 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2816 (2 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2816 (3 : Fin 4)))))) = 0 at hc
