def pivotMatrix2752 : Matrix (Fin 5) (Fin 4) ℤ := ![![-1, 0, 0, 1], ![0, -1, 0, 1], ![0, -1, 2, -1], ![0, 2, 0, -2], ![1, 0, -2, 1]]

theorem sound2752 {H : CMatrix} (hH : IsHadamard H) :
    injectiveMoment H node2752 = Sparse.eval value2752 (momentVector H) := by
  have heq : pivotMatrix2752 = (fun u v => node2752 (pivotPermutation2752 u) v) := by apply Matrix.ext; unfold pivotMatrix2752 node2752 pivotPermutation2752; decide +kernel
  have hmoment : injectiveMoment H node2752 = injectiveMoment H pivotMatrix2752 := by
    rw [heq]
    rw [injectiveMoment_row_permutation]
  have hshape : pivotMatrix2752 0 = Pi.single (3 : Fin 4) 1 - Pi.single 0 1 := by exact funext (by decide +kernel)
  have hc := injectiveMoment_first_row_contraction (by decide : 4 < 6) hH pivotMatrix2752 3 0 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix2752 (0 : Fin 4)) =
      Sparse.eval value1010 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2752 (0 : Fin 4) = raw6416 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2752 raw6416; decide +kernel
    rw [heq]
    exact (canonical6416 hH).trans (sound1010 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix2752 (1 : Fin 4)) =
      Sparse.eval value1002 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2752 (1 : Fin 4) = raw8351 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2752 raw8351; decide +kernel
    rw [heq]
    exact (canonical8351 hH).trans (sound1002 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix2752 (2 : Fin 4)) =
      Sparse.eval value1000 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2752 (2 : Fin 4) = raw8412 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2752 raw8412; decide +kernel
    rw [heq]
    exact (canonical8412 hH).trans (sound1000 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix2752 (3 : Fin 4)) =
      Sparse.eval value203 (momentVector H) := by
    have heq : mergeFirst pivotMatrix2752 (3 : Fin 4) = raw8415 := by apply Matrix.ext; unfold mergeFirst pivotMatrix2752 raw8415; decide +kernel
    rw [heq]
    exact (canonical8415 hH).trans (sound203 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (2 : ℝ) * injectiveMoment H node2752 + (injectiveMoment H (mergeFirst pivotMatrix2752 (0 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2752 (1 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2752 (2 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix2752 (3 : Fin 4)))))) = 0 at hc
  rw [hm0, hm1, hm2, hm3] at hc
  norm_num [value2752, value1000, value1002, value1010, value203, Sparse.eval] at hc ⊢
  linarith

