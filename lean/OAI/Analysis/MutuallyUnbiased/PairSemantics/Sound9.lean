def pivotPermutation623 : Equiv.Perm (Fin 5) where
  toFun := ![1, 0, 2, 3, 4]
  invFun := ![1, 0, 2, 3, 4]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def pivotMatrix623 : Matrix (Fin 5) (Fin 3) ℤ := ![![-1, 1, 0], ![-2, 0, 2], ![0, -2, 2], ![1, 3, -4], ![2, -2, 0]]

theorem sound623 {H : CMatrix} (hH : IsHadamard H) :
    injectiveMoment H node623 = Sparse.eval value623 (momentVector H) := by
  have heq : pivotMatrix623 = (fun u v => node623 (pivotPermutation623 u) v) := by apply Matrix.ext; unfold pivotMatrix623 node623 pivotPermutation623; decide +kernel
  have hmoment : injectiveMoment H node623 = injectiveMoment H pivotMatrix623 := by
    rw [heq]
    rw [injectiveMoment_row_permutation]
  have hshape : pivotMatrix623 0 = Pi.single (1 : Fin 3) 1 - Pi.single 0 1 := by exact funext (by decide +kernel)
  have hc := injectiveMoment_first_row_contraction (by decide : 4 < 6) hH pivotMatrix623 1 0 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix623 (0 : Fin 4)) =
      Sparse.eval value104 (momentVector H) := by
    have heq : mergeFirst pivotMatrix623 (0 : Fin 4) = raw715 := by apply Matrix.ext; unfold mergeFirst pivotMatrix623 raw715; decide +kernel
    rw [heq]
    exact (canonical715 hH).trans (sound104 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix623 (1 : Fin 4)) =
      Sparse.eval value85 (momentVector H) := by
    have heq : mergeFirst pivotMatrix623 (1 : Fin 4) = raw3907 := by apply Matrix.ext; unfold mergeFirst pivotMatrix623 raw3907; decide +kernel
    rw [heq]
    exact (canonical3907 hH).trans (sound85 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix623 (2 : Fin 4)) =
      Sparse.eval value199 (momentVector H) := by
    have heq : mergeFirst pivotMatrix623 (2 : Fin 4) = raw4040 := by apply Matrix.ext; unfold mergeFirst pivotMatrix623 raw4040; decide +kernel
    rw [heq]
    exact (canonical4040 hH).trans (sound199 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix623 (3 : Fin 4)) =
      Sparse.eval value201 (momentVector H) := by
    have heq : mergeFirst pivotMatrix623 (3 : Fin 4) = raw4046 := by apply Matrix.ext; unfold mergeFirst pivotMatrix623 raw4046; decide +kernel
    rw [heq]
    exact (canonical4046 hH).trans (sound201 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (2 : ℝ) * injectiveMoment H node623 + (injectiveMoment H (mergeFirst pivotMatrix623 (0 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix623 (1 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix623 (2 : Fin 4)) + (injectiveMoment H (mergeFirst pivotMatrix623 (3 : Fin 4)))))) = 0 at hc
  rw [hm0, hm1, hm2, hm3] at hc
  norm_num [value623, value104, value199, value201, value85, Sparse.eval] at hc ⊢
  linarith

