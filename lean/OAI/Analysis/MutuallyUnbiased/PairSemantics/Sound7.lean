theorem sound448 {H : CMatrix} (_hH : IsHadamard H) :
    injectiveMoment H node448 = Sparse.eval value448 (momentVector H) := by
  have hc : momentVector H 312 = injectiveMoment H node448 := rfl
  simp [value448, Sparse.eval, hc]

