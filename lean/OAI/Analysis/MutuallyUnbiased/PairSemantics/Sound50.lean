    rw [heq]
    rw [injectiveMoment_row_permutation]
  have hshape : pivotMatrix3200 0 = Pi.single (3 : Fin 4) 1 - Pi.single 1 1 := by exact funext (by decide +kernel)
  have hc := injectiveMoment_first_row_contraction (by decide : 5 < 6) hH pivotMatrix3200 3 1 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix3200 (0 : Fin 5)) =
      Sparse.eval value1751 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3200 (0 : Fin 5) = raw2200 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3200 raw2200; decide +kernel
    rw [heq]
    exact (canonical2200 hH).trans (sound1751 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix3200 (1 : Fin 5)) =
      Sparse.eval value2055 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3200 (1 : Fin 5) = raw3668 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3200 raw3668; decide +kernel
    rw [heq]
    exact (canonical3668 hH).trans (sound2055 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix3200 (2 : Fin 5)) =
      Sparse.eval value2724 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3200 (2 : Fin 5) = raw3715 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3200 raw3715; decide +kernel
    rw [heq]
    exact (canonical3715 hH).trans (sound2724 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix3200 (3 : Fin 5)) =
      Sparse.eval value2076 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3200 (3 : Fin 5) = raw3719 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3200 raw3719; decide +kernel
    rw [heq]
    exact (canonical3719 hH).trans (sound2076 hH)
  have hm4 : injectiveMoment H (mergeFirst pivotMatrix3200 (4 : Fin 5)) =
      Sparse.eval value2582 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3200 (4 : Fin 5) = raw3721 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3200 raw3721; decide +kernel
    rw [heq]
    exact (canonical3721 hH).trans (sound2582 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (1 : ℝ) * injectiveMoment H node3200 + (injectiveMoment H (mergeFirst pivotMatrix3200 (0 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3200 (1 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3200 (2 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3200 (3 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3200 (4 : Fin 5))))))) = 0 at hc
  rw [hm0, hm1, hm2, hm3, hm4] at hc
  norm_num [value3200, value1751, value2055, value2076, value2582, value2724, Sparse.eval] at hc ⊢
  linarith

