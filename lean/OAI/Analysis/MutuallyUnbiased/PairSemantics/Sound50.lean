theorem sound3200 {H : CMatrix} (hH : IsHadamard H) :
    injectiveMoment H node3200 = Sparse.eval value3200 (momentVector H) := by
  have heq : pivotMatrix3200 = (fun u v => node3200 (pivotPermutation3200 u) v) := by apply Matrix.ext; unfold pivotMatrix3200 node3200 pivotPermutation3200; decide +kernel
