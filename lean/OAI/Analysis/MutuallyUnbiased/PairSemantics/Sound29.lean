theorem sound1856 {H : CMatrix} (hH : IsHadamard H) :
    injectiveMoment H node1856 = Sparse.eval value1856 (momentVector H) := by
  have heq : pivotMatrix1856 = (fun u v => node1856 (pivotPermutation1856 u) v) := by apply Matrix.ext; unfold pivotMatrix1856 node1856 pivotPermutation1856; decide +kernel
  have hmoment : injectiveMoment H node1856 = injectiveMoment H pivotMatrix1856 := by
    rw [heq]
    rw [injectiveMoment_row_permutation]
  have hshape : pivotMatrix1856 0 = Pi.single (2 : Fin 3) 1 - Pi.single 0 1 := by exact funext (by decide +kernel)
  have hc := injectiveMoment_first_row_contraction (by decide : 5 < 6) hH pivotMatrix1856 2 0 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix1856 (0 : Fin 5)) =
      Sparse.eval value322 (momentVector H) := by
    have heq : mergeFirst pivotMatrix1856 (0 : Fin 5) = raw305 := by apply Matrix.ext; unfold mergeFirst pivotMatrix1856 raw305; decide +kernel
    rw [heq]
    exact (canonical305 hH).trans (sound322 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix1856 (1 : Fin 5)) =
      Sparse.eval value374 (momentVector H) := by
    have heq : mergeFirst pivotMatrix1856 (1 : Fin 5) = raw2689 := by apply Matrix.ext; unfold mergeFirst pivotMatrix1856 raw2689; decide +kernel
    rw [heq]
    exact (canonical2689 hH).trans (sound374 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix1856 (2 : Fin 5)) =
      Sparse.eval value561 (momentVector H) := by
    have heq : mergeFirst pivotMatrix1856 (2 : Fin 5) = raw2826 := by apply Matrix.ext; unfold mergeFirst pivotMatrix1856 raw2826; decide +kernel
    rw [heq]
    exact (canonical2826 hH).trans (sound561 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix1856 (3 : Fin 5)) =
      Sparse.eval value561 (momentVector H) := by
    have heq : mergeFirst pivotMatrix1856 (3 : Fin 5) = raw2840 := by apply Matrix.ext; unfold mergeFirst pivotMatrix1856 raw2840; decide +kernel
    rw [heq]
    exact (canonical2840 hH).trans (sound561 hH)
  have hm4 : injectiveMoment H (mergeFirst pivotMatrix1856 (4 : Fin 5)) =
      Sparse.eval value573 (momentVector H) := by
    have heq : mergeFirst pivotMatrix1856 (4 : Fin 5) = raw2841 := by apply Matrix.ext; unfold mergeFirst pivotMatrix1856 raw2841; decide +kernel
    rw [heq]
    exact (canonical2841 hH).trans (sound573 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (1 : ℝ) * injectiveMoment H node1856 + (injectiveMoment H (mergeFirst pivotMatrix1856 (0 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix1856 (1 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix1856 (2 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix1856 (3 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix1856 (4 : Fin 5))))))) = 0 at hc
  rw [hm0, hm1, hm2, hm3, hm4] at hc
  norm_num [value1856, value322, value374, value561, value573, Sparse.eval] at hc ⊢
  linarith

