    rw [heq]
    rw [injectiveMoment_row_permutation]
  have hshape : pivotMatrix3264 0 = Pi.single (3 : Fin 4) 1 - Pi.single 2 1 := by exact funext (by decide +kernel)
  have hc := injectiveMoment_first_row_contraction (by decide : 5 < 6) hH pivotMatrix3264 3 2 (by decide) hshape
  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix3264 (0 : Fin 5)) =
      Sparse.eval value2201 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3264 (0 : Fin 5) = raw4407 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3264 raw4407; decide +kernel
    rw [heq]
    exact (canonical4407 hH).trans (sound2201 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix3264 (1 : Fin 5)) =
      Sparse.eval value1803 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3264 (1 : Fin 5) = raw4583 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3264 raw4583; decide +kernel
    rw [heq]
    exact (canonical4583 hH).trans (sound1803 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix3264 (2 : Fin 5)) =
      Sparse.eval value2244 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3264 (2 : Fin 5) = raw4594 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3264 raw4594; decide +kernel
    rw [heq]
    exact (canonical4594 hH).trans (sound2244 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix3264 (3 : Fin 5)) =
      Sparse.eval value2245 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3264 (3 : Fin 5) = raw4597 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3264 raw4597; decide +kernel
    rw [heq]
    exact (canonical4597 hH).trans (sound2245 hH)
  have hm4 : injectiveMoment H (mergeFirst pivotMatrix3264 (4 : Fin 5)) =
      Sparse.eval value2246 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3264 (4 : Fin 5) = raw4598 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3264 raw4598; decide +kernel
    rw [heq]
    exact (canonical4598 hH).trans (sound2246 hH)
  norm_num only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero] at hc
  change (1 : ℝ) * injectiveMoment H node3264 + (injectiveMoment H (mergeFirst pivotMatrix3264 (0 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3264 (1 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3264 (2 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3264 (3 : Fin 5)) + (injectiveMoment H (mergeFirst pivotMatrix3264 (4 : Fin 5))))))) = 0 at hc
  rw [hm0, hm1, hm2, hm3, hm4] at hc
  norm_num [value3264, value1803, value2201, value2244, value2245, value2246, Sparse.eval] at hc ⊢
  linarith

