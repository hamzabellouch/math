theorem sound3264 {H : CMatrix} (hH : IsHadamard H) :
    injectiveMoment H node3264 = Sparse.eval value3264 (momentVector H) := by
  have heq : pivotMatrix3264 = (fun u v => node3264 (pivotPermutation3264 u) v) := by apply Matrix.ext; unfold pivotMatrix3264 node3264 pivotPermutation3264; decide +kernel
