  rw [← hmoment] at hc
  have hm0 : injectiveMoment H (mergeFirst pivotMatrix3328 (0 : Fin 5)) =
      Sparse.eval value2357 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3328 (0 : Fin 5) = raw5336 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3328 raw5336; decide +kernel
    rw [heq]
    exact (canonical5336 hH).trans (sound2357 hH)
  have hm1 : injectiveMoment H (mergeFirst pivotMatrix3328 (1 : Fin 5)) =
      Sparse.eval value2371 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3328 (1 : Fin 5) = raw5417 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3328 raw5417; decide +kernel
    rw [heq]
    exact (canonical5417 hH).trans (sound2371 hH)
  have hm2 : injectiveMoment H (mergeFirst pivotMatrix3328 (2 : Fin 5)) =
      Sparse.eval value2371 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3328 (2 : Fin 5) = raw5428 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3328 raw5428; decide +kernel
    rw [heq]
    exact (canonical5428 hH).trans (sound2371 hH)
  have hm3 : injectiveMoment H (mergeFirst pivotMatrix3328 (3 : Fin 5)) =
      Sparse.eval value2373 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3328 (3 : Fin 5) = raw5430 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3328 raw5430; decide +kernel
    rw [heq]
    exact (canonical5430 hH).trans (sound2373 hH)
  have hm4 : injectiveMoment H (mergeFirst pivotMatrix3328 (4 : Fin 5)) =
      Sparse.eval value1752 (momentVector H) := by
    have heq : mergeFirst pivotMatrix3328 (4 : Fin 5) = raw5431 := by apply Matrix.ext; unfold mergeFirst pivotMatrix3328 raw5431; decide +kernel
