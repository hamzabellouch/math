import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary4
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary5

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck64 : Integer.Sparse.reindex coordinateMap (PairData.rows 64) =
    PairSemantics.boundaryRow68 := by decide +kernel

theorem rowSound64 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 64) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck64]
  exact PairSemantics.boundarySound68 hH

