import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary14
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary15

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck224 : Integer.Sparse.reindex coordinateMap (PairData.rows 224) =
    PairSemantics.boundaryRow398 := by decide +kernel

theorem rowSound224 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 224) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck224]
  exact PairSemantics.boundarySound398 hH

