import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary8
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary9

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck128 : Integer.Sparse.reindex coordinateMap (PairData.rows 128) =
    PairSemantics.boundaryRow171 := by decide +kernel

theorem rowSound128 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 128) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck128]
  exact PairSemantics.boundarySound171 hH

