import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary5
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary6

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck80 : Integer.Sparse.reindex coordinateMap (PairData.rows 80) =
    PairSemantics.boundaryRow89 := by decide +kernel

theorem rowSound80 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 80) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck80]
  exact PairSemantics.boundarySound89 hH

