import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary9
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary10

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck144 : Integer.Sparse.reindex coordinateMap (PairData.rows 144) =
    PairSemantics.boundaryRow249 := by decide +kernel

theorem rowSound144 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 144) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck144]
  exact PairSemantics.boundarySound249 hH

