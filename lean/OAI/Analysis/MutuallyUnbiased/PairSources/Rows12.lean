import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary12
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary13

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck192 : Integer.Sparse.reindex coordinateMap (PairData.rows 192) =
    PairSemantics.boundaryRow351 := by decide +kernel

theorem rowSound192 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 192) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck192]
  exact PairSemantics.boundarySound351 hH

