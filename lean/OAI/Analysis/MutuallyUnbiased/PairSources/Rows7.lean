import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary7
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary8

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck112 : Integer.Sparse.reindex coordinateMap (PairData.rows 112) =
    PairSemantics.boundaryRow146 := by decide +kernel

theorem rowSound112 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 112) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck112]
  exact PairSemantics.boundarySound146 hH

