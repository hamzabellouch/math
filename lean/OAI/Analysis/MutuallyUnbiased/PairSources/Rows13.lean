theorem rowCheck208 : Integer.Sparse.reindex coordinateMap (PairData.rows 208) =
    PairSemantics.boundaryRow379 := by decide +kernel

theorem rowSound208 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 208) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck208]
  exact PairSemantics.boundarySound379 hH

