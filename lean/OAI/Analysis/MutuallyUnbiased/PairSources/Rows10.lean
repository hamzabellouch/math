import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary10
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary11

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck160 : Integer.Sparse.reindex coordinateMap (PairData.rows 160) =
    PairSemantics.boundaryRow277 := by decide +kernel

theorem rowSound160 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 160) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck160]
  exact PairSemantics.boundarySound277 hH

