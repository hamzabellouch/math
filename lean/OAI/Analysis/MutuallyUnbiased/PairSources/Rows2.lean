import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary2

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck32 : Integer.Sparse.reindex coordinateMap (PairData.rows 32) =
    PairSemantics.boundaryRow33 := by decide +kernel

theorem rowSound32 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 32) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck32]
  exact PairSemantics.boundarySound33 hH

