import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary1

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck16 : Integer.Sparse.reindex coordinateMap (PairData.rows 16) =
    PairSemantics.boundaryRow17 := by decide +kernel

theorem rowSound16 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 16) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck16]
  exact PairSemantics.boundarySound17 hH

