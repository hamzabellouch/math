import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary6
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary7

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck96 : Integer.Sparse.reindex coordinateMap (PairData.rows 96) =
    PairSemantics.boundaryRow105 := by decide +kernel

theorem rowSound96 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 96) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck96]
  exact PairSemantics.boundarySound105 hH

