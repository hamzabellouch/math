import OAI.Analysis.MutuallyUnbiased.PairSources.Data
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary15
import OAI.Analysis.MutuallyUnbiased.PairSemantics.Boundary16

namespace OAI

namespace MUB6.Certificate.PairSourceBridge

theorem rowCheck240 : Integer.Sparse.reindex coordinateMap (PairData.rows 240) =
    PairSemantics.boundaryRow423 := by decide +kernel

theorem rowSound240 {H : CMatrix} (hH : IsHadamard H) :
    Integer.Sparse.eval (PairData.rows 240) (momentVector H) = 0 := by
  unfold momentVector
  rw [← Integer.Sparse.eval_reindex]
  rw [rowCheck240]
  exact PairSemantics.boundarySound423 hH

