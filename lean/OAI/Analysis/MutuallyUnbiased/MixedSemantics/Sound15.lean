theorem sound960 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node960 node960Labels = Sparse.eval nodeValue960 (mixedVector B) := by
  have hc : mixedVector B (Sum.inr 960) = mixedMoment B node960 node960Labels := rfl
  simpa [nodeValue960, Sparse.eval] using hc.symm

