theorem sound256 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node256 node256Labels = Sparse.eval nodeValue256 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue256 (familyPairVector B) := singlePair256 B _hB
    _ = _ := by norm_num [singlePairValue256, nodeValue256, Sparse.eval, mixedVector]; ring

