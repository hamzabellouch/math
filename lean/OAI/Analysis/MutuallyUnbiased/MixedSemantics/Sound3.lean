theorem sound192 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node192 node192Labels = Sparse.eval nodeValue192 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue192 (familyPairVector B) := singlePair192 B _hB
