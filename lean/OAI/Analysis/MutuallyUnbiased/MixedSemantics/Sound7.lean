theorem sound448 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node448 node448Labels = Sparse.eval nodeValue448 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue448 (familyPairVector B) := singlePair448 B _hB
    _ = _ := by norm_num [singlePairValue448, nodeValue448, Sparse.eval, mixedVector]; ring

