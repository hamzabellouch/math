theorem sound384 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node384 node384Labels = Sparse.eval nodeValue384 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue384 (familyPairVector B) := singlePair384 B _hB
    _ = _ := by
      norm_num [singlePairValue384, nodeValue384, Sparse.eval, mixedVector]
      ring

