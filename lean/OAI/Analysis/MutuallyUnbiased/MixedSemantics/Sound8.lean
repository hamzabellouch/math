theorem sound512 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node512 node512Labels = Sparse.eval nodeValue512 (mixedVector B) := by
  simpa only [nodeValue512, Sparse.eval_nil] using zero512 B _hB _hF

theorem sound513 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node513 node513Labels = Sparse.eval nodeValue513 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue513 (familyPairVector B) := singlePair513 B _hB
    _ = _ := by norm_num [singlePairValue513, nodeValue513, Sparse.eval, mixedVector]; ring

