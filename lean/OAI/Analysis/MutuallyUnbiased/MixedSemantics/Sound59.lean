    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node3776 node3776Labels = Sparse.eval nodeValue3776 (mixedVector B) := by
  have hc : mixedVector B (Sum.inr 3776) = mixedMoment B node3776 node3776Labels := rfl
