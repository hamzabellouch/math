theorem sound3328 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node3328 node3328Labels = Sparse.eval nodeValue3328 (mixedVector B) := by
  simpa only [nodeValue3328, Sparse.eval_nil] using zero3328 B _hB _hF

theorem sound3329 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node3329 node3329Labels = Sparse.eval nodeValue3329 (mixedVector B) := by
  have hc : mixedVector B (Sum.inr 3329) = mixedMoment B node3329 node3329Labels := rfl
  simpa [nodeValue3329, Sparse.eval] using hc.symm

