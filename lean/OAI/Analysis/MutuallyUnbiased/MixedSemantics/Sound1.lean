theorem sound64 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node64 node64Labels = Sparse.eval nodeValue64 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue64 (familyPairVector B) := singlePair64 B _hB
    _ = _ := by norm_num [singlePairValue64, nodeValue64, Sparse.eval, mixedVector]; ring

