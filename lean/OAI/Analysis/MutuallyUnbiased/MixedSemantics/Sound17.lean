    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node1089 node1089Labels = Sparse.eval nodeValue1089 (mixedVector B) := by
  simpa only [nodeValue1089, Sparse.eval_nil] using zero1089 B _hB _hF

