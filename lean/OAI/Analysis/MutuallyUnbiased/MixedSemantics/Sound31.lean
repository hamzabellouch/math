theorem sound1984 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node1984 node1984Labels = Sparse.eval nodeValue1984 (mixedVector B) := by
  have hc : mixedVector B (Sum.inr 1984) = mixedMoment B node1984 node1984Labels := rfl
  simpa [nodeValue1984, Sparse.eval] using hc.symm

