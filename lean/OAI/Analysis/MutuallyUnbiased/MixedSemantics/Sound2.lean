theorem sound128 (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node128 node128Labels = Sparse.eval nodeValue128 (mixedVector B) := by
  calc
    _ = Sparse.eval singlePairValue128 (familyPairVector B) := singlePair128 B _hB
    _ = _ := by
      norm_num [singlePairValue128, nodeValue128, Sparse.eval, mixedVector]
      ring

