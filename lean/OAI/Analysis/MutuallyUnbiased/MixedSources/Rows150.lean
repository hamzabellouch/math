theorem chunkSound150 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 150) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2400 ∨ k.val = 2401 ∨ k.val = 2402 ∨ k.val = 2403 ∨ k.val = 2404 ∨ k.val = 2405 ∨ k.val = 2406 ∨ k.val = 2407 ∨ k.val = 2408 ∨ k.val = 2409 ∨ k.val = 2410 ∨ k.val = 2411 ∨ k.val = 2412 ∨ k.val = 2413 ∨ k.val = 2414 ∨ k.val = 2415 := by omega
  rcases heq with h2400 | h2401 | h2402 | h2403 | h2404 | h2405 | h2406 | h2407 | h2408 | h2409 | h2410 | h2411 | h2412 | h2413 | h2414 | h2415
  · have he : k = (2400 : Fin 2425) := Fin.ext h2400
    subst k
    rw [sourceRowsAt2400]
    exact rowSound2400 B hB hF
  · have he : k = (2401 : Fin 2425) := Fin.ext h2401
    subst k
    rw [sourceRowsAt2401]
    exact rowSound2401 B hB hF
  · have he : k = (2402 : Fin 2425) := Fin.ext h2402
    subst k
    rw [sourceRowsAt2402]
    exact rowSound2402 B hB hF
  · have he : k = (2403 : Fin 2425) := Fin.ext h2403
    subst k
    rw [sourceRowsAt2403]
    exact rowSound2403 B hB hF
  · have he : k = (2404 : Fin 2425) := Fin.ext h2404
    subst k
    rw [sourceRowsAt2404]
    exact rowSound2404 B hB hF
  · have he : k = (2405 : Fin 2425) := Fin.ext h2405
    subst k
    rw [sourceRowsAt2405]
    exact rowSound2405 B hB hF
  · have he : k = (2406 : Fin 2425) := Fin.ext h2406
    subst k
    rw [sourceRowsAt2406]
    exact rowSound2406 B hB hF
  · have he : k = (2407 : Fin 2425) := Fin.ext h2407
    subst k
    rw [sourceRowsAt2407]
    exact rowSound2407 B hB hF
  · have he : k = (2408 : Fin 2425) := Fin.ext h2408
