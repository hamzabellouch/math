    (_hF : AllTransitionsFourierZero B) :
    Integer.Sparse.eval MixedData.row2400 (numericVector B) = 0 := by
  rw [integer_eval_numericVector, Integer.Sparse.eval_perm reindexCheck2400, Integer.Sparse.eval_reindex]
  exact pair_row_zero B hB PairSemantics.boundaryRow404 (fun _ hH => PairSemantics.boundarySound404 hH)

