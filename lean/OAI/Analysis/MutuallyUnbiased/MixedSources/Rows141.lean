    (_hF : AllTransitionsFourierZero B) :
    Integer.Sparse.eval MixedData.row2256 (numericVector B) = 0 := by
  rw [integer_eval_numericVector, Integer.Sparse.eval_perm reindexCheck2256, Integer.Sparse.eval_reindex]
  exact pair_row_zero B hB PairSemantics.boundaryRow97 (fun _ hH => PairSemantics.boundarySound97 hH)

