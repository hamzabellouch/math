theorem chunkSound141 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 141) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2256 ∨ k.val = 2257 ∨ k.val = 2258 ∨ k.val = 2259 ∨ k.val = 2260 ∨ k.val = 2261 ∨ k.val = 2262 ∨ k.val = 2263 ∨ k.val = 2264 ∨ k.val = 2265 ∨ k.val = 2266 ∨ k.val = 2267 ∨ k.val = 2268 ∨ k.val = 2269 ∨ k.val = 2270 ∨ k.val = 2271 := by omega
  rcases heq with h2256 | h2257 | h2258 | h2259 | h2260 | h2261 | h2262 | h2263 | h2264 | h2265 | h2266 | h2267 | h2268 | h2269 | h2270 | h2271
  · have he : k = (2256 : Fin 2425) := Fin.ext h2256
    subst k
    rw [sourceRowsAt2256]
    exact rowSound2256 B hB hF
  · have he : k = (2257 : Fin 2425) := Fin.ext h2257
    subst k
    rw [sourceRowsAt2257]
    exact rowSound2257 B hB hF
  · have he : k = (2258 : Fin 2425) := Fin.ext h2258
    subst k
    rw [sourceRowsAt2258]
    exact rowSound2258 B hB hF
  · have he : k = (2259 : Fin 2425) := Fin.ext h2259
    subst k
    rw [sourceRowsAt2259]
    exact rowSound2259 B hB hF
  · have he : k = (2260 : Fin 2425) := Fin.ext h2260
    subst k
    rw [sourceRowsAt2260]
    exact rowSound2260 B hB hF
  · have he : k = (2261 : Fin 2425) := Fin.ext h2261
    subst k
    rw [sourceRowsAt2261]
    exact rowSound2261 B hB hF
  · have he : k = (2262 : Fin 2425) := Fin.ext h2262
    subst k
    rw [sourceRowsAt2262]
    exact rowSound2262 B hB hF
  · have he : k = (2263 : Fin 2425) := Fin.ext h2263
    subst k
    rw [sourceRowsAt2263]
    exact rowSound2263 B hB hF
  · have he : k = (2264 : Fin 2425) := Fin.ext h2264
    subst k
    rw [sourceRowsAt2264]
    exact rowSound2264 B hB hF
  · have he : k = (2265 : Fin 2425) := Fin.ext h2265
    subst k
    rw [sourceRowsAt2265]
    exact rowSound2265 B hB hF
  · have he : k = (2266 : Fin 2425) := Fin.ext h2266
    subst k
    rw [sourceRowsAt2266]
    exact rowSound2266 B hB hF
  · have he : k = (2267 : Fin 2425) := Fin.ext h2267
    subst k
    rw [sourceRowsAt2267]
    exact rowSound2267 B hB hF
  · have he : k = (2268 : Fin 2425) := Fin.ext h2268
    subst k
    rw [sourceRowsAt2268]
    exact rowSound2268 B hB hF
  · have he : k = (2269 : Fin 2425) := Fin.ext h2269
    subst k
    rw [sourceRowsAt2269]
    exact rowSound2269 B hB hF
  · have he : k = (2270 : Fin 2425) := Fin.ext h2270
    subst k
    rw [sourceRowsAt2270]
