  have heq : k.val = 2304 ∨ k.val = 2305 ∨ k.val = 2306 ∨ k.val = 2307 ∨ k.val = 2308 ∨ k.val = 2309 ∨ k.val = 2310 ∨ k.val = 2311 ∨ k.val = 2312 ∨ k.val = 2313 ∨ k.val = 2314 ∨ k.val = 2315 ∨ k.val = 2316 ∨ k.val = 2317 ∨ k.val = 2318 ∨ k.val = 2319 := by omega
