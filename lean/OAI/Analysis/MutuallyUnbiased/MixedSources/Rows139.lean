theorem chunkSound139 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 139) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2224 ∨ k.val = 2225 ∨ k.val = 2226 ∨ k.val = 2227 ∨ k.val = 2228 ∨ k.val = 2229 ∨ k.val = 2230 ∨ k.val = 2231 ∨ k.val = 2232 ∨ k.val = 2233 ∨ k.val = 2234 ∨ k.val = 2235 ∨ k.val = 2236 ∨ k.val = 2237 ∨ k.val = 2238 ∨ k.val = 2239 := by omega
  rcases heq with h2224 | h2225 | h2226 | h2227 | h2228 | h2229 | h2230 | h2231 | h2232 | h2233 | h2234 | h2235 | h2236 | h2237 | h2238 | h2239
  · have he : k = (2224 : Fin 2425) := Fin.ext h2224
    subst k
    rw [sourceRowsAt2224]
    exact rowSound2224 B hB hF
  · have he : k = (2225 : Fin 2425) := Fin.ext h2225
