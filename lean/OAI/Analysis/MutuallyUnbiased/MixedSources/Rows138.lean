theorem chunkSound138 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 138) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2208 ∨ k.val = 2209 ∨ k.val = 2210 ∨ k.val = 2211 ∨ k.val = 2212 ∨ k.val = 2213 ∨ k.val = 2214 ∨ k.val = 2215 ∨ k.val = 2216 ∨ k.val = 2217 ∨ k.val = 2218 ∨ k.val = 2219 ∨ k.val = 2220 ∨ k.val = 2221 ∨ k.val = 2222 ∨ k.val = 2223 := by omega
  rcases heq with h2208 | h2209 | h2210 | h2211 | h2212 | h2213 | h2214 | h2215 | h2216 | h2217 | h2218 | h2219 | h2220 | h2221 | h2222 | h2223
  · have he : k = (2208 : Fin 2425) := Fin.ext h2208
    subst k
    rw [sourceRowsAt2208]
    exact rowSound2208 B hB hF
  · have he : k = (2209 : Fin 2425) := Fin.ext h2209
    subst k
    rw [sourceRowsAt2209]
    exact rowSound2209 B hB hF
  · have he : k = (2210 : Fin 2425) := Fin.ext h2210
