theorem chunkSound136 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 136) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2176 ∨ k.val = 2177 ∨ k.val = 2178 ∨ k.val = 2179 ∨ k.val = 2180 ∨ k.val = 2181 ∨ k.val = 2182 ∨ k.val = 2183 ∨ k.val = 2184 ∨ k.val = 2185 ∨ k.val = 2186 ∨ k.val = 2187 ∨ k.val = 2188 ∨ k.val = 2189 ∨ k.val = 2190 ∨ k.val = 2191 := by omega
  rcases heq with h2176 | h2177 | h2178 | h2179 | h2180 | h2181 | h2182 | h2183 | h2184 | h2185 | h2186 | h2187 | h2188 | h2189 | h2190 | h2191
