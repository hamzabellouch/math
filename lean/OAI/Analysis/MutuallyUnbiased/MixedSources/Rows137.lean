theorem chunkSound137 (B : Fin 7 → Basis) (hB : IsMUBFamily B)
    (hF : AllTransitionsFourierZero B) (k : Fin 2425)
    (hk : k.val / 16 = 137) :
    Integer.Sparse.eval (MixedData.sourceRows k) (numericVector B) = 0 := by
  have heq : k.val = 2192 ∨ k.val = 2193 ∨ k.val = 2194 ∨ k.val = 2195 ∨ k.val = 2196 ∨ k.val = 2197 ∨ k.val = 2198 ∨ k.val = 2199 ∨ k.val = 2200 ∨ k.val = 2201 ∨ k.val = 2202 ∨ k.val = 2203 ∨ k.val = 2204 ∨ k.val = 2205 ∨ k.val = 2206 ∨ k.val = 2207 := by omega
  rcases heq with h2192 | h2193 | h2194 | h2195 | h2196 | h2197 | h2198 | h2199 | h2200 | h2201 | h2202 | h2203 | h2204 | h2205 | h2206 | h2207
  · have he : k = (2192 : Fin 2425) := Fin.ext h2192
    subst k
    rw [sourceRowsAt2192]
    exact rowSound2192 B hB hF
  · have he : k = (2193 : Fin 2425) := Fin.ext h2193
    subst k
    rw [sourceRowsAt2193]
    exact rowSound2193 B hB hF
  · have he : k = (2194 : Fin 2425) := Fin.ext h2194
