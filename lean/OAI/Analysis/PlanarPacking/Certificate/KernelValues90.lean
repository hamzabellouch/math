  unfold kernel85_0Expr
  have hl := (gridRows_contains j i k).2.1
  rw [pointLambda_eq] at hl
  have hh := CBox.contains_mul hl (trans85_contains j i k)
  simpa only [Bool.false_eq_true,ite_false,mul_one] using hh
