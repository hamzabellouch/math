    (kernel88_1 j i k).Contains (lambda (quadraturePoint j.val (16*i.val+k.val))*
      Complex.exp (Complex.I*Real.pi*z (quadraturePoint j.val (16*i.val+k.val))*(88:ℕ))*
      (if true then Complex.I*Real.pi*z (quadraturePoint j.val (16*i.val+k.val)) else 1)) := by
  rw [← kernel88_1_eq]
  unfold kernel88_1Expr
  have hl := (gridRows_contains j i k).2.1
  rw [pointLambda_eq] at hl
  have hh := CBox.contains_mul hl (trans88_contains j i k)
  have hz := (gridRows_contains j i k).2.2.1
  rw [pointZ_eq] at hz
  simpa only [ite_true] using CBox.contains_mul hh (CBox.contains_mul piI_contains hz)
end SharpPlanar.CachedData

