noncomputable def kernel49_1 : Fin 6 → Fin 16 → Fin 16 → CBox := ![kernel49_1_r0,kernel49_1_r1,kernel49_1_r2,kernel49_1_r3,kernel49_1_r4,kernel49_1_r5]
lemma kernel49_1_eq (j : Fin 6) (i k : Fin 16) : kernel49_1Expr j i k = kernel49_1 j i k := by
  fin_cases j
  · exact kernel49_1_r0_eq i k
  · exact kernel49_1_r1_eq i k
  · exact kernel49_1_r2_eq i k
  · exact kernel49_1_r3_eq i k
  · exact kernel49_1_r4_eq i k
  · exact kernel49_1_r5_eq i k
lemma kernel49_1_contains (j : Fin 6) (i k : Fin 16) :
    (kernel49_1 j i k).Contains (lambda (quadraturePoint j.val (16*i.val+k.val))*
      Complex.exp (Complex.I*Real.pi*z (quadraturePoint j.val (16*i.val+k.val))*(49:ℕ))*
      (if true then Complex.I*Real.pi*z (quadraturePoint j.val (16*i.val+k.val)) else 1)) := by
  rw [← kernel49_1_eq]
  unfold kernel49_1Expr
  have hl := (gridRows_contains j i k).2.1
  rw [pointLambda_eq] at hl
  have hh := CBox.contains_mul hl (trans49_contains j i k)
  have hz := (gridRows_contains j i k).2.2.1
  rw [pointZ_eq] at hz
  simpa only [ite_true] using CBox.contains_mul hh (CBox.contains_mul piI_contains hz)
