  · exact column49_1_r0_eq i k
  · exact column49_1_r1_eq i k
  · exact column49_1_r2_eq i k
  · exact column49_1_r3_eq i k
  · exact column49_1_r4_eq i k
  · exact column49_1_r5_eq i k
lemma column49_1_contains (j : Fin 6) (i k : Fin 16) :
    (column49_1 j i k).Contains ((fejerWeight (16*i.val+k.val):ℂ)*basisFunction true 49 j.val (quadraturePoint j.val (16*i.val+k.val))) := by
  rw [← column49_1_eq,basisFunction_wave,← mul_assoc]
  unfold column49_1Expr
  apply CBox.contains_mul
  · rw [← waveAmplitude_mod true 49 j.val (quadraturePoint j.val (16*i.val+k.val))]
    exact amp1_1_contains j i k
  · exact power49_contains j i k
